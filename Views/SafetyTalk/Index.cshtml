@model IEnumerable<MBS_SAP.Models.SafetyTalk>
@{
    ViewData["Title"] = "Safety Talk - SAP";
    var userNik = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAdmin = User.IsInRole("Admin");
}

<div class="animate-fade-in pb-4">
    <!-- Header with Banner -->
    <div class="position-relative mb-4" style="margin: -20px -20px 20px -20px;">
        <div style="background: linear-gradient(135deg, #e11d48, #f43f5e); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; padding: 32px 20px 24px; text-align: center; position: relative; overflow: hidden;">
            <!-- Decorative circle -->
            <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: -30px; left: -10px; width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            
            <i class="bi bi-megaphone-fill text-white mb-2 d-block" style="font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
            <h4 style="font-weight: 800; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.2); margin-bottom: 4px; letter-spacing: 0.5px;">SAFETY TALK</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 12px; margin: 0; font-weight: 500;">Dokumentasikan agenda pengarahan K3.</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(244, 63, 94, 0.15); color: var(--color-red); border-radius: 12px;">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hybrid Grid Layout: Form and List side-by-side on laptop, stacked on mobile -->
    <div class="form-responsive-row">
        
        <!-- Form Column -->
        <div class="card-sap border-red-accent">
            <form asp-controller="SafetyTalk" asp-action="Submit" method="post" enctype="multipart/form-data" id="safetyTalkForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="talkId" name="id" value="" />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-white" style="font-weight: 700;" id="formTitle"><i class="bi bi-megaphone-fill me-2" style="color: #f43f5e;"></i>Catat Safety Talk Baru</h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelEdit" onclick="cancelEditSafetyTalk()">
                        <i class="bi bi-x-circle me-1"></i> Batal Edit
                    </button>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="tanggal">Tanggal Kegiatan</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-calendar-event-fill input-sap-icon"></i>
                            <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="waktuStr">Waktu Mulai</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-clock-fill input-sap-icon"></i>
                            <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="areaSearch">Area Utama</label>
                        <div class="position-relative mb-0">
                            <div class="input-sap-wrapper mb-0">
                                <i class="bi bi-geo-alt-fill input-sap-icon"></i>
                                <input type="text" id="areaSearch" class="input-sap text-uppercase" placeholder="Ketik untuk mencari area..." autocomplete="off" style="padding-right: 36px;" />
                                <i class="bi bi-chevron-down position-absolute" style="right: 12px; top: 14px; color: var(--text-muted); cursor: pointer;" id="toggleAreaDropdown"></i>
                            </div>
                            <!-- Hidden select for actual form submission -->
                            <select id="area" name="area" required style="display:none;">
                                <option value="" disabled selected></option>
                            </select>
                            <!-- Dropdown list -->
                            <div id="areaDropdownMenu" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1050; background: var(--bg-card); border:1px solid var(--border-color); max-height:220px; overflow-y:auto; border-radius:8px; box-shadow: 0 8px 24px rgba(0,0,0,0.25);">
                                <!-- Populated by JS -->
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="benchmarkSearch">Detail Lokasi / Benchmark</label>
                        <div class="d-flex align-items-center gap-2">
                            <div class="position-relative flex-grow-1 mb-0">
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-compass-fill input-sap-icon"></i>
                                    <input type="text" id="benchmarkSearch" class="input-sap text-uppercase" placeholder="Pilih Area Utama dulu..." autocomplete="off" style="padding-right: 36px;" disabled />
                                    <i class="bi bi-chevron-down position-absolute" style="right: 12px; top: 14px; color: var(--text-muted); cursor: pointer;" id="toggleBenchmarkDropdown"></i>
                                </div>
                                <!-- Hidden input for actual form submission -->
                                <input type="hidden" id="detilLokasi" name="detilLokasi" value="" />
                                <!-- Dropdown list -->
                                <div id="benchmarkDropdownMenu" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1050; background: var(--bg-card); border:1px solid var(--border-color); max-height:220px; overflow-y:auto; border-radius:8px; box-shadow: 0 8px 24px rgba(0,0,0,0.25);">
                                    <!-- Populated by JS -->
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary shadow-sm" style="height: 46px; border-radius: 12px; padding: 0 16px; background-color: var(--color-primary); border: none;" onclick="$('#addBenchmarkModal').modal('show')" title="Tambah Benchmark Baru" id="btnAddBenchmark" disabled>
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-group-sap">
                    <label class="form-label-sap" for="lokasi">Lokasi Spesifik</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-geo-fill input-sap-icon"></i>
                        <input type="text" id="lokasi" name="lokasi" class="input-sap" placeholder="Masukkan lokasi spesifik / Klik ikon Lokasi Aktual GPS di kanan..." style="padding-right: 40px;" required />
                        <button type="button" class="btn btn-link p-0 position-absolute" id="btnGetLocation" style="right: 12px; top: 10px; color: var(--color-primary);" onclick="getLocation()" title="Ambil Lokasi Aktual GPS">
                            <i class="bi bi-crosshair"></i>
                        </button>
                    </div>
                    <small class="text-muted" style="font-size: 10px;">Lokasi Aktual GPS otomatis mengambil koordinat Anda atau Anda bisa mengetiknya secara manual.</small>
                </div>

                <div class="form-group-sap">
                    <label class="form-label-sap" for="judul">Judul / Topik Pembahasan</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-megaphone-fill input-sap-icon"></i>
                        <input type="text" id="judul" name="judul" class="input-sap" placeholder="Misal: Statistik insiden 2025 dan kewaspadaan kerja" required />
                    </div>
                </div>

                <div class="form-group-sap">
                    <label class="form-label-sap" for="keterangan">Keterangan / Daftar Hadir / Notulen</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-file-earmark-text-fill input-sap-icon" style="top: 14px;"></i>
                        <textarea id="keterangan" name="keterangan" class="input-sap" rows="3" placeholder="Masukkan ringkasan notulen talk, jumlah peserta, atau instansi terkait..." style="padding-left: 42px;"></textarea>
                    </div>
                </div>

                <div class="row">
                    <!-- Presenter Photo -->
                    <div class="col-6 form-group-sap mb-4">
                        <label class="form-label-sap">Foto Diri Presenter</label>
                        <input type="file" id="fotoDiriInput" name="fotoDiri" accept="image/*" class="d-none" onchange="previewDiri(this)" />
                        <div class="upload-card" onclick="document.getElementById('fotoDiriInput').click()" style="padding: 16px 8px;">
                            <div id="diriPlaceholder">
                                <i class="bi bi-person-bounding-box" style="font-size: 20px;"></i>
                                <span class="d-block text-white" style="font-size: 11px; font-weight: 700; margin-top: 4px;">Ambil Foto Diri</span>
                            </div>
                            <div id="diriPreviewContainer" class="d-none">
                                <img id="diriPreview" src="" alt="Preview" style="max-width: 100%; max-height: 80px; border-radius: 6px;" />
                            </div>
                        </div>
                    </div>

                    <!-- Event Photo -->
                    <div class="col-6 form-group-sap mb-4">
                        <label class="form-label-sap">Foto Kegiatan Briefing</label>
                        <input type="file" id="fotoKegiatanInput" name="fotoKegiatan" accept="image/*" class="d-none" onchange="previewKegiatan(this)" />
                        <div class="upload-card" onclick="document.getElementById('fotoKegiatanInput').click()" style="padding: 16px 8px;">
                            <div id="kegiatanPlaceholder">
                                <i class="bi bi-camera-fill" style="font-size: 20px;"></i>
                                <span class="d-block text-white" style="font-size: 11px; font-weight: 700; margin-top: 4px;">Ambil Foto Briefing</span>
                            </div>
                            <div id="kegiatanPreviewContainer" class="d-none">
                                <img id="kegiatanPreview" src="" alt="Preview" style="max-width: 100%; max-height: 80px; border-radius: 6px;" />
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-sap-primary w-100 py-3" style="background-color: #f43f5e; border-color: #e11d48;">
                    <i class="bi bi-check-circle-fill me-2"></i> SIMPAN SAFETY TALK
                </button>
            </form>
        </div>

        <!-- History/List Column -->
        <div>
            <div class="history-header mb-3">
                <h6 class="text-white" style="font-weight: 700;"><i class="bi bi-card-list me-2" style="color: var(--color-primary);"></i>Log Briefing Keselamatan</h6>
            </div>
            
            @if (Model == null || !Model.Any())
            {
                <div class="card-sap text-center py-4 text-muted">
                    <i class="bi bi-inbox-fill d-block mb-2" style="font-size: 32px;"></i>
                    Belum ada safety briefing tercatat.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var item in Model)
                    {
                        <div class="card-sap border-red-accent mb-0">
                            
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span style="font-weight: 700; font-size: 14px; color: var(--text-main);">@item.Judul</span>
                                    <span class="d-block text-muted" style="font-size: 11px;"><i class="bi bi-geo-alt-fill me-1"></i>@(item.Lokasi ?? item.Area ?? "General")</span>
                                </div>
                                <span class="status-badge approved" style="font-size: 9px; background-color: rgba(244, 63, 94, 0.15); color: #f43f5e;">
                                    Selesai
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Keterangan))
                            {
                                <p style="font-size: 11px; color: var(--text-muted); background-color: var(--bg-layout); padding: 8px; border-radius: 6px; margin: 8px 0 10px; border-left: 3px solid #f43f5e; white-space: pre-line;">
                                    @item.Keterangan
                                </p>
                            }

                            <!-- Images -->
                            @if (!string.IsNullOrEmpty(item.FotoDiri) || !string.IsNullOrEmpty(item.FotoKegiatan))
                            {
                                @if (item.Nik == userNik)
                                {
                                    <div class="d-flex gap-2 my-2">
                                        @if (!string.IsNullOrEmpty(item.FotoDiri))
                                        {
                                            var displayDiri = item.FotoDiri.StartsWith("http") 
                                                ? "/ImageProxy/Get?url=" + Uri.EscapeDataString(item.FotoDiri) 
                                                : item.FotoDiri;
                                            <a href="@displayDiri" target="_blank">
                                                <img src="@displayDiri" alt="Presenter" style="max-height: 50px; border-radius: 4px; border: 1px solid var(--border-color);" />
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(item.FotoKegiatan))
                                        {
                                            var displayKegiatan = item.FotoKegiatan.StartsWith("http") 
                                                ? "/ImageProxy/Get?url=" + Uri.EscapeDataString(item.FotoKegiatan) 
                                                : item.FotoKegiatan;
                                            <a href="@displayKegiatan" target="_blank">
                                                <img src="@displayKegiatan" alt="Briefing" style="max-height: 50px; border-radius: 4px; border: 1px solid var(--border-color);" />
                                            </a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="px-2 py-1.5 d-flex align-items-center gap-1.5 my-2" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; max-width: fit-content;">
                                        <i class="bi bi-shield-lock-fill text-warning" style="font-size: 13px;"></i>
                                        <span class="text-muted" style="font-size: 10px;">Foto dikunci</span>
                                    </div>
                                }
                            }

                            <div class="d-flex justify-content-between align-items-center pt-2 mt-2" style="border-top: 1px solid var(--border-color); font-size: 11px; color: var(--text-muted);">
                                <div class="d-flex align-items-center gap-2">
                                    <span><i class="bi bi-person me-1"></i>@item.Nama</span>
                                    @if (item.Nik == userNik || isAdmin)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border: 1px solid var(--border-color); background: var(--bg-card); font-size: 13px;">
                                                <li><a class="dropdown-item text-white" href="javascript:void(0)" onclick="editSafetyTalk(@item.Id)"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Laporan</a></li>
                                                <li><hr class="dropdown-divider border-secondary"></li>
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteSafetyTalk(@item.Id)"><i class="bi bi-trash-fill me-2"></i>Hapus Laporan</a></li>
                                            </ul>
                                        </div>
                                    }
                                </div>
                                <span><i class="bi bi-clock me-1"></i>@item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
    </div>
</div>

<!-- Modal Add Benchmark -->
<div class="modal fade" id="addBenchmarkModal" tabindex="-1" aria-labelledby="addBenchmarkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold" id="addBenchmarkModalLabel"><i class="bi bi-plus-square-fill text-primary me-2"></i>Tambah Benchmark Baru</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-4">
                <div class="alert alert-info py-2" style="font-size: 12px; border-radius: 8px;">
                    <i class="bi bi-info-circle me-1"></i> Benchmark yang Anda tambahkan hanya akan terlihat oleh karyawan di perusahaan Anda untuk area yang sedang dipilih.
                </div>
                <div class="form-group-sap mb-3">
                    <label class="form-label-sap">Area Utama</label>
                    <input type="text" id="newBenchmarkArea" class="form-control input-sap" disabled />
                </div>
                <div class="form-group-sap mb-3">
                    <label class="form-label-sap">Nama Benchmark / Detail Lokasi</label>
                    <input type="text" id="newBenchmarkName" class="form-control input-sap text-uppercase" placeholder="Misal: DEPAN POS SECURITY KM 3" />
                    <div id="addBenchmarkError" class="text-danger mt-2" style="font-size: 12px; display: none;"></div>
                </div>
                <div class="mt-3">
                    <h6 class="text-white fw-bold mb-2" style="font-size: 13px;"><i class="bi bi-list-task me-1 text-primary"></i>Daftar Benchmark Terdaftar (di area ini)</h6>
                    <div id="existingBenchmarksList" class="list-group" style="max-height: 180px; overflow-y: auto; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2);">
                        <div class="p-3 text-center text-muted" style="font-size: 12px;">Memuat daftar benchmark...</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">Tutup</button>
                <button type="button" class="btn btn-primary" id="btnSaveBenchmark" onclick="saveNewBenchmark()" style="border-radius: 8px; font-weight: 600;">Simpan Benchmark</button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: white; font-family: 'Poppins', sans-serif;">
    <div class="loader-spinner-container" style="position: relative; width: 100px; height: 100px; display: flex; justify-content: center; align-items: center; margin-bottom: 24px;">
        <div class="loader-circle" style="box-sizing: border-box; width: 80px; height: 80px; border: 4px solid rgba(255, 255, 255, 0.1); border-radius: 50%; border-top-color: #f43f5e; border-bottom-color: #f43f5e; animation: sap-spin 1.5s linear infinite;"></div>
        <i class="bi bi-cloud-arrow-up-fill" style="position: absolute; font-size: 32px; color: white; animation: sap-bounce 2s ease-in-out infinite;"></i>
    </div>
    <h5 id="loadingTitle" style="font-weight: 700; margin-bottom: 8px; letter-spacing: 0.5px; text-align: center; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Memproses Laporan Safety Talk</h5>
    <p id="loadingSubtitle" style="font-size: 13px; color: rgba(255,255,255,0.7); margin-bottom: 16px; text-align: center; max-width: 320px; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">Sedang menyimpan laporan safety talk dan mengunggah lampiran foto. Mohon jangan menutup halaman ini...</p>

    <!-- Progress Bar Container -->
    <div style="width: 280px; background: rgba(255,255,255,0.1); height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.05);">
        <div id="loadingProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #f43f5e, #e11d48); transition: width 0.1s ease; border-radius: 4px;"></div>
    </div>
    <div id="loadingProgressPercent" style="font-size: 14px; font-weight: 700; color: #f43f5e; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">0%</div>
</div>

<style>
    @@keyframes sap-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    @@keyframes sap-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }
</style>

@section Scripts {
    <script>
        function previewDiri(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('diriPreview').src = e.target.result;
                    document.getElementById('diriPlaceholder').classList.add('d-none');
                    document.getElementById('diriPreviewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        function previewKegiatan(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('kegiatanPreview').src = e.target.result;
                    document.getElementById('kegiatanPlaceholder').classList.add('d-none');
                    document.getElementById('kegiatanPreviewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        // Geolocation Function
        function getLocation() {
            var btn = document.getElementById('btnGetLocation');
            var input = document.getElementById('lokasi');
            
            if (navigator.geolocation) {
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 14px; height: 14px;"></span>';
                
                navigator.geolocation.getCurrentPosition(function(position) {
                    var lat = position.coords.latitude.toFixed(6);
                    var lon = position.coords.longitude.toFixed(6);
                    var coords = lat + ", " + lon;
                    
                    if (!input.value || input.value.indexOf(',') !== -1 || input.value === '') {
                        input.value = coords;
                    } else if (input.value.endsWith('- ')) {
                        input.value = input.value + coords;
                    } else {
                        input.value = input.value + " (" + coords + ")";
                    }
                    
                    btn.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
                }, function(error) {
                    console.log('GPS error: ' + error.message);
                    btn.innerHTML = '<i class="bi bi-crosshair text-danger"></i>';
                }, {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                });
            } else {
                alert("Geolocation tidak didukung oleh browser ini.");
            }
        }

        var globalAreasList = [
            { id: 1, namaArea: "Port/Jetty - Indexim" },
            { id: 2, namaArea: "CPP-33 & ROM - Indexim" },
            { id: 3, namaArea: "Kantor - Indexim" },
            { id: 4, namaArea: "Mess & Fasilitas - Indexim" },
            { id: 5, namaArea: "Nursery - Indexim" },
            { id: 6, namaArea: "Settling Pond - Indexim" },
            { id: 7, namaArea: "PIT - Unggul" },
            { id: 8, namaArea: "Road PIT Overburden - Unggul" },
            { id: 9, namaArea: "Kantor - Unggul" },
            { id: 10, namaArea: "Mess & Fasilitas - Unggul" },
            { id: 11, namaArea: "Settling Pond - Unggul" },
            { id: 12, namaArea: "PIT - KPP" },
            { id: 13, namaArea: "Road PIT Overburden - KPP" },
            { id: 14, namaArea: "Kantor - KPP" },
            { id: 15, namaArea: "Mess & Fasilitas - KPP" },
            { id: 16, namaArea: "Settling Pond - KPP" },
            { id: 17, namaArea: "PIT - MGE" },
            { id: 18, namaArea: "Road PIT Overburden - MGE" },
            { id: 19, namaArea: "Kantor - MGE" },
            { id: 20, namaArea: "Mess & Fasilitas - MGE" },
            { id: 21, namaArea: "Settling Pond - MGE" },
            { id: 22, namaArea: "Magazine/Gudang Handak" },
            { id: 23, namaArea: "Road Coal Mining (Jl. Anggrek)" },
            { id: 24, namaArea: "Road Coal Mining (Jl. Mawar)" },
            { id: 25, namaArea: "Road Coal Hauling (Jl. Nusantara)" },
            { id: 26, namaArea: "Other Area" }
        ];

        var globalBenchmarksList = [];

        function loadAreas() {
            var select = $('#area');
            select.empty();
            select.append('<option value="" disabled selected></option>');
            globalAreasList.forEach(function(item) {
                select.append('<option value="' + item.namaArea + '">' + item.namaArea + '</option>');
            });
            renderAreaDropdown('');
            $('#areaDropdownMenu').hide();
        }

        function renderAreaDropdown(filterText) {
            var menu = $('#areaDropdownMenu');
            menu.empty();
            var clean = (filterText || '').trim().toLowerCase();
            var filtered = globalAreasList.filter(function(a) {
                return a.namaArea.toLowerCase().includes(clean);
            });

            if (filtered.length > 0) {
                filtered.forEach(function(item) {
                    var btn = $('<button type="button"></button>')
                        .addClass('d-block w-100 text-start py-2 px-3 border-0 area-option-btn')
                        .css({
                            background: 'none',
                            color: 'var(--text-main)',
                            fontSize: '13px',
                            borderBottom: '1px solid var(--border-color)',
                            cursor: 'pointer'
                        })
                        .html('<i class="bi bi-geo-alt-fill me-2 text-primary"></i>' + item.namaArea)
                        .on('mouseenter', function() { $(this).css('background', 'var(--bg-layout)'); })
                        .on('mouseleave', function() { $(this).css('background', 'none'); })
                        .on('click', function() {
                            selectArea(item.namaArea);
                        });
                    menu.append(btn);
                });
            } else if (clean.length > 0) {
                menu.append('<div class="p-3 text-center text-muted" style="font-size:12px;"><i class="bi bi-search me-1"></i>Area "' + filterText + '" tidak ditemukan</div>');
            } else {
                menu.append('<div class="p-3 text-center text-muted" style="font-size:12px;">Belum ada Area Utama.</div>');
            }
            
            if (menu.children().length > 0) menu.show(); else menu.hide();
        }

        function selectArea(namaArea) {
            $('#areaSearch').val(namaArea);
            $('#area').val(namaArea);
            $('#areaDropdownMenu').hide();
            $('#areaSearch').removeClass('is-invalid');
            
            // Load Benchmarks for this area
            loadBenchmarks(namaArea);
            
            // Auto-fill Lokasi Spesifik
            var currentLokasi = $('#lokasi').val().trim();
            if (currentLokasi === '') {
                $('#lokasi').val(namaArea + ' - ');
                $('#lokasi').focus();
            } else if (currentLokasi.indexOf(' - ') !== -1) {
                var parts = currentLokasi.split(' - ');
                parts[0] = namaArea;
                $('#lokasi').val(parts.join(' - '));
            } else {
                $('#lokasi').val(namaArea + ' - ' + currentLokasi);
            }
        }

        function loadBenchmarks(areaUtama, preselectBenchmark) {
            if (!areaUtama) return;
            $('#benchmarkSearch').prop('disabled', true).val('Memuat benchmark...');
            $('#btnAddBenchmark').prop('disabled', true);
            
            $.ajax({
                url: '/Api/GetBenchmarks',
                type: 'GET',
                data: { areaUtama: areaUtama },
                success: function(response) {
                    globalBenchmarksList = response || [];
                    $('#benchmarkSearch').prop('disabled', false).val('');
                    $('#btnAddBenchmark').prop('disabled', false);
                    
                    if (preselectBenchmark) {
                        selectBenchmark(preselectBenchmark);
                    } else {
                        $('#detilLokasi').val('');
                        renderBenchmarkDropdown('');
                        $('#benchmarkDropdownMenu').show();
                        setTimeout(function() {
                            $('#benchmarkSearch').focus();
                        }, 50);
                    }
                    renderBenchmarkDropdown('');
                },
                error: function() {
                    $('#benchmarkSearch').prop('disabled', false).val('');
                    $('#btnAddBenchmark').prop('disabled', false);
                }
            });
        }

        function renderBenchmarkDropdown(filterText) {
            var menu = $('#benchmarkDropdownMenu');
            menu.empty();
            var clean = (filterText || '').trim().toLowerCase();
            var filtered = globalBenchmarksList.filter(function(b) {
                return b.namaBenchmark.toLowerCase().includes(clean);
            });

            if (filtered.length > 0) {
                filtered.forEach(function(item) {
                    var btn = $('<button type="button"></button>')
                        .addClass('d-block w-100 text-start py-2 px-3 border-0 area-option-btn')
                        .css({
                            background: 'none',
                            color: 'var(--text-main)',
                            fontSize: '13px',
                            borderBottom: '1px solid var(--border-color)',
                            cursor: 'pointer'
                        })
                        .html('<i class="bi bi-compass-fill me-2 text-primary"></i>' + item.namaBenchmark)
                        .on('mouseenter', function() { $(this).css('background', 'var(--bg-layout)'); })
                        .on('mouseleave', function() { $(this).css('background', 'none'); })
                        .on('click', function() {
                            selectBenchmark(item.namaBenchmark);
                        });
                    menu.append(btn);
                });
            } else if (clean.length > 0) {
                menu.append('<div class="p-3 text-center text-muted" style="font-size:12px;"><i class="bi bi-search me-1"></i>Benchmark "' + filterText + '" tidak ditemukan</div>');
            } else {
                menu.append('<div class="p-3 text-center text-muted" style="font-size:12px;">Belum ada benchmark di area ini. Klik + untuk tambah.</div>');
            }
            
            if (menu.children().length > 0) menu.show(); else menu.hide();
        }

        function selectBenchmark(namaBenchmark) {
            $('#benchmarkSearch').val(namaBenchmark);
            $('#detilLokasi').val(namaBenchmark);
            $('#benchmarkDropdownMenu').hide();
            $('#benchmarkSearch').removeClass('is-invalid');
        }

        function saveNewBenchmark() {
            var btn = $('#btnSaveBenchmark');
            var errorDiv = $('#addBenchmarkError');
            var benchmarkName = $('#newBenchmarkName').val();
            var areaUtama = $('#area').val();

            if (!areaUtama) {
                errorDiv.text('Area utama belum dipilih!').show();
                return;
            }

            if (!benchmarkName || benchmarkName.trim() === '') {
                errorDiv.text('Nama benchmark tidak boleh kosong').show();
                return;
            }

            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Menyimpan...');
            errorDiv.hide();

            $.ajax({
                url: '/Api/AddBenchmark',
                type: 'POST',
                dataType: 'json',
                data: { areaUtama: areaUtama, namaBenchmark: benchmarkName },
                success: function(response) {
                    $('#addBenchmarkModal').modal('hide');
                    $('#newBenchmarkName').val('');
                    var benchmarkToSelect = (response && response.data) ? response.data.namaBenchmark : null;
                    loadBenchmarks(areaUtama, benchmarkToSelect);
                    btn.prop('disabled', false).text('Simpan Benchmark');
                },
                error: function(xhr) {
                    errorDiv.text(xhr.responseText || 'Terjadi kesalahan saat menyimpan benchmark').show();
                    btn.prop('disabled', false).text('Simpan Benchmark');
                }
            });
        }

        function cancelEditSafetyTalk() {
            $('#safetyTalkForm')[0].reset();
            $('#talkId').val('');
            $('#formTitle').html('<i class="bi bi-megaphone-fill me-2" style="color: #f43f5e;"></i>Catat Safety Talk Baru');
            $('#btnCancelEdit').addClass('d-none');
            
            // Reset images
            $('#diriPreview, #kegiatanPreview').attr('src', '');
            $('#diriPreviewContainer, #kegiatanPreviewContainer').addClass('d-none');
            $('#diriPlaceholder, #kegiatanPlaceholder').removeClass('d-none');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function editSafetyTalk(id) {
            $.get('/SafetyTalk/GetData/' + id, function(data) {
                if (data) {
                    $('#talkId').val(data.id);
                    
                    // Format dates and times
                    if (data.tanggal) $('#tanggal').val(data.tanggal.split('T')[0]);
                    if (data.waktu) $('#waktuStr').val(data.waktu.substring(0, 5));
                    
                    // Selects
                    $('#area').val(data.area);
                    $('#areaSearch').val(data.area);

                    // Inputs
                    $('#lokasi').val(data.lokasi);
                    $('#detilLokasi').val(data.detilLokasi);
                    
                    if (data.area) {
                        loadBenchmarks(data.area, data.detilLokasi);
                    } else {
                        $('#benchmarkSearch').prop('disabled', true).val('Pilih Area Utama dulu...');
                        $('#btnAddBenchmark').prop('disabled', true);
                    }
                    $('#judul').val(data.judul);
                    $('#keterangan').val(data.keterangan);

                    $('#formTitle').html('<i class="bi bi-pencil-square me-2" style="color: var(--color-primary);"></i>Edit Laporan Safety Talk');
                    $('#btnCancelEdit').removeClass('d-none');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }).fail(function() {
                alert("Gagal mengambil data laporan. Laporan mungkin sudah dihapus.");
            });
        }

        function deleteSafetyTalk(id) {
            if (confirm("Apakah Anda yakin ingin menghapus laporan ini? Data yang dihapus tidak dapat dikembalikan.")) {
                var form = $('<form action="/SafetyTalk/Delete/' + id + '" method="post">' +
                             '<input type="hidden" name="__RequestVerificationToken" value="' + $('input[name="__RequestVerificationToken"]').val() + '" />' +
                             '</form>');
                $('body').append(form);
                form.submit();
            }
        }

        $(document).ready(function() {
            loadAreas();
            $('#addBenchmarkModal').on('show.bs.modal', function () {
                var area = $('#area').val();
                if(!area) {
                    alert('Pilih Area Utama terlebih dahulu!');
                    return false; // Prevent modal from opening
                }
                $('#newBenchmarkArea').val(area);
                $('#newBenchmarkName').val('');
                $('#addBenchmarkError').hide();
                
                // Populate existing benchmarks in modal
                var list = $('#existingBenchmarksList');
                list.empty();
                if(globalBenchmarksList.length > 0) {
                    globalBenchmarksList.forEach(function(b) {
                        list.append('<div class="list-group-item" style="font-size: 13px; background: rgba(0,0,0,0.1); border-color: var(--border-color); color: var(--text-main);"><i class="bi bi-compass me-2 text-muted"></i>' + b.namaBenchmark + '</div>');
                    });
                } else {
                    list.append('<div class="p-3 text-center text-muted" style="font-size: 12px;">Belum ada benchmark di area ini</div>');
                }
            });

            // Toggle area dropdown on chevron click
            $('#toggleAreaDropdown').on('click', function() {
                var menu = $('#areaDropdownMenu');
                if (menu.is(':visible')) {
                    menu.hide();
                } else {
                    renderAreaDropdown($('#areaSearch').val());
                    menu.show();
                }
            });

            // Filter dropdown on keyup
            $('#areaSearch').on('input keyup', function() {
                renderAreaDropdown($(this).val());
            });

            // Open dropdown on focus
            $('#areaSearch').on('focus', function() {
                renderAreaDropdown($(this).val());
            });

            // Toggle benchmark dropdown on chevron click
            $('#toggleBenchmarkDropdown').on('click', function() {
                if ($('#benchmarkSearch').prop('disabled')) return;
                var menu = $('#benchmarkDropdownMenu');
                if (menu.is(':visible')) {
                    menu.hide();
                } else {
                    renderBenchmarkDropdown($('#benchmarkSearch').val());
                    menu.show();
                }
            });

            // Filter dropdown on keyup
            $('#benchmarkSearch').on('input keyup', function() {
                renderBenchmarkDropdown($(this).val());
                if($(this).val() === '') $('#detilLokasi').val('');
            });

            // Open dropdown on focus
            $('#benchmarkSearch').on('focus', function() {
                if ($('#benchmarkSearch').prop('disabled')) return;
                renderBenchmarkDropdown($(this).val());
            });

            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#benchmarkSearch, #benchmarkDropdownMenu, #toggleBenchmarkDropdown').length) {
                    $('#benchmarkDropdownMenu').hide();
                }
                if (!$(e.target).closest('#areaSearch, #areaDropdownMenu, #toggleAreaDropdown').length) {
                    $('#areaDropdownMenu').hide();
                }
            });
            // Prevent double submission
            let safetyTalkSubmitting = false;
            $('#safetyTalkForm').on('submit', function(e) {
                e.preventDefault();

                if (safetyTalkSubmitting) return false;

                var btn = $(this).find('button[type="submit"]');
                if (btn.prop('disabled')) {
                    return false;
                }

                // Custom validation
                let isValid = true;
                let firstInvalid = null;
                
                $('#safetyTalkForm').find('.is-invalid').removeClass('is-invalid');
                $('#safetyTalkForm').find('.sap-err-msg').remove();

                const fieldsToValidate = {
                    'tanggal': 'Tanggal',
                    'waktuStr': 'Waktu',
                    'area': 'Area Utama',
                    'lokasi': 'Lokasi Spesifik',
                    'judul': 'Topik / Judul'
                };

                // Validate visible input/select/textarea
                $('#safetyTalkForm').find('input[required]:visible, select[required]:visible, textarea[required]:visible').each(function() {
                    const $el = $(this);
                    const id = $el.attr('id') || $el.attr('name');
                    const val = $el.val();
                    
                    if (!val || val.toString().trim() === '') {
                        isValid = false;
                        $el.addClass('is-invalid');
                        if (!firstInvalid) firstInvalid = $el;
                        
                        const labelName = fieldsToValidate[id] || $el.closest('.form-group-sap').find('label').text() || 'Field';
                        const errHtml = `<span class="text-danger sap-err-msg d-block mt-1"><i class="bi bi-exclamation-circle-fill me-1"></i>${labelName.replace(':', '').replace('*', '').trim()} wajib diisi.</span>`;
                        
                        const $wrapper = $el.closest('.input-sap-wrapper');
                        if ($wrapper.length) {
                            $wrapper.after(errHtml);
                        } else {
                            $el.after(errHtml);
                        }
                    }
                });

                if (!isValid) {
                    if (firstInvalid) {
                        $('html, body').animate({
                            scrollTop: firstInvalid.offset().top - 120
                        }, 300);
                    }
                    return false;
                }

                // Additional check for hidden area field
                var areaVal = $('#area').val();
                if (!areaVal || areaVal.trim() === '') {
                    $('#areaSearch').addClass('is-invalid');
                    if (!$('#areaSearch').closest('.input-sap-wrapper').next('.sap-err-msg').length) {
                        $('#areaSearch').closest('.input-sap-wrapper').after(`<span class="text-danger sap-err-msg d-block mt-1"><i class="bi bi-exclamation-circle-fill me-1"></i>Area Utama wajib dipilih dari dropdown.</span>`);
                    }
                    $('html, body').animate({
                        scrollTop: $('#areaSearch').offset().top - 120
                    }, 300);
                    return false;
                }

                safetyTalkSubmitting = true;
                btn.prop('disabled', true);
                btn.css('pointer-events', 'none');
                var originalText = btn.html();
                btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>MENYIMPAN...');
                
                const $overlay = $('#loadingOverlay');
                const $progressBar = $('#loadingProgressBar');
                const $progressPercent = $('#loadingProgressPercent');
                const $title = $('#loadingTitle');
                const $subtitle = $('#loadingSubtitle');

                $overlay.css('display', 'flex');
                $title.text('Menyiapkan Data...');
                $subtitle.text('Sedang memproses laporan safety talk...');
                $progressBar.css('width', '0%');
                $progressPercent.text('0%');

                const formData = new FormData($('#safetyTalkForm')[0]);

                $.ajax({
                    url: '/SafetyTalk/Submit',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    xhr: function() {
                        const xhr = new window.XMLHttpRequest();
                        xhr.upload.addEventListener('progress', function(evt) {
                            if (evt.lengthComputable) {
                                const percentComplete = Math.round((evt.loaded / evt.total) * 100);
                                $progressBar.css('width', percentComplete + '%');
                                $progressPercent.text(percentComplete + '%');
                                if (percentComplete === 100) {
                                    $title.text('Memproses di Server...');
                                    $subtitle.text('Mohon tunggu, server sedang menyimpan data...');
                                }
                            }
                        }, false);
                        return xhr;
                    },
                    success: function(response) {
                        $title.text('Selesai!');
                        $subtitle.text(response.message || 'Laporan safety talk berhasil disimpan.');
                        $progressBar.css('width', '100%');
                        $progressPercent.text('100%');
                        
                        setTimeout(() => {
                            window.location.href = '/Home/Index';
                        }, 800);
                    },
                    error: function(xhr, status, error) {
                        $overlay.css('display', 'none');
                        btn.prop('disabled', false);
                        btn.css('pointer-events', 'auto');
                        btn.html(originalText);
                        safetyTalkSubmitting = false;
                        
                        let errMessage = "Gagal mengirim data. Silakan periksa koneksi internet Anda.";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                const parsed = JSON.parse(xhr.responseText);
                                if (parsed && parsed.message) errMessage = parsed.message;
                            } catch(e) {}
                        }
                        
                        alert(errMessage);
                    }
                });

                return false;
            });
        });
    </script>
}
