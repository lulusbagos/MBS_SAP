@model IEnumerable<MBS_SAP.Models.P2hReport>
@{
    ViewData["Title"] = "P2H - Pemeriksaan Harian Kendaraan";
    var vehiclesList = ViewBag.Vehicles as List<MBS_SAP.Models.P2hVehicle> ?? new List<MBS_SAP.Models.P2hVehicle>();
    var userNik = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAdmin = User.IsInRole("Admin");
    var minDate = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
    var maxDate = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
}

<style>
    @@keyframes sap-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    @@keyframes sap-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }
    .unit-option-btn:hover {
        background-color: rgba(2, 132, 199, 0.15) !important;
        color: #38bdf8 !important;
    }
    .checkpoint-row {
        transition: background-color 0.15s ease;
    }
    .checkpoint-row:hover {
        background-color: rgba(255, 255, 255, 0.02);
    }
    .p2h-badge-log {
        background-color: rgba(2, 132, 199, 0.18) !important;
        border: 1px solid rgba(56, 189, 248, 0.45) !important;
        color: #bae6fd !important;
        font-size: 11px !important;
        font-weight: 600 !important;
        padding: 4px 10px !important;
        border-radius: 20px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
    }
    [data-bs-theme="light"] .p2h-badge-log,
    body.light-theme .p2h-badge-log {
        background-color: rgba(2, 132, 199, 0.12) !important;
        border-color: rgba(2, 132, 199, 0.35) !important;
        color: #0369a1 !important;
    }
</style>

<div class="animate-fade-in pb-4">
    <!-- Header with Banner -->
    <div class="position-relative mb-4" style="margin: -20px -20px 20px -20px;">
        <div style="background: linear-gradient(135deg, #0284c7, #38bdf8); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; padding: 32px 20px 24px; text-align: center; position: relative; overflow: hidden;">
            <!-- Decorative circles -->
            <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: -30px; left: -10px; width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            
            <i class="bi bi-truck-front-fill text-white mb-2 d-block" style="font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
            <h4 style="font-weight: 800; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.2); margin-bottom: 4px; letter-spacing: 0.5px;">P2H - PEMERIKSAAN KENDARAAN</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 12px; margin: 0; font-weight: 500;">Pemeriksaan kondisi unit dan kelayakan operasional harian sebelum bekerja.</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(244, 63, 94, 0.15); color: var(--color-red); border-radius: 12px;">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.15); color: #10b981; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hybrid Grid Layout: Form and List side-by-side on laptop, stacked on mobile -->
    <div class="form-responsive-row">
        <!-- Form Column -->
        <div class="card-sap border-primary-accent" style="overflow: visible;">
            <form asp-controller="P2h" asp-action="Create" method="post" id="p2hForm" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="p2hId" name="id" value="" />
                
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0" style="font-weight: 700; color: var(--text-main);" id="formTitle">
                        <i class="bi bi-truck-front-fill me-2 text-primary"></i>Form Pemeriksaan P2H Baru
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelEdit" onclick="cancelEditP2h()">
                        <i class="bi bi-x-circle me-1"></i> Batal Edit
                    </button>
                </div>
                
                <!-- Date and Time -->
                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="tanggal">Tanggal Pemeriksaan</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-calendar-event-fill input-sap-icon"></i>
                            <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@minDate" max="@maxDate" required />
                        </div>
                    </div>
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="waktuStr">Waktu Pemeriksaan</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-clock-fill input-sap-icon"></i>
                            <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                        </div>
                    </div>
                </div>

                <!-- User Info (Read-Only) -->
                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap">NIK Pemeriksa</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-person-badge-fill input-sap-icon"></i>
                            <input type="text" class="input-sap text-muted" value="@ViewBag.UserNik" readonly style="background-color: rgba(255,255,255,0.03);" />
                        </div>
                    </div>
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap">Nama Pemeriksa</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-person-fill input-sap-icon"></i>
                            <input type="text" class="input-sap text-muted" value="@ViewBag.UserNama" readonly style="background-color: rgba(255,255,255,0.03);" />
                        </div>
                    </div>
                </div>

                <!-- Unit & Brand Info -->
                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="noLambungInput">No. Lambung Kendaraan</label>
                        <div class="position-relative">
                            <div class="input-sap-wrapper mb-0">
                                <i class="bi bi-truck-flatbed input-sap-icon"></i>
                                <input type="text" id="noLambungInput" name="noLambung" class="input-sap text-uppercase" placeholder="Cari / Masukkan No Lambung..." autocomplete="off" required style="padding-right: 40px;" />
                                <i class="bi bi-chevron-down position-absolute" style="right: 12px; top: 14px; color: var(--text-muted); cursor: pointer;" id="toggleUnitDropdown"></i>
                            </div>
                            <div id="unitDropdownMenu" style="display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 1050; background: var(--bg-card); border: 1px solid var(--border-color); max-height: 250px; overflow-y: auto; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.25); padding: 4px;">
                                <!-- Loaded dynamically by JS -->
                            </div>
                        </div>
                        <small class="text-muted" style="font-size: 10px;">Ketik untuk mencari unit, atau masukkan nama baru jika belum terdaftar.</small>
                    </div>
                    
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="merek">Merek / Tipe Kendaraan</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-info-circle-fill input-sap-icon"></i>
                            <input type="text" id="merek" name="merek" class="input-sap text-uppercase" placeholder="Misal: TRITON 2.5L" required />
                        </div>
                    </div>
                </div>

                <!-- Vehicle Type & Odometer -->
                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="jenisKendaraan">Jenis Kendaraan</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-car-front-fill input-sap-icon"></i>
                            <select id="jenisKendaraan" name="jenisKendaraan" class="input-sap" required>
                                <option value="" disabled selected>Pilih Jenis...</option>
                                <option value="LIGHT VEHICLE">LIGHT VEHICLE</option>
                                <option value="DUMP TRUCK">DUMP TRUCK</option>
                                <option value="HEAVY EQUIPMENT">HEAVY EQUIPMENT (ALAT BERAT)</option>
                                <option value="BUS / MANTRIP">BUS / MANTRIP</option>
                                <option value="MOTORCYCLE">MOTORCYCLE</option>
                                <option value="OTHER">OTHER</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="kilometer">Odometer / Kilometer</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-speedometer input-sap-icon"></i>
                            <input type="number" step="any" id="kilometer" name="kilometer" class="input-sap" placeholder="Misal: 11111" required />
                        </div>
                    </div>
                </div>

                <!-- SIMPER / KIMPER & Speedometer Photo -->
                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="simperKimper">Memiliki SIMPER / KIMPER yang Aktif?</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-card-heading input-sap-icon"></i>
                            <select id="simperKimper" name="simperKimper" class="input-sap" required>
                                <option value="YA">YA</option>
                                <option value="TIDAK">TIDAK</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="fotoSpeedometer">Foto Speedometer <span class="text-danger">*</span></label>
                        <input type="file" id="fotoSpeedometer" name="fotoSpeedometer" accept="image/*" class="d-none" onchange="previewSpeedo(this)" />
                        <div class="upload-card" onclick="document.getElementById('fotoSpeedometer').click()" style="padding: 16px 12px; border-color: rgba(2, 132, 199, 0.4);">
                            <div id="speedoPlaceholder">
                                <i class="bi bi-speedometer2 text-primary" style="font-size: 24px;"></i>
                                <span class="d-block" style="font-size: 12px; font-weight: 700; margin-top: 4px; color: var(--text-main);">Unggah Foto Speedometer</span>
                            </div>
                            <div id="speedoPreviewContainer" class="d-none">
                                <img id="speedoPreview" src="" alt="Speedometer Preview" style="max-width: 100%; max-height: 100px; border-radius: 6px;" />
                            </div>
                        </div>
                        <small class="text-muted" style="font-size: 10px;" id="speedoHelp">Wajib melampirkan foto speedometer terbaru.</small>
                    </div>
                </div>

                <!-- Checklist Header + Quick Actions -->
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3 flex-wrap gap-2">
                    <h6 class="mb-0" style="font-weight: 700; color: var(--text-main); border-left: 3px solid var(--color-primary); padding-left: 8px;">CHECKLIST KONDISI UNIT</h6>
                    <div class="d-flex gap-2" id="quickActionBtns">
                        <button type="button" class="btn btn-sm px-3 py-1" id="btnAllGood" onclick="autoFillAll('GOOD')" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 20px; font-size: 11px; font-weight: 700; letter-spacing: 0.3px; box-shadow: 0 2px 8px rgba(16,185,129,0.3); transition: all 0.2s ease;">
                            <i class="bi bi-check-all me-1"></i>Semua BAIK
                        </button>
                        <button type="button" class="btn btn-sm px-3 py-1" id="btnAllBad" onclick="autoFillAll('NOT_GOOD')" style="background: linear-gradient(135deg, #f43f5e, #e11d48); color: white; border: none; border-radius: 20px; font-size: 11px; font-weight: 700; letter-spacing: 0.3px; box-shadow: 0 2px 8px rgba(244,63,94,0.3); transition: all 0.2s ease;">
                            <i class="bi bi-x-circle me-1"></i>Semua RUSAK
                        </button>
                    </div>
                </div>

                <!-- Accordion checklist -->
                <div class="accordion mb-4" id="checklistAccordion">
                    
                    <!-- GOLONGAN A -->
                    <div class="accordion-item" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
                        <h2 class="accordion-header" id="headingA">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseA" aria-expanded="true" aria-controls="collapseA" style="background-color: rgba(244, 63, 94, 0.08); color: var(--text-main); font-weight: bold; border: none; box-shadow: none;">
                                <span class="badge bg-danger me-2">GOL. A</span> Kritis (Harus Baik - Total 16 Item)
                            </button>
                        </h2>
                        <div id="collapseA" class="accordion-collapse collapse show" aria-labelledby="headingA" data-bs-parent="#checklistAccordion">
                            <div class="accordion-body border-top border-secondary pt-3" style="background-color: rgba(0,0,0,0.1);">
                                @for (int i = 0; i < MBS_SAP.Controllers.P2hController.GolA.Length; i++)
                                {
                                    var idx = i;
                                    var itemText = MBS_SAP.Controllers.P2hController.GolA[idx];
                                    <div class="checkpoint-row py-2 border-bottom border-secondary mb-2" id="row_golA_@idx">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <span class="fs-13 fw-semibold" style="color: var(--text-main);">@(idx + 1). @itemText</span>
                                            
                                            <div class="d-flex gap-2">
                                                <input type="radio" class="btn-check" name="golA_status_@idx" id="golA_good_@idx" value="GOOD" checked autocomplete="off" onchange="toggleDefectPhoto('golA', @idx, 'GOOD')">
                                                <label class="btn btn-sm btn-outline-success px-3" for="golA_good_@idx" style="border-radius: 20px; font-size: 11px; font-weight: bold;">BAIK</label>

                                                <input type="radio" class="btn-check" name="golA_status_@idx" id="golA_bad_@idx" value="NOT_GOOD" autocomplete="off" onchange="toggleDefectPhoto('golA', @idx, 'NOT_GOOD')">
                                                <label class="btn btn-sm btn-outline-danger px-3" for="golA_bad_@idx" style="border-radius: 20px; font-size: 11px; font-weight: bold;">RUSAK</label>
                                            </div>
                                        </div>

                                        <!-- Photo upload wrapper shown if status is NOT_GOOD -->
                                        <div class="defect-photo-wrapper mt-2 ps-3" id="photo_wrapper_golA_@idx" style="display: none; border-left: 2px solid var(--color-red);">
                                            <label class="form-label-sap mb-1" style="font-size: 11px; color: var(--color-red); font-weight: 600;">
                                                <i class="bi bi-camera-fill me-1"></i> Foto Kerusakan (Wajib)
                                            </label>
                                            <input type="file" name="golA_photo_@idx" id="photo_input_golA_@idx" class="input-sap py-1" accept="image/*" style="height: auto; border-color: rgba(244, 63, 94, 0.4);" />
                                            <div id="photo_preview_wrapper_golA_@idx" class="mt-1 d-none">
                                                <span class="text-muted" style="font-size: 10px;">Foto terunggah: </span>
                                                <a id="photo_preview_link_golA_@idx" href="#" target="_blank" class="text-primary fw-semibold ms-1" style="font-size: 10px;">Lihat Foto</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- GOLONGAN B -->
                    <div class="accordion-item" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
                        <h2 class="accordion-header" id="headingB">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseB" aria-expanded="false" aria-controls="collapseB" style="background-color: rgba(234, 179, 8, 0.08); color: var(--text-main); font-weight: bold; border: none; box-shadow: none;">
                                <span class="badge bg-warning text-dark me-2">GOL. B</span> Penting (Total 10 Item)
                            </button>
                        </h2>
                        <div id="collapseB" class="accordion-collapse collapse" aria-labelledby="headingB" data-bs-parent="#checklistAccordion">
                            <div class="accordion-body border-top border-secondary pt-3" style="background-color: rgba(0,0,0,0.1);">
                                @for (int i = 0; i < MBS_SAP.Controllers.P2hController.GolB.Length; i++)
                                {
                                    var idx = i;
                                    var itemText = MBS_SAP.Controllers.P2hController.GolB[idx];
                                    <div class="checkpoint-row py-2 border-bottom border-secondary mb-2" id="row_golB_@idx">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <span class="fs-13 fw-semibold" style="color: var(--text-main);">@(idx + 1). @itemText</span>
                                            
                                            <div class="d-flex gap-2">
                                                <input type="radio" class="btn-check" name="golB_status_@idx" id="golB_good_@idx" value="GOOD" checked autocomplete="off" onchange="toggleDefectPhoto('golB', @idx, 'GOOD')">
                                                <label class="btn btn-sm btn-outline-success px-3" for="golB_good_@idx" style="border-radius: 20px; font-size: 11px; font-weight: bold;">BAIK</label>

                                                <input type="radio" class="btn-check" name="golB_status_@idx" id="golB_bad_@idx" value="NOT_GOOD" autocomplete="off" onchange="toggleDefectPhoto('golB', @idx, 'NOT_GOOD')">
                                                <label class="btn btn-sm btn-outline-danger px-3" for="golB_bad_@idx" style="border-radius: 20px; font-size: 11px; font-weight: bold;">RUSAK</label>
                                            </div>
                                        </div>

                                        <!-- Photo upload wrapper shown if status is NOT_GOOD -->
                                        <div class="defect-photo-wrapper mt-2 ps-3" id="photo_wrapper_golB_@idx" style="display: none; border-left: 2px solid var(--color-red);">
                                            <label class="form-label-sap mb-1" style="font-size: 11px; color: var(--color-red); font-weight: 600;">
                                                <i class="bi bi-camera-fill me-1"></i> Foto Kerusakan (Wajib)
                                            </label>
                                            <input type="file" name="golB_photo_@idx" id="photo_input_golB_@idx" class="input-sap py-1" accept="image/*" style="height: auto; border-color: rgba(244, 63, 94, 0.4);" />
                                            <div id="photo_preview_wrapper_golB_@idx" class="mt-1 d-none">
                                                <span class="text-muted" style="font-size: 10px;">Foto terunggah: </span>
                                                <a id="photo_preview_link_golB_@idx" href="#" target="_blank" class="text-primary fw-semibold ms-1" style="font-size: 10px;">Lihat Foto</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- GOLONGAN C -->
                    <div class="accordion-item" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
                        <h2 class="accordion-header" id="headingC">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseC" aria-expanded="false" aria-controls="collapseC" style="background-color: rgba(2, 132, 199, 0.08); color: var(--text-main); font-weight: bold; border: none; box-shadow: none;">
                                <span class="badge bg-info text-dark me-2">GOL. C</span> Umum (Total 11 Item)
                            </button>
                        </h2>
                        <div id="collapseC" class="accordion-collapse collapse" aria-labelledby="headingC" data-bs-parent="#checklistAccordion">
                            <div class="accordion-body border-top border-secondary pt-3" style="background-color: rgba(0,0,0,0.1);">
                                @for (int i = 0; i < MBS_SAP.Controllers.P2hController.GolC.Length; i++)
                                {
                                    var idx = i;
                                    var itemText = MBS_SAP.Controllers.P2hController.GolC[idx];
                                    <div class="checkpoint-row py-2 border-bottom border-secondary mb-2" id="row_golC_@idx">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <span class="fs-13 fw-semibold" style="color: var(--text-main);">@(idx + 1). @itemText</span>
                                            
                                            <div class="d-flex gap-2">
                                                <input type="radio" class="btn-check" name="golC_status_@idx" id="golC_good_@idx" value="GOOD" checked autocomplete="off" onchange="toggleDefectPhoto('golC', @idx, 'GOOD')">
                                                <label class="btn btn-sm btn-outline-success px-3" for="golC_good_@idx" style="border-radius: 20px; font-size: 11px; font-weight: bold;">BAIK</label>

                                                <input type="radio" class="btn-check" name="golC_status_@idx" id="golC_bad_@idx" value="NOT_GOOD" autocomplete="off" onchange="toggleDefectPhoto('golC', @idx, 'NOT_GOOD')">
                                                <label class="btn btn-sm btn-outline-danger px-3" for="golC_bad_@idx" style="border-radius: 20px; font-size: 11px; font-weight: bold;">RUSAK</label>
                                            </div>
                                        </div>

                                        <!-- Photo upload wrapper shown if status is NOT_GOOD -->
                                        <div class="defect-photo-wrapper mt-2 ps-3" id="photo_wrapper_golC_@idx" style="display: none; border-left: 2px solid var(--color-red);">
                                            <label class="form-label-sap mb-1" style="font-size: 11px; color: var(--color-red); font-weight: 600;">
                                                <i class="bi bi-camera-fill me-1"></i> Foto Kerusakan (Wajib)
                                            </label>
                                            <input type="file" name="golC_photo_@idx" id="photo_input_golC_@idx" class="input-sap py-1" accept="image/*" style="height: auto; border-color: rgba(244, 63, 94, 0.4);" />
                                            <div id="photo_preview_wrapper_golC_@idx" class="mt-1 d-none">
                                                <span class="text-muted" style="font-size: 10px;">Foto terunggah: </span>
                                                <a id="photo_preview_link_golC_@idx" href="#" target="_blank" class="text-primary fw-semibold ms-1" style="font-size: 10px;">Lihat Foto</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <button type="submit" id="btnSubmitP2h" class="btn btn-sap-primary w-100 py-3" style="background: linear-gradient(135deg, #0284c7, #0ea5e9); border-color: #0284c7; font-weight: 700; border-radius: 12px; letter-spacing: 0.5px;">
                    <i class="bi bi-check-circle-fill me-2"></i> KIRIM LAPORAN P2H
                </button>
            </form>
        </div>

        <!-- History Column -->
        <div>
            <div class="history-header mb-3">
                <h6 style="font-weight: 700; color: var(--text-main);">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Histori Pemeriksaan P2H
                </h6>
            </div>
            
            @if (Model == null || !Model.Any())
            {
                <div class="card-sap text-center py-4 text-muted">
                    <i class="bi bi-inbox-fill d-block mb-2" style="font-size: 32px;"></i>
                    Belum ada histori pemeriksaan P2H tercatat.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @{ int loopIndex = 1; }
                    @foreach (var item in Model)
                    {
                        var delayClass = "delay-" + (loopIndex > 6 ? 6 : loopIndex);
                        
                        var defectsA = new List<string>();
                        var defectsB = new List<string>();
                        var defectsC = new List<string>();
                        
                        try
                        {
                            if (!string.IsNullOrEmpty(item.GolA_Json))
                            {
                                var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolA_Json);
                                if (list != null) defectsA.AddRange(list.Where(x => x.Status == "NOT_GOOD").Select(x => x.Name));
                            }
                            if (!string.IsNullOrEmpty(item.GolB_Json))
                            {
                                var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolB_Json);
                                if (list != null) defectsB.AddRange(list.Where(x => x.Status == "NOT_GOOD").Select(x => x.Name));
                            }
                            if (!string.IsNullOrEmpty(item.GolC_Json))
                            {
                                var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolC_Json);
                                if (list != null) defectsC.AddRange(list.Where(x => x.Status == "NOT_GOOD").Select(x => x.Name));
                            }
                        }
                        catch {}

                        var totalDefects = defectsA.Count + defectsB.Count + defectsC.Count;
                        var isGood = totalDefects == 0;
                        var borderClass = isGood ? "border-primary-accent" : "border-red-accent";
                        var resultBadgeClass = isGood ? "bg-success" : "bg-danger";
                        var statusText = isGood ? "AMAN (GOOD)" : $"{totalDefects} TEMUAN";

                        <div class="card-sap animate-fade-in @delayClass @borderClass mb-0">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 32px; height: 32px; font-size: 15px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: rgba(2, 132, 199, 0.15); color: #38bdf8;">
                                        <i class="bi bi-truck-front-fill"></i>
                                    </div>
                                    <div>
                                        <span style="font-weight: 700; font-size: 14px; color: var(--text-main);">@item.NoLambung</span>
                                        <span class="d-block text-muted" style="font-size: 11px;">@item.Merek (@item.JenisKendaraan)</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @resultBadgeClass rounded-pill px-2.5 py-1 fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">@statusText</span>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border: 1px solid var(--border-color); background: var(--bg-card); font-size: 13px;">
                                            @if (string.Equals(item.Nik?.Trim(), userNik?.Trim(), StringComparison.OrdinalIgnoreCase) || isAdmin)
                                            {
                                                <li><a class="dropdown-item" href="javascript:void(0)" style="color: var(--text-main);" onclick="editP2h(@item.Id)"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Laporan</a></li>
                                            }
                                            <li><a class="dropdown-item" href="javascript:void(0)" style="color: var(--text-main);" onclick="shareP2h('@item.NoLambung', '@item.Tanggal.ToString("dd MMM yyyy")', '@item.Merek', '@item.JenisKendaraan', @totalDefects, '@item.Nama')"><i class="bi bi-share-fill me-2" style="color: #38bdf8;"></i>Bagikan Hasil</a></li>
                                            @if (string.Equals(item.Nik?.Trim(), userNik?.Trim(), StringComparison.OrdinalIgnoreCase) || isAdmin)
                                            {
                                                <li><hr class="dropdown-divider border-secondary"></li>
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteP2h(@item.Id)"><i class="bi bi-trash-fill me-2"></i>Hapus Laporan</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">
                                <div><strong>Pemeriksa:</strong> @item.Nama (@item.Nik)</div>
                                <div class="mt-1">
                                    <span><strong>Odometer:</strong> @item.Kilometer KM</span> &bull; 
                                    <span><strong>SIMPER:</strong> <span class="badge @(item.SimperKimper == "YA" ? "bg-success" : "bg-danger")" style="font-size: 9px;">@item.SimperKimper</span></span>
                                </div>
                            </div>

                            <!-- List defects if exists -->
                            @if (!isGood)
                            {
                                <div class="defect-list-box p-2 mb-2 rounded" style="background: rgba(244, 63, 94, 0.08); border: 1px solid rgba(244, 63, 94, 0.2);">
                                    <span class="text-danger fw-bold d-block mb-1" style="font-size: 11px;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Daftar Temuan Kerusakan:</span>
                                    <ul class="mb-0 ps-3" style="font-size: 11px; color: var(--text-main); line-height: 1.4;">
                                        @foreach (var def in defectsA) { <li><span class="badge bg-danger py-0 px-1 me-1 text-uppercase" style="font-size: 8px;">GOL. A</span> @def</li> }
                                        @foreach (var def in defectsB) { <li><span class="badge bg-warning text-dark py-0 px-1 me-1 text-uppercase" style="font-size: 8px;">GOL. B</span> @def</li> }
                                        @foreach (var def in defectsC) { <li><span class="badge bg-info text-dark py-0 px-1 me-1 text-uppercase" style="font-size: 8px;">GOL. C</span> @def</li> }
                                    </ul>
                                </div>
                            }

                            <!-- Speedometer thumbnail and defect photo thumbnails -->
                            @{
                                var hasPhotos = !string.IsNullOrEmpty(item.FotoSpeedometer);
                                if (!hasPhotos)
                                {
                                    try
                                    {
                                        if (!string.IsNullOrEmpty(item.GolA_Json)) {
                                            var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolA_Json);
                                            if (list != null && list.Any(x => x.Status == "NOT_GOOD" && !string.IsNullOrEmpty(x.PhotoUrl))) hasPhotos = true;
                                        }
                                        if (!hasPhotos && !string.IsNullOrEmpty(item.GolB_Json)) {
                                            var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolB_Json);
                                            if (list != null && list.Any(x => x.Status == "NOT_GOOD" && !string.IsNullOrEmpty(x.PhotoUrl))) hasPhotos = true;
                                        }
                                        if (!hasPhotos && !string.IsNullOrEmpty(item.GolC_Json)) {
                                            var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolC_Json);
                                            if (list != null && list.Any(x => x.Status == "NOT_GOOD" && !string.IsNullOrEmpty(x.PhotoUrl))) hasPhotos = true;
                                        }
                                    }
                                    catch {}
                                }
                            }
                            @if (hasPhotos)
                            {
                                @if (item.Nik == userNik)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        @if (!string.IsNullOrEmpty(item.FotoSpeedometer))
                                        {
                                            var proxyFotoSpeedometer = item.FotoSpeedometer.StartsWith("http") ? "/ImageProxy/Get?url=" + Uri.EscapeDataString(item.FotoSpeedometer) : item.FotoSpeedometer;
                                            <div class="text-center">
                                                <a href="@proxyFotoSpeedometer" target="_blank" title="Foto Odometer Speedometer">
                                                    <img src="@proxyFotoSpeedometer" alt="Speedometer" style="width: 55px; height: 55px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color);" />
                                                </a>
                                                <div class="text-muted" style="font-size: 8px; margin-top: 2px;">Speedometer</div>
                                            </div>
                                        }
                                        
                                        @{
                                            var defectPhotos = new List<string>();
                                            try
                                            {
                                                if (!string.IsNullOrEmpty(item.GolA_Json)) {
                                                    var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolA_Json);
                                                    if (list != null) defectPhotos.AddRange(list.Where(x => x.Status == "NOT_GOOD" && !string.IsNullOrEmpty(x.PhotoUrl)).Select(x => x.PhotoUrl!));
                                                }
                                                if (!string.IsNullOrEmpty(item.GolB_Json)) {
                                                    var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolB_Json);
                                                    if (list != null) defectPhotos.AddRange(list.Where(x => x.Status == "NOT_GOOD" && !string.IsNullOrEmpty(x.PhotoUrl)).Select(x => x.PhotoUrl!));
                                                }
                                                if (!string.IsNullOrEmpty(item.GolC_Json)) {
                                                    var list = System.Text.Json.JsonSerializer.Deserialize<List<MBS_SAP.Controllers.P2hController.ChecklistItem>>(item.GolC_Json);
                                                    if (list != null) defectPhotos.AddRange(list.Where(x => x.Status == "NOT_GOOD" && !string.IsNullOrEmpty(x.PhotoUrl)).Select(x => x.PhotoUrl!));
                                                }
                                            }
                                            catch {}
                                            int picIdx = 1;
                                            foreach (var photo in defectPhotos)
                                            {
                                                var proxyPhoto = photo.StartsWith("http") ? "/ImageProxy/Get?url=" + Uri.EscapeDataString(photo) : photo;
                                                <div class="text-center">
                                                    <a href="@proxyPhoto" target="_blank" title="Foto Kerusakan #@picIdx">
                                                        <img src="@proxyPhoto" alt="Kerusakan" style="width: 55px; height: 55px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(244,63,94,0.3);" />
                                                    </a>
                                                    <div class="text-danger" style="font-size: 8px; margin-top: 2px;">Temuan #@picIdx</div>
                                                </div>
                                                picIdx++;
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="px-2 py-1.5 d-flex align-items-center gap-1.5 mb-2" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; max-width: fit-content;">
                                        <i class="bi bi-shield-lock-fill text-warning" style="font-size: 13px;"></i>
                                        <span class="text-muted" style="font-size: 10px;">Foto dikunci</span>
                                    </div>
                                }
                            }

                            <div class="d-flex justify-content-between align-items-center pt-2" style="border-top: 1px solid var(--border-color); font-size: 11px; color: var(--text-muted);">
                                <span><i class="bi bi-calendar-event me-1"></i>@item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")</span>
                                <span><i class="bi bi-shield-check me-1"></i>P2H Selesai</span>
                            </div>
                        </div>
                        loopIndex++;
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 99999; justify-content: center; align-items: center; flex-direction: column; color: white; font-family: 'Poppins', sans-serif;">
    <div class="loader-spinner-container" style="position: relative; width: 100px; height: 100px; display: flex; justify-content: center; align-items: center; margin-bottom: 24px;">
        <div class="loader-circle" style="box-sizing: border-box; width: 80px; height: 80px; border: 4px solid rgba(255, 255, 255, 0.15); border-radius: 50%; border-top-color: #38bdf8; border-bottom-color: #38bdf8; animation: sap-spin 1.5s linear infinite;"></div>
        <i class="bi bi-truck-front-fill" style="position: absolute; font-size: 32px; color: white; animation: sap-bounce 2s ease-in-out infinite;"></i>
    </div>
    <h5 id="loadingTitle" style="font-weight: 700; margin-bottom: 8px; letter-spacing: 0.5px; text-align: center; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Memproses Laporan P2H</h5>
    <p id="loadingSubtitle" style="font-size: 13px; color: rgba(255,255,255,0.75); margin-bottom: 16px; text-align: center; max-width: 340px; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">Sedang menyimpan laporan pemeriksaan kendaraan dan checklist kondisi unit...</p>

    <!-- Progress Bar Container -->
    <div style="width: 280px; background: rgba(255,255,255,0.1); height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.05);">
        <div id="loadingProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #0284c7, #38bdf8); transition: width 0.1s ease; border-radius: 4px;"></div>
    </div>
    <div id="loadingProgressPercent" style="font-size: 14px; font-weight: 700; color: #38bdf8; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">0%</div>
</div>

@section Scripts {
    <script>
        // Master list of vehicles from ViewBag for autocomplete search
        const registeredVehicles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vehiclesList));
        const GOL_A_COUNT = @MBS_SAP.Controllers.P2hController.GolA.Length;
        const GOL_B_COUNT = @MBS_SAP.Controllers.P2hController.GolB.Length;
        const GOL_C_COUNT = @MBS_SAP.Controllers.P2hController.GolC.Length;

        function escapeHtml(str) {
            return String(str ?? '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function previewSpeedo(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('speedoPreview').src = e.target.result;
                    document.getElementById('speedoPlaceholder').classList.add('d-none');
                    document.getElementById('speedoPreviewContainer').classList.remove('d-none');
                    $(input).removeClass('is-invalid');
                    $(input).closest('.form-group-sap').find('.sap-err-msg').remove();
                }
                reader.readAsDataURL(file);
            }
        }

        let isP2hSubmitting = false;

        function resetButtonState() {
            isP2hSubmitting = false;
            $('#loadingOverlay').css('display', 'none');
            var p2hId = $('#p2hId').val();
            var btnText = '<i class="bi bi-check-circle-fill me-2"></i> ' + (p2hId ? 'PERBARUI LAPORAN P2H' : 'KIRIM LAPORAN P2H');
            var $btn = $('#btnSubmitP2h, #p2hForm button[type="submit"]');
            $btn.prop('disabled', false).css('pointer-events', 'auto').html(btnText);
        }

        function showSapErrorPopup(title, errors, fallbackMessage) {
            resetButtonState();
            const cleanErrors = Array.isArray(errors) && errors.length > 0 
                ? errors 
                : (typeof errors === 'string' && errors.trim().length > 0 ? [errors] : [fallbackMessage || 'Data belum lengkap.']);
            
            $('#sapErrorModal').remove();
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');

            const listHtml = cleanErrors.map(item => `<li style="margin-bottom: 8px;">${escapeHtml(item)}</li>`).join('');
            const modalHtml = `
                <div class="modal fade" id="sapErrorModal" tabindex="-1" aria-hidden="true" style="z-index: 10050;">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="background: var(--bg-card, #1e293b); color: var(--text-main, #f8fafc); border: 1px solid rgba(239,68,68,0.5); border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                            <div class="modal-header" style="border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1)); padding: 16px 20px;">
                                <h5 class="modal-title d-flex align-items-center" style="font-size: 16px; font-weight: 800; color: #ef4444;">
                                    <i class="bi bi-exclamation-triangle-fill text-danger me-2" style="font-size: 20px;"></i>
                                    ${escapeHtml(title || 'Data Belum Lengkap')}
                                </h5>
                                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body" style="font-size: 13px; line-height: 1.6; padding: 20px;">
                                <div class="mb-2 fw-semibold text-danger">Periksa dan lengkapi bagian berikut:</div>
                                <ul class="mb-0 ps-3" style="color: var(--text-main, #f8fafc);">
                                    ${listHtml}
                                </ul>
                            </div>
                            <div class="modal-footer" style="border-top: 1px solid var(--border-color, rgba(255,255,255,0.1)); padding: 12px 20px;">
                                <button type="button" class="btn btn-danger px-4 py-2" data-bs-dismiss="modal" style="border-radius: 8px; font-weight: 600; font-size: 13px;">
                                    <i class="bi bi-check2 me-1"></i> Mengerti & Perbaiki
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
            $('body').append(modalHtml);

            try {
                const modalEl = document.getElementById('sapErrorModal');
                if (window.bootstrap && bootstrap.Modal) {
                    const myModal = bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: true, keyboard: true });
                    $(modalEl).on('hidden.bs.modal', function() {
                        resetButtonState();
                        $('#sapErrorModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    });
                    myModal.show();
                } else if ($.fn.modal) {
                    $(modalEl).on('hidden.bs.modal', function() {
                        resetButtonState();
                        $('#sapErrorModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    }).modal('show');
                } else {
                    alert((title || 'Data belum lengkap') + '\n\n- ' + cleanErrors.join('\n- '));
                }
            } catch(e) {
                alert((title || 'Data belum lengkap') + '\n\n- ' + cleanErrors.join('\n- '));
            }
        }

        function showSapSuccessPopup(title, message) {
            $('#sapSuccessModal').remove();
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');

            const safeTitle = escapeHtml(title || 'Berhasil Disimpan!');
            const safeMsg = escapeHtml(message || 'Laporan P2H berhasil disimpan ke sistem.');

            const modalHtml = `
                <div class="modal fade" id="sapSuccessModal" tabindex="-1" aria-hidden="true" style="z-index: 10050;">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="background: var(--bg-card, #1e293b); color: var(--text-main, #f8fafc); border: 1.5px solid rgba(16, 185, 129, 0.5); border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); overflow: hidden;">
                            <div class="modal-body text-center p-4">
                                <div style="width: 72px; height: 72px; background: rgba(16, 185, 129, 0.15); border: 2px solid #10b981; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                                    <i class="bi bi-check2-circle" style="font-size: 40px; color: #10b981;"></i>
                                </div>
                                <h4 style="font-weight: 800; color: #10b981; margin-bottom: 8px;">${safeTitle}</h4>
                                <p style="font-size: 14px; color: var(--text-muted, #94a3b8); margin-bottom: 24px; line-height: 1.5;">${safeMsg}</p>
                                <button type="button" class="btn btn-success px-5 py-2.5 w-100" data-bs-dismiss="modal" style="background-color: #10b981; border-color: #059669; border-radius: 12px; font-weight: 700; font-size: 14px; letter-spacing: 0.3px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
                                    <i class="bi bi-check-lg me-1"></i> OK, Mengerti
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
            $('body').append(modalHtml);

            try {
                const modalEl = document.getElementById('sapSuccessModal');
                if (window.bootstrap && bootstrap.Modal) {
                    const myModal = bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: true, keyboard: true });
                    $(modalEl).on('hidden.bs.modal', function() {
                        $('#sapSuccessModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    });
                    myModal.show();
                } else if ($.fn.modal) {
                    $(modalEl).on('hidden.bs.modal', function() {
                        $('#sapSuccessModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    }).modal('show');
                } else {
                    alert(safeTitle + '\n\n' + safeMsg);
                }
            } catch(e) {
                alert(safeTitle + '\n\n' + safeMsg);
            }
        }

        const serverErrorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]));
        if (serverErrorMessage) {
            setTimeout(() => showSapErrorPopup("Terjadi kesalahan", [serverErrorMessage]), 250);
        }

        const serverSuccessMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]));
        if (serverSuccessMessage) {
            setTimeout(() => showSapSuccessPopup("Berhasil Disimpan!", serverSuccessMessage), 250);
        }

        // ========= AUTO FILL ALL =========
        function autoFillAll(status) {
            const suffix = status === 'GOOD' ? 'good' : 'bad';
            const categories = [
                { prefix: 'golA', count: GOL_A_COUNT },
                { prefix: 'golB', count: GOL_B_COUNT },
                { prefix: 'golC', count: GOL_C_COUNT }
            ];

            categories.forEach(cat => {
                for (let i = 0; i < cat.count; i++) {
                    const radioId = `${cat.prefix}_${suffix}_${i}`;
                    const radio = document.getElementById(radioId);
                    if (radio) {
                        radio.checked = true;
                        toggleDefectPhoto(cat.prefix, i, status);
                    }
                }
            });

            // Expand all accordion panels to show results
            ['collapseA', 'collapseB', 'collapseC'].forEach(id => {
                const el = document.getElementById(id);
                if (el && !$(el).hasClass('show')) {
                    new bootstrap.Collapse(el, { toggle: true });
                }
            });

            const label = status === 'GOOD' ? 'BAIK' : 'RUSAK';
            showToast(`Semua item diatur ke <strong>${label}</strong>`, status === 'GOOD' ? '#10b981' : '#f43f5e');
        }

        // Micro toast notification
        function showToast(message, bgColor) {
            const existing = document.getElementById('p2hToast');
            if (existing) existing.remove();

            const toast = document.createElement('div');
            toast.id = 'p2hToast';
            toast.innerHTML = message;
            Object.assign(toast.style, {
                position: 'fixed', bottom: '24px', right: '24px', zIndex: '9999',
                background: bgColor, color: 'white', padding: '12px 20px',
                borderRadius: '12px', fontWeight: '700', fontSize: '13px',
                boxShadow: '0 8px 24px rgba(0,0,0,0.3)', opacity: '0',
                transform: 'translateY(20px)', transition: 'all 0.3s ease'
            });
            document.body.appendChild(toast);
            requestAnimationFrame(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
            });
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(20px)';
                setTimeout(() => toast.remove(), 350);
            }, 2500);
        }

        // ========= SHARE FUNCTIONALITY =========
        function shareP2h(noLambung, tanggal, merek, jenis, defects, nama) {
            const statusLabel = defects === 0 ? 'AMAN (GOOD)' : `${defects} TEMUAN`;
            const shareText = `LAPORAN P2H KENDARAAN\n` +
                              `--------------------\n` +
                              `Unit: ${noLambung}\n` +
                              `Tanggal: ${tanggal}\n` +
                              `Tipe: ${merek} (${jenis})\n` +
                              `Status: ${statusLabel}\n` +
                              `Pemeriksa: ${nama}\n` +
                              `--------------------\n` +
                              `INDEXIM Safety Accountability Program`;

            if (navigator.share) {
                navigator.share({
                    title: `P2H - ${noLambung} (${tanggal})`,
                    text: shareText
                }).catch(() => {});
            } else {
                navigator.clipboard.writeText(shareText).then(() => {
                    showToast('<i class="bi bi-clipboard-check me-1"></i> Hasil P2H disalin ke clipboard!', '#0284c7');
                }).catch(() => {
                    const ta = document.createElement('textarea');
                    ta.value = shareText;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    ta.remove();
                    showToast('<i class="bi bi-clipboard-check me-1"></i> Hasil P2H disalin ke clipboard!', '#0284c7');
                });
            }
        }

        function toggleDefectPhoto(category, index, status) {
            const wrapper = document.getElementById(`photo_wrapper_${category}_${index}`);
            const input = document.getElementById(`photo_input_${category}_${index}`);
            
            if (status === 'NOT_GOOD') {
                $(wrapper).slideDown(150);
            } else {
                $(wrapper).slideUp(150);
                if (input) input.value = '';
            }
        }

        $(document).ready(function() {
            const $input = $('#noLambungInput');
            const $menu = $('#unitDropdownMenu');
            const $toggle = $('#toggleUnitDropdown');
            const $merek = $('#merek');
            const $jenis = $('#jenisKendaraan');

            // Render matching dropdown list
            function renderDropdown(filterText = '') {
                $menu.empty();
                const cleanFilterText = filterText.trim().toLowerCase();
                
                const matches = registeredVehicles.filter(v => 
                    v.NoLambung.toLowerCase().includes(cleanFilterText)
                );

                if (matches.length > 0) {
                    matches.forEach(v => {
                        const itemHtml = `<button type="button" class="unit-option-btn d-flex align-items-center justify-content-between w-100 text-start py-2 px-3 border-0 select-vehicle-btn" data-no="${v.NoLambung}" data-merek="${v.Merek}" data-jenis="${v.JenisKendaraan}" style="font-size: 13px; color: var(--text-main); background: none; border-bottom: 1px solid var(--border-color); cursor: pointer; border-radius: 6px; margin-bottom: 2px;">
                                            <span><i class="bi bi-truck me-2 text-primary"></i><strong>${v.NoLambung}</strong> - ${v.Merek}</span>
                                            <span class="badge" style="background: rgba(2,132,199,0.15); color: #38bdf8; font-size: 10px;">${v.JenisKendaraan}</span>
                                          </button>`;
                        $menu.append(itemHtml);
                    });
                }

                // If typing and no exact match exists, offer to add as new unit
                const exactMatch = registeredVehicles.some(v => v.NoLambung.toLowerCase() === cleanFilterText);
                if (cleanFilterText.length > 0 && !exactMatch) {
                    const addNewHtml = `<button type="button" class="unit-option-btn d-flex align-items-center w-100 text-start py-2 px-3 border-0 select-new-vehicle-btn" data-no="${filterText.toUpperCase()}" style="font-size: 13px; font-weight: 700; color: #f59e0b; background: rgba(245,158,11,0.1); border-radius: 6px; margin-bottom: 2px; cursor: pointer;">
                                            <i class="bi bi-plus-lg me-2"></i>Tambah "${filterText.toUpperCase()}" Sebagai Unit Baru
                                        </button>`;
                    $menu.append(addNewHtml);
                }

                if ($menu.children().length > 0) {
                    $menu.show();
                } else {
                    $menu.hide();
                }
            }

            // Click listener for selecting unit from list
            $menu.on('click', '.select-vehicle-btn', function() {
                const noLambung = $(this).data('no');
                const brand = $(this).data('merek');
                const type = $(this).data('jenis');

                $input.val(noLambung);
                $merek.val(brand);
                $jenis.val(type).change();
                $menu.hide();
            });

            // Click listener for adding new unit
            $menu.on('click', '.select-new-vehicle-btn', function() {
                const newUnit = $(this).data('no');
                
                const exists = registeredVehicles.some(v => v.NoLambung.toLowerCase() === newUnit.toLowerCase());
                if (exists) {
                    const matchedUnit = registeredVehicles.find(v => v.NoLambung.toLowerCase() === newUnit.toLowerCase());
                    $input.val(matchedUnit.NoLambung);
                    $merek.val(matchedUnit.Merek);
                    $jenis.val(matchedUnit.JenisKendaraan).change();
                    $menu.hide();
                    return;
                }

                $input.val(newUnit);
                $merek.val('').focus();
                $jenis.val('').change();
                $menu.hide();
            });

            // Trigger dropdown render on typing
            $input.on('input focus', function() {
                renderDropdown($(this).val());
            });

            // Toggle dropdown arrow click
            $toggle.on('click', function(e) {
                e.stopPropagation();
                if ($menu.is(':visible')) {
                    $menu.hide();
                } else {
                    renderDropdown($input.val());
                }
            });

            // Close dropdown if clicked outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#noLambungInput, #unitDropdownMenu, #toggleUnitDropdown').length) {
                    $menu.hide();
                }
            });

            // Real-time error clearing on user input
            $('#p2hForm').on('input change', 'input, select, textarea', function() {
                $(this).removeClass('is-invalid');
                $(this).closest('.form-group-sap').find('.sap-err-msg').remove();
                $(this).closest('.input-sap-wrapper').next('.sap-err-msg').remove();
            });

            // Form Submit handler
            $('#p2hForm').on('submit', function(e) {
                e.preventDefault();
                if (isP2hSubmitting) return false;

                const p2hId = $('#p2hId').val();
                const isEdit = p2hId !== '';
                const btn = $('#btnSubmitP2h, #p2hForm button[type="submit"]');

                // Reset errors
                $('#p2hForm').find('.is-invalid').removeClass('is-invalid');
                $('#p2hForm').find('.sap-err-msg').remove();

                const noLambung = $('#noLambungInput').val().trim();
                const merek = $('#merek').val().trim();
                const jenis = $('#jenisKendaraan').val();
                const km = $('#kilometer').val().trim();
                const fotoSpeedoInput = document.getElementById('fotoSpeedometer');
                const hasSpeedoPreview = !$('#speedoPreviewContainer').hasClass('d-none') && $('#speedoPreview').attr('src');
                const hasSpeedo = isEdit 
                    ? (hasSpeedoPreview || (fotoSpeedoInput && fotoSpeedoInput.files.length > 0))
                    : (fotoSpeedoInput && fotoSpeedoInput.files.length > 0);

                let isValid = true;
                let firstInvalid = null;
                let missingFields = [];

                if (!noLambung) {
                    isValid = false;
                    $('#noLambungInput').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#noLambungInput');
                    $('#noLambungInput').closest('.input-sap-wrapper').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>No. Lambung Kendaraan wajib diisi.</span>');
                    missingFields.push("No. Lambung Kendaraan wajib diisi.");
                }
                if (!merek) {
                    isValid = false;
                    $('#merek').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#merek');
                    $('#merek').closest('.input-sap-wrapper').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Merek / Tipe Kendaraan wajib diisi.</span>');
                    missingFields.push("Merek / Tipe Kendaraan wajib diisi.");
                }
                if (!jenis) {
                    isValid = false;
                    $('#jenisKendaraan').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#jenisKendaraan');
                    $('#jenisKendaraan').closest('.input-sap-wrapper').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Jenis Kendaraan wajib dipilih.</span>');
                    missingFields.push("Jenis Kendaraan wajib dipilih.");
                }
                if (!km) {
                    isValid = false;
                    $('#kilometer').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#kilometer');
                    $('#kilometer').closest('.input-sap-wrapper').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Odometer / Kilometer wajib diisi.</span>');
                    missingFields.push("Odometer / Kilometer wajib diisi.");
                }
                if (!hasSpeedo) {
                    isValid = false;
                    $(fotoSpeedoInput).addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $(fotoSpeedoInput).closest('.form-group-sap');
                    $(fotoSpeedoInput).closest('.form-group-sap').find('.upload-card').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Foto Speedometer wajib diunggah.</span>');
                    missingFields.push("Foto Speedometer wajib diunggah.");
                }

                // Check critical checklist items: if status is NOT_GOOD, photo must be uploaded
                $('.btn-check[value="NOT_GOOD"]:checked').each(function() {
                    const nameAttr = $(this).attr('name'); // e.g. golA_status_3
                    const parts = nameAttr.split('_'); // ['golA', 'status', '3']
                    const cat = parts[0];
                    const idx = parseInt(parts[2]);
                    const fileInput = document.getElementById(`photo_input_${cat}_${idx}`);
                    const previewWrapper = document.getElementById(`photo_preview_wrapper_${cat}_${idx}`);
                    const hasExistingPhoto = previewWrapper && !$(previewWrapper).hasClass('d-none');
                    
                    if (fileInput && fileInput.files.length === 0 && !hasExistingPhoto) {
                        isValid = false;
                        $(fileInput).addClass('is-invalid');
                        if (!firstInvalid) firstInvalid = $(fileInput);
                        const groupLabel = cat === 'golA' ? 'Gol. A' : cat === 'golB' ? 'Gol. B' : 'Gol. C';
                        const errHtml = `<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Foto bukti kerusakan wajib diunggah.</span>`;
                        $(fileInput).after(errHtml);
                        
                        let itemText = $(`#row_${cat}_${idx}`).find('.fs-13').text()?.trim() || `${groupLabel} Item #${idx + 1}`;
                        missingFields.push(`Foto Kerusakan (${groupLabel}): ${itemText}`);

                        // Expand the respective accordion item
                        const collapseEl = document.getElementById(`collapse${cat.slice(-1).toUpperCase()}`);
                        if (collapseEl && !$(collapseEl).hasClass('show')) {
                            $(`button[data-bs-target="#collapse${cat.slice(-1).toUpperCase()}"]`).click();
                        }
                    }
                });

                if (!isValid) {
                    resetButtonState();
                    showSapErrorPopup("Laporan P2H belum lengkap", missingFields);
                    if (firstInvalid) {
                        $('html, body').animate({
                            scrollTop: firstInvalid.offset().top - 120
                        }, 300);
                    }
                    return false;
                }

                isP2hSubmitting = true;
                btn.prop('disabled', true).css('pointer-events', 'none');
                btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>MENYIMPAN...');

                const $overlay = $('#loadingOverlay');
                const $progressBar = $('#loadingProgressBar');
                const $progressPercent = $('#loadingProgressPercent');
                const $title = $('#loadingTitle');
                const $subtitle = $('#loadingSubtitle');

                $overlay.css('display', 'flex');
                $title.text('Menyiapkan Data P2H...');
                $subtitle.text('Sedang memproses pemeriksaan kendaraan dan checklist...');
                $progressBar.css('width', '15%');
                $progressPercent.text('15%');

                const formData = new FormData(this);

                $.ajax({
                    url: '/P2h/Create',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    xhr: function() {
                        const xhr = new window.XMLHttpRequest();
                        xhr.upload.addEventListener('progress', function(evt) {
                            if (evt.lengthComputable) {
                                const percent = Math.round((evt.loaded / evt.total) * 100);
                                const scaledPercent = Math.max(15, Math.min(95, percent));
                                $progressBar.css('width', scaledPercent + '%');
                                $progressPercent.text(scaledPercent + '%');
                                if (percent >= 100) {
                                    $title.text('Memproses di Server...');
                                    $subtitle.text('Mohon tunggu, server sedang menyimpan data...');
                                }
                            }
                        }, false);
                        return xhr;
                    },
                    success: function(response) {
                        $title.text('Selesai!');
                        $subtitle.text(response && response.message ? response.message : 'Laporan P2H berhasil disimpan.');
                        $progressBar.css('width', '100%');
                        $progressPercent.text('100%');
                        setTimeout(function() {
                            window.location.href = '/P2h/Index';
                        }, 500);
                    },
                    error: function(xhr, status, error) {
                        resetButtonState();

                        let errMessage = "Terjadi kesalahan saat menyimpan data P2H.";
                        let errList = [];

                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.message) errMessage = xhr.responseJSON.message;
                            if (Array.isArray(xhr.responseJSON.errors)) errList = xhr.responseJSON.errors;
                        } else if (xhr.responseText) {
                            try {
                                const parsed = JSON.parse(xhr.responseText);
                                if (parsed.message) errMessage = parsed.message;
                                if (Array.isArray(parsed.errors)) errList = parsed.errors;
                            } catch(e) {}
                        }

                        if (errList.length === 0) {
                            errList = [errMessage];
                        }

                        showSapErrorPopup(errMessage, errList);
                    },
                    complete: function() {
                        setTimeout(function() {
                            if ($('#sapErrorModal').is(':visible') || !isP2hSubmitting) {
                                resetButtonState();
                            }
                        }, 100);
                    }
                });

                return false;
            });

            // Ensure button state is clean on page load
            resetButtonState();
            window.addEventListener('pageshow', function() {
                resetButtonState();
            });
        });

        // Cancel Edit report function
        function cancelEditP2h() {
            $('#p2hForm')[0].reset();
            $('#p2hId').val('');
            $('#formTitle').html('<i class="bi bi-truck-front-fill me-2 text-primary"></i>Form Pemeriksaan P2H Baru');
            $('#btnCancelEdit').addClass('d-none');
            resetButtonState();
            $('#p2hForm').find('.is-invalid').removeClass('is-invalid');
            $('#p2hForm').find('.sap-err-msg').remove();
            
            // Hide speedo preview
            $('#speedoPreview').attr('src', '');
            $('#speedoPreviewContainer').addClass('d-none');
            $('#speedoPlaceholder').removeClass('d-none');
            $('#speedoHelp').text("Wajib melampirkan foto speedometer terbaru.");

            // Reset checklist photos wrappers
            $('.defect-photo-wrapper').hide();
            $('.defect-photo-wrapper input[type="file"]').val('');
            $('.defect-photo-wrapper').each(function() {
                const idAttr = $(this).attr('id');
                const parts = idAttr.split('_'); // ['photo', 'wrapper', 'golA', '3']
                const cat = parts[2];
                const idx = parts[3];
                $(`#photo_preview_wrapper_${cat}_${idx}`).addClass('d-none');
            });

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Edit report function
        function editP2h(id) {
            $.get('/P2h/GetData/' + id, function(data) {
                if (data) {
                    cancelEditP2h(); // Clear previous form state
                    
                    $('#p2hId').val(data.id);
                    if (data.tanggal) $('#tanggal').val(data.tanggal);
                    if (data.waktu) $('#waktuStr').val(data.waktu);
                    
                    // Metadata
                    $('#noLambungInput').val(data.noLambung);
                    $('#merek').val(data.merek);
                    $('#jenisKendaraan').val(data.jenisKendaraan).change();
                    $('#kilometer').val(data.kilometer);
                    $('#simperKimper').val(data.simperKimper).change();

                    // Speedometer photo preview
                    if (data.fotoSpeedometer) {
                        var proxyFoto = data.fotoSpeedometer.startsWith("http") ? "/ImageProxy/Get?url=" + encodeURIComponent(data.fotoSpeedometer) : data.fotoSpeedometer;
                        $('#speedoPreview').attr('src', proxyFoto);
                        $('#speedoPlaceholder').addClass('d-none');
                        $('#speedoPreviewContainer').removeClass('d-none');
                        $('#speedoHelp').text("Biarkan kosong jika tidak ingin mengubah foto.");
                    }

                    // Populate Golongan A Checkpoints
                    if (data.golA) {
                        data.golA.forEach((item, index) => {
                            const idx = index;
                            if (item.status === 'NOT_GOOD') {
                                $(`#golA_bad_${idx}`).prop('checked', true);
                                toggleDefectPhoto('golA', idx, 'NOT_GOOD');
                                
                                if (item.photoUrl) {
                                    var proxyDefect = item.photoUrl.startsWith("http") ? "/ImageProxy/Get?url=" + encodeURIComponent(item.photoUrl) : item.photoUrl;
                                    $(`#photo_preview_link_golA_${idx}`).attr('href', proxyDefect);
                                    $(`#photo_preview_wrapper_golA_${idx}`).removeClass('d-none');
                                }
                            } else {
                                $(`#golA_good_${idx}`).prop('checked', true);
                            }
                        });
                    }

                    // Populate Golongan B Checkpoints
                    if (data.golB) {
                        data.golB.forEach((item, index) => {
                            const idx = index;
                            if (item.status === 'NOT_GOOD') {
                                $(`#golB_bad_${idx}`).prop('checked', true);
                                toggleDefectPhoto('golB', idx, 'NOT_GOOD');
                                
                                if (item.photoUrl) {
                                    var proxyDefect = item.photoUrl.startsWith("http") ? "/ImageProxy/Get?url=" + encodeURIComponent(item.photoUrl) : item.photoUrl;
                                    $(`#photo_preview_link_golB_${idx}`).attr('href', proxyDefect);
                                    $(`#photo_preview_wrapper_golB_${idx}`).removeClass('d-none');
                                }
                            } else {
                                $(`#golB_good_${idx}`).prop('checked', true);
                            }
                        });
                    }

                    // Populate Golongan C Checkpoints
                    if (data.golC) {
                        data.golC.forEach((item, index) => {
                            const idx = index;
                            if (item.status === 'NOT_GOOD') {
                                $(`#golC_bad_${idx}`).prop('checked', true);
                                toggleDefectPhoto('golC', idx, 'NOT_GOOD');
                                
                                if (item.photoUrl) {
                                    var proxyDefect = item.photoUrl.startsWith("http") ? "/ImageProxy/Get?url=" + encodeURIComponent(item.photoUrl) : item.photoUrl;
                                    $(`#photo_preview_link_golC_${idx}`).attr('href', proxyDefect);
                                    $(`#photo_preview_wrapper_golC_${idx}`).removeClass('d-none');
                                }
                            } else {
                                $(`#golC_good_${idx}`).prop('checked', true);
                            }
                        });
                    }

                    // Toggle Cancel button and scroll to top
                    $('#formTitle').html('<i class="bi bi-pencil-square me-2 text-primary"></i>Edit Laporan P2H');
                    $('#btnCancelEdit').removeClass('d-none');
                    $('#btnSubmitP2h').html('<i class="bi bi-check-circle-fill me-2"></i> PERBARUI LAPORAN P2H');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }).fail(function() {
                alert("Gagal mengambil data P2H. Data mungkin sudah dihapus.");
            });
        }

        // Delete report function
        function deleteP2h(id) {
            if (confirm("Apakah Anda yakin ingin menghapus laporan pemeriksaan P2H ini?")) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/P2h/Delete/' + id;
                
                const token = $('input[name="__RequestVerificationToken"]').val();
                if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);
                }

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
