    <!-- Leaflet.js JavaScript -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
    /* ──────────────────────────────────────────────────────────────────────────
       1. 5-MINUTE AUTO SLIDE ROTATION (/EarlyWarning -> /Display)
       ────────────────────────────────────────────────────────────────────────── */
    const SLIDE_DURATION_SECONDS = 300; // 5 minutes
    let slideTimeRemaining = SLIDE_DURATION_SECONDS;
    let isSlidePaused = false;

    function updateSlideTimer() {
        if (isSlidePaused) return;

        slideTimeRemaining--;

        if (slideTimeRemaining <= 0) {
            // Rotate to Display 1 (continuous loop: Display 1 -> 2 -> 3 -> 4 -> 1)
            window.location.href = '/Display';
            return;
        }

        const mins = Math.floor(slideTimeRemaining / 60);
        const secs = slideTimeRemaining % 60;
        const countdownEl = document.getElementById('slideCountdown');
        if (countdownEl) {
            countdownEl.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        const progressPct = ((SLIDE_DURATION_SECONDS - slideTimeRemaining) / SLIDE_DURATION_SECONDS) * 100;
        const barEl = document.getElementById('slideProgressBar');
        if (barEl) {
            barEl.style.width = `${progressPct}%`;
        }
    }
    setInterval(updateSlideTimer, 1000);

    function togglePauseSlide() {
        isSlidePaused = !isSlidePaused;
        const icon = document.getElementById('pauseIcon');
        const text = document.getElementById('pauseText');
        if (isSlidePaused) {
            if (icon) icon.className = 'bi bi-play-fill';
            if (text) text.innerText = 'Lanjut';
        } else {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (text) text.innerText = 'Jeda';
        }
    }

    function toggleFullScreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
        } else {
            if (document.exitFullscreen) document.exitFullscreen();
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       2. LIVE DIGITAL CLOCK (WITA)
       ────────────────────────────────────────────────────────────────────────── */
    function updateClock() {
        const now = new Date();
        const hrs = String(now.getHours()).padStart(2, '0');
        const mins = String(now.getMinutes()).padStart(2, '0');
        const secs = String(now.getSeconds()).padStart(2, '0');

        const clockEl = document.getElementById('liveClock');
        if (clockEl) clockEl.innerText = `${hrs}:${mins}:${secs}`;

        const months = ['JAN', 'FEB', 'MAR', 'APR', 'MEI', 'JUN', 'JUL', 'AGU', 'SEP', 'OKT', 'NOV', 'DES'];
        const dateStr = `WITA • ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()}`;
        const dateEl = document.getElementById('liveDate');
        if (dateEl) dateEl.innerText = dateStr;
    }
    setInterval(updateClock, 1000);
    updateClock();

    /* ──────────────────────────────────────────────────────────────────────────
       3. AUDIO CHIME, EMERGENCY SIREN & GOOGLE VOICE SYNTHESIS (TTS)
       ────────────────────────────────────────────────────────────────────────── */
    let audioContext = null;
    let isSoundMuted = false;
    let lastAudioAlertTime = 0;
    let speechVoices = [];

    function initVoiceSynthesis() {
        if ('speechSynthesis' in window) {
            speechVoices = window.speechSynthesis.getVoices();
            window.speechSynthesis.onvoiceschanged = () => {
                speechVoices = window.speechSynthesis.getVoices();
            };
        }
    }

    function getAudioContext() {
        if (!audioContext) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) {
                audioContext = new AudioCtx();
            }
        }
        if (audioContext && audioContext.state === 'suspended') {
            audioContext.resume();
        }
        return audioContext;
    }

    // Unlock audio on first user touch/click anywhere on page
    document.addEventListener('click', () => {
        getAudioContext();
        if ('speechSynthesis' in window && speechVoices.length === 0) {
            speechVoices = window.speechSynthesis.getVoices();
        }
    }, { once: true });

    function toggleSoundAlert() {
        isSoundMuted = !isSoundMuted;
        const btn = document.getElementById('btnToggleSound');
        const icon = document.getElementById('soundIcon');
        const text = document.getElementById('soundText');

        if (isSoundMuted) {
            btn.className = 'hdr-ctrl-btn sound-muted';
            icon.className = 'bi bi-volume-mute-fill';
            text.innerText = 'Suara: OFF';
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        } else {
            btn.className = 'hdr-ctrl-btn sound-active';
            icon.className = 'bi bi-volume-up-fill';
            text.innerText = 'Suara: ON';
            testSoundAlert();
        }
    }

    function playRadarChime() {
        if (isSoundMuted) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        try {
            const now = ctx.currentTime;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(880, now); // A5 note
            osc.frequency.exponentialRampToValueAtTime(440, now + 0.35);

            gain.gain.setValueAtTime(0.3, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start(now);
            osc.stop(now + 0.36);
        } catch(e) {}
    }

    function playEmergencyWarningSiren() {
        if (isSoundMuted) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        try {
            const now = ctx.currentTime;
            const osc1 = ctx.createOscillator();
            const osc2 = ctx.createOscillator();
            const gain = ctx.createGain();

            osc1.type = 'triangle';
            osc2.type = 'sawtooth';

            osc1.frequency.setValueAtTime(950, now);
            osc1.frequency.linearRampToValueAtTime(650, now + 0.25);
            osc1.frequency.linearRampToValueAtTime(950, now + 0.5);

            osc2.frequency.setValueAtTime(475, now);
            osc2.frequency.linearRampToValueAtTime(325, now + 0.25);
            osc2.frequency.linearRampToValueAtTime(475, now + 0.5);

            gain.gain.setValueAtTime(0.4, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.7);

            osc1.connect(gain);
            osc2.connect(gain);
            gain.connect(ctx.destination);

            osc1.start(now);
            osc2.start(now);
            osc1.stop(now + 0.7);
            osc2.stop(now + 0.7);
        } catch(e) {}
    }

    function getGoogleIndonesianVoice() {
        if (!speechVoices || speechVoices.length === 0) {
            if ('speechSynthesis' in window) speechVoices = window.speechSynthesis.getVoices();
        }
        // 1. Prioritize Google Indonesian voice
        let voice = speechVoices.find(v => (v.name.includes('Google') || v.name.includes('google')) && (v.lang === 'id-ID' || v.lang.startsWith('id')));
        // 2. Any Indonesian voice (Microsoft Gadis, Apple Damayanti, etc.)
        if (!voice) voice = speechVoices.find(v => v.lang === 'id-ID' || v.lang.startsWith('id'));
        // 3. Any Google voice
        if (!voice) voice = speechVoices.find(v => v.name.includes('Google') || v.name.includes('google'));
        return voice;
    }

    function speakGoogleVoice(text) {
        if (isSoundMuted) return;

        showVoiceNotificationToast(text);

        // Web Speech API
        if ('speechSynthesis' in window) {
            try {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'id-ID';
                utterance.rate = 0.95;
                utterance.pitch = 1.0;

                const voice = getGoogleIndonesianVoice();
                if (voice) {
                    utterance.voice = voice;
                }

                utterance.onerror = () => {
                    playGoogleTranslateFallback(text);
                };

                window.speechSynthesis.speak(utterance);
                return;
            } catch (err) {
                console.warn('SpeechSynthesis failed, trying fallback:', err);
            }
        }

        playGoogleTranslateFallback(text);
    }

    function playGoogleTranslateFallback(text) {
        if (isSoundMuted) return;
        try {
            const safeText = text.substring(0, 180);
            const ttsUrl = `https://translate.google.com/translate_tts?ie=UTF-8&tl=id&client=tw-ob&q=${encodeURIComponent(safeText)}`;
            const audio = new Audio(ttsUrl);
            audio.play().catch(e => console.warn('TTS playback prevented:', e));
        } catch(e) {}
    }

    function showVoiceNotificationToast(text) {
        let toastEl = document.getElementById('voiceToastIndicator');
        if (!toastEl) {
            toastEl = document.createElement('div');
            toastEl.id = 'voiceToastIndicator';
            toastEl.style.position = 'fixed';
            toastEl.style.bottom = '46px';
            toastEl.style.right = '20px';
            toastEl.style.background = 'rgba(15, 23, 42, 0.92)';
            toastEl.style.border = '1px solid #38bdf8';
            toastEl.style.boxShadow = '0 8px 32px rgba(0, 210, 255, 0.35)';
            toastEl.style.borderRadius = '10px';
            toastEl.style.padding = '8px 14px';
            toastEl.style.display = 'flex';
            toastEl.style.alignItems = 'center';
            toastEl.style.gap = '10px';
            toastEl.style.zIndex = '99999';
            toastEl.style.fontSize = '11px';
            toastEl.style.color = '#fff';
            toastEl.style.transition = 'all 0.3s ease';
            document.body.appendChild(toastEl);
        }

        toastEl.innerHTML = `
            <span class="spinner-grow spinner-grow-sm text-info" role="status"></span>
            <div>
                <strong style="color:#38bdf8; display:block; font-size:10px; text-transform:uppercase; letter-spacing:0.5px;">Google Voice Notification</strong>
                <span style="color:#e2e8f0;">${text.length > 70 ? text.substring(0, 67) + '...' : text}</span>
            </div>
        `;
        toastEl.style.opacity = '1';
        toastEl.style.transform = 'translateY(0)';

        clearTimeout(toastEl._timer);
        toastEl._timer = setTimeout(() => {
            toastEl.style.opacity = '0';
            toastEl.style.transform = 'translateY(10px)';
        }, 7000);
    }

    function testSoundAlert() {
        playRadarChime();
        setTimeout(() => {
            const testMsg = "Perhatian. Ini adalah uji coba sistem suara Google pada peringatan dini cuaca IMORA. Pemantauan 17 titik tambang beroperasi normal.";
            speakGoogleVoice(testMsg);
        }, 450);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       4. LEAFLET MAP & WEATHER DATA INTEGRATION (NO API KEY REQUIRED)
       ────────────────────────────────────────────────────────────────────────── */
    let map = null;
    let markersLayer = null;
    let darkTileLayer = null;
    let satTileLayer = null;
    let weatherResults = [];
    let hourlyChartInstance = null;
    let activeFilter = 'all';

    function initMap() {
        // Center around Indexim Coalindo mining leasehold (Sangkulirang / Kaliorang, East Kutai)
        map = L.map('weatherMap', {
            zoomControl: false,
            attributionControl: false
        }).setView([1.045, 117.658], 13);

        L.control.zoom({ position: 'topright' }).addTo(map);

        // Esri World Dark Gray Base & Reference - Clean dark radar basemap with NO API KEY REQUIRED / NO WATERMARKS
        const darkBase = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            maxNativeZoom: 16
        });
        const darkRef = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            maxNativeZoom: 16
        });
        darkTileLayer = L.layerGroup([darkBase, darkRef]);

        // Esri World Imagery (Satellite) - DEFAULT ACTIVE LAYER
        satTileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            maxNativeZoom: 18
        }).addTo(map);

        markersLayer = L.layerGroup().addTo(map);

        // Pause auto-popup rotation on user map interactions
        map.on('dragstart', () => { pausePopupCycle(20000); });
        map.on('zoomstart', () => { pausePopupCycle(20000); });
    }

    function setMapLayer(layerType) {
        document.getElementById('btnLayerDark').classList.toggle('active', layerType === 'dark');
        document.getElementById('btnLayerSat').classList.toggle('active', layerType === 'satellite');

        if (layerType === 'dark') {
            if (map.hasLayer(satTileLayer)) map.removeLayer(satTileLayer);
            if (!map.hasLayer(darkTileLayer)) map.addLayer(darkTileLayer);
        } else {
            if (map.hasLayer(darkTileLayer)) map.removeLayer(darkTileLayer);
            if (!map.hasLayer(satTileLayer)) map.addLayer(satTileLayer);
        }
    }

    let markerItems = [];
    let currentPopupIndex = -1;
    let popupCycleTimer = null;
    let isPopupCyclePaused = false;
    let popupPauseResumeTimeout = null;

    function startPopupCycle() {
        if (popupCycleTimer) clearInterval(popupCycleTimer);
        if (!markerItems || markerItems.length === 0) return;

        // Auto rotate popup on map every 7.5 seconds
        popupCycleTimer = setInterval(() => {
            if (isPopupCyclePaused) return;
            if (!markerItems || markerItems.length === 0) return;

            currentPopupIndex = (currentPopupIndex + 1) % markerItems.length;
            showPointPopup(currentPopupIndex, false);
        }, 7500);
    }

    function pausePopupCycle(durationMs = 15000) {
        isPopupCyclePaused = true;
        clearTimeout(popupPauseResumeTimeout);
        popupPauseResumeTimeout = setTimeout(() => {
            isPopupCyclePaused = false;
        }, durationMs);
    }

    function showPointPopup(index, isManual = false) {
        if (!markerItems || !markerItems[index]) return;
        currentPopupIndex = index;
        const mi = markerItems[index];
        const p = mi.point;

        const currentZoom = map.getZoom();
        const targetZoom = Math.max(currentZoom, 14);
        map.panTo([p.latitude, p.longitude], { animate: true, duration: 0.9 });

        mi.marker.openPopup();
        document.getElementById('selectedPointName').innerText = p.name;
        updateHourlyChart(mi.item);

        // Highlight active card in the list
        document.querySelectorAll('.point-card').forEach(c => c.classList.remove('active-card-highlight'));
        if (mi.card) {
            mi.card.classList.add('active-card-highlight');
            if (!isUserInteractingWithPoints && document.getElementById('tabContentPoints').style.display !== 'none') {
                mi.card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        if (isManual) {
            pausePopupCycle(20000);
            isUserInteractingWithPoints = true;
            clearTimeout(autoScrollPauseTimeout);
            autoScrollPauseTimeout = setTimeout(() => { isUserInteractingWithPoints = false; }, 8000);
        }
    }

    function resetMapView() {
        if (weatherResults && weatherResults.length > 0) {
            const bounds = L.latLngBounds(weatherResults.map(r => [r.point.latitude, r.point.longitude]));
            map.fitBounds(bounds, { padding: [40, 40] });
        } else {
            map.setView([1.045, 117.658], 13);
        }
    }

    // WMO Weather code helper
    function interpretWmoCode(code) {
        if (code === 0) return { desc: 'Cerah', icon: 'bi-sun-fill text-warning' };
        if (code === 1 || code === 2) return { desc: 'Cerah Berawan', icon: 'bi-cloud-sun-fill text-info' };
        if (code === 3) return { desc: 'Berawan Tebal', icon: 'bi-clouds-fill text-secondary' };
        if (code >= 51 && code <= 55) return { desc: 'Gerimis Ringan', icon: 'bi-cloud-drizzle-fill text-info' };
        if (code >= 61 && code <= 65) return { desc: 'Hujan', icon: 'bi-cloud-rain-fill text-primary' };
        if (code >= 80 && code <= 82) return { desc: 'Hujan Lebat (Showers)', icon: 'bi-cloud-rain-heavy-fill text-danger' };
        if (code >= 95 && code <= 99) return { desc: 'Badai Petir', icon: 'bi-cloud-lightning-rain-fill text-danger' };
        return { desc: 'Normal', icon: 'bi-cloud-fill text-muted' };
    }

    async function fetchForecastData() {
        try {
            // First attempt to call the local cached backend endpoint
            let response = await fetch('/EarlyWarning/GetForecast');
            if (!response.ok) {
                // Direct fallback to IMORA API
                response = await fetch('https://imora.indexim.id/api/v1/forecast');
            }
            if (!response.ok) throw new Error('Forecast unavailable');

            const payload = await response.json();
            weatherResults = payload.results || [];

            renderWeatherDashboard(weatherResults);
        } catch (err) {
            console.warn('Error fetching forecast, retrying in 10s:', err);
            setTimeout(fetchForecastData, 10000);
        }
    }

    function renderWeatherDashboard(results) {
        if (!results || results.length === 0) return;

        markersLayer.clearLayers();
        markerItems = [];

        let maxRain = 0;
        let maxRainLocation = 'Seluruh Pit Kering';
        let maxProb = 0;
        let maxProbLocation = '-';
        let maxWind = 0;
        let maxWindLocation = '-';
        let tempSum = 0;
        let warningPointsCount = 0;
        let activeAlertPoints = [];

        const bounds = [];
        const cardListEl = document.getElementById('pointsCardList');
        cardListEl.innerHTML = '';

        let tickerItems = [];

        results.forEach((item, index) => {
            const p = item.point;
            const fc = item.forecast.hourly;

            const curTemp = fc.temperature_2m ? fc.temperature_2m[0] : 25;
            const curPrecip = fc.precipitation ? fc.precipitation[0] : 0;
            const curProb = fc.precipitation_probability ? fc.precipitation_probability[0] : 0;
            const curWind = fc.wind_speed_10m ? fc.wind_speed_10m[0] : 0;
            const curGust = fc.wind_gusts_10m ? fc.wind_gusts_10m[0] : 0;
            const curCode = fc.weather_code ? fc.weather_code[0] : 0;

            tempSum += curTemp;

            // Track max stats
            if (curPrecip > maxRain) {
                maxRain = curPrecip;
                maxRainLocation = p.name;
            }
            if (curProb > maxProb) {
                maxProb = curProb;
                maxProbLocation = p.name;
            }
            if (curGust > maxWind) {
                maxWind = curGust;
                maxWindLocation = p.name;
            }

            // Determine Severity Level
            // 0: Green (Normal), 1: Yellow (Waspada), 2: Orange (Siaga), 3: Red (Awas)
            let severity = 'green';
            let statusText = 'Normal';

            if (curPrecip >= 5 || curGust >= 45 || curCode >= 95) {
                severity = 'red';
                statusText = 'Awas';
                warningPointsCount++;
                activeAlertPoints.push({ name: p.name, precip: curPrecip, gust: curGust, status: 'Awas' });
            } else if (curPrecip >= 2 || curGust >= 32) {
                severity = 'orange';
                statusText = 'Siaga';
                warningPointsCount++;
                activeAlertPoints.push({ name: p.name, precip: curPrecip, gust: curGust, status: 'Siaga' });
            } else if (curPrecip > 0 || curProb >= 50 || curGust >= 24) {
                severity = 'yellow';
                statusText = 'Waspada';
                warningPointsCount++;
                activeAlertPoints.push({ name: p.name, precip: curPrecip, gust: curGust, status: 'Waspada' });
            }

            bounds.push([p.latitude, p.longitude]);

            // Create Custom Radar Marker Pin for Leaflet
            const pinHtml = `
                <div class="radar-pin ${severity}">
                    <div class="core-dot"></div>
                    <div class="pulse-wave"></div>
                </div>
            `;
            const customIcon = L.divIcon({
                html: pinHtml,
                className: '',
                iconSize: [32, 32],
                iconAnchor: [16, 16]
            });

            const marker = L.marker([p.latitude, p.longitude], { icon: customIcon });

            // Marker Popup Content
            const wmoInfo = interpretWmoCode(curCode);
            const popupHtml = `
                <div style="font-family:'Poppins',sans-serif; min-width:200px; padding:4px;">
                    <div style="font-size:12px; font-weight:800; color:#0f172a; margin-bottom:4px; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">
                        <i class="bi bi-geo-alt-fill text-primary"></i> ${p.name}
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Kondisi Cuaca:</span>
                        <strong style="color:#0f172a;"><i class="${wmoInfo.icon}"></i> ${wmoInfo.desc}</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Curah Hujan (Now):</span>
                        <strong style="color:${curPrecip > 0 ? '#ef4444' : '#10b981'}; font-weight:800;">${curPrecip} mm/h</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Probabilitas Hujan:</span>
                        <strong style="color:#7c3aed;">${curProb}%</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Suhu Udara:</span>
                        <strong style="color:#0284c7;">${curTemp} &deg;C</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between;">
                        <span>Kecepatan / Gust:</span>
                        <strong style="color:#d97706;">${curWind} / ${curGust} km/h</strong>
                    </div>
                </div>
            `;
            marker.bindPopup(popupHtml);
            marker.on('click', () => {
                showPointPopup(index, true);
            });
            markersLayer.addLayer(marker);

            // Right Panel Point Card
            let cardClass = 'point-card';
            if (severity === 'red') cardClass += ' alert-item';
            else if (severity === 'yellow' || severity === 'orange') cardClass += ' warning-item';

            const card = document.createElement('div');
            card.className = cardClass;
            card.onclick = () => {
                showPointPopup(index, true);
            };

            markerItems.push({
                marker: marker,
                point: p,
                item: item,
                card: card,
                index: index
            });

            card.innerHTML = `
                <div class="point-badge" style="background:${severity === 'red' ? 'rgba(239,68,68,0.2)' : severity === 'orange' ? 'rgba(251,146,60,0.2)' : severity === 'yellow' ? 'rgba(251,191,36,0.2)' : 'rgba(16,185,129,0.2)'}; color:${severity === 'red' ? '#ef4444' : severity === 'orange' ? '#fb923c' : severity === 'yellow' ? '#fbbf24' : '#10b981'};">
                    <i class="${wmoInfo.icon}"></i>
                </div>
                <div>
                    <div class="point-name">${p.name}</div>
                    <div class="point-meta">
                        <span><i class="bi bi-wind"></i> ${curGust} km/h</span>
                        <span><i class="bi bi-percent"></i> ${curProb}% Prob</span>
                        <span class="badge ${severity === 'red' ? 'bg-danger' : severity === 'orange' ? 'bg-warning text-dark' : severity === 'yellow' ? 'bg-warning text-dark' : 'bg-success'}">${statusText}</span>
                    </div>
                </div>
                <div class="point-weather-col">
                    <div class="point-temp">${curTemp}&deg;C</div>
                    <div class="point-precip ${curPrecip > 0 ? 'wet' : 'dry'}">${curPrecip > 0 ? curPrecip + ' mm/h' : 'Kering'}</div>
                </div>
            `;
            cardListEl.appendChild(card);

            tickerItems.push(`${p.name}: ${curTemp}°C • Hujan: ${curPrecip}mm • Gust: ${curGust}km/h (${wmoInfo.desc})`);
        });

        // Fit map bounds initially
        if (bounds.length > 0) {
            map.fitBounds(L.latLngBounds(bounds), { padding: [35, 35] });
        }

        // Update HUD KPI Cards
        const avgTemp = (tempSum / results.length).toFixed(1);
        document.getElementById('kpiPointsCount').innerText = results.length;
        document.getElementById('kpiMaxRain').innerHTML = `${maxRain} <span style="font-size:12px;">mm/h</span>`;
        document.getElementById('kpiMaxRainLoc').innerText = maxRainLocation;
        document.getElementById('kpiRainBadge').innerText = `${maxRain} mm`;

        document.getElementById('kpiMaxProb').innerHTML = `${maxProb} <span style="font-size:12px;">%</span>`;
        document.getElementById('kpiMaxProbLoc').innerText = maxProbLocation;

        document.getElementById('kpiMaxWind').innerHTML = `${maxWind} <span style="font-size:12px;">km/h</span>`;
        document.getElementById('kpiMaxWindLoc').innerText = maxWindLocation;

        document.getElementById('kpiAvgTemp').innerHTML = `${avgTemp} <span style="font-size:12px;">&deg;C</span>`;

        // Update Warning Notification Banner & Sound Trigger
        const banner = document.getElementById('warningBanner');
        const iconBox = document.getElementById('warningIconBox');
        const icon = document.getElementById('warningIcon');
        const title = document.getElementById('warningTitle');
        const desc = document.getElementById('warningDesc');
        const kpiStatusBadge = document.getElementById('kpiStatusBadge');
        const kpiStatusText = document.getElementById('kpiStatusText');

        document.getElementById('warningPointsBadge').innerText = `${warningPointsCount} Titik Terindikasi`;

        if (activeAlertPoints.some(a => a.status === 'Awas')) {
            banner.className = 'warning-banner siaga';
            icon.className = 'bi bi-exclamation-octagon-fill text-danger';
            title.innerText = 'PERINGATAN DINI CUACA EKSTREM: SIAGA TINGGI!';
            desc.innerText = `Terdeteksi potensi hujan lebat & angin kencang di area: ${activeAlertPoints.filter(a => a.status === 'Awas').map(a => a.name).join(', ')}. Terapkan mitigasi K3 dan kurangi aktivitas di area lereng terbuka!`;
            kpiStatusBadge.className = 'badge bg-danger';
            kpiStatusBadge.innerText = 'SIAGA';
            kpiStatusText.className = 'kpi-num text-danger';
            kpiStatusText.innerText = 'AWAS';

            // Trigger emergency audio siren + Google Voice announcement (limit once per 90 seconds)
            const nowTime = Date.now();
            if (nowTime - lastAudioAlertTime > 90000) {
                lastAudioAlertTime = nowTime;
                playEmergencyWarningSiren();
                setTimeout(() => {
                    const alertMsg = `Peringatan dini cuaca ekstrem status siaga. Terdeteksi potensi hujan lebat dan angin kencang di pit tambang. Seluruh personel wajib mematuhi keselamatan kerja.`;
                    speakGoogleVoice(alertMsg);
                }, 1200);
            }
        } else if (warningPointsCount > 0) {
            banner.className = 'warning-banner waspada';
            icon.className = 'bi bi-exclamation-triangle-fill text-warning';
            title.innerText = 'PERINGATAN DINI CUACA: STATUS WASPADA';
            desc.innerText = `Terdapat potensi gerimis/presipitasi meningkat di ${warningPointsCount} titik (${activeAlertPoints.slice(0, 3).map(a => a.name).join(', ')}). Waspada jalan hauling licin dan jaga jarak aman berkendara.`;
            kpiStatusBadge.className = 'badge bg-warning text-dark';
            kpiStatusBadge.innerText = 'WASPADA';
            kpiStatusText.className = 'kpi-num text-warning';
            kpiStatusText.innerText = 'WASPADA';

            const nowTime = Date.now();
            if (nowTime - lastAudioAlertTime > 120000) {
                lastAudioAlertTime = nowTime;
                playRadarChime();
                setTimeout(() => {
                    const warnMsg = `Peringatan dini cuaca status waspada. Terdeteksi potensi hujan pada ${warningPointsCount} titik tambang. Harap berhati-hati dan kurangi kecepatan unit.`;
                    speakGoogleVoice(warnMsg);
                }, 500);
            }
        } else {
            banner.className = 'warning-banner normal';
            icon.className = 'bi bi-shield-check text-success';
            title.innerText = 'KONDISI CUACA SITE: NORMAL & AMAN';
            desc.innerText = 'Tidak ada potensi hujan lebat, petir, atau hembusan angin kencang berisiko di seluruh 17 titik operasional tambang.';
            kpiStatusBadge.className = 'badge bg-success';
            kpiStatusBadge.innerText = 'AMAN';
            kpiStatusText.className = 'kpi-num text-success';
            kpiStatusText.innerText = 'NORMAL';
        }

        // Update Bottom Ticker
        document.getElementById('weatherTickerText').innerText = tickerItems.join('  •  ');

        // Render Initial Hourly Chart (Combined or Point 1)
        updateHourlyChart(results[0]);

        // Start cycling popups across the 17 mining operational points on satellite map
        startPopupCycle();
    }

    /* ──────────────────────────────────────────────────────────────────────────
       6. AUTOMATIC TAB ROTATION (Daftar Titik -> Tren 24 Jam -> Panduan K3)
       ────────────────────────────────────────────────────────────────────────── */
    const TABS_SEQUENCE = [
        { id: 'points', duration: 35000 }, // 35 seconds for points list
        { id: 'chart', duration: 25000 },  // 25 seconds for hourly trend chart
        { id: 'safety', duration: 20000 }  // 20 seconds for safety protocols
    ];
    let currentTabSeqIndex = 0;
    let tabRotationTimeout = null;
    let isTabRotationPaused = false;

    function startTabRotation() {
        scheduleNextTab();
    }

    function scheduleNextTab() {
        if (tabRotationTimeout) clearTimeout(tabRotationTimeout);
        if (isTabRotationPaused) return;

        const currentTabObj = TABS_SEQUENCE[currentTabSeqIndex];
        tabRotationTimeout = setTimeout(() => {
            if (isTabRotationPaused) return;
            currentTabSeqIndex = (currentTabSeqIndex + 1) % TABS_SEQUENCE.length;
            const nextTab = TABS_SEQUENCE[currentTabSeqIndex];
            switchRightTab(nextTab.id, false);
            scheduleNextTab();
        }, currentTabObj.duration);
    }

    function pauseTabRotation(durationMs = 25000) {
        isTabRotationPaused = true;
        if (tabRotationTimeout) clearTimeout(tabRotationTimeout);
        setTimeout(() => {
            isTabRotationPaused = false;
            scheduleNextTab();
        }, durationMs);
    }

    function switchRightTab(tabName, isManual = false) {
        document.getElementById('tabPointsBtn').classList.toggle('active', tabName === 'points');
        document.getElementById('tabChartBtn').classList.toggle('active', tabName === 'chart');
        document.getElementById('tabSafetyBtn').classList.toggle('active', tabName === 'safety');

        document.getElementById('tabContentPoints').style.display = tabName === 'points' ? 'flex' : 'none';
        document.getElementById('tabContentChart').style.display = tabName === 'chart' ? 'flex' : 'none';
        document.getElementById('tabContentSafety').style.display = tabName === 'safety' ? 'flex' : 'none';

        if (tabName === 'chart' && hourlyChartInstance) {
            setTimeout(() => {
                hourlyChartInstance.resize();
            }, 60);
        }

        if (isManual) {
            const idx = TABS_SEQUENCE.findIndex(t => t.id === tabName);
            if (idx !== -1) currentTabSeqIndex = idx;
            pauseTabRotation(30000);
        }
    }

    function updateHourlyChart(item) {
        if (!item || !item.forecast || !item.forecast.hourly) return;
        const fc = item.forecast.hourly;
        const labels = (fc.time || []).slice(0, 24).map(t => {
            const parts = t.split('T');
            return parts.length > 1 ? parts[1] : t;
        });
        const precipData = (fc.precipitation || []).slice(0, 24);
        const tempData = (fc.temperature_2m || []).slice(0, 24);
        const windData = (fc.wind_gusts_10m || []).slice(0, 24);

        document.getElementById('chartLocationLabel').innerText = `Prakiraan 24 Jam: ${item.point.name}`;

        const ctx = document.getElementById('hourlyWeatherChart').getContext('2d');
        if (hourlyChartInstance) {
            hourlyChartInstance.destroy();
        }

        hourlyChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Hujan (mm)',
                        data: precipData,
                        backgroundColor: 'rgba(56, 189, 248, 0.65)',
                        borderColor: '#0284c7',
                        borderWidth: 1,
                        yAxisID: 'yPrecip',
                        order: 2
                    },
                    {
                        label: 'Suhu (°C)',
                        data: tempData,
                        type: 'line',
                        borderColor: '#fbbf24',
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        tension: 0.3,
                        pointRadius: 2,
                        yAxisID: 'yTemp',
                        order: 1
                    },
                    {
                        label: 'Gust Angin (km/h)',
                        data: windData,
                        type: 'line',
                        borderColor: '#fb923c',
                        borderDash: [4, 4],
                        backgroundColor: 'transparent',
                        borderWidth: 1.5,
                        tension: 0.3,
                        pointRadius: 0,
                        yAxisID: 'yWind',
                        order: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        labels: { color: '#cbd5e1', font: { family: 'Poppins', size: 10 } }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: '#94a3b8', font: { size: 9 }, maxRotation: 45 },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    yPrecip: {
                        type: 'linear',
                        position: 'left',
                        title: { display: true, text: 'Hujan (mm)', color: '#38bdf8', font: { size: 9 } },
                        ticks: { color: '#38bdf8', font: { size: 9 }, beginAtZero: true },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    yTemp: {
                        type: 'linear',
                        position: 'right',
                        title: { display: true, text: 'Suhu (°C)', color: '#fbbf24', font: { size: 9 } },
                        ticks: { color: '#fbbf24', font: { size: 9 } },
                        grid: { drawOnChartArea: false }
                    },
                    yWind: {
                        type: 'linear',
                        position: 'right',
                        display: false,
                        grid: { drawOnChartArea: false }
                    }
                }
            }
        });
    }

    /* ──────────────────────────────────────────────────────────────────────────
       5. AUTO-SCROLL ENGINE FOR OPERATIONAL POINTS (TV DASHBOARD MODE)
       ────────────────────────────────────────────────────────────────────────── */
    let isAutoScrollEnabled = true;
    let isUserInteractingWithPoints = false;
    let autoScrollPauseTimeout = null;
    let autoScrollRaf = null;
    let lastScrollTimestamp = 0;
    let edgeHoldUntil = 0;

    function toggleAutoScroll() {
        isAutoScrollEnabled = !isAutoScrollEnabled;
        const badge = document.getElementById('autoScrollBadge');
        if (badge) {
            if (isAutoScrollEnabled) {
                badge.style.background = 'rgba(56,189,248,0.15)';
                badge.style.borderColor = 'rgba(56,189,248,0.4)';
                badge.style.color = '#38bdf8';
                badge.innerHTML = '<i class="bi bi-arrow-down-up"></i> Auto-Scroll: ON';
            } else {
                badge.style.background = 'rgba(148,163,184,0.15)';
                badge.style.borderColor = 'rgba(148,163,184,0.3)';
                badge.style.color = '#94a3b8';
                badge.innerHTML = '<i class="bi bi-pause-circle"></i> Auto-Scroll: OFF';
            }
        }
    }

    function initAutoScroll() {
        const container = document.getElementById('tabContentPoints');
        if (!container) return;

        // Pause auto-scroll on hover, wheel, or touch interaction
        container.addEventListener('mouseenter', () => { isUserInteractingWithPoints = true; });
        container.addEventListener('mouseleave', () => { isUserInteractingWithPoints = false; });
        container.addEventListener('wheel', () => {
            isUserInteractingWithPoints = true;
            clearTimeout(autoScrollPauseTimeout);
            autoScrollPauseTimeout = setTimeout(() => { isUserInteractingWithPoints = false; }, 4000);
        }, { passive: true });
        container.addEventListener('touchstart', () => { isUserInteractingWithPoints = true; }, { passive: true });
        container.addEventListener('touchend', () => {
            clearTimeout(autoScrollPauseTimeout);
            autoScrollPauseTimeout = setTimeout(() => { isUserInteractingWithPoints = false; }, 4000);
        }, { passive: true });

        const holdDurationMs = 2500;

        function stepAutoScroll(timestamp) {
            if (!lastScrollTimestamp) lastScrollTimestamp = timestamp;
            const delta = timestamp - lastScrollTimestamp;
            lastScrollTimestamp = timestamp;

            if (isAutoScrollEnabled && !isUserInteractingWithPoints) {
                const tabPoints = document.getElementById('tabContentPoints');
                if (tabPoints && tabPoints.style.display !== 'none') {
                    const now = Date.now();
                    if (now >= edgeHoldUntil) {
                        const maxScroll = tabPoints.scrollHeight - tabPoints.clientHeight;
                        if (maxScroll > 10) {
                            if (tabPoints.scrollTop >= maxScroll - 2) {
                                // Bottom reached: hold for 2.5s, then smooth return to top
                                edgeHoldUntil = now + holdDurationMs;
                                setTimeout(() => {
                                    tabPoints.scrollTo({ top: 0, behavior: 'smooth' });
                                    edgeHoldUntil = Date.now() + 2000;
                                }, 500);
                            } else {
                                tabPoints.scrollTop += Math.max(0.4, (delta / 16.6) * 0.4);
                            }
                        }
                    }
                }
            }
            autoScrollRaf = requestAnimationFrame(stepAutoScroll);
        }

        if (autoScrollRaf) cancelAnimationFrame(autoScrollRaf);
        autoScrollRaf = requestAnimationFrame(stepAutoScroll);
    }

    // Initialize Map, Speech, Auto-Scroll, Tab Carousel, and Fetch Live Forecast
    window.addEventListener('DOMContentLoaded', () => {
        initVoiceSynthesis();
        initMap();
        initAutoScroll();
        startTabRotation();
        fetchForecastData();

        // Refresh forecast every 5 minutes (300,000 ms) as specified by IMORA integration guide
        setInterval(fetchForecastData, 300000);
    });
    </script>
</body>
</html>
