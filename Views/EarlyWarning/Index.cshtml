@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Display 4 &mdash; IMORA Early Warning Weather Command Center</title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">

    <!-- Leaflet.js CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Chart.js for Hourly Trend -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg: #050811;
            --panel: rgba(10, 18, 32, 0.85);
            --panel-card: rgba(15, 23, 42, 0.7);
            --border: rgba(56, 189, 248, 0.16);
            --border-bright: rgba(56, 189, 248, 0.45);
            --txt: #ffffff;
            --muted: #94a3b8;
            --blue: #38bdf8;
            --cyan: #00d2ff;
            --emerald: #10b981;
            --green: #34d399;
            --amber: #fbbf24;
            --orange: #fb923c;
            --red: #ef4444;
            --purple: #a855f7;
            --r: 16px;
        }

        html { background: var(--bg); }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; font-family: inherit; }

        body {
            background: var(--bg);
            background-image:
                radial-gradient(rgba(56, 189, 248, 0.035) 1px, transparent 1px),
                radial-gradient(circle at 10% 10%, rgba(56, 189, 248, 0.09) 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(16, 185, 129, 0.07) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(2, 132, 199, 0.04) 0%, transparent 60%);
            background-size: 28px 28px, 100% 100%, 100% 100%, 100% 100%;
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: var(--txt);
            height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* ── Top Countdown Progress Bar ── */
        .top-progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.06);
            z-index: 9999;
        }
        .top-progress-inner {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #00d2ff, #38bdf8, #10b981, #fbbf24, #ef4444);
            box-shadow: 0 0 14px rgba(0, 210, 255, 0.9);
            transition: width 1s linear;
        }

        /* ── TV Main Layout ── */
        .tv-container {
            display: grid;
            grid-template-rows: auto auto auto 1fr auto;
            height: 100vh;
            padding: 8px 16px 8px 16px;
            gap: 8px;
        }

        /* ── Header ── */
        .tv-header {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: var(--r);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: 8px 18px;
            display: grid;
            grid-template-columns: auto 1fr auto auto;
            align-items: center;
            gap: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 1px 1px rgba(255,255,255,0.06);
        }

        .brand-box { display: flex; align-items: center; gap: 12px; }
        .brand-icon {
            width: 44px; height: 44px; border-radius: 12px;
            background: linear-gradient(135deg, rgba(0, 210, 255, 0.2), rgba(16, 185, 129, 0.25));
            border: 1.5px solid var(--cyan);
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 0 18px rgba(0, 210, 255, 0.45);
        }
        .brand-title {
            font-size: 18px; font-weight: 800;
            background: linear-gradient(90deg, #ffffff, #38bdf8, #34d399);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex; align-items: center; gap: 8px;
            letter-spacing: 0.3px;
        }
        .brand-sub {
            font-size: 10.5px; color: var(--muted); font-weight: 600;
            letter-spacing: 0.6px; text-transform: uppercase;
        }

        /* Slide Switcher Widget */
        .slide-indicator-widget {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid var(--border);
            border-radius: 30px;
            padding: 4px 12px 4px 10px;
            justify-self: center;
        }
        .slide-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 800;
            color: #38bdf8;
            background: rgba(56, 189, 248, 0.14);
            border: 1px solid rgba(56, 189, 248, 0.35);
            padding: 3px 9px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .slide-timer-text {
            font-size: 11px;
            font-weight: 700;
            color: #cbd5e1;
            font-variant-numeric: tabular-nums;
        }
        .slide-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #fff;
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 10.5px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all 0.2s;
        }
        .slide-btn:hover {
            background: rgba(56, 189, 248, 0.2);
            border-color: var(--blue);
            color: #fff;
        }
        .slide-btn.active-display {
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            border-color: #38bdf8;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
        }

        /* Sound & Header Controls */
        .hdr-actions { display: flex; align-items: center; gap: 10px; }
        .hdr-ctrl-btn {
            height: 36px; padding: 0 12px; border-radius: 9px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            color: var(--txt); display: flex; align-items: center; justify-content: center; gap: 6px;
            font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.2s;
        }
        .hdr-ctrl-btn:hover { background: rgba(56, 189, 248, 0.2); border-color: var(--blue); color: #fff; }
        .hdr-ctrl-btn.sound-active {
            background: rgba(16, 185, 129, 0.18);
            border-color: rgba(16, 185, 129, 0.5);
            color: #34d399;
        }
        .hdr-ctrl-btn.sound-muted {
            background: rgba(239, 68, 68, 0.18);
            border-color: rgba(239, 68, 68, 0.5);
            color: #fca5a5;
        }

        .clock-widget {
            display: flex; flex-direction: column; align-items: flex-end;
            padding: 4px 12px; background: rgba(0, 0, 0, 0.35);
            border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.06);
        }
        .clock-time {
            font-size: 17px; font-weight: 800;
            color: #38bdf8; letter-spacing: 0.5px;
            font-variant-numeric: tabular-nums;
            font-family: 'JetBrains Mono', monospace;
        }
        .clock-date { font-size: 9.5px; color: var(--muted); font-weight: 600; }

        /* ── Weather Warning Banner (Dynamic) ── */
        .warning-banner {
            border-radius: 12px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }
        .warning-banner.normal {
            background: linear-gradient(90deg, rgba(16, 185, 129, 0.15), rgba(6, 78, 59, 0.3));
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #a7f3d0;
        }
        .warning-banner.waspada {
            background: linear-gradient(90deg, rgba(251, 191, 36, 0.22), rgba(120, 53, 15, 0.35));
            border: 1px solid rgba(251, 191, 36, 0.5);
            color: #fde68a;
            animation: pulse-yellow 2s infinite ease-in-out;
        }
        .warning-banner.siaga {
            background: linear-gradient(90deg, rgba(239, 68, 68, 0.25), rgba(127, 29, 29, 0.45));
            border: 1.5px solid rgba(239, 68, 68, 0.7);
            color: #fecaca;
            animation: pulse-red 1.5s infinite ease-in-out;
        }

        @@keyframes pulse-red {
            0%, 100% { box-shadow: 0 0 15px rgba(239, 68, 68, 0.4); border-color: rgba(239, 68, 68, 0.7); }
            50% { box-shadow: 0 0 30px rgba(239, 68, 68, 0.85); border-color: #ef4444; }
        }
        @@keyframes pulse-yellow {
            0%, 100% { box-shadow: 0 0 12px rgba(251, 191, 36, 0.3); }
            50% { box-shadow: 0 0 25px rgba(251, 191, 36, 0.7); }
        }

        .warning-left { display: flex; align-items: center; gap: 12px; }
        .warning-icon-box {
            width: 38px; height: 38px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .warning-banner.normal .warning-icon-box { background: rgba(16, 185, 129, 0.25); color: #34d399; }
        .warning-banner.waspada .warning-icon-box { background: rgba(251, 191, 36, 0.3); color: #fbbf24; }
        .warning-banner.siaga .warning-icon-box { background: rgba(239, 68, 68, 0.35); color: #ef4444; }

        .warning-title { font-size: 13px; font-weight: 800; letter-spacing: 0.3px; text-transform: uppercase; }
        .warning-desc { font-size: 11px; opacity: 0.9; font-weight: 500; }
        .warning-meta { display: flex; align-items: center; gap: 10px; font-size: 11px; }

        /* ── KPI HUD Cards Row ── */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 8px;
        }
        .kpi-card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 8px 12px;
            backdrop-filter: blur(16px);
            position: relative;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(0,0,0,0.25);
            transition: all 0.2s ease;
        }
        .kpi-card:hover { transform: translateY(-2px); border-color: var(--border-bright); }
        .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; }
        .kpi-card.status::before { background: linear-gradient(180deg, #10b981, #059669); }
        .kpi-card.points::before { background: linear-gradient(180deg, #00d2ff, #0284c7); }
        .kpi-card.rain::before { background: linear-gradient(180deg, #38bdf8, #0369a1); }
        .kpi-card.prob::before { background: linear-gradient(180deg, #a855f7, #7e22ce); }
        .kpi-card.wind::before { background: linear-gradient(180deg, #fb923c, #c2410c); }
        .kpi-card.temp::before { background: linear-gradient(180deg, #fbbf24, #d97706); }

        .kpi-hdr { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
        .kpi-title {
            font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
            color: var(--muted); display: flex; align-items: center; gap: 5px;
        }
        .kpi-num {
            font-size: 22px; font-weight: 800; line-height: 1.1; letter-spacing: -0.3px;
            font-family: 'JetBrains Mono', 'Poppins', monospace;
        }
        .kpi-sub { font-size: 9.5px; color: var(--muted); font-weight: 500; margin-top: 2px; }

        /* ── Main View Grid: Map (Left) + Detail Tabs (Right) ── */
        .main-grid {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: 10px;
            min-height: 0;
            height: 100%;
        }

        /* ── Map Panel ── */
        .map-panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: var(--r);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        }
        .panel-header {
            padding: 8px 14px;
            background: rgba(15, 23, 42, 0.8);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .panel-title {
            font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;
            display: flex; align-items: center; gap: 7px; color: #fff;
        }
        .map-layer-controls {
            display: flex; align-items: center; gap: 6px;
        }
        .layer-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: var(--muted);
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .layer-btn.active, .layer-btn:hover {
            background: rgba(56, 189, 248, 0.2);
            border-color: var(--blue);
            color: #fff;
        }

        #weatherMap {
            flex: 1;
            width: 100%;
            height: 100%;
            background: #060b17;
            z-index: 10;
        }

        /* Leaflet Custom Marker & Pulsing Radar Pin */
        .radar-pin {
            position: relative;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .radar-pin .core-dot {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid #ffffff;
            box-shadow: 0 0 10px rgba(0,0,0,0.8);
            z-index: 2;
        }
        .radar-pin .pulse-wave {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 32px; height: 32px;
            border-radius: 50%;
            animation: radar-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
            z-index: 1;
        }
        .radar-pin.green .core-dot { background: #10b981; }
        .radar-pin.green .pulse-wave { border: 2px solid rgba(16, 185, 129, 0.6); }

        .radar-pin.yellow .core-dot { background: #fbbf24; }
        .radar-pin.yellow .pulse-wave { border: 2.5px solid rgba(251, 191, 36, 0.8); animation-duration: 1.3s; }

        .radar-pin.orange .core-dot { background: #fb923c; }
        .radar-pin.orange .pulse-wave { border: 3px solid rgba(251, 146, 60, 0.85); animation-duration: 1.0s; }

        .radar-pin.red .core-dot { background: #ef4444; }
        .radar-pin.red .pulse-wave { border: 3.5px solid rgba(239, 68, 68, 0.95); animation-duration: 0.8s; }

        @@keyframes radar-ping {
            0% { width: 12px; height: 12px; opacity: 1; }
            100% { width: 44px; height: 44px; opacity: 0; }
        }

        .map-legend {
            position: absolute;
            bottom: 12px;
            left: 12px;
            background: rgba(10, 18, 32, 0.9);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 6px 12px;
            z-index: 999;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 10px;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .legend-item { display: flex; align-items: center; gap: 5px; }
        .legend-dot { width: 9px; height: 9px; border-radius: 50%; }

        /* ── Right Panel: Tabs, Points List & Hourly Forecast ── */
        .right-panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: var(--r);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            min-height: 0;
        }
        .nav-tabs-ews {
            display: flex;
            align-items: center;
            background: rgba(15, 23, 42, 0.8);
            border-bottom: 1px solid var(--border);
            padding: 4px 8px;
            gap: 4px;
        }
        .tab-ews-btn {
            background: transparent;
            border: none;
            color: var(--muted);
            padding: 6px 14px;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            text-transform: uppercase;
        }
        .tab-ews-btn:hover { color: #fff; background: rgba(255, 255, 255, 0.05); }
        .tab-ews-btn.active {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #fff;
            box-shadow: 0 0 10px rgba(2, 132, 199, 0.5);
        }

        .tab-content-area {
            flex: 1;
            overflow-y: auto;
            padding: 10px 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .tab-content-area::-webkit-scrollbar { width: 5px; }
        .tab-content-area::-webkit-scrollbar-thumb { background: rgba(56, 189, 248, 0.25); border-radius: 10px; }

        /* Operational Point Cards */
        .point-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 10px;
            padding: 8px 12px;
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 12px;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .point-card:hover {
            background: rgba(30, 41, 59, 0.7);
            border-color: var(--blue);
            transform: translateX(3px);
        }
        .point-card.warning-item {
            border-color: rgba(251, 191, 36, 0.6);
            background: rgba(120, 53, 15, 0.2);
        }
        .point-card.alert-item {
            border-color: rgba(239, 68, 68, 0.7);
            background: rgba(127, 29, 29, 0.3);
        }
        .point-card.active-card-highlight {
            border-color: #38bdf8 !important;
            background: rgba(14, 165, 233, 0.25) !important;
            box-shadow: 0 0 16px rgba(56, 189, 248, 0.45);
            transform: translateX(5px);
        }

        .point-badge {
            width: 38px; height: 38px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
        }
        .point-name { font-size: 12px; font-weight: 800; color: #fff; }
        .point-meta { font-size: 10px; color: var(--muted); margin-top: 1px; display: flex; gap: 8px; }
        .point-weather-col { text-align: right; }
        .point-temp { font-size: 15px; font-weight: 800; color: #38bdf8; font-family: 'JetBrains Mono', monospace; }
        .point-precip { font-size: 10.5px; font-weight: 700; }
        .point-precip.wet { color: #f87171; }
        .point-precip.dry { color: #34d399; }

        /* Hourly Forecast Chart Container */
        .chart-box {
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px;
            height: 220px;
            position: relative;
        }

        /* ── Safety Recommendations Box ── */
        .safety-box {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .safety-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 11px;
            padding: 6px 10px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            border-left: 3px solid var(--blue);
        }

        /* ── Bottom Ticker ── */
        .tv-footer-ticker {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 5px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            overflow: hidden;
        }
        .ticker-lbl {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #fff;
            font-size: 10.5px;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 5px;
            white-space: nowrap;
            letter-spacing: 0.5px;
            box-shadow: 0 0 10px rgba(2, 132, 199, 0.5);
            flex-shrink: 0;
            z-index: 2;
        }
        .ticker-scroll-wrap {
            flex: 1;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
        }
        .ticker-scroll {
            display: inline-block;
            white-space: nowrap;
            font-size: 11px;
            font-weight: 600;
            color: #e2e8f0;
            animation: ticker-marquee 70s linear infinite;
        }
        .ticker-scroll:hover {
            animation-play-state: paused;
        }
        @@keyframes ticker-marquee {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
    </style>
</head>
<body>
    <!-- Top Progress Bar -->
    <div class="top-progress-bar">
        <div class="top-progress-inner" id="slideProgressBar"></div>
    </div>

    <div class="tv-container">
        <!-- 1. Header -->
        <header class="tv-header">
            <div class="brand-box">
                <div class="brand-icon">
                    <i class="bi bi-cloud-lightning-rain-fill text-info" style="font-size: 22px;"></i>
                </div>
                <div>
                    <div class="brand-title">
                        IMORA &bull; EARLY WARNING SYSTEM
                        <span style="font-size:12px; color:var(--muted); font-weight:600;">[DISPLAY 4 &bull; WEATHER RADAR]</span>
                    </div>
                    <div class="brand-sub">
                        INDEXIM METEOROLOGICAL &amp; OPERATIONAL RADAR COMMAND CENTER
                    </div>
                </div>
            </div>

            <!-- Slide Indicator Widget -->
            <div class="slide-indicator-widget">
                <div class="slide-pill">
                    <i class="bi bi-display"></i> Slide 4 / 4
                </div>
                <div class="slide-timer-text">
