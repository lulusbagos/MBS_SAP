    /* ── Klasifikasi 5 Kategori Curah Hujan Sesuai Aturan:
       1. Hujan Ringan: 0 - 20 mm/hari
       2. Hujan Sedang: 20 - 50 mm/hari
       3. Hujan Lebat: 50 - 100 mm/hari (atau >= 50 mm/jam) -> MENGELUARKAN SUARA LEVEL 1
       4. Hujan Sangat Lebat: 100 - 150 mm/hari (atau >= 80 mm/jam) -> MENGELUARKAN SUARA LEVEL 2
       5. Hujan Ekstrem: >= 150 mm/hari (atau >= 100 mm/jam) -> MENGELUARKAN SUARA LEVEL 3
    ── */
    function classifyRainfall(dailyAccumMm = 0, hourlyRateMm = 0) {
        const d = Number(dailyAccumMm) || 0;
        const h = Number(hourlyRateMm) || 0;

        if (d >= 150 || h >= 100) {
            return {
                tier: 5,
                level: 'ekstrem',
                name: 'Hujan Ekstrem',
                rangeLabel: '\u2265 150 mm/hari',
                rateLabel: h >= 100 ? `${h.toFixed(1)} mm/jam` : '',
                severity: 'kritis',
                statusText: 'Hujan Ekstrem',
                kpiBadge: 'EKSTREM',
                kpiClass: 'bg-danger',
                hasAudioAlarm: true,
                soundTier: 100,
                desc: 'Terdeteksi curah hujan ekstrem (\u2265 150 mm/hari). Bahaya longsor lereng pit & banjir bandang limpasan! Segera hentikan operasional dan evakuasi ke shelter aman.'
            };
        }
        if (d >= 100 || h >= 80) {
            return {
                tier: 4,
                level: 'sangat-lebat',
                name: 'Hujan Sangat Lebat',
                rangeLabel: '100 - 150 mm/hari',
                rateLabel: h >= 80 ? `${h.toFixed(1)} mm/jam` : '',
                severity: 'red',
                statusText: 'Hujan Sangat Lebat',
                kpiBadge: 'SANGAT LEBAT',
                kpiClass: 'bg-danger',
                hasAudioAlarm: true,
                soundTier: 80,
                desc: 'Terdeteksi curah hujan sangat lebat (100 - 150 mm/hari). Waspada ketidakstabilan lereng disposal (DCI) dan pastikan pompa sump dewatering aktif penuh.'
            };
        }
        if (d >= 50 || h >= 50) {
            return {
                tier: 3,
                level: 'lebat',
                name: 'Hujan Lebat',
                rangeLabel: '50 - 100 mm/hari',
                rateLabel: h >= 50 ? `${h.toFixed(1)} mm/jam` : '',
                severity: 'orange',
                statusText: 'Hujan Lebat',
                kpiBadge: 'LEBAT',
                kpiClass: 'bg-warning text-dark',
                hasAudioAlarm: true,
                soundTier: 50,
                desc: 'Terdeteksi curah hujan lebat (50 - 100 mm/hari). Waspada jalan hauling sangat licin, kurangi batas kecepatan DT maksimal 30 km/jam dan jaga jarak aman 4x kendaraan.'
            };
        }
        if (d >= 20 || h >= 5) {
            return {
                tier: 2,
                level: 'sedang',
                name: 'Hujan Sedang',
                rangeLabel: '20 - 50 mm/hari',
                rateLabel: h >= 5 ? `${h.toFixed(1)} mm/jam` : '',
                severity: 'yellow',
                statusText: 'Hujan Sedang',
                kpiBadge: 'SEDANG',
                kpiClass: 'bg-warning text-dark',
                hasAudioAlarm: false,
                soundTier: 0,
                desc: 'Terpantau curah hujan intensitas sedang (20 - 50 mm/hari). Permukaan hauling mulai basah dan licin, kurangi kecepatan armada dan jaga jarak aman.'
            };
        }
        return {
            tier: 1,
            level: 'ringan',
            name: d > 0 ? 'Hujan Ringan' : 'Cerah / Kering',
            rangeLabel: '0 - 20 mm/hari',
            rateLabel: h > 0 ? `${h.toFixed(1)} mm/jam` : '0 mm/h',
            severity: 'green',
            statusText: d > 0 ? 'Hujan Ringan' : 'Normal',
            kpiBadge: d > 0 ? 'RINGAN' : 'AMAN',
            kpiClass: d > 0 ? 'bg-info text-dark' : 'bg-success',
            hasAudioAlarm: false,
            soundTier: 0,
            desc: d > 0 
                ? 'Terpantau hujan ringan / gerimis (0 - 20 mm/hari). Hauling aman dan terkendali, pengemudi tetap waspada.' 
                : 'Kondisi cuaca saat ini kondusif dan prakiraan cuaca hari ini cerah/berawan di seluruh 17 titik tambang.'
        };
    }

    let lastRainAlertTier = 0; // Tracks highest active audio tier (50, 80, 100)
    let lastRainAlertTime = 0;
    const RAIN_ALERT_REPEAT_INTERVAL_MS = 1800000; // 30 minutes repeat interval

    /* ── Chime Lonceng Lembut (Ting Ting) Sesuai Permintaan:
       - Suara tidak terlalu keras (volume nyaman gain 0.18, gelombang sine jernih & harmonic chime)
       - 1x Ting: Curah Hujan Level 1 / Lebat (50 - 100 mm/hari atau >= 50 mm/jam)
       - 2x Ting Ting: Curah Hujan Level 2 / Sangat Lebat (100 - 150 mm/hari atau >= 80 mm/jam)
       - 3x Ting Ting Ting: Curah Hujan Level 3 / Ekstrem (>= 150 mm/hari atau >= 100 mm/jam)
    ── */
    function playTingChime(count = 1) {
        if (isSoundMuted) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        try {
            const now = ctx.currentTime;
            const interval = 0.38; // Jeda antar bunyi "ting"
            const fundamentalFreq = 1046.5; // C6 (nada lonceng lembut & jernih)
            const overtoneFreq = 2093.0;    // C7 (harmonis kilau lonceng)

            for (let i = 0; i < count; i++) {
                const start = now + (i * interval);
                const duration = 0.65;

                // 1. Nada Utama (Fundamental Sine Wave)
                const osc1 = ctx.createOscillator();
                const gain1 = ctx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(fundamentalFreq, start);

                // Attack cepat & decay meluruh halus
                gain1.gain.setValueAtTime(0.0001, start);
                gain1.gain.linearRampToValueAtTime(0.18, start + 0.008); // Volume lembut & nyaman
                gain1.gain.exponentialRampToValueAtTime(0.0001, start + duration);

                osc1.connect(gain1);
                gain1.connect(ctx.destination);
                osc1.start(start);
                osc1.stop(start + duration);

                // 2. Kilau Harmonis Lonceng (Acoustic Bell Shimmer)
                const osc2 = ctx.createOscillator();
                const gain2 = ctx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(overtoneFreq, start);

                gain2.gain.setValueAtTime(0.0001, start);
                gain2.gain.linearRampToValueAtTime(0.06, start + 0.005);
                gain2.gain.exponentialRampToValueAtTime(0.0001, start + 0.35);

                osc2.connect(gain2);
                gain2.connect(ctx.destination);
                osc2.start(start);
                osc2.stop(start + 0.38);
            }
        } catch(e) {
            console.warn('playTingChime error:', e);
        }
    }

    // Fungsi wrapper kompatibilitas:
    function playRadarChime() { playTingChime(1); }
    function playRainAlertSound50() { playTingChime(1); }
    function playRainAlertSound80() { playTingChime(2); }
    function playRainAlertSound100() { playTingChime(3); }
    function playEmergencyWarningSiren() { playTingChime(2); }

    function triggerRainAlert(tier, locationStr = '', dailyVal = 0, rateVal = 0, isTest = false, timeEstimateStr = '') {
        const cleanLoc = locationStr ? `di area ${locationStr}` : 'di area operasional tambang';
        const timeInfoSpoken = timeEstimateStr ? `, diperkirakan terjadi pada ${timeEstimateStr}` : '';

        if (tier === 5 || tier === 100) {
            // Hujan Ekstrem (>= 150 mm/hari atau >= 100 mm/jam): 3 KALI TING TING TING
            playTingChime(3);
            setTimeout(() => {
                const speechMsg = `Peringatan bahaya darurat! Terdeteksi curah hujan ekstrem ${Math.round(dailyVal || rateVal)} milimeter ${cleanLoc}${timeInfoSpoken}. Seluruh aktivitas di lereng pit terbuka wajib segera dihentikan. Segera lakukan evakuasi personel ke shelter aman!`;
                speakGoogleVoice(speechMsg);
            }, 1450);
        } else if (tier === 4 || tier === 80) {
            // Hujan Sangat Lebat (100 - 150 mm/hari atau >= 80 mm/jam): 2 KALI TING TING
            playTingChime(2);
            setTimeout(() => {
                const speechMsg = `Peringatan siaga! Terdeteksi hujan sangat lebat ${Math.round(dailyVal || rateVal)} milimeter ${cleanLoc}${timeInfoSpoken}. Seluruh pengawas dan operator wajib waspada terhadap potensi ketidakstabilan lereng pit dan genangan air dewatering.`;
                speakGoogleVoice(speechMsg);
            }, 1100);
        } else if (tier === 3 || tier === 50) {
            // Hujan Lebat (50 - 100 mm/hari atau >= 50 mm/jam): 1 KALI TING
            playTingChime(1);
            setTimeout(() => {
                const speechMsg = `Perhatian! Peringatan dini hujan lebat ${Math.round(dailyVal || rateVal)} milimeter ${cleanLoc}${timeInfoSpoken}. Seluruh operator unit diimbau waspada jalan hauling sangat licin, kurangi batas kecepatan maksimal 30 kilometer per jam dan jaga jarak aman.`;
                speakGoogleVoice(speechMsg);
            }, 750);
        } else if (tier === 2) {
            // Hujan Sedang (20 - 50 mm/hari): 1 KALI TING LEMBUT
            playTingChime(1);
            setTimeout(() => {
                const speechMsg = `Informasi cuaca. Terpantau hujan sedang ${Math.round(dailyVal || rateVal)} milimeter ${cleanLoc}${timeInfoSpoken}. Jalan hauling mulai licin, kurangi kecepatan dan jaga jarak aman.`;
                speakGoogleVoice(speechMsg);
            }, 750);
        } else {
            // Hujan Ringan (0 - 20 mm/hari)
            showVoiceNotificationToast(`Kondisi Hujan Ringan (0 - 20 mm/hari): Normal & Aman tanpa alarm suara.`);
        }
    }

    function testRainAlert(dailyVal, rateVal = 0, sampleTimeStr = '') {
        getAudioContext();
        const classification = classifyRainfall(dailyVal, rateVal);
        const sampleLoc = 'Pit T2, T4, dan IPD S13';
        const sampleTime = sampleTimeStr || (classification.tier >= 4 ? 'Pukul 15:00 - 18:00 WITA' : 'Pukul 13:00 - 15:00 WITA');

        showVoiceNotificationToast(`[UJI COBA SUARA] ${classification.name} (${classification.rangeLabel}) • Perkiraan: ${sampleTime}`);

        // Flash temporary banner preview for 12 seconds
        const banner = document.getElementById('warningBanner');
        const icon = document.getElementById('warningIcon');
        const title = document.getElementById('warningTitle');
        const desc = document.getElementById('warningDesc');
        const kpiStatusBadge = document.getElementById('kpiStatusBadge');
        const kpiStatusText = document.getElementById('kpiStatusText');
        const timeBadge = document.getElementById('warningTimeWindowBadge');
        const timeText = document.getElementById('warningTimeWindowText');

        if (timeBadge && timeText) {
            timeBadge.style.display = 'inline-flex';
            timeText.innerText = sampleTime;
        }

        if (banner) {
            banner.className = `warning-banner ${classification.severity === 'kritis' ? 'kritis' : classification.severity === 'red' ? 'siaga' : classification.severity === 'orange' ? 'siaga' : classification.severity === 'yellow' ? 'waspada' : 'normal'}`;
            if (icon) {
                icon.className = classification.tier === 5 
                    ? 'bi bi-exclamation-triangle-fill text-white' 
                    : classification.tier >= 3 
                        ? 'bi bi-bell-fill text-danger' 
                        : 'bi bi-shield-check text-success';
            }
            if (title) title.innerText = `[SIMULASI UJI] ${classification.name.toUpperCase()} (${classification.rangeLabel})`;
            if (desc) desc.innerText = `${classification.desc} Terdeteksi simulasi ${dailyVal} mm/hari ${rateVal > 0 ? '(' + rateVal + ' mm/jam)' : ''} di ${sampleLoc}. Perkiraan terjadinya: ${sampleTime}.`;
            if (kpiStatusBadge) {
                kpiStatusBadge.className = `badge ${classification.kpiClass}`;
                kpiStatusBadge.innerText = `TEST ${classification.kpiBadge}`;
            }
            if (kpiStatusText) {
                kpiStatusText.className = `kpi-num ${classification.tier >= 4 ? 'text-danger' : classification.tier === 3 ? 'text-warning' : 'text-success'}`;
                kpiStatusText.innerText = classification.kpiBadge;
            }
        }

        triggerRainAlert(classification.tier, sampleLoc, dailyVal, rateVal, true, sampleTime);

        // Close test dropdown menu
        const menu = document.getElementById('testSoundMenuDropdown');
        if (menu) menu.style.display = 'none';
    }

    function toggleTestSoundMenu(e) {
        if (e) e.stopPropagation();
        const menu = document.getElementById('testSoundMenuDropdown');
        if (!menu) return;
        menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
    }

    document.addEventListener('click', (e) => {
        const wrap = document.querySelector('.test-sound-menu-wrap');
        const menu = document.getElementById('testSoundMenuDropdown');
        if (wrap && menu && !wrap.contains(e.target)) {
            menu.style.display = 'none';
        }
    });

    function getGoogleIndonesianVoice() {
        if (!speechVoices || speechVoices.length === 0) {
            if ('speechSynthesis' in window) speechVoices = window.speechSynthesis.getVoices();
        }
        // 1. Prioritize Google Indonesian voice
        let voice = speechVoices.find(v => (v.name.includes('Google') || v.name.includes('google')) && (v.lang === 'id-ID' || v.lang.startsWith('id')));
        // 2. Any Indonesian voice (Microsoft Gadis, Apple Damayanti, etc.)
        if (!voice) voice = speechVoices.find(v => v.lang === 'id-ID' || v.lang.startsWith('id'));
        // 3. Any Google voice
        if (!voice) voice = speechVoices.find(v => v.name.includes('Google') || v.name.includes('google'));
        return voice;
    }

    function speakGoogleVoice(text) {
        if (isSoundMuted) return;

        showVoiceNotificationToast(text);

        // Web Speech API
        if ('speechSynthesis' in window) {
            try {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'id-ID';
                utterance.rate = 0.95;
                utterance.pitch = 1.0;

                const voice = getGoogleIndonesianVoice();
                if (voice) {
                    utterance.voice = voice;
                }

                utterance.onerror = () => {
                    playGoogleTranslateFallback(text);
                };

                window.speechSynthesis.speak(utterance);
                return;
            } catch (err) {
                console.warn('SpeechSynthesis failed, trying fallback:', err);
            }
        }

        playGoogleTranslateFallback(text);
    }

    function playGoogleTranslateFallback(text) {
        if (isSoundMuted) return;
        try {
            const safeText = text.substring(0, 180);
            const ttsUrl = `https://translate.google.com/translate_tts?ie=UTF-8&tl=id&client=tw-ob&q=${encodeURIComponent(safeText)}`;
            const audio = new Audio(ttsUrl);
            audio.play().catch(e => console.warn('TTS playback prevented:', e));
        } catch(e) {}
    }

    function showVoiceNotificationToast(text) {
        let toastEl = document.getElementById('voiceToastIndicator');
        if (!toastEl) {
            toastEl = document.createElement('div');
            toastEl.id = 'voiceToastIndicator';
            toastEl.style.position = 'fixed';
            toastEl.style.bottom = '46px';
            toastEl.style.right = '20px';
            toastEl.style.background = 'rgba(15, 23, 42, 0.94)';
            toastEl.style.border = '1px solid #38bdf8';
            toastEl.style.boxShadow = '0 8px 32px rgba(0, 210, 255, 0.35)';
            toastEl.style.borderRadius = '10px';
            toastEl.style.padding = '8px 14px';
            toastEl.style.display = 'flex';
            toastEl.style.alignItems = 'center';
            toastEl.style.gap = '10px';
            toastEl.style.zIndex = '99999';
            toastEl.style.fontSize = '11px';
            toastEl.style.color = '#fff';
            toastEl.style.transition = 'all 0.3s ease';
            document.body.appendChild(toastEl);
        }

        toastEl.innerHTML = `
            <span class="spinner-grow spinner-grow-sm text-info" role="status"></span>
            <div>
                <strong style="color:#38bdf8; display:block; font-size:10px; text-transform:uppercase; letter-spacing:0.5px;">Notifikasi Suara Early Warning</strong>
                <span style="color:#e2e8f0;">${text.length > 80 ? text.substring(0, 77) + '...' : text}</span>
            </div>
        `;
        toastEl.style.opacity = '1';
        toastEl.style.transform = 'translateY(0)';

        clearTimeout(toastEl._timer);
        toastEl._timer = setTimeout(() => {
            toastEl.style.opacity = '0';
            toastEl.style.transform = 'translateY(10px)';
        }, 7000);
    }

    function testSoundAlert() {
        playRadarChime();
        setTimeout(() => {
            const testMsg = "Perhatian. Uji coba sistem suara peringatan dini cuaca IMORA. Terdeteksi potensi hujan di area operasional tambang. Seluruh personel diinstruksikan berhati-hati terhadap jalan hauling licin dan kurangi kecepatan unit.";
            speakGoogleVoice(testMsg);
        }, 450);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       4. LEAFLET MAP & WEATHER DATA INTEGRATION (NO API KEY REQUIRED)
       ────────────────────────────────────────────────────────────────────────── */
    let map = null;
    let markersLayer = null;
    let darkTileLayer = null;
    let satTileLayer = null;
    let weatherResults = [];
    let hourlyChartInstance = null;
    let activeFilter = 'all';

    function initMap() {
        // Center around Indexim Coalindo mining leasehold (Sangkulirang / Kaliorang, East Kutai)
        map = L.map('weatherMap', {
            zoomControl: false,
            attributionControl: false
        }).setView([1.045, 117.658], 13);

        L.control.zoom({ position: 'topright' }).addTo(map);

        // Esri World Dark Gray Base & Reference - Clean dark radar basemap with NO API KEY REQUIRED / NO WATERMARKS
        const darkBase = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            maxNativeZoom: 16
        });
        const darkRef = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            maxNativeZoom: 16
        });
        darkTileLayer = L.layerGroup([darkBase, darkRef]);

        // Esri World Imagery (Satellite) - DEFAULT ACTIVE LAYER
        satTileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            maxNativeZoom: 18
        }).addTo(map);

        markersLayer = L.layerGroup().addTo(map);

        // Pause auto-popup rotation on user map interactions
        map.on('dragstart', () => { pausePopupCycle(20000); });
        map.on('zoomstart', () => { pausePopupCycle(20000); });
    }

    function setMapLayer(layerType) {
        document.getElementById('btnLayerDark').classList.toggle('active', layerType === 'dark');
        document.getElementById('btnLayerSat').classList.toggle('active', layerType === 'satellite');

        if (layerType === 'dark') {
            if (map.hasLayer(satTileLayer)) map.removeLayer(satTileLayer);
            if (!map.hasLayer(darkTileLayer)) map.addLayer(darkTileLayer);
        } else {
            if (map.hasLayer(darkTileLayer)) map.removeLayer(darkTileLayer);
            if (!map.hasLayer(satTileLayer)) map.addLayer(satTileLayer);
        }
    }

    let markerItems = [];
    let currentPopupIndex = -1;
    let popupCycleTimer = null;
    let isPopupCyclePaused = false;
    let popupPauseResumeTimeout = null;

    function startPopupCycle() {
        if (popupCycleTimer) clearInterval(popupCycleTimer);
        if (!markerItems || markerItems.length === 0) return;

        // Auto rotate popup on map every 7.5 seconds
        popupCycleTimer = setInterval(() => {
            if (isPopupCyclePaused) return;
            if (!markerItems || markerItems.length === 0) return;

            currentPopupIndex = (currentPopupIndex + 1) % markerItems.length;
            showPointPopup(currentPopupIndex, false);
        }, 7500);
    }

    function pausePopupCycle(durationMs = 15000) {
        isPopupCyclePaused = true;
        clearTimeout(popupPauseResumeTimeout);
        popupPauseResumeTimeout = setTimeout(() => {
            isPopupCyclePaused = false;
        }, durationMs);
    }

    function showPointPopup(index, isManual = false) {
        if (!markerItems || !markerItems[index]) return;
        currentPopupIndex = index;
        const mi = markerItems[index];
        const p = mi.point;

        const currentZoom = map.getZoom();
        const targetZoom = Math.max(currentZoom, 14);
        map.panTo([p.latitude, p.longitude], { animate: true, duration: 0.9 });

        mi.marker.openPopup();
        document.getElementById('selectedPointName').innerText = p.name;
        updateHourlyChart(mi.item);

        // Highlight active marker pin on map
        document.querySelectorAll('.marker-pin-wrap').forEach(w => w.classList.remove('active-pin-focus'));
        const mEl = mi.marker.getElement();
        if (mEl) {
            const wrap = mEl.querySelector('.marker-pin-wrap');
            if (wrap) wrap.classList.add('active-pin-focus');
        }

        // Highlight active card in the list
        document.querySelectorAll('.point-card').forEach(c => c.classList.remove('active-card-highlight'));
        if (mi.card) {
            mi.card.classList.add('active-card-highlight');
            if (!isUserInteractingWithPoints && document.getElementById('tabContentPoints').style.display !== 'none') {
                mi.card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        if (isManual) {
            pausePopupCycle(20000);
            isUserInteractingWithPoints = true;
            clearTimeout(autoScrollPauseTimeout);
            autoScrollPauseTimeout = setTimeout(() => { isUserInteractingWithPoints = false; }, 8000);
        }
    }

    function resetMapView() {
        if (weatherResults && weatherResults.length > 0) {
            const bounds = L.latLngBounds(weatherResults.map(r => [r.point.latitude, r.point.longitude]));
            map.fitBounds(bounds, { padding: [40, 40] });
        } else {
            map.setView([1.045, 117.658], 13);
        }
    }

    // WMO Weather code helper
    function interpretWmoCode(code) {
        if (code === 0) return { desc: 'Cerah', icon: 'bi-sun-fill', color: '#fbbf24' };
        if (code === 1 || code === 2) return { desc: 'Cerah Berawan', icon: 'bi-cloud-sun-fill', color: '#38bdf8' };
        if (code === 3) return { desc: 'Berawan Tebal', icon: 'bi-clouds-fill', color: '#bae6fd' };
        if (code >= 51 && code <= 55) return { desc: 'Gerimis Ringan', icon: 'bi-cloud-drizzle-fill', color: '#00d2ff' };
        if (code >= 61 && code <= 65) return { desc: 'Hujan', icon: 'bi-cloud-rain-fill', color: '#38bdf8' };
        if (code >= 80 && code <= 82) return { desc: 'Hujan Lebat (Showers)', icon: 'bi-cloud-rain-heavy-fill', color: '#f87171' };
        if (code >= 95 && code <= 99) return { desc: 'Badai Petir', icon: 'bi-cloud-lightning-rain-fill', color: '#facc15' };
        return { desc: 'Cerah Berawan', icon: 'bi-cloud-sun-fill', color: '#38bdf8' };
    }

    async function fetchForecastData() {
        try {
            // First attempt to call the local cached backend endpoint
            let response = await fetch('/EarlyWarning/GetForecast');
            if (!response.ok) {
                // Direct fallback to IMORA API
                response = await fetch('https://imora.indexim.id/api/v1/forecast');
            }
            if (!response.ok) throw new Error('Forecast unavailable');

            const payload = await response.json();
            weatherResults = payload.results || [];

            renderWeatherDashboard(weatherResults);
        } catch (err) {
            console.warn('Error fetching forecast, retrying in 10s:', err);
            setTimeout(fetchForecastData, 10000);
        }
    }

    // Helper: Determine Current Hour Index in WITA (UTC+8)
    function getCurrentHourIndex(timeArray) {
        if (!timeArray || timeArray.length === 0) return 0;
        const now = new Date();
        const utcMs = now.getTime() + (now.getTimezoneOffset() * 60000);
        const witaDate = new Date(utcMs + (8 * 3600000));
        const y = witaDate.getFullYear();
        const m = String(witaDate.getMonth() + 1).padStart(2, '0');
        const d = String(witaDate.getDate()).padStart(2, '0');
        const h = String(witaDate.getHours()).padStart(2, '0');
        const targetPrefix = `${y}-${m}-${d}T${h}:00`;
        const idx = timeArray.findIndex(t => t.startsWith(targetPrefix));
        if (idx !== -1) return idx;

        // Fallback closest match
        const witaTargetMs = new Date(`${y}-${m}-${d}T${h}:00:00+08:00`).getTime();
        let closestIdx = 0;
        let minDiff = Infinity;
        for (let i = 0; i < timeArray.length; i++) {
            const tDate = new Date(timeArray[i] + ':00+08:00');
            const diff = Math.abs(tDate.getTime() - witaTargetMs);
            if (diff < minDiff) {
                minDiff = diff;
                closestIdx = i;
            }
        }
        return closestIdx;
    }

    function renderWeatherDashboard(results) {
        if (!results || results.length === 0) return;

        markersLayer.clearLayers();
        markerItems = [];

        // 1. Determine Current Hour Index (WITA UTC+8) & Today's Remaining Forecast Window
        const fc0 = results[0].forecast.hourly;
        const currentHourIdx = getCurrentHourIndex(fc0.time);

        const now = new Date();
        const utcMs = now.getTime() + (now.getTimezoneOffset() * 60000);
        const witaDate = new Date(utcMs + (8 * 3600000));
        const todayStr = `${witaDate.getFullYear()}-${String(witaDate.getMonth() + 1).padStart(2, '0')}-${String(witaDate.getDate()).padStart(2, '0')}`;

        // Today's remaining hours (from current hour until 23:00)
        let todayRemainingIndices = [];
        for (let i = currentHourIdx; i < fc0.time.length; i++) {
            if (fc0.time[i].startsWith(todayStr)) {
                todayRemainingIndices.push(i);
            }
        }
        // If late night (< 6 hours remaining), include overnight hours up to +12h for night shift
        if (todayRemainingIndices.length < 6) {
            for (let i = currentHourIdx; i < Math.min(fc0.time.length, currentHourIdx + 12); i++) {
                if (!todayRemainingIndices.includes(i)) todayRemainingIndices.push(i);
            }
        }

        // 2. Scan Site-Wide Hourly Trends for Today's Forecast Peak
        const hourlySiteSummary = todayRemainingIndices.map(idx => {
            const timeStr = fc0.time[idx].split('T')[1];
            const maxProbAtHour = Math.max(...results.map(r => r.forecast.hourly.precipitation_probability ? r.forecast.hourly.precipitation_probability[idx] : 0));
            const maxRainAtHour = Math.max(...results.map(r => r.forecast.hourly.precipitation ? r.forecast.hourly.precipitation[idx] : 0));
            const maxGustAtHour = Math.max(...results.map(r => r.forecast.hourly.wind_gusts_10m ? r.forecast.hourly.wind_gusts_10m[idx] : 0));
            return { time: timeStr, prob: maxProbAtHour, rain: maxRainAtHour, gust: maxGustAtHour, index: idx };
        });

        const rainForecastHours = hourlySiteSummary.filter(h => h.prob >= 50 || h.rain > 0);
        let rainTimeWindowStr = '';
        if (rainForecastHours.length > 0) {
            const startHour = rainForecastHours[0].time;
            const endHour = rainForecastHours[rainForecastHours.length - 1].time;
            rainTimeWindowStr = (startHour === endHour) ? `Pukul ${startHour} WITA` : `Pukul ${startHour} - ${endHour} WITA`;
        }

        let maxRainNow = 0;
        let maxRainNowLocation = 'Seluruh Pit Kering';
        let maxGustNow = 0;
        let maxGustNowLocation = '-';
        let tempSum = 0;

        let siteMaxProb = 0;
        let siteMaxProbLocation = '-';
        let siteMaxRainRate = 0;
        let siteMaxRainRateLocation = '-';
        let siteMaxTotalRain = 0;
        let siteMaxGust = 0;
        let siteMaxGustLocation = '-';

        let warningPointsCount = 0;
        let activeNowRainPoints = [];
        let activeNowThunderPoints = [];
        let activeAlertPoints = [];

        const bounds = [];
        const cardListEl = document.getElementById('pointsCardList');
        cardListEl.innerHTML = '';

        let tickerItems = [];

        results.forEach((item, index) => {
            const p = item.point;
            const fc = item.forecast.hourly;

            // Actual telemetry for Current Hour (Now)
            const curTemp = fc.temperature_2m ? fc.temperature_2m[currentHourIdx] : 25;
            const curPrecip = fc.precipitation ? fc.precipitation[currentHourIdx] : 0;
            const curProb = fc.precipitation_probability ? fc.precipitation_probability[currentHourIdx] : 0;
            const curWind = fc.wind_speed_10m ? fc.wind_speed_10m[currentHourIdx] : 0;
            const curGust = fc.wind_gusts_10m ? fc.wind_gusts_10m[currentHourIdx] : 0;
            const curCode = fc.weather_code ? fc.weather_code[currentHourIdx] : 0;

            tempSum += curTemp;

            // Track Real-Time Stats (Now)
            if (curPrecip > maxRainNow) {
                maxRainNow = curPrecip;
                maxRainNowLocation = p.name;
            }
            if (curGust > maxGustNow) {
                maxGustNow = curGust;
                maxGustNowLocation = p.name;
            }

            // Forecast Stats for This Point (Today)
            const ptTodayPrecip = todayRemainingIndices.map(i => fc.precipitation ? fc.precipitation[i] : 0);
            const ptTodayProb = todayRemainingIndices.map(i => fc.precipitation_probability ? fc.precipitation_probability[i] : 0);
            const ptTodayGust = todayRemainingIndices.map(i => fc.wind_gusts_10m ? fc.wind_gusts_10m[i] : 0);
            const ptTodayCode = todayRemainingIndices.map(i => fc.weather_code ? fc.weather_code[i] : 0);

            const ptMaxPrecip = Math.max(...ptTodayPrecip, 0);
            const ptTotalRain = ptTodayPrecip.reduce((a, b) => a + b, 0);
            const ptMaxProb = Math.max(...ptTodayProb, 0);
            const ptMaxGust = Math.max(...ptTodayGust, 0);
            const ptMaxCode = Math.max(...ptTodayCode, 0);

            if (ptMaxProb > siteMaxProb) {
                siteMaxProb = ptMaxProb;
                siteMaxProbLocation = p.name;
            }
            if (ptMaxPrecip > siteMaxRainRate) {
                siteMaxRainRate = ptMaxPrecip;
                siteMaxRainRateLocation = p.name;
            }
            if (ptTotalRain > siteMaxTotalRain) {
                siteMaxTotalRain = ptTotalRain;
            }
            if (ptMaxGust > siteMaxGust) {
                siteMaxGust = ptMaxGust;
                siteMaxGustLocation = p.name;
            }

            if (curPrecip > 0) {
                activeNowRainPoints.push({ name: p.name, precip: curPrecip, gust: curGust });
            }
            if (curCode >= 95 || ptMaxCode >= 95) {
                activeNowThunderPoints.push({ name: p.name, code: curCode });
            }

            // Determine Severity Level according to user rules:
            // 1. Hujan Ringan (0 - 20 mm/hari)
            // 2. Hujan Sedang (20 - 50 mm/hari)
            // 3. Hujan Lebat (50 - 100 mm/hari atau >= 50 mm/jam) -> Tier 3
            // 4. Hujan Sangat Lebat (100 - 150 mm/hari atau >= 80 mm/jam) -> Tier 4
            // 5. Hujan Ekstrem (>= 150 mm/hari atau >= 100 mm/jam) -> Tier 5
            const ptCls = classifyRainfall(ptTotalRain, curPrecip);
            let severity = (ptCls.severity === 'kritis') ? 'red' : ptCls.severity;
            let statusText = ptCls.statusText;

            // Extra checks for severe wind gusts and thunder
            if (curCode >= 95 || ptMaxCode >= 95) {
                if (severity === 'green' || severity === 'yellow') {
                    severity = 'red';
                    statusText = 'Petir / Badai';
                }
            } else if (curGust >= 45 && severity === 'green') {
                severity = 'orange';
                statusText = 'Angin Kencang';
            }

            if (ptCls.tier >= 3 || curCode >= 95 || curPrecip > 0) {
                warningPointsCount++;
                activeAlertPoints.push({
                    name: p.name,
                    precip: curPrecip,
                    gust: curGust,
                    code: curCode,
                    ptTotalRain,
                    ptMaxProb,
                    ptMaxPrecip,
                    status: statusText,
                    tier: ptCls.tier
                });
            }

            bounds.push([p.latitude, p.longitude]);

            const wmoInfo = interpretWmoCode(curCode);

            // Dynamic Weather Badges & Ripples on Map Point
            let weatherBadgeHtml = '';
            let rippleEffectHtml = '';

            const isThunder = (curCode >= 95 || curCode === 96 || curCode === 99 || ptMaxCode >= 95);
            const isRainingNow = (curPrecip > 0 || (curCode >= 51 && curCode <= 65) || (curCode >= 80 && curCode <= 82));
            const isHeavyRainNow = (ptCls.tier >= 3 || curPrecip >= 2 || (curCode >= 63 && curCode <= 65) || (curCode >= 81 && curCode <= 82));
            const isHighWindNow = (curGust >= 30 && !isRainingNow && !isThunder);
            const isHighProbToday = (ptMaxProb >= 60 && !isRainingNow && !isThunder);

            if (isThunder) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-thunder" title="Peringatan Petir / Thunderstorm">
                        <i class="bi bi-lightning-charge-fill lightning-flash text-warning"></i>
                        <span>PETIR</span>
                    </div>
                `;
                rippleEffectHtml = `<div class="thunder-ripple"></div>`;
            } else if (ptCls.tier === 5 || curPrecip >= 100) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-heavy-rain" style="background:rgba(220,38,38,0.95); border-color:#ef4444;" title="Hujan Ekstrem: ${ptTotalRain.toFixed(1)} mm/hari (${curPrecip} mm/h)">
                        <i class="bi bi-exclamation-triangle-fill text-white"></i>
                        <span>EKSTREM ${curPrecip > 0 ? curPrecip + ' mm/h' : ptTotalRain.toFixed(0) + ' mm'}</span>
                    </div>
                `;
                rippleEffectHtml = `<div class="thunder-ripple" style="border-color:#ef4444;"></div>`;
            } else if (ptCls.tier === 4 || curPrecip >= 80) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-heavy-rain" style="background:rgba(185,28,28,0.92); border-color:#ef4444;" title="Hujan Sangat Lebat: ${ptTotalRain.toFixed(1)} mm/hari (${curPrecip} mm/h)">
                        <i class="bi bi-bell-fill text-white"></i>
                        <span>S. LEBAT ${curPrecip > 0 ? curPrecip + ' mm/h' : ptTotalRain.toFixed(0) + ' mm'}</span>
                    </div>
                `;
                rippleEffectHtml = `<div class="rain-ripple"></div>`;
            } else if (ptCls.tier === 3 || curPrecip >= 50) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-heavy-rain" style="background:rgba(194,65,12,0.92); border-color:#fb923c;" title="Hujan Lebat: ${ptTotalRain.toFixed(1)} mm/hari (${curPrecip} mm/h)">
                        <i class="bi bi-cloud-rain-heavy-fill rain-bounce"></i>
                        <span>LEBAT ${curPrecip > 0 ? curPrecip + ' mm/h' : ptTotalRain.toFixed(0) + ' mm'}</span>
                    </div>
                `;
                rippleEffectHtml = `<div class="rain-ripple"></div>`;
            } else if (ptCls.tier === 2 || curPrecip >= 5) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-rain" style="background:rgba(180,83,9,0.9); border-color:#fbbf24;" title="Hujan Sedang: ${ptTotalRain.toFixed(1)} mm/hari (${curPrecip} mm/h)">
                        <i class="bi bi-cloud-rain-fill rain-bounce"></i>
                        <span>SEDANG ${curPrecip > 0 ? curPrecip + ' mm/h' : ptTotalRain.toFixed(0) + ' mm'}</span>
                    </div>
                `;
                rippleEffectHtml = `<div class="rain-ripple"></div>`;
            } else if (isRainingNow) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-rain" title="Hujan Ringan: ${curPrecip} mm/h (${ptTotalRain.toFixed(1)} mm/hari)">
                        <i class="bi bi-cloud-drizzle-fill"></i>
                        <span>${curPrecip > 0 ? curPrecip + ' mm' : 'Gerimis'}</span>
                    </div>
                `;
                rippleEffectHtml = `<div class="rain-ripple"></div>`;
            } else if (isHighWindNow) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-wind" title="Hembusan Angin: ${curGust} km/h">
                        <i class="bi bi-wind wind-spin"></i>
                        <span>${curGust} km/h</span>
                    </div>
                `;
            } else if (isHighProbToday) {
                weatherBadgeHtml = `
                    <div class="marker-weather-badge badge-prob" title="Peluang Hujan Hari Ini: ${ptMaxProb}%">
                        <i class="bi bi-cloud-sun-fill"></i>
                        <span>${ptMaxProb}% Prob</span>
                    </div>
                `;
            }

            const shortPitName = p.name.replace(/\s*-\s*(KPP|UDU|MGE)\b/gi, '').trim();

            const markerSeverityClass = (severity === 'green') ? 'cyan' : severity;
            let beaconIcon = '<i class="bi bi-geo-alt-fill text-white"></i>';
            if (isThunder) {
                beaconIcon = '<i class="bi bi-lightning-charge-fill text-warning"></i>';
            } else if (isHeavyRainNow || isRainingNow) {
                beaconIcon = '<i class="bi bi-cloud-rain-fill text-white"></i>';
            } else if (isHighWindNow) {
                beaconIcon = '<i class="bi bi-wind text-warning"></i>';
            }

            const pinHtml = `
                <div class="marker-pin-wrap" title="${p.name} • ${wmoInfo.desc} • Saat Ini: ${curPrecip} mm/h (Maks Hari Ini: ${ptMaxPrecip} mm/h)">
                    ${rippleEffectHtml}
                    ${weatherBadgeHtml}
                    <div class="marker-radar-core">
                        <div class="pulse-wave ${markerSeverityClass}"></div>
                        <div class="core-beacon ${markerSeverityClass}">
                            ${beaconIcon}
                        </div>
                    </div>
                    <div class="marker-pit-label ${markerSeverityClass}">${shortPitName}</div>
                </div>
            `;

            const customIcon = L.divIcon({
                html: pinHtml,
                className: 'custom-map-div-icon',
                iconSize: [80, 64],
                iconAnchor: [40, 32]
            });

            const marker = L.marker([p.latitude, p.longitude], { icon: customIcon });

            // Marker Popup Content
            const currentHourLabel = fc0.time[currentHourIdx] ? fc0.time[currentHourIdx].split('T')[1] : '--:--';
            const popupHtml = `
                <div style="font-family:'Poppins',sans-serif; min-width:215px; padding:4px;">
                    <div style="font-size:12px; font-weight:800; color:#0f172a; margin-bottom:4px; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">
                        <i class="bi bi-geo-alt-fill text-primary"></i> ${p.name}
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Kondisi Saat Ini (${currentHourLabel}):</span>
                        <strong style="color:#0f172a;"><i class="bi ${wmoInfo.icon}" style="color:${wmoInfo.color};"></i> ${wmoInfo.desc}</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Curah Hujan (Now):</span>
                        <strong style="color:${curPrecip > 0 ? '#ef4444' : '#10b981'}; font-weight:800;">${curPrecip > 0 ? curPrecip + ' mm/h' : '0.0 mm/h (Kering)'}</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Peluang Hujan (Hari Ini):</span>
                        <strong style="color:#7c3aed;">${ptMaxProb}% (Puncak ${ptMaxPrecip > 0 ? ptMaxPrecip + ' mm/h' : 'Nihil'})</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Akumulasi Hujan Hari Ini:</span>
                        <strong style="color:#0284c7;">${ptTotalRain.toFixed(1)} mm</strong>
                    </div>
                    <div style="font-size:11px; color:#475569; display:flex; justify-content:space-between; margin-bottom:2px;">
                        <span>Suhu / Gust:</span>
                        <strong style="color:#d97706;">${curTemp}&deg;C / ${curGust} km/h</strong>
                    </div>
                </div>
            `;
            marker.bindPopup(popupHtml);
            marker.on('click', () => {
                showPointPopup(index, true);
            });
            markersLayer.addLayer(marker);

            // Right Panel Point Card
            let cardClass = 'point-card';
            if (severity === 'red') cardClass += ' alert-item';
            else if (severity === 'yellow' || severity === 'orange') cardClass += ' warning-item';

            const card = document.createElement('div');
            card.className = cardClass;
            card.setAttribute('data-point-type', (curPrecip > 0 || ptMaxProb >= 50 || severity !== 'green') ? 'warning' : 'dry');
            card.onclick = () => {
                showPointPopup(index, true);
            };

            markerItems.push({
                marker: marker,
                point: p,
                item: item,
                card: card,
                index: index
            });

            // Contractor Badge
            let contractorBadge = '';
            if (p.name.includes('KPP')) {
                contractorBadge = '<span class="badge" style="background:rgba(56,189,248,0.22); color:#38bdf8; border:1px solid rgba(56,189,248,0.5); font-size:8.5px; font-weight:800;">KPP</span>';
            } else if (p.name.includes('UDU')) {
                contractorBadge = '<span class="badge" style="background:rgba(52,211,153,0.22); color:#34d399; border:1px solid rgba(52,211,153,0.5); font-size:8.5px; font-weight:800;">UDU</span>';
            } else if (p.name.includes('MGE')) {
                contractorBadge = '<span class="badge" style="background:rgba(251,191,36,0.22); color:#fbbf24; border:1px solid rgba(251,191,36,0.5); font-size:8.5px; font-weight:800;">MGE</span>';
            }

            // Hauling Road Condition
            let roadBadge = '';
            if (curPrecip >= 2) {
                roadBadge = '<span class="hauling-badge hauling-danger"><i class="bi bi-exclamation-triangle-fill"></i> Sangat Licin / Standby</span>';
            } else if (curPrecip > 0) {
                roadBadge = '<span class="hauling-badge hauling-caution"><i class="bi bi-speedometer2"></i> Basah • Maks 30 km/h</span>';
            } else if (ptMaxProb >= 50 || ptTotalRain >= 1.0) {
                roadBadge = '<span class="hauling-badge hauling-caution" style="border-color:rgba(251,191,36,0.4);"><i class="bi bi-cloud-rain"></i> Waspada Siang/Sore</span>';
            } else {
                roadBadge = '<span class="hauling-badge hauling-normal"><i class="bi bi-check-circle-fill"></i> Kering • Normal</span>';
            }

            // High Contrast Badge Class & Glowing Status Corner Dot
            let badgeThemeClass = 'badge-cyan';
            let statusDotColor = '#00d2ff';
            if (severity === 'red') {
                badgeThemeClass = 'badge-red';
                statusDotColor = '#ef4444';
            } else if (severity === 'orange') {
                badgeThemeClass = 'badge-orange';
                statusDotColor = '#fb923c';
            } else if (severity === 'yellow') {
                badgeThemeClass = 'badge-yellow';
                statusDotColor = '#fbbf24';
            }

            const displayPrecipText = curPrecip > 0 
                ? `${curPrecip} mm/h` 
                : (ptMaxPrecip > 0 ? `Kering • Maks ${ptMaxPrecip}mm` : 'Kering');

            card.innerHTML = `
                <div class="point-badge ${badgeThemeClass}" title="${wmoInfo.desc}">
                    <span class="badge-status-dot" style="background:${statusDotColor}; box-shadow:0 0 8px ${statusDotColor};"></span>
                    <i class="bi ${wmoInfo.icon} badge-weather-icon" style="color: ${wmoInfo.color};"></i>
                </div>
                <div style="flex:1; min-width:0;">
                    <div class="d-flex align-items-center gap-1 mb-1">
                        <span class="point-name text-truncate" style="max-width:140px;">${p.name}</span>
                        ${contractorBadge}
                        <span class="badge ${severity === 'red' ? 'bg-danger' : severity === 'orange' ? 'bg-warning text-dark' : severity === 'yellow' ? 'bg-warning text-dark' : 'bg-info text-dark'}" style="font-size:8.5px; padding:2px 5px; font-weight:800;">${statusText}</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        ${roadBadge}
                        <span style="font-size:9.5px; color:#cbd5e1; font-weight:600;"><i class="bi bi-wind text-warning"></i> ${curGust} km/h</span>
                    </div>
                    <!-- Rain Probability Mini Bar (Today Max) -->
                    <div style="display:flex; align-items:center; gap:6px;">
                        <div style="flex:1; height:4px; background:rgba(255,255,255,0.12); border-radius:3px; overflow:hidden;">
                            <div style="width:${ptMaxProb}%; height:100%; background:${ptMaxProb >= 60 ? '#a855f7' : ptMaxProb >= 30 ? '#38bdf8' : '#00d2ff'}; border-radius:3px;"></div>
                        </div>
                        <span style="font-size:9px; color:#94a3b8; font-weight:700;">${ptMaxProb}% Prob Hari Ini</span>
                    </div>
                </div>
                <div class="point-weather-col">
                    <div class="point-temp">${curTemp}&deg;C</div>
                    <div class="point-precip ${curPrecip > 0 ? 'wet' : 'dry'}" style="font-size:11.5px; font-weight:800;">${displayPrecipText}</div>
                    <span style="font-size:9.5px; color:${wmoInfo.color}; font-weight:700;">${wmoInfo.desc}</span>
                </div>
            `;
            cardListEl.appendChild(card);

            tickerItems.push(`${p.name}: ${curTemp}°C (${wmoInfo.desc}) • Now: ${curPrecip > 0 ? curPrecip + 'mm' : 'Kering'} • Prediksi Hari Ini: Peluang ${ptMaxProb}%, Maks ${ptMaxPrecip}mm, Gust ${ptMaxGust}km/h`);
        });

        // Fit map bounds initially
        if (bounds.length > 0) {
            map.fitBounds(L.latLngBounds(bounds), { padding: [35, 35] });
        }

        // Update HUD KPI Cards (Reflecting Real-Time Telemetry & Today's Peak Forecast)
        const avgTemp = (tempSum / results.length).toFixed(1);
        document.getElementById('kpiPointsCount').innerText = results.length;

        // KPI 1: Curah Hujan Sekarang (Now) & Prediksi Puncak Hari Ini
        document.getElementById('kpiMaxRain').innerHTML = `${maxRainNow.toFixed(1)} <span style="font-size:12px;">mm/h</span>`;
        if (maxRainNow > 0) {
            document.getElementById('kpiMaxRainLoc').innerText = `${maxRainNowLocation} (Sedang Hujan)`;
            document.getElementById('kpiRainBadge').innerText = `${maxRainNow} mm/h`;
            document.getElementById('kpiRainBadge').className = 'badge bg-danger';
        } else {
            document.getElementById('kpiMaxRainLoc').innerText = siteMaxRainRate > 0 ? `Puncak Prediksi Hari Ini: ${siteMaxRainRate} mm/h` : 'Seluruh Pit Kering';
            document.getElementById('kpiRainBadge').innerText = 'NOW: 0.0 mm';
            document.getElementById('kpiRainBadge').className = 'badge bg-primary';
        }

        // KPI 2: Probabilitas Hujan Maksimum Hari Ini
        document.getElementById('kpiMaxProb').innerHTML = `${siteMaxProb} <span style="font-size:12px;">%</span>`;
        document.getElementById('kpiMaxProbLoc').innerText = rainTimeWindowStr ? `Puncak ${rainTimeWindowStr}` : `Maks Hari Ini: ${siteMaxProbLocation}`;

        // KPI 3: Gust Angin Maksimum Hari Ini
        document.getElementById('kpiMaxWind').innerHTML = `${siteMaxGust} <span style="font-size:12px;">km/h</span>`;
        document.getElementById('kpiMaxWindLoc').innerText = `Maks Hari Ini: ${siteMaxGustLocation}`;

        // KPI 4: Suhu Udara Rata-Rata Saat Ini
        document.getElementById('kpiAvgTemp').innerHTML = `${avgTemp} <span style="font-size:12px;">&deg;C</span>`;
        const currentCodeSite = results[0].forecast.hourly.weather_code ? results[0].forecast.hourly.weather_code[currentHourIdx] : 0;
        const wmoInfoSite = interpretWmoCode(currentCodeSite);
        const kpiWeatherDescEl = document.getElementById('kpiWeatherDesc');
        if (kpiWeatherDescEl) kpiWeatherDescEl.innerText = `Saat Ini: ${wmoInfoSite.desc}`;

        // Update Warning Notification Banner & Sound Trigger
        const banner = document.getElementById('warningBanner');
        const iconBox = document.getElementById('warningIconBox');
        const icon = document.getElementById('warningIcon');
        const title = document.getElementById('warningTitle');
        const desc = document.getElementById('warningDesc');
        const kpiStatusBadge = document.getElementById('kpiStatusBadge');
        const kpiStatusText = document.getElementById('kpiStatusText');

        document.getElementById('warningPointsBadge').innerText = `${warningPointsCount} Titik Terindikasi`;

        const alertLocations = (activeNowRainPoints.length > 0 ? activeNowRainPoints : activeAlertPoints)
            .map(a => a.name.replace(/\s*-\s*(KPP|UDU|MGE)\b/gi, '').trim());
        const uniqueLocations = [...new Set(alertLocations)];
        const locationsPreview = uniqueLocations.slice(0, 3).join(', ');
        const locationsSpoken = uniqueLocations.length > 0 
            ? `di beberapa lokasi, antara lain area ${locationsPreview}${uniqueLocations.length > 3 ? ', dan sekitarnya' : ''}` 
            : 'di beberapa lokasi pit operasional';
        const locationsBanner = uniqueLocations.length > 0 
            ? `di beberapa lokasi (${locationsPreview}${uniqueLocations.length > 3 ? ', dll' : ''})` 
            : 'di beberapa lokasi operasional';

        // Evaluasi Klasifikasi Site Sesuai Aturan:
        // 1. Hujan Ringan (0 - 20 mm/hari)
        // 2. Hujan Sedang (20 - 50 mm/hari)
        // 3. Hujan Lebat (50 - 100 mm/hari atau >= 50 mm/jam) -> SUARA 1
        // 4. Hujan Sangat Lebat (100 - 150 mm/hari atau >= 80 mm/jam) -> SUARA 2
        // 5. Hujan Ekstrem (>= 150 mm/hari atau >= 100 mm/jam) -> SUARA 3
        const siteCls = classifyRainfall(siteMaxTotalRain, maxRainNow);
        const hasThunderActive = (activeNowThunderPoints.length > 0);
        const hasSevereWind = (maxGustNow >= 45);

        const nowTime = Date.now();
        const lastAlert = getLastAudioAlertTime();
        const isAlertIntervalPassed = (nowTime - lastAlert >= RAIN_ALERT_REPEAT_INTERVAL_MS);
        const hasTierEscalated = (siteCls.tier > lastRainAlertTier && siteCls.hasAudioAlarm);

        // Format Perkiraan Waktu Terjadinya Hujan
        let formattedOccurrenceInfo = '';
        if (maxRainNow > 0) {
            formattedOccurrenceInfo = rainTimeWindowStr 
                ? `Sedang berlangsung saat ini (estimasi berlanjut hingga ${rainTimeWindowStr.replace('Pukul ', '')})` 
                : 'Sedang berlangsung saat ini';
        } else if (rainTimeWindowStr) {
            formattedOccurrenceInfo = rainTimeWindowStr;
        }

        const timeBadge = document.getElementById('warningTimeWindowBadge');
        const timeText = document.getElementById('warningTimeWindowText');
        if (timeBadge && timeText) {
            if (formattedOccurrenceInfo && siteCls.tier >= 2) {
                timeBadge.style.display = 'inline-flex';
                timeText.innerText = formattedOccurrenceInfo;
            } else if (siteMaxProb >= 50 && rainTimeWindowStr) {
                timeBadge.style.display = 'inline-flex';
                timeText.innerText = rainTimeWindowStr;
            } else {
                timeBadge.style.display = 'none';
            }
        }

        if (siteCls.tier === 5) {
            // Level 5: Hujan Ekstrem (>= 150 mm/hari atau >= 100 mm/jam) -> 3x TING
            banner.className = 'warning-banner kritis';
            icon.className = 'bi bi-exclamation-triangle-fill text-white';
            title.innerText = 'PERINGATAN DARURAT: STATUS AWAS HUJAN EKSTREM (\u2265 150 MM/HARI)!';
            desc.innerText = `Terdeteksi akumulasi curah hujan ekstrem (${siteMaxTotalRain.toFixed(1)} mm/hari, laju ${maxRainNow.toFixed(1)} mm/jam) ${locationsBanner}. Perkiraan terjadinya: ${formattedOccurrenceInfo || 'hari ini'}. Bahaya banjir bandang limpasan & longsor lereng! Segera hentikan operasi pit dan evakuasi personel ke shelter aman!`;
            
            kpiStatusBadge.className = 'badge bg-danger';
            kpiStatusBadge.innerText = 'EKSTREM';
            kpiStatusText.className = 'kpi-num text-danger';
            kpiStatusText.innerText = 'EKSTREM';

            if (hasTierEscalated || isAlertIntervalPassed) {
                lastRainAlertTier = 5;
                setLastAudioAlertTime(nowTime);
                lastAudioAlertTime = nowTime;
                triggerRainAlert(5, locationsSpoken, siteMaxTotalRain, maxRainNow, false, formattedOccurrenceInfo);
            }
        } else if (siteCls.tier === 4) {
            // Level 4: Hujan Sangat Lebat (100 - 150 mm/hari atau >= 80 mm/jam) -> 2x TING TING
            banner.className = 'warning-banner siaga';
            icon.className = 'bi bi-bell-fill text-danger';
            title.innerText = 'PERINGATAN DINI: STATUS AWAS HUJAN SANGAT LEBAT (100 - 150 MM/HARI)!';
            desc.innerText = `Terdeteksi curah hujan sangat lebat (${siteMaxTotalRain.toFixed(1)} mm/hari, laju ${maxRainNow.toFixed(1)} mm/jam) ${locationsBanner}. Perkiraan terjadinya: ${formattedOccurrenceInfo || 'hari ini'}. Waspada ketidakstabilan lereng disposal (DCI) dan pastikan pompa sump dewatering aktif penuh!`;
            
            kpiStatusBadge.className = 'badge bg-danger';
            kpiStatusBadge.innerText = 'SANGAT LEBAT';
            kpiStatusText.className = 'kpi-num text-danger';
            kpiStatusText.innerText = 'AWAS';

            if (hasTierEscalated || isAlertIntervalPassed) {
                lastRainAlertTier = 4;
                setLastAudioAlertTime(nowTime);
                lastAudioAlertTime = nowTime;
                triggerRainAlert(4, locationsSpoken, siteMaxTotalRain, maxRainNow, false, formattedOccurrenceInfo);
            }
        } else if (siteCls.tier === 3) {
            // Level 3: Hujan Lebat (50 - 100 mm/hari atau >= 50 mm/jam) -> 1x TING
            banner.className = 'warning-banner siaga';
            icon.className = 'bi bi-cloud-rain-heavy-fill text-warning';
            title.innerText = 'PERINGATAN CUACA: STATUS SIAGA HUJAN LEBAT (50 - 100 MM/HARI)';
            desc.innerText = `Terdeteksi curah hujan lebat (${siteMaxTotalRain.toFixed(1)} mm/hari, laju ${maxRainNow.toFixed(1)} mm/jam) ${locationsBanner}. Perkiraan terjadinya: ${formattedOccurrenceInfo || 'hari ini'}. Waspada jalan hauling sangat licin, kurangi batas kecepatan armada maksimal 30 km/jam dan jaga jarak aman 4x kendaraan!`;
            
            kpiStatusBadge.className = 'badge bg-warning text-dark';
            kpiStatusBadge.innerText = 'LEBAT';
            kpiStatusText.className = 'kpi-num text-warning';
            kpiStatusText.innerText = 'SIAGA';

            if (hasTierEscalated || isAlertIntervalPassed) {
                lastRainAlertTier = 3;
                setLastAudioAlertTime(nowTime);
                lastAudioAlertTime = nowTime;
                triggerRainAlert(3, locationsSpoken, siteMaxTotalRain, maxRainNow, false, formattedOccurrenceInfo);
            }
        } else if (hasThunderActive) {
            // Peringatan Sambaran Petir
            banner.className = 'warning-banner siaga';
            icon.className = 'bi bi-lightning-charge-fill text-warning';
            title.innerText = 'PERINGATAN BAHAYA: POTENSI PETIR / THUNDERSTORM';
            desc.innerText = `Terdeteksi aktivitas petir dan awan konvektif ${locationsBanner}. Perkiraan terjadinya: ${formattedOccurrenceInfo || 'saat ini'}. Seluruh personel di area terbuka segera evakuasi ke shelter petir terdekat.`;
            kpiStatusBadge.className = 'badge bg-warning text-dark';
            kpiStatusBadge.innerText = 'BAHAYA PETIR';
            kpiStatusText.className = 'kpi-num text-warning';
            kpiStatusText.innerText = 'PETIR';

            if (isAlertIntervalPassed) {
                setLastAudioAlertTime(nowTime);
                lastAudioAlertTime = nowTime;
                playEmergencyWarningSiren();
                setTimeout(() => {
                    speakGoogleVoice(`Peringatan bahaya petir. Terdeteksi potensi sambaran petir ${locationsSpoken}. Segera evakuasi ke shelter aman.`);
                }, 1200);
            }
        } else if (siteCls.tier === 2) {
            // Level 2: Hujan Sedang (20 - 50 mm/hari)
            lastRainAlertTier = 0;
            banner.className = 'warning-banner waspada';
            icon.className = 'bi bi-cloud-rain-fill text-warning';
            title.innerText = 'PERINGATAN CUACA: STATUS WASPADA HUJAN SEDANG (20 - 50 MM/HARI)';
            desc.innerText = `Terpantau hujan intensitas sedang (${siteMaxTotalRain.toFixed(1)} mm/hari, laju ${maxRainNow.toFixed(1)} mm/jam) ${locationsBanner}. ${formattedOccurrenceInfo ? 'Perkiraan terjadinya: ' + formattedOccurrenceInfo + '. ' : ''}Permukaan jalan hauling basah dan mulai licin, kurangi batas kecepatan armada.`;
            kpiStatusBadge.className = 'badge bg-warning text-dark';
            kpiStatusBadge.innerText = 'SEDANG';
            kpiStatusText.className = 'kpi-num text-warning';
            kpiStatusText.innerText = 'WASPADA';
        } else if (maxRainNow > 0 || siteMaxTotalRain > 0) {
            // Level 1: Hujan Ringan (0 - 20 mm/hari)
            lastRainAlertTier = 0;
            banner.className = 'warning-banner waspada';
            icon.className = 'bi bi-cloud-drizzle-fill text-info';
            title.innerText = 'KONDISI CUACA: HUJAN RINGAN / GERIMIS (0 - 20 MM/HARI)';
            desc.innerText = `Terpantau hujan ringan / gerimis (${siteMaxTotalRain.toFixed(1)} mm/hari, laju ${maxRainNow.toFixed(1)} mm/jam) ${locationsBanner}. Kondisi jalan hauling relatif aman dan terkendali.`;
            kpiStatusBadge.className = 'badge bg-info text-dark';
            kpiStatusBadge.innerText = 'RINGAN';
            kpiStatusText.className = 'kpi-num text-info';
            kpiStatusText.innerText = 'RINGAN';
        } else if (siteMaxProb >= 50) {
            // Prediksi Hujan Nanti Siang / Sore
            lastRainAlertTier = 0;
            banner.className = 'warning-banner waspada';
            icon.className = 'bi bi-cloud-sun-fill text-warning';
            title.innerText = 'PERINGATAN DINI CUACA: POTENSI HUJAN HARI INI';
            desc.innerText = `Saat ini kondisi site kondusif (${avgTemp}°C). Namun diprediksi potensi hujan pada ${rainTimeWindowStr || 'siang hingga sore'} dengan probabilitas mencapai ${siteMaxProb}%. Tim operasional diimbau waspada terhadap jalan hauling licin.`;
            kpiStatusBadge.className = 'badge bg-warning text-dark';
            kpiStatusBadge.innerText = 'PREDIKSI';
            kpiStatusText.className = 'kpi-num text-warning';
            kpiStatusText.innerText = 'WASPADA';
        } else {
            // Normal & Aman
            lastRainAlertTier = 0;
            banner.className = 'warning-banner normal';
            icon.className = 'bi bi-shield-check text-success';
            title.innerText = 'KONDISI CUACA SITE: NORMAL & AMAN';
            desc.innerText = 'Kondisi cuaca saat ini kondusif (akumulasi 0 - 20 mm/hari) dan prakiraan cuaca cerah/berawan di seluruh 17 titik tambang Indexim.';
            kpiStatusBadge.className = 'badge bg-success';
            kpiStatusBadge.innerText = 'AMAN';
            kpiStatusText.className = 'kpi-num text-success';
            kpiStatusText.innerText = 'NORMAL';
        }

        // Update filter badge numbers
        const warnCountEl = document.getElementById('warnCountBadge');
        if (warnCountEl) warnCountEl.innerText = warningPointsCount;
        const dryCountEl = document.getElementById('dryCountBadge');
        if (dryCountEl) dryCountEl.innerText = Math.max(0, results.length - warningPointsCount);

        // Update Bottom Ticker
        document.getElementById('weatherTickerText').innerText = tickerItems.join('  •  ');

        // Render Initial Hourly Chart (Combined or Point 1)
        updateHourlyChart(results[0]);

        // Start cycling popups across the 17 mining operational points on satellite map
        startPopupCycle();
    }

    /* ──────────────────────────────────────────────────────────────────────────
       6. AUTOMATIC TAB ROTATION (Daftar Titik <-> Tren 24 Jam Bergantian)
       ────────────────────────────────────────────────────────────────────────── */
    const TAB_ROTATION_CYCLE_MS = 18000; // 18 seconds alternating between tabs
    let tabRotationProgressMs = 0;
    let tabRotationTimer = null;
    let isTabRotationPaused = false;
    let currentActiveTab = 'points';
    let tabCycleCount = 0;

    function startTabRotation() {
        if (tabRotationTimer) clearInterval(tabRotationTimer);
        tabRotationProgressMs = 0;

        tabRotationTimer = setInterval(() => {
            if (isTabRotationPaused) return;

            tabRotationProgressMs += 200;
            const pct = Math.min(100, (tabRotationProgressMs / TAB_ROTATION_CYCLE_MS) * 100);

            const pBar = document.getElementById('tabRotationProgressBar');
            if (pBar) pBar.style.width = `${pct}%`;

            const secLeft = Math.max(0, Math.ceil((TAB_ROTATION_CYCLE_MS - tabRotationProgressMs) / 1000));
            const secEl = document.getElementById('tabCountdownSec');
            if (secEl) secEl.innerText = `${secLeft}s`;

            if (tabRotationProgressMs >= TAB_ROTATION_CYCLE_MS) {
                tabRotationProgressMs = 0;
                tabCycleCount++;

                // Alternate between 'points' and 'chart' primarily, with 'safety' every 4 cycles
                if (tabCycleCount % 4 === 0) {
                    switchRightTab('safety', false);
                } else if (currentActiveTab === 'points') {
                    switchRightTab('chart', false);
                } else {
                    switchRightTab('points', false);
                }
            }
        }, 200);
    }

    function toggleTabRotationPause() {
        isTabRotationPaused = !isTabRotationPaused;
        const badge = document.getElementById('tabRotationStatusBadge');
        if (isTabRotationPaused) {
            if (badge) {
                badge.style.background = 'rgba(239,68,68,0.2)';
                badge.style.color = '#f87171';
                badge.style.borderColor = 'rgba(239,68,68,0.4)';
                badge.innerHTML = '<i class="bi bi-pause-fill"></i> Rotasi: JEDA';
            }
        } else {
            if (badge) {
                badge.style.background = 'rgba(56,189,248,0.14)';
                badge.style.color = '#38bdf8';
                badge.style.borderColor = 'rgba(56,189,248,0.35)';
                badge.innerHTML = '<i class="bi bi-arrow-repeat" id="tabRotIcon"></i> Rotasi: <span id="tabCountdownSec">18s</span>';
            }
            tabRotationProgressMs = 0;
        }
    }

    function pauseTabRotation(durationMs = 25000) {
        isTabRotationPaused = true;
        const badge = document.getElementById('tabRotationStatusBadge');
        if (badge) {
            badge.style.background = 'rgba(251,191,36,0.2)';
            badge.style.color = '#fbbf24';
            badge.innerHTML = '<i class="bi bi-hand-index-thumb"></i> Manual: Jeda';
        }
        clearTimeout(window._tabResumeTimeout);
        window._tabResumeTimeout = setTimeout(() => {
            isTabRotationPaused = false;
            tabRotationProgressMs = 0;
            if (badge) {
                badge.style.background = 'rgba(56,189,248,0.14)';
                badge.style.color = '#38bdf8';
                badge.innerHTML = '<i class="bi bi-arrow-repeat" id="tabRotIcon"></i> Rotasi: <span id="tabCountdownSec">18s</span>';
            }
        }, durationMs);
    }

    function switchRightTab(tabName, isManual = false) {
        currentActiveTab = tabName;
        tabRotationProgressMs = 0;
        const pBar = document.getElementById('tabRotationProgressBar');
        if (pBar) pBar.style.width = '0%';

        document.getElementById('tabPointsBtn').classList.toggle('active', tabName === 'points');
        document.getElementById('tabChartBtn').classList.toggle('active', tabName === 'chart');
        document.getElementById('tabSafetyBtn').classList.toggle('active', tabName === 'safety');

        const pEl = document.getElementById('tabContentPoints');
        const cEl = document.getElementById('tabContentChart');
        const sEl = document.getElementById('tabContentSafety');

        pEl.style.display = tabName === 'points' ? 'flex' : 'none';
        cEl.style.display = tabName === 'chart' ? 'flex' : 'none';
        sEl.style.display = tabName === 'safety' ? 'flex' : 'none';

        if (tabName === 'points') {
            pEl.classList.remove('tab-fade-in');
            void pEl.offsetWidth; // trigger reflow
            pEl.classList.add('tab-fade-in');
        } else if (tabName === 'chart') {
            cEl.classList.remove('tab-fade-in');
            void cEl.offsetWidth;
            cEl.classList.add('tab-fade-in');
            if (hourlyChartInstance) {
                setTimeout(() => hourlyChartInstance.resize(), 60);
            }
        } else if (tabName === 'safety') {
            sEl.classList.remove('tab-fade-in');
            void sEl.offsetWidth;
            sEl.classList.add('tab-fade-in');
        }

        if (isManual) {
            pauseTabRotation(25000);
        }
    }

    function setPointFilter(type) {
        document.getElementById('filterAllBtn').classList.toggle('active', type === 'all');
        document.getElementById('filterWarnBtn').classList.toggle('active', type === 'warning');
        document.getElementById('filterDryBtn').classList.toggle('active', type === 'dry');

        document.querySelectorAll('.point-card').forEach(card => {
            const pType = card.getAttribute('data-point-type');
            if (type === 'all') {
                card.style.display = 'grid';
            } else if (type === 'warning') {
                card.style.display = (pType === 'warning') ? 'grid' : 'none';
            } else if (type === 'dry') {
                card.style.display = (pType === 'dry') ? 'grid' : 'none';
            }
        });
    }

    function updateHourlyChart(item) {
        if (!item || !item.forecast || !item.forecast.hourly) return;
        const fc = item.forecast.hourly;

        const currentHourIdx = getCurrentHourIndex(fc.time);
        const sliceEnd = Math.min(fc.time.length, currentHourIdx + 24);

        const labels = (fc.time || []).slice(currentHourIdx, sliceEnd).map(t => {
            const parts = t.split('T');
            return parts.length > 1 ? parts[1] : t;
        });
        const precipData = (fc.precipitation || []).slice(currentHourIdx, sliceEnd);
        const probData = (fc.precipitation_probability || []).slice(currentHourIdx, sliceEnd);
        const tempData = (fc.temperature_2m || []).slice(currentHourIdx, sliceEnd);
        const windData = (fc.wind_gusts_10m || []).slice(currentHourIdx, sliceEnd);
        const codes = (fc.weather_code || []).slice(currentHourIdx, sliceEnd);

        document.getElementById('chartLocationLabel').innerText = `Prakiraan 24 Jam: ${item.point.name}`;

        // 1. Calculate 24-Hour HUD Highlights
        const totalRain = precipData.reduce((a, b) => a + b, 0).toFixed(1);
        const maxPrecipVal = Math.max(...precipData);
        let peakRainHour = '--:--';
        if (maxPrecipVal > 0) {
            const peakIdx = precipData.indexOf(maxPrecipVal);
            peakRainHour = labels[peakIdx] || '--:--';
        }
        const maxGustVal = Math.max(...windData);
        const maxGustIdx = windData.indexOf(maxGustVal);
        const maxGustHour = labels[maxGustIdx] || '--:--';

        const minTemp = Math.min(...tempData).toFixed(0);
        const maxTemp = Math.max(...tempData).toFixed(0);

        document.getElementById('trendTotalRain').innerText = `${totalRain} mm`;
        document.getElementById('trendPeakRain').innerText = peakRainHour !== '--:--' ? `Pk ${peakRainHour}` : 'Nihil Hujan';
        document.getElementById('trendPeakRainVal').innerText = maxPrecipVal > 0 ? `Maks ${maxPrecipVal} mm/h` : 'Kering 24 Jam';
        document.getElementById('trendMaxGust').innerText = `${maxGustVal} km/h`;
        document.getElementById('trendMaxGustTime').innerText = `Pukul ${maxGustHour}`;
        document.getElementById('trendTempRange').innerHTML = `${minTemp}&deg; — ${maxTemp}&deg;C`;
        document.getElementById('trendTempDesc').innerText = `Min ${minTemp}°C / Maks ${maxTemp}°C`;

        // Hauling Road Guidance text
        const guidanceEl = document.getElementById('trendHaulingText');
        if (guidanceEl) {
            if (maxPrecipVal >= 2 || totalRain >= 5) {
                guidanceEl.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Peringatan Jalan Sangat Licin:</span> Terdeteksi potensi hujan lebat puncak ${maxPrecipVal} mm/h pada pukul ${peakRainHour}. Rekomendasi pembatasan kecepatan armada dan siapkan motor grader.`;
            } else if (totalRain > 0) {
                guidanceEl.innerHTML = `<span class="text-warning fw-bold"><i class="bi bi-speedometer2"></i> Waspada Jalan Basah:</span> Potensi gerimis basah pada jam ${peakRainHour}. Batasi kecepatan hauling DT maksimal 30 km/jam dan jaga jarak aman.`;
            } else {
                guidanceEl.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Hauling Road Normal:</span> Kondisi jalan tambang diprediksi kering dan aman untuk kecepatan standar selama 24 jam ke depan.`;
            }
        }

        // 2. Render Hourly Strip (Next 8 Hours from Current Hour)
        const stripContainer = document.getElementById('hourlyStripWrap');
        if (stripContainer) {
            stripContainer.innerHTML = '';
            for (let i = 0; i < Math.min(8, labels.length); i++) {
                const hourTime = labels[i];
                const hRain = precipData[i] || 0;
                const hProb = probData[i] || 0;
                const hTemp = Math.round(tempData[i] || 25);
                const hCode = codes[i] || 0;
                const wInfo = interpretWmoCode(hCode);

                const cardEl = document.createElement('div');
                cardEl.className = `hourly-strip-card ${i === 0 ? 'active-now' : ''} ${hRain > 0 ? 'wet-hour' : ''}`;
                cardEl.innerHTML = `
                    <div class="strip-time">${i === 0 ? 'SEKARANG (' + hourTime + ')' : hourTime}</div>
                    <div class="strip-icon"><i class="bi ${wInfo.icon}" style="color:${wInfo.color}; font-size:16px;"></i></div>
                    <div class="strip-rain" style="color:${hRain > 0 ? '#38bdf8' : '#64748b'};">${hRain > 0 ? hRain + 'mm' : '0mm'}</div>
                    <div class="strip-prob">${hProb}%</div>
                    <div class="strip-temp">${hTemp}&deg;C</div>
                `;
                stripContainer.appendChild(cardEl);
            }
        }

        // 3. Render Chart.js Multi-Layer
        const ctx = document.getElementById('hourlyWeatherChart').getContext('2d');
        if (hourlyChartInstance) {
            hourlyChartInstance.destroy();
        }

        hourlyChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Curah Hujan (mm)',
                        data: precipData,
                        backgroundColor: 'rgba(56, 189, 248, 0.7)',
                        borderColor: '#0284c7',
                        borderWidth: 1.2,
                        borderRadius: 3,
                        yAxisID: 'yPrecip',
                        order: 2
                    },
                    {
                        label: 'Peluang Hujan (%)',
                        data: probData,
                        type: 'line',
                        borderColor: '#a855f7',
                        borderDash: [3, 3],
                        backgroundColor: 'transparent',
                        borderWidth: 1.5,
                        tension: 0.35,
                        pointRadius: 0,
                        yAxisID: 'yProb',
                        order: 3
                    },
                    {
                        label: 'Suhu (°C)',
                        data: tempData,
                        type: 'line',
                        borderColor: '#fbbf24',
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        tension: 0.35,
                        pointRadius: 2,
                        yAxisID: 'yTemp',
                        order: 1
                    },
                    {
                        label: 'Gust Angin (km/h)',
                        data: windData,
                        type: 'line',
                        borderColor: '#fb923c',
                        borderDash: [4, 4],
                        backgroundColor: 'transparent',
                        borderWidth: 1.5,
                        tension: 0.35,
                        pointRadius: 0,
                        yAxisID: 'yWind',
                        order: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        labels: { color: '#cbd5e1', font: { family: 'Poppins', size: 9 }, boxWidth: 10, padding: 6 }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: '#94a3b8', font: { size: 8.5 }, maxRotation: 0 },
                        grid: { color: 'rgba(255,255,255,0.04)' }
                    },
                    yPrecip: {
                        type: 'linear',
                        position: 'left',
                        title: { display: true, text: 'Hujan (mm)', color: '#38bdf8', font: { size: 8.5 } },
                        ticks: { color: '#38bdf8', font: { size: 8.5 }, beginAtZero: true },
                        grid: { color: 'rgba(255,255,255,0.04)' }
                    },
                    yProb: {
                        type: 'linear',
                        position: 'right',
                        display: false,
                        min: 0,
                        max: 100
                    },
                    yTemp: {
                        type: 'linear',
                        position: 'right',
                        title: { display: true, text: 'Suhu (°C)', color: '#fbbf24', font: { size: 8.5 } },
                        ticks: { color: '#fbbf24', font: { size: 8.5 } },
                        grid: { drawOnChartArea: false }
                    },
                    yWind: {
                        type: 'linear',
                        position: 'right',
                        display: false,
                        grid: { drawOnChartArea: false }
                    }
                }
            }
        });
    }

    /* ──────────────────────────────────────────────────────────────────────────
       5. AUTO-SCROLL ENGINE FOR OPERATIONAL POINTS (TV DASHBOARD MODE)
       ────────────────────────────────────────────────────────────────────────── */
    let isAutoScrollEnabled = true;
    let isUserInteractingWithPoints = false;
    let autoScrollPauseTimeout = null;
    let autoScrollRaf = null;
    let lastScrollTimestamp = 0;
    let edgeHoldUntil = 0;

    function toggleAutoScroll() {
        isAutoScrollEnabled = !isAutoScrollEnabled;
        const badge = document.getElementById('autoScrollBadge');
        if (badge) {
            if (isAutoScrollEnabled) {
                badge.style.background = 'rgba(56,189,248,0.15)';
                badge.style.borderColor = 'rgba(56,189,248,0.4)';
                badge.style.color = '#38bdf8';
                badge.innerHTML = '<i class="bi bi-arrow-down-up"></i> Auto-Scroll: ON';
            } else {
                badge.style.background = 'rgba(148,163,184,0.15)';
                badge.style.borderColor = 'rgba(148,163,184,0.3)';
                badge.style.color = '#94a3b8';
                badge.innerHTML = '<i class="bi bi-pause-circle"></i> Auto-Scroll: OFF';
            }
        }
    }

    function initAutoScroll() {
        const container = document.getElementById('tabContentPoints');
        if (!container) return;

        // Pause auto-scroll on hover, wheel, or touch interaction
        container.addEventListener('mouseenter', () => { isUserInteractingWithPoints = true; });
        container.addEventListener('mouseleave', () => { isUserInteractingWithPoints = false; });
        container.addEventListener('wheel', () => {
            isUserInteractingWithPoints = true;
            clearTimeout(autoScrollPauseTimeout);
            autoScrollPauseTimeout = setTimeout(() => { isUserInteractingWithPoints = false; }, 4000);
        }, { passive: true });
        container.addEventListener('touchstart', () => { isUserInteractingWithPoints = true; }, { passive: true });
        container.addEventListener('touchend', () => {
            clearTimeout(autoScrollPauseTimeout);
            autoScrollPauseTimeout = setTimeout(() => { isUserInteractingWithPoints = false; }, 4000);
        }, { passive: true });

        const holdDurationMs = 2500;

        function stepAutoScroll(timestamp) {
            if (!lastScrollTimestamp) lastScrollTimestamp = timestamp;
            const delta = timestamp - lastScrollTimestamp;
            lastScrollTimestamp = timestamp;

            if (isAutoScrollEnabled && !isUserInteractingWithPoints) {
                const tabPoints = document.getElementById('tabContentPoints');
                if (tabPoints && tabPoints.style.display !== 'none') {
                    const now = Date.now();
                    if (now >= edgeHoldUntil) {
                        const maxScroll = tabPoints.scrollHeight - tabPoints.clientHeight;
                        if (maxScroll > 10) {
                            if (tabPoints.scrollTop >= maxScroll - 2) {
                                // Bottom reached: hold for 2.5s, then smooth return to top
                                edgeHoldUntil = now + holdDurationMs;
                                setTimeout(() => {
                                    tabPoints.scrollTo({ top: 0, behavior: 'smooth' });
                                    edgeHoldUntil = Date.now() + 2000;
                                }, 500);
                            } else {
                                tabPoints.scrollTop += Math.max(0.4, (delta / 16.6) * 0.4);
                            }
                        }
                    }
                }
            }
            autoScrollRaf = requestAnimationFrame(stepAutoScroll);
        }

        if (autoScrollRaf) cancelAnimationFrame(autoScrollRaf);
        autoScrollRaf = requestAnimationFrame(stepAutoScroll);
    }

    // Initialize Map, Speech, Auto-Scroll, Tab Carousel, and Fetch Live Forecast
    window.addEventListener('DOMContentLoaded', () => {
        initVoiceSynthesis();
        initMap();
        initAutoScroll();
        startTabRotation();
        fetchForecastData();

        // Refresh forecast every 5 minutes (300,000 ms) as specified by IMORA integration guide
        setInterval(fetchForecastData, 300000);
    });
    </script>
</body>
</html>
