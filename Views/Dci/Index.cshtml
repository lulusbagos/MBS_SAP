    // Score Calculation
    function calculateDciScore() {
        const p1 = parseInt($('#skorLantaiDump').val()) || 100;
        const p2 = parseInt($('#skorSafetyBerm').val()) || 100;
        const p3 = parseInt($('#skorKondisiCrest').val()) || 100;
        const p4 = parseInt($('#skorGradeDumping').val()) || 100;
        const p5 = parseInt($('#skorDrainaseDump').val()) || 100;
        const p6 = parseInt($('#skorPenataanSpillage').val()) || 100;
        const p7 = parseInt($('#skorRambuPenerangan').val()) || 100;
        const p8 = parseInt($('#skorSpotterManuver').val()) || 100;

        let total = (p1 * 0.15) + (p2 * 0.15) + (p3 * 0.15) + (p4 * 0.15) +
                    (p5 * 0.10) + (p6 * 0.10) + (p7 * 0.10) + (p8 * 0.10);

        let rounded = (Math.round(total * 10) / 10).toFixed(1);

        const paramsList = [
            { name: "Lantai Dump & Daya Dukung", val: p1, desc100: "Rata & Padat Kuat", desc70: "Bergelombang / Lembek", desc40: "Amblas Parah / Lumpur" },
            { name: "Tanggul Pengaman (Safety Berm)", val: p2, desc100: "≥ 3/4 Roda & Kokoh", desc70: "1/2 - 3/4 Roda / Tipis", desc40: "< 1/2 Roda / Putus" },
            { name: "Kondisi Crest & Tepi Dumping", val: p3, desc100: "Stabil & Rapat", desc70: "Retak Rambut / Penurunan", desc40: "Retak Lebar / Slump" },
            { name: "Counter Grade Lantai", val: p4, desc100: "Naik 2-3% ke Crest", desc70: "Datar Tanpa Counter Grade", desc40: "Turun ke Luar Crest" },
            { name: "Drainase & Saluran Dump", val: p5, desc100: "Kering & Mengalir", desc70: "Ada Genangan Lokal", desc40: "Tergenang Masif / Bahaya" },
            { name: "Penataan Spillage & Material", val: p6, desc100: "Bersih & Dozer Aktif", desc70: "Tumpukan Belum Rata", desc40: "Menumpuk Berantakan" },
            { name: "Rambu & Penerangan Malam", val: p7, desc100: "Lampu Terang & Lengkap", desc70: "Remang / Rambu Kusam", desc40: "Gelap Total / Tanpa Rambu" },
            { name: "Spotter & Pola Manuver Unit", val: p8, desc100: "Spotter Aktif & Tertib", desc70: "Kurang Fokus / Mepet", desc40: "Tanpa Spotter / Semrawut" }
        ];

        let cnt100 = 0, cnt70 = 0, cnt40 = 0;
        let findings = [];
        let autoActions = [];

        paramsList.forEach(p => {
            if (p.val === 100) cnt100++;
            else if (p.val === 70) {
                cnt70++;
                findings.push(`<b>${p.name}</b>: Skor 70 (${p.desc70})`);
                if (p.name.includes("Lantai")) autoActions.push("Dukungan dozer memadatkan dan meratakan lantai dump");
                else if (p.name.includes("Berm")) autoActions.push("Peninggian safety berm minimal 3/4 tinggi roda unit terbesar");
                else if (p.name.includes("Crest")) autoActions.push("Monitoring retakan crest dan penataan mundur titik buang");
                else if (p.name.includes("Grade")) autoActions.push("Rekayasa counter grade menanjak 2-3% ke arah crest");
                else if (p.name.includes("Drainase")) autoActions.push("Pembuatan parit drainase pembuang air di disposal");
                else if (p.name.includes("Spillage")) autoActions.push("Pembersihan dan perataan ceceran material oleh dozer");
                else if (p.name.includes("Rambu")) autoActions.push("Optimalisasi tower lamp dan perbaikan rambu batas dumping");
                else if (p.name.includes("Spotter")) autoActions.push("Penempatan spotter aktif dan penertiban jarak dumping unit");
            } else if (p.val === 40) {
                cnt40++;
                findings.push(`<span class="text-danger"><b>${p.name}</b>: Skor 40 (${p.desc40}) [KRITIS]</span>`);
                if (p.name.includes("Crest")) autoActions.push("URGENT / STOP: Penutupan sementara area crest retak/slump dan inspeksi Geotek");
                else if (p.name.includes("Berm")) autoActions.push("URGENT: Rekonstruksi segera tanggul pengaman sebelum dumping dilanjutkan");
                else if (p.name.includes("Grade")) autoActions.push("URGENT: Dozer wajib segera membuat counter grade tanjakan");
                else if (p.name.includes("Lantai")) autoActions.push("URGENT: Re-sheeting material kering dan pengalihan ke pad alternatif");
                else if (p.name.includes("Spotter")) autoActions.push("URGENT: Wajib tempatkan spotter sebelum unit diizinkan manuver");
                else autoActions.push(`URGENT: Penanganan segera pada ${p.name}`);
            }
        });

        $('#cntStandar').text(cnt100);
        $('#cntPerhatian').text(cnt70);
        $('#cntKritis').text(cnt40);

        let label = "Baik";
        let color = "#10b981";
        let bg = "rgba(16, 185, 129, 0.15)";
        let border = "rgba(16, 185, 129, 0.4)";
        let statusTitle = "STATUS: DISPOSAL LAYAK OPERASI PENUH (OPTIMAL)";
        let statusDesc = "Seluruh 8 parameter dumping memenuhi standar keselamatan disposal tambang.";
        let statusIcon = "bi-shield-fill-check";

        if (total < 70) {
            label = "Kurang";
            color = "#f43f5e";
            bg = "rgba(244, 63, 94, 0.15)";
            border = "rgba(244, 63, 94, 0.4)";
            statusTitle = "STATUS: DISPOSAL RAWAN / PERLU PERBAIKAN SEGERA";
            statusDesc = "Ditemukan parameter kritis di bawah standar keselamatan disposal. Batasi/tutup dumping pad hingga direkayasa aman.";
            statusIcon = "bi-x-octagon-fill";
        } else if (total < 85) {
            label = "Sedang";
            color = "#f59e0b";
            bg = "rgba(245, 158, 11, 0.15)";
            border = "rgba(245, 158, 11, 0.4)";
            statusTitle = "STATUS: DISPOSAL LAYAK DENGAN PENGAWASAN & CATATAN";
            statusDesc = "Operasi dumping berjalan dengan perhatian khusus pada parameter yang perlu perbaikan/dozer support.";
            statusIcon = "bi-exclamation-triangle-fill";
        }

        $('#liveScoreVal').text(rounded);
        $('#liveScoreBadge').html(`Skor DCI: <span>${rounded}</span>% (${label})`).css({ 'background': bg, 'color': color, 'border-color': border });

        $('#summaryScoreVal').text(rounded + '%').css('color', color);
        $('#summaryCategoryBadge').html(`<i class="bi ${statusIcon} me-1"></i> ${label.toUpperCase()}`).css({ 'background': bg, 'color': color });

        $('#feasibilityBanner').css({ 'background': bg, 'border-color': border, 'color': color });
        $('#feasibilityIcon').attr('class', `bi ${statusIcon}`);
        $('#feasibilityTitle').text(statusTitle);
        $('#feasibilityDesc').text(statusDesc);

        // Update findings list
        if (findings.length === 0) {
            $('#findingsCountBadge').text('0 Defisit').attr('class', 'badge bg-success');
            $('#findingsList').html('<i class="bi bi-check2-circle text-success me-1"></i> Semua parameter berada dalam batas optimal.');
            $('#autoRecText').text('Pertahankan kondisi standar kerja di area dumping.');
        } else {
            $('#findingsCountBadge').text(`${findings.length} Temuan Defisit`).attr('class', 'badge bg-warning text-dark');
            let listHtml = '<ul class="mb-0 ps-3">' + findings.map(f => `<li class="mb-1">${f}</li>`).join('') + '</ul>';
            $('#findingsList').html(listHtml);
            let recText = autoActions.length > 0 ? autoActions.join("; ") + "." : "Lakukan perbaikan terarah pada parameter defisit.";
            $('#autoRecText').text(recText);
        }

        currentDciSummaryData = {
            totalScore: rounded,
            kategori: label,
            statusTitle: statusTitle,
            cnt100: cnt100,
            cnt70: cnt70,
            cnt40: cnt40,
            findings: findings,
            autoActions: autoActions
        };
    }

    function applyAutoRecommendationDci() {
        const text = $('#autoRecText').text().trim();
