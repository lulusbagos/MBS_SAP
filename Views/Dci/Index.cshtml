<div class="modal fade" id="dciDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid rgba(249, 115, 22, 0.4); border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 16px 24px;">
                <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2">
                    <i class="bi bi-layers-fill" style="color: #ea580c;"></i>
                    <span>Detail Laporan Dump Condition Index (DCI)</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <div class="row g-4">
                    <div class="col-12 col-md-5">
                        <div id="detailImgWrap" style="width: 100%; height: 260px; border-radius: 14px; overflow: hidden; background: #000; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center;">
                            <img id="detailImg" src="" alt="Foto DCI" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/img/placeholder-photo.png'" />
                        </div>
                        <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted" style="font-size: 12px;">Skor Akhir DCI:</span>
                                <span class="font-weight-bold" id="detailSkor" style="font-size: 14px;">-</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted" style="font-size: 12px;">Status Kategori:</span>
                                <span class="font-weight-bold" id="detailKategori" style="font-size: 12px;">-</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted" style="font-size: 12px;">Disposal / Dump:</span>
                                <span class="font-weight-bold text-white" id="detailNamaDump" style="font-size: 12px;">-</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted" style="font-size: 12px;">Surveyor:</span>
                                <span class="font-weight-bold text-white" id="detailSurveyor" style="font-size: 12px;">-</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-7">
                        <h6 class="text-white font-weight-bold mb-3" style="font-size: 13px;">Breakdown 8 Parameter Penilaian:</h6>
                        <div class="d-flex flex-column gap-2" id="detailParamsList">
                            <!-- Injected by JS -->
                        </div>

                        <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); font-size: 12px;">
                            <div class="mb-2"><strong>Catatan:</strong> <span id="detailCatatan" class="text-muted">-</span></div>
                            <div class="mb-2"><strong>Tindakan Perbaikan:</strong> <span id="detailTindakan" class="text-muted">-</span></div>
                            <div><strong>PIC:</strong> <span id="detailPic" class="text-muted">-</span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-sm btn-success me-auto" id="btnShareWa" onclick="shareWhatsApp()">
                    <i class="bi bi-whatsapp me-1"></i> Bagikan WhatsApp
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<style>
.param-box-premium {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 10px;
    transition: all 0.2s ease;
}
.param-box-premium:hover {
    background: rgba(249, 115, 22, 0.03);
    border-color: rgba(249, 115, 22, 0.3);
}
.param-icon-badge {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
}
.param-header-title {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--text-main);
}
.param-guideline-badge {
    font-size: 11px;
    color: var(--text-muted);
}
.score-btn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}
.btn-score-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1.5px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
}
.btn-score-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(249, 115, 22, 0.4);
    color: #fff;
}
.btn-score-card.active {
    background: rgba(249, 115, 22, 0.15);
    border-color: #f97316;
    color: #fff;
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.25);
}
.btn-score-pill {
    font-weight: 800;
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.3);
    margin-right: 6px;
}
.btn-score-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 600;
}
.btn-score-icon {
    font-size: 14px;
    margin-left: 6px;
    opacity: 0.3;
}
.btn-score-card.active .btn-score-icon {
    opacity: 1;
    color: #ea580c;
}
@@media (max-width: 768px) {
    .score-btn-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Init score button click handlers
        document.querySelectorAll('.btn-score-card').forEach(btn => {
            btn.addEventListener('click', function () {
                const param = this.dataset.param;
                const val = parseInt(this.dataset.val);

                // Set active class
                document.querySelectorAll(`.btn-score-card[data-param="${param}"]`).forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                // Update hidden input
                document.getElementById(param).value = val;

                // Recalculate score live
                calcLiveScore();
            });
        });

        // Trigger Success/Error modal if present
        const successModal = document.getElementById('statusSuccessModal');
        if (successModal) {
            new bootstrap.Modal(successModal).show();
        }
        const errorModal = document.getElementById('statusErrorModal');
        if (errorModal) {
            new bootstrap.Modal(errorModal).show();
        }

        calcLiveScore();
    });

    function calcLiveScore() {
        const p1 = parseInt(document.getElementById('skorLantaiDump').value) || 100;
        const p2 = parseInt(document.getElementById('skorSafetyBerm').value) || 100;
        const p3 = parseInt(document.getElementById('skorKondisiCrest').value) || 100;
        const p4 = parseInt(document.getElementById('skorGradeDumping').value) || 100;
        const p5 = parseInt(document.getElementById('skorDrainaseDump').value) || 100;
        const p6 = parseInt(document.getElementById('skorPenataanSpillage').value) || 100;
        const p7 = parseInt(document.getElementById('skorRambuPenerangan').value) || 100;
        const p8 = parseInt(document.getElementById('skorSpotterManuver').value) || 100;

        let total = (p1 * 0.15) + (p2 * 0.15) + (p3 * 0.15) + (p4 * 0.15) +
                    (p5 * 0.10) + (p6 * 0.10) + (p7 * 0.10) + (p8 * 0.10);
        total = Math.round(total * 10) / 10;

        let kat = total >= 85 ? "Baik" : (total >= 70 ? "Sedang" : "Kurang");
        let color = total >= 85 ? "#10b981" : (total >= 70 ? "#f59e0b" : "#f43f5e");
        let bg = total >= 85 ? "rgba(16, 185, 129, 0.2)" : (total >= 70 ? "rgba(245, 158, 11, 0.2)" : "rgba(244, 63, 94, 0.2)");

        const scoreValEl = document.getElementById('liveScoreVal');
        const badgeEl = document.getElementById('liveScoreBadge');
        if (scoreValEl && badgeEl) {
            scoreValEl.innerText = total.toFixed(1);
            badgeEl.innerHTML = `Skor DCI: <span id="liveScoreVal">${total.toFixed(1)}</span>% (${kat})`;
            badgeEl.style.color = color;
            badgeEl.style.backgroundColor = bg;
            badgeEl.style.borderColor = color;
        }
    }

    function openInputModal() {
        document.getElementById('dciForm').reset();
        document.getElementById('reportId').value = '';
        document.getElementById('modalFormTitle').innerText = 'Form Inspeksi Dump Condition Index (DCI)';
        const newBadge = document.getElementById('modalNewBadge');
        if (newBadge) newBadge.classList.remove('d-none');
        document.getElementById('inputTanggal').value = new Date().toISOString().substring(0, 10);
        document.getElementById('inputWaktu').value = new Date().toTimeString().substring(0, 5);
        document.getElementById('photoPreviewWrap').classList.add('d-none');

        // Reset all buttons to 100
        ['skorLantaiDump', 'skorSafetyBerm', 'skorKondisiCrest', 'skorGradeDumping',
         'skorDrainaseDump', 'skorPenataanSpillage', 'skorRambuPenerangan', 'skorSpotterManuver'].forEach(param => {
            document.getElementById(param).value = 100;
            document.querySelectorAll(`.btn-score-card[data-param="${param}"]`).forEach(b => {
                if (b.dataset.val === "100") b.classList.add('active');
                else b.classList.remove('active');
            });
        });

        calcLiveScore();
        new bootstrap.Modal(document.getElementById('dciInputModal')).show();
    }

    function editReport(id) {
        fetch(`/Dci/GetDetail?id=${id}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('reportId').value = data.id;
                document.getElementById('modalFormTitle').innerText = 'Edit Laporan DCI #' + data.id;
                const newBadge = document.getElementById('modalNewBadge');
                if (newBadge) newBadge.classList.add('d-none');
                document.getElementById('inputTanggal').value = data.tanggal;
                document.getElementById('inputWaktu').value = data.waktu;
                document.getElementById('inputShift').value = data.shift || 'Day';
                document.getElementById('inputArea').value = data.area || '';
                document.getElementById('inputLokasi').value = data.lokasi || '';
                document.getElementById('inputDisposal').value = data.disposal || '';
                document.getElementById('inputNamaDump').value = data.namaDump || '';
                document.getElementById('inputDetilLokasi').value = data.detilLokasi || '';
                document.getElementById('inputLat').value = data.latitude || '';
                document.getElementById('inputLong').value = data.longitude || '';
                if (data.latitude && data.longitude) {
                    document.getElementById('inputGps').value = `${data.latitude}, ${data.longitude}`;
                } else {
                    document.getElementById('inputGps').value = '';
                }

                document.getElementById('inputCatatan').value = data.catatan || '';
                document.getElementById('inputTindakan').value = data.tindakanPerbaikan || '';
                document.getElementById('inputPic').value = data.pic || '';

                if (data.fotoUrl) {
                    document.getElementById('photoPreviewImg').src = data.fotoUrl;
                    document.getElementById('photoPreviewWrap').classList.remove('d-none');
                } else {
                    document.getElementById('photoPreviewWrap').classList.add('d-none');
                }

                // Set score values
                const scoreMap = {
                    'skorLantaiDump': data.skorLantaiDump,
                    'skorSafetyBerm': data.skorSafetyBerm,
                    'skorKondisiCrest': data.skorKondisiCrest,
                    'skorGradeDumping': data.skorGradeDumping,
                    'skorDrainaseDump': data.skorDrainaseDump,
                    'skorPenataanSpillage': data.skorPenataanSpillage,
                    'skorRambuPenerangan': data.skorRambuPenerangan,
                    'skorSpotterManuver': data.skorSpotterManuver
                };

                for (let param in scoreMap) {
                    const val = scoreMap[param] || 100;
                    document.getElementById(param).value = val;
                    document.querySelectorAll(`.btn-score-card[data-param="${param}"]`).forEach(b => {
                        if (parseInt(b.dataset.val) === val) b.classList.add('active');
                        else b.classList.remove('active');
                    });
                }

                calcLiveScore();
                new bootstrap.Modal(document.getElementById('dciInputModal')).show();
            })
            .catch(err => alert('Gagal memuat data laporan: ' + err));
    }

    let currentDetailData = null;

    function openDetailModal(id) {
        fetch(`/Dci/GetDetail?id=${id}`)
            .then(res => res.json())
            .then(data => {
                currentDetailData = data;
                document.getElementById('detailImg').src = data.fotoUrl || '/img/placeholder-photo.png';
                document.getElementById('detailSkor').innerText = data.totalScore + '%';
                document.getElementById('detailKategori').innerText = data.kategoriIndex;
                document.getElementById('detailKategori').style.color = data.totalScore >= 85 ? '#10b981' : (data.totalScore >= 70 ? '#f59e0b' : '#f43f5e');
                document.getElementById('detailNamaDump').innerText = data.namaDump || data.disposal || data.lokasi;
                document.getElementById('detailSurveyor').innerText = `${data.nama} (${data.nik})`;
                document.getElementById('detailCatatan').innerText = data.catatan || '-';
                document.getElementById('detailTindakan').innerText = data.tindakanPerbaikan || '-';
                document.getElementById('detailPic').innerText = data.pic || '-';

                const params = [
                    { name: '1. Lantai Dump & Pad Stability', val: data.skorLantaiDump, weight: '15%' },
                    { name: '2. Safety Berm / Tanggul Penahan', val: data.skorSafetyBerm, weight: '15%' },
                    { name: '3. Kondisi Crest & Edge Disposal', val: data.skorKondisiCrest, weight: '15%' },
                    { name: '4. Grade & Kemiringan Dumping', val: data.skorGradeDumping, weight: '15%' },
                    { name: '5. Drainase & Aliran Air Dump', val: data.skorDrainaseDump, weight: '10%' },
                    { name: '6. Penataan Material & Spillage', val: data.skorPenataanSpillage, weight: '10%' },
                    { name: '7. Rambu & Penerangan Disposal', val: data.skorRambuPenerangan, weight: '10%' },
                    { name: '8. Petugas Spotter & Manuver Unit', val: data.skorSpotterManuver, weight: '10%' }
                ];

                let html = '';
                params.forEach(p => {
                    let col = p.val === 100 ? '#10b981' : (p.val === 70 ? '#f59e0b' : '#f43f5e');
                    html += `
                        <div class="d-flex align-items-center justify-content-between p-2 rounded-2" style="background: rgba(255,255,255,0.03); font-size: 11.5px;">
                            <span class="text-white">${p.name} <small class="text-muted">(${p.weight})</small></span>
                            <span class="badge" style="background: ${col}20; color: ${col}; border: 1px solid ${col}40; font-weight: 700;">${p.val}</span>
                        </div>
                    `;
                });
                document.getElementById('detailParamsList').innerHTML = html;

                new bootstrap.Modal(document.getElementById('dciDetailModal')).show();
            })
            .catch(err => alert('Gagal memuat detail laporan: ' + err));
    }

    function shareWhatsApp() {
        if (!currentDetailData) return;
        const d = currentDetailData;
        const text = `*LAPORAN DUMP CONDITION INDEX (DCI)*%0A` +
                     `*Tanggal:* ${d.tanggal} (${d.waktu})%0A` +
                     `*Lokasi:* ${d.lokasi} - ${d.area}%0A` +
                     `*Disposal/Dump:* ${d.namaDump || d.disposal || '-'}%0A` +
                     `*Surveyor:* ${d.nama} (${d.nik})%0A` +
                     `*Total Skor DCI:* ${d.totalScore}% (${d.kategoriIndex})%0A` +
                     `-------------------------%0A` +
                     `*Catatan:* ${d.catatan || '-'}%0A` +
                     `*Tindakan Perbaikan:* ${d.tindakanPerbaikan || '-'}%0A` +
                     `*PIC:* ${d.pic || '-'}`;
        window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    function confirmDelete(id) {
        document.getElementById('deleteForm').action = `/Dci/Delete?id=${id}`;
        new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
    }

    function previewPhoto(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('photoPreviewImg').src = e.target.result;
                document.getElementById('photoPreviewWrap').classList.remove('d-none');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function getLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(position => {
                const lat = position.coords.latitude.toFixed(6);
                const long = position.coords.longitude.toFixed(6);
                document.getElementById('inputLat').value = lat;
                document.getElementById('inputLong').value = long;
                document.getElementById('inputGps').value = `${lat}, ${long}`;
            }, err => {
                alert('Gagal mengambil GPS: ' + err.message);
            });
        } else {
            alert('Geolocation tidak didukung pada browser ini.');
        }
    }
</script>
