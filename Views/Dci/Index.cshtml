                        <button type="submit" class="btn btn-primary flex-fill py-3 font-weight-bold shadow-sm" style="background: linear-gradient(135deg, #c2410c, #ea580c); border: none; border-radius: 14px; font-size: 14px;">
                            <i class="bi bi-check2-circle me-1"></i> Simpan Laporan DCI
                        </button>
                        <button type="button" class="btn btn-outline-secondary py-3 px-4 font-weight-bold" style="border-radius: 14px;" onclick="resetForm()">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIWAYAT COLUMN -->
        <div class="col-lg-6">
            <!-- Filter Bar -->
            <div class="card-sap p-3 mb-3">
                <form method="get" asp-action="Index">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label-sap" style="font-size: 11px;">Cari Lokasi / Dump / NIK</label>
                            <input type="text" name="search" class="input-sap" value="@ViewBag.CurrentSearch" placeholder="Ketik kata kunci..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Filter Disposal</label>
                            <select name="disposal" class="input-sap">
                                <option value="">Semua Disposal</option>
                                @foreach (var d in disposalList)
                                {
                                    <option value="@d" selected="@(ViewBag.CurrentDisposal == d ? "selected" : null)">@d</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Kategori Skor</label>
                            <select name="kategori" class="input-sap">
                                <option value="">Semua Skor</option>
                                <option value="Baik" selected="@(ViewBag.CurrentKategori == "Baik" ? "selected" : null)">Baik (&ge; 85%)</option>
                                <option value="Sedang" selected="@(ViewBag.CurrentKategori == "Sedang" ? "selected" : null)">Sedang (70 - 84%)</option>
                                <option value="Kurang" selected="@(ViewBag.CurrentKategori == "Kurang" ? "selected" : null)">Kurang (&lt; 70%)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm" style="height: 44px; border-radius: 10px; background: #ea580c; border: none;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- List of Reports -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 text-white font-weight-bold" style="font-size: 13px;">
                    <i class="bi bi-clock-history me-1 text-warning"></i> Riwayat Inspeksi DCI (@Model.Count())
                </h6>
            </div>

            @if (!Model.Any())
            {
                <div class="card-sap p-5 text-center text-muted">
                    <i class="bi bi-inbox" style="font-size: 40px; color: var(--text-muted);"></i>
                    <p class="mt-2 mb-0" style="font-size: 13px;">Belum ada data inspeksi DCI pada periode ini.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3" style="max-height: 800px; overflow-y: auto; padding-right: 4px;">
                    @foreach (var item in Model)
                    {
                        var badgeBg = item.TotalScore >= 85 ? "rgba(16, 185, 129, 0.15)" : (item.TotalScore >= 70 ? "rgba(245, 158, 11, 0.15)" : "rgba(244, 63, 94, 0.15)");
                        var badgeColor = item.TotalScore >= 85 ? "#10b981" : (item.TotalScore >= 70 ? "#f59e0b" : "#f43f5e");
                        var borderAccent = item.TotalScore >= 85 ? "#10b981" : (item.TotalScore >= 70 ? "#f59e0b" : "#f43f5e");

                        <div class="card-sap p-3 position-relative animate-fade-in" style="border-left: 4px solid @borderAccent;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="mb-0 font-weight-bold text-white">@(item.NamaDump ?? item.Lokasi)</h6>
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.Disposal</span>
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.Shift</span>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size: 11px;">
                                        <i class="bi bi-geo-alt me-1"></i> @item.Area | @item.Lokasi @(!string.IsNullOrEmpty(item.DetilLokasi) ? $"({item.DetilLokasi})" : "")
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge px-2 py-1" style="background: @badgeBg; color: @badgeColor; font-size: 13px; font-weight: 800; border-radius: 8px;">
                                        @item.TotalScore%
                                    </span>
                                    <div style="font-size: 10px; font-weight: 600; color: @badgeColor; margin-top: 2px;">@item.KategoriIndex</div>
                                </div>
                            </div>

                            <!-- Score Pills Summary -->
                            <div class="d-flex flex-wrap gap-1 mb-2 pt-1 border-top border-secondary border-opacity-25" style="font-size: 10.5px;">
                                <span class="badge bg-dark text-muted">Lantai: @item.SkorLantaiDump</span>
                                <span class="badge bg-dark text-muted">Berm: @item.SkorSafetyBerm</span>
                                <span class="badge bg-dark text-muted">Crest: @item.SkorKondisiCrest</span>
                                <span class="badge bg-dark text-muted">Grade: @item.SkorGradeDumping</span>
                                <span class="badge bg-dark text-muted">Drainase: @item.SkorDrainaseDump</span>
                                <span class="badge bg-dark text-muted">Spillage: @item.SkorPenataanSpillage</span>
                                <span class="badge bg-dark text-muted">Rambu: @item.SkorRambuPenerangan</span>
                                <span class="badge bg-dark text-muted">Spotter: @item.SkorSpotterManuver</span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Catatan))
                            {
                                <div class="text-muted mb-2" style="font-size: 11px; font-style: italic;">
                                    <i class="bi bi-chat-left-text me-1"></i> "@item.Catatan"
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                                <div class="text-muted" style="font-size: 11px;">
                                    <i class="bi bi-person me-1"></i> @item.Nama &bull; @item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")
                                </div>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-info py-1 px-2" style="font-size: 11px; border-radius: 6px;" onclick="showDetailDci(@item.Id)" title="Lihat Detail">
                                        <i class="bi bi-eye"></i> Detail
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-success py-1 px-2" style="font-size: 11px; border-radius: 6px;" onclick="shareSavedDci(@item.Id)" title="Share WhatsApp">
                                        <i class="bi bi-whatsapp"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2" style="font-size: 11px; border-radius: 6px;" onclick="editDci(@item.Id)" title="Edit Laporan">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 11px; border-radius: 6px;" onclick="confirmDeleteDci(@item.Id)" title="Hapus Laporan">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Detail Modal -->
<div class="modal fade" id="dciDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 20px;">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle text-warning"></i>
                    <span id="detailModalTitle">Detail Laporan DCI</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailModalBody" style="padding: 24px;">
                <!-- Populated by JS -->
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-sm btn-success" id="btnShareDetailWa">
                    <i class="bi bi-whatsapp me-1"></i> Share WhatsApp
                </button>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tambah Benchmark Baru -->
<div class="modal fade" id="addBenchmarkModal" tabindex="-1" aria-labelledby="addBenchmarkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card, #1e293b); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title fs-6 font-weight-bold text-white" id="addBenchmarkModalLabel">
                    <i class="bi bi-plus-circle me-1 text-warning"></i> Tambah Benchmark Baru
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size: 12px; font-weight: 600;">Area Utama</label>
                    <input type="text" class="form-control form-control-sm text-uppercase" id="newBenchmarkArea" readonly style="background: rgba(0,0,0,0.2);" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size: 12px; font-weight: 600;">Nama Benchmark / Detail Lokasi *</label>
                    <input type="text" class="form-control form-control-sm text-uppercase" id="newBenchmarkName" placeholder="Contoh: RL 50, BM-08, DISPOSAL TIMUR" />
                    <div class="text-danger mt-1" id="addBenchmarkError" style="display:none; font-size:11px;"></div>
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">Benchmark yang Sudah Ada di Area Ini:</label>
                    <div id="existingBenchmarksList" class="list-group list-group-flush border rounded" style="max-height: 140px; overflow-y: auto; background: rgba(0,0,0,0.1);">
                        <!-- Loaded dynamically -->
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnSaveBenchmark" onclick="saveNewBenchmark()" style="background: #ea580c; border: none;">Simpan Benchmark</button>
            </div>
        </div>
    </div>
</div>

