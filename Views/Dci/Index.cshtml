        let text = `*LAPORAN DUMP CONDITION INDEX (DCI)*%0A`;
        text += `*Area:* ${encodeURIComponent(area)}%0A`;
        text += `*Dump/Pad:* ${encodeURIComponent(dump)}%0A`;
        text += `*Tanggal:* ${encodeURIComponent(tanggal)}%0A`;
        text += `*Surveyor:* ${encodeURIComponent(surveyor)}%0A%0A`;
        text += `*Skor Akhir:* *${d.totalScore}%* (${d.kategori})%0A`;
        text += `*Status:* ${encodeURIComponent(d.statusTitle)}%0A%0A`;

        if (d.findings && d.findings.length > 0) {
            text += `*Temuan Parameter:*%0A`;
            d.findings.forEach(f => {
                let clean = f.replace(/<[^>]*>/g, '');
                text += `• ${encodeURIComponent(clean)}%0A`;
            });
            text += `%0A`;
        }

        const rec = $('#tindakanPerbaikan').val().trim();
        if (rec) text += `*Rekomendasi:* ${encodeURIComponent(rec)}%0A`;

        window.open(`https://wa.me/?text=${text}`, '_blank');
    }

