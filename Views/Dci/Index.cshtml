@model IEnumerable<MBS_SAP.Models.DciReport>
@{
    ViewData["Title"] = "Dump Condition Index (DCI) - SAP";
    var userNik = ViewBag.UserNik as string ?? "";
    var userNama = ViewBag.UserNama as string ?? "";
    var userDept = ViewBag.UserDept as string ?? "";
    var userCompany = ViewBag.UserCompany as string ?? "PT INDEXIM COALINDO";
    var areaList = ViewBag.AreaList as List<string> ?? new List<string>();
    var disposalList = ViewBag.DisposalList as List<string> ?? new List<string>();
    var totalReports = ViewBag.TotalReports as int? ?? 0;
    var avgScore = ViewBag.AvgScore as double? ?? 100.0;
    var goodCount = ViewBag.GoodCount as int? ?? 0;
    var fairCount = ViewBag.FairCount as int? ?? 0;
    var poorCount = ViewBag.PoorCount as int? ?? 0;
}

<div class="animate-fade-in">
    <!-- Header Screen Title -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="screen-title d-flex align-items-center gap-2">
                <i class="bi bi-layers-fill" style="color: #f97316;"></i>
                <span>Dump Condition Index (DCI)</span>
                <span class="badge" style="background: linear-gradient(135deg, #ef4444, #f43f5e); color: white; font-size: 10px; font-weight: 800; padding: 2.5px 7px; border-radius: 6px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(244, 63, 94, 0.4); display: inline-flex; align-items: center; gap: 2px;">
                    <i class="bi bi-stars" style="font-size: 9px;"></i> NEW
                </span>
                <span class="badge" style="background: rgba(249, 115, 22, 0.15); color: #ea580c; border: 1px solid rgba(249, 115, 22, 0.3); font-size: 11px; padding: 4px 10px; border-radius: 8px;">Disposal Area</span>
            </div>
            <p class="screen-subtitle mb-0">Inspeksi & Penilaian Standar Kelayakan Area Dumping / Disposal Tambang.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 shadow-sm" style="border-radius: 10px; padding: 8px 14px; font-weight: 600;">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Export Excel</span>
            </a>
        </div>
    </div>

    <!-- Status Feedback Popup Modal (Desktop & Mobile) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="modal fade" id="statusSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 16px auto;">
                <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); border: 2px solid #10b981;">
                        <i class="bi bi-check-lg text-success" style="font-size: 38px;"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2">Berhasil Disimpan!</h4>
                    <p class="text-muted mb-4" style="font-size: 13.5px; line-height: 1.5;">@TempData["SuccessMessage"]</p>
                    <button type="button" class="btn btn-primary w-100 py-2.5 font-weight-bold shadow-sm" style="background: linear-gradient(135deg, #c2410c, #ea580c); border: none; border-radius: 14px;" data-bs-dismiss="modal">
                        <i class="bi bi-check2-circle me-1"></i> Selesai
                    </button>
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="modal fade" id="statusErrorModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 16px auto;">
                <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(244, 63, 94, 0.15); border: 2px solid #f43f5e;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 32px;"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2">Gagal Menyimpan!</h4>
                    <p class="text-muted mb-4" style="font-size: 13.5px; line-height: 1.5;">@TempData["ErrorMessage"]</p>
                    <button type="button" class="btn btn-outline-danger w-100 py-2.5 font-weight-bold shadow-sm" style="border-radius: 14px;" data-bs-dismiss="modal">
                        Tutup &amp; Periksa Kembali
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Client Validation Popup Modal (Desktop & Mobile) -->
    <div class="modal fade" id="clientAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px; margin: 16px auto;">
            <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 22px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(245, 158, 11, 0.15); border: 2px solid #f59e0b;">
                    <i class="bi bi-exclamation-circle-fill" style="color: #f59e0b; font-size: 28px;"></i>
                </div>
                <h5 class="text-white font-weight-bold mb-2" id="clientAlertTitle">Perhatian</h5>
                <p class="text-muted mb-4" id="clientAlertMsg" style="font-size: 13px;"></p>
                <button type="button" class="btn btn-warning w-100 py-2 font-weight-bold shadow-sm" style="border-radius: 12px; color: #000;" data-bs-dismiss="modal">
                    Mengerti &amp; Lengkapi
                </button>
            </div>
        </div>
    </div>

    <!-- Delete Confirm Popup Modal (Desktop & Mobile) -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px; margin: 16px auto;">
            <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 22px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(244, 63, 94, 0.15); border: 2px solid #f43f5e;">
                    <i class="bi bi-trash3-fill text-danger" style="font-size: 28px;"></i>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Hapus Laporan?</h5>
                <p class="text-muted mb-4" style="font-size: 13px;">Data laporan inspeksi ini akan dihapus dari sistem. Tindakan ini tidak dapat dibatalkan.</p>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill py-2" data-bs-dismiss="modal" style="border-radius: 12px;">Batal</button>
                        <button type="submit" class="btn btn-danger flex-fill py-2 font-weight-bold" style="border-radius: 12px;">Ya, Hapus</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Top Summary Metrics Cards (30 Days) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #f97316;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Total Inspeksi</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: var(--text-main);">@totalReports</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(249, 115, 22, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-clipboard-data-fill" style="color: #f97316; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">30 Hari Terakhir</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #3b82f6;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Rata-rata Skor DCI</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: @(avgScore >= 85 ? "#10b981" : (avgScore >= 70 ? "#f59e0b" : "#f43f5e"));">@avgScore%</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(59, 130, 246, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-speedometer2" style="color: #3b82f6; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Target Operasi: &gt;= 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #10b981;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Kondisi Baik</div>
                        <h3 class="mb-0 mt-1 font-weight-bold text-success">@goodCount</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Skor &ge; 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #f43f5e;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Perlu Perbaikan</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: #f43f5e;">@(fairCount + poorCount)</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(244, 63, 94, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Sedang: @fairCount | Kurang: @poorCount</div>
            </div>
        </div>
    </div>

    <!-- Filter & Action Bar -->
    <div class="card-sap p-3 mb-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">PENCARIAN</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Nama, NIK, Dump, Lokasi..." />
                </div>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">DISPOSAL</label>
                <select name="disposal" class="form-select form-select-sm">
                    <option value="">Semua Disposal</option>
                    @foreach (var d in disposalList)
                    {
                        <option value="@d" selected="@(d == ViewBag.CurrentDisposal)">@d</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">KATEGORI</label>
                <select name="kategori" class="form-select form-select-sm">
                    <option value="">Semua Kategori</option>
                    <option value="Baik" selected="@("Baik" == ViewBag.CurrentKategori)">Baik (>=85%)</option>
                    <option value="Sedang" selected="@("Sedang" == ViewBag.CurrentKategori)">Sedang (70-84%)</option>
                    <option value="Kurang" selected="@("Kurang" == ViewBag.CurrentKategori)">Kurang (<70%)</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">PERIODE TANGGAL</label>
                <div class="input-group input-group-sm">
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
                    <span class="input-group-text">-</span>
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
                </div>
            </div>

            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill" style="background: #ea580c; border: none; border-radius: 8px;">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                <button type="button" class="btn btn-sm btn-success flex-fill d-flex align-items-center justify-content-center gap-1" style="background: linear-gradient(135deg, #ea580c, #f97316); border: none; border-radius: 8px; font-weight: 600;" onclick="openInputModal()">
                    <i class="bi bi-plus-lg"></i>
                    <span>Baru</span>
                    <span class="badge" style="background: linear-gradient(135deg, #ef4444, #f43f5e); color: white; font-size: 8.5px; font-weight: 800; padding: 1.5px 4.5px; border-radius: 4px; letter-spacing: 0.5px;">NEW</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Main List Table / Cards -->
    <div class="card-sap p-0 mb-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                <thead style="background: rgba(249, 115, 22, 0.05); border-bottom: 1px solid var(--border-color);">
                    <tr class="text-muted" style="font-size: 11px; font-weight: 700; text-transform: uppercase;">
                        <th class="ps-3 py-3" style="width: 50px;">Foto</th>
                        <th class="py-3">Tanggal &amp; Waktu</th>
                        <th class="py-3">Disposal &amp; Nama Dump</th>
                        <th class="py-3">Lokasi / Area</th>
                        <th class="py-3">Surveyor</th>
                        <th class="py-3 text-center">Skor DCI</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="pe-3 py-3 text-end" style="width: 140px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox d-block mb-2" style="font-size: 32px; color: var(--text-muted);"></i>
                                Belum ada laporan Dump Condition Index (DCI) untuk kriteria ini.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(item.FotoUrl))
                                    {
                                        <div style="width: 44px; height: 44px; border-radius: 8px; overflow: hidden; background: #000; cursor: pointer; border: 1px solid rgba(255,255,255,0.1);" onclick="openDetailModal(@item.Id)">
                                            <img src="@item.FotoUrl" alt="Foto DCI" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/img/placeholder-photo.png'" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="width: 44px; height: 44px; border-radius: 8px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 18px;">
                                            <i class="bi bi-camera"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="font-weight-bold" style="color: var(--text-main);">@item.Tanggal.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@item.Waktu.ToString(@"hh\:mm") | Shift: @(item.Shift ?? "-")</small>
                                </td>
                                <td>
                                    <div class="font-weight-bold" style="color: #ea580c;">@(item.NamaDump ?? item.Disposal ?? "Dump Disposal")</div>
                                    <small class="text-muted"><i class="bi bi-layers me-1"></i>@(item.Disposal ?? "Disposal Area")</small>
                                </td>
                                <td>
                                    <div style="color: var(--text-main);">@item.Lokasi</div>
                                    <small class="text-muted">@item.Area @(!string.IsNullOrEmpty(item.DetilLokasi) ? $"• {item.DetilLokasi}" : "")</small>
                                </td>
                                <td>
                                    <div class="font-weight-bold" style="color: var(--text-main);">@item.Nama</div>
                                    <small class="text-muted">@item.Nik • @(item.Departemen ?? "-")</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge px-2.5 py-1.5" style="font-size: 12px; font-weight: 800; border-radius: 8px; background: @(item.TotalScore >= 85 ? "rgba(16, 185, 129, 0.15)" : (item.TotalScore >= 70 ? "rgba(245, 158, 11, 0.15)" : "rgba(244, 63, 94, 0.15)")); color: @(item.TotalScore >= 85 ? "#10b981" : (item.TotalScore >= 70 ? "#f59e0b" : "#f43f5e")); border: 1px solid @(item.TotalScore >= 85 ? "rgba(16, 185, 129, 0.3)" : (item.TotalScore >= 70 ? "rgba(245, 158, 11, 0.3)" : "rgba(244, 63, 94, 0.3)"));">
                                        @item.TotalScore%
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.KategoriIndex == "Baik")
                                    {
                                        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 6px; font-size: 11px;">Baik</span>
                                    }
                                    else if (item.KategoriIndex == "Sedang")
                                    {
                                        <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 6px; font-size: 11px;">Sedang</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3); border-radius: 6px; font-size: 11px;">Kurang</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-info" title="Lihat Detail" onclick="openDetailModal(@item.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" title="Edit Laporan" onclick="editReport(@item.Id)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" title="Hapus Laporan" onclick="confirmDelete(@item.Id)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Input / Edit Modal -->
<div class="modal fade" id="dciInputModal" tabindex="-1" aria-labelledby="dciInputModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid rgba(249, 115, 22, 0.3); border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 16px 24px;">
                <h5 class="modal-title font-weight-bold d-flex align-items-center gap-2" id="dciInputModalLabel" style="color: var(--text-main);">
                    <i class="bi bi-layers-fill" style="color: #ea580c;"></i>
                    <span id="modalFormTitle">Form Inspeksi Dump Condition Index (DCI)</span>
                    <span class="badge" id="modalNewBadge" style="background: linear-gradient(135deg, #ef4444, #f43f5e); color: white; font-size: 9.5px; font-weight: 800; padding: 2.5px 7px; border-radius: 6px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(244, 63, 94, 0.4); display: inline-flex; align-items: center; gap: 2px;">
                        <i class="bi bi-stars" style="font-size: 9px;"></i> NEW
                    </span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <form id="dciForm" method="post" asp-action="Submit" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="reportId" name="id" value="" />

                    <!-- Section 1: Data Lokasi & Waktu -->
                    <div class="mb-4">
                        <div class="text-muted font-weight-bold mb-3" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="bi bi-geo-alt-fill text-warning me-1"></i> 1. Informasi Umum &amp; Lokasi
                        </div>
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">TANGGAL *</label>
                                <input type="date" id="inputTanggal" name="tanggal" class="form-control form-control-sm" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">WAKTU *</label>
                                <input type="time" id="inputWaktu" name="waktuStr" class="form-control form-control-sm" required value="@DateTime.Now.ToString("HH:mm")" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">SHIFT</label>
                                <select id="inputShift" name="shift" class="form-select form-select-sm">
                                    <option value="Day">Day Shift</option>
                                    <option value="Night">Night Shift</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted" style="font-size: 11px; font-weight: 600;">AREA *</label>
                                <select id="inputArea" name="area" class="form-select form-select-sm" required>
                                    <option value="">Pilih Area...</option>
                                    @foreach (var a in areaList)
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
