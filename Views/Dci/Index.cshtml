                            <p class="mb-1 text-muted" style="font-size:12px;">Tanggal: <span class="text-white">${data.tanggal} ${data.waktu}</span></p>
                            <p class="mb-1 text-muted" style="font-size:12px;">Disposal: <span class="text-white font-weight-bold">${data.disposal || '-'}</span></p>
                            <p class="mb-1 text-muted" style="font-size:12px;">Nama Dump: <span class="text-white">${data.namaDump || '-'}</span></p>
                            <p class="mb-1 text-muted" style="font-size:12px;">Lokasi / Area: <span class="text-white">${data.lokasi} (${data.area})</span></p>
                            <p class="mb-1 text-muted" style="font-size:12px;">Shift: <span class="text-white">${data.shift || '-'}</span></p>
                            <p class="mb-1 text-muted" style="font-size:12px;">Surveyor: <span class="text-white">${data.nama} (${data.nik})</span></p>
                            <p class="mb-1 text-muted" style="font-size:12px;">Perusahaan: <span class="text-white">${data.perusahaan || '-'}</span></p>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card p-3 bg-dark border-0 mb-3 text-center">
                            <div class="text-muted" style="font-size:11px; text-transform:uppercase;">Skor Dump Condition Index</div>
                            <h2 class="mb-1 mt-1 font-weight-bold" style="color: ${data.totalScore >= 85 ? '#10b981' : (data.totalScore >= 70 ? '#f59e0b' : '#f43f5e')};">${data.totalScore}%</h2>
                            <div><span class="${katBadge}">${data.kategoriIndex}</span></div>
                        </div>
                        <div class="card p-3 bg-dark border-0">
                            <h6 class="text-white font-weight-bold mb-2">Rincian 8 Parameter</h6>
                            <div style="font-size:11.5px;">
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>1. Lantai Dump (15%):</span> <strong>${data.skorLantaiDump}/100</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>2. Safety Berm (15%):</span> <strong>${data.skorSafetyBerm}/100</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>3. Kondisi Crest (15%):</span> <strong>${data.skorKondisiCrest}/100</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>4. Grade Dumping (15%):</span> <strong>${data.skorGradeDumping}/100</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>5. Drainase Dump (10%):</span> <strong>${data.skorDrainaseDump}/100</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>6. Penataan Spillage (10%):</span> <strong>${data.skorPenataanSpillage}/100</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>7. Rambu &amp; Lampu (10%):</span> <strong>${data.skorRambuPenerangan}/100</strong></div>
                                <div class="d-flex justify-content-between py-1"><span>8. Spotter &amp; Manuver (10%):</span> <strong>${data.skorSpotterManuver}/100</strong></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card p-3 bg-dark border-0">
                            <h6 class="text-white font-weight-bold mb-1">Catatan &amp; Rekomendasi</h6>
                            <p class="mb-1 text-muted" style="font-size:12px;">Catatan: <span class="text-white">${data.catatan || '-'}</span></p>
                            <p class="mb-1 text-muted" style="font-size:12px;">Rekomendasi: <span class="text-white">${data.tindakanPerbaikan || '-'}</span></p>
                            <p class="mb-0 text-muted" style="font-size:12px;">PIC: <span class="text-white">${data.pic || '-'}</span></p>
                        </div>
                    </div>
                </div>
            `;

            $('#detailModalBody').html(html);
            new bootstrap.Modal(document.getElementById('dciDetailModal')).show();
        });
    }

    $('#btnShareDetailWa').on('click', function() {
        if (!currentDetailData) return;
        shareSavedDci(currentDetailData.id);
    });

    function confirmDeleteDci(id) {
        $('#deleteForm').attr('action', '/Dci/Delete/' + id);
        new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
    }
</script>
}
