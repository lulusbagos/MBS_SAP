        <!-- Leaderboard Chart -->
        <div class="row mb-4 animate-fade-in">
            <div class="col-12">
                <div class="premium-card">
                    <div class="premium-header">
                        <i class="bi bi-bar-chart-line-fill text-info" style="font-size: 16px; color: #38bdf8 !important;"></i>
                        <h6 class="premium-title">Grafik Perbandingan Kepatuhan Perusahaan (%)</h6>
                    </div>
                    <div class="premium-body">
