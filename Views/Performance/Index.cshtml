                                Total Indikator Piramida: <span style="font-weight: 900; font-size: 14px;">@totalAccidentPyramid</span>
                            </div>

                            <div class="table-responsive mt-3" style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; background: #ffffff;">
                                <table class="table table-sm align-middle text-start mb-0" style="color: #0f172a; font-size: 12px; border-collapse: collapse;">
                                    <thead style="background: #f1f5f9; font-weight: 700; color: #475569;">
                                        <tr>
                                            <th class="ps-3 py-2" style="border-bottom: 1.5px solid #cbd5e1;">Kategori Insiden</th>
                                            <th class="text-center py-2" style="border-bottom: 1.5px solid #cbd5e1;">Jumlah</th>
                                            <th class="text-end pe-3 py-2" style="border-bottom: 1.5px solid #cbd5e1;">Komposisi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            double pNearMiss = totalAccidentPyramid > 0 ? (double)ViewBag.IncidentNearMiss / totalAccidentPyramid * 100.0 : 0.0;
                                            double pPropertyDamage = totalAccidentPyramid > 0 ? (double)ViewBag.IncidentPropertyDamage / totalAccidentPyramid * 100.0 : 0.0;
                                            double pFirstAid = totalAccidentPyramid > 0 ? (double)ViewBag.IncidentFirstAidInjury / totalAccidentPyramid * 100.0 : 0.0;
                                            double pMedical = totalAccidentPyramid > 0 ? (double)ViewBag.IncidentMedicalTreatmentInjury / totalAccidentPyramid * 100.0 : 0.0;
                                            double pKebakaran = totalAccidentPyramid > 0 ? (double)ViewBag.IncidentKebakaran / totalAccidentPyramid * 100.0 : 0.0;
                                            double pFatality = totalAccidentPyramid > 0 ? (double)ViewBag.IncidentFatality / totalAccidentPyramid * 100.0 : 0.0;
                                        }
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td class="ps-3 py-2" style="font-weight: 600;">Near Miss</td>
                                            <td class="text-center py-2" style="font-weight: 600;">@ViewBag.IncidentNearMiss</td>
                                            <td class="text-end pe-3 py-2" style="font-family: monospace; font-weight: 600;">@Math.Round(pNearMiss, 1)%</td>
