        position: relative;
        min-width: 820px;
        width: 100%;
    }
    .org-secondary-block::after {
        content: "Maincon Non Utama";
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #94a3b8;
        background: #f0f4f8;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 3px 12px;
        white-space: nowrap;
    }
    .org-chart-tree ul.org-secondary-maincon-row {
        display: grid;
        grid-template-columns: repeat(5, minmax(145px, 1fr));
        gap: 10px;
        padding-top: 2px;
        min-width: 820px;
        align-items: start;
    }
    .org-chart-tree ul.org-secondary-maincon-row::before {
        display: none;
    }
    .org-chart-tree ul.org-secondary-maincon-row > li.org-secondary-branch {
        width: 100%;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    /* Maincon row: primary branch + right-side secondary 5x5 grid */
    .org-maincon-combined-row {
        gap: var(--oc-gap-h);
        align-items: flex-start;
    }
    .org-maincon-separator {
        width: 3px;
        min-height: 108px;
        background: linear-gradient(180deg, transparent, #cbd5e1 25%, #cbd5e1 75%, transparent);
        align-self: stretch;
        flex-shrink: 0;
        border-radius: 999px;
        padding: 0 !important;
        margin: 0 4px;
    }
    .org-maincon-separator::before,
    .org-maincon-separator::after {
        display: none !important;
    }
    .org-secondary-maincon-cell {
        min-width: 820px;
        width: 820px;
        padding: 0 !important;
        position: relative;
    }
    .org-secondary-maincon-cell::before,
    .org-secondary-maincon-cell::after {
        display: none !important;
    }
    .org-secondary-maincon-cell > .org-secondary-caption {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 8px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.45px;
        text-transform: uppercase;
        color: #64748b;
        background: #e2e8f0;
        border-radius: 999px;
        padding: 4px 10px;
    }
    .org-chart-tree ul.org-secondary-maincon-row {
        margin: 0;
        padding-top: 8px;
        display: grid;
        grid-template-columns: repeat(5, minmax(145px, 1fr));
        grid-auto-rows: minmax(90px, auto);
        gap: 10px;
        min-width: 820px;
    }
    .org-chart-tree ul.org-secondary-maincon-row > li {
        width: 100%;
        padding: 0;
    }
    .org-chart-tree ul.org-secondary-maincon-row > li.org-secondary-branch::before,
    .org-chart-tree ul.org-secondary-maincon-row > li.org-secondary-branch::after {
        display: none;
    }
    .org-chart-tree ul.org-secondary-maincon-row > li::before,
    .org-chart-tree ul.org-secondary-maincon-row > li::after {
        display: none;
    }
    .org-chart-tree ul.org-secondary-maincon-row > li.org-secondary-branch > .org-node-card {
        width: 100%;
    }
    .org-secondary-branch-subcons {
        width: 100%;
        margin-top: 10px;
        padding-top: 12px;
        display: grid;
        gap: 8px;
        position: relative;
    }
    .org-secondary-branch-subcons::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
        height: 12px;
        border-left: var(--oc-line-w) solid var(--oc-line);
    }
    .org-secondary-branch-subcons > li {
        width: 100%;
        padding: 0;
    }
    .org-secondary-branch-subcons > li::before,
    .org-secondary-branch-subcons > li::after {
        display: none;
    }
    .org-secondary-branch-subcons > li > .org-node-card {
        width: 100%;
    }
    .org-chart-tree ul.org-subcon-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(150px, 1fr));
        gap: 10px;
        min-width: 820px;
        padding-top: 22px;
        align-items: start;
        justify-content: stretch;
    }
    .org-chart-tree ul.org-subcon-grid::before {
        display: none;
    }
    .org-chart-tree ul.org-subcon-grid > li {
        width: 100%;
        padding: 0;
    }
    .org-chart-tree ul.org-subcon-grid > li::before,
    .org-chart-tree ul.org-subcon-grid > li::after {
        display: none;
    }
    .org-chart-tree ul.org-subcon-grid > li > .org-node-card {
        width: 100%;
        min-height: 74px;
        border-radius: var(--oc-radius);
        box-shadow: 0 1px 4px rgba(15,23,42,0.07);
    }
    .org-chart-tree ul.org-subcon-grid > li > .org-node-card .org-node-card-inner {
        padding: 7px 8px 8px;
    }
    .org-chart-tree ul.org-subcon-grid > li > .org-node-card .org-avatar {
        width: 26px;
        height: 26px;
        font-size: 13px;
        border-radius: 6px;
    }
    .org-chart-tree ul.org-subcon-grid > li > .org-node-card .org-node-title {
        font-size: 10px;
    }
    .org-chart-tree ul.org-subcon-grid > li > .org-node-card .org-node-meta {
        font-size: 9px;
        line-height: 1.2;
    }
    .org-chart-tree ul.org-subcon-grid > li > .org-node-card .org-node-tag,
    .org-chart-tree ul.org-subcon-grid > li > .org-node-card .org-level-pill {
        font-size: 8px;
    }
    .org-chart-tree ul.org-subcon-grid > li.has-children > .org-node-card::after {
        display: none;
    }
    .org-chart-tree li {
        position: relative;
        padding: 0 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .org-node {
        --ach-rate: 0;
    }
    .org-chart-tree li::before,
    .org-chart-tree li::after {
        content: "";
        position: absolute;
        top: 0;
        width: 50%;
        height: 18px;
        border-top: var(--oc-line-w) solid var(--oc-line);
    }
    .org-chart-tree li::before {
        right: 50%;
        border-right: var(--oc-line-w) solid var(--oc-line);
        border-radius: 0 0 0 0;
    }
    .org-chart-tree li::after {
        left: 50%;
        border-left: var(--oc-line-w) solid var(--oc-line);
    }
    .org-chart-tree li:only-child::before,
    .org-chart-tree li:only-child::after {
        display: none;
    }
    .org-chart-tree li:only-child {
        padding-top: 0;
    }
    .org-chart-tree li:first-child::before,
    .org-chart-tree li:last-child::after {
        border: 0;
    }
    .org-chart-tree li:last-child::before {
        border-right: 0;
        border-radius: 0 8px 0 0;
    }
    .org-chart-tree li:first-child::after {
        border-radius: 8px 0 0 0;
    }
    .org-chart-tree ul::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: var(--oc-conn-v);
        border-left: var(--oc-line-w) solid var(--oc-line);
    }
    .org-node-card {
        width: 228px;
        min-height: 108px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: var(--oc-radius);
        box-shadow: 0 2px 8px rgba(15,23,42,0.08), 0 1px 2px rgba(15,23,42,0.04);
        padding: 0;
        display: flex;
        flex-direction: column;
        position: relative;
        text-align: left;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        overflow: hidden;
    }
    .org-node-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(15,23,42,0.12), 0 2px 4px rgba(15,23,42,0.06);
    }
    /* Top accent bar */
    .org-node-card::before {
        content: "";
        display: block;
        height: 4px;
        width: 100%;
        background: #94a3b8;
        border-radius: var(--oc-radius) var(--oc-radius) 0 0;
        flex-shrink: 0;
    }
    .org-node-card-inner {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 12px 12px;
        flex: 1;
    }
    .org-node.has-children > .org-node-card::after {
        content: "";
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        top: calc(100% + 1px);
        height: 14px;
        border-left: var(--oc-line-w) solid var(--oc-line);
    }
    .org-node[data-level="0"] > .org-node-card {
        width: 264px;
    }
    .org-node[data-level="1"] > .org-node-card {
        width: 240px;
    }
    .org-node[data-level="2"] > .org-node-card {
        width: 224px;
    }
    .org-node[data-level="3"] > .org-node-card,
    .org-node[data-level="4"] > .org-node-card,
    .org-node[data-level="5"] > .org-node-card {
        width: 208px;
        min-height: 102px;
    }
    .org-chart-tree ul.org-children-compact > .org-node > .org-node-card {
        width: 198px;
        min-height: 98px;
    }
    .org-chart-tree ul.org-children-dense > .org-node > .org-node-card {
        width: 184px;
        min-height: 94px;
    }
    .org-avatar {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        border: 1px solid #e2e8f0;
    }
    .org-chart-tree ul.org-children-dense > .org-node > .org-node-card .org-avatar {
        width: 26px;
        height: 26px;
        font-size: 13px;
        border-radius: 6px;
    }
    .org-node-text { flex: 1; min-width: 0; }
    .org-node-title {
        font-size: 12px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.35;
        word-break: break-word;
    }
    .org-chart-tree ul.org-children-dense > .org-node > .org-node-card .org-node-title {
        font-size: 10px;
    }
    .org-node-meta {
        font-size: 10px;
        color: #64748b;
        line-height: 1.4;
        margin-top: 3px;
    }
    .org-chart-tree ul.org-children-dense > .org-node > .org-node-card .org-node-meta {
        font-size: 9px;
        line-height: 1.3;
    }
    .org-node-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 5px;
    }
    .org-node-tag {
        display: inline-flex;
        align-items: center;
        font-size: 10px;
        font-weight: 700;
        color: #0369a1;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        border-radius: 6px;
        padding: 2px 6px;
    }
    .org-node-menu-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 24px;
        height: 24px;
        border-radius: 6px;
        border: 1px solid #dbeafe;
        background: #f8fafc;
        color: #334155;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 2;
    }
    .org-node-menu-btn:hover {
        background: #e0f2fe;
        color: #0369a1;
        border-color: #93c5fd;
    }
    /* Achievement color scale: 0% merah -> 100% hijau */
    .org-node .org-node-tag {
        --ach-hue: calc(var(--ach-rate) * 1.2);
        color: hsl(var(--ach-hue), 72%, 24%);
        background: hsl(var(--ach-hue), 85%, 92%);
        border-color: hsl(var(--ach-hue), 70%, 72%);
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    }
    .org-node[style*="--ach-rate:0"] .org-node-tag,
    .org-node[style*="--ach-rate:0;"] .org-node-tag {
        color: #b91c1c;
        background: #fee2e2;
        border-color: #fca5a5;
    }
    .org-level-pill {
        display: inline-flex;
        align-items: center;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        border-radius: 6px;
        padding: 2px 6px;
        border: 1px solid #e2e8f0;
        color: #475569;
        background: #f8fafc;
    }
    /* ── Tier accent bars ── */
    .org-node[data-tier="owner"] > .org-node-card::before  { background: var(--oc-owner-bar); }
    .org-node[data-tier="maincon"] > .org-node-card::before { background: var(--oc-main-bar);  }
    .org-node[data-tier="subcon"] > .org-node-card::before  { background: var(--oc-sub-bar);   }
    .org-node[data-tier="vendor"] > .org-node-card::before  { background: var(--oc-vend-bar);  }
    /* ── Tier borders & backgrounds ── */
    .org-node[data-tier="owner"] > .org-node-card  { border-color: #c7d7fc; }
    .org-node[data-tier="maincon"] > .org-node-card { border-color: #bae6fd; }
    .org-node[data-tier="subcon"] > .org-node-card  { border-color: #99f6e4; }
    .org-node[data-tier="vendor"] > .org-node-card  { border-color: #fed7aa; }
    /* ── Tier level pills ── */
    .org-node[data-tier="owner"] .org-level-pill {
        color: #1e40af; background: #dbeafe; border-color: #93c5fd;
    }
    .org-node[data-tier="maincon"] .org-level-pill {
        color: #0c4a6e; background: #e0f2fe; border-color: #7dd3fc;
    }
    .org-node[data-tier="subcon"] .org-level-pill {
        color: #065f46; background: #d1fae5; border-color: #6ee7b7;
    }
    .org-node[data-tier="vendor"] .org-level-pill {
        color: #7c2d12; background: #fef3c7; border-color: #fcd34d;
    }
    /* ── Primary maincon: bolder accent ── */
    .org-node[data-maincon-group="primary"] > .org-node-card {
        border-color: #7dd3fc;
        box-shadow: 0 4px 16px rgba(14,165,233,0.15), 0 1px 3px rgba(14,165,233,0.1);
    }
    .org-node[data-maincon-group="primary"] .org-level-pill {
        color: #0c4a6e; background: #bae6fd; border-color: #38bdf8;
    }
    /* ── Secondary maincon: neutral ── */
    .org-node[data-maincon-group="secondary"] > .org-node-card {
        border-color: #e2e8f0;
    }
    .org-node[data-maincon-group="secondary"] .org-level-pill {
        color: #475569; background: #f1f5f9; border-color: #cbd5e1;
    }
    .org-node.org-node-matrix > .org-node-card {
        width: 100%;
        min-height: 74px;
        border-radius: var(--oc-radius);
        box-shadow: 0 1px 4px rgba(15,23,42,0.07);
    }
    .org-node.org-node-matrix > .org-node-card .org-node-card-inner {
        padding: 7px 8px 8px;
    }
    .org-node.org-node-matrix > .org-node-card .org-avatar {
        width: 26px;
        height: 26px;
        font-size: 13px;
        border-radius: 6px;
    }
    .org-node.org-node-matrix > .org-node-card .org-node-title {
        font-size: 10px;
    }
    .org-node.org-node-matrix > .org-node-card .org-node-meta {
        font-size: 9px;
        line-height: 1.2;
    }
    .org-node.org-node-matrix > .org-node-card .org-level-pill,
    .org-node.org-node-matrix > .org-node-card .org-node-tag {
        font-size: 8px;
    }
    .org-chart-tree ul.org-children-dense > .org-node > .org-node-card .org-node-tag {
        font-size: 8px;
        padding: 1px 5px;
    }
    /* ── Level 0 (OWNER) extra prominence ── */
    .org-node[data-level="0"] > .org-node-card {
        box-shadow: 0 6px 24px rgba(30,64,175,0.15), 0 2px 6px rgba(30,64,175,0.08);
    }
    .org-node[data-level="0"] > .org-node-card::before {
        height: 5px;
    }
    /* ── Primary maincon prominence ── */
    .org-node[data-maincon-group="primary"][data-level="1"] > .org-node-card::before {
        height: 5px;
    }
    .hierarchy-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }
    .hierarchy-toggle-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    .hierarchy-mode-btn {
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.3px;
        color: #475569;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .hierarchy-mode-btn:hover {
        border-color: #7dd3fc;
        color: #0284c7;
        background: #f0f9ff;
    }
    .hierarchy-mode-btn.is-active {
        border-color: #0284c7;
        background: linear-gradient(135deg,#0369a1,#0ea5e9);
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(14,165,233,0.3);
    }
    .hierarchy-search {
        flex: 1 1 280px;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        background: var(--bg-card);
        color: var(--text-main);
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
    }
    .hierarchy-search:focus {
        outline: none;
        border-color: #38bdf8;
        box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
    }
    .hierarchy-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }
    .hierarchy-lead {
        font-size: 12px;
        color: #cbd5e1;
        margin-bottom: 8px;
    }
    .hierarchy-source {
        font-size: 11px;
        color: #94a3b8;
        margin-bottom: 12px;
    }
    .hierarchy-hint {
        font-size: 10px;
        color: #64748b;
        margin-top: 6px;
        margin-bottom: 0;
    }
    .hierarchy-empty {
        border: 1px dashed #334155;
        background: rgba(15, 23, 42, 0.45);
        color: #cbd5e1;
        border-radius: 10px;
    }
    body.light-theme .hierarchy-lead {
        color: #334155;
    }
    body.light-theme .hierarchy-source {
        color: #475569;
    }
    body.light-theme .hierarchy-hint {
        color: #64748b;
    }
    body.light-theme .hierarchy-empty {
        border-color: #cbd5e1;
        background: #ffffff;
        color: #334155;
    }
    .hierarchy-summary-chip {
        border: 1px solid var(--border-color);
        background: rgba(56, 189, 248, 0.08);
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-main);
    }
    .hierarchy-level-guide {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 6px 0 14px;
    }
    .hierarchy-level-guide span {
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        padding: 4px 10px;
        color: #475569;
        background: #ffffff;
    }
    .hierarchy-level-guide .role-owner        { border-color: #93c5fd; background: #dbeafe; color: #1e40af; }
    .hierarchy-level-guide .role-maincon      { border-color: #7dd3fc; background: #e0f2fe; color: #0c4a6e; }
    .hierarchy-level-guide .role-maincon-primary { border-color: #38bdf8; background: #bae6fd; color: #0c4a6e; font-weight: 800; }
    .hierarchy-level-guide .role-subcon       { border-color: #6ee7b7; background: #d1fae5; color: #065f46; }
    .hierarchy-level-guide .role-vendor       { border-color: #fcd34d; background: #fef3c7; color: #7c2d12; }
    .org-node-hidden {
        display: none !important;
    }

    @@media (max-width: 767.98px) {
        .hierarchy-toolbar {
            flex-direction: column;
            align-items: stretch;
        }
        .hierarchy-toggle-group {
            width: 100%;
        }
        .hierarchy-mode-btn {
            flex: 1 1 calc(50% - 3px);
            text-align: center;
        }
        .org-chart-wrapper {
            max-height: 68vh;
            padding: 8px;
            background-size: 14px 14px;
        }
        .org-chart-tree ul {
            gap: 10px;
            padding-top: 22px;
        }
        .org-chart-tree ul.org-secondary-matrix {
            grid-template-columns: repeat(3, minmax(140px, 1fr));
            min-width: 540px;
            padding-top: 28px;
        }
        .org-secondary-block {
            margin-top: 10px;
            padding-top: 14px;
            min-width: 540px;
        }
        .org-secondary-block::after {
            font-size: 9px;
            top: 2px;
            padding: 1px 7px;
        }
        .org-chart-tree ul.org-secondary-maincon-row {
            grid-template-columns: repeat(3, minmax(140px, 1fr));
            min-width: 540px;
        }
        .org-secondary-branch-subcons {
            margin-top: 8px;
            padding-top: 10px;
            gap: 6px;
        }
        .org-secondary-branch-subcons::before {
            height: 10px;
        }
        .org-chart-tree ul.org-subcon-grid {
            grid-template-columns: repeat(3, minmax(140px, 1fr));
            min-width: 540px;
            padding-top: 18px;
        }
        .org-chart-tree ul::before {
            height: 22px;
        }
        .org-chart-tree li {
            padding: 0 3px;
        }
        .org-chart-tree li::before,
        .org-chart-tree li::after {
            height: 12px;
        }
        .org-node.has-children > .org-node-card::after {
            height: 10px;
        }
        .org-node-card {
            width: 186px;
