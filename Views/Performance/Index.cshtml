                    </div>
                </div>
            </div>

            <!-- Safety Pyramid Block -->
            <div class="col-12 col-md-6">
                <div class="premium-card">
                    <div class="premium-header">
                        <i class="bi bi-triangle-half text-warning" style="font-size: 16px; color: #fbbf24 !important;"></i>
