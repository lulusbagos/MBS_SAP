        .org-chart-tree ul.org-subcon-grid > li > .org-node-card {
            width: 100%;
        }
        .org-chart-tree ul.org-children-compact > .org-node > .org-node-card,
        .org-chart-tree ul.org-children-dense > .org-node > .org-node-card {
            width: 170px;
        }
    }
    .dept-achievement-modal {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1100;
        padding: 8px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease-out;
    }
    .dept-achievement-modal.show {
        opacity: 1;
        pointer-events: auto;
    }
    .dept-achievement-backdrop {
