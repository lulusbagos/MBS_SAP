    .dept-achievement-modal {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1100;
        padding: 8px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease-out;
    }
    .dept-achievement-modal.show {
        opacity: 1;
        pointer-events: auto;
    }
    .dept-achievement-backdrop {
