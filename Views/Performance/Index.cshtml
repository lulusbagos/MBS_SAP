        background: #ffffff;
        box-shadow: 0 20px 50px rgba(2, 6, 23, 0.3);
        z-index: 1;
        transform: scale(0.96);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
