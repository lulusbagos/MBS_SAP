                            @{
                                int totalAccidentPyramid = ViewBag.IncidentNearMiss + ViewBag.IncidentPropertyDamage + ViewBag.IncidentFirstAidInjury + ViewBag.IncidentMedicalTreatmentInjury + ViewBag.IncidentKebakaran + ViewBag.IncidentFatality;
