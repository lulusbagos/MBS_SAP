                        <h6 class="premium-title">@(ViewBag.IsAdmin == true ? "Leaderboard Kepatuhan Perusahaan (Tahun Ini)" : "Pencapaian Kepatuhan Perusahaan (Tahun Ini)")</h6>
                    </div>
                    <div class="premium-body">
