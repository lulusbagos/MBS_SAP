    /* ═══════════════════════════════════════════════════
       ORG CHART – PREMIUM REDESIGN
       Design tokens defined on .org-chart-wrapper root
    ═══════════════════════════════════════════════════ */
    .org-chart-wrapper {
        /* tokens */
        --oc-line:         #64748b;
        --oc-line-w:       2.8px;
        --oc-radius:       12px;
        --oc-gap-h:        28px;
        --oc-conn-v:       28px;
        /* colours per tier */
        --oc-owner-border: #1e40af;
        --oc-owner-bar:    linear-gradient(135deg,#1e40af,#2563eb);
        --oc-owner-bg:     #ffffff;
        --oc-main-border:  #0284c7;
        --oc-main-bar:     linear-gradient(135deg,#0369a1,#0ea5e9);
        --oc-main-bg:      #ffffff;
        --oc-sub-border:   #0d9488;
        --oc-sub-bar:      linear-gradient(135deg,#0f766e,#14b8a6);
        --oc-sub-bg:       #ffffff;
        --oc-vend-border:  #b45309;
        --oc-vend-bar:     linear-gradient(135deg,#b45309,#f59e0b);
        --oc-vend-bg:      #ffffff;
        /* layout */
        overflow: auto;
        max-height: min(74vh, 940px);
        padding: 24px 20px 20px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background-color: #f0f4f8;
        background-image:
            radial-gradient(circle, #cbd5e1 1px, transparent 1px);
        background-size: 22px 22px;
        scroll-behavior: smooth;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.04);
    }
    .org-chart-tree,
    .org-chart-tree ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .org-chart-tree {
        text-align: center;
        min-width: max-content;
        padding: 4px 8px 8px;
        zoom: var(--org-zoom, 1);
    }
    .org-chart-tree ul {
        position: relative;
        padding-top: var(--oc-conn-v);
        display: flex;
        justify-content: center;
        gap: var(--oc-gap-h);
    }
    .org-chart-tree ul.org-children-compact {
        gap: 16px;
    }
    .org-chart-tree ul.org-children-dense {
        gap: 10px;
        padding-top: 20px;
    }
    .org-chart-tree ul.org-children-dense::before {
        height: 20px;
    }
    .org-chart-tree ul.org-secondary-matrix {
        display: grid;
        grid-template-columns: repeat(5, minmax(145px, 1fr));
        gap: 10px;
        padding-top: 34px;
        justify-content: stretch;
        min-width: 820px;
    }
    .org-chart-tree ul.org-secondary-matrix::before {
        display: none;
    }
    .org-chart-tree ul.org-secondary-matrix > li {
        width: 100%;
        padding: 0;
    }
    .org-chart-tree ul.org-secondary-matrix > li::before,
    .org-chart-tree ul.org-secondary-matrix > li::after {
        display: none;
    }
    .org-chart-outer {
        position: relative;
    }
    .org-scroll-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
        gap: 8px;
    }
    .org-scroll-btn {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        background: #ffffff;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.15s ease;
        box-shadow: 0 1px 4px rgba(15,23,42,0.07);
