                    <div style="font-size: 22px; font-weight: 900; color: @(isMyWeekCompliant ? "#10b981" : "#ef4444");">
                        @(isMyWeekCompliant ? "PATUH (OK)" : "BELUM PATUH")
                    </div>
                    <div class="text-muted mt-1" style="font-size: 11px;">Aktual: @ViewBag.MyTotalWeek / Target: Minimal @myWeeklyTarget aktivitas</div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="kpi-card">
                    <i class="bi bi-award-fill kpi-icon-bg"></i>
                    <div class="text-muted mb-1" style="font-size: 11px; font-weight: 700; text-transform: uppercase;">Pencapaian Bulan Ini</div>
                    <div style="font-size: 28px; font-weight: 900; color: #f59e0b;">@ViewBag.MyTotalMonth <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);">/ @myTotalMonthTarget Target</span></div>
                    <div class="mt-2">
                        <div class="progress-achievement">
                            <div class="progress-bar bg-warning" style="width: @(myMonthlyProgress)%; height: 100%;"></div>
                        </div>
                        <span class="text-muted" style="font-size: 10px;">Progress: @Math.Round(myMonthlyProgress)%</span>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="kpi-card">
                    <i class="bi bi-exclamation-triangle-fill kpi-icon-bg"></i>
                    <div class="text-muted mb-1" style="font-size: 11px; font-weight: 700; text-transform: uppercase;">Hazard Dilaporkan</div>
                    <div style="font-size: 28px; font-weight: 900; color: #f43f5e;">@ViewBag.MyHazardsMonth</div>
                    <div class="text-muted" style="font-size: 11px;">Bahaya yang Anda temukan (Bulan Ini)</div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="kpi-card">
                    <i class="bi bi-shield-fill-check kpi-icon-bg"></i>
                    <div class="text-muted mb-1" style="font-size: 11px; font-weight: 700; text-transform: uppercase;">Lainnya (Bulan Ini)</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-main); line-height: 1.6;">
                        📋 Inspeksi: <strong>@ViewBag.MyInspectionsMonth</strong> <br />
                        📢 Safety Talk: <strong>@ViewBag.MySafetyTalksMonth</strong> <br />
                        👥 P5M: <strong>@ViewBag.MyP5msMonth</strong> <br />
                        👁️ Observasi: <strong>@ViewBag.MyObservationsMonth</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- My Activity Distribution -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <div class="chart-container">
                    <h6 class="mb-3" style="font-weight: 700;">Proporsi Laporan Saya (Bulan Ini)</h6>
                    <div style="height: 250px; display: flex; align-items: center; justify-content: center;">
                        <canvas id="myProporsiChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="chart-container">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0" style="font-weight: 700;">Target Kepatuhan Detail Saya</h6>
                        @if (ViewBag.KategoriPengawas != null && !string.IsNullOrWhiteSpace(ViewBag.KategoriPengawas.ToString()))
                        {
                            <span class="badge shadow-sm" style="background-color: rgba(56, 189, 248, 0.12); color: #38bdf8; font-size: 10.5px; font-weight: 700; border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 8px;">
                                <i class="bi bi-shield-shaded me-1"></i> @ViewBag.KategoriPengawas
                            </span>
                        }
                    </div>
                    @if (ViewBag.KaryawanIdMitra != null)
                    {
                        <div class="mb-3" style="font-size: 11px; color: var(--text-muted); background: rgba(0,0,0,0.02); padding: 8px; border-radius: 6px; border: 1px dashed rgba(0,0,0,0.1);">
                            <strong>Detail Mitra (Debug):</strong> @ViewBag.NamaMitra (ID Karyawan: @ViewBag.KaryawanIdMitra)
                        </div>
                    }
                    <div class="d-flex flex-column gap-3 mt-3">
                        <div>
                            <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 700;">
                                <span>Hazard Report</span>
                                <span>Actual : @ViewBag.MyHazardsMonth | Target : @ViewBag.TargetHazardReport</span>
                            </div>
                            <div class="progress-achievement" style="height: 10px;">
                                @{
                                    double targetHazardDouble = (double)(ViewBag.TargetHazardReport ?? 2);
                                    double percentHazard = targetHazardDouble > 0 ? Math.Min((double)ViewBag.MyHazardsMonth / targetHazardDouble * 100.0, 100.0) : 0.0;
                                }
                                <div class="progress-bar bg-danger" style="width: @(percentHazard)%;"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 700;">
                                <span>Safety Inspection</span>
                                <span>Actual : @ViewBag.MyInspectionsMonth | Target : @ViewBag.TargetInspeksi</span>
                            </div>
                            <div class="progress-achievement" style="height: 10px;">
                                @{
                                    double targetInspeksiDouble = (double)(ViewBag.TargetInspeksi ?? 1);
                                    double percentInspeksi = targetInspeksiDouble > 0 ? Math.Min((double)ViewBag.MyInspectionsMonth / targetInspeksiDouble * 100.0, 100.0) : 0.0;
                                }
                                <div class="progress-bar bg-primary" style="width: @(percentInspeksi)%;"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 700;">
                                <span>Safety Talk</span>
                                <span>Actual : @ViewBag.MySafetyTalksMonth | Target : @ViewBag.TargetSafetyTalk</span>
                            </div>
                            <div class="progress-achievement" style="height: 10px;">
                                @{
                                    double targetSafetyTalkDouble = (double)(ViewBag.TargetSafetyTalk ?? 1);
                                    double percentSafetyTalk = targetSafetyTalkDouble > 0 ? Math.Min((double)ViewBag.MySafetyTalksMonth / targetSafetyTalkDouble * 100.0, 100.0) : 0.0;
                                }
                                <div class="progress-bar bg-warning" style="width: @(percentSafetyTalk)%;"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 700;">
                                <span>P5M Pre-Start</span>
                                <span>Actual : @ViewBag.MyP5msMonth | Target : @ViewBag.TargetP5M</span>
                            </div>
                            <div class="progress-achievement" style="height: 10px;">
                                @{
                                    double targetP5mDouble = (double)(ViewBag.TargetP5M ?? 1);
                                    double percentP5m = targetP5mDouble > 0 ? Math.Min((double)ViewBag.MyP5msMonth / targetP5mDouble * 100.0, 100.0) : 0.0;
                                }
                                <div class="progress-bar bg-success" style="width: @(percentP5m)%;"></div>
                            </div>
                        </div>

                        @if ((ViewBag.TargetObservasi ?? 0) > 0 || ViewBag.MyObservationsMonth > 0)
                        {
                            <div>
                                <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 700;">
                                    <span>Safety Observation</span>
                                    <span>Actual : @ViewBag.MyObservationsMonth | Target : @ViewBag.TargetObservasi</span>
                                </div>
                                <div class="progress-achievement" style="height: 10px;">
                                    @{
                                        double targetObservasiDouble = (double)(ViewBag.TargetObservasi ?? 0);
                                        double percentObservasi = targetObservasiDouble > 0 ? Math.Min((double)ViewBag.MyObservationsMonth / targetObservasiDouble * 100.0, 100.0) : 0.0;
                                    }
                                    <div class="progress-bar" style="width: @(percentObservasi)%; background-color: #fb923c;"></div>
                                </div>
                            </div>
                        }

                        @if ((ViewBag.TargetCoaching ?? 0) > 0 || ViewBag.MyCoachingsMonth > 0)
                        {
                            <div>
                                <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 700;">
                                    <span>Coaching</span>
                                    <span>Actual : @ViewBag.MyCoachingsMonth | Target : @ViewBag.TargetCoaching</span>
                                </div>
                                <div class="progress-achievement" style="height: 10px;">
                                    @{
                                        double targetCoachingDouble = (double)(ViewBag.TargetCoaching ?? 0);
                                        double percentCoaching = targetCoachingDouble > 0 ? Math.Min((double)(ViewBag.MyCoachingsMonth ?? 0) / targetCoachingDouble * 100.0, 100.0) : 0.0;
                                    }
                                    <div class="progress-bar" style="width: @(percentCoaching)%; background-color: #0d9488;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <!-- ==================== SECTION: GRAFIK & ANALITIK SAP (MTD & YTD) ==================== -->
