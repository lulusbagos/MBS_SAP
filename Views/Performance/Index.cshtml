        box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
    }
    .org-scroll-track {
        flex: 1;
        height: 4px;
        background: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
    }
    .org-scroll-thumb {
        height: 100%;
        background: linear-gradient(90deg,#0369a1,#0ea5e9);
        border-radius: 999px;
        transition: width 0.2s, left 0.2s;
        position: relative;
        min-width: 30px;
    }
    .org-chart-wrapper {
        cursor: grab;
    }
    .org-chart-wrapper.is-dragging {
        cursor: grabbing;
        user-select: none;
    }
    /* secondary maincon aligned at the edge, same top level as primary row */
    .org-level1-flex {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .org-secondary-block {
        margin-top: 16px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        position: relative;
        min-width: 820px;
        width: 100%;
