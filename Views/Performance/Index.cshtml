    }
    .org-scroll-track {
        flex: 1;
        height: 4px;
        background: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
    }
    .org-scroll-thumb {
        height: 100%;
        background: linear-gradient(90deg,#0369a1,#0ea5e9);
        border-radius: 999px;
        transition: width 0.2s, left 0.2s;
        position: relative;
        min-width: 30px;
    }
    .org-chart-wrapper {
        cursor: grab;
    }
    .org-chart-wrapper.is-dragging {
        cursor: grabbing;
        user-select: none;
    }
