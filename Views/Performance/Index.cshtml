                                        double pExtreme = totalOpenAll > 0 ? (double)ViewBag.SafetyOpenExtreme / totalOpenAll * 100.0 : 0.0;
                                        double pHigh = totalOpenAll > 0 ? (double)ViewBag.SafetyOpenHigh / totalOpenAll * 100.0 : 0.0;
                                        double pMedium = totalOpenAll > 0 ? (double)ViewBag.SafetyOpenMedium / totalOpenAll * 100.0 : 0.0;
