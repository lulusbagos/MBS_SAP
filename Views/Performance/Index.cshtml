    </div> <!-- Closing sectionCompany -->

    @{
        var uncompliantWeek = ViewBag.UncompliantWeek as List<MBS_SAP.Controllers.UncompliantEmployeeViewModel> ?? new List<MBS_SAP.Controllers.UncompliantEmployeeViewModel>();
        var uncompliantMonth = ViewBag.UncompliantMonth as List<MBS_SAP.Controllers.UncompliantEmployeeViewModel> ?? new List<MBS_SAP.Controllers.UncompliantEmployeeViewModel>();
        var companyHistory = ViewBag.CompanyHistory as List<MBS_SAP.Controllers.PerformanceHistoryViewModel> ?? new List<MBS_SAP.Controllers.PerformanceHistoryViewModel>();
    }


    @{
        var hierarchy = ViewBag.CompanyHierarchy as List<MBS_SAP.Controllers.CompanyHierarchyNode> ?? new List<MBS_SAP.Controllers.CompanyHierarchyNode>();
        var primaryChildren = ViewBag.CompanyHierarchyPrimaryChildren as List<string> ?? new List<string>();
        var primaryChildSet = new HashSet<string>(
            primaryChildren
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c.Trim()),
            StringComparer.OrdinalIgnoreCase
        );

        int CountNodes(IEnumerable<MBS_SAP.Controllers.CompanyHierarchyNode> nodes)
        {
            var total = 0;
            foreach (var n in nodes)
            {
                total += 1;
                if (n.Children != null && n.Children.Count > 0)
                {
                    total += CountNodes(n.Children);
                }
            }
            return total;
        }

        int MaxDepth(MBS_SAP.Controllers.CompanyHierarchyNode node, int currentLevel = 1)
        {
            if (node.Children == null || node.Children.Count == 0)
            {
                return currentLevel;
            }
            return node.Children.Max(c => MaxDepth(c, currentLevel + 1));
        }

        var countedHierarchyNodes = CountNodes(hierarchy);
        var totalHierarchyNodes = (int?)ViewBag.CompanyHierarchyActualActiveCount ?? countedHierarchyNodes;
        var renderedHierarchyNodes = (int?)ViewBag.CompanyHierarchyRenderedCount ?? countedHierarchyNodes;
        var hierarchyDepth = hierarchy.Any() ? hierarchy.Max(n => MaxDepth(n)) : 0;

        string GetTierName(int level)
        {
            if (level <= 0) return "OWNER";
            if (level == 1) return "MAINCON";
            if (level == 2) return "SUBCON";
            return "VENDOR";
        }

        string GetTierKey(int level)
        {
            if (level <= 0) return "owner";
            if (level == 1) return "maincon";
            if (level == 2) return "subcon";
            return "vendor";
        }

        string GetChildContainerClass(int childCount)
        {
            if (childCount >= 12) return "org-children org-children-dense";
            if (childCount >= 7) return "org-children org-children-compact";
            return "org-children";
        }

        string GetAchievementRateCss(double achievementRate)
        {
            var normalized = Math.Max(0d, Math.Min(achievementRate, 100d));
            return normalized.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }

        void RenderMatrixNode(MBS_SAP.Controllers.CompanyHierarchyNode node, int level, string mainconGroup)
        {
            var tierName = GetTierName(level);
            var tierKey = GetTierKey(level);
            var achievementRateCss = GetAchievementRateCss(node.CumulativeAchievementRate);
            var departmentJson = System.Text.Json.JsonSerializer.Serialize(node.DepartmentAchievements ?? new List<MBS_SAP.Controllers.DepartmentAchievementViewModel>());

            <li class="org-node org-node-matrix" data-company-name="@node.CompanyName" data-company-id="@node.CompanyId" data-level="@level" data-tier="@tierKey" data-maincon-group="@mainconGroup" data-dept-achievements="@departmentJson" style="--ach-rate:@achievementRateCss;">
                <div class="org-node-card">
                    <button type="button" class="org-node-menu-btn" title="Lihat pencapaian per departemen" aria-label="Lihat pencapaian per departemen">
                        <i class="bi bi-three-dots"></i>
                    </button>
                    <div class="org-node-card-inner">
                        <div class="org-avatar"><i class="bi bi-building"></i></div>
                        <div class="org-node-text">
                            <div class="org-node-title">@node.CompanyName</div>
                            <div class="org-node-meta">Persentase pencapaian hazard</div>
                            <div class="org-node-badges">
                                <span class="org-node-tag">@($"YTD {node.CumulativeYtdAchievementRate:0.#}%")</span>
                                <span class="org-node-tag">@($"MTD {node.CumulativeMonthlyAchievementRate:0.#}%")</span>
                                <span class="org-node-tag">@($"WEEK {node.CumulativeWeeklyAchievementRate:0.#}%")</span>
                                <span class="org-level-pill">@tierName</span>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
        }

        void RenderSecondaryBranch(MBS_SAP.Controllers.CompanyHierarchyNode mainconNode, int level)
        {
            var hasChildren = mainconNode.Children != null && mainconNode.Children.Count > 0;
            var tierKey = GetTierKey(level);
            var tierLabel = "MAINCON L2";
            var achievementRateCss = GetAchievementRateCss(mainconNode.CumulativeAchievementRate);
            var departmentJson = System.Text.Json.JsonSerializer.Serialize(mainconNode.DepartmentAchievements ?? new List<MBS_SAP.Controllers.DepartmentAchievementViewModel>());

            <li class="org-node org-node-matrix org-secondary-branch @(hasChildren ? "has-children" : string.Empty)" data-company-name="@mainconNode.CompanyName" data-company-id="@mainconNode.CompanyId" data-level="@level" data-tier="@tierKey" data-maincon-group="secondary" data-dept-achievements="@departmentJson" style="--ach-rate:@achievementRateCss;">
                <div class="org-node-card">
                    <button type="button" class="org-node-menu-btn" title="Lihat pencapaian per departemen" aria-label="Lihat pencapaian per departemen">
                        <i class="bi bi-three-dots"></i>
                    </button>
                    <div class="org-node-card-inner">
                        <div class="org-avatar"><i class="bi bi-building"></i></div>
                        <div class="org-node-text">
                            <div class="org-node-title">@mainconNode.CompanyName</div>
                            <div class="org-node-meta">Persentase pencapaian hazard</div>
                            <div class="org-node-badges">
                                <span class="org-node-tag">@($"YTD {mainconNode.CumulativeYtdAchievementRate:0.#}%")</span>
                                <span class="org-node-tag">@($"MTD {mainconNode.CumulativeMonthlyAchievementRate:0.#}%")</span>
                                <span class="org-node-tag">@($"WEEK {mainconNode.CumulativeWeeklyAchievementRate:0.#}%")</span>
                                <span class="org-level-pill">@tierLabel</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (hasChildren)
                {
                    <ul class="org-children org-secondary-branch-subcons" data-child-count="@mainconNode.Children!.Count">
                        @foreach (var sub in mainconNode.Children!)
                        {
                            RenderMatrixNode(sub, level + 1, "secondary");
                        }
                    </ul>
                }
            </li>
        }

        void RenderOrgNode(MBS_SAP.Controllers.CompanyHierarchyNode node, int level = 0, string inheritedMainconGroup = "none")
        {
            var hasChildren = node.Children != null && node.Children.Count > 0;
            var childCount = node.Children?.Count ?? 0;
            var isPrimaryBranchMainconL2 = level == 2 && string.Equals(inheritedMainconGroup, "primary", StringComparison.OrdinalIgnoreCase);
            var tierName = isPrimaryBranchMainconL2 ? "MAINCON L2" : GetTierName(level);
            var tierKey = isPrimaryBranchMainconL2 ? "maincon" : GetTierKey(level);
            var isMainconLevel = level == 1;
            var companyNameKey = (node.CompanyName ?? string.Empty).Trim();
            var isPrimaryMaincon = isMainconLevel && primaryChildSet.Contains(companyNameKey);
            var mainconGroup = isMainconLevel ? (isPrimaryMaincon ? "primary" : "secondary") : inheritedMainconGroup;
            var childContainerClass = GetChildContainerClass(childCount);
            var achievementRateCss = GetAchievementRateCss(node.CumulativeAchievementRate);
            var departmentJson = System.Text.Json.JsonSerializer.Serialize(node.DepartmentAchievements ?? new List<MBS_SAP.Controllers.DepartmentAchievementViewModel>());

            <li class="org-node @(hasChildren ? "has-children" : string.Empty)" data-company-name="@node.CompanyName" data-company-id="@node.CompanyId" data-level="@level" data-tier="@tierKey" data-maincon-group="@mainconGroup" data-dept-achievements="@departmentJson" style="--ach-rate:@achievementRateCss;">
                <div class="org-node-card">
                    <button type="button" class="org-node-menu-btn" title="Lihat pencapaian per departemen" aria-label="Lihat pencapaian per departemen">
                        <i class="bi bi-three-dots"></i>
                    </button>
                    <div class="org-node-card-inner">
                        <div class="org-avatar"><i class="bi @(level == 0 ? "bi-building-fill" : (hasChildren ? "bi-building" : "bi-building"))"></i></div>
                        <div class="org-node-text">
                            <div class="org-node-title">@node.CompanyName</div>
                            <div class="org-node-meta">Persentase pencapaian hazard</div>
                            <div class="org-node-badges">
                                <span class="org-node-tag">@($"YTD {node.CumulativeYtdAchievementRate:0.#}%")</span>
                                <span class="org-node-tag">@($"MTD {node.CumulativeMonthlyAchievementRate:0.#}%")</span>
                                <span class="org-node-tag">@($"WEEK {node.CumulativeWeeklyAchievementRate:0.#}%")</span>
                                <span class="org-level-pill">@tierName</span>
                            </div>
                        </div>
                    </div>
                </div>
                @if (hasChildren)
                {
                    if (level == 0)
                    {
                        var orderedChildren = node.Children!;
                        var primaryMaincons = orderedChildren.Where(c => primaryChildSet.Contains((c.CompanyName ?? string.Empty).Trim())).ToList();
                        var otherChildren = orderedChildren.Where(c => !primaryChildSet.Contains((c.CompanyName ?? string.Empty).Trim())).ToList();
                        var totalMaincons = primaryMaincons.Count + otherChildren.Count;
                        var combinedClass = GetChildContainerClass(totalMaincons);

                        <ul class="@combinedClass org-maincon-combined-row" data-child-count="@totalMaincons">
                            @foreach (var child in primaryMaincons)
                            {
                                RenderOrgNode(child, level + 1, "primary");
                            }
                            @if (otherChildren.Any() && primaryMaincons.Any())
                            {
                                <li class="org-maincon-separator" aria-hidden="true"></li>
                            }
                            @if (otherChildren.Any())
                            {
                                <li class="org-secondary-maincon-cell">
                                    <div class="org-secondary-caption">Maincon Non Utama 5x5</div>
                                    <ul class="org-secondary-maincon-row org-secondary-maincon-row-5x5" data-child-count="@otherChildren.Count">
                                        @foreach (var child in otherChildren)
                                        {
                                            RenderSecondaryBranch(child, level + 1);
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        var nextChildClass = level == 1
                            ? (string.Equals(mainconGroup, "primary", StringComparison.OrdinalIgnoreCase)
                                ? $"{childContainerClass} org-secondary-maincon-row"
                                : $"{childContainerClass} org-subcon-grid")
                            : childContainerClass;
                        <ul class="@nextChildClass" data-child-count="@childCount">
                            @foreach (var child in node.Children!)
                            {
                                RenderOrgNode(child, level + 1, mainconGroup);
                            }
                        </ul>
                    }
                }
            </li>
        }
    }

    <!-- ==================== SECTION 4: HIRARKI PERUSAHAAN ==================== -->
    <div id="sectionHierarchy" style="display: none;">
        <div class="premium-card animate-fade-in">
            <div class="premium-header">
                <i class="bi bi-diagram-3-fill text-primary" style="font-size: 16px; color: #38bdf8 !important;"></i>
                <h6 class="premium-title">Hirarki Perusahaan</h6>
            </div>
            <div class="premium-body">
                @if (hierarchy == null || !hierarchy.Any())
                {
                    <div class="card-sap text-center py-4 hierarchy-empty">
                        <i class="bi bi-diagram-3-fill d-block mb-2" style="font-size: 28px;"></i>
                        Data hirarki perusahaan belum tersedia.
                    </div>
                }
                else
                {
                    var indeximRoot = hierarchy.FirstOrDefault(h => (h.CompanyName ?? string.Empty).Contains("INDEXIM", StringComparison.OrdinalIgnoreCase));
                    var rootsToRender = indeximRoot != null
                        ? new List<MBS_SAP.Controllers.CompanyHierarchyNode> { indeximRoot }
                            .Concat(hierarchy.Where(h => h.CompanyId != indeximRoot.CompanyId).OrderBy(h => h.CompanyName))
                            .ToList()
                        : hierarchy.OrderBy(h => h.CompanyName).ToList();

                    <div class="hierarchy-toolbar">
                        <input id="hierarchySearchInput" type="text" class="hierarchy-search" placeholder="Cari perusahaan / ID perusahaan..." autocomplete="off" />
                        <div class="hierarchy-toggle-group" id="hierarchyModeToggle">
                            <button type="button" class="hierarchy-mode-btn is-active" data-mode="all">Semua Child</button>
                            <button type="button" class="hierarchy-mode-btn" data-mode="primary">Maincon Utama Saja</button>
                        </div>
                    </div>
                    <p class="hierarchy-hint">Tip: pilih mode Maincon Utama Saja untuk fokus cabang inti INDEXIM.</p>

                    <div class="org-chart-outer">
                        <div class="org-scroll-nav" id="orgScrollNav">
                            <button type="button" class="org-scroll-btn" id="orgScrollLeft" title="Geser kiri"><i class="bi bi-chevron-left"></i></button>
                            <div class="org-scroll-track"><div class="org-scroll-thumb" id="orgScrollThumb"></div></div>
                            <button type="button" class="org-scroll-btn" id="orgScrollRight" title="Geser kanan"><i class="bi bi-chevron-right"></i></button>
                            <div class="org-zoom-controls" aria-label="Kontrol zoom hirarki">
                                <button type="button" class="org-scroll-btn" id="orgZoomOut" title="Zoom out"><i class="bi bi-zoom-out"></i></button>
                                <span class="org-zoom-value" id="orgZoomValue">100%</span>
                                <select id="orgZoomPreset" class="org-zoom-select" title="Pilih zoom">
                                    <option value="1">100%</option>
                                    <option value="0.9">90%</option>
                                    <option value="0.8">80%</option>
                                    <option value="0.7">70%</option>
                                    <option value="0.6">60%</option>
                                    <option value="0.5">50%</option>
                                    <option value="0.4">40%</option>
                                    <option value="0.3">30%</option>
                                    <option value="0.2">20%</option>
                                </select>
                                <button type="button" class="org-scroll-btn" id="orgZoomIn" title="Zoom in"><i class="bi bi-zoom-in"></i></button>
                                <button type="button" class="org-scroll-btn" id="orgZoomReset" title="Reset zoom"><i class="bi bi-arrow-counterclockwise"></i></button>
                            </div>
                        </div>
                        <div class="org-chart-wrapper" id="orgChartWrapper">
                            <ul class="org-chart-tree" id="hierarchyOrgTree">
                                @foreach (var root in rootsToRender)
                                {
                                    RenderOrgNode(root);
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="dept-achievement-modal" id="deptAchievementModal" aria-hidden="true">
                        <div class="dept-achievement-backdrop" data-dept-close="true"></div>
                        <div class="dept-achievement-dialog" role="dialog" aria-modal="true" aria-labelledby="deptAchievementTitle">
                            <div class="dept-achievement-header">
                                <h6 class="dept-achievement-title" id="deptAchievementTitle">Pencapaian Per Departemen</h6>
                                <button type="button" class="dept-achievement-close" id="deptAchievementClose" aria-label="Tutup">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="dept-achievement-body">
                                <div class="table-responsive league-table-container">
                                    <table class="dept-achievement-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 60px; text-align: center;">Pos</th>
                                                <th>Klub (Departemen)</th>
                                                <th style="text-align: center;">Skuad (Karyawan)</th>
                                                <th style="text-align: center; background-color: #1e3a8a; color: #ffffff;">PTS (Kepatuhan %)</th>
                                                <th style="text-align: center; width: 110px;">Form (5 Laga)</th>
                                                <th style="text-align: center;">HZ (Hazard)</th>
                                                <th style="text-align: center;">IP (Inspeksi)</th>
                                                <th style="text-align: center;">ST (S. Talk)</th>
                                                <th style="text-align: center;">OB (Observasi)</th>
                                                <th style="text-align: center;">CC (Coaching)</th>
                                                <th style="background-color: #78350f; color: #ffffff; border-left: 2px solid #b45309; text-align: center;">P5M *</th>
                                                <th style="text-align: center;">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody id="deptAchievementRows">
                                            <tr><td colspan="11" class="text-center text-muted">Belum ada data departemen.</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="league-legend-box">
                                    <div class="league-legend-item">
                                        <div class="league-legend-dot dot-champions"></div>
                                        <span>Zona Champions (Peringkat 1-3): Kepatuhan Tinggi / Apresiasi Unggul</span>
                                    </div>
                                    <div class="league-legend-item">
                                        <div class="league-legend-dot dot-normal"></div>
                                        <span>Zona Aman (Tengah): Memenuhi Standar Safety</span>
                                    </div>
                                    <div class="league-legend-item">
                                        <div class="league-legend-dot dot-relegation"></div>
                                        <span>Zona Degradasi/Pembinaan (3 Peringkat Bawah): Butuh Re-Coaching & Pendampingan</span>
                                    </div>
                                </div>
                                <span class="text-muted" style="font-size: 11px; font-style: italic; margin-top: 12px; display: block; line-height: 1.4;">
                                    * Catatan: Kolom P5M sengaja diwarnai berbeda karena tidak diikutsertakan dalam akumulasi target total kepatuhan SAP perusahaan (Target P5M dimonitor terpisah).
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Secondary Modal: Detail Karyawan (Lazy Load) -->
                    <div class="dept-achievement-modal" id="employeeDetailModal" aria-hidden="true" style="z-index: 1200;">
                        <div class="dept-achievement-backdrop" data-emp-close="true"></div>
                        <div class="dept-achievement-dialog" role="dialog" aria-modal="true" aria-labelledby="employeeDetailTitle" style="width: min(1500px, 96vw);">
                            <div class="dept-achievement-header" style="background: #f8fafc;">
                                <h6 class="dept-achievement-title" id="employeeDetailTitle">Detail Karyawan per Departemen</h6>
                                <button type="button" class="dept-achievement-close" id="employeeDetailClose" aria-label="Tutup">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="dept-achievement-body">
                                <div id="employeeLoading" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="text-muted mt-2 mb-0" style="font-size: 13px; font-weight: 600;">Memuat data karyawan...</p>
                                </div>
                                <div class="table-responsive d-none league-table-container" id="employeeTableContainer">
                                    <table class="dept-achievement-table" style="font-size: 12px;">
                                        <thead>
                                            <tr>
                                                <th style="width: 60px; text-align: center;">Pos</th>
                                                <th>Pemain (Nama Karyawan & NIK)</th>
                                                <th>Jabatan</th>
                                                <th class="text-center" style="background-color: #1e3a8a; color: #ffffff;">PTS (Kepatuhan %)</th>
                                                <th class="text-center" style="width: 110px;">Form (5 Program)</th>
                                                <th class="text-center">HZ (Hazard)</th>
                                                <th class="text-center">IP (Inspeksi)</th>
                                                <th class="text-center">ST (S. Talk)</th>
                                                <th class="text-center">OB (Observasi)</th>
                                                <th class="text-center">CC (Coaching)</th>
                                                <th class="text-center" style="background-color: #78350f; color: #ffffff; border-left: 2px solid #b45309;">P5M *</th>
                                            </tr>
                                        </thead>
                                        <tbody id="employeeDetailRows">
                                            <!-- Lazy loaded rows -->
                                        </tbody>
                                    </table>
                                </div>
                                <div class="league-legend-box" id="employeeLeagueLegend" style="margin-top: 12px; margin-bottom: 12px;">
                                    <div class="league-legend-item">
                                        <div class="league-legend-dot dot-champions"></div>
                                        <span>Zona Champions (Top 3): Pemain Teladan Safety</span>
                                    </div>
                                    <div class="league-legend-item">
                                        <div class="league-legend-dot dot-normal"></div>
                                        <span>Zona Aman (Tengah): Patuh Kriteria K3</span>
                                    </div>
                                    <div class="league-legend-item">
                                        <div class="league-legend-dot dot-relegation"></div>
                                        <span>Zona Degradasi/Pembinaan (3 Bawah): Perlu Konseling & Pembinaan PJA</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

<!-- Charts & Tabs Handling Script -->
@section Scripts {
<script>
    const deptModal = document.getElementById('deptAchievementModal');
    const deptRows = document.getElementById('deptAchievementRows');
    const deptTitle = document.getElementById('deptAchievementTitle');
    const deptCloseBtn = document.getElementById('deptAchievementClose');

    const empModal = document.getElementById('employeeDetailModal');
    const empRows = document.getElementById('employeeDetailRows');
    const empTitle = document.getElementById('employeeDetailTitle');
    const empCloseBtn = document.getElementById('employeeDetailClose');
    const empLoading = document.getElementById('employeeLoading');
    const empTableContainer = document.getElementById('employeeTableContainer');

    let currentCompanyId = null;

    function getAchievementColor(rate) {
        const val = Number(rate);
        if (val >= 90) return '#16a34a'; // Green
        if (val >= 60) return '#ca8a04'; // Yellow
        if (val >= 30) return '#ea580c'; // Orange
        return '#dc2626'; // Red
    }

    function getFormDot(rate) {
        const val = Number(rate);
        if (val >= 100) return '<span class="league-form-dot dot-w" title="Target Tercapai (100%+) - WIN">W</span>';
        if (val >= 50) return '<span class="league-form-dot dot-d" title="Target Sebagian (50%-99%) - DRAW">D</span>';
        return '<span class="league-form-dot dot-l" title="Target Rendah (<50%) - LOSS">L</span>';
    }

    function getEmpFormDot(actual, target) {
        if (target === 0) {
            return '<span class="league-form-dot dot-w" title="Bebas Target (Tercapai) - WIN">W</span>';
        }
        const rate = (actual / target) * 100;
        if (rate >= 100) return '<span class="league-form-dot dot-w" title="Target Tercapai - WIN">W</span>';
        if (rate >= 50) return '<span class="league-form-dot dot-d" title="Target Sebagian - DRAW">D</span>';
        return '<span class="league-form-dot dot-l" title="Target Kurang - LOSS">L</span>';
    }

    function getDeptBadgeColor(deptName) {
        let hash = 0;
        for (let i = 0; i < deptName.length; i++) {
            hash = deptName.charCodeAt(i) + ((hash << 5) - hash);
        }
        const colors = [
            '#1e3a8a', '#b91c1c', '#047857', '#6d28d9', '#a21caf',
            '#c2410c', '#0369a1', '#15803d', '#be123c', '#4d7c0f'
        ];
        const idx = Math.abs(hash) % colors.length;
        return colors[idx];
    }

    function getDeptInitials(deptName) {
        const cleanName = deptName.replace(/[^a-zA-Z0-9\s]/g, '').trim();
        const words = cleanName.split(/\s+/);
        if (words.length >= 2) {
            return (words[0][0] + words[1][0]).toUpperCase();
        }
        return cleanName.substring(0, 2).toUpperCase();
    }

    function closeDeptModal() {
        if (!deptModal) return;
        deptModal.classList.remove('show');
        deptModal.setAttribute('aria-hidden', 'true');
    }

    function closeEmpModal() {
        if (!empModal) return;
        empModal.classList.remove('show');
        empModal.setAttribute('aria-hidden', 'true');
    }

    window.viewEmployeeDetails = function(deptName, companyIdOverride) {
        if (!empModal || !empRows || !empTitle || !empLoading || !empTableContainer) return;
        const cid = companyIdOverride || currentCompanyId;

        empTitle.textContent = 'Detail Karyawan & Target MTD - ' + deptName;
        
        empLoading.classList.remove('d-none');
        empTableContainer.classList.add('d-none');
        
        empModal.classList.add('show');
        empModal.setAttribute('aria-hidden', 'false');

        const url = '/Performance/GetDepartmentEmployees?companyId=' + cid + '&departmentName=' + encodeURIComponent(deptName);
        fetch(url)
            .then(res => {
                if (!res.ok) throw new Error('Gagal mengambil data');
                return res.json();
            })
            .then(data => {
                empLoading.classList.add('d-none');
                empTableContainer.classList.remove('d-none');

                if (!Array.isArray(data) || data.length === 0) {
                    empRows.innerHTML = '<tr><td colspan="10" class="text-center text-muted">Tidak ada data karyawan aktif.</td></tr>';
                } else {
                    const sortedData = data.slice().sort((a, b) => {
                        const aZero = (a.mtdTotalTarget === 0) ? 1 : 0;
                        const bZero = (b.mtdTotalTarget === 0) ? 1 : 0;
                        if (aZero !== bZero) return aZero - bZero;
                        return (b.complianceRate || 0) - (a.complianceRate || 0);
                    });

                    const totalEmployees = sortedData.length;
                    empRows.innerHTML = sortedData.map((item, idx) => {
                        const name = item.karyawanName || '-';
                        const nik = item.nik || '-';
                        const jabatan = item.jabatanName || '-';
                        
                        const mtd = Number(item.complianceRate || 0).toFixed(1);
                        
                        function formatZeroTgt(actual, target) {
                            if (target === 0) return '<span style="font-weight: 900; color: #000000;">' + actual + ' / ' + target + '</span>';
                            return actual + ' / ' + target;
                        }

                        const hAct = item.hazard ? item.hazard.actual : 0;
                        const hTgt = item.hazard ? item.hazard.target : 0;
                        const iAct = item.inspeksi ? item.inspeksi.actual : 0;
                        const iTgt = item.inspeksi ? item.inspeksi.target : 0;
                        const stAct = item.safetyTalk ? item.safetyTalk.actual : 0;
                        const stTgt = item.safetyTalk ? item.safetyTalk.target : 0;
                        const oAct = item.observasi ? item.observasi.actual : 0;
                        const oTgt = item.observasi ? item.observasi.target : 0;
                        const cAct = item.coaching ? item.coaching.actual : 0;
                        const cTgt = item.coaching ? item.coaching.target : 0;

                        const formDisplay = getEmpFormDot(hAct, hTgt) + getEmpFormDot(iAct, iTgt) + getEmpFormDot(stAct, stTgt) + getEmpFormDot(oAct, oTgt) + getEmpFormDot(cAct, cTgt);

                        const hazard = formatZeroTgt(hAct, hTgt);
                        const inspeksi = formatZeroTgt(iAct, iTgt);
                        const safetyTalk = formatZeroTgt(stAct, stTgt);
                        const observasi = formatZeroTgt(oAct, oTgt);
                        const coaching = formatZeroTgt(cAct, cTgt);
                        const p5m = formatZeroTgt(item.p5m ? item.p5m.actual : 0, item.p5m ? item.p5m.target : 0);
                        
                        const isZeroTarget = (item.mtdTotalTarget === 0);
                        let rowStyle = isZeroTarget ? 'background-color: #f0fdf4;' : '';

                        let rankDisplay = idx + 1;
                        let rankClass = 'league-rank-pill';
                        let rowClass = 'league-row-normal';

                        if (idx < 3) {
                            rowClass = 'league-row-champions';
                            rankClass += ' league-rank-champions';
                            if (idx === 0) rankDisplay = '🥇 1';
                            else if (idx === 1) rankDisplay = '🥈 2';
                            else if (idx === 2) rankDisplay = '🥉 3';
                        } else if (idx >= totalEmployees - 3 && totalEmployees > 5) {
                            rowClass = 'league-row-relegation';
                            rankClass += ' league-rank-relegation';
                        }

                        const rankPill = '<div class="' + rankClass + '">' + rankDisplay + '</div>';
                        
                        return '<tr class="' + rowClass + '" style="' + rowStyle + '">' +
                            '<td class="text-muted fw-bold" style="text-align: center;">' + rankPill + '</td>' +
                            '<td><div class="fw-bold" style="color: #334155;">' + name + '</div><div style="font-size: 10px; color: #64748b;">' + nik + '</div></td>' +
                            '<td>' + jabatan + '</td>' +
                            '<td class="fw-bold text-center" style="color: ' + getAchievementColor(mtd) + ';">' + mtd + '%</td>' +
                            '<td style="text-align: center; white-space: nowrap;">' + formDisplay + '</td>' +
                            '<td class="text-center">' + hazard + '</td>' +
                            '<td class="text-center">' + inspeksi + '</td>' +
                            '<td class="text-center">' + safetyTalk + '</td>' +
                            '<td class="text-center">' + observasi + '</td>' +
                            '<td class="text-center">' + coaching + '</td>' +
                            '<td class="text-center" style="background-color: #fffbeb; border-left: 2px solid #f59e0b;">' + p5m + '</td>' +
                        '</tr>';
                    }).join('');
                }
            })
            .catch(err => {
                empLoading.classList.add('d-none');
                empTableContainer.classList.remove('d-none');
                empRows.innerHTML = '<tr><td colspan="10" class="text-center text-danger">Terjadi kesalahan saat memuat data.</td></tr>';
                console.error(err);
            });
    };

    window.openDeptModal = function(companyId, companyName, deptData) {
