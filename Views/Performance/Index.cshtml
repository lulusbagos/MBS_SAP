                                            <td class="ps-3 py-2" style="font-weight: 600;">Property Damage</td>
                                            <td class="text-center py-2" style="font-weight: 600;">@ViewBag.IncidentPropertyDamage</td>
                                            <td class="text-end pe-3 py-2" style="font-family: monospace; font-weight: 600;">@Math.Round(pPropertyDamage, 1)%</td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td class="ps-3 py-2" style="font-weight: 600;">First Aid Injury</td>
                                            <td class="text-center py-2" style="font-weight: 600;">@ViewBag.IncidentFirstAidInjury</td>
                                            <td class="text-end pe-3 py-2" style="font-family: monospace; font-weight: 600;">@Math.Round(pFirstAid, 1)%</td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td class="ps-3 py-2" style="font-weight: 600;">Medical Treatment Injury</td>
                                            <td class="text-center py-2" style="font-weight: 600;">@ViewBag.IncidentMedicalTreatmentInjury</td>
                                            <td class="text-end pe-3 py-2" style="font-family: monospace; font-weight: 600;">@Math.Round(pMedical, 1)%</td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td class="ps-3 py-2" style="font-weight: 600;">Kebakaran</td>
                                            <td class="text-center py-2" style="font-weight: 600;">@ViewBag.IncidentKebakaran</td>
                                            <td class="text-end pe-3 py-2" style="font-family: monospace; font-weight: 600;">@Math.Round(pKebakaran, 1)%</td>
                                        </tr>
                                        <tr style="border-bottom: none;">
                                            <td class="ps-3 py-2" style="font-weight: 600;">Fatality</td>
                                            <td class="text-center py-2" style="font-weight: 600;">@ViewBag.IncidentFatality</td>
                                            <td class="text-end pe-3 py-2" style="font-family: monospace; font-weight: 600;">@Math.Round(pFatality, 1)%</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <small class="d-block mt-2 text-muted" style="font-size: 10px;">
                                Urutan dari bawah ke atas: Near Miss, Property Damage, First Aid Injury, Medical Treatment Injury, Kebakaran, Fatality.
                            </small>
