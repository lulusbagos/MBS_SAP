            function registerPoint(type, normalized) {
                const normalizedId = String(normalized.id ?? '').trim();
                if (normalizedId) {
                    const idKey = type + '|' + normalizedId;
                    if (seenIds.has(idKey)) {
                        return;
                    }
                    seenIds.add(idKey);
                }

                const signature = [
                    type,
                    String(normalized.lat ?? ''),
                    String(normalized.lon ?? ''),
                    String(normalized.tanggal ?? ''),
                    String(normalized.nama ?? ''),
                    String(normalized.detail ?? ''),
                    String(normalized.area ?? '')
                ].join('|');

                if (!normalizedId && seenSignatures.has(signature)) {
                    return;
                }
                if (!normalizedId) {
                    seenSignatures.add(signature);
                }

                points.push({
                    key: type + '-' + String(normalized.id ?? sequence) + '-' + String(sequence),
                    type: type,
                    ...normalized
                });
                sequence += 1;
            }

            hitSafeHazardPoints.forEach(function(raw) {
                const normalized = normalizePoint(raw);
                if (!normalized) {
                    return;
                }
                registerPoint('hazard', normalized);
            });

            hitSafeInspectionPoints.forEach(function(raw) {
                const normalized = normalizePoint(raw);
                if (!normalized) {
                    return;
                }
                registerPoint('inspection', normalized);
            });

            hitSafeP5mPoints.forEach(function(raw) {
                const normalized = normalizePoint(raw);
                if (!normalized) {
                    return;
                }
                registerPoint('p5m', normalized);
            });

            hitSafeSafetyTalkPoints.forEach(function(raw) {
                const normalized = normalizePoint(raw);
                if (!normalized) {
                    return;
                }
                registerPoint('safetytalk', normalized);
            });

            return points;
        }

        function getHitSafeFilterValues() {
            const typeEl = document.getElementById('hitsafeFilterType');
            const statusEl = document.getElementById('hitsafeFilterStatus');
            const riskEl = document.getElementById('hitsafeFilterRisk');
            const keywordEl = document.getElementById('hitsafeFilterKeyword');

            return {
                type: typeEl ? typeEl.value : 'all',
                status: statusEl ? statusEl.value : 'all',
                risk: riskEl ? riskEl.value : 'all',
                keyword: normalizeText(keywordEl ? keywordEl.value : '')
            };
        }

        function filterHitSafePoints() {
            const filters = getHitSafeFilterValues();

            return hitSafeAllPoints.filter(function(point) {
                if (filters.type !== 'all' && point.type !== filters.type) {
                    return false;
                }

                if (filters.status !== 'all') {
                    const status = normalizeText(point.status);
                    if (status !== filters.status) {
                        return false;
                    }
                }

                if (filters.risk !== 'all') {
                    const risk = normalizeText(point.resiko);
                    if (filters.risk === 'low' && !(risk.includes('rendah') || risk.includes('low'))) {
                        return false;
                    }
                    if (filters.risk === 'medium' && !(risk.includes('sedang') || risk.includes('medium'))) {
                        return false;
                    }
                    if (filters.risk === 'high' && !(risk.includes('tinggi') || risk.includes('high'))) {
                        return false;
                    }
                    if (filters.risk === 'extreme' && !(risk.includes('ekstrem') || risk.includes('extreme'))) {
                        return false;
                    }
                }

                if (filters.keyword) {
                    const corpus = [point.area, point.nama, point.detail, point.status, point.resiko].map(normalizeText).join(' ');
                    if (!corpus.includes(filters.keyword)) {
                        return false;
                    }
                }

                return true;
            });
        }

        function applyHitSafeFiltersAndRender(shouldFit) {
            const summary = renderHitSafeReportPoints();

            if (shouldFit && hitSafeMap) {
                if (summary.bounds) {
                    hitSafeMap.fitBounds(summary.bounds.pad(0.2));
                } else {
                    hitSafeMap.setView([kaliorangLat, kaliorangLon], 11);
                }
            }
        }

        function initHitSafeFilters() {
            if (hitSafeFiltersInitialized) {
                return;
            }

            const ids = ['hitsafeFilterType', 'hitsafeFilterStatus', 'hitsafeFilterRisk', 'hitsafeFilterKeyword'];
            ids.forEach(function(id) {
                const element = document.getElementById(id);
                if (!element) {
                    return;
                }
                const eventName = id === 'hitsafeFilterKeyword' ? 'input' : 'change';
                element.addEventListener(eventName, function() {
                    applyHitSafeFiltersAndRender(true);
                });
            });

            const resetButton = document.getElementById('hitsafeFilterReset');
            if (resetButton) {
                resetButton.addEventListener('click', function() {
                    const typeEl = document.getElementById('hitsafeFilterType');
                    const statusEl = document.getElementById('hitsafeFilterStatus');
                    const riskEl = document.getElementById('hitsafeFilterRisk');
                    const keywordEl = document.getElementById('hitsafeFilterKeyword');
                    if (typeEl) typeEl.value = 'hazard';
                    if (statusEl) statusEl.value = 'all';
                    if (riskEl) riskEl.value = 'all';
                    if (keywordEl) keywordEl.value = '';
                    applyHitSafeFiltersAndRender(true);
                });
            }

            const locateButton = document.getElementById('hitsafeLocateBtn');
            if (locateButton) {
                locateButton.addEventListener('click', function() {
                    hitSafeAutoCenter = true;
                    locateButton.classList.add('btn-success', 'text-white');
                    locateButton.style.background = '';
                    locateButton.style.color = '';
                    locateButton.style.borderColor = '';
                    locateButton.innerHTML = '<i class="bi bi-crosshair text-success"></i> Mengikuti...';
                    updateHitSafeToUserLocation();
                });
            }

            const heatmapToggle = document.getElementById('hitsafeHeatmapToggle');
            if (heatmapToggle) {
                heatmapToggle.addEventListener('click', function() {
                    hitSafeHeatmapMode = !hitSafeHeatmapMode;
                    const legendEl = document.getElementById('hitsafeHeatmapLegend');
                    const pinLegendEl = document.getElementById('hitsafePinLegend');

                    if (hitSafeHeatmapMode) {
                        heatmapToggle.classList.add('btn-danger', 'text-white');
                        heatmapToggle.style.background = '#dc2626';
                        heatmapToggle.style.color = '#ffffff';
                        heatmapToggle.style.borderColor = '#b91c1c';
                        heatmapToggle.innerHTML = '<i class="bi bi-fire text-white"></i> Mode Pin';
                        if (legendEl) legendEl.style.display = 'block';
                        if (pinLegendEl) pinLegendEl.style.display = 'none';
                    } else {
                        heatmapToggle.classList.remove('btn-danger', 'text-white');
                        heatmapToggle.style.background = '#0f172a';
                        heatmapToggle.style.color = '#f8fafc';
                        heatmapToggle.style.borderColor = '#1e293b';
                        heatmapToggle.innerHTML = '<i class="bi bi-fire text-danger"></i> Mode Heatmap';
                        if (legendEl) legendEl.style.display = 'none';
                        if (pinLegendEl) pinLegendEl.style.display = 'block';
                    }
                    applyHitSafeFiltersAndRender(false);
                });
            }

            hitSafeFiltersInitialized = true;
        }

        function buildPointPopup(type, point) {
            const badgeMap = {
                hazard: { text: 'Hazard', className: 'hitsafe-popup-badge-hazard', detailLabel: 'Detail Temuan' },
                inspection: { text: 'Inspection', className: 'hitsafe-popup-badge-inspection', detailLabel: 'Jenis Inspeksi' },
                p5m: { text: 'P5M', className: 'hitsafe-popup-badge-p5m', detailLabel: 'Topik P5M' },
                safetytalk: { text: 'Safety Talk', className: 'hitsafe-popup-badge-safetytalk', detailLabel: 'Judul / Materi' }
            };
            const meta = badgeMap[type] || badgeMap.inspection;
            const isHazard = type === 'hazard';

            const rows = [];
            if (point.area) {
                rows.push('<div class="hitsafe-popup-label">Area</div><div class="hitsafe-popup-value">' + escapeHtml(point.area) + '</div>');
            }
            if (point.tanggal) {
                rows.push('<div class="hitsafe-popup-label">Tanggal</div><div class="hitsafe-popup-value">' + escapeHtml(point.tanggal) + '</div>');
            }
            if (point.nama) {
                rows.push('<div class="hitsafe-popup-label">Pelapor</div><div class="hitsafe-popup-value">' + escapeHtml(point.nama) + '</div>');
            }
            if (isHazard && point.resiko) {
                rows.push('<div class="hitsafe-popup-label">Risiko</div><div class="hitsafe-popup-value">' + escapeHtml(point.resiko) + '</div>');
            }
            if (isHazard && point.status) {
                rows.push('<div class="hitsafe-popup-label">Status</div><div class="hitsafe-popup-value">' + escapeHtml(point.status) + '</div>');
            }

            const detailBlock = point.detail
                ? '<div class="hitsafe-popup-detail"><strong>' + meta.detailLabel + ':</strong><br>' + escapeHtml(point.detail) + '</div>'
                : '';

            const photoClass = _hitSafeIsAdmin ? 'hitsafe-popup-photo' : 'hitsafe-popup-photo hitsafe-blurred-photo';
            const photoBlock = (_hitSafeCanViewPhoto && point.photoUrl)
                ? '<div class="hitsafe-popup-photo-wrap"><img class="' + photoClass + '" src="' + escapeHtml(point.photoUrl) + '" alt="Foto laporan" loading="lazy" /></div>'
                : '';

            return [
                '<div class="hitsafe-popup">',
                '<div class="hitsafe-popup-header">',
                '<div class="hitsafe-popup-title">Laporan Area</div>',
                '<span class="hitsafe-popup-badge ' + meta.className + '">' + meta.text + '</span>',
                '</div>',
                '<div class="hitsafe-popup-grid">',
                rows.join(''),
                '</div>',
                photoBlock,
                detailBlock,
                '</div>'
            ].join('');
        }

        function renderHitSafeReportPoints() {
            if (!hitSafeReportLayer) {
                return { count: 0, bounds: null };
            }

            hitSafeReportLayer.clearLayers();
            hitSafeMarkerByKey.clear();
            if (hitSafeClusterLayer) {
                hitSafeClusterLayer.clearLayers();
            }
            if (hitSafeHeatLayer && hitSafeMap) {
                hitSafeMap.removeLayer(hitSafeHeatLayer);
                hitSafeHeatLayer = null;
            }

            hitSafeFilteredPoints = filterHitSafePoints();
            const bounds = [];

            if (hitSafeHeatmapMode) {
                const heatPoints = [];
                hitSafeFilteredPoints.forEach(function(point) {
                    bounds.push([point.lat, point.lon]);
                    if (point.type === 'hazard') {
                        let weight = 0.5;
                        const risk = String(point.resiko || '').toLowerCase();
                        if (risk.includes('extreme') || risk.includes('ekstrem') || risk.includes('sangat berat') || risk.includes('kritis')) {
                            weight = 1.0;
                        } else if (risk.includes('high') || risk.includes('tinggi') || risk.includes('berat')) {
                            weight = 0.8;
                        } else if (risk.includes('medium') || risk.includes('sedang')) {
                            weight = 0.5;
                        } else {
                            weight = 0.2;
                        }
                        heatPoints.push([point.lat, point.lon, weight]);
                    }
                });

                if (typeof L.heatLayer === 'function') {
                    hitSafeHeatLayer = L.heatLayer(heatPoints, {
                        radius: 35,
                        blur: 20,
                        maxZoom: 18
                    }).addTo(hitSafeMap);
                }
            } else {
                // Urutkan titik agar Hazard di-render paling akhir (tampil paling atas)
                hitSafeFilteredPoints.sort(function(a, b) {
                    if (a.type === 'hazard' && b.type !== 'hazard') return 1;
                    if (a.type !== 'hazard' && b.type === 'hazard') return -1;
                    return 0;
                });

                hitSafeFilteredPoints.forEach(function(point) {
                    const popup = buildPointPopup(point.type, point);
                    const markerColors = {
                        inspection: '#3b82f6',
                        p5m: '#10b981',
                        safetytalk: '#f59e0b'
                    };
                    
                    let markerColor = markerColors[point.type] || '#3b82f6';
                    
                    // Prioritas warna marker untuk Hazard berdasarkan resiko dan status
                    if (point.type === 'hazard') {
                        const status = String(point.status || '').toLowerCase();
                        const risk = String(point.resiko || '').toLowerCase();
                        
                        if (status === 'closed' || status === 'close') {
                            markerColor = '#10b981'; // Hijau untuk yang sudah close
                        } else {
                            if (risk.includes('extreme') || risk.includes('ekstrem') || risk.includes('sangat berat') || risk.includes('kritis')) {
                                markerColor = '#991b1b'; // Merah gelap
                            } else if (risk.includes('high') || risk.includes('tinggi') || risk.includes('berat')) {
                                markerColor = '#ef4444'; // Merah
                            } else if (risk.includes('medium') || risk.includes('sedang')) {
                                markerColor = '#f59e0b'; // Oranye
                            } else if (risk.includes('low') || risk.includes('rendah')) {
                                markerColor = '#eab308'; // Kuning
                            } else {
                                markerColor = '#f43f5e'; // Default warna merah muda/hazard
                            }
                        }
                    }

                    const marker = L.marker([point.lat, point.lon], {
                        icon: L.divIcon({
                            className: 'hitsafe-map-pin-wrapper',
                            html: '<span style="display:block;width:14px;height:14px;border-radius:50%;border:2px solid #ffffff;background:' + markerColor + ';box-shadow:0 0 0 1px rgba(15,23,42,0.7);"></span>',
                            iconSize: [14, 14],
                            iconAnchor: [7, 7]
                        })
                    }).bindPopup(popup, {
                        maxWidth: 320,
                        className: 'hitsafe-popup-shell'
                    });

                    hitSafeMarkerByKey.set(point.key, marker);

                    if (hitSafeClusterLayer) {
                        hitSafeClusterLayer.addLayer(marker);
                    } else {
                        marker.addTo(hitSafeReportLayer);
                    }

                    bounds.push([point.lat, point.lon]);
                });
            }

            // Calculate and display Danger Zones (Hazard >= 69%) in the floating panel
            const dangerPanel = document.getElementById('hitsafeDangerZonesPanel');
            const dangerList = document.getElementById('hitsafeDangerZonesList');
            if (dangerPanel && dangerList) {
                dangerList.innerHTML = '';
                const dangerAreas = [];

                // Group filtered points by area name
                const areaGroups = new Map();
                hitSafeFilteredPoints.forEach(function(point) {
                    if (!point.area) return;
                    const areaKey = point.area.trim().toLowerCase();
                    if (!areaGroups.has(areaKey)) {
                        areaGroups.set(areaKey, { name: point.area, points: [] });
                    }
                    areaGroups.get(areaKey).points.push(point);
                });

                areaGroups.forEach(function(group) {
                    const total = group.points.length;
                    if (total < 2) return;

                    const hazardsCount = group.points.filter(p => p.type === 'hazard').length;
                    const hazardPercent = (hazardsCount / total) * 100;

                    if (hazardPercent >= 69) {
                        dangerAreas.push({
                            name: group.name,
                            percent: Math.round(hazardPercent),
                            hazards: hazardsCount,
                            total: total,
                            points: group.points
                        });
                    }
                });

                if (dangerAreas.length > 0) {
                    dangerPanel.style.display = 'block';
                    dangerAreas.forEach(function(area) {
                        const item = document.createElement('div');
                        item.style.padding = '8px';
                        item.style.background = 'rgba(244, 63, 94, 0.08)';
                        item.style.border = '1px solid rgba(244, 63, 94, 0.3)';
                        item.style.borderRadius = '8px';
                        item.style.cursor = 'pointer';
                        item.style.marginBottom = '4px';
                        item.style.transition = 'all 0.2s';
                        item.className = 'danger-zone-item';
                        item.innerHTML = '<div style="font-weight:700; color:#f8fafc; font-size:11px; margin-bottom:2px;">' + escapeHtml(area.name) + '</div>' +
                                         '<div style="color:#f43f5e; font-weight:800; font-size:10px; display:flex; align-items:center; gap:4px;">' +
                                         '<span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#f43f5e;"></span>' +
                                         'Rawan (' + area.percent + '% Hazard)</div>' +
                                         '<div style="font-size:9.5px; color:#94a3b8; margin-top:2px;">' + area.hazards + ' dari ' + area.total + ' laporan</div>';

                        item.addEventListener('mouseenter', function() {
                            item.style.background = 'rgba(244, 63, 94, 0.2)';
                            item.style.borderColor = 'rgba(244, 63, 94, 0.5)';
                        });
                        item.addEventListener('mouseleave', function() {
                            item.style.background = 'rgba(244, 63, 94, 0.08)';
                            item.style.borderColor = 'rgba(244, 63, 94, 0.3)';
                        });

                        item.addEventListener('click', function() {
                            let sumLat = 0, sumLon = 0;
                            area.points.forEach(p => {
                                sumLat += p.lat;
                                sumLon += p.lon;
                            });
                            const avgLat = sumLat / area.total;
                            const avgLon = sumLon / area.total;
                            if (hitSafeMap) {
                                hitSafeMap.flyTo([avgLat, avgLon], 15);
                            }
                        });

                        dangerList.appendChild(item);
                    });
                } else {
                    dangerPanel.style.display = 'none';
                }
            }

            return {
                count: bounds.length,
                bounds: bounds.length > 0 ? L.latLngBounds(bounds) : null
            };
        }

        function renderKaliorangFallback() {
            if (!hitSafeAnchorLayer) {
                return;
            }

            hitSafeAnchorLayer.clearLayers();
            L.marker([kaliorangLat, kaliorangLon])
                .bindPopup('<strong>Kaliorang, Kalimantan Timur</strong><br>Area fokus Safe Map.')
                .addTo(hitSafeAnchorLayer);

            L.circle([kaliorangLat, kaliorangLon], {
                radius: 1800,
                color: '#0ea5e9',
                weight: 2,
                fillColor: '#38bdf8',
                fillOpacity: 0.15
            }).addTo(hitSafeAnchorLayer);
        }

        function applyUserLocation(position) {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            const accuracy = Math.max(25, Math.round(position.coords.accuracy || 25));

            if (hitSafeUserMarker) {
                hitSafeMap.removeLayer(hitSafeUserMarker);
                hitSafeUserMarker = null;
            }
            if (hitSafeUserAccuracyCircle) {
                hitSafeMap.removeLayer(hitSafeUserAccuracyCircle);
                hitSafeUserAccuracyCircle = null;
            }

            hitSafeUserMarker = L.marker([lat, lon], {
                icon: hitSafeUserIcon
            }).addTo(hitSafeMap)
                .bindPopup('<strong>Lokasi Anda Saat Ini</strong><br>Map diposisikan ke GPS browser.');
            hitSafeUserAccuracyCircle = L.circle([lat, lon], {
                radius: accuracy,
                color: '#16a34a',
                weight: 2,
                fillColor: '#4ade80',
                fillOpacity: 0.18
            }).addTo(hitSafeMap);

            if (hitSafeAutoCenter) {
                hitSafeMap.setView([lat, lon], 15);
            }
            window.setTimeout(function() {
                if (hitSafeMap) {
                    hitSafeMap.invalidateSize();
                }
            }, 120);
        }

        function fallbackToKaliorang() {
            if (!hitSafeMap) {
                return;
            }

            if (hitSafeUserMarker) {
                hitSafeMap.removeLayer(hitSafeUserMarker);
                hitSafeUserMarker = null;
            }
            if (hitSafeUserAccuracyCircle) {
                hitSafeMap.removeLayer(hitSafeUserAccuracyCircle);
                hitSafeUserAccuracyCircle = null;
            }

            const reportSummary = renderHitSafeReportPoints();
            if (reportSummary.bounds) {
                hitSafeMap.fitBounds(reportSummary.bounds.pad(0.2));
            } else {
                renderKaliorangFallback();
                hitSafeMap.setView([kaliorangLat, kaliorangLon], 11);
            }
        }

        function updateHitSafeToUserLocation() {
            if (!hitSafeMap || typeof navigator === 'undefined' || !navigator.geolocation) {
                return;
            }

            navigator.geolocation.getCurrentPosition(function(position) {
                applyUserLocation(position);
            }, function() {
                fallbackToKaliorang();
            }, {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 15000
            });
        }

        window.stopHitSafeLocationTracking = function() {
            if (typeof navigator !== 'undefined' && navigator.geolocation && hitSafeWatchId !== null) {
                navigator.geolocation.clearWatch(hitSafeWatchId);
            }
            hitSafeWatchId = null;
        };

        function startHitSafeLocationTracking() {
            if (!hitSafeMap || typeof navigator === 'undefined' || !navigator.geolocation || hitSafeWatchId !== null) {
                return;
            }

            hitSafeWatchId = navigator.geolocation.watchPosition(function(position) {
                applyUserLocation(position);
            }, function() {
                fallbackToKaliorang();
                window.stopHitSafeLocationTracking();
            }, {
                enableHighAccuracy: true,
                timeout: 15000,
                maximumAge: 10000
            });
        }

        window.initHitSafeMap = function(retryCount) {
            const container = document.getElementById('hitsafeLeafletMap');
            if (!container) {
                return;
            }

            if (typeof L === 'undefined') {
                container.innerHTML = '<div style="height:100%;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--text-muted);">Leaflet belum termuat.</div>';
                return;
            }

            const rect = container.getBoundingClientRect();
            if (rect.width <= 0 || rect.height <= 0) {
                const attemptsLeft = typeof retryCount === 'number' ? retryCount : 15;
                if (attemptsLeft > 0) {
                    window.setTimeout(function() {
                        window.initHitSafeMap(attemptsLeft - 1);
                    }, 120);
                }
                return;
            }

            if (!hitSafeMap) {
                hitSafeMap = L.map('hitsafeLeafletMap', {
                    attributionControl: false,
                    maxZoom: 19
                }).setView([kaliorangLat, kaliorangLon], 11);
                const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                });
                const satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    maxZoom: 19,
                    attribution: 'Tiles &copy; Esri'
                });
                const darkLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                    maxZoom: 19,
                    attribution: '&copy; CartoDB'
                });
                
                satelliteLayer.addTo(hitSafeMap);
                
                const baseMaps = {
                    "Satelit": satelliteLayer,
                    "Gelap (Dark)": darkLayer,
                    "Terang (OSM)": osmLayer
                };
                L.control.layers(baseMaps).addTo(hitSafeMap);
                hitSafeAnchorLayer = L.layerGroup().addTo(hitSafeMap);
                hitSafeReportLayer = L.layerGroup().addTo(hitSafeMap);
                if (typeof L.markerClusterGroup === 'function') {
                    hitSafeClusterLayer = L.markerClusterGroup({
                        showCoverageOnHover: false,
                        spiderfyOnMaxZoom: true,
                        disableClusteringAtZoom: 16,
                        maxClusterRadius: 40
                    }).addTo(hitSafeMap);
                }

                hitSafeAllPoints = buildHitSafeSourcePoints();
                initHitSafeFilters();
                applyHitSafeFiltersAndRender(true);

                // Disable auto-centering when the user interacts with the map
                hitSafeMap.on('dragstart zoomstart movestart', function() {
                    hitSafeAutoCenter = false;
                    const locateButton = document.getElementById('hitsafeLocateBtn');
                    if (locateButton) {
                        locateButton.classList.remove('btn-success', 'text-white');
                        locateButton.style.background = '#0f172a';
                        locateButton.style.color = '#f8fafc';
                        locateButton.style.borderColor = '#1e293b';
                        locateButton.innerHTML = '<i class="bi bi-crosshair"></i> Lokasi Saya';
                    }
                });

                if (hitSafeFilteredPoints.length === 0) {
                    renderKaliorangFallback();
                } else {
                    hitSafeAnchorLayer.clearLayers();
                }
            }

            if (!hitSafeGeolocAttempted) {
                hitSafeGeolocAttempted = true;
                updateHitSafeToUserLocation();
                startHitSafeLocationTracking();
            } else if (hitSafeUserMarker) {
                const userPoint = hitSafeUserMarker.getLatLng();
                hitSafeMap.setView([userPoint.lat, userPoint.lng], 15);
                startHitSafeLocationTracking();
            } else {
                updateHitSafeToUserLocation();
                startHitSafeLocationTracking();
            }

            window.setTimeout(function() {
                if (hitSafeMap) {
                    hitSafeMap.invalidateSize();
                }
            }, 120);
        };

        if (document.getElementById('sectionHitSafe') && document.getElementById('sectionHitSafe').style.display === 'block') {
            window.requestAnimationFrame(function() {
                window.initHitSafeMap(20);
            });
        }

    });

    // ==========================================
    // Analytics Tab Engine (MTD & YTD Graphs)
    // ==========================================
    let _analyticsData = null;
    let _employeeAnalyticsData = null;
    let _analyticsMode = 'mtd'; // 'mtd' | 'ytd'
    let _chartCompanyMtdYtdInstance = null;
    let _chartSaPillarsInstance = null;
    let _chartTopPerformersInstance = null;
    let _chartEmployeeComplianceDistInstance = null;
    let _chartHazardKtaTtaAnalyticsInstance = null;
    let _chartMultiMonthTrendInstance = null;
    let _chartKategoriBahayaInstance = null;
    let _companyKategoriMode = 'mtd';

    function switchCompanyKategoriTimeframe(mode) {
        _companyKategoriMode = mode;
        const btnMtd = document.getElementById('btnCompanyKategoriMtd');
        const btnYtd = document.getElementById('btnCompanyKategoriYtd');
        if (btnMtd && btnYtd) {
            if (mode === 'mtd') {
                btnMtd.classList.add('btn-primary', 'active');
                btnMtd.classList.remove('btn-outline-primary');
                btnYtd.classList.add('btn-outline-primary');
                btnYtd.classList.remove('btn-primary', 'active');
            } else {
                btnYtd.classList.add('btn-primary', 'active');
                btnYtd.classList.remove('btn-outline-primary');
                btnMtd.classList.add('btn-outline-primary');
                btnMtd.classList.remove('btn-primary', 'active');
            }
        }
        renderCompanyKategoriChart();
    }

    function renderCompanyKategoriChart() {
        const ctx = document.getElementById('chartKategoriBahaya');
        if (!ctx) return;

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || 
                       document.body.classList.contains('dark') || 
                       document.body.classList.contains('dark-theme');
        const textColor = isDark ? '#f8fafc' : '#0f172a';

        let ktaCount = 0;
        let ttaCount = 0;

        if (_companyKategoriMode === 'ytd') {
            ktaCount = @(ViewBag.UnsafeConditionCountYtd ?? 0);
            ttaCount = @(ViewBag.UnsafeActCountYtd ?? 0);
        } else {
            ktaCount = @(ViewBag.UnsafeConditionCount ?? 0);
            ttaCount = @(ViewBag.UnsafeActCount ?? 0);
        }

        if (_analyticsData && _analyticsData.hazardBreakdown) {
            const hb = _companyKategoriMode === 'ytd' ? _analyticsData.hazardBreakdown.ytd : _analyticsData.hazardBreakdown.mtd;
            if (hb) {
                ktaCount = hb.kta || 0;
                ttaCount = hb.tta || 0;
            }
        }

        const total = ktaCount + ttaCount;
        const ktaPct = total > 0 ? Math.round((ktaCount / total) * 1000) / 10 : 0;
        const ttaPct = total > 0 ? Math.round((ttaCount / total) * 1000) / 10 : 0;

        const ktaTextEl = document.getElementById('compKategoriKtaText');
        const ttaTextEl = document.getElementById('compKategoriTtaText');
        if (ktaTextEl) ktaTextEl.textContent = ktaCount.toLocaleString('id-ID') + ' (' + ktaPct + '%)';
        if (ttaTextEl) ttaTextEl.textContent = ttaCount.toLocaleString('id-ID') + ' (' + ttaPct + '%)';

        if (_chartKategoriBahayaInstance) {
            _chartKategoriBahayaInstance.destroy();
        }

        _chartKategoriBahayaInstance = new Chart(ctx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['KTA (Kondisi Tidak Aman)', 'TTA (Tindakan Tidak Aman)'],
                datasets: [{
                    data: [ktaCount, ttaCount],
                    backgroundColor: ['#3b82f6', '#f59e0b'],
                    borderWidth: 2,
                    borderColor: isDark ? '#1e293b' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: textColor, font: { weight: 'bold', size: 11 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const val = context.raw || 0;
                                const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                return ' ' + context.label + ': ' + val.toLocaleString('id-ID') + ' (' + pct + '%)';
                            }
                        }
                    }
                },
                cutout: '65%'
            }
        });
    }

    function setAnalyticsTimeframe(mode) {
        _analyticsMode = mode;
        const btnMtd = document.getElementById('btnModeMtd');
        const btnYtd = document.getElementById('btnModeYtd');
        if (btnMtd && btnYtd) {
            if (mode === 'mtd') {
                btnMtd.classList.add('btn-primary', 'active');
                btnMtd.classList.remove('btn-outline-primary');
                btnYtd.classList.add('btn-outline-primary');
                btnYtd.classList.remove('btn-primary', 'active');
            } else {
                btnYtd.classList.add('btn-primary', 'active');
                btnYtd.classList.remove('btn-outline-primary');
                btnMtd.classList.add('btn-outline-primary');
                btnMtd.classList.remove('btn-primary', 'active');
            }
        }
        renderAnalyticsUI();
    }

    async function loadAnalyticsTab(forceRefresh = false) {
        if (_analyticsData && _employeeAnalyticsData && !forceRefresh) {
            renderAnalyticsUI();
            return;
        }

        const selectedYear = '@ViewBag.SelectedYear' || new Date().getFullYear();
        const selectedMonth = '@ViewBag.SelectedMonth' || (new Date().getMonth() + 1);

        try {
            const refreshParam = forceRefresh ? '&refresh=true' : '';
            const [resCompany, resEmployee] = await Promise.all([
                fetch('/Performance/GetCompanyAnalyticsData?year=' + selectedYear + '&month=' + selectedMonth + refreshParam),
                fetch('/Performance/GetEmployeeAnalyticsData?year=' + selectedYear + '&month=' + selectedMonth + refreshParam)
            ]);

            if (resCompany.ok && resEmployee.ok) {
                _analyticsData = await resCompany.json();
                _employeeAnalyticsData = await resEmployee.json();
                renderAnalyticsUI();
                renderCompanyKategoriChart();
            } else {
                console.error('Failed to load analytics data', resCompany.status, resEmployee.status);
            }
        } catch (err) {
            console.error('Error loading analytics:', err);
        }
    }

    function applyAnalyticsFilters() {
        renderAnalyticsUI();
    }

    function renderAnalyticsUI() {
        renderYtdProgressionChart();
        if (!_analyticsData || !_employeeAnalyticsData) return;

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || 
                       document.body.classList.contains('dark') || 
                       document.body.classList.contains('dark-theme');
        const textColor = isDark ? '#f8fafc' : '#0f172a';
        const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';

        const isMtd = _analyticsMode === 'mtd';
        const tierFilter = document.getElementById('analyticsTierFilter')?.value || 'all';
        const pillarFilter = document.getElementById('analyticsPillarFilter')?.value || 'all';
        const searchQuery = (document.getElementById('analyticsSearchInput')?.value || '').trim().toLowerCase();

        // 1. Update KPI Summary Cards
        const sum = _analyticsData.summary || {};
        const totalActualEl = document.getElementById('kpiTotalActual');
        const totalTargetEl = document.getElementById('kpiTotalTarget');
        const avgRateEl = document.getElementById('kpiAvgRate');
        const subLabelEl = document.getElementById('kpiSubmissionsLabel');
        const rateLabelEl = document.getElementById('kpiRateLabel');
        const topCompEl = document.getElementById('kpiTopCompany');
        const topScoreEl = document.getElementById('kpiTopCompanyScore');
        const totalEmpEl = document.getElementById('kpiTotalEmployees');
        const totalCompEl = document.getElementById('kpiTotalCompanies');

        if (subLabelEl) subLabelEl.textContent = isMtd ? 'Realisasi SAP (MTD)' : 'Realisasi SAP (YTD)';
        if (rateLabelEl) rateLabelEl.textContent = isMtd ? 'Rata-rata Capaian (MTD)' : 'Rata-rata Capaian (YTD)';
        if (totalActualEl) totalActualEl.textContent = (isMtd ? sum.grandMtdActual : sum.grandYtdActual)?.toLocaleString('id-ID') || '0';
        if (totalTargetEl) totalTargetEl.textContent = (isMtd ? sum.grandMtdTarget : sum.grandYtdTarget)?.toLocaleString('id-ID') || '0';
        if (avgRateEl) avgRateEl.textContent = ((isMtd ? sum.avgMtdRate : sum.avgYtdRate) || 0) + '%';
        if (totalEmpEl) totalEmpEl.textContent = sum.totalEmployees?.toLocaleString('id-ID') || '0';
        if (totalCompEl) totalCompEl.textContent = sum.totalCompanies || '0';

        // Filter companies
        let companies = (_analyticsData.companies || []).slice();
        if (tierFilter !== 'all') {
            companies = companies.filter(c => String(c.tier || '').toLowerCase() === tierFilter.toLowerCase());
        }
        if (searchQuery) {
            companies = companies.filter(c => String(c.companyName || '').toLowerCase().includes(searchQuery));
        }

        // Sort companies based on selected pillar filter and timeframe mode
        companies.sort((a, b) => {
            let metricA = 0;
            let metricB = 0;
            if (pillarFilter === 'hazard') {
                metricA = isMtd ? Number(a.hazardMtd || 0) : Number(a.hazardYtd || 0);
                metricB = isMtd ? Number(b.hazardMtd || 0) : Number(b.hazardYtd || 0);
            } else if (pillarFilter === 'hazard_kta') {
                metricA = isMtd ? Number(a.hazardMtdKta || 0) : Number(a.hazardYtdKta || 0);
                metricB = isMtd ? Number(b.hazardMtdKta || 0) : Number(b.hazardYtdKta || 0);
            } else if (pillarFilter === 'hazard_tta') {
                metricA = isMtd ? Number(a.hazardMtdTta || 0) : Number(a.hazardYtdTta || 0);
                metricB = isMtd ? Number(b.hazardMtdTta || 0) : Number(b.hazardYtdTta || 0);
            } else if (pillarFilter === 'inspeksi') {
                metricA = isMtd ? Number(a.inspeksiMtd || 0) : Number(a.inspeksiYtd || 0);
                metricB = isMtd ? Number(b.inspeksiMtd || 0) : Number(b.inspeksiYtd || 0);
            } else if (pillarFilter === 'safetytalk') {
                metricA = isMtd ? Number(a.safetyTalkMtd || 0) : Number(a.safetyTalkYtd || 0);
                metricB = isMtd ? Number(b.safetyTalkMtd || 0) : Number(b.safetyTalkYtd || 0);
            } else if (pillarFilter === 'observasi') {
                metricA = isMtd ? Number(a.observasiMtd || 0) : Number(a.observasiYtd || 0);
                metricB = isMtd ? Number(b.observasiMtd || 0) : Number(b.observasiYtd || 0);
            } else if (pillarFilter === 'coaching') {
                metricA = isMtd ? Number(a.coachingMtd || 0) : Number(a.coachingYtd || 0);
                metricB = isMtd ? Number(b.coachingMtd || 0) : Number(b.coachingYtd || 0);
            } else if (pillarFilter === 'p5m') {
                metricA = isMtd ? Number(a.p5mMtd || 0) : Number(a.p5mYtd || 0);
                metricB = isMtd ? Number(b.p5mMtd || 0) : Number(b.p5mYtd || 0);
            } else {
                metricA = isMtd ? Number(a.mtdRate || 0) : Number(a.ytdRate || 0);
                metricB = isMtd ? Number(b.mtdRate || 0) : Number(b.ytdRate || 0);
            }
            return metricB - metricA;
        });

        if (companies.length > 0 && topCompEl) {
            const top = companies[0];
            topCompEl.textContent = top.companyName;
            const topRate = isMtd ? top.mtdRate : top.ytdRate;
            if (topScoreEl) topScoreEl.textContent = 'Skor: ' + topRate + '% (Peringkat #1)';
        }

        // 2. Render Chart Perusahaan (MTD vs YTD)
        const ctxCompany = document.getElementById('chartCompanyMtdYtd');
        const chartTitleEl = document.getElementById('chartCompanyTitle');
        const chartSubTitleEl = document.getElementById('chartCompanySubtitle');
        
        let chartMetricLabel = isMtd ? 'Kepatuhan MTD (%)' : 'Kepatuhan YTD (%)';
        let isPercentage = true;

        if (pillarFilter === 'hazard') {
            if (chartTitleEl) chartTitleEl.textContent = isMtd ? 'Laporan Hazard Report Perusahaan (MTD)' : 'Laporan Hazard Report Perusahaan (YTD)';
            if (chartSubTitleEl) chartSubTitleEl.textContent = 'Jumlah total temuan hazard dilaporkan per entitas perusahaan';
            chartMetricLabel = isMtd ? 'Laporan Hazard (MTD)' : 'Laporan Hazard (YTD)';
            isPercentage = false;
        } else if (pillarFilter === 'hazard_kta') {
            if (chartTitleEl) chartTitleEl.textContent = isMtd ? 'Hazard - Kondisi Tidak Aman / KTA (MTD)' : 'Hazard - Kondisi Tidak Aman / KTA (YTD)';
            if (chartSubTitleEl) chartSubTitleEl.textContent = 'Jumlah temuan bahaya fisik, fasilitas, dan lingkungan kerja per perusahaan';
            chartMetricLabel = isMtd ? 'Laporan KTA (MTD)' : 'Laporan KTA (YTD)';
            isPercentage = false;
        } else if (pillarFilter === 'hazard_tta') {
            if (chartTitleEl) chartTitleEl.textContent = isMtd ? 'Hazard - Tindakan Tidak Aman / TTA (MTD)' : 'Hazard - Tindakan Tidak Aman / TTA (YTD)';
            if (chartSubTitleEl) chartSubTitleEl.textContent = 'Jumlah temuan pelanggaran perilaku, SOP, dan APD per perusahaan';
            chartMetricLabel = isMtd ? 'Laporan TTA (MTD)' : 'Laporan TTA (YTD)';
            isPercentage = false;
        } else {
            if (chartTitleEl) chartTitleEl.textContent = isMtd ? 'Perbandingan Kepatuhan SAP Perusahaan (MTD %)' : 'Perbandingan Kepatuhan SAP Perusahaan (YTD %)';
            if (chartSubTitleEl) chartSubTitleEl.textContent = isMtd ? 'Pencapaian target bulan berjalan per entitas perusahaan' : 'Pencapaian akumulasi target tahun berjalan per entitas perusahaan';
        }

        if (ctxCompany) {
            if (_chartCompanyMtdYtdInstance) {
                _chartCompanyMtdYtdInstance.destroy();
            }

            const compLabels = companies.map(c => c.companyName);
            let compValues = [];
            let compColors = [];

            if (pillarFilter === 'hazard') {
                compValues = companies.map(c => isMtd ? (c.hazardMtd || 0) : (c.hazardYtd || 0));
                compColors = compValues.map(() => 'rgba(244, 63, 94, 0.85)');
            } else if (pillarFilter === 'hazard_kta') {
                compValues = companies.map(c => isMtd ? (c.hazardMtdKta || 0) : (c.hazardYtdKta || 0));
                compColors = compValues.map(() => 'rgba(59, 130, 246, 0.85)');
            } else if (pillarFilter === 'hazard_tta') {
                compValues = companies.map(c => isMtd ? (c.hazardMtdTta || 0) : (c.hazardYtdTta || 0));
                compColors = compValues.map(() => 'rgba(245, 158, 11, 0.85)');
            } else if (pillarFilter === 'inspeksi') {
                compValues = companies.map(c => isMtd ? (c.inspeksiMtd || 0) : (c.inspeksiYtd || 0));
                compColors = compValues.map(() => 'rgba(59, 130, 246, 0.85)');
            } else if (pillarFilter === 'safetytalk') {
                compValues = companies.map(c => isMtd ? (c.safetyTalkMtd || 0) : (c.safetyTalkYtd || 0));
                compColors = compValues.map(() => 'rgba(168, 85, 247, 0.85)');
            } else if (pillarFilter === 'observasi') {
                compValues = companies.map(c => isMtd ? (c.observasiMtd || 0) : (c.observasiYtd || 0));
                compColors = compValues.map(() => 'rgba(245, 158, 11, 0.85)');
            } else if (pillarFilter === 'coaching') {
                compValues = companies.map(c => isMtd ? (c.coachingMtd || 0) : (c.coachingYtd || 0));
                compColors = compValues.map(() => 'rgba(16, 185, 129, 0.85)');
            } else if (pillarFilter === 'p5m') {
                compValues = companies.map(c => isMtd ? (c.p5mMtd || 0) : (c.p5mYtd || 0));
                compColors = compValues.map(() => 'rgba(20, 184, 166, 0.85)');
            } else {
                compValues = companies.map(c => isMtd ? c.mtdRate : c.ytdRate);
                compColors = compValues.map(r => {
                    if (r >= 80) return 'rgba(16, 185, 129, 0.85)'; // Green
                    if (r >= 50) return 'rgba(245, 158, 11, 0.85)'; // Yellow
                    return 'rgba(239, 68, 68, 0.85)'; // Red
                });
            }

            _chartCompanyMtdYtdInstance = new Chart(ctxCompany.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: compLabels,
                    datasets: [{
                        label: chartMetricLabel,
                        data: compValues,
                        backgroundColor: compColors,
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const comp = companies[context.dataIndex];
                                    if (isPercentage) {
                                        const actual = isMtd ? comp.mtdActual : comp.ytdActual;
                                        const target = isMtd ? comp.mtdTarget : comp.ytdTarget;
                                        return 'Kepatuhan: ' + context.parsed.x + '% (' + actual + ' / ' + target + ')';
                                    } else {
                                        return chartMetricLabel + ': ' + context.parsed.x.toLocaleString('id-ID') + ' laporan';
                                    }
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: gridColor },
                            ticks: { color: textColor, font: { weight: 'bold' } },
                            suggestedMax: isPercentage ? 100 : undefined,
                            min: 0
                        },
                        y: {
                            grid: { display: false },
                            ticks: { color: textColor, font: { size: 11, weight: '600' } }
                        }
                    }
                }
            });
        }

        // 3. Render SA Pillars Radar Chart
        const ctxPillars = document.getElementById('chartSaPillars');
        if (ctxPillars && _analyticsData.saTypes) {
            if (_chartSaPillarsInstance) {
                _chartSaPillarsInstance.destroy();
            }

            const sa = _analyticsData.saTypes;
            const targetData = isMtd ? sa.mtdTargets : sa.ytdTargets;
            const actualData = isMtd ? sa.mtdActuals : sa.ytdActuals;

            _chartSaPillarsInstance = new Chart(ctxPillars.getContext('2d'), {
                type: 'radar',
                data: {
                    labels: sa.labels || ['Hazard', 'Inspeksi', 'Safety Talk', 'Observasi', 'Coaching', 'P5M'],
                    datasets: [
                        {
                            label: 'Realisasi (' + (isMtd ? 'MTD' : 'YTD') + ')',
                            data: actualData,
                            backgroundColor: 'rgba(2, 132, 199, 0.35)',
                            borderColor: '#0284c7',
                            borderWidth: 2.5,
                            pointBackgroundColor: '#0284c7',
                            pointRadius: 4
                        },
                        {
                            label: 'Target (' + (isMtd ? 'MTD' : 'YTD') + ')',
                            data: targetData,
                            backgroundColor: 'rgba(244, 63, 94, 0.15)',
                            borderColor: '#f43f5e',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            pointBackgroundColor: '#f43f5e',
                            pointRadius: 3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        r: {
                            angleLines: { color: gridColor },
                            grid: { color: gridColor },
                            pointLabels: { color: textColor, font: { weight: '700', size: 11 } },
                            ticks: { backdropColor: 'transparent', color: textColor, beginAtZero: true }
                        }
                    }
                }
            });
        }

        // 4. Render Top 10 Star Performers (Employee) Chart
        const ctxTopPerformers = document.getElementById('chartTopPerformers');
        if (ctxTopPerformers && _employeeAnalyticsData) {
            if (_chartTopPerformersInstance) {
                _chartTopPerformersInstance.destroy();
            }

            const topList = isMtd ? (_employeeAnalyticsData.topPerformersMtd || []) : (_employeeAnalyticsData.topPerformersYtd || []);
            const labels = topList.map(e => e.nama + ' (' + (e.namaDepartemen || 'General') + ')');
            const rates = topList.map(e => isMtd ? e.mtdRate : e.ytdRate);

            _chartTopPerformersInstance = new Chart(ctxTopPerformers.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Kepatuhan (%)',
                        data: rates,
                        backgroundColor: 'rgba(245, 158, 11, 0.85)',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const emp = topList[context.dataIndex];
                                    const actual = isMtd ? emp.mtdActual : emp.ytdActual;
                                    const target = isMtd ? emp.mtdTarget : emp.ytdTarget;
                                    return 'Capaian: ' + context.parsed.x + '% (' + actual + '/' + target + ' laporan) - ' + emp.namaPerusahaan;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: gridColor },
                            ticks: { color: textColor },
                            suggestedMax: 100,
                            min: 0
                        },
                        y: {
                            grid: { display: false },
                            ticks: { color: textColor, font: { size: 10, weight: 'bold' } }
                        }
                    }
                }
            });
        }

        // 5. Render Employee Compliance Distribution Doughnut Chart
        const ctxDist = document.getElementById('chartEmployeeComplianceDist');
        if (ctxDist && _employeeAnalyticsData && _employeeAnalyticsData.complianceDistribution) {
            if (_chartEmployeeComplianceDistInstance) {
                _chartEmployeeComplianceDistInstance.destroy();
            }

            const dist = _employeeAnalyticsData.complianceDistribution;
            const d100 = document.getElementById('distCount100');
            const d80 = document.getElementById('distCount80');
            const d50 = document.getElementById('distCount50');
            const dLow = document.getElementById('distCountLow');

            if (d100) d100.textContent = dist.tier100 || 0;
            if (d80) d80.textContent = dist.tier80 || 0;
            if (d50) d50.textContent = dist.tier50 || 0;
            if (dLow) dLow.textContent = dist.tierLow || 0;

            _chartEmployeeComplianceDistInstance = new Chart(ctxDist.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['100%+ (Sangat Patuh)', '80-99% (Patuh)', '50-79% (Cukup)', '<50% (Rendah)'],
                    datasets: [{
                        data: [dist.tier100 || 0, dist.tier80 || 0, dist.tier50 || 0, dist.tierLow || 0],
                        backgroundColor: ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444'],
                        borderWidth: 2,
                        borderColor: isDark ? '#1e293b' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: textColor, font: { size: 11, weight: 'bold' } } }
                    },
                    cutout: '65%'
                }
            });
        }

        // 5b. Render Hazard Breakdown (KTA vs TTA) Analytics Doughnut Chart & Cards
        const ctxHazBreakdown = document.getElementById('chartHazardKtaTtaAnalytics');
        const hazBreakdown = _analyticsData.hazardBreakdown;
        if (hazBreakdown) {
            const mtdHaz = hazBreakdown.mtd || { total: 0, kta: 0, tta: 0, ktaPct: 0, ttaPct: 0 };
            const ytdHaz = hazBreakdown.ytd || { total: 0, kta: 0, tta: 0, ktaPct: 0, ttaPct: 0 };
            const activeHaz = isMtd ? mtdHaz : ytdHaz;

            // Header labels
            const tfLabel = document.getElementById('hazardKtaTtaTimeframeLabel');
            const totalBadge = document.getElementById('badgeHazardTotalSelected');
            const legKta = document.getElementById('legendKtaPct');
            const legTta = document.getElementById('legendTtaPct');

            if (tfLabel) tfLabel.textContent = isMtd ? 'MTD' : 'YTD';
            if (totalBadge) totalBadge.textContent = (activeHaz.total || 0).toLocaleString('id-ID') + ' Laporan';
            if (legKta) legKta.textContent = (activeHaz.ktaPct || 0) + '% (' + (activeHaz.kta || 0).toLocaleString('id-ID') + ')';
            if (legTta) legTta.textContent = (activeHaz.ttaPct || 0) + '% (' + (activeHaz.tta || 0).toLocaleString('id-ID') + ')';

            // MTD Card elements
            const bHazMtdTotal = document.getElementById('badgeHazMtdTotal');
            const vHazMtdKta = document.getElementById('valHazMtdKta');
            const barHazMtdKta = document.getElementById('progHazMtdKta');
            const vHazMtdTta = document.getElementById('valHazMtdTta');
            const barHazMtdTta = document.getElementById('progHazMtdTta');

            if (bHazMtdTotal) bHazMtdTotal.textContent = (mtdHaz.total || 0).toLocaleString('id-ID') + ' Laporan';
            if (vHazMtdKta) vHazMtdKta.innerHTML = (mtdHaz.kta || 0).toLocaleString('id-ID') + ' (<span id="pctHazMtdKta">' + (mtdHaz.ktaPct || 0) + '%</span>)';
            if (barHazMtdKta) barHazMtdKta.style.width = Math.min(100, mtdHaz.ktaPct || 0) + '%';
            if (vHazMtdTta) vHazMtdTta.innerHTML = (mtdHaz.tta || 0).toLocaleString('id-ID') + ' (<span id="pctHazMtdTta">' + (mtdHaz.ttaPct || 0) + '%</span>)';
            if (barHazMtdTta) barHazMtdTta.style.width = Math.min(100, mtdHaz.ttaPct || 0) + '%';

            // YTD Card elements
            const bHazYtdTotal = document.getElementById('badgeHazYtdTotal');
            const vHazYtdKta = document.getElementById('valHazYtdKta');
            const barHazYtdKta = document.getElementById('progHazYtdKta');
            const vHazYtdTta = document.getElementById('valHazYtdTta');
            const barHazYtdTta = document.getElementById('progHazYtdTta');

            if (bHazYtdTotal) bHazYtdTotal.textContent = (ytdHaz.total || 0).toLocaleString('id-ID') + ' Laporan';
            if (vHazYtdKta) vHazYtdKta.innerHTML = (ytdHaz.kta || 0).toLocaleString('id-ID') + ' (<span id="pctHazYtdKta">' + (ytdHaz.ktaPct || 0) + '%</span>)';
            if (barHazYtdKta) barHazYtdKta.style.width = Math.min(100, ytdHaz.ktaPct || 0) + '%';
            if (vHazYtdTta) vHazYtdTta.innerHTML = (ytdHaz.tta || 0).toLocaleString('id-ID') + ' (<span id="pctHazYtdTta">' + (ytdHaz.ttaPct || 0) + '%</span>)';
            if (barHazYtdTta) barHazYtdTta.style.width = Math.min(100, ytdHaz.ttaPct || 0) + '%';

            // Dynamic Insight Note
            const insightEl = document.getElementById('hazardKtaTtaInsightText');
            if (insightEl) {
                if (activeHaz.total === 0) {
                    insightEl.textContent = 'Belum ada data laporan hazard pada periode ' + (isMtd ? 'MTD bulan ini' : 'YTD tahun ini') + '.';
                } else if (activeHaz.kta > activeHaz.tta) {
                    insightEl.textContent = 'Temuan Kondisi Tidak Aman (KTA) mendominasi (' + activeHaz.ktaPct + '%). Disarankan fokus pada perbaikan fasilitas fisik, infrastruktur kerja, perbaikan alat, dan housekeeping.';
                } else if (activeHaz.tta > activeHaz.kta) {
                    insightEl.textContent = 'Temuan Tindakan Tidak Aman (TTA) mendominasi (' + activeHaz.ttaPct + '%). Disarankan meningkatkan observasi keselamatan, briefing SOP, coaching pekerja, dan penegakan kepatuhan APD.';
                } else {
                    insightEl.textContent = 'Proporsi temuan KTA dan TTA seimbang (' + activeHaz.ktaPct + '% vs ' + activeHaz.ttaPct + '%). Pertahankan pengawasan terintegrasi pada aspek fisik lingkungan kerja dan perilaku aman pekerja.';
                }
            }

            // Doughnut chart rendering
            if (ctxHazBreakdown) {
                if (_chartHazardKtaTtaAnalyticsInstance) {
                    _chartHazardKtaTtaAnalyticsInstance.destroy();
                }

                _chartHazardKtaTtaAnalyticsInstance = new Chart(ctxHazBreakdown.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['KTA (Kondisi Tidak Aman)', 'TTA (Tindakan Tidak Aman)'],
                        datasets: [{
                            data: [activeHaz.kta || 0, activeHaz.tta || 0],
                            backgroundColor: ['#3b82f6', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: isDark ? '#1e293b' : '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const val = context.raw || 0;
                                        const pct = activeHaz.total > 0 ? ((val / activeHaz.total) * 100).toFixed(1) : 0;
                                        return ' ' + context.label + ': ' + val.toLocaleString('id-ID') + ' (' + pct + '%)';
                                    }
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            }
        }

        // 6. Populate Super League Company Standings (Top 5 Preview)
        const tbodyComp = document.getElementById('tbodyCompanyStandings');
        if (tbodyComp) {
            if (companies.length === 0) {
                tbodyComp.innerHTML = '<tr><td colspan="9" class="text-center py-3 text-muted">Tidak ada data perusahaan yang sesuai filter.</td></tr>';
            } else {
                tbodyComp.innerHTML = companies.slice(0, 5).map((c, idx) => {
                    let rankDisplay = idx + 1;
                    if (idx === 0) rankDisplay = '🥇 1';
                    else if (idx === 1) rankDisplay = '🥈 2';
                    else if (idx === 2) rankDisplay = '🥉 3';

                    const tierClass = c.tier === 'Owner' ? 'tier-owner' : (c.tier === 'Maincon' ? 'tier-maincon' : 'tier-subcon');
                    const mtdRate = Number(c.mtdRate || 0);
                    const ytdRate = Number(c.ytdRate || 0);

                    const mtdBadgeClass = mtdRate >= 80 ? 'text-success' : (mtdRate >= 50 ? 'text-warning' : 'text-danger');
                    const ytdBadgeClass = ytdRate >= 80 ? 'text-success' : (ytdRate >= 50 ? 'text-warning' : 'text-danger');

                    // Mini pillar badges
                    const pHaz = c.hazardMtd > 0 ? '<span class="pillar-mini-badge pillar-mini-ok" title="Hazard: ' + c.hazardMtd + ' (KTA: ' + (c.hazardMtdKta || 0) + ' | TTA: ' + (c.hazardMtdTta || 0) + ')">H:' + c.hazardMtd + '</span>' : '<span class="pillar-mini-badge pillar-mini-danger">H:0</span>';
                    const pIns = c.inspeksiMtd > 0 ? '<span class="pillar-mini-badge pillar-mini-ok" title="Inspeksi: ' + c.inspeksiMtd + '">I:' + c.inspeksiMtd + '</span>' : '<span class="pillar-mini-badge pillar-mini-danger">I:0</span>';
                    const pSt = c.safetyTalkMtd > 0 ? '<span class="pillar-mini-badge pillar-mini-ok" title="Safety Talk: ' + c.safetyTalkMtd + '">ST:' + c.safetyTalkMtd + '</span>' : '<span class="pillar-mini-badge pillar-mini-danger">ST:0</span>';
                    const pObs = c.observasiMtd > 0 ? '<span class="pillar-mini-badge pillar-mini-ok" title="Observasi: ' + c.observasiMtd + '">O:' + c.observasiMtd + '</span>' : '<span class="pillar-mini-badge pillar-mini-warn">O:0</span>';
                    const pCoa = c.coachingMtd > 0 ? '<span class="pillar-mini-badge pillar-mini-ok" title="Coaching: ' + c.coachingMtd + '">C:' + c.coachingMtd + '</span>' : '<span class="pillar-mini-badge pillar-mini-warn">C:0</span>';

                    return `
                        <tr>
                            <td class="text-center fw-bold text-muted">${rankDisplay}</td>
                            <td class="fw-bold">${c.companyName}</td>
                            <td class="text-center"><span class="tier-pill ${tierClass}">${c.tier}</span></td>
                            <td class="text-center fw-bold">${c.activeEmployees}</td>
                            <td class="text-center">${c.mtdTarget}</td>
                            <td class="text-center fw-bold">${c.mtdActual}</td>
                            <td class="text-center fw-bold ${mtdBadgeClass}">${mtdRate}%</td>
                            <td class="text-center fw-bold ${ytdBadgeClass}">${ytdRate}%</td>
                            <td class="text-center">${pHaz} ${pIns} ${pSt} ${pObs} ${pCoa}</td>
                        </tr>
                    `;
                }).join('');
            }
        }

        // 7. Populate Top Employees Table
        const tbodyTopEmp = document.getElementById('tbodyTopEmployees');
        if (tbodyTopEmp && _employeeAnalyticsData) {
            const topList = isMtd ? (_employeeAnalyticsData.topPerformersMtd || []) : (_employeeAnalyticsData.topPerformersYtd || []);
            if (topList.length === 0) {
                tbodyTopEmp.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Belum ada data.</td></tr>';
            } else {
                tbodyTopEmp.innerHTML = topList.slice(0, 10).map((e, idx) => {
                    return `
                        <tr>
                            <td class="text-center fw-bold text-muted">${idx + 1}</td>
                            <td>
                                <div class="fw-bold">${e.nama}</div>
                                <small class="text-muted">${e.nik}</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width: 160px;" title="${e.namaPerusahaan}">${e.namaPerusahaan}</div>
                                <small class="text-muted">${e.namaDepartemen || 'General'}</small>
                            </td>
                            <td class="text-center fw-bold text-success">${e.mtdRate}% (${e.mtdActual}/${e.mtdTarget})</td>
                            <td class="text-center fw-bold text-primary">${e.ytdRate}%</td>
                        </tr>
                    `;
                }).join('');
            }
        }

        // 8. Populate Low Compliance Table
        const tbodyLow = document.getElementById('tbodyLowCompliance');
        const lowBadge = document.getElementById('badgeLowComplianceCount');
        if (tbodyLow && _employeeAnalyticsData) {
            const lowList = _employeeAnalyticsData.lowCompliance || [];
            if (lowBadge) lowBadge.textContent = lowList.length + ' Karyawan';

            if (lowList.length === 0) {
                tbodyLow.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Luar biasa! Tidak ada karyawan di bawah 50% target.</td></tr>';
            } else {
                tbodyLow.innerHTML = lowList.slice(0, 15).map((e, idx) => {
                    return `
                        <tr>
                            <td class="text-center fw-bold text-muted">${idx + 1}</td>
                            <td>
                                <div class="fw-bold">${e.nama}</div>
                                <small class="text-muted">${e.nik}</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width: 140px;" title="${e.namaPerusahaan}">${e.namaPerusahaan}</div>
                                <small class="text-muted">${e.namaDepartemen || 'General'}</small>
                            </td>
                            <td class="text-center">${e.mtdTarget}</td>
                            <td class="text-center fw-bold text-danger">${e.mtdActual}</td>
                            <td class="text-center"><span class="badge bg-danger-subtle text-danger border border-danger-subtle">${e.mtdRate}%</span></td>
                        </tr>
                    `;
                }).join('');
            }
        }

        // 9. Render Multi-Month Trend Chart
        const ctxMultiTrend = document.getElementById('chartMultiMonthTrend');
        if (ctxMultiTrend && _analyticsData.monthlyTrend) {
            if (_chartMultiMonthTrendInstance) {
                _chartMultiMonthTrendInstance.destroy();
            }

            const tr = _analyticsData.monthlyTrend;
            const labels = tr.map(t => t.monthLabel);

            _chartMultiMonthTrendInstance = new Chart(ctxMultiTrend.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Hazard Report', data: tr.map(t => t.hazards), borderColor: '#f43f5e', backgroundColor: 'rgba(244, 63, 94, 0.1)', tension: 0.3, fill: true, borderWidth: 2.5 },
                        { label: 'Inspeksi', data: tr.map(t => t.inspections), borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', tension: 0.3, fill: true, borderWidth: 2.5 },
                        { label: 'Safety Talk', data: tr.map(t => t.safetyTalks), borderColor: '#a855f7', backgroundColor: 'rgba(168, 85, 247, 0.1)', tension: 0.3, fill: true, borderWidth: 2.5 },
                        { label: 'Observasi', data: tr.map(t => t.observations || 0), borderColor: '#f59e0b', backgroundColor: 'rgba(245, 158, 11, 0.1)', tension: 0.3, fill: true, borderWidth: 2.5 },
                        { label: 'Coaching', data: tr.map(t => t.coachings || 0), borderColor: '#10b981', backgroundColor: 'rgba(16, 185, 129, 0.1)', tension: 0.3, fill: true, borderWidth: 2.5 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { color: textColor, font: { weight: 'bold' } } }
                    },
                    scales: {
                        x: { grid: { color: gridColor }, ticks: { color: textColor, font: { weight: 'bold' } } },
                        y: { grid: { color: gridColor }, ticks: { color: textColor, font: { weight: 'bold' } } }
                    }
                }
            });
        }
    }


    let _progressionCumulativeMode = false;
    let _chartYtdProgressionInstance = null;

    function setProgressionCumulativeMode(isCumulative) {
        _progressionCumulativeMode = isCumulative;
        const btnM = document.getElementById('btnProgMonthly');
        const btnC = document.getElementById('btnProgCumulative');
        if (btnM && btnC) {
            if (isCumulative) {
                btnC.classList.add('btn-primary', 'active');
                btnC.classList.remove('btn-outline-primary');
                btnM.classList.add('btn-outline-primary');
                btnM.classList.remove('btn-primary', 'active');
            } else {
                btnM.classList.add('btn-primary', 'active');
                btnM.classList.remove('btn-outline-primary');
                btnC.classList.add('btn-outline-primary');
                btnC.classList.remove('btn-primary', 'active');
            }
        }
        renderYtdProgressionChart();
    }

    function renderYtdProgressionChart() {
        if (!_analyticsData || !_analyticsData.ytdMonthlyProgression) return;

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || 
                       document.body.classList.contains('dark') || 
                       document.body.classList.contains('dark-theme');
        const textColor = isDark ? '#f8fafc' : '#0f172a';
        const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';

        const progList = _analyticsData.ytdMonthlyProgression || [];
        if (progList.length === 0) return;

        const pillar = document.getElementById('progPillarFilter')?.value || 'all';
        const isCum = _progressionCumulativeMode;

        // Metric calculations
        const totalYtd = progList[progList.length - 1]?.cumulative || 0;
        let peakMonth = progList[0];
        let sumTotal = 0;
        progList.forEach(p => {
            sumTotal += p.total;
            if (p.total > (peakMonth?.total || 0)) peakMonth = p;
        });
        const avgPerMonth = Math.round(sumTotal / Math.max(1, progList.length));
        const lastMonth = progList[progList.length - 1];
        const lastGrowth = lastMonth?.growthRate || 0;

        const mTotalEl = document.getElementById('metricProgTotalYtd');
        const mPeakEl = document.getElementById('metricProgPeakMonth');
        const mAvgEl = document.getElementById('metricProgAvgMonth');
        const mGrowthEl = document.getElementById('metricProgLastGrowth');

        if (mTotalEl) mTotalEl.textContent = totalYtd.toLocaleString('id-ID');
        if (mPeakEl) mPeakEl.textContent = (peakMonth?.monthShort || '-') + ' (' + (peakMonth?.total || 0).toLocaleString('id-ID') + ')';
        if (mAvgEl) mAvgEl.textContent = avgPerMonth.toLocaleString('id-ID') + ' / bln';
        if (mGrowthEl) {
            const growthSign = lastGrowth > 0 ? '+' : '';
            const growthClass = lastGrowth >= 0 ? 'text-success' : 'text-danger';
            const growthIcon = lastGrowth >= 0 ? '<i class="bi bi-arrow-up-right"></i> ' : '<i class="bi bi-arrow-down-right"></i> ';
            mGrowthEl.innerHTML = `<span class="${growthClass}">${growthIcon}${growthSign}${lastGrowth}%</span>`;
        }

        // Prepare chart datasets
        const labels = progList.map(p => p.monthShort);
        let datasets = [];

        if (isCum) {
            // Cumulative YTD view
            datasets.push({
                type: 'line',
                label: 'Akumulasi Total SAP (YTD)',
                data: progList.map(p => p.cumulative),
                borderColor: '#0284c7',
                backgroundColor: 'rgba(2, 132, 199, 0.15)',
                borderWidth: 3,
                fill: true,
                tension: 0.35,
                pointRadius: 5,
                pointHoverRadius: 7,
                pointBackgroundColor: '#0284c7'
            });
        } else {
            // Monthly progression view
            if (pillar === 'total') {
                datasets.push({
                    type: 'bar',
                    label: 'Total Submission SAP',
                    data: progList.map(p => p.total),
                    backgroundColor: 'rgba(2, 132, 199, 0.85)',
                    borderRadius: 6
                });
                datasets.push({
                    type: 'line',
                    label: 'Trend Kenaikan',
                    data: progList.map(p => p.total),
                    borderColor: '#f59e0b',
                    borderWidth: 2.5,
                    tension: 0.35,
                    pointRadius: 4,
                    pointBackgroundColor: '#f59e0b',
                    fill: false
                });
            } else if (pillar === 'hazard') {
                datasets.push({
                    type: 'bar',
                    label: 'Hazard Report (Total)',
                    data: progList.map(p => p.hazards),
                    backgroundColor: 'rgba(244, 63, 94, 0.85)',
                    borderRadius: 6
                });
                datasets.push({
                    type: 'line',
                    label: 'Trend Hazard',
                    data: progList.map(p => p.hazards),
                    borderColor: '#f43f5e',
                    borderWidth: 2,
                    tension: 0.35,
                    pointRadius: 4,
                    pointBackgroundColor: '#f43f5e',
                    fill: false
                });
            } else if (pillar === 'hazard_kta') {
                datasets.push({
                    type: 'bar',
                    label: 'Hazard - KTA (Kondisi Tidak Aman)',
                    data: progList.map(p => p.hazardsKta || 0),
                    backgroundColor: 'rgba(59, 130, 246, 0.85)',
                    borderRadius: 6
                });
                datasets.push({
                    type: 'line',
                    label: 'Trend KTA',
                    data: progList.map(p => p.hazardsKta || 0),
                    borderColor: '#3b82f6',
                    borderWidth: 2,
                    tension: 0.35,
                    pointRadius: 4,
                    pointBackgroundColor: '#3b82f6',
                    fill: false
                });
            } else if (pillar === 'hazard_tta') {
                datasets.push({
                    type: 'bar',
                    label: 'Hazard - TTA (Tindakan Tidak Aman)',
                    data: progList.map(p => p.hazardsTta || 0),
                    backgroundColor: 'rgba(245, 158, 11, 0.85)',
                    borderRadius: 6
                });
                datasets.push({
                    type: 'line',
                    label: 'Trend TTA',
                    data: progList.map(p => p.hazardsTta || 0),
                    borderColor: '#f59e0b',
                    borderWidth: 2,
                    tension: 0.35,
                    pointRadius: 4,
                    pointBackgroundColor: '#f59e0b',
                    fill: false
                });
            } else if (pillar === 'hazard_both') {
                datasets.push(
                    {
                        type: 'bar',
                        label: 'KTA (Kondisi)',
                        data: progList.map(p => p.hazardsKta || 0),
                        backgroundColor: 'rgba(59, 130, 246, 0.85)',
                        borderRadius: 4
                    },
                    {
                        type: 'bar',
                        label: 'TTA (Tindakan)',
                        data: progList.map(p => p.hazardsTta || 0),
                        backgroundColor: 'rgba(245, 158, 11, 0.85)',
                        borderRadius: 4
                    },
                    {
                        type: 'line',
                        label: 'Total Hazard',
                        data: progList.map(p => p.hazards),
                        borderColor: '#f43f5e',
                        borderWidth: 2.5,
                        tension: 0.35,
                        pointRadius: 4,
                        pointBackgroundColor: '#f43f5e',
                        fill: false
                    }
                );
            } else if (pillar === 'inspeksi') {
                datasets.push({
                    type: 'bar',
                    label: 'Inspeksi',
                    data: progList.map(p => p.inspections),
                    backgroundColor: 'rgba(59, 130, 246, 0.85)',
                    borderRadius: 6
                });
            } else if (pillar === 'safetytalk') {
                datasets.push({
                    type: 'bar',
                    label: 'Safety Talk',
                    data: progList.map(p => p.safetyTalks),
                    backgroundColor: 'rgba(168, 85, 247, 0.85)',
                    borderRadius: 6
                });
            } else if (pillar === 'observasi') {
                datasets.push({
                    type: 'bar',
                    label: 'Observasi',
                    data: progList.map(p => p.observations),
                    backgroundColor: 'rgba(245, 158, 11, 0.85)',
                    borderRadius: 6
                });
            } else if (pillar === 'coaching') {
                datasets.push({
                    type: 'bar',
                    label: 'Coaching',
                    data: progList.map(p => p.coachings),
                    backgroundColor: 'rgba(16, 185, 129, 0.85)',
                    borderRadius: 6
                });
            } else if (pillar === 'p5m') {
                datasets.push({
                    type: 'bar',
                    label: 'P5M',
                    data: progList.map(p => p.p5ms),
                    backgroundColor: 'rgba(20, 184, 166, 0.85)',
                    borderRadius: 6
                });
            } else {
                // All Stacked
                datasets.push(
                    { type: 'bar', label: 'Hazard', data: progList.map(p => p.hazards), backgroundColor: 'rgba(244, 63, 94, 0.85)', stack: 'sap', borderRadius: 4 },
                    { type: 'bar', label: 'Inspeksi', data: progList.map(p => p.inspections), backgroundColor: 'rgba(59, 130, 246, 0.85)', stack: 'sap', borderRadius: 4 },
                    { type: 'bar', label: 'Safety Talk', data: progList.map(p => p.safetyTalks), backgroundColor: 'rgba(168, 85, 247, 0.85)', stack: 'sap', borderRadius: 4 },
                    { type: 'bar', label: 'Observasi', data: progList.map(p => p.observations), backgroundColor: 'rgba(245, 158, 11, 0.85)', stack: 'sap', borderRadius: 4 },
                    { type: 'bar', label: 'Coaching', data: progList.map(p => p.coachings), backgroundColor: 'rgba(16, 185, 129, 0.85)', stack: 'sap', borderRadius: 4 },
                    { type: 'bar', label: 'P5M', data: progList.map(p => p.p5ms), backgroundColor: 'rgba(20, 184, 166, 0.85)', stack: 'sap', borderRadius: 4 },
                    {
                        type: 'line',
                        label: 'Total Submission',
                        data: progList.map(p => p.total),
                        borderColor: '#0284c7',
                        borderWidth: 2.5,
                        tension: 0.35,
                        pointRadius: 4,
                        pointBackgroundColor: '#0284c7',
                        fill: false
                    }
                );
            }
        }

        const ctxProg = document.getElementById('chartYtdMonthlyProgression');
        if (ctxProg) {
            if (_chartYtdProgressionInstance) {
                _chartYtdProgressionInstance.destroy();
            }

            _chartYtdProgressionInstance = new Chart(ctxProg.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { color: textColor, font: { weight: 'bold', size: 11 } }
                        },
                        tooltip: {
                            callbacks: {
                                footer: function(tooltipItems) {
                                    if (tooltipItems.length > 0) {
                                        const idx = tooltipItems[0].dataIndex;
                                        const item = progList[idx];
                                        const growth = item.growthRate;
                                        const growthStr = idx === 0 ? 'Bulan Pertama' : ((growth >= 0 ? '+' : '') + growth + '% MoM');
                                        return 'Total: ' + item.total.toLocaleString('id-ID') + ' (KTA: ' + (item.hazardsKta || 0) + ' | TTA: ' + (item.hazardsTta || 0) + ') | Kenaikan: ' + growthStr;
                                    }
                                    return '';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: gridColor },
                            ticks: { color: textColor, font: { weight: 'bold' } }
                        },
                        y: {
                            grid: { color: gridColor },
                            ticks: { color: textColor }
                        }
                    }
                }
            });
        }

        // Populate Table
        const tbody = document.getElementById('tbodyYtdMonthlyProgression');
        if (tbody) {
            tbody.innerHTML = progList.map((p, idx) => {
                const growthVal = p.growthRate;
                let growthDisplay = idx === 0 
                    ? '<span class="badge bg-secondary-subtle text-secondary">-</span>' 
                    : (growthVal >= 0 
                        ? `<span class="badge bg-success-subtle text-success fw-bold"><i class="bi bi-arrow-up-right me-1"></i>+${growthVal}%</span>` 
                        : `<span class="badge bg-danger-subtle text-danger fw-bold"><i class="bi bi-arrow-down-right me-1"></i>${growthVal}%</span>`);

                return `
                    <tr>
                        <td class="fw-bold text-nowrap"><i class="bi bi-calendar2-month text-primary me-1"></i>${p.monthName}</td>
                        <td class="text-center fw-bold text-primary">${p.total.toLocaleString('id-ID')}</td>
                        <td class="text-center" title="KTA: ${p.hazardsKta || 0} | TTA: ${p.hazardsTta || 0}">
                            <span class="fw-bold">${p.hazards.toLocaleString('id-ID')}</span>
                            <small class="d-block text-muted" style="font-size: 10px;">(KTA:${p.hazardsKta || 0} | TTA:${p.hazardsTta || 0})</small>
                        </td>
                        <td class="text-center">${p.inspections.toLocaleString('id-ID')}</td>
                        <td class="text-center">${p.safetyTalks.toLocaleString('id-ID')}</td>
                        <td class="text-center">${p.observations.toLocaleString('id-ID')}</td>
                        <td class="text-center">${p.coachings.toLocaleString('id-ID')}</td>
                        <td class="text-center">${p.p5ms.toLocaleString('id-ID')}</td>
                        <td class="text-center">${growthDisplay}</td>
                    </tr>
                `;
            }).join('');
        }
    }

</script>
}



