                                                                <span class="badge" style="background: #eff6ff; color: #1d4ed8; font-size: 9.5px; font-weight: 600; border: 1px solid #bfdbfe;">
                                                                    <i class="bi bi-shield-check me-1"></i>Standar Akuntabilitas Departemen
                                                                </span>
                                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill btn-open-scoring-modal" 
                                                                        data-bs-toggle="modal" data-bs-target="#leagueScoringModal" 
                                                                        style="font-size: 10px; font-weight: 600;" 
                                                                        title="Buka rincian hitungan riil & metodologi departemen"
                                                                        data-type="departemen"
                                                                        data-name="@dept.DepartmentName"
                                                                        data-dept="@dept.DepartmentName"
                                                                        data-pos="Departemen"
                                                                        data-total-score="@dept.TotalScore"
                                                                        data-score-close="@dept.ScoreCloseRate"
                                                                        data-pts-close="@dept.PtsClose"
                                                                        data-ap-closed="@dept.ApClosed"
                                                                        data-ap-total="@dept.ApTotal"
                                                                        data-score-kualitas="@dept.ScoreKualitas"
                                                                        data-pts-kualitas="@dept.PtsKualitas"
                                                                        data-score-capaian="@dept.ScoreCapaian"
                                                                        data-pts-capaian="@dept.PtsCapaian"
                                                                        data-act-capaian="@dept.TotalActual"
                                                                        data-tgt-capaian="@dept.TotalTarget"
                                                                        data-compliance="@dept.MtdAchievementRate"
                                                                        data-score-beban="@dept.ScoreSkalaBeban"
                                                                        data-pts-beban="@dept.PtsBeban"
                                                                        data-user-target="@dept.TotalTarget"
                                                                        data-max-target="@dept.MaxTargetDept"
                                                                        data-kpi-hazard="@dept.HazardActual / @dept.HazardTarget"
                                                                        data-kpi-inspeksi="@dept.InspeksiActual / @dept.InspeksiTarget"
                                                                        data-kpi-safetytalk="@dept.SafetyTalkActual / @dept.SafetyTalkTarget"
                                                                        data-kpi-observasi="@dept.ObservasiActual / @dept.ObservasiTarget"
                                                                        data-kpi-coaching="@dept.CoachingActual / @dept.CoachingTarget"
                                                                        data-kpi-p5m="@dept.P5mActual / @dept.P5mTarget">
                                                                    <i class="bi bi-calculator me-1"></i>Detail Hitungan &amp; Panduan
                                                                </button>
                                                            </div>
                                                            <div>
                                                                <span class="badge px-3 py-1.5 rounded-pill shadow-xs" style="background: #0f172a; color: #38bdf8; font-size: 11.5px; font-weight: 700; border: 1px solid #334155;">
                                                                    Total Skor: <span class="text-white">@dept.TotalScore pts</span> (@dept.TotalScore%)
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- 4 Formula Cards -->
                                                        <div class="row g-2 g-md-3 text-center" style="font-size: 11px;">
                                                            <!-- 1. Capaian Target -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">1. Capaian Target</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dbeafe; color: #1d4ed8;">Bobot 35%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-primary">@dept.ScoreCapaian%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            35% &times; @dept.ScoreCapaian% = <strong class="text-dark">@dept.PtsCapaian pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Realisasi: <strong class="text-dark">@dept.TotalActual</strong></span>
                                                                            <span>Target: <strong class="text-dark">@dept.TotalTarget</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-graph-up me-1 text-primary"></i>Kepatuhan kuantitatif seluruh anggota departemen (@dept.MtdAchievementRate%).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 2. Close Rate -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">2. Close Rate</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dcfce7; color: #15803d;">Bobot 30%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-success">@dept.ScoreCloseRate%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            30% &times; @dept.ScoreCloseRate% = <strong class="text-dark">@dept.PtsClose pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Closed: <strong class="text-dark">@dept.ApClosed</strong></span>
                                                                            <span>Total: <strong class="text-dark">@dept.ApTotal AP</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-shield-check me-1 text-success"></i>Tingkat penutupan temuan bahaya &amp; action plan lingkup departemen.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 3. Kualitas Mutu -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">3. Kualitas Mutu</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #fef3c7; color: #b45309;">Bobot 25%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #d97706;">@dept.ScoreKualitas%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            25% &times; @dept.ScoreKualitas% = <strong class="text-dark">@dept.PtsKualitas pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Standar Mutu SAP</span>
                                                                            <span class="text-success fw-bold"><i class="bi bi-check-circle me-0.5"></i>5.0 / 5.0 ★</span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-patch-check me-1 text-warning"></i>Kualitas validasi data laporan K3 departemen (Baseline 100% tanpa penalti).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 4. Skala Beban -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">4. Skala Beban</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #e0e7ff; color: #4338ca;">Bobot 10%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #4338ca;">@dept.ScoreSkalaBeban%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            10% &times; @dept.ScoreSkalaBeban% = <strong class="text-dark">@dept.PtsBeban pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Target Dept: <strong class="text-dark">@dept.TotalTarget</strong></span>
                                                                            <span>Max Dept: <strong class="text-dark">@dept.MaxTargetDept</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-people me-1 text-indigo" style="color: #4338ca;"></i>Faktor keadilan beban operasional departemen vs departemen target terbesar.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Banner Rangkuman Akumulasi PTS Departemen -->
                                                        <div class="mt-2.5 p-2 px-3 rounded-2 d-flex flex-wrap align-items-center justify-content-between gap-2" style="background: #ffffff; border: 1px solid #e2e8f0; font-size: 11px;">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary" style="width: 22px; height: 22px; font-size: 11px; flex-shrink: 0;">
                                                                    <i class="bi bi-info-circle-fill"></i>
                                                                </div>
                                                                <div class="text-secondary" style="font-size: 11px; line-height: 1.4;">
                                                                    <strong class="text-dark">Akumulasi Skor PTS Departemen:</strong> (@dept.PtsCapaian pts) + (@dept.PtsClose pts) + (@dept.PtsKualitas pts) + (@dept.PtsBeban pts) = <strong class="text-primary fs-6">@dept.TotalScore pts (@dept.TotalScore%)</strong>
                                                                    <span class="text-muted d-none d-lg-inline ms-2">&bull; Standar penilaian agregat departemen terpadu.</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @{
                        var departmentRedZone = ViewBag.DepartmentRedZone as List<MBS_SAP.Controllers.DepartmentAchievementViewModel> ?? new List<MBS_SAP.Controllers.DepartmentAchievementViewModel>();
                        if (departmentRedZone.Any())
                        {
                            <div class="mt-4 p-3 rounded" style="background-color: #fef2f2; border: 1px solid #fca5a5;">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="bi bi-exclamation-triangle-fill text-danger me-2" style="font-size: 18px;"></i>
                                    <h6 class="mb-0 fw-bold text-danger">ZONA DEGRADASI (Target Ada, Pencapaian 0%)</h6>
                                </div>
                                <div class="table-responsive league-table-wrap">
                                    <table class="league-table">
                                        <thead>
                                            <tr>
                                                <th class="align-left">Klub (Departemen)</th>
                                                <th style="width: 80px;">Skuad</th>
                                                <th style="width: 105px; background-color: #991b1b; color: white;">Capaian (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var dept in departmentRedZone)
                                            {
                                                var shieldColor = GetDeptColor(dept.DepartmentName);
                                                var initials = GetDeptInitials(dept.DepartmentName);
                                                <tr class="league-tr-relegation dept-table-row" data-dept-name="@dept.DepartmentName" title="Klik untuk melihat skuad pemain @dept.DepartmentName" style="cursor: pointer;" onclick="filterPlayerTable('@dept.DepartmentName.Replace("'", "\\'")');">
                                                    <td class="align-left">
                                                        <div class="football-badge" style="background-color: @shieldColor;">@initials</div>
                                                        <span class="fw-bold" style="color: #991b1b;">@dept.DepartmentName</span>
                                                    </td>
                                                    <td class="text-center text-danger">@dept.EmployeeCount</td>
                                                    <td class="text-center fw-bold text-danger">0%</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }

                    <div class="legend-box mt-3">
                        <div class="legend-item">
                            <div class="legend-dot" style="background: #16a34a;"></div>
                            <span>80–100% (Hijau &bull; Tercapai / Patuh)</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-dot" style="background: #dc2626;"></div>
                            <span>40–79% (Merah &bull; Perlu Perhatian)</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-dot" style="background: #0f172a;"></div>
                            <span>0–39% (Hitam &bull; Kritis / Degradasi)</span>
                        </div>
                    </div>
                    <span class="text-muted mt-2 d-block" style="font-size: 11px; font-style: italic; line-height: 1.4;">
                        * Standar warna SOP diterapkan pada <strong>Aksen Baris &amp; Skor Total PTS</strong> (80–100 pts Hijau, 40–79 pts Merah, &lt;40 pts Hitam) serta sub-program K3 individual. Klik baris Departemen untuk menyaring skuad pemain.
                    </span>
                </div>
            }
        </div>

        <!-- Right: Player details / Squad Standings -->
        <div class="col-xl-5 is-fullheight-active" id="squadSection">
            <div class="league-card">
                <div class="top-scorers-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span>
                            <i class="bi @(squadTab == "volume" ? "bi-megaphone-fill text-info" : "bi-trophy-fill text-warning") me-1"></i>
                            @(squadTab == "volume" ? "Pelapor Terbanyak" : (currentMode == "company" || currentMode == "core" ? "Pemain Terbaik K3" : "Skuad Pemain K3"))
                        </span>
                        <!-- Toggle Tab Pill: Pemain Terbaik vs Pelapor Terbanyak -->
                        <div class="btn-group btn-group-sm p-0.5 rounded-pill bg-dark bg-opacity-50 border border-secondary border-opacity-50" role="group">
                            <button type="button" class="btn btn-sm py-0.5 px-2.5 rounded-pill fw-bold @(squadTab != "volume" ? "btn-warning text-dark shadow-sm" : "text-white-50 btn-link text-decoration-none")" onclick="switchSquadTab('best');" style="font-size: 10.5px;">
                                <i class="bi bi-trophy-fill me-1"></i>Pemain Terbaik
                            </button>
                            <button type="button" class="btn btn-sm py-0.5 px-2.5 rounded-pill fw-bold @(squadTab == "volume" ? "btn-info text-white shadow-sm" : "text-white-50 btn-link text-decoration-none")" onclick="switchSquadTab('volume');" style="font-size: 10.5px;">
                                <i class="bi bi-megaphone-fill me-1"></i>Pelapor Terbanyak
                            </button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <button type="button" class="btn btn-sm btn-outline-light d-none" id="resetFilterBtn" onclick="resetPlayerFilter();" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px;">
                            <i class="bi bi-x-circle me-1"></i> Tampilkan Semua
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light" id="toggleAllDetailsBtn" onclick="toggleAllDetails();" title="Tampilkan Semua Rincian Kepatuhan" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px; transition: all 0.2s;">
                            <i class="bi bi-eye" id="detailsIcon"></i> <span class="d-none d-md-inline ms-1" id="detailsText">Buka Rincian</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light" id="toggleFullHeightBtn" onclick="toggleSquadHeight();" title="Tinggi Penuh (Buka Scroll untuk Screenshot)" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px; transition: all 0.2s;">
                            <i class="bi bi-arrows-angle-expand" id="heightIcon"></i> <span class="d-none d-md-inline ms-1" id="heightText">Tinggi Penuh</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light" id="toggleFullscreenBtn" onclick="toggleSquadFullscreen();" title="Layar Penuh (Fokus Mode)" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px; transition: all 0.2s;">
                            <i class="bi bi-fullscreen" id="fullscreenIcon"></i> <span class="d-none d-md-inline ms-1" id="fullscreenText">Layar Penuh</span>
                        </button>
                    </div>
                </div>
                
                <div class="p-3">
                    <div class="squad-podium" id="squadPodium">
                        <!-- Populated dynamically via JS -->
                    </div>

                    <div class="alert alert-info py-2 px-3 mb-2 border-0 d-none align-items-center gap-2" id="filterAlert" style="border-radius: 8px; font-size: 12px; background-color: #f0f9ff; color: #0369a1;">
                        <i class="bi bi-info-circle-fill"></i>
                        <span id="filterAlertText"></span>
                    </div>

                    @{
                        var isVolumeMode = (squadTab == "volume");
                        var displayEmployees = isVolumeMode ? (topReporters ?? employees) : employees;
                    }

                    <!-- Search & Filter Bar -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="input-group input-group-sm" style="max-width: 280px;">
                            <span class="input-group-text bg-white text-muted border-end-0 py-1" style="font-size: 11px;"><i class="bi bi-search"></i></span>
                            <input type="text" id="playerSearchInput" class="form-control border-start-0 py-1" placeholder="Cari nama, NIK, jabatan..." style="font-size: 11px;" oninput="filterPlayerSearch();">
                            <button class="btn btn-outline-secondary border-start-0 py-1 px-2 d-none" type="button" id="clearPlayerSearchBtn" onclick="clearPlayerSearch();" style="font-size: 10px;">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                        <div class="d-flex align-items-center gap-1.5 text-muted" style="font-size: 10.5px;">
                            <span>Tampil: <strong class="text-dark" id="playerSearchCount">@(displayEmployees != null ? displayEmployees.Count : 0)</strong></span>
                            @if (!showAllPlayers && totalPlayerCount > 10)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 9.5px; font-weight: 700;">Top 10 Saja</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 9.5px; font-weight: 700;">Semua (@totalPlayerCount.ToString("N0"))</span>
                            }
                        </div>
                    </div>

                    <div class="table-responsive league-table-wrap" style="max-height: 520px; overflow-y: auto;">
                        <table class="league-table">
                            <thead>
                                <tr style="position: sticky; top: 0; z-index: 10;">
                                    <th style="width: 50px; background: #0f172a;">Pos</th>
                                    <th class="align-left" style="background: #0f172a;">Pemain</th>
                                    @if (isVolumeMode)
                                    {
                                        <th style="width: 115px; background: #0f172a;" title="Total Realisasi Laporan Safety dan Skor PTS">Laporan &amp; PTS</th>
                                    }
                                    else if (currentMode == "company" || currentMode == "core")
                                    {
                                        <th style="width: 110px; background: #0f172a;" title="Poin Total Skor agregat (4 Pilar) dan Persentase Capaian Target SAP">PTS &amp; Capaian</th>
                                    }
                                    else
                                    {
                                        <th style="width: 95px; background: #0f172a;" title="Persentase Kepatuhan Capaian Target (SOP)">Capaian %</th>
                                    }
                                    <th style="width: 110px; background: #0f172a;">Form (5 Program)</th>
                                    <th style="background: #0f172a; width: 80px;">Rincian</th>
                                </tr>
                            </thead>
                            <tbody id="playerTableBody">
                                @if (displayEmployees == null || displayEmployees.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">Tidak ada data pemain.</td>
                                    </tr>
                                }
                                else
                                {
                                    int empIdx = 0;
                                    var activeEmployeesList = displayEmployees.Cast<dynamic>().Where(e => (int)e.mtdTotalTarget > 0).ToList();
                                    int activePlayerCount = activeEmployeesList.Count;

                                    foreach (dynamic emp in displayEmployees)
                                    {
                                        empIdx++;
                                        var rowClass = "league-tr-normal";
                                        var rankClass = "";
                                        var rankText = empIdx.ToString();
                                        var zeroTarget = (emp.mtdTotalTarget == 0 || (emp.hasRoster && emp.onsiteDays == 0));
                                        double evalRate = (currentMode == "company" || currentMode == "core") ? (double)emp.totalScore : (double)emp.complianceRate;

                                        if (zeroTarget)
                                        {
                                            rowClass = "league-tr-normal";
                                            rankClass = "league-rank-no-movement";
                                            rankText = "-";
                                        }
                                        else if (empIdx <= 3)
                                        {
                                            rowClass = "league-tr-champions";
                                            rankClass = "league-rank-champions";
                                            if (empIdx == 1) rankText = "🥇 1";
                                            else if (empIdx == 2) rankText = "🥈 2";
                                            else if (empIdx == 3) rankText = "🥉 3";
                                        }
                                        else if (evalRate == 0)
                                        {
                                            rowClass = "league-tr-no-movement";
                                            rankClass = "league-rank-no-movement";
                                        }
                                        else if (empIdx >= activePlayerCount - 1 && activePlayerCount > 4)
                                        {
                                            rowClass = "league-tr-relegation";
                                            rankClass = "league-rank-relegation";
                                        }

                                        var rowStyle = zeroTarget ? "background-color: #f8fafc !important; border-left: 4px solid #cbd5e1 !important;" : $"background-color: {GetRowBgColor(evalRate)} !important; border-left: 4px solid {GetRowBorderColor(evalRate)} !important;";

