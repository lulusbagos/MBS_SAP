                                                                    <i class="bi bi-diagram-3 me-1 text-primary"></i>@comp.TierLabel
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (tier3RedZone.Any())
                    {
                        <div class="mt-3 p-3 rounded" style="background-color: #fef2f2; border: 1px solid #fca5a5;">
