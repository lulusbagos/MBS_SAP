         <div class="league-banner-pattern"></div>
         <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center position-relative" style="z-index: 1;">
             <div class="d-flex align-items-center gap-3 mb-3 mb-md-0">
                 <img src="/images/logo indexim putih.png" style="height: 52px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));" />
