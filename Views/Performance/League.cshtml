@using MBS_SAP.Controllers
@{
    ViewData["Title"] = "League Safety Accountability Program";
    ViewData["HideFooter"] = true;
    var companies = ViewBag.Companies as List<MBS_SAP.Models.PerusahaanView> ?? new List<MBS_SAP.Models.PerusahaanView>();
    var selectedCompanyId = (int)(ViewBag.SelectedCompanyId ?? 0);
    var companyName = ViewBag.CompanyName as string ?? "";
    var deptAchievements = ViewBag.DepartmentAchievements as List<DepartmentAchievementViewModel> ?? new List<DepartmentAchievementViewModel>();
    var employees = ViewBag.Employees as System.Collections.ICollection;
    var topReporters = ViewBag.TopReporters as System.Collections.ICollection ?? employees;
    var totalPlayerCount = (int)(ViewBag.TotalPlayerCount ?? (employees?.Count ?? 0));
    var showAllPlayers = (bool)(ViewBag.ShowAllPlayers ?? false);
    var squadTab = (string)(ViewBag.SquadTab ?? "best");
    var isIndexim = companyName.ToUpper().Contains("INDEXIM");
    var isSafetyRole = ViewBag.IsSafetyRole as bool? ?? false;
    var currentUserNik = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
                         ?? User.FindFirst("Nrp")?.Value 
                         ?? User.Identity?.Name ?? "";
    var isTopParent = (ViewBag.IsTopParent as bool? ?? false);
    var isAdmin = (ViewBag.IsAdmin as bool? ?? false) || User.IsInRole("Admin") || string.Equals(currentUserNik, "24051940986", StringComparison.OrdinalIgnoreCase);
    var canDownloadDetail = isAdmin || isSafetyRole;
    var targetFilter = ViewBag.TargetFilter as string ?? "target";
}


@functions {
    public string GetDeptInitials(string name) {
        if (string.IsNullOrEmpty(name)) return "GEN";
        var clean = new string(name.Where(c => char.IsLetterOrDigit(c) || char.IsWhiteSpace(c)).ToArray()).Trim();
        var words = clean.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2) {
            return (words[0][0].ToString() + words[1][0].ToString()).ToUpper();
        }
        return (clean.Length >= 2 ? clean.Substring(0, 2) : clean).ToUpper();
    }

    public string GetDeptColor(string name) {
        if (string.IsNullOrEmpty(name)) return "#1e3a8a";
        int hash = 0;
        foreach (char c in name) {
            hash = c + ((hash << 5) - hash);
        }
        var colors = new[] {
            "#1e3a8a", "#b91c1c", "#047857", "#6d28d9", "#a21caf",
            "#c2410c", "#0369a1", "#15803d", "#be123c", "#4d7c0f"
        };
        int idx = Math.Abs(hash) % colors.Length;
        return colors[idx];
    }

    public Microsoft.AspNetCore.Html.IHtmlContent GetFormDotsHtml(double h, double i, double st, double o, double c) {
        var sb = new System.Text.StringBuilder();
        sb.Append(GetDotHtml(h, "Hazard"));
        sb.Append(GetDotHtml(i, "Inspeksi"));
        sb.Append(GetDotHtml(st, "Safety Talk"));
        sb.Append(GetDotHtml(o, "Observasi"));
        sb.Append(GetDotHtml(c, "Coaching"));
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    private string GetDotHtml(double val, string programName) {
        if (val < 0) return $"<span class=\"league-form-dot dot-w\" title=\"{programName} Bebas Target - WIN\">W</span>";
        if (val >= 80) return $"<span class=\"league-form-dot dot-w\" title=\"{programName} Tercapai (80%+) - WIN\">W</span>";
        if (val >= 40) return $"<span class=\"league-form-dot dot-d\" title=\"{programName} Sebagian (40%-79%) - DRAW\">D</span>";
        return $"<span class=\"league-form-dot dot-l\" title=\"{programName} Kurang (<40%) - LOSS\">L</span>";
    }

    public Microsoft.AspNetCore.Html.IHtmlContent GetEmpFormDotsHtml(int hAct, int hTgt, int iAct, int iTgt, int stAct, int stTgt, int oAct, int oTgt, int cAct, int cTgt) {
        var sb = new System.Text.StringBuilder();
        sb.Append(GetEmpDotHtml(hAct, hTgt, "Hazard"));
        sb.Append(GetEmpDotHtml(iAct, iTgt, "Inspeksi"));
        sb.Append(GetEmpDotHtml(stAct, stTgt, "Safety Talk"));
        sb.Append(GetEmpDotHtml(oAct, oTgt, "Observasi"));
        sb.Append(GetEmpDotHtml(cAct, cTgt, "Coaching"));
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    private string GetEmpDotHtml(int act, int tgt, string programName) {
        if (tgt == 0) {
            if (act > 0) return $"<span class=\"league-form-dot dot-w\" title=\"{programName} Realisasi {act} (Bebas Target) - WIN\">W</span>";
            return $"<span class=\"league-form-dot dot-off\" style=\"background: #94a3b8; color: #ffffff;\" title=\"{programName} Bebas Target (0 Hari Onsite / Cuti)\">-</span>";
        }
        double rate = ((double)act / tgt) * 100;
        if (rate >= 80) return $"<span class=\"league-form-dot dot-w\" title=\"{programName} Tercapai ({act}/{tgt}) - WIN\">W</span>";
        if (rate >= 40) return $"<span class=\"league-form-dot dot-d\" title=\"{programName} Sebagian ({act}/{tgt}) - DRAW\">D</span>";
        return $"<span class=\"league-form-dot dot-l\" title=\"{programName} Kurang ({act}/{tgt}) - LOSS\">L</span>";
    }

    public string GetRateColor(double rate) {
        if (rate < 0) return "#64748b"; // gray for N/A
        if (rate >= 80) return "#16a34a"; // 80–100% Hijau (Tercapai / Patuh)
        if (rate >= 40) return "#dc2626"; // 40–79% Merah (Perlu Perhatian)
        return "#0f172a"; // 0–39% Hitam (Kritis / Degradasi)
    }

    public string GetRowBgColor(double rate) {
        if (rate < 0) return ""; 
        if (rate >= 80) return "rgba(22, 163, 74, 0.04)"; // Hijau lembut & bersih
        if (rate >= 40) return "rgba(220, 38, 38, 0.04)"; // Merah lembut
        return "rgba(15, 23, 42, 0.04)"; // Hitam / abu lembut
    }

    public string GetRowBorderColor(double rate) {
        if (rate < 0) return "#cbd5e1";
        if (rate >= 80) return "#16a34a"; // Hijau
        if (rate >= 40) return "#dc2626"; // Merah
        return "#0f172a"; // Hitam
    }

    public string FormatRate(double rate) {
        if (rate < 0) return "N/A";
        return rate + "%";
    }

    public string BuildPtsTooltip(dynamic comp) {
