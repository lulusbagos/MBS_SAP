                                @if (!tier1Standings.Any())
                                {
                                    <tr>
                                        <td colspan="14" class="text-center text-muted py-4">Belum ada data perusahaan untuk Tier 1.</td>
                                    </tr>
                                }
                                else
                                {
                                    int idx = 0;
                                    foreach (var comp in tier1Standings)
                                    {
                                        idx++;
                                        var rowClass = "league-tr-normal";
                                        var rankClass = "";
                                        var rankText = idx.ToString();

                                        if (comp.MtdAchievementRate == 0)
                                        {
                                            rowClass = "league-tr-no-movement";
                                            rankClass = "league-rank-no-movement";
                                        }
                                        else if (idx <= 3)
                                        {
                                            rowClass = "league-tr-champions";
                                            rankClass = "league-rank-champions";
                                            if (idx == 1) rankText = "🥇 1";
                                            else if (idx == 2) rankText = "🥈 2";
                                            else if (idx == 3) rankText = "🥉 3";
                                        }

                                        var shieldColor = GetDeptColor(comp.CompanyName);
                                        var initials = GetDeptInitials(comp.CompanyName);

                                        <tr class="@rowClass" style="cursor: pointer; background-color: @GetRowBgColor((double)comp.TotalScore) !important; border-left: 4px solid @GetRowBorderColor((double)comp.TotalScore) !important;" onclick="location.href='?companyId=@comp.CompanyId&mode=dept';">
                                            <td class="text-center">
                                                <div class="league-rank-pill @rankClass">@rankText</div>
                                            </td>
                                            <td class="align-left">
                                                <div class="d-flex align-items-center">
                                                    <div class="football-badge me-2" style="background-color: @shieldColor;">@initials</div>
                                                    <div>
                                                        <div class="fw-bold" style="color: #334155; font-size: 14px;">@comp.CompanyName</div>
                                                        <div style="font-size: 11px; color: #64748b;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? "" : comp.PjoName)</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold">@comp.EmployeeCount</td>
                                            <td class="text-center fw-bold" style="color: @GetRateColor((double)comp.TotalScore); background-color: rgba(30, 58, 138, 0.03);">
                                                <div style="font-size: 14px; font-weight: 800;">@(((double)comp.TotalScore).ToString("F1"))</div>
                                            </td>
                                            <td class="text-center fw-bold" style="color: @GetRateColor((double)comp.MtdAchievementRate); background-color: rgba(4, 120, 87, 0.03);">
                                                <div style="font-size: 13.5px; font-weight: 800;">@FormatRate(comp.MtdAchievementRate)</div>
                                                <div style="font-size: 9.5px; color: #64748b; font-weight: 600;" title="Realisasi / Target SAP">@comp.TotalActual / @comp.TotalTarget</div>
                                            </td>
                                            <td class="text-center" style="white-space: nowrap;">
                                                @GetFormDotsHtml(comp.MtdHazardRate, comp.MtdInspeksiRate, comp.MtdSafetyTalkRate, comp.MtdObservasiRate, comp.MtdCoachingRate)
                                            </td>
                                            <td class="text-center">@FormatRate(comp.MtdHazardRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdInspeksiRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdSafetyTalkRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdObservasiRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdCoachingRate)</td>
                                            <td class="text-center" style="background-color: #fffbeb; border-left: 2px solid #f59e0b; color: @GetRateColor(comp.MtdP5mRate);">@FormatRate(comp.MtdP5mRate)</td>
                                            <td class="text-center" style="background-color: #ecfdf5; border-left: 2px solid #10b981; color: @GetRateColor(comp.MtdCloseRate);">@FormatRate(comp.MtdCloseRate)</td>
                                            <td class="text-center" onclick="event.stopPropagation();">
                                                <button class="btn btn-sm btn-outline-secondary py-0.5 px-2 rounded-pill" style="font-size: 10px; font-weight: 600; border-color: #cbd5e1; color: #334155;" type="button" data-bs-toggle="collapse" data-bs-target="#detail-tier1-@idx" aria-expanded="false">
                                                    Detail <i class="bi bi-chevron-down ms-1" style="font-size: 9px;"></i>
                                                </button>
                                            </td>
                                        </tr>

                                        <!-- Collapsible Tier 1 Company Detail Card -->
                                        <tr class="collapse" id="detail-tier1-@idx" style="background-color: #f8fafc;">
                                            <td colspan="14" class="p-2 p-md-3">
                                                <div class="player-detail-box">
                                                    <!-- Header Bar Perusahaan -->
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2" style="border-bottom: 1px solid #e2e8f0;">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="football-badge" style="background-color: @shieldColor; width: 22px; height: 26px; font-size: 8px;">@initials</div>
                                                            <div class="fw-bold text-dark" style="font-size: 12px; letter-spacing: -0.2px;">
                                                                Aktivitas K3 Perusahaan: <span class="text-primary">@comp.CompanyName</span>
                                                            </div>
                                                            <span class="badge rounded-pill" style="background: #e0f2fe; color: #0369a1; font-size: 9.5px; font-weight: 600; border: 1px solid #bae6fd;">
                                                                <i class="bi bi-people me-1"></i>@comp.EmployeeCount Skuad Target
                                                            </span>
                                                            <span class="badge rounded-pill" style="background: #fef3c7; color: #92400e; font-size: 9.5px; font-weight: 700; border: 1px solid #fde68a;">
                                                                🏆 @comp.TierLabel
                                                            </span>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <a href="?companyId=@comp.CompanyId&mode=dept" class="btn btn-sm btn-outline-primary py-0.5 px-2.5 rounded-pill fw-semibold" style="font-size: 10.5px;">
                                                                <i class="bi bi-diagram-3 me-1"></i>Buka Klasemen Departemen
                                                            </a>
                                                        </div>
                                                    </div>

                                                    <!-- 7 KPI Summary Strip (Horizontal & Compact) -->
                                                    <div class="kpi-summary-strip mb-3">
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Hazard</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.HazardActual / @comp.HazardTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdHazardRate); font-weight: 600;">@FormatRate(comp.MtdHazardRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Inspeksi</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.InspeksiActual / @comp.InspeksiTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdInspeksiRate); font-weight: 600;">@FormatRate(comp.MtdInspeksiRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">S. Talk</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.SafetyTalkActual / @comp.SafetyTalkTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdSafetyTalkRate); font-weight: 600;">@FormatRate(comp.MtdSafetyTalkRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Observasi</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.ObservasiActual / @comp.ObservasiTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdObservasiRate); font-weight: 600;">@FormatRate(comp.MtdObservasiRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Coaching</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.CoachingActual / @comp.CoachingTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdCoachingRate); font-weight: 600;">@FormatRate(comp.MtdCoachingRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">P5M *</div>
                                                            <div class="fw-bold text-warning-emphasis" style="font-size: 13px;">@comp.P5mActual / @comp.P5mTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdP5mRate); font-weight: 600;">@FormatRate(comp.MtdP5mRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Close Rate</div>
                                                            <div class="fw-bold" style="font-size: 13px; color: @GetRateColor(comp.MtdCloseRate);">@FormatRate(comp.MtdCloseRate)</div>
                                                            <div style="font-size: 9.5px; color: #64748b; font-weight: 600;">@comp.ApClosed / @comp.ApTotal AP</div>
                                                        </div>
                                                    </div>

                                                    <!-- PTS Formula Section -->
                                                    <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                        <!-- Section Header -->
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-2.5 mb-3" style="border-bottom: 1px solid #e2e8f0;">
                                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                <div class="d-flex align-items-center justify-content-center rounded-2 bg-primary text-white" style="width: 24px; height: 24px; font-size: 11px;">
                                                                    <i class="bi bi-calculator"></i>
                                                                </div>
                                                                <span class="fw-bold text-dark" style="font-size: 12.5px; letter-spacing: -0.2px;">Rincian Formula Skor Akhir (PTS) @comp.TierLabel</span>
                                                                <span class="badge" style="background: #eff6ff; color: #1d4ed8; font-size: 9.5px; font-weight: 600; border: 1px solid #bfdbfe;">
                                                                    <i class="bi bi-shield-check me-1"></i>Standar Akuntabilitas Perusahaan
                                                                </span>
                                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill btn-open-scoring-modal" 
                                                                        data-bs-toggle="modal" data-bs-target="#leagueScoringModal" 
                                                                        style="font-size: 10px; font-weight: 600;" 
                                                                        title="Buka rincian hitungan riil &amp; panduan perusahaan"
                                                                        data-type="perusahaan"
                                                                        data-name="@comp.CompanyName"
                                                                        data-dept="@comp.CompanyName"
                                                                        data-pos="@comp.TierLabel"
                                                                        data-tier-label="@comp.TierLabel"
                                                                        data-total-score="@comp.TotalScore"
                                                                        data-score-close="@comp.ScoreCloseRate"
                                                                        data-pts-close="@comp.PtsClose"
                                                                        data-ap-closed="@comp.ApClosed"
                                                                        data-ap-total="@comp.ApTotal"
                                                                        data-score-kualitas="@comp.ScoreKualitas"
                                                                        data-pts-kualitas="@comp.PtsKualitas"
                                                                        data-score-capaian="@comp.ScorePencapaian"
                                                                        data-pts-capaian="@comp.PtsPencapaian"
                                                                        data-act-capaian="@comp.TotalActual"
                                                                        data-tgt-capaian="@comp.TotalTarget"
                                                                        data-compliance="@comp.MtdAchievementRate"
                                                                        data-score-beban="@comp.ScoreSkalaBeban"
                                                                        data-pts-beban="@comp.PtsBeban"
                                                                        data-user-target="@comp.TotalTarget"
                                                                        data-max-target="@comp.MaxTargetTier"
                                                                        data-kpi-hazard="@comp.HazardActual / @comp.HazardTarget"
                                                                        data-kpi-inspeksi="@comp.InspeksiActual / @comp.InspeksiTarget"
                                                                        data-kpi-safetytalk="@comp.SafetyTalkActual / @comp.SafetyTalkTarget"
                                                                        data-kpi-observasi="@comp.ObservasiActual / @comp.ObservasiTarget"
                                                                        data-kpi-coaching="@comp.CoachingActual / @comp.CoachingTarget"
                                                                        data-kpi-p5m="@comp.P5mActual / @comp.P5mTarget">
                                                                    <i class="bi bi-calculator me-1"></i>Detail Hitungan &amp; Panduan
                                                                </button>
                                                            </div>
                                                            <div>
                                                                <span class="badge px-3 py-1.5 rounded-pill shadow-xs" style="background: #0f172a; color: #38bdf8; font-size: 11.5px; font-weight: 700; border: 1px solid #334155;">
                                                                    Total Skor: <span class="text-white">@comp.TotalScore pts</span> (@comp.TotalScore%)
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- 4 Formula Cards -->
                                                        <div class="row g-2 g-md-3 text-center" style="font-size: 11px;">
                                                            <!-- 1. Capaian Target -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">1. Capaian Target</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dbeafe; color: #1d4ed8;">Bobot @(comp.WeightCapaian)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-primary">@comp.ScorePencapaian%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightCapaian)% &times; @comp.ScorePencapaian% = <strong class="text-dark">@comp.PtsPencapaian pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Realisasi: <strong class="text-dark">@comp.TotalActual</strong></span>
                                                                            <span>Target: <strong class="text-dark">@comp.TotalTarget</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-graph-up me-1 text-primary"></i>Kepatuhan kuantitatif seluruh anggota &amp; divisi perusahaan (@comp.MtdAchievementRate%).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 2. Close Rate -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">2. Close Rate</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dcfce7; color: #15803d;">Bobot @(comp.WeightClose)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-success">@comp.ScoreCloseRate%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightClose)% &times; @comp.ScoreCloseRate% = <strong class="text-dark">@comp.PtsClose pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Closed: <strong class="text-dark">@comp.ApClosed</strong></span>
                                                                            <span>Total: <strong class="text-dark">@comp.ApTotal AP</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-shield-check me-1 text-success"></i>Tingkat penutupan temuan bahaya &amp; action plan seluruh departemen di perusahaan.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 3. Kualitas Mutu -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">3. Kualitas Mutu</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #fef3c7; color: #b45309;">Bobot @(comp.WeightKualitas)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #d97706;">@comp.ScoreKualitas%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightKualitas)% &times; @comp.ScoreKualitas% = <strong class="text-dark">@comp.PtsKualitas pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Standar Mutu SAP</span>
                                                                            <span class="text-success fw-bold"><i class="bi bi-check-circle me-0.5"></i>@((((double)comp.ScoreKualitas) * 5.0 / 100.0).ToString("F1")) / 5.0 ★</span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-patch-check me-1 text-warning"></i>Kualitas validasi data laporan K3 seluruh divisi perusahaan (Baseline 100% tanpa penalti).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 4. Skala Beban (Per-Tier) -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">4. Skala Beban</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #e0e7ff; color: #4338ca;">Bobot @(comp.WeightBeban)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #4338ca;">@comp.ScoreSkalaBeban%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightBeban)% &times; @comp.ScoreSkalaBeban% = <strong class="text-dark">@comp.PtsBeban pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Target Perusahaan: <strong class="text-dark">@comp.TotalTarget</strong></span>
                                                                            <span>Max @comp.TierLabel: <strong class="text-dark">@comp.MaxTargetTier</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-people me-1 text-indigo" style="color: #4338ca;"></i>Faktor keadilan beban operasional vs target tertinggi di @comp.TierLabel.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Banner Rangkuman Akumulasi PTS Perusahaan -->
                                                        <div class="mt-2.5 p-2 px-3 rounded-2 d-flex flex-wrap align-items-center justify-content-between gap-2" style="background: #ffffff; border: 1px solid #e2e8f0; font-size: 11px;">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary" style="width: 22px; height: 22px; font-size: 11px; flex-shrink: 0;">
                                                                    <i class="bi bi-info-circle-fill"></i>
                                                                </div>
                                                                <div class="text-secondary" style="font-size: 11px; line-height: 1.4;">
                                                                    <strong class="text-dark">Akumulasi Skor PTS Perusahaan:</strong> (@comp.PtsPencapaian pts) + (@comp.PtsClose pts) + (@comp.PtsKualitas pts) + (@comp.PtsBeban pts) = <strong class="text-primary fs-6">@comp.TotalScore pts (@comp.TotalScore%)</strong>
                                                                    <span class="ms-2 text-muted" style="font-size: 10px;">• Hierarki K3: Personal (Karyawan) &rarr; Departemen &rarr; Perusahaan (@comp.TierLabel)</span>
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <span class="badge" style="background: #f1f5f9; color: #475569; font-size: 10px; font-weight: 600; border: 1px solid #e2e8f0;">
                                                                    <i class="bi bi-diagram-3 me-1 text-primary"></i>@comp.TierLabel
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (tier1RedZone.Any())
                    {
                        <div class="mt-3 p-3 rounded" style="background-color: #fef2f2; border: 1px solid #fca5a5;">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-exclamation-triangle-fill text-danger me-2" style="font-size: 16px;"></i>
                                <h6 class="mb-0 fw-bold text-danger" style="font-size: 13px;">ZONA DEGRADASI TIER 1 (Target Ada, Pencapaian 0%)</h6>
                            </div>
                            <div class="table-responsive league-table-wrap">
                                <table class="league-table">
                                    <thead>
                                        <tr>
                                            <th class="align-left">Klub (Perusahaan)</th>
                                            <th style="width: 80px;">Skuad</th>
                                            <th style="width: 105px; background-color: #991b1b; color: white;">PTS (Skor Total)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var comp in tier1RedZone)
                                        {
                                            var shieldColor = GetDeptColor(comp.CompanyName);
                                            var initials = GetDeptInitials(comp.CompanyName);
                                            <tr class="league-tr-relegation" style="cursor: pointer;" onclick="location.href='?companyId=@comp.CompanyId&mode=dept';">
                                                <td class="align-left">
                                                    <div class="d-flex align-items-center">
                                                        <div class="football-badge me-2" style="background-color: @shieldColor;">@initials</div>
                                                        <div>
                                                            <div class="fw-bold" style="color: #991b1b; font-size: 14px;">@comp.CompanyName</div>
                                                            <div style="font-size: 11px; color: #64748b;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? "" : comp.PjoName)</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center text-danger fw-bold">@comp.EmployeeCount</td>
                                                <td class="text-center fw-bold text-danger">
                                                    <div style="font-size: 14px; font-weight: 800;">@(((double)comp.TotalScore).ToString("F1"))</div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!-- TIER 2: DIVISI SATU (21 - 100 SKUAD) -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <div class="league-card p-3 mb-4" id="tier2Section" style="border-top: 4px solid #0284c7;">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 6px;">
                                <i class="bi bi-award-fill me-1"></i> TIER 2
                            </span>
                            <h5 class="mb-0 fw-bold" style="color: #0f172a; font-size: 16px;">Divisi Satu (Skuad 21 – 100 Karyawan)</h5>
                        </div>
                        <span class="badge bg-info text-dark px-2 py-1 fw-bold" style="font-size: 11px;">@tier2Standings.Count KLUB AKTIF</span>
                    </div>

                    <div class="table-responsive league-table-wrap mb-3">
                        <table class="league-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">Pos</th>
                                    <th class="align-left">Klub (Perusahaan)</th>
                                    <th style="width: 80px;">Skuad</th>
                                    <th style="width: 105px; background-color: #1e3a8a;" title="Poin Total Skor agregat (Komparasi sama dengan Compliance)">PTS (Skor Total)</th>
                                    <th style="width: 90px; background-color: #047857;" title="Pencapaian Target SAP MTD (Realisasi / Target)">Capaian %</th>
                                    <th style="width: 120px;">Form (5 Laga)</th>
                                    <th style="width: 60px;">HZ</th>
                                    <th style="width: 60px;">IP</th>
                                    <th style="width: 60px;">ST</th>
                                    <th style="width: 60px;">OB</th>
                                    <th style="width: 60px;">CC</th>
                                    <th style="width: 65px; background-color: #78350f;">P5M *</th>
                                    <th style="width: 75px; background-color: #065f46;">Close Rate</th>
                                    <th style="width: 65px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!tier2Standings.Any())
                                {
                                    <tr>
                                        <td colspan="14" class="text-center text-muted py-4">Belum ada data perusahaan untuk Tier 2.</td>
                                    </tr>
                                }
                                else
                                {
                                    int idx = 0;
                                    foreach (var comp in tier2Standings)
                                    {
                                        idx++;
                                        var rowClass = "league-tr-normal";
                                        var rankClass = "";
                                        var rankText = idx.ToString();

                                        if (comp.MtdAchievementRate == 0)
                                        {
                                            rowClass = "league-tr-no-movement";
                                            rankClass = "league-rank-no-movement";
                                        }
                                        else if (idx <= 3)
                                        {
                                            rowClass = "league-tr-champions";
                                            rankClass = "league-rank-champions";
                                            if (idx == 1) rankText = "🥇 1";
                                            else if (idx == 2) rankText = "🥈 2";
                                            else if (idx == 3) rankText = "🥉 3";
                                        }

                                        var shieldColor = GetDeptColor(comp.CompanyName);
                                        var initials = GetDeptInitials(comp.CompanyName);

                                        <tr class="@rowClass" style="cursor: pointer; background-color: @GetRowBgColor((double)comp.TotalScore) !important; border-left: 4px solid @GetRowBorderColor((double)comp.TotalScore) !important;" onclick="location.href='?companyId=@comp.CompanyId&mode=dept';">
                                            <td class="text-center">
                                                <div class="league-rank-pill @rankClass">@rankText</div>
                                            </td>
                                            <td class="align-left">
                                                <div class="d-flex align-items-center">
                                                    <div class="football-badge me-2" style="background-color: @shieldColor;">@initials</div>
                                                    <div>
                                                        <div class="fw-bold" style="color: #334155; font-size: 14px;">@comp.CompanyName</div>
                                                        <div style="font-size: 11px; color: #64748b;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? "" : comp.PjoName)</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold">@comp.EmployeeCount</td>
                                            <td class="text-center fw-bold" style="color: @GetRateColor((double)comp.TotalScore); background-color: rgba(30, 58, 138, 0.03);">
                                                <div style="font-size: 14px; font-weight: 800;">@(((double)comp.TotalScore).ToString("F1"))</div>
                                            </td>
                                            <td class="text-center fw-bold" style="color: @GetRateColor((double)comp.MtdAchievementRate); background-color: rgba(4, 120, 87, 0.03);">
                                                <div style="font-size: 13.5px; font-weight: 800;">@FormatRate(comp.MtdAchievementRate)</div>
                                                <div style="font-size: 9.5px; color: #64748b; font-weight: 600;" title="Realisasi / Target SAP">@comp.TotalActual / @comp.TotalTarget</div>
                                            </td>
                                            <td class="text-center" style="white-space: nowrap;">
                                                @GetFormDotsHtml(comp.MtdHazardRate, comp.MtdInspeksiRate, comp.MtdSafetyTalkRate, comp.MtdObservasiRate, comp.MtdCoachingRate)
                                            </td>
                                            <td class="text-center">@FormatRate(comp.MtdHazardRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdInspeksiRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdSafetyTalkRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdObservasiRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdCoachingRate)</td>
                                            <td class="text-center" style="background-color: #fffbeb; border-left: 2px solid #f59e0b; color: @GetRateColor(comp.MtdP5mRate);">@FormatRate(comp.MtdP5mRate)</td>
                                            <td class="text-center" style="background-color: #ecfdf5; border-left: 2px solid #10b981; color: @GetRateColor(comp.MtdCloseRate);">@FormatRate(comp.MtdCloseRate)</td>
                                            <td class="text-center" onclick="event.stopPropagation();">
                                                <button class="btn btn-sm btn-outline-secondary py-0.5 px-2 rounded-pill" style="font-size: 10px; font-weight: 600; border-color: #cbd5e1; color: #334155;" type="button" data-bs-toggle="collapse" data-bs-target="#detail-tier2-@idx" aria-expanded="false">
                                                    Detail <i class="bi bi-chevron-down ms-1" style="font-size: 9px;"></i>
                                                </button>
                                            </td>
                                        </tr>

                                        <!-- Collapsible Tier 2 Company Detail Card -->
                                        <tr class="collapse" id="detail-tier2-@idx" style="background-color: #f8fafc;">
                                            <td colspan="14" class="p-2 p-md-3">
                                                <div class="player-detail-box">
                                                    <!-- Header Bar Perusahaan -->
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2" style="border-bottom: 1px solid #e2e8f0;">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="football-badge" style="background-color: @shieldColor; width: 22px; height: 26px; font-size: 8px;">@initials</div>
                                                            <div class="fw-bold text-dark" style="font-size: 12px; letter-spacing: -0.2px;">
                                                                Aktivitas K3 Perusahaan: <span class="text-primary">@comp.CompanyName</span>
                                                            </div>
                                                            <span class="badge rounded-pill" style="background: #e0f2fe; color: #0369a1; font-size: 9.5px; font-weight: 600; border: 1px solid #bae6fd;">
                                                                <i class="bi bi-people me-1"></i>@comp.EmployeeCount Skuad Target
                                                            </span>
                                                            <span class="badge rounded-pill" style="background: #f0f9ff; color: #0369a1; font-size: 9.5px; font-weight: 700; border: 1px solid #7dd3fc;">
                                                                🥈 @comp.TierLabel
                                                            </span>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <a href="?companyId=@comp.CompanyId&mode=dept" class="btn btn-sm btn-outline-primary py-0.5 px-2.5 rounded-pill fw-semibold" style="font-size: 10.5px;">
                                                                <i class="bi bi-diagram-3 me-1"></i>Buka Klasemen Departemen
                                                            </a>
                                                        </div>
                                                    </div>

                                                    <!-- 7 KPI Summary Strip (Horizontal & Compact) -->
                                                    <div class="kpi-summary-strip mb-3">
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Hazard</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.HazardActual / @comp.HazardTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdHazardRate); font-weight: 600;">@FormatRate(comp.MtdHazardRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Inspeksi</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.InspeksiActual / @comp.InspeksiTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdInspeksiRate); font-weight: 600;">@FormatRate(comp.MtdInspeksiRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">S. Talk</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.SafetyTalkActual / @comp.SafetyTalkTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdSafetyTalkRate); font-weight: 600;">@FormatRate(comp.MtdSafetyTalkRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Observasi</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.ObservasiActual / @comp.ObservasiTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdObservasiRate); font-weight: 600;">@FormatRate(comp.MtdObservasiRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Coaching</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.CoachingActual / @comp.CoachingTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdCoachingRate); font-weight: 600;">@FormatRate(comp.MtdCoachingRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">P5M *</div>
                                                            <div class="fw-bold text-warning-emphasis" style="font-size: 13px;">@comp.P5mActual / @comp.P5mTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdP5mRate); font-weight: 600;">@FormatRate(comp.MtdP5mRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Close Rate</div>
                                                            <div class="fw-bold" style="font-size: 13px; color: @GetRateColor(comp.MtdCloseRate);">@FormatRate(comp.MtdCloseRate)</div>
                                                            <div style="font-size: 9.5px; color: #64748b; font-weight: 600;">@comp.ApClosed / @comp.ApTotal AP</div>
                                                        </div>
                                                    </div>

                                                    <!-- PTS Formula Section -->
                                                    <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                        <!-- Section Header -->
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-2.5 mb-3" style="border-bottom: 1px solid #e2e8f0;">
                                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                <div class="d-flex align-items-center justify-content-center rounded-2 bg-primary text-white" style="width: 24px; height: 24px; font-size: 11px;">
                                                                    <i class="bi bi-calculator"></i>
                                                                </div>
                                                                <span class="fw-bold text-dark" style="font-size: 12.5px; letter-spacing: -0.2px;">Rincian Formula Skor Akhir (PTS) @comp.TierLabel</span>
                                                                <span class="badge" style="background: #eff6ff; color: #1d4ed8; font-size: 9.5px; font-weight: 600; border: 1px solid #bfdbfe;">
                                                                    <i class="bi bi-shield-check me-1"></i>Standar Akuntabilitas Perusahaan
                                                                </span>
                                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill btn-open-scoring-modal" 
                                                                        data-bs-toggle="modal" data-bs-target="#leagueScoringModal" 
                                                                        style="font-size: 10px; font-weight: 600;" 
                                                                        title="Buka rincian hitungan riil &amp; panduan perusahaan"
                                                                        data-type="perusahaan"
                                                                        data-name="@comp.CompanyName"
                                                                        data-dept="@comp.CompanyName"
                                                                        data-pos="@comp.TierLabel"
                                                                        data-tier-label="@comp.TierLabel"
                                                                        data-total-score="@comp.TotalScore"
                                                                        data-score-close="@comp.ScoreCloseRate"
                                                                        data-pts-close="@comp.PtsClose"
                                                                        data-ap-closed="@comp.ApClosed"
                                                                        data-ap-total="@comp.ApTotal"
                                                                        data-score-kualitas="@comp.ScoreKualitas"
                                                                        data-pts-kualitas="@comp.PtsKualitas"
                                                                        data-score-capaian="@comp.ScorePencapaian"
                                                                        data-pts-capaian="@comp.PtsPencapaian"
                                                                        data-act-capaian="@comp.TotalActual"
                                                                        data-tgt-capaian="@comp.TotalTarget"
                                                                        data-compliance="@comp.MtdAchievementRate"
                                                                        data-score-beban="@comp.ScoreSkalaBeban"
                                                                        data-pts-beban="@comp.PtsBeban"
                                                                        data-user-target="@comp.TotalTarget"
                                                                        data-max-target="@comp.MaxTargetTier"
                                                                        data-kpi-hazard="@comp.HazardActual / @comp.HazardTarget"
                                                                        data-kpi-inspeksi="@comp.InspeksiActual / @comp.InspeksiTarget"
                                                                        data-kpi-safetytalk="@comp.SafetyTalkActual / @comp.SafetyTalkTarget"
                                                                        data-kpi-observasi="@comp.ObservasiActual / @comp.ObservasiTarget"
                                                                        data-kpi-coaching="@comp.CoachingActual / @comp.CoachingTarget"
                                                                        data-kpi-p5m="@comp.P5mActual / @comp.P5mTarget">
                                                                    <i class="bi bi-calculator me-1"></i>Detail Hitungan &amp; Panduan
                                                                </button>
                                                            </div>
                                                            <div>
                                                                <span class="badge px-3 py-1.5 rounded-pill shadow-xs" style="background: #0f172a; color: #38bdf8; font-size: 11.5px; font-weight: 700; border: 1px solid #334155;">
                                                                    Total Skor: <span class="text-white">@comp.TotalScore pts</span> (@comp.TotalScore%)
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- 4 Formula Cards -->
                                                        <div class="row g-2 g-md-3 text-center" style="font-size: 11px;">
                                                            <!-- 1. Capaian Target -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">1. Capaian Target</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dbeafe; color: #1d4ed8;">Bobot @(comp.WeightCapaian)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-primary">@comp.ScorePencapaian%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightCapaian)% &times; @comp.ScorePencapaian% = <strong class="text-dark">@comp.PtsPencapaian pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Realisasi: <strong class="text-dark">@comp.TotalActual</strong></span>
                                                                            <span>Target: <strong class="text-dark">@comp.TotalTarget</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-graph-up me-1 text-primary"></i>Kepatuhan kuantitatif seluruh anggota &amp; divisi perusahaan (@comp.MtdAchievementRate%).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 2. Close Rate -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">2. Close Rate</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dcfce7; color: #15803d;">Bobot @(comp.WeightClose)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-success">@comp.ScoreCloseRate%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightClose)% &times; @comp.ScoreCloseRate% = <strong class="text-dark">@comp.PtsClose pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Closed: <strong class="text-dark">@comp.ApClosed</strong></span>
                                                                            <span>Total: <strong class="text-dark">@comp.ApTotal AP</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-shield-check me-1 text-success"></i>Tingkat penutupan temuan bahaya &amp; action plan seluruh departemen di perusahaan.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 3. Kualitas Mutu -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">3. Kualitas Mutu</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #fef3c7; color: #b45309;">Bobot @(comp.WeightKualitas)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #d97706;">@comp.ScoreKualitas%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightKualitas)% &times; @comp.ScoreKualitas% = <strong class="text-dark">@comp.PtsKualitas pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Standar Mutu SAP</span>
                                                                            <span class="text-success fw-bold"><i class="bi bi-check-circle me-0.5"></i>@((((double)comp.ScoreKualitas) * 5.0 / 100.0).ToString("F1")) / 5.0 ★</span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-patch-check me-1 text-warning"></i>Kualitas validasi data laporan K3 seluruh divisi perusahaan (Baseline 100% tanpa penalti).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 4. Skala Beban (Per-Tier) -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">4. Skala Beban</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #e0e7ff; color: #4338ca;">Bobot @(comp.WeightBeban)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #4338ca;">@comp.ScoreSkalaBeban%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightBeban)% &times; @comp.ScoreSkalaBeban% = <strong class="text-dark">@comp.PtsBeban pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Target Perusahaan: <strong class="text-dark">@comp.TotalTarget</strong></span>
                                                                            <span>Max @comp.TierLabel: <strong class="text-dark">@comp.MaxTargetTier</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-people me-1 text-indigo" style="color: #4338ca;"></i>Faktor keadilan beban operasional vs target tertinggi di @comp.TierLabel.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Banner Rangkuman Akumulasi PTS Perusahaan -->
                                                        <div class="mt-2.5 p-2 px-3 rounded-2 d-flex flex-wrap align-items-center justify-content-between gap-2" style="background: #ffffff; border: 1px solid #e2e8f0; font-size: 11px;">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary" style="width: 22px; height: 22px; font-size: 11px; flex-shrink: 0;">
                                                                    <i class="bi bi-info-circle-fill"></i>
                                                                </div>
                                                                <div class="text-secondary" style="font-size: 11px; line-height: 1.4;">
                                                                    <strong class="text-dark">Akumulasi Skor PTS Perusahaan:</strong> (@comp.PtsPencapaian pts) + (@comp.PtsClose pts) + (@comp.PtsKualitas pts) + (@comp.PtsBeban pts) = <strong class="text-primary fs-6">@comp.TotalScore pts (@comp.TotalScore%)</strong>
                                                                    <span class="ms-2 text-muted" style="font-size: 10px;">• Hierarki K3: Personal (Karyawan) &rarr; Departemen &rarr; Perusahaan (@comp.TierLabel)</span>
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <span class="badge" style="background: #f1f5f9; color: #475569; font-size: 10px; font-weight: 600; border: 1px solid #e2e8f0;">
                                                                    <i class="bi bi-diagram-3 me-1 text-primary"></i>@comp.TierLabel
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (tier2RedZone.Any())
                    {
                        <div class="mt-3 p-3 rounded" style="background-color: #fef2f2; border: 1px solid #fca5a5;">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-exclamation-triangle-fill text-danger me-2" style="font-size: 16px;"></i>
                                <h6 class="mb-0 fw-bold text-danger" style="font-size: 13px;">ZONA DEGRADASI TIER 2 (Target Ada, Pencapaian 0%)</h6>
                            </div>
                            <div class="table-responsive league-table-wrap">
                                <table class="league-table">
                                    <thead>
                                        <tr>
                                            <th class="align-left">Klub (Perusahaan)</th>
                                            <th style="width: 80px;">Skuad</th>
                                            <th style="width: 105px; background-color: #991b1b; color: white;">PTS (Skor Total)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var comp in tier2RedZone)
                                        {
                                            var shieldColor = GetDeptColor(comp.CompanyName);
                                            var initials = GetDeptInitials(comp.CompanyName);
                                            <tr class="league-tr-relegation" style="cursor: pointer;" onclick="location.href='?companyId=@comp.CompanyId&mode=dept';">
                                                <td class="align-left">
                                                    <div class="d-flex align-items-center">
                                                        <div class="football-badge me-2" style="background-color: @shieldColor;">@initials</div>
                                                        <div>
                                                            <div class="fw-bold" style="color: #991b1b; font-size: 14px;">@comp.CompanyName</div>
                                                            <div style="font-size: 11px; color: #64748b;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? "" : comp.PjoName)</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center text-danger fw-bold">@comp.EmployeeCount</td>
                                                <td class="text-center fw-bold text-danger">
                                                    <div style="font-size: 14px; font-weight: 800;">@(((double)comp.TotalScore).ToString("F1"))</div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!-- TIER 3: DIVISI DUA (1 - 20 SKUAD) -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <div class="league-card p-3 mb-4" id="tier3Section" style="border-top: 4px solid #059669;">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge" style="background: linear-gradient(135deg, #059669, #047857); color: #fff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 6px;">
                                <i class="bi bi-shield-shaded me-1"></i> TIER 3
                            </span>
                            <h5 class="mb-0 fw-bold" style="color: #0f172a; font-size: 16px;">Divisi Dua (Skuad 1 – 20 Karyawan)</h5>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success text-white px-2 py-1 fw-bold" style="font-size: 11px;">@tier3Standings.Count KLUB AKTIF</span>
                            <div class="input-group input-group-sm" style="max-width: 220px;">
                                <span class="input-group-text bg-white border-end-0 py-0"><i class="bi bi-search text-muted" style="font-size: 11px;"></i></span>
                                <input type="text" id="tier3SearchInput" placeholder="Cari nama perusahaan..." class="form-control border-start-0" style="font-size: 11px;" onkeyup="filterTier3Table();" />
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive league-table-wrap mb-3" style="max-height: 560px; overflow-y: auto;">
                        <table class="league-table" id="tier3Table">
                            <thead>
                                <tr style="position: sticky; top: 0; z-index: 5;">
                                    <th style="width: 50px;">Pos</th>
                                    <th class="align-left">Klub (Perusahaan)</th>
                                    <th style="width: 80px;">Skuad</th>
                                    <th style="width: 105px; background-color: #1e3a8a;" title="Poin Total Skor agregat (Komparasi sama dengan Compliance)">PTS (Skor Total)</th>
                                    <th style="width: 90px; background-color: #047857;" title="Pencapaian Target SAP MTD (Realisasi / Target)">Capaian %</th>
                                    <th style="width: 120px;">Form (5 Laga)</th>
                                    <th style="width: 60px;">HZ</th>
                                    <th style="width: 60px;">IP</th>
                                    <th style="width: 60px;">ST</th>
                                    <th style="width: 60px;">OB</th>
                                    <th style="width: 60px;">CC</th>
                                    <th style="width: 65px; background-color: #78350f;">P5M *</th>
                                    <th style="width: 75px; background-color: #065f46;">Close Rate</th>
                                    <th style="width: 65px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!tier3Standings.Any())
                                {
                                    <tr>
                                        <td colspan="14" class="text-center text-muted py-4">Belum ada data perusahaan untuk Tier 3.</td>
                                    </tr>
                                }
                                else
                                {
                                    int idx = 0;
                                    foreach (var comp in tier3Standings)
                                    {
                                        idx++;
                                        var rowClass = "league-tr-normal";
                                        var rankClass = "";
                                        var rankText = idx.ToString();

                                        if (comp.MtdAchievementRate == 0)
                                        {
                                            rowClass = "league-tr-no-movement";
                                            rankClass = "league-rank-no-movement";
                                        }
                                        else if (idx <= 3)
                                        {
                                            rowClass = "league-tr-champions";
                                            rankClass = "league-rank-champions";
                                            if (idx == 1) rankText = "🥇 1";
                                            else if (idx == 2) rankText = "🥈 2";
                                            else if (idx == 3) rankText = "🥉 3";
                                        }

                                        var shieldColor = GetDeptColor(comp.CompanyName);
                                        var initials = GetDeptInitials(comp.CompanyName);

                                        <tr class="@rowClass" style="cursor: pointer; background-color: @GetRowBgColor((double)comp.TotalScore) !important; border-left: 4px solid @GetRowBorderColor((double)comp.TotalScore) !important;" onclick="location.href='?companyId=@comp.CompanyId&mode=dept';">
                                            <td class="text-center">
                                                <div class="league-rank-pill @rankClass">@rankText</div>
                                            </td>
                                            <td class="align-left">
                                                <div class="d-flex align-items-center">
                                                    <div class="football-badge me-2" style="background-color: @shieldColor;">@initials</div>
                                                    <div>
                                                        <div class="fw-bold tier3-comp-name" style="color: #334155; font-size: 14px;">@comp.CompanyName</div>
                                                        <div style="font-size: 11px; color: #64748b;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? "" : comp.PjoName)</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold">@comp.EmployeeCount</td>
                                            <td class="text-center fw-bold" style="color: @GetRateColor((double)comp.TotalScore); background-color: rgba(30, 58, 138, 0.03);">
                                                <div style="font-size: 14px; font-weight: 800;">@(((double)comp.TotalScore).ToString("F1"))</div>
                                            </td>
                                            <td class="text-center fw-bold" style="color: @GetRateColor((double)comp.MtdAchievementRate); background-color: rgba(4, 120, 87, 0.03);">
                                                <div style="font-size: 13.5px; font-weight: 800;">@FormatRate(comp.MtdAchievementRate)</div>
                                                <div style="font-size: 9.5px; color: #64748b; font-weight: 600;" title="Realisasi / Target SAP">@comp.TotalActual / @comp.TotalTarget</div>
                                            </td>
                                            <td class="text-center" style="white-space: nowrap;">
                                                @GetFormDotsHtml(comp.MtdHazardRate, comp.MtdInspeksiRate, comp.MtdSafetyTalkRate, comp.MtdObservasiRate, comp.MtdCoachingRate)
                                            </td>
                                            <td class="text-center">@FormatRate(comp.MtdHazardRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdInspeksiRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdSafetyTalkRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdObservasiRate)</td>
                                            <td class="text-center">@FormatRate(comp.MtdCoachingRate)</td>
                                            <td class="text-center" style="background-color: #fffbeb; border-left: 2px solid #f59e0b; color: @GetRateColor(comp.MtdP5mRate);">@FormatRate(comp.MtdP5mRate)</td>
                                            <td class="text-center" style="background-color: #ecfdf5; border-left: 2px solid #10b981; color: @GetRateColor(comp.MtdCloseRate);">@FormatRate(comp.MtdCloseRate)</td>
                                            <td class="text-center" onclick="event.stopPropagation();">
                                                <button class="btn btn-sm btn-outline-secondary py-0.5 px-2 rounded-pill" style="font-size: 10px; font-weight: 600; border-color: #cbd5e1; color: #334155;" type="button" data-bs-toggle="collapse" data-bs-target="#detail-tier3-@idx" aria-expanded="false">
                                                    Detail <i class="bi bi-chevron-down ms-1" style="font-size: 9px;"></i>
                                                </button>
                                            </td>
                                        </tr>

                                        <!-- Collapsible Tier 3 Company Detail Card -->
                                        <tr class="collapse" id="detail-tier3-@idx" style="background-color: #f8fafc;">
                                            <td colspan="14" class="p-2 p-md-3">
                                                <div class="player-detail-box">
                                                    <!-- Header Bar Perusahaan -->
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2" style="border-bottom: 1px solid #e2e8f0;">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="football-badge" style="background-color: @shieldColor; width: 22px; height: 26px; font-size: 8px;">@initials</div>
                                                            <div class="fw-bold text-dark" style="font-size: 12px; letter-spacing: -0.2px;">
                                                                Aktivitas K3 Perusahaan: <span class="text-primary">@comp.CompanyName</span>
                                                            </div>
                                                            <span class="badge rounded-pill" style="background: #e0f2fe; color: #0369a1; font-size: 9.5px; font-weight: 600; border: 1px solid #bae6fd;">
                                                                <i class="bi bi-people me-1"></i>@comp.EmployeeCount Skuad Target
                                                            </span>
                                                            <span class="badge rounded-pill" style="background: #ecfdf5; color: #065f46; font-size: 9.5px; font-weight: 700; border: 1px solid #a7f3d0;">
                                                                🥉 @comp.TierLabel
                                                            </span>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <a href="?companyId=@comp.CompanyId&mode=dept" class="btn btn-sm btn-outline-primary py-0.5 px-2.5 rounded-pill fw-semibold" style="font-size: 10.5px;">
                                                                <i class="bi bi-diagram-3 me-1"></i>Buka Klasemen Departemen
                                                            </a>
                                                        </div>
                                                    </div>

                                                    <!-- 7 KPI Summary Strip (Horizontal & Compact) -->
                                                    <div class="kpi-summary-strip mb-3">
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Hazard</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.HazardActual / @comp.HazardTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdHazardRate); font-weight: 600;">@FormatRate(comp.MtdHazardRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Inspeksi</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.InspeksiActual / @comp.InspeksiTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdInspeksiRate); font-weight: 600;">@FormatRate(comp.MtdInspeksiRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">S. Talk</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.SafetyTalkActual / @comp.SafetyTalkTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdSafetyTalkRate); font-weight: 600;">@FormatRate(comp.MtdSafetyTalkRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Observasi</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.ObservasiActual / @comp.ObservasiTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdObservasiRate); font-weight: 600;">@FormatRate(comp.MtdObservasiRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Coaching</div>
                                                            <div class="fw-bold" style="font-size: 13px;">@comp.CoachingActual / @comp.CoachingTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdCoachingRate); font-weight: 600;">@FormatRate(comp.MtdCoachingRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">P5M *</div>
                                                            <div class="fw-bold text-warning-emphasis" style="font-size: 13px;">@comp.P5mActual / @comp.P5mTarget</div>
                                                            <div style="font-size: 9.5px; color: @GetRateColor(comp.MtdP5mRate); font-weight: 600;">@FormatRate(comp.MtdP5mRate)</div>
                                                        </div>
                                                        <div class="kpi-summary-item">
                                                            <div class="text-muted" style="font-size: 11px;">Close Rate</div>
                                                            <div class="fw-bold" style="font-size: 13px; color: @GetRateColor(comp.MtdCloseRate);">@FormatRate(comp.MtdCloseRate)</div>
                                                            <div style="font-size: 9.5px; color: #64748b; font-weight: 600;">@comp.ApClosed / @comp.ApTotal AP</div>
                                                        </div>
                                                    </div>

                                                    <!-- PTS Formula Section -->
                                                    <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                        <!-- Section Header -->
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-2.5 mb-3" style="border-bottom: 1px solid #e2e8f0;">
                                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                <div class="d-flex align-items-center justify-content-center rounded-2 bg-primary text-white" style="width: 24px; height: 24px; font-size: 11px;">
                                                                    <i class="bi bi-calculator"></i>
                                                                </div>
                                                                <span class="fw-bold text-dark" style="font-size: 12.5px; letter-spacing: -0.2px;">Rincian Formula Skor Akhir (PTS) @comp.TierLabel</span>
                                                                <span class="badge" style="background: #eff6ff; color: #1d4ed8; font-size: 9.5px; font-weight: 600; border: 1px solid #bfdbfe;">
                                                                    <i class="bi bi-shield-check me-1"></i>Standar Akuntabilitas Perusahaan
                                                                </span>
                                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill btn-open-scoring-modal" 
                                                                        data-bs-toggle="modal" data-bs-target="#leagueScoringModal" 
                                                                        style="font-size: 10px; font-weight: 600;" 
                                                                        title="Buka rincian hitungan riil &amp; panduan perusahaan"
                                                                        data-type="perusahaan"
                                                                        data-name="@comp.CompanyName"
                                                                        data-dept="@comp.CompanyName"
                                                                        data-pos="@comp.TierLabel"
                                                                        data-tier-label="@comp.TierLabel"
                                                                        data-total-score="@comp.TotalScore"
                                                                        data-score-close="@comp.ScoreCloseRate"
                                                                        data-pts-close="@comp.PtsClose"
                                                                        data-ap-closed="@comp.ApClosed"
                                                                        data-ap-total="@comp.ApTotal"
                                                                        data-score-kualitas="@comp.ScoreKualitas"
                                                                        data-pts-kualitas="@comp.PtsKualitas"
                                                                        data-score-capaian="@comp.ScorePencapaian"
                                                                        data-pts-capaian="@comp.PtsPencapaian"
                                                                        data-act-capaian="@comp.TotalActual"
                                                                        data-tgt-capaian="@comp.TotalTarget"
                                                                        data-compliance="@comp.MtdAchievementRate"
                                                                        data-score-beban="@comp.ScoreSkalaBeban"
                                                                        data-pts-beban="@comp.PtsBeban"
                                                                        data-user-target="@comp.TotalTarget"
                                                                        data-max-target="@comp.MaxTargetTier"
                                                                        data-kpi-hazard="@comp.HazardActual / @comp.HazardTarget"
                                                                        data-kpi-inspeksi="@comp.InspeksiActual / @comp.InspeksiTarget"
                                                                        data-kpi-safetytalk="@comp.SafetyTalkActual / @comp.SafetyTalkTarget"
                                                                        data-kpi-observasi="@comp.ObservasiActual / @comp.ObservasiTarget"
                                                                        data-kpi-coaching="@comp.CoachingActual / @comp.CoachingTarget"
                                                                        data-kpi-p5m="@comp.P5mActual / @comp.P5mTarget">
                                                                    <i class="bi bi-calculator me-1"></i>Detail Hitungan &amp; Panduan
                                                                </button>
                                                            </div>
                                                            <div>
                                                                <span class="badge px-3 py-1.5 rounded-pill shadow-xs" style="background: #0f172a; color: #38bdf8; font-size: 11.5px; font-weight: 700; border: 1px solid #334155;">
                                                                    Total Skor: <span class="text-white">@comp.TotalScore pts</span> (@comp.TotalScore%)
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- 4 Formula Cards -->
                                                        <div class="row g-2 g-md-3 text-center" style="font-size: 11px;">
                                                            <!-- 1. Capaian Target -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">1. Capaian Target</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dbeafe; color: #1d4ed8;">Bobot @(comp.WeightCapaian)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-primary">@comp.ScorePencapaian%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightCapaian)% &times; @comp.ScorePencapaian% = <strong class="text-dark">@comp.PtsPencapaian pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Realisasi: <strong class="text-dark">@comp.TotalActual</strong></span>
                                                                            <span>Target: <strong class="text-dark">@comp.TotalTarget</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-graph-up me-1 text-primary"></i>Kepatuhan kuantitatif seluruh anggota &amp; divisi perusahaan (@comp.MtdAchievementRate%).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 2. Close Rate -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">2. Close Rate</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #dcfce7; color: #15803d;">Bobot @(comp.WeightClose)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4 text-success">@comp.ScoreCloseRate%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightClose)% &times; @comp.ScoreCloseRate% = <strong class="text-dark">@comp.PtsClose pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Closed: <strong class="text-dark">@comp.ApClosed</strong></span>
                                                                            <span>Total: <strong class="text-dark">@comp.ApTotal AP</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-shield-check me-1 text-success"></i>Tingkat penutupan temuan bahaya &amp; action plan seluruh departemen di perusahaan.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 3. Kualitas Mutu -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">3. Kualitas Mutu</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #fef3c7; color: #b45309;">Bobot @(comp.WeightKualitas)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #d97706;">@comp.ScoreKualitas%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightKualitas)% &times; @comp.ScoreKualitas% = <strong class="text-dark">@comp.PtsKualitas pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Standar Mutu SAP</span>
                                                                            <span class="text-success fw-bold"><i class="bi bi-check-circle me-0.5"></i>@((((double)comp.ScoreKualitas) * 5.0 / 100.0).ToString("F1")) / 5.0 ★</span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-patch-check me-1 text-warning"></i>Kualitas validasi data laporan K3 seluruh divisi perusahaan (Baseline 100% tanpa penalti).
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- 4. Skala Beban (Per-Tier) -->
                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                <div class="pts-clean-card">
                                                                    <div>
                                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px solid #f1f5f9;">
                                                                            <span class="fw-bold text-dark text-nowrap" style="font-size: 11.5px;">4. Skala Beban</span>
                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #e0e7ff; color: #4338ca;">Bobot @(comp.WeightBeban)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #4338ca;">@comp.ScoreSkalaBeban%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightBeban)% &times; @comp.ScoreSkalaBeban% = <strong class="text-dark">@comp.PtsBeban pts</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 10px; color: #475569;">
                                                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 9.5px;">
                                                                            <span>Target Perusahaan: <strong class="text-dark">@comp.TotalTarget</strong></span>
                                                                            <span>Max @comp.TierLabel: <strong class="text-dark">@comp.MaxTargetTier</strong></span>
                                                                        </div>
                                                                        <div class="text-muted text-start mt-1.5" style="font-size: 9px; line-height: 1.35;">
                                                                            <i class="bi bi-people me-1 text-indigo" style="color: #4338ca;"></i>Faktor keadilan beban operasional vs target tertinggi di @comp.TierLabel.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Banner Rangkuman Akumulasi PTS Perusahaan -->
                                                        <div class="mt-2.5 p-2 px-3 rounded-2 d-flex flex-wrap align-items-center justify-content-between gap-2" style="background: #ffffff; border: 1px solid #e2e8f0; font-size: 11px;">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary" style="width: 22px; height: 22px; font-size: 11px; flex-shrink: 0;">
