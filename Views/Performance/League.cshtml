                    <button type="button" class="btn btn-sm btn-warning fw-bold text-dark" onclick="downloadSapDetailExcel(this);" title="Unduh Rincian Seluruh Program SAP per Sheet + Audit Kualitas AI (.xlsx)" style="border-radius: 8px; font-size: 11px; padding: 6px 12px; height: 31px; display: inline-flex; align-items: center; box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);">
                        <i class="bi bi-stars me-1 text-dark"></i> Download Detail SAP + AI
                    </button>
                }
                <span class="badge bg-success px-3 py-2" style="border-radius: 8px; font-size: 11px; font-weight: 700; height: 31px; display: inline-flex; align-items: center;">
                    <i class="bi bi-calendar-event me-1"></i> @months.First(m => m.Val == selectedMonth).Name @selectedYear
