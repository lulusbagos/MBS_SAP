                                                                            <span class="badge rounded-pill pts-card-badge" style="background: #e0e7ff; color: #4338ca;">Bobot @(comp.WeightBeban)%</span>
                                                                        </div>
                                                                        <div class="my-2">
                                                                            <span class="fw-bold fs-4" style="color: #4338ca;">@comp.ScoreSkalaBeban%</span>
                                                                        </div>
                                                                        <div class="py-1 px-2 rounded text-center" style="background: #f8fafc; border: 1px solid #f1f5f9; font-size: 11px; color: #334155; white-space: nowrap;">
                                                                            @(comp.WeightBeban)% &times; @comp.ScoreSkalaBeban% = <strong class="text-dark">@comp.PtsBeban pts</strong>
