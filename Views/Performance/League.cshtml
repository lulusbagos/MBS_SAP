        }
        .podium-block {
            font-size: 18px;
        }
        .podium-gold .podium-block { height: 60px; }
        .podium-silver .podium-block { height: 45px; }
        .podium-bronze .podium-block { height: 35px; }
    }
</style>

    @{
        int selectedYear = ViewBag.SelectedYear as int? ?? DateTime.Today.Year;
        int selectedMonth = ViewBag.SelectedMonth as int? ?? DateTime.Today.Month;
        var currentMode = ViewBag.Mode as string ?? "dept";
        
        var months = new[] {
            new { Val = 1, Name = "Januari" },
            new { Val = 2, Name = "Februari" },
            new { Val = 3, Name = "Maret" },
            new { Val = 4, Name = "April" },
            new { Val = 5, Name = "Mei" },
            new { Val = 6, Name = "Juni" },
            new { Val = 7, Name = "Juli" },
            new { Val = 8, Name = "Agustus" },
            new { Val = 9, Name = "September" },
            new { Val = 10, Name = "Oktober" },
            new { Val = 11, Name = "November" },
            new { Val = 12, Name = "Desember" }
        };
    }

    <!-- Header Selector with Month & Year Filters -->
    <div class="card p-3 shadow-sm border-0 mb-4 bg-white" style="border-radius: 12px; border: 1px solid #cbd5e1 !important;">
        <form id="leagueFilterForm" method="get" action="/Performance/League" class="row g-2 align-items-end">
            <input type="hidden" name="mode" value="@currentMode" />
            <input type="hidden" id="companyIdInput" name="companyId" value="@selectedCompanyId" />

            <!-- Searchable Company Dropdown -->
            <div class="col-md-5 col-sm-12">
                <label class="form-label text-muted fw-bold mb-1" style="font-size: 11px;">PILIH PERUSAHAAN</label>
                <div class="position-relative" id="companyDropdownWrapper">
                    <div id="companySearchTrigger"
                         onclick="toggleCompanyDropdown()"
                         class="form-select border-2 shadow-sm fw-bold d-flex align-items-center justify-content-between"
                         style="border-radius: 8px; font-size: 13px; cursor: pointer; user-select: none; min-height: 38px;">
                        <span id="companySelectedLabel">
                            @(companies.FirstOrDefault(c => c.PerusahaanId == selectedCompanyId)?.NamaPerusahaan ?? "Pilih Perusahaan")
                        </span>
                        <i class="bi bi-chevron-down" id="companyChevron" style="font-size: 11px; color: #64748b; transition: transform 0.2s;"></i>
                    </div>
                    <div id="companyDropdownMenu" style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:9999; background:#fff; border:2px solid #cbd5e1; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); overflow:hidden;">
                        <div style="padding: 8px;">
                            <div class="position-relative">
                                <i class="bi bi-search" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:12px;"></i>
                                <input type="text" id="companySearchInput"
                                       placeholder="Cari perusahaan..."
                                       oninput="filterCompanyList(this.value)"
                                       onclick="event.stopPropagation()"
                                       class="form-control form-control-sm"
                                       style="padding-left: 30px; border-radius: 6px; font-size: 12px; border-color: #e2e8f0;" />
                            </div>
                        </div>
                        <div id="companyListContainer" style="max-height: 220px; overflow-y: auto; padding: 0 4px 8px;">
                            @foreach (var c in companies)
                            {
                                <div class="company-option @(c.PerusahaanId == selectedCompanyId ? "company-option-active" : "")"
                                     data-value="@c.PerusahaanId"
                                     data-label="@c.NamaPerusahaan"
                                     onclick="selectCompany(@c.PerusahaanId, '@Html.Raw(c.NamaPerusahaan.Replace("'", "\\'"))')"
                                     style="padding: 8px 12px; border-radius: 7px; cursor:pointer; font-size: 13px; font-weight: 600; transition: background 0.15s; @(c.PerusahaanId == selectedCompanyId ? "background:#eff6ff; color:#1d4ed8;" : "")">
                                    @c.NamaPerusahaan
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <label class="form-label text-muted fw-bold mb-1" style="font-size: 11px;">BULAN KLASEMEN</label>
                <select name="month" class="form-select border-2 shadow-sm fw-bold" style="border-radius: 8px; font-size: 13px;" onchange="this.form.submit();">
                    @foreach (var m in months)
                    {
                        if (m.Val == selectedMonth)
                        {
                            <option value="@m.Val" selected>@m.Name</option>
                        }
                        else
                        {
                            <option value="@m.Val">@m.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label class="form-label text-muted fw-bold mb-1" style="font-size: 11px;">TAHUN</label>
                <select name="year" class="form-select border-2 shadow-sm fw-bold" style="border-radius: 8px; font-size: 13px;" onchange="this.form.submit();">
                    @for (int y = 2024; y <= 2026; y++)
                    {
                        if (y == selectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-bold w-100 shadow-sm" style="border-radius: 8px; font-size: 13px; height: 38px;">
                    <i class="bi bi-funnel-fill"></i> Filter
                </button>
            </div>
        </form>
    </div>

 
