                                <table class="league-table">
                                    <thead>
                                        <tr>
                                            <th class="align-left">Klub (Perusahaan)</th>
                                            <th style="width: 80px;">Skuad</th>
                                            <th style="width: 105px; background-color: #991b1b; color: white;">PTS (Skor Total)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var comp in tier3RedZone)
                                        {
                                            var shieldColor = GetDeptColor(comp.CompanyName);
                                            var initials = GetDeptInitials(comp.CompanyName);
                                            <tr class="league-tr-relegation" style="cursor: pointer;" onclick="location.href='?companyId=@comp.CompanyId&mode=dept';">
                                                <td class="align-left">
                                                    <div class="d-flex align-items-center">
                                                        <div class="football-badge me-2" style="background-color: @shieldColor;">@initials</div>
                                                        <div>
                                                            <div class="fw-bold" style="color: #991b1b; font-size: 14px;">@comp.CompanyName</div>
                                                            <div style="font-size: 11px; color: #64748b;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? "" : comp.PjoName)</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center text-danger fw-bold">@comp.EmployeeCount</td>
                                                <td class="text-center fw-bold text-danger">
                                                    <div style="font-size: 14px; font-weight: 800;">@(((double)comp.TotalScore).ToString("F1"))</div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <div class="legend-box mt-3 mb-2">
                    <div class="legend-item">
                        <div class="legend-dot" style="background: #000000;"></div>
                        <span>0–39% (Hitam)</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-dot" style="background: #dc2626;"></div>
                        <span>40–79% (Merah)</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-dot" style="background: #16a34a;"></div>
                        <span>80–100% (Hijau)</span>
                    </div>
                </div>
                <span class="text-muted mt-1 mb-4 d-block" style="font-size: 11px; font-style: italic; line-height: 1.4;">
                    * Klik baris Perusahaan untuk melihat Klasemen Internal (Klub / Departemen) dari perusahaan tersebut secara detail.
                </span>
            }
            else if (currentMode == "core")
            {
                var companyStandings = ViewBag.CompanyStandings as List<dynamic> ?? new List<dynamic>();
                <div class="league-card p-3">
                    <div class="league-card-header">
                        <h5><i class="bi bi-star-fill me-2 text-warning"></i>Liga Perusahaan Inti</h5>
                        <div class="league-card-actions">
                            <span class="badge bg-primary px-2 py-1" style="font-size: 10px; font-weight: 700;">@companyStandings.Count COMPANY</span>
                            <button type="button" class="btn btn-sm btn-outline-warning" onclick="downloadSapDetailExcel(this);" title="Unduh Detail Seluruh SAP + AI Quality (.xlsx)" style="font-size: 11px; font-weight: 700; border-radius: 6px; padding: 3px 8px;">
                                <i class="bi bi-stars text-warning"></i> <span class="d-none d-sm-inline ms-1">Detail + AI</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="downloadSquadExcel(this);" title="Unduh Laporan Klasemen Excel (.xlsx)" style="font-size: 11px; font-weight: 700; border-radius: 6px; padding: 3px 8px;">
                                <i class="bi bi-file-earmark-excel-fill"></i> <span class="d-none d-sm-inline ms-1">Klasemen Excel</span>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive league-table-wrap mb-3">
                        <table class="league-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">Pos</th>
                                    <th class="align-left">Klub (Perusahaan)</th>
                                    <th style="width: 80px;">Skuad</th>
                                    <th style="width: 105px; background-color: #1e3a8a;" title="Poin Total Skor agregat (Komparasi sama dengan Compliance)">PTS (Skor Total)</th>
                                    <th style="width: 90px; background-color: #047857;" title="Pencapaian Target SAP MTD (Realisasi / Target)">Capaian %</th>
                                    <th style="width: 120px;">Form (5 Laga)</th>
                                    <th style="width: 60px;">HZ</th>
                                    <th style="width: 60px;">IP</th>
                                    <th style="width: 60px;">ST</th>
                                    <th style="width: 60px;">OB</th>
                                    <th style="width: 60px;">CC</th>
                                    <th style="width: 65px; background-color: #78350f;">P5M *</th>
                                    <th style="width: 75px; background-color: #065f46;">Close Rate</th>
                                    <th style="width: 65px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!companyStandings.Any())
                                {
                                    <tr>
                                        <td colspan="14" class="text-center text-muted py-4">Belum ada data perusahaan terdaftar.</td>
                                    </tr>
                                }
                                else
                                {
                                    int idx = 0;
                                    foreach (var comp in companyStandings)
                                    {
                                        idx++;
                                        var rowClass = "league-tr-normal";
                                        var rankClass = "";
                                        var rankText = idx.ToString();

                                        if (comp.MtdAchievementRate == 0)
                                        {
                                            rowClass = "league-tr-no-movement";
                                            rankClass = "league-rank-no-movement";
                                        }
                                        else if (idx <= 3)
                                        {
                                            rowClass = "league-tr-champions";
                                            rankClass = "league-rank-champions";
                                            if (idx == 1) rankText = "🥇 1";
                                            else if (idx == 2) rankText = "🥈 2";
                                            else if (idx == 3) rankText = "🥉 3";
                                        }

                                        var shieldColor = GetDeptColor(comp.CompanyName);
                                        var initials = GetDeptInitials(comp.CompanyName);

                                        <tr class="@rowClass" style="cursor: pointer; background-color: @GetRowBgColor((double)comp.TotalScore) !important; border-left: 4px solid @GetRowBorderColor((double)comp.TotalScore) !important;" onclick="location.href='?companyId=@comp.CompanyId&mode=dept@(selectedCompanyId > 0 && selectedCompanyId != (int)comp.CompanyId ? $"&parentId={selectedCompanyId}" : "")';">
                                            <td class="text-center">
                                                <div class="league-rank-pill @rankClass">@rankText</div>
                                            </td>
                                            <td class="align-left">
                                                <div class="d-flex align-items-center">
                                                    <div class="football-badge me-2" style="background-color: @shieldColor;">@initials</div>
                                                    <div>
                                                        <div class="fw-bold" style="color: #334155; font-size: 14px;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? comp.CompanyName : comp.PjoName)</div>
                                                        <div style="font-size: 11px; color: #64748b;">@(string.IsNullOrWhiteSpace(comp.PjoName) ? "" : comp.CompanyName)</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">@comp.EmployeeCount</td>
