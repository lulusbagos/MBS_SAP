        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        text-shadow: 1px 1px 0px rgba(0,0,0,0.2);
    }
    
    /* Podium Colors & Heights */
    .podium-gold .podium-block {
        height: 80px;
        background: linear-gradient(180deg, #eab308, #ca8a04);
        border: 2px solid #fef08a;
        border-bottom: none;
        color: #fef08a;
    }
    .podium-gold .podium-rate {
        background-color: #fef08a;
        color: #854d0e;
    }
    .podium-gold {
        transform: scale(1.05);
        z-index: 2;
    }
    
    .podium-silver .podium-block {
        height: 60px;
        background: linear-gradient(180deg, #94a3b8, #475569);
        border: 2px solid #e2e8f0;
        border-bottom: none;
        color: #e2e8f0;
    }
    .podium-silver .podium-rate {
        background-color: #e2e8f0;
        color: #334155;
    }
    
    .podium-bronze .podium-block {
        height: 45px;
        background: linear-gradient(180deg, #b45309, #78350f);
        border: 2px solid #fed7aa;
        border-bottom: none;
        color: #fed7aa;
    }
    .podium-bronze .podium-rate {
        background-color: #fed7aa;
        color: #7c2d12;
    }
    
    @@media (max-width: 576px) {
        .podium-name {
            font-size: 11px;
        }
        .podium-avatar {
            font-size: 20px;
        }
        .podium-rate {
            font-size: 11px;
            padding: 1px 6px;
        }
        .podium-block {
            font-size: 18px;
        }
        .podium-gold .podium-block { height: 60px; }
        .podium-silver .podium-block { height: 45px; }
        .podium-bronze .podium-block { height: 35px; }
    }
</style>

    @{
        int selectedYear = ViewBag.SelectedYear as int? ?? DateTime.Today.Year;
        int selectedMonth = ViewBag.SelectedMonth as int? ?? DateTime.Today.Month;
        var currentMode = ViewBag.Mode as string ?? "dept";
        
        var months = new[] {
            new { Val = 1, Name = "Januari" },
            new { Val = 2, Name = "Februari" },
            new { Val = 3, Name = "Maret" },
            new { Val = 4, Name = "April" },
            new { Val = 5, Name = "Mei" },
            new { Val = 6, Name = "Juni" },
            new { Val = 7, Name = "Juli" },
            new { Val = 8, Name = "Agustus" },
            new { Val = 9, Name = "September" },
            new { Val = 10, Name = "Oktober" },
            new { Val = 11, Name = "November" },
            new { Val = 12, Name = "Desember" }
        };
    }

    <!-- Header Selector with Month & Year Filters -->
    <div class="card p-3 shadow-sm border-0 mb-4 bg-white" style="border-radius: 12px; border: 1px solid #cbd5e1 !important;">
        <form id="leagueFilterForm" method="get" action="/Performance/League" class="row g-2 align-items-end">
            <input type="hidden" name="mode" value="@currentMode" />
            <input type="hidden" id="companyIdInput" name="companyId" value="@selectedCompanyId" />
            @if (ViewBag.ParentId != null)
            {
                <input type="hidden" name="parentId" value="@ViewBag.ParentId" />
            }

            <!-- Searchable Company Dropdown -->
            <div class="col-md-5 col-sm-12">
                <label class="form-label text-muted fw-bold mb-1" style="font-size: 11px;">PILIH PERUSAHAAN</label>
                <div class="position-relative" id="companyDropdownWrapper">
                    <div id="companySearchTrigger"
                         onclick="toggleCompanyDropdown()"
                         class="form-select border-2 shadow-sm fw-bold d-flex align-items-center justify-content-between"
                         style="border-radius: 8px; font-size: 13px; cursor: pointer; user-select: none; min-height: 38px;">
                        <span id="companySelectedLabel">
                            @(companies.FirstOrDefault(c => c.PerusahaanId == selectedCompanyId)?.NamaPerusahaan ?? "Pilih Perusahaan")
                        </span>
                        <i class="bi bi-chevron-down" id="companyChevron" style="font-size: 11px; color: #64748b; transition: transform 0.2s;"></i>
                    </div>
                    <div id="companyDropdownMenu" style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:9999; background:#fff; border:2px solid #cbd5e1; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); overflow:hidden;">
                        <div style="padding: 8px;">
                            <div class="position-relative">
                                <i class="bi bi-search" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:12px;"></i>
                                <input type="text" id="companySearchInput"
                                       placeholder="Cari perusahaan..."
                                       oninput="filterCompanyList(this.value)"
                                       onclick="event.stopPropagation()"
                                       class="form-control form-control-sm"
                                       style="padding-left: 30px; border-radius: 6px; font-size: 12px; border-color: #e2e8f0;" />
                            </div>
                        </div>
                        <div id="companyListContainer" style="max-height: 220px; overflow-y: auto; padding: 0 4px 8px;">
                            @foreach (var c in companies)
                            {
                                <div class="company-option @(c.PerusahaanId == selectedCompanyId ? "company-option-active" : "")"
                                     data-value="@c.PerusahaanId"
                                     data-label="@c.NamaPerusahaan"
                                     onclick="selectCompany(@c.PerusahaanId, '@Html.Raw((c.NamaPerusahaan ?? "").Replace("'", "\\'"))')"
                                     style="padding: 8px 12px; border-radius: 7px; cursor:pointer; font-size: 13px; font-weight: 600; transition: background 0.15s; @(c.PerusahaanId == selectedCompanyId ? "background:#eff6ff; color:#1d4ed8;" : "")">
                                    @c.NamaPerusahaan
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <label class="form-label text-muted fw-bold mb-1" style="font-size: 11px;">BULAN KLASEMEN</label>
                <select name="month" class="form-select border-2 shadow-sm fw-bold" style="border-radius: 8px; font-size: 13px;" onchange="this.form.submit();">
                    @foreach (var m in months)
                    {
                        if (m.Val == selectedMonth)
                        {
                            <option value="@m.Val" selected>@m.Name</option>
                        }
                        else
                        {
                            <option value="@m.Val">@m.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label class="form-label text-muted fw-bold mb-1" style="font-size: 11px;">TAHUN</label>
                <select name="year" class="form-select border-2 shadow-sm fw-bold" style="border-radius: 8px; font-size: 13px;" onchange="this.form.submit();">
                    @for (int y = 2024; y <= 2026; y++)
                    {
                        if (y == selectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-bold w-100 shadow-sm" style="border-radius: 8px; font-size: 13px; height: 38px;">
                    <i class="bi bi-funnel-fill"></i> Filter
                </button>
            </div>

            <!-- Radio Button Target SAP Filter -->
            <div class="col-12 mt-2 pt-2 border-top">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted fw-bold d-flex align-items-center" style="font-size: 11px; text-transform: uppercase;">
                            <i class="bi bi-person-lines-fill text-primary me-1"></i>Filter Skuad SAP:
                        </span>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Target Filter">
                            <input type="radio" class="btn-check" name="targetFilter" id="tf_target" value="target" @(targetFilter == "target" ? "checked" : "") onchange="this.form.submit();">
                            <label class="btn btn-outline-primary fw-bold" for="tf_target" style="font-size: 11px; border-radius: 6px 0 0 6px;">
                                <i class="bi bi-bullseye me-1"></i>Hanya Target SAP
                            </label>

                            <input type="radio" class="btn-check" name="targetFilter" id="tf_nontarget_active" value="nontarget_active" @(targetFilter == "nontarget_active" ? "checked" : "") onchange="this.form.submit();">
                            <label class="btn btn-outline-success fw-bold" for="tf_nontarget_active" style="font-size: 11px;">
                                <i class="bi bi-lightning-charge-fill me-1"></i>Non-Target Aktif SAP
                            </label>

                            <input type="radio" class="btn-check" name="targetFilter" id="tf_all" value="all" @(targetFilter == "all" ? "checked" : "") onchange="this.form.submit();">
                            <label class="btn btn-outline-secondary fw-bold" for="tf_all" style="font-size: 11px; border-radius: 0 6px 6px 0;">
                                <i class="bi bi-people-fill me-1"></i>Semua Skuad (+ Non-Target)
                            </label>
                        </div>
                    </div>
                    <div class="text-muted" style="font-size: 11px;">
                        @if (targetFilter == "nontarget_active")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-lightning-charge-fill me-1"></i>Menampilkan karyawan di luar target yang aktif membuat laporan SAP
                            </span>
                        }
                        else if (targetFilter == "all")
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                <i class="bi bi-people-fill me-1"></i>Menampilkan seluruh karyawan (Target &amp; Non-Target)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                <i class="bi bi-shield-check me-1"></i>Menampilkan skuad pemain wajib target SAP
                            </span>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>

 
    <!-- Download Loading Modal / Overlay -->
    <div id="downloadLoadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 99999; justify-content: center; align-items: center;">
        <div style="background: #ffffff; border-radius: 16px; padding: 28px 32px; max-width: 440px; width: 90%; text-align: center; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2); border: 1px solid #e2e8f0; animation: modalPop 0.3s ease-out;">
            <div style="width: 64px; height: 64px; margin: 0 auto 16px; background: #eff6ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative;">
                <div class="spinner-border text-primary" style="width: 48px; height: 48px; border-width: 3px;" role="status"></div>
                <i class="bi bi-file-earmark-arrow-down-fill text-primary" style="position: absolute; font-size: 20px;"></i>
            </div>
            <h5 id="downloadModalTitle" style="font-weight: 800; color: #0f172a; margin-bottom: 8px;">Menyiapkan Dokumen Excel...</h5>
            <p id="downloadModalDesc" style="font-size: 13px; color: #64748b; line-height: 1.5; margin-bottom: 20px;">
                AI sedang mengaudit kualitas laporan SAP dan menyusun rekapitulasi multi-sheet...
            </p>
            <div class="progress" style="height: 6px; border-radius: 999px; background-color: #f1f5f9; overflow: hidden;">
                <div id="downloadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: 100%;"></div>
            </div>
            <div style="margin-top: 14px; font-size: 11px; color: #94a3b8; font-weight: 600;">
                <i class="bi bi-shield-check text-success me-1"></i> Mohon tunggu sebentar, file akan terunduh otomatis
            </div>
        </div>
    </div>

    <!-- Sports Scoreboard Banner -->
    <div class="league-banner">
        <div class="league-banner-pattern"></div>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center position-relative" style="z-index: 1;">
            <div class="d-flex align-items-center gap-3 mb-3 mb-md-0">
                <img src="/images/logo indexim putih.png" style="height: 52px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));" />
                <div>
                    <h2 class="league-title-main">League Safety Accountability Program</h2>
                    <div style="font-size: 13px; font-weight: 600; color: #a1a1aa; margin-top: 2px;">
                        @(currentMode == "company" ? "Super League • Evaluasi Kinerja K3LH Seluruh Perusahaan" : (currentMode == "core" ? "Liga Perusahaan Inti" : $"Klasemen Klub Internal • {companyName}"))
