                const elTotPct = document.getElementById('mRealTotalPct');
                if (elTotPct) elTotPct.textContent = totalScore + '%';
                
                // Pilar 1: Close Rate
                const scoreClose = d.scoreClose || '0';
                const ptsClose = d.ptsClose || '0';
                const elCrScore = document.getElementById('mRealCrScore');
                if (elCrScore) elCrScore.textContent = scoreClose + '%';
                const elCrForm = document.getElementById('mRealCrFormula');
                if (elCrForm) elCrForm.textContent = scoreClose + '%';
                const elCrPts = document.getElementById('mRealCrPts');
                if (elCrPts) elCrPts.textContent = ptsClose + ' pts';
                
                const elCrDetails = document.getElementById('mRealCrDetails');
                const elCrDesc = document.getElementById('mRealCrDesc');
                if (isComp) {
                    if (elCrDetails) {
                        elCrDetails.innerHTML = 'Status AP Perusahaan: <strong>' + (d.apClosed || '0') + ' Selesai</strong> dari total <strong>' + (d.apTotal || '0') + ' Action Plan</strong>';
                    }
