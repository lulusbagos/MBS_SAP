                                    </div>
                                    <div class="p-2 rounded bg-light border text-secondary" style="font-size: 11px; line-height: 1.45;">
                                        <div id="mRealCrDetails" class="mb-1 fw-semibold text-dark">-</div>
                                        <div class="text-muted" id="mRealCrDesc">-</div>
                                    </div>
                                </div>
                            </div>
