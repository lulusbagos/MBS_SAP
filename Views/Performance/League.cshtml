            string compName = System.Net.WebUtility.HtmlEncode((string)comp.CompanyName);
            int wClose = (int)comp.WeightClose;
            int wKualitas = (int)comp.WeightKualitas;
            int wCapaian = (int)comp.WeightCapaian;
            int wBeban = (int)comp.WeightBeban;

            double scClose = (double)comp.ScoreCloseRate;
            double scKualitas = (double)comp.ScoreKualitas;
            double scCapaian = (double)comp.ScorePencapaian;
            double scBeban = (double)comp.ScoreSkalaBeban;

            double ptClose = (double)comp.PtsClose;
            double ptKualitas = (double)comp.PtsKualitas;
            double ptCapaian = (double)comp.PtsPencapaian;
            double ptBeban = (double)comp.PtsBeban;
            double totScore = (double)comp.TotalScore;

            double barClose = Math.Min(100.0, Math.Max(0.0, scClose));
            double barKualitas = Math.Min(100.0, Math.Max(0.0, scKualitas));
            double barCapaian = Math.Min(100.0, Math.Max(0.0, scCapaian));
            double barBeban = Math.Min(100.0, Math.Max(0.0, scBeban));

            return "<div class='pts-corp-card'>" +
                   "<div class='pts-corp-header'>" +
                       "<div class='pts-corp-meta'>" +
                           "<span class='pts-corp-tag'>KARTU EVALUASI KINERJA K3LH</span>" +
                           $"<div class='pts-corp-title' title='{compName}'>{compName}</div>" +
                       "</div>" +
                       "<div class='pts-corp-badge'>" +
                           $"<span class='pts-corp-badge-score'>{totScore:F1}</span>" +
                           "<span class='pts-corp-badge-unit'>PTS</span>" +
                       "</div>" +
                   "</div>" +
                   "<div class='pts-corp-list'>" +
                       "<div class='pts-corp-item'>" +
                           "<div class='pts-corp-item-top'>" +
                               "<div class='pts-corp-indicator'>" +
                                   "<span class='pts-corp-dot' style='background: #3b82f6; box-shadow: 0 0 6px rgba(59, 130, 246, 0.6);'></span>" +
                                   "<span class='pts-corp-name'>Capaian 5 SAP</span>" +
                                   $"<span class='pts-corp-weight'>{wCapaian}%</span>" +
                               "</div>" +
                               "<div class='pts-corp-calc'>" +
                                   $"<span class='pts-corp-val'>{scCapaian:F1}%</span>" +
                                   $"<span class='pts-corp-math'>&times; {wCapaian}% &rarr;</span>" +
                                   $"<span class='pts-corp-pts' style='color: #60a5fa;'>+{ptCapaian:F2}</span>" +
                               "</div>" +
                           "</div>" +
                           "<div class='pts-corp-bar-bg'>" +
                               $"<div class='pts-corp-bar-fill' style='width: {barCapaian:F1}%; background: linear-gradient(90deg, #2563eb, #3b82f6);'></div>" +
                           "</div>" +
                       "</div>" +
                       "<div class='pts-corp-item'>" +
                           "<div class='pts-corp-item-top'>" +
                               "<div class='pts-corp-indicator'>" +
                                   "<span class='pts-corp-dot' style='background: #10b981; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);'></span>" +
                                   "<span class='pts-corp-name'>Action Plan Closure</span>" +
                                   $"<span class='pts-corp-weight'>{wClose}%</span>" +
                               "</div>" +
                               "<div class='pts-corp-calc'>" +
                                   $"<span class='pts-corp-val'>{scClose:F1}%</span>" +
                                   $"<span class='pts-corp-math'>&times; {wClose}% &rarr;</span>" +
                                   $"<span class='pts-corp-pts' style='color: #34d399;'>+{ptClose:F2}</span>" +
                               "</div>" +
                           "</div>" +
                           "<div class='pts-corp-bar-bg'>" +
                               $"<div class='pts-corp-bar-fill' style='width: {barClose:F1}%; background: linear-gradient(90deg, #059669, #10b981);'></div>" +
                           "</div>" +
                       "</div>" +
                       "<div class='pts-corp-item'>" +
                           "<div class='pts-corp-item-top'>" +
                               "<div class='pts-corp-indicator'>" +
                                   "<span class='pts-corp-dot' style='background: #f59e0b; box-shadow: 0 0 6px rgba(245, 158, 11, 0.6);'></span>" +
                                   "<span class='pts-corp-name'>Mutu Laporan AI</span>" +
                                   $"<span class='pts-corp-weight'>{wKualitas}%</span>" +
                               "</div>" +
                               "<div class='pts-corp-calc'>" +
                                   $"<span class='pts-corp-val'>{scKualitas:F0}%</span>" +
                                   $"<span class='pts-corp-math'>&times; {wKualitas}% &rarr;</span>" +
                                   $"<span class='pts-corp-pts' style='color: #fbbf24;'>+{ptKualitas:F2}</span>" +
                               "</div>" +
                           "</div>" +
                           "<div class='pts-corp-bar-bg'>" +
