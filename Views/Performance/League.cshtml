    /* Fullscreen Squad Section & Screenshot Mode */
    .top-scorers-header {
        background: #0f172a;
        color: #ffffff;
        padding: 12px 16px;
        font-weight: 800;
        font-size: 15px;
        text-transform: uppercase;
        border-top-left-radius: 12px;
