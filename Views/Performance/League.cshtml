                    <span><i class="bi bi-people-fill me-2"></i>Skuad Pemain K3</span>
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <button type="button" class="btn btn-sm btn-outline-light d-none" id="resetFilterBtn" onclick="resetPlayerFilter();" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px;">
                            <i class="bi bi-x-circle me-1"></i> Tampilkan Semua
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light" id="toggleAllDetailsBtn" onclick="toggleAllDetails();" title="Tampilkan Semua Rincian Kepatuhan" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px; transition: all 0.2s;">
                            <i class="bi bi-eye" id="detailsIcon"></i> <span class="d-none d-md-inline ms-1" id="detailsText">Buka Rincian</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light" id="toggleFullHeightBtn" onclick="toggleSquadHeight();" title="Tinggi Penuh (Buka Scroll untuk Screenshot)" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px; transition: all 0.2s;">
                            <i class="bi bi-arrows-angle-expand" id="heightIcon"></i> <span class="d-none d-md-inline ms-1" id="heightText">Tinggi Penuh</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light" id="toggleFullscreenBtn" onclick="toggleSquadFullscreen();" title="Layar Penuh (Fokus Mode)" style="font-size: 10px; font-weight: 700; border-radius: 4px; padding: 4px 8px; transition: all 0.2s;">
                            <i class="bi bi-fullscreen" id="fullscreenIcon"></i> <span class="d-none d-md-inline ms-1" id="fullscreenText">Layar Penuh</span>
                        </button>
                    </div>
                </div>
                
                <div class="p-3">
                    <div class="squad-podium" id="squadPodium">
                        <!-- Populated dynamically via JS -->
                    </div>

                    <div class="alert alert-info py-2 px-3 mb-3 border-0 d-none align-items-center gap-2" id="filterAlert" style="border-radius: 8px; font-size: 12px; background-color: #f0f9ff; color: #0369a1;">
                        <i class="bi bi-info-circle-fill"></i>
                        <span id="filterAlertText"></span>
                    </div>

                    <div class="table-responsive league-table-wrap" style="max-height: 520px; overflow-y: auto;">
                        <table class="league-table">
                            <thead>
                                <tr style="position: sticky; top: 0; z-index: 10;">
                                    <th style="width: 50px; background: #0f172a;">Pos</th>
                                    <th class="align-left" style="background: #0f172a;">Pemain</th>
                                    <th style="width: 90px; background: #0f172a;">PTS %</th>
                                    <th style="width: 110px; background: #0f172a;">Form (5 Program)</th>
                                    <th style="background: #0f172a; width: 80px;">Rincian</th>
                                </tr>
                            </thead>
                            <tbody id="playerTableBody">
                                @if (employees == null || employees.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">Tidak ada data pemain.</td>
                                    </tr>
                                }
                                else
                                {
                                    int empIdx = 0;
                                    var activeEmployeesList = employees.Cast<dynamic>().Where(e => (int)e.mtdTotalTarget > 0).ToList();
                                    int activePlayerCount = activeEmployeesList.Count;

                                    foreach (dynamic emp in employees)
                                    {
                                        empIdx++;
                                        var rowClass = "league-tr-normal";
                                        var rankClass = "";
                                        var rankText = empIdx.ToString();
                                        var zeroTarget = (emp.mtdTotalTarget == 0 || (emp.hasRoster && emp.onsiteDays == 0));

                                        if (zeroTarget)
                                        {
                                            rowClass = "league-tr-normal";
                                            rankClass = "league-rank-no-movement";
                                            rankText = "-";
                                        }
                                        else if (empIdx <= 3)
                                        {
                                            rowClass = "league-tr-champions";
                                            rankClass = "league-rank-champions";
                                            if (empIdx == 1) rankText = "🥇 1";
                                            else if (empIdx == 2) rankText = "🥈 2";
                                            else if (empIdx == 3) rankText = "🥉 3";
                                        }
                                        else if (emp.complianceRate == 0)
                                        {
                                            rowClass = "league-tr-no-movement";
                                            rankClass = "league-rank-no-movement";
                                        }
                                        else if (empIdx >= activePlayerCount - 1 && activePlayerCount > 4)
                                        {
                                            rowClass = "league-tr-relegation";
                                            rankClass = "league-rank-relegation";
                                        }

                                        var rowStyle = zeroTarget ? "background-color: #f8fafc !important;" : $"background-color: {GetRowBgColor((double)emp.totalScore)} !important;";

                                        <tr class="@rowClass player-row" style="@rowStyle" data-dept="@emp.departmentName">
                                            <td class="text-center">
                                                <div class="league-rank-pill @rankClass" style="font-size: 9px; min-width: 26px;">@rankText</div>
                                            </td>
                                            <td class="align-left">
                                                <div class="fw-bold d-inline-flex align-items-center flex-wrap gap-1" style="color: #334155; font-size: 13px;">
                                                    <span>@emp.name</span>
                                                    @if (emp.isNewHire == true)
                                                    {
                                                        <span class="badge badge-newhire" title="Karyawan baru bergabung (@(emp.tanggalMasukStr ?? "Baru")) (Target dihitung proporsional)">
                                                            <i class="bi bi-sparkles me-1 text-warning"></i>New Hire
                                                        </span>
                                                    }
                                                    @if (emp.isNonTarget == true)
                                                    {
                                                        if (emp.isActivelyReporting == true)
                                                        {
                                                            <span class="badge bg-success text-white py-0 px-1" style="font-size: 9px; font-weight: 700;" title="Karyawan Non-Target yang aktif membuat laporan SAP (@emp.totalActualAll laporan)">
                                                                <i class="bi bi-lightning-charge-fill me-1"></i>Non-Target Aktif (@emp.totalActualAll SAP)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-muted border py-0 px-1" style="font-size: 9px;" title="Karyawan Bebas Target SAP">
                                                                Non-Target
                                                            </span>
                                                        }
                                                    }
                                                </div>
                                                <div style="font-size: 10px; color: #64748b;">
                                                    @emp.nik &bull; <span class="badge bg-light text-dark py-0" style="font-size: 9px;">@emp.departmentName</span> &bull; <span style="font-size: 9px; color: #94a3b8;">@(emp.jabatanName ?? "-")</span>
                                                    @if (emp.hasRoster)
                                                    {
                                                        <span>&bull;</span>
                                                        if (emp.onsiteDays == 0)
                                                        {
                                                            <span class="badge bg-secondary text-white py-0" style="font-size: 9px; background-color: #64748b !important;" title="Sedang tidak bertugas / Cuti di periode ini"><i class="bi bi-pause-circle me-1"></i>0 Hari Onsite (Cuti)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-info text-white py-0" style="font-size: 9px; background-color: #0ea5e9 !important;">@emp.onsiteDays Hari Onsite</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span>&bull;</span> <span class="badge bg-secondary text-white py-0" style="font-size: 9px; background-color: #64748b !important;">Roster belum di seting</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold" style="font-size: 13px;">
                                                @if (emp.isNonTarget == true)
                                                {
                                                    if (emp.isActivelyReporting == true)
                                                    {
                                                        <span class="badge bg-success text-white" style="font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 6px;" title="Aktif membuat @emp.totalActualAll laporan SAP">
                                                            AKTIF (@emp.totalActualAll)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge" style="background-color: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px;" title="Non-Target SAP">
                                                            NON-TARGET
                                                        </span>
                                                    }
                                                }
                                                else if (zeroTarget)
                                                {
                                                    <span class="badge" style="background-color: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px;" title="Bebas target (0 Hari Onsite / Cuti)">
                                                        CUTI / OFF
                                                    </span>
                                                }
                                                else
                                                {
                                                    <div style="color: @GetRateColor((double)emp.totalScore); font-size: 13px;">@emp.totalScore%</div>
                                                    <div style="font-size: 9px; color: #64748b; font-weight: normal;" title="Capaian Kuantitatif Target">Capaian: @emp.complianceRate%</div>
                                                }
                                            </td>
                                            <td class="text-center" style="white-space: nowrap;">
                                                @GetEmpFormDotsHtml(emp.hazard.actual, emp.hazard.target, emp.inspeksi.actual, emp.inspeksi.target, emp.safetyTalk.actual, emp.safetyTalk.target, emp.observasi.actual, emp.observasi.target, emp.coaching.actual, emp.coaching.target)
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 10px;" type="button" data-bs-toggle="collapse" data-bs-target="#detail-@emp.nik" aria-expanded="false">
                                                    Detail <i class="bi bi-chevron-down ms-1"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        <tr class="collapse player-row" id="detail-@emp.nik" data-dept="@emp.departmentName" style="background-color: #f8fafc;">
                                            <td colspan="5" class="p-3">
                                                <div class="p-2.5 border rounded bg-white shadow-xs">
                                                    <div class="fw-bold text-dark mb-2" style="font-size: 11px; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px;">
                                                        Aktivitas K3 Bulan Ini (Realisasi / Target)
                                                    </div>
                                                    <div class="row text-center g-2" style="font-size: 11px;">
                                                        <div class="col-4 col-sm-auto flex-fill">
                                                            <div class="text-muted">Hazard</div>
                                                            <div class="fw-bold">@emp.hazard.actual / @emp.hazard.target</div>
                                                        </div>
                                                        <div class="col-4 col-sm-auto flex-fill">
                                                            <div class="text-muted">Inspeksi</div>
                                                            <div class="fw-bold">@emp.inspeksi.actual / @emp.inspeksi.target</div>
                                                        </div>
                                                        <div class="col-4 col-sm-auto flex-fill">
                                                            <div class="text-muted">S. Talk</div>
                                                            <div class="fw-bold">@emp.safetyTalk.actual / @emp.safetyTalk.target</div>
                                                        </div>
                                                        <div class="col-4 col-sm-auto flex-fill">
                                                            <div class="text-muted">Observasi</div>
                                                            <div class="fw-bold">@emp.observasi.actual / @emp.observasi.target</div>
                                                        </div>
                                                        <div class="col-4 col-sm-auto flex-fill">
                                                            <div class="text-muted">Coaching</div>
                                                            <div class="fw-bold">@emp.coaching.actual / @emp.coaching.target</div>
                                                        </div>
                                                        <div class="col-4 col-sm-auto flex-fill bg-light rounded" style="border-left: 2px solid #f59e0b;">
                                                            <div class="text-muted">P5M *</div>
                                                            <div class="fw-bold text-warning-emphasis">@emp.p5m.actual / @emp.p5m.target</div>
                                                        </div>
                                                        <div class="col-4 col-sm-auto flex-fill bg-light rounded" style="border-left: 2px solid #10b981;">
                                                            <div class="text-muted">Close Rate</div>
                                                            <div class="fw-bold" style="color: @GetRateColor((double)emp.closeRate);">@FormatRate((double)emp.closeRate)</div>
                                                        </div>
                                                    </div>

                                                    @if (!zeroTarget && emp.isTargetSap == true)
                                                    {
                                                        <div class="mt-2.5 p-2.5 border rounded" style="background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%); border-color: #e2e8f0 !important;">
                                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-2 pb-1.5" style="border-bottom: 1px dashed #cbd5e1;">
                                                                <div class="d-flex align-items-center gap-1.5">
                                                                    <span class="badge bg-primary px-1.5 py-0.5" style="font-size: 10px;"><i class="bi bi-calculator-fill me-1"></i>FORMULA SKOR</span>
                                                                    <span class="fw-bold text-dark" style="font-size: 11px;">Rincian Perhitungan Skor Akhir (PTS)</span>
                                                                </div>
                                                                <div>
                                                                    <span class="badge bg-dark text-white px-2 py-1 shadow-sm" style="font-size: 11px; font-weight: 700;">
                                                                        Skor Akhir: @emp.totalScore pts (@emp.totalScore%)
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            
                                                            <div class="row g-2 text-center" style="font-size: 11px;">
                                                                <div class="col-6 col-md-3">
                                                                    <div class="p-2 rounded bg-white border shadow-xs h-100">
                                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                                            <span class="text-muted" style="font-size: 10px; font-weight: 600;">1. Close Rate</span>
                                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 px-1 py-0" style="font-size: 9px;">Bobot 50%</span>
                                                                        </div>
                                                                        <div class="fw-bold fs-6 text-success">@emp.scoreCloseRate%</div>
                                                                        <div class="text-muted pt-1" style="font-size: 10px; border-top: 1px solid #f1f5f9;">
                                                                            50% &times; @emp.scoreCloseRate% = <strong class="text-dark">@emp.ptsClose pts</strong>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-6 col-md-3">
                                                                    <div class="p-2 rounded bg-white border shadow-xs h-100">
                                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                                            <span class="text-muted" style="font-size: 10px; font-weight: 600;">2. Kualitas</span>
                                                                            <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-20 px-1 py-0" style="font-size: 9px;">Bobot 25%</span>
                                                                        </div>
                                                                        <div class="fw-bold fs-6 text-warning-emphasis">@emp.scoreKualitas%</div>
                                                                        <div class="text-muted pt-1" style="font-size: 10px; border-top: 1px solid #f1f5f9;">
                                                                            25% &times; @emp.scoreKualitas% = <strong class="text-dark">@emp.ptsKualitas pts</strong>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-6 col-md-3">
                                                                    <div class="p-2 rounded bg-white border shadow-xs h-100">
                                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                                            <span class="text-muted" style="font-size: 10px; font-weight: 600;">3. Capaian</span>
                                                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 px-1 py-0" style="font-size: 9px;">Bobot 15%</span>
                                                                        </div>
                                                                        <div class="fw-bold fs-6 text-primary">@emp.scoreCapaian%</div>
                                                                        <div class="text-muted pt-1" style="font-size: 10px; border-top: 1px solid #f1f5f9;">
                                                                            15% &times; @emp.scoreCapaian% = <strong class="text-dark">@emp.ptsCapaian pts</strong>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-6 col-md-3">
                                                                    <div class="p-2 rounded bg-white border shadow-xs h-100">
                                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                                            <span class="text-muted" style="font-size: 10px; font-weight: 600;">4. Skala Beban</span>
                                                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-20 px-1 py-0" style="font-size: 9px;">Bobot 10%</span>
                                                                        </div>
                                                                        <div class="fw-bold fs-6 text-info">@emp.scoreSkalaBeban%</div>
                                                                        <div class="text-muted pt-1" style="font-size: 10px; border-top: 1px solid #f1f5f9;">
                                                                            10% &times; @emp.scoreSkalaBeban% = <strong class="text-dark">@emp.ptsBeban pts</strong>
                                                                        </div>
                                                                        <div class="text-muted" style="font-size: 9px; margin-top: 2px;">
                                                                            Target: @emp.mtdTotalTarget / Max: @emp.maxTargetPlayer
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Penjelasan Rumus Skor Liga -->
<div class="modal fade" id="leagueScoringModal" tabindex="-1" aria-labelledby="leagueScoringModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white p-3 px-4" style="background: linear-gradient(135deg, #1e3a8a, #2563eb) !important;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-white bg-opacity-20 p-2 d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                        <i class="bi bi-calculator-fill fs-5 text-white"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="leagueScoringModalLabel">Metodologi & Bobot Perhitungan Skor Liga</h5>
                        <div class="text-white-50" style="font-size: 12px;">Sistem pembobotan performa terintegrasi (Identik dengan Menu Compliance)</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <!-- Ringkasan Rumus -->
                <div class="p-3 rounded-3 mb-4 text-center shadow-sm" style="background: #ffffff; border: 1px solid #bfdbfe;">
                    <div class="text-muted fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase;">Formula Agregat PTS</div>
                    <div class="fw-bold fs-5 text-primary">
                        Skor = (50% &times; Close Rate) + (25% &times; Kualitas) + (15% &times; Capaian) + (10% &times; Skala Beban)
                    </div>
                </div>

                <div class="row g-3">
                    <!-- 1. Close Rate -->
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded p-2 text-success" style="background: #ecfdf5;"><i class="bi bi-shield-check fs-5"></i></div>
                                        <div class="fw-bold text-dark" style="font-size: 14px;">1. Close Rate Action Plan</div>
                                    </div>
                                    <span class="badge bg-success rounded-pill px-2.5 py-1" style="font-size: 11px;">Bobot 50%</span>
                                </div>
                                <p class="text-muted mb-0" style="font-size: 12px; line-height: 1.5;">
                                    Tingkat penyelesaian dan tindak lanjut temuan bahaya/isu K3LH (Action Plan Closed). Memiliki bobot terbesar karena tindakan korektif nyata merupakan faktor kunci keselamatan.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Kualitas -->
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded p-2 text-warning" style="background: #fffbeb;"><i class="bi bi-stars fs-5"></i></div>
                                        <div class="fw-bold text-dark" style="font-size: 14px;">2. Kualitas Input (Mutu)</div>
                                    </div>
                                    <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1" style="font-size: 11px;">Bobot 25%</span>
                                </div>
                                <p class="text-muted mb-0" style="font-size: 12px; line-height: 1.5;">
                                    Rata-rata validasi mutu data laporan SAP (Hazard, Inspeksi, Observasi, Coaching, Safety Talk) yang dievaluasi secara objektif oleh AI Safety Validator.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Capaian -->
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded p-2 text-primary" style="background: #eff6ff;"><i class="bi bi-bullseye fs-5"></i></div>
                                        <div class="fw-bold text-dark" style="font-size: 14px;">3. Capaian Target (Volume)</div>
                                    </div>
                                    <span class="badge bg-primary rounded-pill px-2.5 py-1" style="font-size: 11px;">Bobot 15%</span>
                                </div>
                                <p class="text-muted mb-0" style="font-size: 12px; line-height: 1.5;">
                                    Persentase rata-rata penyelesaian target wajib 5 program SAP (maks. 100%). Menilai kepatuhan kuantitatif seluruh anggota skuad.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Skala Beban -->
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded p-2 text-info" style="background: #f0fdfa;"><i class="bi bi-people-fill fs-5"></i></div>
                                        <div class="fw-bold text-dark" style="font-size: 14px;">4. Skala Beban Tenaga Kerja</div>
                                    </div>
                                    <span class="badge bg-info text-white rounded-pill px-2.5 py-1" style="font-size: 11px;">Bobot 10%</span>
                                </div>
                                <p class="text-muted mb-0" style="font-size: 12px; line-height: 1.5;">
                                    Apresiasi keadilan operasional berdasarkan rasio jumlah karyawan aktif. Memberikan faktor proporsional bagi entitas dengan skala operasi dan personil lebih besar.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info d-flex align-items-center gap-2 mt-3 mb-0 py-2 px-3 border-0 rounded-3" style="font-size: 12px; background: #e0f2fe; color: #0369a1;">
                    <i class="bi bi-lightbulb-fill text-info fs-6"></i>
                    <span><strong>Tips:</strong> Arahkan kursor / sentuh angka <strong>PTS (ⓘ)</strong> pada tabel klasemen mana saja untuk melihat kalkulasi detail angka riil tiap perusahaan.</span>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-white">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal" style="border-radius: 8px; font-size: 13px;">Tutup</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            new bootstrap.Tooltip(tooltipTriggerEl, { container: 'body', sanitize: false });
        });
    });

    function filterPlayerTable(deptName) {
        const rows = document.querySelectorAll('.player-row');
        const alertBox = document.getElementById('filterAlert');
        const alertText = document.getElementById('filterAlertText');
        const resetBtn = document.getElementById('resetFilterBtn');

        let matchCount = 0;

        rows.forEach(row => {
            const rowDept = row.getAttribute('data-dept');
            if (rowDept === deptName) {
                row.classList.remove('d-none');
                matchCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        // Update alert layout
        if (alertBox) {
            alertBox.classList.remove('d-none');
            alertBox.classList.add('d-flex');
            alertBox.style.backgroundColor = '#ecfdf5';
            alertBox.style.color = '#047857';
        }
        if (alertText) {
            alertText.innerHTML = 'Menampilkan Skuad Klub <strong>' + deptName + '</strong> (' + (matchCount / 2) + ' Pemain)';
        }
        
        currentSquadDeptFilter = deptName; // Store filter state
        resetBtn.classList.remove('d-none');

        // Smooth scroll to squad section
        const squadSec = document.getElementById('squadSection');
        if (squadSec) {
            squadSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
            
            // Update podium if fullscreen
            if (squadSec.classList.contains('is-fullscreen')) {
                updatePodium();
            }
        }
    }

    function resetPlayerFilter() {
        const rows = document.querySelectorAll('.player-row');
        const alertBox = document.getElementById('filterAlert');
        const alertText = document.getElementById('filterAlertText');
        const resetBtn = document.getElementById('resetFilterBtn');

        rows.forEach(row => {
            row.classList.remove('d-none');
            // Hide collapse details by default
            if (row.classList.contains('collapse')) {
                row.classList.remove('show');
            }
        });

        if (alertBox) {
            alertBox.classList.remove('d-flex');
            alertBox.classList.add('d-none');
        }
        if (alertText) {
            alertText.innerHTML = '';
        }
        
        currentSquadDeptFilter = null; // Reset filter state
        resetBtn.classList.add('d-none');

        // Reset details toggle button state
        const detailsBtn = document.getElementById('toggleAllDetailsBtn');
        const detailsIcon = document.getElementById('detailsIcon');
        const detailsText = document.getElementById('detailsText');
        if (detailsBtn && detailsIcon && detailsText) {
            detailsIcon.className = 'bi bi-eye';
            detailsText.textContent = 'Buka Rincian';
            detailsBtn.title = 'Tampilkan Semua Rincian Kepatuhan';
            detailsBtn.classList.remove('btn-light', 'text-dark', 'fw-bold');
            detailsBtn.classList.add('btn-outline-light');
        }

        // Update podium if fullscreen
        const squadSec = document.getElementById('squadSection');
        if (squadSec && squadSec.classList.contains('is-fullscreen')) {
            updatePodium();
        }
    }

    function toggleSquadHeight() {
        const squadSec = document.getElementById('squadSection');
        const btn = document.getElementById('toggleFullHeightBtn');
        const icon = document.getElementById('heightIcon');
        const text = document.getElementById('heightText');
        
        const isFullHeight = squadSec.classList.toggle('is-fullheight-active');
        
        if (isFullHeight) {
            icon.className = 'bi bi-arrows-angle-contract';
            text.textContent = 'Normal';
            btn.title = 'Kembali ke Tinggi Normal';
            btn.classList.remove('btn-outline-light');
            btn.classList.add('btn-light', 'text-dark', 'fw-bold');
        } else {
            icon.className = 'bi bi-arrows-angle-expand';
            text.textContent = 'Tinggi Penuh';
            btn.title = 'Tinggi Penuh (Buka Scroll untuk Screenshot)';
            btn.classList.remove('btn-light', 'text-dark', 'fw-bold');
            btn.classList.add('btn-outline-light');
        }
    }

    function toggleSquadFullscreen() {
        const squadSec = document.getElementById('squadSection');
        const btn = document.getElementById('toggleFullscreenBtn');
        const icon = document.getElementById('fullscreenIcon');
        const text = document.getElementById('fullscreenText');
        
        const isFullscreen = squadSec.classList.toggle('is-fullscreen');
        document.body.classList.toggle('squad-fullscreen-active', isFullscreen);
        
        if (isFullscreen) {
            updatePodium();
            icon.className = 'bi bi-fullscreen-exit';
            text.textContent = 'Layar Normal';
            btn.title = 'Keluar dari Layar Penuh';
            btn.classList.remove('btn-outline-light');
            btn.classList.add('btn-light', 'text-dark', 'fw-bold');
        } else {
            icon.className = 'bi bi-fullscreen';
            text.textContent = 'Layar Penuh';
            btn.title = 'Layar Penuh (Fokus Mode)';
            btn.classList.remove('btn-light', 'text-dark', 'fw-bold');
            btn.classList.add('btn-outline-light');
        }
    }

    function toggleAllDetails() {
        const squadSec = document.getElementById('squadSection');
        const details = squadSec.querySelectorAll('tr.collapse.player-row');
        const btn = document.getElementById('toggleAllDetailsBtn');
        const icon = document.getElementById('detailsIcon');
        const text = document.getElementById('detailsText');
        
        let anyHidden = false;
        details.forEach(d => {
            if (!d.classList.contains('d-none') && !d.classList.contains('show')) {
                anyHidden = true;
            }
        });
        
        details.forEach(d => {
            if (!d.classList.contains('d-none')) {
                if (anyHidden) {
                    d.classList.add('show');
                } else {
                    d.classList.remove('show');
                }
            }
        });
        
        const detailBtns = squadSec.querySelectorAll('button[data-bs-toggle="collapse"]');
        detailBtns.forEach(b => {
            const parentRow = b.closest('tr');
            if (parentRow && !parentRow.classList.contains('d-none')) {
                b.setAttribute('aria-expanded', anyHidden ? 'true' : 'false');
            }
        });
        
        if (anyHidden) {
            icon.className = 'bi bi-eye-slash';
            text.textContent = 'Tutup Rincian';
            btn.title = 'Sembunyikan Semua Detail Rincian';
            btn.classList.remove('btn-outline-light');
            btn.classList.add('btn-light', 'text-dark', 'fw-bold');
        } else {
            icon.className = 'bi bi-eye';
            text.textContent = 'Buka Rincian';
            btn.title = 'Tampilkan Semua Rincian Kepatuhan';
            btn.classList.remove('btn-light', 'text-dark', 'fw-bold');
            btn.classList.add('btn-outline-light');
        }
    }

    function updatePodium() {
        const rows = document.querySelectorAll('#playerTableBody tr.player-row:not(.collapse)');
        const visibleRows = Array.from(rows).filter(row => !row.classList.contains('d-none'));
        const podiumContainer = document.getElementById('squadPodium');
        
        if (!podiumContainer) return;
        
        const topPlayers = [];
        for (let i = 0; i < visibleRows.length; i++) {
            if (topPlayers.length >= 3) break;
            
            const nameEl = visibleRows[i].querySelector('.fw-bold');
            if (!nameEl) continue;
            
            const name = nameEl.textContent.trim();
            const deptBadge = visibleRows[i].querySelector('.badge');
            const dept = deptBadge ? deptBadge.textContent.trim() : '';
            
            const cells = visibleRows[i].getElementsByTagName('td');
            if (cells.length < 3) continue;
            const rate = cells[2].textContent.trim();
            
            topPlayers.push({ name, dept, rate });
        }
        
        if (topPlayers.length === 0) {
            podiumContainer.style.display = 'none';
            return;
        }
        
        let html = '';
        
        // 2nd Place (Silver)
        if (topPlayers.length >= 2) {
            html += `
            <div class="podium-step podium-silver">
                <div class="podium-avatar">🥈</div>
                <div class="podium-name" title="${topPlayers[1].name}">${topPlayers[1].name}</div>
                <div class="podium-dept" title="${topPlayers[1].dept}">${topPlayers[1].dept}</div>
                <div class="podium-rate">${topPlayers[1].rate}</div>
                <div class="podium-block">2</div>
            </div>`;
        } else {
            html += `
            <div class="podium-step podium-silver" style="opacity: 0.3;">
                <div class="podium-avatar">🥈</div>
                <div class="podium-name">-</div>
                <div class="podium-dept">-</div>
                <div class="podium-rate">0%</div>
                <div class="podium-block">2</div>
            </div>`;
        }
        
        // 1st Place (Gold)
        if (topPlayers.length >= 1) {
            html += `
            <div class="podium-step podium-gold">
                <div class="podium-avatar">🏆 🥇</div>
                <div class="podium-name" title="${topPlayers[0].name}">${topPlayers[0].name}</div>
                <div class="podium-dept" title="${topPlayers[0].dept}">${topPlayers[0].dept}</div>
                <div class="podium-rate">${topPlayers[0].rate}</div>
                <div class="podium-block">1</div>
            </div>`;
        }
        
        // 3rd Place (Bronze)
        if (topPlayers.length >= 3) {
            html += `
            <div class="podium-step podium-bronze">
                <div class="podium-avatar">🥉</div>
                <div class="podium-name" title="${topPlayers[2].name}">${topPlayers[2].name}</div>
                <div class="podium-dept" title="${topPlayers[2].dept}">${topPlayers[2].dept}</div>
                <div class="podium-rate">${topPlayers[2].rate}</div>
                <div class="podium-block">3</div>
            </div>`;
        } else {
            html += `
            <div class="podium-step podium-bronze" style="opacity: 0.3;">
                <div class="podium-avatar">🥉</div>
                <div class="podium-name">-</div>
                <div class="podium-dept">-</div>
                <div class="podium-rate">0%</div>
                <div class="podium-block">3</div>
            </div>`;
        }
        
        podiumContainer.innerHTML = html;
    }

    let currentSquadDeptFilter = null; // Track active filter

    function getSelectedTargetFilter() {
        const radio = document.querySelector('input[name="targetFilter"]:checked');
        return radio ? radio.value : '@targetFilter';
    }

    function downloadSquadExcel(clickedBtn) {
        const companyId = '@selectedCompanyId';
        const mode = '@currentMode';
        const year = '@selectedYear';
        const month = '@selectedMonth';
        const targetFilter = getSelectedTargetFilter();
        let url = '@Url.Action("ExportLeagueToExcel", "Performance")?companyId=' + companyId + '&mode=' + encodeURIComponent(mode) + '&year=' + year + '&month=' + month + '&targetFilter=' + encodeURIComponent(targetFilter);
        if ('@ViewBag.ParentId') {
            url += '&parentId=' + '@ViewBag.ParentId';
        }
        if (currentSquadDeptFilter) {
            url += '&departmentName=' + encodeURIComponent(currentSquadDeptFilter);
        }
        executeExcelDownload(
            url,
            "Menyiapkan Laporan Klasemen...",
            "Sedang menyusun data klasemen & kepatuhan skuad SAP ke format Excel (.xlsx)...",
            clickedBtn
        );
    }

    function downloadSapDetailExcel(clickedBtn) {
        const companyId = '@selectedCompanyId';
        const mode = '@currentMode';
        const year = '@selectedYear';
        const month = '@selectedMonth';
        const targetFilter = getSelectedTargetFilter();
        let url = '@Url.Action("ExportSapDetailToExcel", "Performance")?companyId=' + companyId + '&mode=' + encodeURIComponent(mode) + '&year=' + year + '&month=' + month + '&targetFilter=' + encodeURIComponent(targetFilter);
        if ('@ViewBag.ParentId') {
            url += '&parentId=' + '@ViewBag.ParentId';
        }
        if (currentSquadDeptFilter) {
            url += '&departmentName=' + encodeURIComponent(currentSquadDeptFilter);
        }
        executeExcelDownload(
            url,
            "🤖 AI Memproses & Mengaudit Detail SAP...",
            "Sedang mengaudit mutu laporan SAP (Hazard, Inspeksi, Action Plan, Observasi, P5M) dan menyusun Dashboard Eksekutif...",
            clickedBtn
        );
    }

    async function executeExcelDownload(url, title, desc, clickedBtn) {
        const overlay = document.getElementById('downloadLoadingOverlay');
        const modalTitle = document.getElementById('downloadModalTitle');
        const modalDesc = document.getElementById('downloadModalDesc');
        const pBar = document.getElementById('downloadProgressBar');

        if (modalTitle) modalTitle.innerText = title || "Menyiapkan Dokumen Excel...";
        if (modalDesc) modalDesc.innerText = desc || "Sedang memproses dan mengaudit data SAP...";
        if (pBar) {
            pBar.className = "progress-bar progress-bar-striped progress-bar-animated bg-primary";
            pBar.style.width = "100%";
        }

        let origHtml = "";
        if (clickedBtn) {
            origHtml = clickedBtn.innerHTML;
            clickedBtn.disabled = true;
            clickedBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Mengunduh...';
        }

        if (overlay) overlay.style.display = 'flex';

        try {
            const response = await fetch(url);
            if (!response.ok) {
                throw new Error("Gagal mengunduh file (HTTP " + response.status + ")");
            }

            let fileName = "Laporan_SAP.xlsx";
            const disposition = response.headers.get('Content-Disposition') || response.headers.get('content-disposition');
            if (disposition && disposition.indexOf('filename=') !== -1) {
                const matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                if (matches != null && matches[1]) {
                    fileName = matches[1].replace(/['"]/g, '');
                }
            }

            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = downloadUrl;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(downloadUrl);
            document.body.removeChild(a);

            if (modalTitle) modalTitle.innerText = "✅ Berhasil Diunduh!";
            if (modalDesc) modalDesc.innerText = "File " + fileName + " siap dibuka.";
            if (pBar) {
                pBar.className = "progress-bar bg-success";
                pBar.style.width = "100%";
            }
            if (clickedBtn) {
                clickedBtn.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i> Selesai!';
            }

            setTimeout(() => {
                if (overlay) overlay.style.display = 'none';
                if (clickedBtn) {
                    clickedBtn.disabled = false;
                    clickedBtn.innerHTML = origHtml;
                }
            }, 1200);

        } catch (err) {
            console.error(err);
            if (modalTitle) modalTitle.innerText = "❌ Terjadi Kendala";
            if (modalDesc) modalDesc.innerText = "Gagal memproses unduhan. Silakan coba kembali.";
            if (pBar) {
                pBar.className = "progress-bar bg-danger";
                pBar.style.width = "100%";
            }
            setTimeout(() => {
                if (overlay) overlay.style.display = 'none';
                if (clickedBtn) {
                    clickedBtn.disabled = false;
                    clickedBtn.innerHTML = origHtml;
                }
            }, 2000);
        }
    }

    // ─── Searchable Company Dropdown ───────────────────────────────────────
    function toggleCompanyDropdown() {
        const menu    = document.getElementById('companyDropdownMenu');
        const chevron = document.getElementById('companyChevron');
        const input   = document.getElementById('companySearchInput');
        const isOpen  = menu.style.display !== 'none';
        if (isOpen) {
            menu.style.display = 'none';
            chevron.style.transform = 'rotate(0deg)';
        } else {
            menu.style.display = 'block';
            chevron.style.transform = 'rotate(180deg)';
            if (input) { input.value = ''; filterCompanyList(''); input.focus(); }
        }
    }

    function filterCompanyList(query) {
        const q = query.toLowerCase().trim();
        document.querySelectorAll('#companyListContainer .company-option').forEach(function(el) {
            const label = (el.getAttribute('data-label') || '').toLowerCase();
            el.style.display = q === '' || label.includes(q) ? '' : 'none';
        });
    }

    function selectCompany(id, label) {
        document.getElementById('companyIdInput').value = id;
        document.getElementById('companySelectedLabel').textContent = label;
        document.getElementById('companyDropdownMenu').style.display = 'none';
        document.getElementById('companyChevron').style.transform = 'rotate(0deg)';
        // Update active highlight
        document.querySelectorAll('#companyListContainer .company-option').forEach(function(el) {
            const active = parseInt(el.getAttribute('data-value')) === id;
            el.style.background = active ? '#eff6ff' : '';
            el.style.color      = active ? '#1d4ed8' : '';
        });
        document.getElementById('leagueFilterForm').submit();
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
        const wrapper = document.getElementById('companyDropdownWrapper');
        const menu    = document.getElementById('companyDropdownMenu');
        if (wrapper && menu && !wrapper.contains(e.target)) {
            menu.style.display = 'none';
            const chevron = document.getElementById('companyChevron');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
        }
    });
    // ─── Filter Tier 3 Standings Table ──────────────────────────────────
    function filterTier3Table() {
        const input = document.getElementById('tier3SearchInput');
        if (!input) return;
        const query = input.value.toLowerCase().trim();
        const table = document.getElementById('tier3Table');
        if (!table) return;
        table.querySelectorAll('tbody tr').forEach(function(row) {
            const nameEl = row.querySelector('.tier3-comp-name');
            if (nameEl) {
                const name = nameEl.textContent.toLowerCase();
                row.style.display = query === '' || name.includes(query) ? '' : 'none';
            }
        });
    }
    // ───────────────────────────────────────────────────────────────────────
</script>
