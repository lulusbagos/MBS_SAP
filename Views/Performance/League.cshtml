                                            <div class="fw-bold text-dark" style="font-size: 13px;">3. Kualitas Mutu Laporan SAP</div>
                                        </div>
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 shadow-xs" style="font-size: 12px; font-weight: 800;">Bobot 25%</span>
                                    </div>
                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                        <span class="fw-bold fs-4" style="color: #d97706;" id="mRealKualitasScore">-</span>
                                        <span class="text-secondary" style="font-size: 11.5px;">&rarr; 25% &times; <span id="mRealKualitasFormula">-</span> = <strong class="text-dark" id="mRealKualitasPts">-</strong></span>
                                    </div>
                                    <div class="p-2 rounded bg-light border text-secondary" style="font-size: 11px; line-height: 1.45;">
                                        <div id="mRealKualitasDetails" class="mb-1 fw-semibold text-dark">-</div>
                                        <div class="text-muted" id="mRealKualitasDesc">-</div>
