                        const scopeTitle = (lMode === 'company') ? 'Super League' : ((lMode === 'core') ? 'Perusahaan Inti' : 'Perusahaan');
                        elBebanDesc.textContent = parseFloat(scoreBeban) >= 100 
                            ? 'Memegang target tugas operasional tertinggi (' + userTgt + ' tugas) di ' + scopeTitle + ', berhak atas 10.0 pts beban penuh.' 
                            : 'Rasio proporsional (' + userTgt + ' / ' + maxTgt + ' \u00d7 100% = ' + scoreBeban + '%) menghargai karyawan dengan target tugas lebih banyak agar memperoleh poin beban kerja proporsional lebih besar.';
                    }
                }
                
                // Akumulasi Bawah
                const elSumClose = document.getElementById('mSumClose');
                if (elSumClose) elSumClose.textContent = ptsClose;
                const elSumKualitas = document.getElementById('mSumKualitas');
                if (elSumKualitas) elSumKualitas.textContent = ptsKualitas;
                const elSumCapaian = document.getElementById('mSumCapaian');
                if (elSumCapaian) elSumCapaian.textContent = ptsCapaian;
                const elSumBeban = document.getElementById('mSumBeban');
                if (elSumBeban) elSumBeban.textContent = ptsBeban;
                const elSumTotal = document.getElementById('mSumTotal');
                if (elSumTotal) elSumTotal.textContent = totalScore + ' pts (' + totalScore + '%)';
                
                // Otomatis buka Tab 1 (Kalkulasi Riil)
                const realTabBtn = document.getElementById('tab-real-calc-link');
                if (realTabBtn && typeof bootstrap !== 'undefined') {
                    const bsTab = bootstrap.Tab.getOrCreateInstance(realTabBtn);
                    bsTab.show();
                }
            });
        });
        
        // Tombol Umum dari Header Rumus (tanpa user spesifik)
        const generalModalBtn = document.querySelector('button[data-bs-target="#leagueScoringModal"]:not(.btn-open-scoring-modal)');
        if (generalModalBtn) {
            generalModalBtn.addEventListener('click', function() {
                const modalTitle = document.getElementById('scoringModalTitle');
                if (modalTitle) modalTitle.textContent = 'Metodologi & Bobot Perhitungan Skor Liga';
                const modalSub = document.getElementById('scoringModalSubtitle');
                if (modalSub) modalSub.textContent = 'Sistem pembobotan performa terintegrasi (Identik dengan Menu Compliance)';
                const sopTabBtn = document.getElementById('tab-sop-guide-link');
                if (sopTabBtn && typeof bootstrap !== 'undefined') {
                    const bsTab = bootstrap.Tab.getOrCreateInstance(sopTabBtn);
                    bsTab.show();
                }
            });
        }

        const initialDept = '@Html.Raw((ViewBag.DepartmentName as string ?? "").Replace("'", "\\'"))';
        if (initialDept) {
            filterPlayerTable(initialDept);
        }
    });
    // ───────────────────────────────────────────────────────────────────────
</script>
