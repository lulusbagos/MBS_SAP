@model IEnumerable<MBS_SAP.Controllers.ComplianceEmployeeViewModel>
@{
    ViewData["Title"] = "Laporan Kepatuhan SAP";
    var companies = ViewBag.Companies as List<MBS_SAP.Models.PerusahaanView> ?? new List<MBS_SAP.Models.PerusahaanView>();
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    int selectedCompanyId = ViewBag.SelectedCompanyId ?? 0;
    string selectedDeptName = ViewBag.SelectedDepartmentName ?? "";
    
    // Pagination data
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 50;
    int startRow = ((currentPage - 1) * pageSize) + 1;
    int endRow = Math.Min(currentPage * pageSize, totalCount);

    var mainconComparison = (ViewBag.MainconGroupComparison as List<MBS_SAP.Controllers.MainconGroupComparisonViewModel> ?? new List<MBS_SAP.Controllers.MainconGroupComparisonViewModel>())!;
    var mostActiveSubcon = ViewBag.MostActiveSubcon as MBS_SAP.Controllers.MostActiveSubconViewModel;
    var mainconLabelsJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        mainconComparison.Select(x => x.MainconName.Replace("PT ", "").Split(' '))
    ));
    
    // Top 5 Subcon Leaderboard data serialization
    var top5SubconsList = (ViewBag.AllSubconStats as List<MBS_SAP.Controllers.MostActiveSubconViewModel> ?? new List<MBS_SAP.Controllers.MostActiveSubconViewModel>()).Take(5).ToList();
    var top5LabelsJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(top5SubconsList.Select(x => x.PerusahaanName.Replace("PT ", ""))));
    var top5ComplianceJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(top5SubconsList.Select(x => x.ComplianceRate)));
}

<style>
    .report-card {
        background: var(--bg-card);
        border: 2px solid #1e293b;
        border-radius: 16px;
        box-shadow: 5px 5px 0px #1e293b;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .report-header {
        background: var(--bg-card);
        padding: 16px 20px;
        border-bottom: 2px solid #1e293b;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }
    .report-title {
        color: var(--text-main);
        font-weight: 800;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }
    .report-body {
        padding: 20px;
    }
    .tab-btn {
        border-radius: 8px;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        outline: none;
    }
    .tab-active {
        background: var(--color-primary) !important;
        color: white !important;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
    }
    .tab-inactive {
        background: transparent !important;
        color: var(--text-muted) !important;
    }
    .compliance-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }
    .compliance-table thead th {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 12px 14px;
        border: none;
        text-align: center;
    }
    .compliance-table thead th.align-left {
        text-align: left;
    }
    .compliance-row {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        transition: background 0.15s ease;
    }
    .compliance-row:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .compliance-row td {
        padding: 14px;
        vertical-align: middle;
        font-size: 13px;
        color: var(--text-main);
        border: none;
        text-align: center;
    }
    .compliance-row td.align-left {
        text-align: left;
    }
    .compliance-row td:first-child { border-radius: 12px 0 0 12px; }
    .compliance-row td:last-child { border-radius: 0 12px 12px 0; }
    
    .compliance-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 8px;
        display: inline-block;
    }
    .badge-success-sap {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }
    .badge-danger-sap {
        background: rgba(244, 63, 94, 0.15);
        color: #f43f5e;
        border: 1px solid rgba(244, 63, 94, 0.3);
    }
    .badge-neutral-sap {
        background: rgba(100, 116, 139, 0.15);
        color: #94a3b8;
        border: 1px solid rgba(100, 116, 139, 0.3);
    }
    
    .prog-cell {
        font-weight: 700;
        font-size: 12px;
    }
    .prog-ok {
        color: #22c55e;
    }
    .prog-warn {
        color: #f43f5e;
    }
    .prog-neutral {
        color: #94a3b8;
    }
    
    .progress-achievement {
        height: 6px;
        border-radius: 3px;
        background: rgba(255,255,255,0.1);
        overflow: hidden;
        width: 80px;
        margin: 4px auto 0;
    }
    .subcon-tooltip {
        display: none;
        position: absolute;
        bottom: 25px;
        left: 0;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(10px);
        border: 1.5px solid rgba(255, 255, 255, 0.1);
        padding: 10px 14px;
        border-radius: 12px;
        z-index: 100;
        width: 250px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }

    /* Premium Card and Hover Design */
    .premium-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        backdrop-filter: blur(12px);
        position: relative;
    }
    .premium-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #10b981, #3b82f6, #6366f1);
        z-index: 10;
    }
    .premium-header {
        padding: 22px 26px;
        border-bottom: 1.5px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.01);
    }
    .premium-title {
        font-family: 'Outfit', 'Inter', sans-serif;
        color: var(--text-main);
        font-weight: 700;
        font-size: 16px;
        letter-spacing: 0.5px;
        margin: 0;
        display: flex;
        align-items: center;
    }
    .premium-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 30px;
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.1), rgba(56, 189, 248, 0.1));
        color: #0284c7;
        border: 1px solid rgba(2, 132, 199, 0.2);
    }
    .maincon-item {
        background: var(--bg-card);
        border: 1.5px solid var(--border-color);
        border-radius: 16px;
        padding: 20px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
        position: relative;
    }
    .maincon-item:hover {
        border-color: #3b82f6;
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -10px rgba(59, 130, 246, 0.2);
    }
    
    /* Responsive SAP Breakdown Grid */
    .sap-breakdown-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        background: var(--bg-body);
        padding: 12px 8px;
        border-radius: 12px;
        border: 1.5px solid var(--border-color);
        text-align: center;
        gap: 4px;
        margin-top: 10px;
    }
    .sap-cell {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
    .sap-cell:not(:last-child) {
        border-right: 1.5px solid var(--border-color);
    }
    @@media (max-width: 768px) {
        .sap-breakdown-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 12px 8px;
        }
        .sap-cell:not(:last-child) {
            border-right: none;
        }
        .sap-cell {
            padding: 6px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }
    }
    
    /* Program Item Styling */
    .program-card-item {
        background: rgba(255, 255, 255, 0.015);
        border: 1.5px solid var(--border-color);
        border-radius: 12px;
        padding: 12px 14px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .program-card-item:hover {
        border-color: rgba(59, 130, 246, 0.5);
        background: rgba(255, 255, 255, 0.035);
        transform: translateY(-1px);
    }
</style>

<div class="animate-fade-in pb-5">

    <!-- Header Banner -->
    <div class="position-relative mb-4" style="margin: -20px -20px 20px -20px;">
        <div style="background: linear-gradient(135deg, #0284c7, #0369a1); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; padding: 32px 20px 24px; text-align: center; position: relative; overflow: hidden;">
            <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: -30px; left: -10px; width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <i class="bi bi-bar-chart-line-fill text-white mb-2 d-block" style="font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
            <h4 style="font-weight: 800; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.2); margin-bottom: 4px;">PENCAPAIAN KINERJA SAP</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 12px; margin: 0; font-weight: 500;">Pantau kepatuhan target mingguan dan statistik bahaya perusahaan secara real-time.</p>
        </div>
    </div>

    <!-- Tabs Toggle (Redirects back to main page or keeps active) -->
    <div class="d-flex justify-content-center mb-4">
        <div style="background: var(--bg-card); border: 1.5px solid var(--border-color); padding: 4px; border-radius: 12px; display: inline-flex; gap: 4px; flex-wrap: wrap; justify-content: center;">
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabMy" onclick="window.location.href='/Performance?tab=my'">
                <i class="bi bi-person-badge-fill me-1"></i> Pencapaian Saya
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabCompany" onclick="window.location.href='/Performance?tab=company'">
                <i class="bi bi-building-fill me-1"></i> Kinerja Perusahaan
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabHitSafe" onclick="window.location.href='/Performance?tab=hitsafe'">
                <i class="bi bi-geo-alt-fill me-1"></i> Safe Map
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabHierarchy" onclick="window.location.href='/Performance?tab=hierarchy'">
                <i class="bi bi-diagram-3-fill me-1"></i> Hirarki Perusahaan
            </button>
            <button class="tab-btn px-4 py-2 tab-active" id="tabCompliance" onclick="void(0)">
                <i class="bi bi-file-earmark-text-fill me-1"></i> Laporan Kepatuhan
            </button>
        </div>
    </div>



    <!-- KPI Summary Row -->
    @{
        int totalTarget = (ViewBag.TargetH ?? 0) + (ViewBag.TargetI ?? 0) + (ViewBag.TargetS ?? 0) + (ViewBag.TargetO ?? 0) + (ViewBag.TargetC ?? 0);
        int totalActual = (ViewBag.ActualH ?? 0) + (ViewBag.ActualI ?? 0) + (ViewBag.ActualS ?? 0) + (ViewBag.ActualO ?? 0) + (ViewBag.ActualC ?? 0);
        double totalComplianceRate = totalTarget > 0 ? Math.Round((double)totalActual / totalTarget * 100.0, 1) : 0.0;
        double progressComplianceRate = Math.Min(totalComplianceRate, 100.0);
        
        string statusText = "Perlu Peningkatan";
        string statusColor = "#f43f5e";
        if (totalComplianceRate >= 85.0) { statusText = "Sangat Baik"; statusColor = "#22c55e"; }
        else if (totalComplianceRate >= 50.0) { statusText = "Cukup Baik"; statusColor = "#f59e0b"; }
    }
    
    <div class="row g-4 mb-4">
        <!-- KPI card 1: Ringkasan Kepatuhan -->
        <div class="col-lg-4 col-md-12">
            <div class="report-card premium-card h-100 mb-0 d-flex flex-column justify-content-between p-4" style="background: var(--bg-card); position: relative; overflow: hidden;">
                <div style="position: absolute; right: -20px; bottom: -20px; font-size: 130px; color: rgba(255,255,255,0.02); pointer-events: none; transform: rotate(-15deg);">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px; margin-bottom: 8px;">
                        Kepatuhan SAP MTD Group
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <span style="font-size: 46px; font-weight: 900; color: @(totalComplianceRate >= 85.0 ? "#22c55e" : (totalComplianceRate >= 50.0 ? "#f59e0b" : "#f43f5e")); font-family: 'Outfit', sans-serif;">
                            @totalComplianceRate%
                        </span>
                        <span class="badge" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: @statusColor; font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 6px;">
                            @statusText
                        </span>
                    </div>
                    <div class="text-muted" style="font-size: 13px; line-height: 1.5; margin-bottom: 20px;">
                        Total realisasi submisi terhadap target bulanan program wajib (Hazard, Inspeksi, Safety Talk, Observasi, Coaching) dari seluruh karyawan aktif ber-target.
                    </div>
                </div>
                
                <div style="border-top: 1.5px solid var(--border-color); padding-top: 16px;">
                    <div class="d-flex justify-content-between mb-1" style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">
                        <span>Realisasi Submisi</span>
                        <span>@totalActual / @totalTarget</span>
                    </div>
                    <div class="progress" style="height: 8px; border-radius: 4px; background: rgba(255,255,255,0.05); overflow: hidden;">
                        <div class="progress-bar" role="progressbar" style="width: @progressComplianceRate%; background: linear-gradient(90deg, #10b981, #3b82f6); border-radius: 4px;" aria-valuenow="@progressComplianceRate" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI card 2: Detail Program & Gap -->
        <div class="col-lg-8 col-md-12">
            <div class="report-card premium-card h-100 mb-0 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="premium-title" style="font-size: 15px; margin: 0;">
                        <i class="bi bi-grid-fill text-primary me-2"></i>Target & Gap Kepatuhan Program Wajib
                    </h5>
                    <span class="badge" style="background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.25); font-weight: 700; font-size: 10.5px; border-radius: 6px; padding: 4px 8px;">
                        MTD Actual vs Target
                    </span>
                </div>
                
                <div class="row g-3">
                    @{
                        var programsList = new[] {
                            new { Name = "Hazard Report", Target = ViewBag.TargetH ?? 0, Actual = ViewBag.ActualH ?? 0, Icon = "bi-shield-exclamation", Color = "#6366f1" },
                            new { Name = "Inspeksi", Target = ViewBag.TargetI ?? 0, Actual = ViewBag.ActualI ?? 0, Icon = "bi-check2-square", Color = "#3b82f6" },
                            new { Name = "Safety Talk", Target = ViewBag.TargetS ?? 0, Actual = ViewBag.ActualS ?? 0, Icon = "bi-chat-left-quote-fill", Color = "#d97706" },
                            new { Name = "Observasi", Target = ViewBag.TargetO ?? 0, Actual = ViewBag.ActualO ?? 0, Icon = "bi-eye-fill", Color = "#ec4899" },
                            new { Name = "Coaching", Target = ViewBag.TargetC ?? 0, Actual = ViewBag.ActualC ?? 0, Icon = "bi-person-lines-fill", Color = "#a855f7" }
                        };
                    }
                    
                    @foreach (var prog in programsList)
                    {
                        double rawRate = prog.Target > 0 ? Math.Round((double)prog.Actual / prog.Target * 100.0, 1) : 0.0;
                        double pRate = Math.Min(rawRate, 100.0);
                        double gap = rawRate < 100.0 ? Math.Round(100.0 - rawRate, 1) : 0.0;
                        
                        <div class="col-md-6 col-12">
                            <div class="program-card-item">
                                <div class="d-flex justify-content-between align-items-center mb-1.5">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 28px; height: 28px; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); color: @prog.Color;">
                                            <i class="bi @prog.Icon" style="font-size: 13px;"></i>
                                        </div>
                                        <span class="fw-bold" style="font-size: 12.5px; color: var(--text-main);">@prog.Name</span>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold" style="font-size: 12.5px; color: var(--text-main);">@prog.Actual / @prog.Target</span>
                                    </div>
                                </div>
                                
                                <div class="d-flex align-items-center gap-3">
                                    <div class="flex-grow-1">
                                        <div class="progress" style="height: 6px; border-radius: 3px; background: rgba(255,255,255,0.05); overflow: hidden;">
                                            <div class="progress-bar" role="progressbar" style="width: @pRate%; background-color: @prog.Color;" aria-valuenow="@pRate" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                    <span class="fw-bold" style="font-size: 11.5px; color: @prog.Color; width: 42px; text-align: right;">@rawRate%</span>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center mt-2" style="font-size: 10px; border-top: 1px dashed rgba(255,255,255,0.04); padding-top: 6px;">
                                    <span class="text-muted">Kekurangan Target (Gap)</span>
                                    @if (gap > 0.0)
                                    {
                                        <span class="badge" style="background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2); font-weight: 700; font-size: 9px; padding: 2px 6px;">
                                            Kurang @gap%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2); font-weight: 700; font-size: 9px; padding: 2px 6px;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Terpenuhi
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Maincon Group Comparison & Spotlight Row -->
    @if (mainconComparison != null && mainconComparison.Any())
    {
        <div class="row g-4 mb-4">
            <!-- Left Card: Maincon Group Comparison -->
            <div class="col-12">
                <div class="premium-card h-100 mb-0">
                    <div class="premium-header">
                        <h5 class="premium-title">
                            <i class="bi bi-bar-chart-line-fill me-2 text-primary" style="font-size: 18px;"></i>Perbandingan Kepatuhan Maincon Utama (MTD Group)
                        </h5>
                        <span class="premium-badge">
                            Maincon + Subkontraktor
                        </span>
                    </div>
                    <div class="premium-body p-4">
                        <div class="row g-4">
                            <!-- Left Column: The Grouped Bar Chart -->
                            <div class="col-lg-7 col-md-12">
                                <div style="height: 380px; position: relative;">
                                    <canvas id="mainconComparisonChart"></canvas>
                                </div>
                            </div>

                            <!-- Right Column: Comparative Grid Details -->
                            <div class="col-lg-5 col-md-12">
                                <div class="row g-3">
                                    @foreach (var item in mainconComparison)
                                    {
                                        <div class="col-md-12">
                                            <div class="maincon-item">
                                                <div class="d-flex justify-content-between align-items-center mb-2.5">
                                                    <div class="fw-bold" style="font-size: 13.5px; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.5px; font-family: 'Outfit', sans-serif;">
                                                        <i class="bi bi-building-fill text-primary me-1.5"></i>@item.MainconName
                                                    </div>
                                                    <span class="badge" style="background-color: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.25); font-weight: 800; font-size: 11.5px; border-radius: 8px; padding: 5px 10px;">
                                                        Kepatuhan: @item.OverallComplianceRate%
                                                    </span>
                                                </div>
                                                
                                                <!-- Employee count and subcons details -->
                                                <div class="d-flex flex-wrap gap-3 mb-3" style="font-size: 11.5px; color: var(--text-muted);">
                                                    <div>
                                                        <i class="bi bi-people-fill me-1"></i>
                                                        <span class="fw-bold" style="color: var(--text-main);">@item.EmployeesWithTargetCount.ToString("N0")</span> Karyawan Ber-Target
                                                    </div>
                                                    <div class="position-relative" style="cursor: pointer;">
                                                        <i class="bi bi-diagram-3-fill me-1"></i>
                                                        <span class="fw-bold text-decoration-underline text-success" id="subcon-trigger-@item.MainconId">@(item.ChildCompanyNames.Count - item.UncompliantChildCompanyNames.Count) Aktif</span> / @item.ChildCompanyNames.Count Anak
                                                        <div class="subcon-tooltip" id="subcon-tooltip-@item.MainconId">
                                                            <div class="fw-bold text-info mb-1" style="font-size:10px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:4px;">List Subkontraktor:</div>
                                                            @if (item.ChildCompanyNames.Any())
                                                            {
                                                                <ul class="list-unstyled mb-0" style="font-size:10.5px; max-height:120px; overflow-y:auto; line-height:1.4;">
                                                                    @foreach (var sub in item.ChildCompanyNames)
                                                                    {
                                                                        <li class="text-white-50 py-0.5"><i class="bi bi-chevron-right text-info" style="font-size: 8px;"></i> @sub</li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted" style="font-size:10.5px;">Tidak ada anak perusahaan</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="position-relative" style="cursor: pointer;">
                                                        <i class="bi bi-x-circle-fill text-danger me-1"></i>
                                                        <span class="text-danger fw-bold text-decoration-underline" id="uncompliant-trigger-@item.MainconId">@item.UncompliantChildCompanyNames.Count</span> Belum Bergerak
                                                        <div class="subcon-tooltip" id="uncompliant-tooltip-@item.MainconId" style="border-color: #ef4444;">
                                                            <div class="fw-bold text-danger mb-1" style="font-size:10px; border-bottom:1px solid rgba(239, 68, 68, 0.2); padding-bottom:4px;">Subkontraktor Tanpa Pergerakan:</div>
                                                            @if (item.UncompliantChildCompanyNames.Any())
                                                            {
                                                                <ul class="list-unstyled mb-0" style="font-size:10.5px; max-height:120px; overflow-y:auto; line-height:1.4;">
                                                                    @foreach (var sub in item.UncompliantChildCompanyNames)
                                                                    {
                                                                        <li class="text-white-50 py-0.5"><i class="bi bi-x-circle text-danger" style="font-size: 8px;"></i> @sub</li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-success" style="font-size:10.5px;"><i class="bi bi-check-circle-fill me-1"></i> Semua subkontraktor aktif</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
 
                                                <!-- SAP Breakdown metrics -->
                                                <div class="sap-breakdown-grid">
                                                    <div class="sap-cell">
                                                        <div style="font-size: 9px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Hazard</div>
                                                        <div class="fw-extrabold mt-1" style="font-size: 12.5px; color: #6366f1;">@item.HazardComplianceRate%</div>
                                                        <div style="font-size: 8.5px; color: var(--text-muted); opacity: 0.85;">@item.ActualHazard/@item.TargetHazard</div>
                                                    </div>
                                                    <div class="sap-cell">
                                                        <div style="font-size: 9px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Inspeksi</div>
                                                        <div class="fw-extrabold mt-1" style="font-size: 12.5px; color: #3b82f6;">@item.InspeksiComplianceRate%</div>
                                                        <div style="font-size: 8.5px; color: var(--text-muted); opacity: 0.85;">@item.ActualInspeksi/@item.TargetInspeksi</div>
                                                    </div>
                                                    <div class="sap-cell">
                                                        <div style="font-size: 9px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">S-Talk</div>
                                                        <div class="fw-extrabold mt-1" style="font-size: 12.5px; color: #d97706;">@item.SafetyTalkComplianceRate%</div>
                                                        <div style="font-size: 8.5px; color: var(--text-muted); opacity: 0.85;">@item.ActualSafetyTalk/@item.TargetSafetyTalk</div>
                                                    </div>
                                                    <div class="sap-cell">
                                                        <div style="font-size: 9px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Observasi</div>
                                                        <div class="fw-extrabold mt-1" style="font-size: 12.5px; color: #ec4899;">@item.ObservasiComplianceRate%</div>
                                                        <div style="font-size: 8.5px; color: var(--text-muted); opacity: 0.85;">@item.ActualObservasi/@item.TargetObservasi</div>
                                                    </div>
                                                    <div class="sap-cell">
                                                        <div style="font-size: 9px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Coaching</div>
                                                        <div class="fw-extrabold mt-1" style="font-size: 12.5px; color: #a855f7;">@item.CoachingComplianceRate%</div>
                                                        <div style="font-size: 8.5px; color: var(--text-muted); opacity: 0.85;">@item.ActualCoaching/@item.TargetCoaching</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row: Subcontractor Leaderboard -->
            <div class="row mt-4 animate-fade-in">
                <div class="col-12">
                    <div class="report-card premium-card">
                        <div class="report-header premium-header d-flex justify-content-between align-items-center">
                            <h3 class="report-title text-primary m-0" style="font-family: 'Outfit', sans-serif; font-size: 15px; font-weight: 800; letter-spacing: 0.5px;">
                                <i class="bi bi-trophy-fill text-warning me-2"></i>🏆 Top 5 Subkontraktor Terbaik (Leaderboard)
                            </h3>
                            <span class="badge" style="background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.25); font-weight: 700; font-size: 11px; border-radius: 8px; padding: 4px 10px;">
                                Bulan Ini
                            </span>
                        </div>
                        <div class="premium-body p-4">
                            <div class="row g-4">
                                <!-- Left Column: Leaderboard Horizontal Bar Chart -->
                                <div class="col-lg-7 col-md-12">
                                    <div class="chart-wrapper" style="position: relative; height: 320px; width: 100%;">
                                        <canvas id="subconLeaderboardChart"></canvas>
                                    </div>
                                </div>
                                <!-- Right Column: Leaderboard Table/List -->
                                <div class="col-lg-5 col-md-12">
                                    <div class="d-flex flex-column gap-2.5">
                                        @{
                                            int rank = 1;
                                        }
                                        @if (top5SubconsList.Any())
                                        {
                                            @foreach (var sub in top5SubconsList)
                                            {
                                                string rankBadgeStyle = "";
                                                string rankText = rank.ToString();
                                                if (rank == 1) { rankBadgeStyle = "background: linear-gradient(135deg, #f59e0b, #d97706); color: white; box-shadow: 0 4px 10px rgba(245, 158, 11, 0.4);"; rankText = "🥇"; }
                                                else if (rank == 2) { rankBadgeStyle = "background: linear-gradient(135deg, #94a3b8, #64748b); color: white; box-shadow: 0 4px 10px rgba(148, 163, 184, 0.4);"; rankText = "🥈"; }
                                                else if (rank == 3) { rankBadgeStyle = "background: linear-gradient(135deg, #b45309, #78350f); color: white; box-shadow: 0 4px 10px rgba(180, 83, 9, 0.4);"; rankText = "🥉"; }
                                                else { rankBadgeStyle = "background: var(--bg-body); border: 1.5px solid var(--border-color); color: var(--text-muted);"; }

                                                <div class="d-flex align-items-center justify-content-between p-3" style="background: rgba(255, 255, 255, 0.02); border: 1.5px solid var(--border-color); border-radius: 12px; transition: all 0.2s ease;">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; border-radius: 50%; font-size: 13.5px; @rankBadgeStyle">
                                                            @rankText
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold" style="font-size: 12.5px; color: var(--text-main);">@sub.PerusahaanName</div>
                                                            <div style="font-size: 10.5px; color: var(--text-muted);">
                                                                <i class="bi bi-building-fill text-primary me-1"></i>Maincon: <span class="fw-semibold text-decoration-underline">@sub.ParentCompanyName</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="fw-extrabold text-success" style="font-size: 14px; font-family: 'Outfit', sans-serif;">@sub.ComplianceRate%</div>
                                                        <div style="font-size: 9.5px; color: var(--text-muted); opacity: 0.85;">@sub.TotalSubmissions.ToString("N0") Data</div>
                                                    </div>
                                                </div>
                                                rank++;
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center py-5 text-muted">
                                                <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                                                Belum ada data subkontraktor aktif bulan ini.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }

    <!-- SAP Program Fulfillment Summary Card -->
    @{
        var sapPrograms = ViewBag.SapPrograms as dynamic[] ?? Array.Empty<dynamic>();
        int totalBerTarget = ViewBag.TotalCount ?? 0;
    }
    <div class="report-card premium-card mt-4">
        <div class="report-header premium-header d-flex justify-content-between align-items-center">
            <h5 class="premium-title">
                <i class="bi bi-bar-chart-fill me-2 text-primary" style="font-size: 18px;"></i>Pencapaian per Program SAP
            </h5>
            <span class="badge" style="background: rgba(59,130,246,0.1); color: #3b82f6; border: 1px solid rgba(59,130,246,0.25); font-weight: 700; font-size: 11px; padding: 5px 10px; border-radius: 8px;">
                <i class="bi bi-people-fill me-1"></i>@totalBerTarget Karyawan Ber-Target
            </span>
        </div>
        <div class="report-body">
            <div class="row g-3">
                @foreach (var prog in sapPrograms)
                {
                    int withTarget = (int)prog.WithTarget;
                    int fulfilled  = (int)prog.Fulfilled;
                    int progActual = (int)prog.TotalActual;
                    int progTarget = (int)prog.TotalTarget;
                    double pctFulfilled = withTarget > 0 ? Math.Round((double)fulfilled / withTarget * 100.0, 1) : 0.0;
                    double pctSubmission = progTarget > 0 ? Math.Round((double)progActual / progTarget * 100.0, 1) : 0.0;
                    double barWidth = Math.Min(pctFulfilled, 100.0);
                    string accentColor = (string)prog.Color;
                    string badgeColor = pctFulfilled >= 80 ? "#22c55e" : (pctFulfilled >= 50 ? "#f59e0b" : "#f43f5e");
                    string badgeBg    = pctFulfilled >= 80 ? "rgba(34,197,94,0.1)" : (pctFulfilled >= 50 ? "rgba(245,158,11,0.1)" : "rgba(244,63,94,0.1)");
                    string badgeBorder= pctFulfilled >= 80 ? "rgba(34,197,94,0.25)" : (pctFulfilled >= 50 ? "rgba(245,158,11,0.25)" : "rgba(244,63,94,0.25)");
                    string notFulfilled = $"{withTarget - fulfilled} karyawan belum terpenuhi";

                    <div class="col-lg-4 col-md-6 col-12">
                        <div class="program-card-item" style="border: 1.5px solid rgba(255,255,255,0.05); border-radius: 14px; padding: 18px 20px; background: var(--bg-card); position: relative; overflow: hidden; transition: box-shadow 0.2s;">
                            <!-- background glow icon -->
                            <div style="position: absolute; right: -12px; bottom: -12px; font-size: 80px; color: @accentColor; opacity: 0.04; pointer-events: none;">
                                <i class="bi @prog.Icon"></i>
                            </div>
                            <!-- header row -->
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 34px; height: 34px; border-radius: 10px; background: @accentColor + '18'; border: 1.5px solid @accentColor + '33'; display: flex; align-items: center; justify-content: center; color: @accentColor;">
                                        <i class="bi @prog.Icon" style="font-size: 15px;"></i>
                                    </div>
                                    <span style="font-size: 13px; font-weight: 800; color: var(--text-main);">@prog.Name</span>
                                </div>
                                <span class="badge" style="background: @badgeBg; color: @badgeColor; border: 1px solid @badgeBorder; font-weight: 800; font-size: 12px; padding: 4px 9px; border-radius: 7px;">
                                    @pctFulfilled%
                                </span>
                            </div>

                            <!-- big metric -->
                            <div class="mb-1" style="font-size: 28px; font-weight: 900; color: @accentColor; font-family: 'Outfit', sans-serif; letter-spacing: -1px;">
                                @fulfilled <span style="font-size: 14px; font-weight: 600; color: var(--text-muted);">/ @withTarget karyawan</span>
                            </div>
                            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 14px;">
                                karyawan sudah mengisi (min. 1 submisi MTD)
                            </div>

                            <!-- progress bar: % fulfilled employees -->
                            <div style="height: 7px; border-radius: 4px; background: rgba(255,255,255,0.05); overflow: hidden; margin-bottom: 10px;">
                                <div style="width: @barWidth%; height: 100%; background: @accentColor; border-radius: 4px; transition: width 0.5s ease;"></div>
                            </div>

                            <!-- submission totals -->
                            <div class="d-flex justify-content-between" style="font-size: 11px; border-top: 1px dashed rgba(255,255,255,0.06); padding-top: 10px;">
                                <span class="text-muted">Total Submisi MTD</span>
                                <span style="font-weight: 700; color: var(--text-main);">@progActual / @progTarget &nbsp;<span style="color: @(pctSubmission >= 100 ? "#22c55e" : "#f59e0b"); font-weight: 800;">(@pctSubmission%)</span></span>
                            </div>
                            @if (withTarget - fulfilled > 0)
                            {
                                <div style="font-size: 10px; color: #f43f5e; margin-top: 5px; text-align: right;">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i>@(withTarget - fulfilled) karyawan belum mengisi
                                </div>
                            }
                            else if (withTarget > 0)
                            {
                                <div style="font-size: 10px; color: #22c55e; margin-top: 5px; text-align: right;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Semua karyawan sudah mengisi
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Script Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Ambil warna text & border dari theme agar grafik kontras di light/dark mode
            const bodyColor = getComputedStyle(document.body).color || '#1e293b';
            const labelColor = bodyColor;
            
            // Deteksi jika tema aktif adalah dark mode untuk menentukan kontras kisi/gridline
            const isDarkTheme = bodyColor.includes('255') || bodyColor.includes('f8') || bodyColor.includes('fa') || bodyColor.includes('ff');
            const gridColor = isDarkTheme ? 'rgba(255, 255, 255, 0.12)' : 'rgba(0, 0, 0, 0.12)';

            // Chart 4: Maincon Group Comparison (Grouped Bar Chart)
            const ctxMaincon = document.getElementById('mainconComparisonChart');
            if (ctxMaincon) {
                const ctxMaincon2d = ctxMaincon.getContext('2d');

                // Dynamic gradients for premium visuals
                const createGrad = (cStart, cEnd) => {
                    const gradient = ctxMaincon2d.createLinearGradient(0, 0, 0, 360);
                    gradient.addColorStop(0, cStart);
                    gradient.addColorStop(1, cEnd);
                    return gradient;
                };

                const overallGrad = createGrad('rgba(16, 185, 129, 0.95)', 'rgba(5, 150, 105, 0.6)');
                const hazardGrad = createGrad('rgba(99, 102, 241, 0.95)', 'rgba(79, 70, 229, 0.6)');
                const inspeksiGrad = createGrad('rgba(59, 130, 246, 0.95)', 'rgba(37, 99, 235, 0.6)');
                const safetyTalkGrad = createGrad('rgba(245, 158, 11, 0.95)', 'rgba(217, 119, 6, 0.6)');
                const observasiGrad = createGrad('rgba(236, 72, 153, 0.95)', 'rgba(219, 39, 119, 0.6)');
                const coachingGrad = createGrad('rgba(168, 85, 247, 0.95)', 'rgba(147, 51, 234, 0.6)');

                new Chart(ctxMaincon2d, {
                    type: 'bar',
                    data: {
                        labels: @mainconLabelsJson,
                        datasets: [
                            {
                                label: 'Overall',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mainconComparison!.Select(x => x.OverallComplianceRate))),
                                backgroundColor: overallGrad,
                                hoverBackgroundColor: '#059669',
                                borderRadius: 6,
                                borderWidth: 0,
                                barPercentage: 0.85,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Hazard',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mainconComparison!.Select(x => x.HazardComplianceRate))),
                                backgroundColor: hazardGrad,
                                hoverBackgroundColor: '#4f46e5',
                                borderRadius: 6,
                                borderWidth: 0,
                                barPercentage: 0.85,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Inspeksi',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mainconComparison!.Select(x => x.InspeksiComplianceRate))),
                                backgroundColor: inspeksiGrad,
                                hoverBackgroundColor: '#2563eb',
                                borderRadius: 6,
                                borderWidth: 0,
                                barPercentage: 0.85,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Safety Talk',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mainconComparison!.Select(x => x.SafetyTalkComplianceRate))),
                                backgroundColor: safetyTalkGrad,
                                hoverBackgroundColor: '#d97706',
                                borderRadius: 6,
                                borderWidth: 0,
                                barPercentage: 0.85,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Observasi',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mainconComparison!.Select(x => x.ObservasiComplianceRate))),
                                backgroundColor: observasiGrad,
                                hoverBackgroundColor: '#db2777',
                                borderRadius: 6,
                                borderWidth: 0,
                                barPercentage: 0.85,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Coaching',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mainconComparison!.Select(x => x.CoachingComplianceRate))),
                                backgroundColor: coachingGrad,
                                hoverBackgroundColor: '#9333ea',
                                borderRadius: 6,
                                borderWidth: 0,
                                barPercentage: 0.85,
                                categoryPercentage: 0.6
                            }
                        ]
                    },
                    plugins: [
                        {
                            id: 'barLabels',
                            afterDatasetsDraw(chart, args, options) {
                                const { ctx } = chart;
                                ctx.save();
                                chart.data.datasets.forEach((dataset, i) => {
                                    const meta = chart.getDatasetMeta(i);
                                    meta.data.forEach((bar, index) => {
                                        const val = dataset.data[index];
                                        if (val > 0) {
                                            ctx.fillStyle = labelColor;
                                            ctx.font = 'bold 9px "Outfit", sans-serif';
                                            ctx.textAlign = 'center';
                                            ctx.textBaseline = 'bottom';
                                            ctx.fillText(val + '%', bar.x, bar.y - 4);
                                        }
                                    });
                                });
                                ctx.restore();
                            }
                        }
                    ],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                align: 'end',
                                labels: {
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    padding: 16,
                                    color: labelColor,
                                    font: { size: 11, weight: '700', family: "'Outfit', 'Inter', sans-serif" }
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(15, 23, 42, 0.92)',
                                titleColor: '#fff',
                                titleFont: { size: 12, weight: 'bold', family: "'Outfit', sans-serif" },
                                bodyColor: '#cbd5e1',
                                bodyFont: { size: 11, family: "'Inter', sans-serif" },
                                borderColor: 'rgba(255, 255, 255, 0.1)',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 12,
                                boxPadding: 6,
                                callbacks: {
                                    label: function(context) {
                                        return ' ' + context.dataset.label + ': ' + context.raw + '%';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { 
                                    color: labelColor, 
                                    font: { size: 11, weight: '800', family: "'Outfit', sans-serif" },
                                    padding: 8
                                }
                            },
                            y: {
                                min: 0,
                                suggestedMax: 30,
                                grid: { 
                                    color: gridColor,
                                    borderDash: [5, 5],
                                    drawBorder: false
                                },
                                ticks: { 
                                    color: labelColor, 
                                    font: { size: 11, weight: '700' },
                                    padding: 8,
                                    callback: function(value) { return value + '%'; }
                                }
                            }
                        }
                    }
                });
            }

            // Chart 5: Subcon Leaderboard (Horizontal Bar Chart)
            const ctxSubcon = document.getElementById('subconLeaderboardChart');
            if (ctxSubcon) {
                const ctxSubcon2d = ctxSubcon.getContext('2d');
                
                // Premium horizontal gradient
                const subconGrad = ctxSubcon2d.createLinearGradient(0, 0, ctxSubcon.width || 400, 0);
                subconGrad.addColorStop(0, 'rgba(59, 130, 246, 0.95)');  // Blue
                subconGrad.addColorStop(1, 'rgba(16, 185, 129, 0.7)');   // Emerald
                
                new Chart(ctxSubcon2d, {
                    type: 'bar',
                    data: {
                        labels: @top5LabelsJson,
                        datasets: [{
                            label: 'Kepatuhan',
                            data: @top5ComplianceJson,
                            backgroundColor: subconGrad,
                            hoverBackgroundColor: '#10b981',
                            borderRadius: 6,
                            borderWidth: 0,
                            barPercentage: 0.6,
                            categoryPercentage: 0.8
                        }]
                    },
                    plugins: [
                        {
                            id: 'barLabelsHorizontal',
                            afterDatasetsDraw(chart, args, options) {
                                const { ctx } = chart;
                                ctx.save();
                                chart.data.datasets.forEach((dataset, i) => {
                                    const meta = chart.getDatasetMeta(i);
                                    meta.data.forEach((bar, index) => {
                                        const val = dataset.data[index];
                                        if (val > 0) {
                                            ctx.fillStyle = labelColor;
                                            ctx.font = 'bold 10px "Outfit", sans-serif';
                                            ctx.textAlign = 'left';
                                            ctx.textBaseline = 'middle';
                                            ctx.fillText(val + '%', bar.x + 6, bar.y);
                                        }
                                    });
                                });
                                ctx.restore();
                            }
                        }
                    ],
                    options: {
                        indexAxis: 'y', // Makes the bar chart horizontal!
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(15, 23, 42, 0.92)',
                                titleColor: '#fff',
                                titleFont: { size: 12, weight: 'bold', family: "'Outfit', sans-serif" },
                                bodyColor: '#cbd5e1',
                                bodyFont: { size: 11, family: "'Inter', sans-serif" },
                                borderColor: 'rgba(255, 255, 255, 0.1)',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 12,
                                callbacks: {
                                    label: function(context) {
                                        return ' Kepatuhan: ' + context.raw + '%';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                min: 0,
                                suggestedMax: 100,
                                grid: { 
                                    color: gridColor,
                                    borderDash: [5, 5],
                                    drawBorder: false
                                },
                                ticks: { 
                                    color: labelColor, 
                                    font: { size: 10, weight: '600' },
                                    callback: function(value) { return value + '%'; }
                                }
                            },
                            y: {
                                grid: { display: false },
                                ticks: { 
                                    color: labelColor, 
                                    font: { size: 10, weight: '700', family: "'Outfit', sans-serif" }
                                }
                            }
                        }
                    }
                });
            }

            // Subcon tooltips hover bindings
            @foreach (var m in mainconComparison!)
            {
                <text>
                const trigger_@(m.MainconId) = document.getElementById("subcon-trigger-@(m.MainconId)");
                const tooltip_@(m.MainconId) = document.getElementById("subcon-tooltip-@(m.MainconId)");
                if (trigger_@(m.MainconId) && tooltip_@(m.MainconId)) {
                    const parentNode = trigger_@(m.MainconId).parentElement;
                    parentNode.addEventListener("mouseenter", function() {
                        tooltip_@(m.MainconId).style.display = "block";
                    });
                    parentNode.addEventListener("mouseleave", function() {
                        tooltip_@(m.MainconId).style.display = "none";
                    });
                }

                const untrigger_@(m.MainconId) = document.getElementById("uncompliant-trigger-@(m.MainconId)");
                const untooltip_@(m.MainconId) = document.getElementById("uncompliant-tooltip-@(m.MainconId)");
                if (untrigger_@(m.MainconId) && untooltip_@(m.MainconId)) {
                    const parentNode = untrigger_@(m.MainconId).parentElement;
                    parentNode.addEventListener("mouseenter", function() {
                        untooltip_@(m.MainconId).style.display = "block";
                    });
                    parentNode.addEventListener("mouseleave", function() {
                        untooltip_@(m.MainconId).style.display = "none";
                    });
                }
                </text>
            }
        });
    </script>

</div>
