@model IEnumerable<MBS_SAP.Controllers.ComplianceEmployeeViewModel>
@{
    ViewData["Title"] = "Laporan Kepatuhan SAP";
    var companies = ViewBag.Companies as List<MBS_SAP.Models.PerusahaanView> ?? new List<MBS_SAP.Models.PerusahaanView>();
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    int selectedCompanyId = ViewBag.SelectedCompanyId ?? 0;
    string selectedDeptName = ViewBag.SelectedDepartmentName ?? "";
    
    // Pagination data
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 50;
    int startRow = ((currentPage - 1) * pageSize) + 1;
    int endRow = Math.Min(currentPage * pageSize, totalCount);

    var mainconComparison = (ViewBag.MainconGroupComparison as List<MBS_SAP.Controllers.MainconGroupComparisonViewModel> ?? new List<MBS_SAP.Controllers.MainconGroupComparisonViewModel>())!;
    var mostActiveSubcon = ViewBag.MostActiveSubcon as MBS_SAP.Controllers.MostActiveSubconViewModel;
}

<style>
    .report-card {
        background: var(--bg-card);
        border: 2px solid #1e293b;
        border-radius: 16px;
        box-shadow: 5px 5px 0px #1e293b;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .report-header {
        background: var(--bg-card);
        padding: 16px 20px;
        border-bottom: 2px solid #1e293b;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }
    .report-title {
        color: var(--text-main);
        font-weight: 800;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }
    .report-body {
        padding: 20px;
    }
    .tab-btn {
        border-radius: 8px;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        outline: none;
    }
    .tab-active {
        background: var(--color-primary) !important;
        color: white !important;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
    }
    .tab-inactive {
        background: transparent !important;
        color: var(--text-muted) !important;
    }
    .compliance-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }
    .compliance-table thead th {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 12px 14px;
        border: none;
        text-align: center;
    }
    .compliance-table thead th.align-left {
        text-align: left;
    }
    .compliance-row {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        transition: background 0.15s ease;
    }
    .compliance-row:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .compliance-row td {
        padding: 14px;
        vertical-align: middle;
        font-size: 13px;
        color: var(--text-main);
        border: none;
        text-align: center;
    }
    .compliance-row td.align-left {
        text-align: left;
    }
    .compliance-row td:first-child { border-radius: 12px 0 0 12px; }
    .compliance-row td:last-child { border-radius: 0 12px 12px 0; }
    
    .compliance-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 8px;
        display: inline-block;
    }
    .badge-success-sap {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }
    .badge-danger-sap {
        background: rgba(244, 63, 94, 0.15);
        color: #f43f5e;
        border: 1px solid rgba(244, 63, 94, 0.3);
    }
    .badge-neutral-sap {
        background: rgba(100, 116, 139, 0.15);
        color: #94a3b8;
        border: 1px solid rgba(100, 116, 139, 0.3);
    }
    
    .prog-cell {
        font-weight: 700;
        font-size: 12px;
    }
    .prog-ok {
        color: #22c55e;
    }
    .prog-warn {
        color: #f43f5e;
    }
    .prog-neutral {
        color: #94a3b8;
    }
    
    .progress-achievement {
        height: 6px;
        border-radius: 3px;
        background: rgba(255,255,255,0.1);
        overflow: hidden;
        width: 80px;
        margin: 4px auto 0;
    }
    .subcon-tooltip {
        display: none;
        position: absolute;
        bottom: 25px;
        left: 0;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(10px);
        border: 1.5px solid rgba(255, 255, 255, 0.1);
        padding: 10px 14px;
        border-radius: 12px;
        z-index: 100;
        width: 250px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }
</style>

<div class="animate-fade-in pb-5">

    <!-- Header Banner -->
    <div class="position-relative mb-4" style="margin: -20px -20px 20px -20px;">
        <div style="background: linear-gradient(135deg, #0284c7, #0369a1); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; padding: 32px 20px 24px; text-align: center; position: relative; overflow: hidden;">
            <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: -30px; left: -10px; width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <i class="bi bi-bar-chart-line-fill text-white mb-2 d-block" style="font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
            <h4 style="font-weight: 800; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.2); margin-bottom: 4px;">PENCAPAIAN KINERJA SAP</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 12px; margin: 0; font-weight: 500;">Pantau kepatuhan target mingguan dan statistik bahaya perusahaan secara real-time.</p>
        </div>
    </div>

    <!-- Tabs Toggle (Redirects back to main page or keeps active) -->
    <div class="d-flex justify-content-center mb-4">
        <div style="background: var(--bg-card); border: 1.5px solid var(--border-color); padding: 4px; border-radius: 12px; display: inline-flex; gap: 4px; flex-wrap: wrap; justify-content: center;">
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabMy" onclick="window.location.href='/Performance?tab=my'">
                <i class="bi bi-person-badge-fill me-1"></i> Pencapaian Saya
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabCompany" onclick="window.location.href='/Performance?tab=company'">
                <i class="bi bi-building-fill me-1"></i> Kinerja Perusahaan
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabHitSafe" onclick="window.location.href='/Performance?tab=hitsafe'">
                <i class="bi bi-geo-alt-fill me-1"></i> Safe Map
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabHierarchy" onclick="window.location.href='/Performance?tab=hierarchy'">
                <i class="bi bi-diagram-3-fill me-1"></i> Hirarki Perusahaan
            </button>
            <button class="tab-btn px-4 py-2 tab-active" id="tabCompliance" onclick="void(0)">
                <i class="bi bi-file-earmark-text-fill me-1"></i> Laporan Kepatuhan
            </button>
        </div>
    </div>

    <!-- Maincon Group Comparison & Spotlight Row -->
    @if (mainconComparison != null && mainconComparison.Any())
    {
        <div class="row g-4 mb-4">
            <!-- Left Card: Maincon Group Comparison -->
            <div class="col-12">
                <div class="report-card h-100 mb-0" style="border-color: #0284c7; box-shadow: 5px 5px 0px #0284c7;">
                    <div class="report-header d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #0284c7; background: rgba(2, 132, 199, 0.05);">
                        <h5 class="report-title text-white font-outfit">
                            <i class="bi bi-bar-chart-line-fill me-2" style="color: #38bdf8;"></i>Perbandingan Kepatuhan Maincon Utama (MTD Group)
                        </h5>
                        <span class="badge text-white" style="font-size: 11px; padding: 6px 12px; border-radius: 8px; background-color: #0284c7;">
                            Maincon + Subkontraktor
                        </span>
                    </div>
                    <div class="report-body p-4">
                        <div class="row g-4">
                            <!-- Left Column: The Grouped Bar Chart -->
                            <div class="col-lg-7 col-md-12">
                                <div style="height: 380px; position: relative;">
                                    <canvas id="mainconComparisonChart"></canvas>
                                </div>
                            </div>

                            <!-- Right Column: Comparative Grid Details -->
                            <div class="col-lg-5 col-md-12">
                                <div class="row g-3">
                                    @foreach (var item in mainconComparison)
                                    {
                                        <div class="col-md-12">
                                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.02); border: 1.5px solid var(--border-color); position: relative;">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <div class="fw-extrabold text-white" style="font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                        <i class="bi bi-building-fill text-info me-1"></i> @item.MainconName
                                                    </div>
                                                    <span class="badge" style="background-color: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3); font-weight: 800; font-size: 12px;">
                                                        Kepatuhan: @item.OverallComplianceRate%
                                                    </span>
                                                </div>
                                                
                                                <!-- Employee count and subcons details -->
                                                <div class="d-flex flex-wrap gap-3 mb-3" style="font-size: 11.5px;">
                                                    <div>
                                                        <i class="bi bi-people-fill text-muted me-1"></i>
                                                        <span class="text-white fw-bold">@item.EmployeesWithTargetCount.ToString("N0")</span> / @item.TotalEmployees.ToString("N0") Karyawan
                                                    </div>
                                                    <div class="position-relative" style="cursor: pointer;">
                                                        <i class="bi bi-diagram-3-fill text-muted me-1"></i>
                                                        <span class="text-white fw-bold text-decoration-underline" id="subcon-trigger-@item.MainconId">@item.ChildCompanyNames.Count</span> Anak
                                                        <div class="subcon-tooltip" id="subcon-tooltip-@item.MainconId">
                                                            <div class="fw-bold text-info mb-1" style="font-size:10px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:4px;">List Subkontraktor:</div>
                                                            @if (item.ChildCompanyNames.Any())
                                                            {
                                                                <ul class="list-unstyled mb-0" style="font-size:10.5px; max-height:120px; overflow-y:auto; line-height:1.4;">
                                                                    @foreach (var sub in item.ChildCompanyNames)
                                                                    {
                                                                        <li class="text-white-50 py-0.5"><i class="bi bi-chevron-right text-info" style="font-size: 8px;"></i> @sub</li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted" style="font-size:10.5px;">Tidak ada anak perusahaan</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="position-relative" style="cursor: pointer;">
                                                        <i class="bi bi-x-circle-fill text-danger me-1"></i>
                                                        <span class="text-danger fw-bold text-decoration-underline" id="uncompliant-trigger-@item.MainconId">@item.UncompliantChildCompanyNames.Count</span> Inaktif
                                                        <div class="subcon-tooltip" id="uncompliant-tooltip-@item.MainconId" style="border-color: #ef4444;">
                                                            <div class="fw-bold text-danger mb-1" style="font-size:10px; border-bottom:1px solid rgba(239, 68, 68, 0.2); padding-bottom:4px;">Subkontraktor Tanpa Pergerakan:</div>
                                                            @if (item.UncompliantChildCompanyNames.Any())
                                                            {
                                                                <ul class="list-unstyled mb-0" style="font-size:10.5px; max-height:120px; overflow-y:auto; line-height:1.4;">
                                                                    @foreach (var sub in item.UncompliantChildCompanyNames)
                                                                    {
                                                                        <li class="text-white-50 py-0.5"><i class="bi bi-x-circle text-danger" style="font-size: 8px;"></i> @sub</li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-success" style="font-size:10.5px;"><i class="bi bi-check-circle-fill me-1"></i> Semua subkontraktor aktif</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- SAP Breakdown metrics -->
                                                <div class="d-flex justify-content-between align-items-center gap-1 mt-2 text-center" style="background: rgba(255,255,255,0.01); padding: 8px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.03);">
                                                    <div style="flex: 1;">
                                                        <div class="text-muted" style="font-size: 8.5px; font-weight: 700; text-transform: uppercase;">Hazard</div>
                                                        <div class="fw-extrabold mt-1 text-white" style="font-size: 11px;">@item.HazardComplianceRate%</div>
                                                        <div class="text-muted" style="font-size: 8px; opacity:0.6;">@item.ActualHazard/@item.TargetHazard</div>
                                                    </div>
                                                    <div style="width: 1px; height: 25px; background: rgba(255,255,255,0.08);"></div>
                                                    <div style="flex: 1;">
                                                        <div class="text-muted" style="font-size: 8.5px; font-weight: 700; text-transform: uppercase;">Inspeksi</div>
                                                        <div class="fw-extrabold mt-1 text-white" style="font-size: 11px;">@item.InspeksiComplianceRate%</div>
                                                        <div class="text-muted" style="font-size: 8px; opacity:0.6;">@item.ActualInspeksi/@item.TargetInspeksi</div>
                                                    </div>
                                                    <div style="width: 1px; height: 25px; background: rgba(255,255,255,0.08);"></div>
                                                    <div style="flex: 1;">
                                                        <div class="text-muted" style="font-size: 8.5px; font-weight: 700; text-transform: uppercase;">Safety Talk</div>
                                                        <div class="fw-extrabold mt-1 text-white" style="font-size: 11px;">@item.SafetyTalkComplianceRate%</div>
                                                        <div class="text-muted" style="font-size: 8px; opacity:0.6;">@item.ActualSafetyTalk/@item.TargetSafetyTalk</div>
                                                    </div>
                                                    <div style="width: 1px; height: 25px; background: rgba(255,255,255,0.08);"></div>
                                                    <div style="flex: 1;">
                                                        <div class="text-muted" style="font-size: 8.5px; font-weight: 700; text-transform: uppercase;">Observasi</div>
                                                        <div class="fw-extrabold mt-1 text-white" style="font-size: 11px;">@item.ObservasiComplianceRate%</div>
                                                        <div class="text-muted" style="font-size: 8px; opacity:0.6;">@item.ActualObservasi/@item.TargetObservasi</div>
                                                    </div>
                                                    <div style="width: 1px; height: 25px; background: rgba(255,255,255,0.08);"></div>
                                                    <div style="flex: 1;">
                                                        <div class="text-muted" style="font-size: 8.5px; font-weight: 700; text-transform: uppercase;">Coaching</div>
                                                        <div class="fw-extrabold mt-1 text-white" style="font-size: 11px;">@item.CoachingComplianceRate%</div>
                                                        <div class="text-muted" style="font-size: 8px; opacity:0.6;">@item.ActualCoaching/@item.TargetCoaching</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }

    <!-- Script Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Ambil warna text & border dari theme agar grafik kontras di light/dark mode
            const rootStyle = getComputedStyle(document.documentElement);
            const labelColor = rootStyle.getPropertyValue('--text-main').trim() || '#334155';
            const mutedColor = rootStyle.getPropertyValue('--text-muted').trim() || '#64748b';
            const gridColor = rootStyle.getPropertyValue('--border-color').trim() || 'rgba(0, 0, 0, 0.08)';

            // Chart 4: Maincon Group Comparison (Grouped Bar Chart)
            const ctxMaincon = document.getElementById('mainconComparisonChart');
            if (ctxMaincon) {
                const ctxMaincon2d = ctxMaincon.getContext('2d');
                new Chart(ctxMaincon2d, {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", mainconComparison!.Select(x => $"['{string.Join("','", x.MainconName.Replace("PT ", "").Split(' '))}'"])))],
                        datasets: [
                            {
                                label: 'Overall',
                                data: [@string.Join(",", mainconComparison!.Select(x => x.OverallComplianceRate))],
                                backgroundColor: '#10b981',
                                borderColor: '#10b981',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Hazard',
                                data: [@string.Join(",", mainconComparison!.Select(x => x.HazardComplianceRate))],
                                backgroundColor: '#6366f1',
                                borderColor: '#6366f1',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Inspeksi',
                                data: [@string.Join(",", mainconComparison!.Select(x => x.InspeksiComplianceRate))],
                                backgroundColor: '#3b82f6',
                                borderColor: '#3b82f6',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Safety Talk',
                                data: [@string.Join(",", mainconComparison!.Select(x => x.SafetyTalkComplianceRate))],
                                backgroundColor: '#eab308',
                                borderColor: '#eab308',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Observasi',
                                data: [@string.Join(",", mainconComparison!.Select(x => x.ObservasiComplianceRate))],
                                backgroundColor: '#ec4899',
                                borderColor: '#ec4899',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Coaching',
                                data: [@string.Join(",", mainconComparison!.Select(x => x.CoachingComplianceRate))],
                                backgroundColor: '#a855f7',
                                borderColor: '#a855f7',
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                labels: {
                                    color: labelColor,
                                    font: { size: 9, weight: 'bold' }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + context.raw + '%';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: labelColor, font: { size: 9, weight: 'bold' } }
                            },
                            y: {
                                min: 0,
                                max: 100,
                                grid: { color: gridColor },
                                ticks: { 
                                    color: labelColor, 
                                    font: { size: 10 },
                                    callback: function(value) { return value + '%'; }
                                }
                            }
                        }
                    }
                });
            }

            // Subcon tooltips hover bindings
            @foreach (var m in mainconComparison!)
            {
                <text>
                const trigger_@(m.MainconId) = document.getElementById("subcon-trigger-@(m.MainconId)");
                const tooltip_@(m.MainconId) = document.getElementById("subcon-tooltip-@(m.MainconId)");
                if (trigger_@(m.MainconId) && tooltip_@(m.MainconId)) {
                    const parentNode = trigger_@(m.MainconId).parentElement;
                    parentNode.addEventListener("mouseenter", function() {
                        tooltip_@(m.MainconId).style.display = "block";
                    });
                    parentNode.addEventListener("mouseleave", function() {
                        tooltip_@(m.MainconId).style.display = "none";
                    });
                }

                const untrigger_@(m.MainconId) = document.getElementById("uncompliant-trigger-@(m.MainconId)");
                const untooltip_@(m.MainconId) = document.getElementById("uncompliant-tooltip-@(m.MainconId)");
                if (untrigger_@(m.MainconId) && untooltip_@(m.MainconId)) {
                    const parentNode = untrigger_@(m.MainconId).parentElement;
                    parentNode.addEventListener("mouseenter", function() {
                        untooltip_@(m.MainconId).style.display = "block";
                    });
                    parentNode.addEventListener("mouseleave", function() {
                        untooltip_@(m.MainconId).style.display = "none";
                    });
                }
                </text>
            }
        });
    </script>

</div>
