@model List<MBS_SAP.Controllers.MainconPerformanceReportViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Performa Perusahaan Utama";
}

<style>
    .report-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sap-tabs-container {
        display: flex;
        gap: 8px;
        background: rgba(15, 23, 42, 0.4);
        padding: 6px;
        border-radius: 12px;
        border: 1.5px solid var(--border-color);
        overflow-x: auto;
    }
    .sap-tab-item {
        display: flex;
        align-items: center;
        padding: 10px 20px;
        color: #94a3b8;
        font-weight: 700;
        font-size: 13px;
        border-radius: 8px;
        transition: all 0.25s ease;
        text-decoration: none;
        white-space: nowrap;
    }
    .sap-tab-item:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.03);
    }
    .sap-tab-item.active {
        color: #fff;
        background: var(--color-indigo);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }
    .maincon-header-card {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        border-left: 5px solid;
    }
    .maincon-tbl th {
        font-size: 10.5px;
        font-weight: 800;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--border-color) !important;
        padding: 12px 8px !important;
    }
    .maincon-tbl td {
        font-size: 12px;
        color: #e2e8f0;
        vertical-align: middle;
        padding: 12px 8px !important;
        border-bottom: 1px solid rgba(255,255,255,0.03) !important;
    }
    .progress-bar-sap {
        height: 6px;
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        overflow: hidden;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-extrabold text-white mb-1 font-outfit" style="font-size: 24px; letter-spacing: -0.5px;">
                Performa Perusahaan Utama (MTD Group)
            </h4>
            <div class="text-muted" style="font-size: 12.5px;">
                Analisis detil performa SAP, kepatuhan, dan total submissions masing-masing Maincon beserta anak perusahaannya.
            </div>
        </div>
    </div>

    <!-- Tabs Toggle (Redirects back to main page or keeps active) -->
    <div class="d-flex justify-content-center mb-4">
        <div style="background: var(--bg-card); border: 1.5px solid var(--border-color); padding: 4px; border-radius: 12px; display: inline-flex; gap: 4px; flex-wrap: wrap; justify-content: center;">
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabMy" onclick="window.location.href='/Performance?tab=my'">
                <i class="bi bi-person-badge-fill me-1"></i> Pencapaian Saya
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabCompany" onclick="window.location.href='/Performance?tab=company'">
                <i class="bi bi-building-fill me-1"></i> Kinerja Perusahaan
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabHitSafe" onclick="window.location.href='/Performance?tab=hitsafe'">
                <i class="bi bi-geo-alt-fill me-1"></i> Safe Map
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabHierarchy" onclick="window.location.href='/Performance?tab=hierarchy'">
                <i class="bi bi-diagram-3-fill me-1"></i> Hirarki Perusahaan
            </button>
            <button class="tab-btn px-4 py-2 tab-inactive" id="tabCompliance" onclick="window.location.href='/Performance/Compliance'">
                <i class="bi bi-file-earmark-text-fill me-1"></i> Laporan Kepatuhan
            </button>
            <button class="tab-btn px-4 py-2 tab-active" id="tabMaincon" onclick="void(0)">
                <i class="bi bi-building-fill-gear me-1"></i> Performa Maincon
            </button>
        </div>
    </div>

    <!-- Maincon Performance Blocks -->
    @if (Model != null && Model.Any())
    {
        int index = 0;
        string[] colors = { "#0284c7", "#10b981", "#a855f7" }; // Blue, Green, Purple
        string[] glowColors = { "rgba(2, 132, 199, 0.15)", "rgba(16, 185, 129, 0.15)", "rgba(168, 85, 247, 0.15)" };

        @foreach (var maincon in Model)
        {
            var accentColor = colors[index % colors.Length];
            var glowBg = glowColors[index % glowColors.Length];
            index++;

            <div class="report-card mb-5" style="border-color: @accentColor; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
                <!-- Maincon Section Header -->
                <div class="p-4 rounded-top maincon-header-card d-flex flex-wrap justify-content-between align-items-center gap-3" style="border-left-color: @accentColor;">
                    <div>
                        <div class="text-uppercase fw-extrabold text-white mb-1" style="font-size: 16px; letter-spacing: 0.5px;">
                            <i class="bi bi-building me-2" style="color: @accentColor;"></i>@maincon.MainconName
                        </div>
                        <div class="text-muted d-flex gap-3 align-items-center" style="font-size: 12px;">
                            <span><i class="bi bi-people-fill me-1"></i> <strong>@maincon.EmployeesWithTarget.ToString("N0") / @maincon.TotalEmployees.ToString("N0")</strong> Karyawan Ber-Target</span>
                            <span>|</span>
                            <span><i class="bi bi-diagram-3-fill me-1"></i> <strong>@(maincon.SubconPerformances.Count - 1)</strong> Subkontraktor</span>
                            <span>|</span>
                            <span><i class="bi bi-file-earmark-check-fill me-1"></i> <strong>@maincon.TotalSubmissions.ToString("N0")</strong> Total Input</span>
                        </div>
                    </div>
                    
                    <!-- Compliance Badge Big -->
                    <div class="px-4 py-2 rounded text-center" style="background: @glowBg; border: 1.5px solid @accentColor;">
                        <div class="text-muted" style="font-size: 9px; font-weight: 800; text-transform: uppercase;">Overall Compliance</div>
                        <h4 class="fw-extrabold mb-0" style="color: @accentColor; font-size: 22px;">@maincon.OverallComplianceRate%</h4>
                    </div>
                </div>

                <div class="p-4">
                    <!-- SAP Program Breakdown Progress bars -->
                    <h6 class="text-white-50 fw-extrabold mb-3" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.5px;">Pencapaian Program SAP Group MTD</h6>
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-6 col-md-2.4" style="flex: 1; min-width: 120px;">
                            <div class="p-3 rounded" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border-color);">
                                <div class="text-muted" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">Hazard Report</div>
                                <h4 class="fw-extrabold text-white my-1" style="font-size: 16px;">@maincon.HazardRate%</h4>
                                <div class="progress-bar-sap"><div class="progress-bar bg-info" style="width: @maincon.HazardRate%; height:100%;"></div></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-2.4" style="flex: 1; min-width: 120px;">
                            <div class="p-3 rounded" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border-color);">
                                <div class="text-muted" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">Inspeksi</div>
                                <h4 class="fw-extrabold text-white my-1" style="font-size: 16px;">@maincon.InspeksiRate%</h4>
                                <div class="progress-bar-sap"><div class="progress-bar bg-primary" style="width: @maincon.InspeksiRate%; height:100%;"></div></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-2.4" style="flex: 1; min-width: 120px;">
                            <div class="p-3 rounded" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border-color);">
                                <div class="text-muted" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">Safety Talk</div>
                                <h4 class="fw-extrabold text-white my-1" style="font-size: 16px;">@maincon.SafetyTalkRate%</h4>
                                <div class="progress-bar-sap"><div class="progress-bar bg-warning" style="width: @maincon.SafetyTalkRate%; height:100%;"></div></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-2.4" style="flex: 1; min-width: 120px;">
                            <div class="p-3 rounded" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border-color);">
                                <div class="text-muted" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">Observasi</div>
                                <h4 class="fw-extrabold text-white my-1" style="font-size: 16px;">@maincon.ObservasiRate%</h4>
                                <div class="progress-bar-sap"><div class="progress-bar bg-danger" style="width: @maincon.ObservasiRate%; height:100%;"></div></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-2.4" style="flex: 1; min-width: 120px;">
                            <div class="p-3 rounded" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border-color);">
                                <div class="text-muted" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">Coaching</div>
                                <h4 class="fw-extrabold text-white my-1" style="font-size: 16px;">@maincon.CoachingRate%</h4>
                                <div class="progress-bar-sap"><div class="progress-bar bg-success" style="width: @maincon.CoachingRate%; height:100%;"></div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Subcon List Table -->
                    <h6 class="text-white-50 fw-extrabold mb-3" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.5px;">Rincian Kepatuhan Perusahaan Anggota</h6>
                    <div class="table-responsive">
                        <table class="table maincon-tbl mb-0" style="background: rgba(15,23,42,0.15);">
                            <thead>
                                <tr>
                                    <th style="width: 30%;">Perusahaan</th>
                                    <th style="width: 12%;">Tipe</th>
                                    <th style="width: 18%; text-align: center;">Karyawan Ber-Target</th>
                                    <th style="width: 15%; text-align: center;">Total Submissions</th>
                                    <th style="width: 15%; text-align: center;">Kepatuhan MTD</th>
                                    <th style="width: 10%; text-align: center;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in maincon.SubconPerformances)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-white">@sub.PerusahaanName</span>
                                        </td>
                                        <td>
                                            @if (sub.IsMaincon)
                                            {
                                                <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); font-weight: 700;">MAINCON</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148,163,184,0.3); font-weight: 700;">SUBCON</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="fw-bold text-white">@sub.EmployeesWithTarget</span> / @sub.TotalEmployees
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="fw-bold text-info">@sub.TotalSubmissions.ToString("N0")</span>
                                        </td>
                                        <td style="text-align: center;">
                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                <div class="progress-bar-sap flex-grow-1" style="max-width: 60px; height: 5px;">
                                                    <div class="progress-bar bg-success" style="width: @sub.OverallComplianceRate%; height: 100%;"></div>
                                                </div>
                                                <span class="fw-bold text-success" style="min-width: 40px; text-align: right;">@sub.OverallComplianceRate%</span>
                                            </div>
                                        </td>
                                        <td style="text-align: center;">
                                            @if (sub.OverallComplianceRate >= 100)
                                            {
                                                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-weight: 700;">100% Compliant</span>
                                            }
                                            else if (sub.TotalSubmissions == 0)
                                            {
                                                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #f87171; font-weight: 700;">No Activity</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; font-weight: 700;">Active</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="report-card p-5 text-center text-muted">
            <i class="bi bi-exclamation-circle" style="font-size: 40px;"></i>
            <h5 class="mt-3 text-white">Tidak Ada Data Performa Maincon</h5>
            <p class="mb-0">Pastikan data perusahaan utama terdaftar aktif di database.</p>
        </div>
    }
</div>
