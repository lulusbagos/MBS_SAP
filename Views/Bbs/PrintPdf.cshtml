@model MBS_SAP.Models.BbsObservation
@{
    Layout = null;
    var obs = Model;
    var behaviors = new List<dynamic>();
    if (!string.IsNullOrEmpty(obs.SelectedBehaviorsJson))
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(obs.SelectedBehaviorsJson);
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                var text = el.TryGetProperty("text", out var tProp) ? tProp.GetString() : "";
                var status = el.TryGetProperty("status", out var sProp) ? sProp.GetString() : "Aman";
                behaviors.Add(new { Text = text, Status = status });
            }
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Laporan Observasi BBS - @obs.ObservationNo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            color: #0f172a;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .pdf-container {
            max-width: 820px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 32px 36px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        }

        .no-print-bar {
            max-width: 820px;
            margin: 0 auto 16px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .report-header {
            border-bottom: 2.5px solid #0284c7;
            padding-bottom: 14px;
            margin-bottom: 20px;
        }

        .report-title {
            font-size: 18px;
            font-weight: 800;
            color: #0369a1;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .section-heading {
            font-size: 12.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #0369a1;
            background: #f0f9ff;
            padding: 6px 10px;
            border-left: 4px solid #0284c7;
            margin-top: 16px;
            margin-bottom: 10px;
            border-radius: 0 4px 4px 0;
        }

        .report-table {
            width: 100%;
            margin-bottom: 12px;
            font-size: 12px;
            border-collapse: collapse;
        }

        .report-table th, .report-table td {
            padding: 6px 10px;
            border: 1px solid #e2e8f0;
            vertical-align: top;
        }

        .report-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
            width: 25%;
        }

        .badge-safe {
            background-color: #dcfce7;
            color: #15803d;
            border: 1px solid #86efac;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 99px;
            font-size: 11px;
            display: inline-block;
        }

        .badge-atrisk {
            background-color: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 99px;
            font-size: 11px;
            display: inline-block;
        }

        .signature-box {
            text-align: center;
            padding-top: 50px;
            border-top: 1px solid #94a3b8;
            font-size: 11px;
            margin-top: 40px;
        }

        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
            }
            .no-print-bar {
                display: none !important;
            }
            .pdf-container {
                box-shadow: none !important;
                border: none !important;
                max-width: 100% !important;
                padding: 0 !important;
            }
            @@page {
                size: A4 portrait;
                margin: 12mm 15mm;
            }
        }
    </style>
</head>
<body>

    <!-- Bar Aksi (Hanya tampil di layar, tersembunyi saat dicetak) -->
    <div class="no-print-bar">
        <a href="/Bbs/Index" class="btn btn-outline-secondary btn-sm" style="border-radius: 8px;">
            <i class="bi bi-arrow-left me-1"></i> Kembali ke Form BBS
        </a>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm d-none" id="btnShareWeb" onclick="shareViaNavigator()" style="border-radius: 8px;">
                <i class="bi bi-share-fill me-1"></i> Bagikan
            </button>
            <button type="button" class="btn btn-primary btn-sm fw-bold" onclick="window.print()" style="border-radius: 8px; background-color: #0284c7; border-color: #0284c7;">
                <i class="bi bi-printer-fill me-1"></i> Cetak / Simpan PDF
            </button>
        </div>
    </div>

    <!-- Lembar Dokumen Resmi PDF -->
    <div class="pdf-container">
        <!-- Kop Surat -->
        <div class="report-header d-flex justify-content-between align-items-center">
            <div>
                <div style="font-size: 11px; font-weight: 800; color: #64748b; letter-spacing: 1px;">PT INDEXIM COALINDO</div>
                <h1 class="report-title">Laporan Observasi Perilaku (BBS)</h1>
                <div style="font-size: 11px; color: #475569; margin-top: 2px;">Safety Accountability Program &bull; Behavior Based Safety</div>
            </div>
            <div class="text-end">
                <div style="font-size: 11px; color: #64748b;">No. Dokumen:</div>
                <div style="font-size: 14px; font-weight: 800; color: #0284c7; letter-spacing: 0.5px;">@obs.ObservationNo</div>
                <div style="font-size: 10.5px; color: #64748b;">Tgl Input: @obs.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <!-- 1. DATA PENGAMAT & PEKERJA -->
        <div class="section-heading">1. Informasi Pelapor &amp; Pekerja yang Diamati</div>
        <table class="report-table">
            <tr>
                <th>Pengamat (Observer)</th>
                <td><strong>@obs.ObserverNama</strong> (NIK: @obs.ObserverNik)</td>
                <th>Pekerja Diamati</th>
                <td><strong>@(string.IsNullOrEmpty(obs.ObservedNama) ? "-" : obs.ObservedNama)</strong> @(!string.IsNullOrEmpty(obs.ObservedNik) ? $"(NIK: {obs.ObservedNik})" : "")</td>
            </tr>
            <tr>
                <th>Perusahaan Pengamat</th>
                <td>@(string.IsNullOrEmpty(obs.ObserverPerusahaan) ? "-" : obs.ObserverPerusahaan)</td>
                <th>Perusahaan Pekerja</th>
                <td>@(string.IsNullOrEmpty(obs.ObservedPerusahaan) ? "-" : obs.ObservedPerusahaan)</td>
            </tr>
            <tr>
                <th>Departemen</th>
                <td>@(string.IsNullOrEmpty(obs.ObserverDept) ? "-" : obs.ObserverDept)</td>
                <th>Jabatan Pekerja</th>
                <td>@(string.IsNullOrEmpty(obs.ObservedJabatan) ? "-" : obs.ObservedJabatan)</td>
            </tr>
        </table>

        <!-- 2. WAKTU & LOKASI OBSERVASI -->
        <div class="section-heading">2. Waktu &amp; Lokasi Observasi</div>
        <table class="report-table">
            <tr>
                <th>Tanggal Observasi</th>
                <td>@obs.Tanggal.ToString("dd MMMM yyyy")</td>
                <th>Waktu Kejadian</th>
                <td>@obs.Waktu WITA</td>
            </tr>
            <tr>
                <th>Area Utama</th>
                <td><strong>@obs.Area</strong></td>
                <th>Detail / Benchmark</th>
                <td>@(string.IsNullOrEmpty(obs.DetilLokasi) ? "-" : obs.DetilLokasi)</td>
            </tr>
            <tr>
                <th>Lokasi Spesifik / GPS</th>
                <td colspan="3">@obs.Site</td>
            </tr>
            <tr>
                <th>Kondisi Lingkungan</th>
                <td>Jalan: @(obs.KondisiJalan ?? "Normal / Kering")</td>
                <th>Kondisi Traffic</th>
                <td>@(obs.KondisiKerja ?? "Lancar")</td>
            </tr>
        </table>

        <!-- 3. HASIL OBSERVASI PERILAKU -->
        <div class="section-heading">3. Klasifikasi &amp; Butir Perilaku yang Diamati</div>
        <table class="report-table">
            <tr>
                <th>Tipe Observasi</th>
                <td><strong>@obs.ObservationType</strong></td>
                <th>Kategori BBS</th>
                <td><strong>@obs.CategoryName</strong> @(!string.IsNullOrEmpty(obs.TopicName) ? $"- Sub: {obs.TopicName}" : "")</td>
            </tr>
            <tr>
                <th>Klasifikasi Temuan</th>
                <td>
                    @if (obs.Klasifikasi == "Aman")
                    {
                        <span class="badge-safe"><i class="bi bi-hand-thumbs-up-fill me-1"></i>PERILAKU AMAN (SAFE)</span>
                    }
                    else
                    {
                        <span class="badge-atrisk"><i class="bi bi-hand-thumbs-down-fill me-1"></i>PERILAKU BERISIKO (AT-RISK)</span>
                    }
                </td>
                <th>Tingkat Risiko Konsekuensi</th>
                <td>
                    <strong>@(obs.TingkatRisiko ?? "Sedang")</strong>
                </td>
            </tr>
        </table>

        <!-- Butir Perilaku Checklist -->
        @if (behaviors.Count > 0)
        {
            <div style="font-size: 11px; font-weight: 700; color: #475569; margin-bottom: 4px;">Daftar Butir Perilaku yang Dicek:</div>
            <table class="report-table">
                <thead>
                    <tr>
                        <th style="width: 5%;">No</th>
                        <th style="width: 75%;">Butir Perilaku</th>
                        <th style="width: 20%; text-align: center;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < behaviors.Count; i++)
                    {
                        var b = behaviors[i];
                        <tr>
                            <td class="text-center">@(i + 1)</td>
                            <td>@b.Text</td>
                            <td class="text-center">
                                @if (b.Status == "Aman")
                                {
                                    <span class="badge-safe">Aman</span>
                                }
                                else
                                {
                                    <span class="badge-atrisk">Berisiko</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (!string.IsNullOrEmpty(obs.CustomBehavior))
        {
            <div style="font-size: 11.5px; margin-bottom: 10px;">
                <strong>Perilaku Spesifik Tambahan:</strong> @obs.CustomBehavior
            </div>
        }

        @if (!string.IsNullOrEmpty(obs.FaktorPemicu))
        {
            <div style="font-size: 11.5px; margin-bottom: 10px;">
                <strong>Faktor Pemicu (Triggers):</strong> @obs.FaktorPemicu
            </div>
        }

        @if (!string.IsNullOrEmpty(obs.Deskripsi))
        {
            <div style="font-size: 11.5px; margin-bottom: 10px;">
                <strong>Deskripsi / Situasi Lapangan:</strong><br />
                <span style="color: #334155;">@obs.Deskripsi</span>
            </div>
        }

        <!-- 4. TINDAKAN & INTERVENSI COACHING -->
        <div class="section-heading">4. Tindakan Langsung &amp; Intervensi Coaching</div>
        <table class="report-table">
            <tr>
                <th>Respons Pekerja</th>
                <td><strong>@(obs.ResponsPekerja ?? "Positif")</strong></td>
                <th>Tindakan Dilakukan</th>
                <td>@(string.IsNullOrEmpty(obs.TindakanDilakukan) ? "-" : obs.TindakanDilakukan)</td>
            </tr>
            @if (!string.IsNullOrEmpty(obs.CatatanCoaching))
            {
                <tr>
                    <th>Catatan Coaching / Komitmen</th>
                    <td colspan="3">@obs.CatatanCoaching</td>
                </tr>
            }
        </table>

        <!-- 5. FOTO BUKTI DOKUMENTASI -->
        @if (!string.IsNullOrEmpty(obs.FotoUrl))
        {
            <div class="section-heading">5. Dokumentasi Foto Lapangan</div>
            <div class="text-center my-3">
                <img src="@obs.FotoUrl" alt="Foto Observasi BBS" style="max-height: 240px; border-radius: 8px; border: 1px solid #cbd5e1; object-fit: contain;" />
            </div>
        }

        <!-- Lembar Verifikasi Tanda Tangan -->
        <div class="row mt-4 pt-3">
            <div class="col-4">
                <div class="signature-box">
                    <strong>@obs.ObserverNama</strong><br />
                    <span>Pengamat (Observer)</span>
                </div>
            </div>
            <div class="col-4">
                <div class="signature-box">
                    <strong>@(string.IsNullOrEmpty(obs.ObservedNama) ? "......................." : obs.ObservedNama)</strong><br />
                    <span>Pekerja yang Diamati</span>
                </div>
            </div>
            <div class="col-4">
                <div class="signature-box">
                    <strong>.......................................</strong><br />
                    <span>Pengawas / Safety Officer</span>
                </div>
            </div>
        </div>

        <div class="text-center text-muted mt-4" style="font-size: 9.5px; border-top: 1px dashed #e2e8f0; padding-top: 8px;">
            Dokumen ini dicetak otomatis dari Sistem INDEXIM SAP (Safety Accountability Program) &bull; BBS Module.
        </div>
    </div>

    <script>
        if (navigator.share) {
            document.getElementById('btnShareWeb').classList.remove('d-none');
        }

        function shareViaNavigator() {
            if (navigator.share) {
                navigator.share({
                    title: 'Laporan Observasi BBS - @obs.ObservationNo',
                    text: 'Laporan Observasi Perilaku BBS No. @obs.ObservationNo di area @obs.Area (@obs.Tanggal.ToString("dd MMM yyyy")).',
                    url: window.location.href
                }).catch(err => console.log('Batal share:', err));
            }
        }
    </script>
</body>
</html>
