@{
    ViewData["Title"] = "Keamanan Akun & Ubah Kata Sandi - SAP";
    ViewData["ActiveTab"] = "ChangePassword";
    string currentPwd = ViewData["CurrentPassword"]?.ToString() ?? "123456";
}

<div class="animate-fade-in d-flex justify-content-center align-items-center py-4" style="min-height: calc(85vh - 80px);">
    <div class="card-sap border-primary-accent p-4 p-md-5" style="max-width: 520px; width: 100%; border-radius: 24px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4); position: relative; overflow: hidden;">
        
        <!-- Subtle Top Glow Accent -->
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #0ea5e9, #6366f1, #10b981);"></div>

        <!-- Header -->
        <div class="text-center mb-4">
            <div class="mb-3" style="font-size: 32px; display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border-radius: 20px; background: linear-gradient(135deg, rgba(14, 165, 233, 0.2), rgba(99, 102, 241, 0.25)); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8; box-shadow: 0 8px 24px rgba(14, 165, 233, 0.25);">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h4 class="text-white fw-bold mb-1" style="letter-spacing: -0.3px;">Ubah Kata Sandi</h4>
            <p class="text-muted mb-0" style="font-size: 13.5px; line-height: 1.5;">Perbarui kata sandi Anda secara berkala untuk menjaga integritas dan perlindungan akun kerja Anda.</p>
        </div>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 mb-4 p-3 d-flex align-items-center" role="alert" style="background-color: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.3) !important; color: #fb7185; border-radius: 14px; font-size: 13px;">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
                <div class="flex-grow-1">@ViewData["Error"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" style="font-size: 10px;"></button>
            </div>
        }

        @if (ViewData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 mb-4 p-3 d-flex align-items-center" role="alert" style="background-color: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3) !important; color: #34d399; border-radius: 14px; font-size: 13px;">
                <i class="bi bi-shield-check fs-5 me-2 flex-shrink-0"></i>
                <div class="flex-grow-1">@ViewData["Success"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" style="font-size: 10px;"></button>
            </div>
        }

        <!-- ── Kartu Password Saat Ini (Quick Reference) ── -->
        <div class="p-3 mb-4" style="background: rgba(15, 23, 42, 0.55); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 16px; backdrop-filter: blur(8px);">
            <div class="d-flex justify-content-between align-items-center">
                <div class="flex-grow-1 me-2">
                    <div class="d-flex align-items-center gap-1 mb-1">
                        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; font-size: 10px; letter-spacing: 0.6px; font-weight: 700;">
                            <i class="bi bi-key-fill me-1"></i>KATA SANDI AKTIF
                        </span>
                    </div>
                    <div id="pwdDisplay" style="font-size: 21px; font-weight: 800; letter-spacing: 5px; color: var(--text-main, #f8fafc); font-family: 'Consolas', 'Courier New', monospace; filter: blur(6px); transition: filter 0.25s ease; user-select: none;">
                        @currentPwd
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted, #94a3b8); margin-top: 2px;">
                        Klik ikon mata untuk melihat kata sandi saat ini
                    </div>
                </div>
                <div class="d-flex gap-1">
                    <button type="button" id="togglePwdBtn" onclick="toggleCurrentPwd()" title="Tampilkan / Sembunyikan"
                            style="background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 12px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; color: #38bdf8; cursor: pointer; transition: all 0.2s ease;">
                        <i class="bi bi-eye-fill fs-5" id="eyeIcon"></i>
                    </button>
                    <button type="button" onclick="copyCurrentPwd()" title="Salin kata sandi"
                            style="background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 12px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; color: #cbd5e1; cursor: pointer; transition: all 0.2s ease;">
                        <i class="bi bi-clipboard fs-5" id="copyIcon"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- ── Form Ubah Password ── -->
        <form asp-controller="Account" asp-action="ChangePassword" method="post" id="formChangePassword" onsubmit="return validateFormBeforeSubmit()">
            @Html.AntiForgeryToken()

            <!-- 1. Password Lama -->
            <div class="form-group-sap mb-3">
                <label class="form-label-sap d-flex justify-content-between align-items-center" for="oldPassword">
                    <span>Kata Sandi Lama <span class="text-danger">*</span></span>
                </label>
                <div class="input-sap-wrapper position-relative">
                    <i class="bi bi-lock-fill input-sap-icon"></i>
                    <input type="password" id="oldPassword" name="oldPassword" class="input-sap" placeholder="Masukkan kata sandi lama Anda" required style="padding-right: 46px;" autocomplete="current-password" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted pe-3 text-decoration-none" onclick="toggleFieldVisibility('oldPassword', 'toggleOldIcon')" tabindex="-1">
                        <i class="bi bi-eye-slash-fill" id="toggleOldIcon"></i>
                    </button>
                </div>
            </div>

            <!-- 2. Password Baru -->
            <div class="form-group-sap mb-2">
                <label class="form-label-sap d-flex justify-content-between align-items-center" for="newPassword">
                    <span>Kata Sandi Baru <span class="text-danger">*</span></span>
                    <span id="strengthText" style="font-size: 11px; font-weight: 700; color: #94a3b8;">Belum diisi</span>
                </label>
                <div class="input-sap-wrapper position-relative">
                    <i class="bi bi-shield-check input-sap-icon"></i>
                    <input type="password" id="newPassword" name="newPassword" class="input-sap" placeholder="Minimal 6 karakter kombinasi" required style="padding-right: 46px;" autocomplete="new-password" oninput="evaluatePasswordStrength()" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted pe-3 text-decoration-none" onclick="toggleFieldVisibility('newPassword', 'toggleNewIcon')" tabindex="-1">
                        <i class="bi bi-eye-slash-fill" id="toggleNewIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Strength Meter Bar -->
            <div class="mb-3">
                <div class="progress" style="height: 6px; background: rgba(255, 255, 255, 0.08); border-radius: 4px; overflow: hidden;">
                    <div id="strengthBar" class="progress-bar" role="progressbar" style="width: 0%; transition: width 0.3s ease, background-color 0.3s ease;"></div>
                </div>
            </div>

            <!-- 3. Konfirmasi Password Baru -->
            <div class="form-group-sap mb-3">
                <label class="form-label-sap d-flex justify-content-between align-items-center" for="confirmPassword">
                    <span>Ulangi Kata Sandi Baru <span class="text-danger">*</span></span>
                    <span id="matchStatusText" style="font-size: 11px; font-weight: 700; color: #94a3b8;"></span>
                </label>
                <div class="input-sap-wrapper position-relative">
                    <i class="bi bi-check2-circle input-sap-icon"></i>
                    <input type="password" id="confirmPassword" name="confirmPassword" class="input-sap" placeholder="Ketik ulang kata sandi baru" required style="padding-right: 46px;" autocomplete="new-password" oninput="evaluatePasswordStrength()" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted pe-3 text-decoration-none" onclick="toggleFieldVisibility('confirmPassword', 'toggleConfirmIcon')" tabindex="-1">
                        <i class="bi bi-eye-slash-fill" id="toggleConfirmIcon"></i>
                    </button>
                </div>
            </div>

            <!-- 4. Interactive Policy Checklist -->
            <div class="p-3 mb-4" style="background: rgba(0, 0, 0, 0.15); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 14px; font-size: 12px;">
                <div class="fw-bold text-white mb-2" style="font-size: 11.5px; letter-spacing: 0.3px;">
                    <i class="bi bi-check2-square text-primary me-1"></i> Syarat Kekuatan Kata Sandi:
                </div>
                <div class="row g-2">
                    <div class="col-6 d-flex align-items-center" id="reqLength" style="color: #64748b; transition: color 0.2s;">
                        <i class="bi bi-circle me-2 req-icon" style="font-size: 10px;"></i> Minimal 6 karakter
                    </div>
                    <div class="col-6 d-flex align-items-center" id="reqNumber" style="color: #64748b; transition: color 0.2s;">
                        <i class="bi bi-circle me-2 req-icon" style="font-size: 10px;"></i> Mengandung angka
                    </div>
                    <div class="col-6 d-flex align-items-center" id="reqLetter" style="color: #64748b; transition: color 0.2s;">
                        <i class="bi bi-circle me-2 req-icon" style="font-size: 10px;"></i> Huruf besar & kecil
                    </div>
                    <div class="col-6 d-flex align-items-center" id="reqMatch" style="color: #64748b; transition: color 0.2s;">
                        <i class="bi bi-circle me-2 req-icon" style="font-size: 10px;"></i> Konfirmasi cocok
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="btnSubmitPassword" class="btn btn-primary w-100 py-3 mb-3 fw-bold shadow-lg" style="border-radius: 14px; background: linear-gradient(135deg, #0284c7, #2563eb); border: none; letter-spacing: 0.5px; transition: all 0.25s ease;">
                <i class="bi bi-check-circle-fill me-2"></i> SIMPAN KATA SANDI BARU
            </button>
            
            <div class="d-flex justify-content-between align-items-center pt-2" style="font-size: 12.5px;">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: #38bdf8; font-weight: 600;">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard Utama
                </a>
                <a asp-controller="Account" asp-action="Profile" class="text-decoration-none text-muted" style="font-weight: 500;">
                    <i class="bi bi-person-circle me-1"></i> Profil Pengguna
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .card-sap {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .input-sap-wrapper input:focus {
        border-color: #38bdf8 !important;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2) !important;
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.4) !important;
    }
</style>

@section Scripts {
    <script>
        var currentRevealed = false;
        var rawCurrentPwd = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentPwd));

        function toggleCurrentPwd() {
            currentRevealed = !currentRevealed;
            var display = document.getElementById('pwdDisplay');
            var icon = document.getElementById('eyeIcon');
            if (currentRevealed) {
                display.style.filter = 'none';
                display.style.userSelect = 'text';
                icon.className = 'bi bi-eye-slash-fill fs-5';
            } else {
                display.style.filter = 'blur(6px)';
                display.style.userSelect = 'none';
                icon.className = 'bi bi-eye-fill fs-5';
            }
        }

        function copyCurrentPwd() {
            if (!rawCurrentPwd) return;
            navigator.clipboard.writeText(rawCurrentPwd).then(function() {
                var copyIcon = document.getElementById('copyIcon');
                copyIcon.className = 'bi bi-check2 text-success fs-5';
                setTimeout(function() {
                    copyIcon.className = 'bi bi-clipboard fs-5';
                }, 2000);
            });
        }

        function toggleFieldVisibility(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-fill text-primary';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye-slash-fill';
            }
        }

        function evaluatePasswordStrength() {
            var pwd = document.getElementById('newPassword').value || '';
            var confirm = document.getElementById('confirmPassword').value || '';

            var hasLength = pwd.length >= 6;
            var hasUpper = /[A-Z]/.test(pwd);
            var hasLower = /[a-z]/.test(pwd);
            var hasNumber = /[0-9]/.test(pwd);
            var isLetterMatch = hasUpper && hasLower;
            var isMatch = pwd.length > 0 && pwd === confirm;

            updateChecklist('reqLength', hasLength);
            updateChecklist('reqLetter', isLetterMatch);
            updateChecklist('reqNumber', hasNumber);
            updateChecklist('reqMatch', isMatch);

            // Calculate Score
            var score = 0;
            if (pwd.length >= 6) score++;
            if (pwd.length >= 8) score++;
            if (hasUpper && hasLower) score++;
            if (hasNumber) score++;
            if (/[^A-Za-z0-9]/.test(pwd)) score++;

            var bar = document.getElementById('strengthBar');
            var text = document.getElementById('strengthText');
            var matchText = document.getElementById('matchStatusText');

            if (confirm.length > 0) {
                if (isMatch) {
                    matchText.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Cocok</span>';
                } else {
                    matchText.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>Tidak Cocok</span>';
                }
            } else {
                matchText.innerHTML = '';
            }

            if (pwd.length === 0) {
                bar.style.width = '0%';
                bar.className = 'progress-bar';
                text.textContent = 'Belum diisi';
                text.style.color = '#94a3b8';
                return;
            }

            if (score <= 1) {
                bar.style.width = '25%';
                bar.style.backgroundColor = '#f43f5e';
                text.textContent = 'Sangat Lemah';
                text.style.color = '#f43f5e';
            } else if (score === 2) {
                bar.style.width = '50%';
                bar.style.backgroundColor = '#f97316';
                text.textContent = 'Cukup';
                text.style.color = '#f97316';
            } else if (score === 3) {
                bar.style.width = '75%';
                bar.style.backgroundColor = '#eab308';
                text.textContent = 'Kuat';
                text.style.color = '#eab308';
            } else {
                bar.style.width = '100%';
                bar.style.backgroundColor = '#10b981';
                text.textContent = 'Sangat Kuat & Aman';
                text.style.color = '#10b981';
            }
        }

        function updateChecklist(elementId, isValid) {
            var el = document.getElementById(elementId);
            if (!el) return;
            var icon = el.querySelector('i');
            if (isValid) {
                el.style.color = '#34d399';
                if (icon) icon.className = 'bi bi-check-circle-fill text-success me-2';
            } else {
                el.style.color = '#64748b';
                if (icon) icon.className = 'bi bi-circle me-2';
            }
        }

        function validateFormBeforeSubmit() {
            var oldP = document.getElementById('oldPassword').value;
            var newP = document.getElementById('newPassword').value;
            var confP = document.getElementById('confirmPassword').value;

            if (!oldP || !newP || !confP) {
                alert('Harap isi semua kolom kata sandi!');
                return false;
            }
            if (newP.length < 6) {
                alert('Kata sandi baru minimal harus 6 karakter!');
                return false;
            }
            if (newP !== confP) {
                alert('Kata sandi baru dan konfirmasi kata sandi tidak cocok!');
                return false;
            }
            if (oldP === newP) {
                if (!confirm('Kata sandi baru sama dengan kata sandi lama Anda. Apakah Anda yakin ingin melanjutkan?')) {
                    return false;
                }
            }
            return true;
        }
    </script>
}
