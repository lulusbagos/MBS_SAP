@{
    ViewData["Title"] = "Akses Ditolak";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-5" style="min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div class="card border-0 shadow-lg" style="max-width: 640px; width: 100%; border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="mb-4" style="width: 88px; height: 88px; border-radius: 24px; background: linear-gradient(135deg, #f97316, #ef4444); display: inline-flex; align-items: center; justify-content: center; color: white; font-size: 2rem; box-shadow: 0 18px 40px rgba(239,68,68,0.25);">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <h2 class="fw-bold mb-2">Akses ditolak</h2>
            <p class="text-muted mb-4">Akun yang sedang login tidak memiliki hak untuk membuka halaman ini.</p>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <div class="alert alert-warning border-0 rounded-4 mb-4" style="background: rgba(245, 158, 11, 0.12);">
                    <div class="fw-semibold mb-1">Akun aktif saat ini</div>
                    <div>@User.Identity?.Name</div>
                    <div class="small text-muted">Role: @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "-")</div>
                </div>
            }

            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 rounded-pill">Kembali ke Dashboard</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4 rounded-pill">Login Ulang</a>
            </div>
        </div>
    </div>
</div>