    <p id="loadingSubtitle" style="font-size: 13px; color: rgba(255,255,255,0.7); margin-bottom: 16px; text-align: center; max-width: 320px; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">Sedang menyimpan laporan temuan hazard dan mengunggah lampiran foto. Mohon jangan menutup halaman ini...</p>

    <!-- Progress Bar Container -->
    <div style="width: 280px; background: rgba(255,255,255,0.1); height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.05);">
        <div id="loadingProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #f97316, #ea580c); transition: width 0.1s ease; border-radius: 4px;"></div>
    </div>
    <div id="loadingProgressPercent" style="font-size: 14px; font-weight: 700; color: #f97316; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">0%</div>
</div>

<style>
    @@keyframes sap-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    @@keyframes sap-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }
</style>

@section Scripts {
    <script>
        let hazardFormSubmitting = false;

        // Compress image client side
        function compressImage(file, maxWidth, maxHeight, quality) {
            return new Promise((resolve) => {
                if (!file.type.startsWith('image/')) {
                    resolve(file);
                    return;
                }
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (event) => {
                    const img = new Image();
                    img.src = event.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let width = img.width;
                        let height = img.height;
                        if (width > height) {
                            if (width > maxWidth) {
                                height = Math.round((height * maxWidth) / width);
                                width = maxWidth;
                            }
                        } else {
                            if (height > maxHeight) {
                                width = Math.round((width * maxHeight) / height);
                                height = maxHeight;
                            }
                        }
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        canvas.toBlob((blob) => {
                            if (blob) {
                                const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                                    type: 'image/jpeg',
                                    lastModified: Date.now()
                                });
                                resolve(compressedFile);
                            } else {
                                resolve(file);
                            }
                        }, 'image/jpeg', quality);
                    };
                    img.onerror = () => resolve(file);
                };
                reader.onerror = () => resolve(file);
            });
        }

        function showSapToast(message, type = 'warning') {
            $('.sap-custom-toast').remove();
            
            let iconClass = 'bi-exclamation-triangle-fill';
            let bgColor = 'rgba(245, 158, 11, 0.95)';
            let textColor = '#ffffff';
            let borderStyle = '1px solid rgba(245, 158, 11, 0.3)';
            
            if (type === 'success') {
                iconClass = 'bi-check-circle-fill';
                bgColor = 'rgba(34, 197, 94, 0.95)';
                borderStyle = '1px solid rgba(34, 197, 94, 0.3)';
            } else if (type === 'danger' || type === 'error') {
                iconClass = 'bi-x-circle-fill';
                bgColor = 'rgba(239, 68, 68, 0.95)';
                borderStyle = '1px solid rgba(239, 68, 68, 0.3)';
            }
            
            const toastHtml = `
                <div class="sap-custom-toast shadow" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-20px); background: ${bgColor}; color: ${textColor}; border: ${borderStyle}; padding: 12px 24px; border-radius: 12px; z-index: 10000; display: flex; align-items: center; gap: 12px; font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 600; opacity: 0; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); backdrop-filter: blur(8px); min-width: 320px; justify-content: center; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);">
                    <i class="bi ${iconClass}" style="font-size: 16px;"></i>
                    <span>${message}</span>
                </div>
            `;
            
            $('body').append(toastHtml);
            
            setTimeout(function() {
                $('.sap-custom-toast').css({
                    'opacity': '1',
                    'transform': 'translateX(-50%) translateY(0)'
                });
            }, 50);
            
            setTimeout(function() {
                $('.sap-custom-toast').css({
                    'opacity': '0',
                    'transform': 'translateX(-50%) translateY(-20px)'
                });
                setTimeout(function() {
                    $('.sap-custom-toast').remove();
                }, 300);
            }, 4000);
        }
        function openCloseHazard(id, nikPja, pjaName) {
            $('#closeHazardId').val(id);
            $('#closeHazardNote').val('');
            $('#closeHazardError').hide().text('');
            $('#closeModePja').prop('checked', true);

            if (nikPja && pjaName) {
                $('#closeHazardPjaInfo').html('<i class="bi bi-person-check me-1"></i>Akan dikirim ke PJA: <strong>' + pjaName + ' (' + nikPja + ')</strong>');
            } else {
                $('#closeHazardPjaInfo').html('<i class="bi bi-exclamation-triangle me-1 text-warning"></i>PJA belum ditentukan pada laporan ini. Pilih mode <strong>Selesaikan Sendiri</strong> atau edit laporan untuk menetapkan PJA.');
            }

            $('#closeHazardModal').modal('show');
        }

        function submitCloseHazard() {
            var id = $('#closeHazardId').val();
            var mode = $('input[name="closeMode"]:checked').val();
            var note = $('#closeHazardNote').val();
            var token = $('input[name="__RequestVerificationToken"]').val();

            if (!id) {
                $('#closeHazardError').text('Data hazard tidak valid.').show();
                return;
            }

            var form = $('<form method="post" action="/Hazard/Close/' + id + '"></form>');
            form.append('<input type="hidden" name="__RequestVerificationToken" value="' + token + '" />');
            form.append('<input type="hidden" name="closeMode" value="' + mode + '" />');
            form.append($('<input type="hidden" name="closeNote" />').val(note));
            $('body').append(form);
            form.submit();
        }

        function previewImage(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('uploadPlaceholder').classList.add('d-none');
                    document.getElementById('imagePreviewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        // PJA Search Logic
        let pjaTimeout = null;
        let pjaIsLintasPerusahaan = true;

        function toggleLintasPerusahaanSearch() {
            pjaIsLintasPerusahaan = document.getElementById('lintasPerusahaanToggle').checked;
            const input = document.getElementById('pjaSearchInput').value;
            if(input.length >= 3) {
                searchPja();
            }
        }

        $('#pjaSearchInput').on('input', function() {
            clearTimeout(pjaTimeout);
            const query = $(this).val();
            
            if (query.length < 1) {
                $('#pjaSearchResults').hide();
                return;
            }

            pjaTimeout = setTimeout(searchPja, 300);
        });

        function searchPja() {
            const query = $('#pjaSearchInput').val();
            if (query.length < 1) return;

            $.when(
                $.get('/Api/GetPjaReference', {
                    lintasPerusahaan: pjaIsLintasPerusahaan
                }),
                $.get('/Api/SearchEmployee', {
                    query: query,
                    lintasPerusahaan: pjaIsLintasPerusahaan
                })
            ).done(function(pjaRefResp, employeeResp) {
                const pjaRefs = pjaRefResp[0] || [];
                const employees = employeeResp[0] || [];
                const lowerQuery = query.toLowerCase();

                const filteredPjaRefs = pjaRefs.filter(function(x) {
                    return (x.nama || '').toLowerCase().includes(lowerQuery)
                        || (x.perusahaan || '').toLowerCase().includes(lowerQuery)
                        || (x.nik || '').toLowerCase().includes(lowerQuery)
                        || (x.jabatan || '').toLowerCase().includes(lowerQuery);
                });

                const merged = [];
                const seen = new Set();

                filteredPjaRefs.forEach(function(item) {
                    const key = (item.nik || '') + '|' + (item.perusahaan || '');
                    if (!seen.has(key)) {
                        seen.add(key);
                        merged.push(item);
                    }
                });

                employees.forEach(function(item) {
                    const key = (item.nik || '') + '|' + (item.perusahaan || '');
                    if (!seen.has(key)) {
                        seen.add(key);
                        item.companyOnly = false;
                        item.source = item.source || 'employee';
                        merged.push(item);
                    }
                });

                const resultsContainer = $('#pjaSearchResults');
                resultsContainer.empty();
                
                if (merged.length === 0) {
                    resultsContainer.append('<div class="p-3 text-center text-muted" style="font-size: 12px;">PJA tidak ditemukan.</div>');
                } else {
                    const companies = merged.filter(x => !!x.companyOnly);
                    const employees = merged.filter(x => !x.companyOnly);

                    if (companies.length > 0) {
                        resultsContainer.append(`
                            <div class="dropdown-header text-primary fw-bold px-3 py-2 bg-dark-card border-bottom" style="font-size: 11px; letter-spacing: 0.5px; opacity: 0.9; cursor: default;">
                                <i class="bi bi-building me-1"></i> PILIH PERUSAHAAN (COMPANY ONLY)
                            </div>
                        `);
                        companies.forEach(function(k) {
                            appendItem(k);
                        });
                    }

                    if (employees.length > 0) {
                        resultsContainer.append(`
                            <div class="dropdown-header text-success fw-bold px-3 py-2 bg-dark-card border-bottom border-top" style="font-size: 11px; letter-spacing: 0.5px; opacity: 0.9; cursor: default; margin-top: 5px;">
                                <i class="bi bi-person-badge me-1"></i> PILIH KARYAWAN / PJO (INDIVIDU)
                            </div>
                        `);
                        employees.forEach(function(k) {
                            appendItem(k);
                        });
                    }

                    function appendItem(k) {
                        const init = (k.nama || '-').charAt(0);
                        const safeNik = (k.nik || '').replace(/'/g, "\\'");
                        const safeNama = (k.nama || '').replace(/'/g, "\\'");
                        const safeJabatan = (k.jabatan || '').replace(/'/g, "\\'");
                        const safeDept = (k.departemen || '').replace(/'/g, "\\'");
                        const safePerusahaan = (k.perusahaan || '').replace(/'/g, "\\'");
                        const safeCompanyOnly = !!k.companyOnly;

                        const badge = safeCompanyOnly
                            ? '<span class="badge bg-warning text-dark" style="font-size:10px;">COMPANY ONLY</span>'
                            : '<span class="badge bg-success" style="font-size:10px;">PJA/EMPLOYEE</span>';

                        const item = $(`
                            <div class="dropdown-item p-3" style="cursor: pointer; border-bottom: 1px solid var(--border-color);" onclick="selectPja('${safeNik}', '${safeNama}', '${safeJabatan}', '${safeDept}', '${safePerusahaan}', ${safeCompanyOnly})">
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--bg-layout); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 16px; color: var(--color-primary);">
                                        ${init}
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2" style="font-weight: 700; font-size: 13px; color: var(--text-main);">
                                            <span>${k.nama || '-'}</span>${badge}
                                        </div>
                                        <div style="font-size: 11px; color: var(--text-muted);"><i class="bi bi-person-badge me-1"></i>${k.nik || '-'} &bull; ${k.jabatan || '-'}</div>
                                        <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;"><i class="bi bi-building me-1"></i>${k.departemen || '-'} | ${k.perusahaan || '-'}</div>
                                    </div>
                                </div>
                            </div>
                        `);
                        resultsContainer.append(item);
                    }
                }
                resultsContainer.show();
            });
        }

        function selectPja(nik, nama, jabatan, dept, perusahaan, companyOnly) {
            $('#nikPja').val(nik);
            $('#pja').val(nama);
            $('#departemenPja').val(dept);
            
            // Display Logic
            let initial = nama.charAt(0).toUpperCase();
            $('#pjaInitial').text(initial);
            $('#pjaDisplayNama').text(nama);
            $('#pjaDisplayJabatan').text(companyOnly ? (jabatan || 'PENANGGUNG JAWAB PERUSAHAAN') : (jabatan || '-'));
            $('#pjaDisplayDept').text(dept || '-');
            $('#pjaDisplayPerusahaan').text(perusahaan || '-');

            $('#selectedPjaCard').removeClass('d-none');
            $('#pjaSearchResults').hide();
            $('#pjaSearchInput').val('');
            $('#pjaSearchInput').parent().hide();
            $('#lintasPerusahaanToggle').closest('.d-flex').hide();
            $('#recentPjasContainer').addClass('d-none');
            
            // Clear validation error on select
            $('#pjaSearchInput').removeClass('is-invalid');
            $('#pjaSearchInput').closest('.form-group-sap').find('.sap-err-msg').remove();
            
            // Save to localStorage
            saveRecentPja({
                nik: nik,
                nama: nama,
                jabatan: jabatan,
                dept: dept,
                perusahaan: perusahaan,
                companyOnly: companyOnly
            });
        }

        function cancelEditHazard() {
            $('#hazardForm')[0].reset();
            $('#hazardId').val('');
            $('#formTitle').html('<i class="bi bi-plus-circle-fill me-2" style="color: var(--color-orange);"></i>Buat Laporan Baru');
            $('#btnCancelEdit').addClass('d-none');
            clearSelectedPja();

            // Reset image preview
            $('#imagePreview').attr('src', '');
            $('#imagePreviewContainer').addClass('d-none');
            $('#uploadPlaceholder').show();

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function editHazard(id) {
            $.get('/Hazard/GetData/' + id, function(data) {
                if (data) {
                    $('#hazardId').val(data.id);
                    
                    // Format dates and times
                    if (data.tanggal) $('#tanggal').val(data.tanggal.split('T')[0]);
                    if (data.waktu) $('#waktuStr').val(data.waktu.substring(0, 5));
                    
                    // Selects
                    $('#area').val(data.area).change();
                    $('#kategoriBahaya').val(data.kategoriBahaya).change();
                    $('input[name="tingkatResiko"][value="' + data.tingkatResiko + '"]').prop('checked', true);

                    // Inputs
                    $('#lokasi').val(data.lokasi);
                    $('#detilLokasi').val(data.detilLokasi);
                    $('#temuan').val(data.temuan);
