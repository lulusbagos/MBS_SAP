        const RECENT_PJAS_KEY = 'mbs_sap_recent_pjas';

        function saveRecentPja(pja) {
            try {
                let list = JSON.parse(localStorage.getItem(RECENT_PJAS_KEY) || '[]');
                list = list.filter(item => item.nik !== pja.nik);
                list.unshift(pja);
                list = list.slice(0, 3);
                localStorage.setItem(RECENT_PJAS_KEY, JSON.stringify(list));
                renderRecentPjas();
            } catch (e) {
                console.error('Error saving recent PJA', e);
            }
        }

        function renderRecentPjas() {
            try {
                const list = JSON.parse(localStorage.getItem(RECENT_PJAS_KEY) || '[]');
                const container = $('#recentPjasContainer');
                const listContainer = $('#recentPjasList');
                
                if (list.length === 0) {
                    container.addClass('d-none');
                    return;
                }
                
                listContainer.empty();
                list.forEach(function(item) {
                    const badgeClass = item.companyOnly ? 'btn-outline-warning' : 'btn-outline-success';
                    const btn = $(`
                        <button type="button" class="btn btn-sm ${badgeClass} py-0 px-2 text-truncate" style="max-width: 130px; font-size: 9px; border-radius: 6px; color: white;" title="${item.nama}">
                            ${item.nama}
                        </button>
                    `);
                    btn.on('click', function(e) {
                        e.preventDefault();
                        selectPja(item.nik, item.nama, item.jabatan, item.dept, item.perusahaan, item.companyOnly);
                    });
                    listContainer.append(btn);
                });
                container.removeClass('d-none');
            } catch (e) {
                console.error('Error rendering recent PJAs', e);
            }
        }

        // Client-side Search and Filter logic
        let currentStatusFilter = 'all';
        let currentRiskFilter = 'all';
        let currentSearchQuery = '';

        function applyHistoryFilters() {
            let visibleCount = 0;
            $('.card-sap[data-status]').each(function() {
                const card = $(this);
                const status = card.data('status').toLowerCase();
                const risk = card.data('risk');
                const searchText = card.data('search-text') || '';

                const matchesStatus = (currentStatusFilter === 'all') || (status === currentStatusFilter);
                const matchesRisk = (currentRiskFilter === 'all') || (risk === currentRiskFilter);
                const matchesSearch = (currentSearchQuery === '') || searchText.includes(currentSearchQuery);

                if (matchesStatus && matchesRisk && matchesSearch) {
                    card.show();
                    visibleCount++;
                } else {
                    card.hide();
                }
            });

            let emptyMsg = $('#emptyHistoryMsg');
            if (visibleCount === 0) {
                if (!emptyMsg.length) {
                    $('.card-sap[data-status]').parent().append(`
                        <div id="emptyHistoryMsg" class="card-sap text-center py-4 text-muted">
                            <i class="bi bi-search d-block mb-2" style="font-size: 32px;"></i>
                            Tidak ada laporan hazard yang cocok dengan filter pencarian.
                        </div>
                    `);
                } else {
                    emptyMsg.show();
                }
            } else {
                if (emptyMsg.length) {
                    emptyMsg.hide();
                }
            }
        }

        $(document).ready(function() {
            loadAreas();
            renderRecentPjas();
            
            // Auto fetch GPS if creating new hazard
            if (!$('#hazardId').val()) {
                getLocation();
            }

            // Bind filters
            $('#historySearchInput').on('input', function() {
                currentSearchQuery = $(this).val().toLowerCase().trim();
                applyHistoryFilters();
            });

            $('.filter-btn-status').on('click', function() {
                $('.filter-btn-status').removeClass('active');
                $(this).addClass('active');
                currentStatusFilter = $(this).data('filter-status');
                applyHistoryFilters();
            });

            $('#filterRisk').on('change', function() {
                currentRiskFilter = $(this).val();
                applyHistoryFilters();
            });

            // Prevent double submission & submit via AJAX with compression and progress bar
            $('#hazardForm').on('submit', function(e) {
                e.preventDefault();
                if (hazardFormSubmitting) {
                    return false;
                }

                // Custom validation
                let isValid = true;
                let firstInvalid = null;
                let errorMessages = [];
                
                $('#hazardForm').find('.is-invalid').removeClass('is-invalid');
                $('#hazardForm').find('.sap-err-msg').remove();

                const fieldsToValidate = {
                    'tanggal': 'Tanggal Temuan',
                    'waktuStr': 'Waktu Temuan',
                    'area': 'Area Utama',
                    'lokasi': 'Lokasi Spesifik',
                    'kategoriBahaya': 'Kategori Bahaya',
                    'jenisBahaya': 'Jenis Bahaya',
                    'temuan': 'Detil Temuan Hazard'
                };

                // Validate visible input/select/textarea
                $('#hazardForm').find('input[required]:visible, select[required]:visible, textarea[required]:visible').each(function() {
                    const $el = $(this);
                    const id = $el.attr('id') || $el.attr('name');
                    const val = $el.val();
                    
                    if (!val || val.toString().trim() === '') {
                        isValid = false;
                        $el.addClass('is-invalid');
                        if (!firstInvalid) firstInvalid = $el;
                        
                        const labelName = fieldsToValidate[id] || $el.closest('.form-group-sap').find('label').text() || 'Field';
                        const cleanLabel = labelName.replace(':', '').replace('*', '').trim();
                        errorMessages.push(cleanLabel);
                        const errHtml = `<span class="text-danger sap-err-msg d-block mt-1"><i class="bi bi-exclamation-circle-fill me-1"></i>${cleanLabel} wajib diisi.</span>`;
                        
                        const $wrapper = $el.closest('.input-sap-wrapper');
                        if ($wrapper.length) {
                            $wrapper.after(errHtml);
                        } else {
                            $el.after(errHtml);
                        }
                    }
                });

                // Validate PJA selection
                const pjaVal = $('#pja').val();
                if (!pjaVal || pjaVal.trim() === '') {
                    isValid = false;
                    $('#pjaSearchInput').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#pjaSearchInput');
                    
                    const searchVal = $('#pjaSearchInput').val().trim();
                    let errMsg = 'Penanggung Jawab Area (PJA) wajib dipilih dari pencarian.';
                    if (searchVal !== '') {
                        errMsg = 'Nama PJA sudah diketik, tapi belum dipilih dari daftar. Silakan klik salah satu nama hasil pencarian yang muncul di bawahnya.';
                    }
                    errorMessages.push("Penanggung Jawab Area (PJA)");
                    
                    if ($('#pjaSearchInput').closest('.form-group-sap').find('.sap-err-msg').length === 0) {
                        $('#pjaSearchInput').after(`<span class="text-danger sap-err-msg d-block mt-1"><i class="bi bi-exclamation-circle-fill me-1"></i>${errMsg}</span>`);
                    }
                }

                // Validate Area Utama (searchable input)
                const areaVal = $('#area').val();
                if (!areaVal || areaVal.trim() === '') {
                    isValid = false;
                    $('#areaSearch').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#areaSearch');
                    
                    errorMessages.push("Area Utama");
                    if ($('#areaSearch').closest('.form-group-sap').find('.sap-err-msg').length === 0) {
                        $('#areaSearch').after('<span class="text-danger sap-err-msg d-block mt-1"><i class="bi bi-exclamation-circle-fill me-1"></i>Area Utama wajib dipilih dari daftar.</span>');
                    }
                }

                if (!isValid) {
                    let toastMsg = "Gagal menyimpan: Silakan lengkapi kolom yang wajib diisi!";
                    if (errorMessages.length > 0) {
                        toastMsg = "Gagal menyimpan: " + errorMessages.join(', ') + " belum diisi dengan benar.";
                    }
                    showSapToast(toastMsg, "danger");
                    if (firstInvalid) {
                        $('html, body').animate({
                            scrollTop: firstInvalid.offset().top - 120
                        }, 300);
                    }
                    return false;
                }

                var perbaikan = $('#perbaikan').val().trim();
                var nikPja = $('#nikPja').val().trim();
                var pjaName = $('#pja').val().trim();
                
                // If the user hasn't filled Tindakan Perbaikan AND hasn't assigned a PJA
                if (perbaikan === '' && nikPja === '' && pjaName === '') {
                    var confirmMsg = "Anda yakin hazard ini tidak di-close (Tindakan Perbaikan kosong) atau dilaporkan ke PJA terkait?\n\nHazard ini akan berstatus OPEN tanpa penanggung jawab dan dapat menjadi overdue hazard bagi perusahaan Anda.";
                    if (!confirm(confirmMsg)) {
                        return false;
                    }
                }

                hazardFormSubmitting = true;
                var btn = $('#btnSubmitHazard');
                
                // Safari-safe double-click prevention
                btn.css('pointer-events', 'none');
                var originalText = btn.html();
                btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>MENYIMPAN...');

                // Form submit via AJAX with upload progress and client-side compression
                const $overlay = $('#loadingOverlay');
                const $progressBar = $('#loadingProgressBar');
                const $progressPercent = $('#loadingProgressPercent');
                const $title = $('#loadingTitle');
                const $subtitle = $('#loadingSubtitle');

                $overlay.css('display', 'flex');
                $title.text('Menyiapkan Data...');
                $subtitle.text('Sedang memproses laporan hazard...');
                $progressBar.css('width', '0%');
                $progressPercent.text('0%');

                const rawFormData = new FormData($('#hazardForm')[0]);
                const compressedFormData = new FormData();

                // Append all non-file fields to compressedFormData
                for (let [key, value] of rawFormData.entries()) {
                    if (!(value instanceof File)) {
                        compressedFormData.append(key, value);
                    }
                }

                // Collect all files to compress
                const filePromises = [];
                const filesToCompress = [];

                $('#hazardForm').find('input[type="file"]').each(function() {
                    const name = $(this).attr('name');
                    const files = $(this)[0].files;
                    if (files && files.length > 0) {
                        for (let i = 0; i < files.length; i++) {
                            filesToCompress.push({ name: name, file: files[i] });
                        }
                    }
                });

                if (filesToCompress.length === 0) {
                    sendAjaxRequest(rawFormData);
                } else {
                    $title.text('Mengompresi Gambar...');
                    $subtitle.text('Mengompresi foto bukti agar unggah lebih cepat...');

                    filesToCompress.forEach(item => {
                        const promise = compressImage(item.file, 1024, 1024, 0.75)
                            .then(compressedFile => {
                                compressedFormData.append(item.name, compressedFile);
                            });
                        filePromises.push(promise);
                    });

                    Promise.all(filePromises).then(() => {
                        $title.text('Mengirim Data...');
                        $subtitle.text('Sedang mengunggah laporan dan lampiran...');
                        sendAjaxRequest(compressedFormData);
                    }).catch(err => {
                        console.error('Compression error:', err);
                        $title.text('Mengirim Data (Tanpa Kompresi)...');
                        sendAjaxRequest(rawFormData);
                    });
                }

                function sendAjaxRequest(formData) {
                    $.ajax({
                        url: $('#hazardForm').attr('action'),
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        xhr: function() {
                            const xhr = new window.XMLHttpRequest();
                            xhr.upload.addEventListener('progress', function(evt) {
                                if (evt.lengthComputable) {
                                    const percentComplete = Math.round((evt.loaded / evt.total) * 100);
                                    $progressBar.css('width', percentComplete + '%');
                                    $progressPercent.text(percentComplete + '%');
                                    if (percentComplete === 100) {
                                        $title.text('Memproses di Server...');
                                        $subtitle.text('Mohon tunggu, server sedang menyimpan data...');
                                    }
                                }
                            }, false);
                            return xhr;
                        },
                        success: function(response) {
                            $title.text('Selesai!');
                            $subtitle.text('Laporan hazard berhasil disimpan.');
                            $progressBar.css('width', '100%');
                            $progressPercent.text('100%');
                            
                            setTimeout(() => {
                                window.location.href = '/Hazard/Index';
                            }, 500);
                        },
                        error: function(xhr, status, error) {
                            $overlay.css('display', 'none');
                            btn.css('pointer-events', 'auto');
                            btn.html(originalText);
                            hazardFormSubmitting = false;
                            
                            let errMessage = "Gagal mengirim data. Silakan periksa koneksi internet Anda.";
                            if (xhr.status === 400 || xhr.status === 500) {
                                errMessage = "Terjadi kesalahan di server. Silakan hubungi admin.";
                            }
                            
                            if (typeof showSapToast === 'function') {
                                showSapToast(errMessage, "danger");
                            } else if (typeof alert === 'function') {
                                alert(errMessage);
                            }
                        }
                    });
                }
            });
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('.form-group-sap').length) {
                $('#pjaSearchResults').hide();
            }
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
