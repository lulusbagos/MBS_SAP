                            <i class="bi bi-save me-1"></i> Simpan Laporan SPI
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Detail Modal -->
<div class="modal fade" id="spiDetailModal" tabindex="-1" aria-labelledby="spiDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 16px 24px;">
                <h5 class="modal-title font-weight-bold d-flex align-items-center gap-2" id="spiDetailModalLabel" style="color: var(--text-main);">
                    <i class="bi bi-droplet-half" style="color: #10b981;"></i>
                    <span id="detailModalTitle">Detail Laporan Sediment Pond Index (SPI)</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailModalBody" style="padding: 24px;">
                <!-- Loaded via JS -->
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 12px 24px;">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">Tutup</button>
                <button type="button" class="btn btn-sm btn-success" id="btnShareDetailWa" style="background: #25d366; border: none; border-radius: 8px;">
                    <i class="bi bi-whatsapp me-1"></i> Bagikan ke WhatsApp
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Scoring Selector Styling */
    .param-box-premium {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 12px;
        transition: all 0.2s ease;
    }
    .param-box-premium:hover {
        border-color: rgba(16, 185, 129, 0.4);
        background: rgba(16, 185, 129, 0.02);
    }
    .param-icon-badge {
        width: 32px; height: 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; font-weight: 700;
    }
    .param-header-title {
        font-size: 12.5px; font-weight: 700; color: var(--text-main);
    }
    .param-guideline-badge {
        font-size: 10.5px; color: var(--text-muted);
        background: rgba(255, 255, 255, 0.04);
        padding: 3px 8px; border-radius: 6px;
    }
    .score-btn-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 8px;
    }
    .btn-score-card {
        background: var(--bg-card);
        border: 1.5px solid var(--border-color);
        border-radius: 10px;
        padding: 9px 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        cursor: pointer;
        transition: all 0.18s ease;
        text-align: left;
    }
    .btn-score-card:hover {
        border-color: #10b981;
        background: rgba(16, 185, 129, 0.08);
    }
    .btn-score-card.active {
        border-color: #10b981;
        background: rgba(16, 185, 129, 0.18);
        box-shadow: 0 0 0 1px #10b981;
    }
    .btn-score-pill {
        font-size: 12px; font-weight: 800;
        padding: 2px 7px; border-radius: 6px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-main);
    }
    .btn-score-card.active .btn-score-pill {
        background: #10b981; color: white;
    }
    .btn-score-text {
        font-size: 11px; font-weight: 600; color: var(--text-main);
        flex: 1; line-height: 1.3;
    }
    .btn-score-icon {
        font-size: 14px; opacity: 0; color: #10b981;
        transition: opacity 0.15s ease;
    }
    .btn-score-card.active .btn-score-icon {
        opacity: 1;
    }
    @@media (max-width: 768px) {
        .score-btn-grid { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
<script>
    // Live Score Calculation
    function calcLiveScore() {
        const p1 = parseInt(document.getElementById('skorKapasitasEndapan').value) || 100;
        const p2 = parseInt(document.getElementById('skorKondisiTanggul').value) || 100;
        const p3 = parseInt(document.getElementById('skorSekatBaffle').value) || 100;
        const p4 = parseInt(document.getElementById('skorPelimpahSpillway').value) || 100;
        const p5 = parseInt(document.getElementById('skorFasilitasDosing').value) || 100;
        const p6 = parseInt(document.getElementById('skorKualitasAirFisik').value) || 100;
        const p7 = parseInt(document.getElementById('skorTitikPenaatanDebit').value) || 100;
        const p8 = parseInt(document.getElementById('skorRambuPengaman').value) || 100;

        let total = (p1 * 0.15) + (p2 * 0.15) + (p3 * 0.15) + (p4 * 0.15) +
                    (p5 * 0.10) + (p6 * 0.10) + (p7 * 0.10) + (p8 * 0.10);
        total = Math.round(total * 10) / 10;

        let kat = total >= 85 ? "Baik" : (total >= 70 ? "Sedang" : "Kurang");
        let color = total >= 85 ? "#10b981" : (total >= 70 ? "#f59e0b" : "#f43f5e");
        let bg = total >= 85 ? "rgba(16, 185, 129, 0.2)" : (total >= 70 ? "rgba(245, 158, 11, 0.2)" : "rgba(244, 63, 94, 0.2)");

        const scoreValEl = document.getElementById('liveScoreVal');
        const badgeEl = document.getElementById('liveScoreBadge');
        if (scoreValEl && badgeEl) {
            scoreValEl.innerText = total.toFixed(1);
            badgeEl.innerHTML = `Skor SPI: <span id="liveScoreVal">${total.toFixed(1)}</span>% (${kat})`;
            badgeEl.style.color = color;
            badgeEl.style.backgroundColor = bg;
            badgeEl.style.borderColor = color;
        }
    }

    function openInputModal() {
        document.getElementById('spiForm').reset();
        document.getElementById('reportId').value = '';
        document.getElementById('modalFormTitle').innerText = 'Form Inspeksi Sediment Pond Index (SPI)';
        const newBadge = document.getElementById('modalNewBadge');
        if (newBadge) newBadge.classList.remove('d-none');
        document.getElementById('inputTanggal').value = new Date().toISOString().substring(0, 10);
        document.getElementById('inputWaktu').value = new Date().toTimeString().substring(0, 5);
        document.getElementById('photoPreviewWrap').classList.add('d-none');

        // Reset all buttons to 100
        ['skorKapasitasEndapan', 'skorKondisiTanggul', 'skorSekatBaffle', 'skorPelimpahSpillway',
         'skorFasilitasDosing', 'skorKualitasAirFisik', 'skorTitikPenaatanDebit', 'skorRambuPengaman'].forEach(param => {
            document.getElementById(param).value = 100;
            document.querySelectorAll(`.btn-score-card[data-param="${param}"]`).forEach(b => {
                if (b.dataset.val === "100") b.classList.add('active');
                else b.classList.remove('active');
            });
        });

        calcLiveScore();
        new bootstrap.Modal(document.getElementById('spiInputModal')).show();
    }

    function editReport(id) {
        fetch(`/Spi/GetDetail?id=${id}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('reportId').value = data.id;
                document.getElementById('modalFormTitle').innerText = 'Edit Laporan SPI #' + data.id;
                const newBadge = document.getElementById('modalNewBadge');
                if (newBadge) newBadge.classList.add('d-none');
                document.getElementById('inputTanggal').value = data.tanggal;
                document.getElementById('inputWaktu').value = data.waktu;
                document.getElementById('inputShift').value = data.shift || 'Day';
                document.getElementById('inputArea').value = data.area || '';
                document.getElementById('inputLokasi').value = data.lokasi || '';
                document.getElementById('inputNamaKolam').value = data.namaKolam || '';
                document.getElementById('inputTitikPenaatan').value = data.titikPenaatan || '';
                document.getElementById('inputDetilLokasi').value = data.detilLokasi || '';
                document.getElementById('inputLat').value = data.latitude || '';
                document.getElementById('inputLong').value = data.longitude || '';
                if (data.latitude && data.longitude) {
                    document.getElementById('inputGps').value = `${data.latitude}, ${data.longitude}`;
                } else {
                    document.getElementById('inputGps').value = '';
                }

                document.getElementById('inputCatatan').value = data.catatan || '';
                document.getElementById('inputTindakan').value = data.tindakanPerbaikan || '';
                document.getElementById('inputPic').value = data.pic || '';

                if (data.fotoUrl) {
                    document.getElementById('photoPreviewImg').src = data.fotoUrl;
                    document.getElementById('photoPreviewWrap').classList.remove('d-none');
                } else {
                    document.getElementById('photoPreviewWrap').classList.add('d-none');
                }

                // Set score values
                const scoreMap = {
                    'skorKapasitasEndapan': data.skorKapasitasEndapan,
                    'skorKondisiTanggul': data.skorKondisiTanggul,
                    'skorSekatBaffle': data.skorSekatBaffle,
                    'skorPelimpahSpillway': data.skorPelimpahSpillway,
                    'skorFasilitasDosing': data.skorFasilitasDosing,
                    'skorKualitasAirFisik': data.skorKualitasAirFisik,
                    'skorTitikPenaatanDebit': data.skorTitikPenaatanDebit,
                    'skorRambuPengaman': data.skorRambuPengaman
                };

                for (let param in scoreMap) {
                    const val = scoreMap[param] || 100;
                    document.getElementById(param).value = val;
                    document.querySelectorAll(`.btn-score-card[data-param="${param}"]`).forEach(b => {
                        if (parseInt(b.dataset.val) === val) b.classList.add('active');
                        else b.classList.remove('active');
                    });
                }

                calcLiveScore();
                new bootstrap.Modal(document.getElementById('spiInputModal')).show();
            })
            .catch(err => alert('Gagal memuat data laporan: ' + err));
    }

    let currentDetailData = null;

    function openDetailModal(id) {
        fetch(`/Spi/GetDetail?id=${id}`)
            .then(res => res.json())
            .then(data => {
                currentDetailData = data;
                document.getElementById('detailModalTitle').innerText = `Detail Inspeksi: ${data.namaKolam || data.lokasi} (#${data.id})`;

                let katBadge = data.kategoriIndex === "Baik" ? "badge bg-success" : (data.kategoriIndex === "Sedang" ? "badge bg-warning text-dark" : "badge bg-danger");

                let html = `
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            ${data.fotoUrl ? `<div style="max-height:280px; overflow:hidden; border-radius:12px; margin-bottom:12px;"><img src="${data.fotoUrl}" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='/img/placeholder-photo.png'"/></div>` : ''}
                            <div class="card p-3 bg-dark border-0">
                                <h6 class="text-white font-weight-bold mb-2">Informasi Umum</h6>
                                <p class="mb-1 text-muted" style="font-size:12px;">Tanggal: <span class="text-white">${data.tanggal} ${data.waktu}</span></p>
                                <p class="mb-1 text-muted" style="font-size:12px;">Kolam Sedimen: <span class="text-white font-weight-bold">${data.namaKolam || '-'}</span></p>
                                <p class="mb-1 text-muted" style="font-size:12px;">Titik Penaatan: <span class="text-white">${data.titikPenaatan || '-'}</span></p>
                                <p class="mb-1 text-muted" style="font-size:12px;">Lokasi / Area: <span class="text-white">${data.lokasi} (${data.area})</span></p>
                                <p class="mb-1 text-muted" style="font-size:12px;">Surveyor: <span class="text-white">${data.nama} (${data.nik})</span></p>
                                <p class="mb-1 text-muted" style="font-size:12px;">Perusahaan: <span class="text-white">${data.perusahaan || '-'}</span></p>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="card p-3 bg-dark border-0 mb-3 text-center">
                                <div class="text-muted" style="font-size:11px; text-transform:uppercase;">Skor Sediment Pond Index</div>
                                <h2 class="mb-1 mt-1 font-weight-bold" style="color: ${data.totalScore >= 85 ? '#10b981' : (data.totalScore >= 70 ? '#f59e0b' : '#f43f5e')};">${data.totalScore}%</h2>
                                <div><span class="${katBadge}">${data.kategoriIndex}</span></div>
                            </div>
                            <div class="card p-3 bg-dark border-0">
                                <h6 class="text-white font-weight-bold mb-2">Rincian 8 Parameter</h6>
                                <div style="font-size:11.5px;">
                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>1. Kapasitas Endapan (15%):</span> <strong>${data.skorKapasitasEndapan}/100</strong></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>2. Kondisi Tanggul (15%):</span> <strong>${data.skorKondisiTanggul}/100</strong></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>3. Sekat Baffle (15%):</span> <strong>${data.skorSekatBaffle}/100</strong></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>4. Pelimpah Spillway (15%):</span> <strong>${data.skorPelimpahSpillway}/100</strong></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>5. Fasilitas Dosing (10%):</span> <strong>${data.skorFasilitasDosing}/100</strong></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>6. Kualitas Air Fisik (10%):</span> <strong>${data.skorKualitasAirFisik}/100</strong></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>7. Titik Pantau Debit (10%):</span> <strong>${data.skorTitikPenaatanDebit}/100</strong></div>
                                    <div class="d-flex justify-content-between py-1"><span>8. Rambu &amp; Pengaman (10%):</span> <strong>${data.skorRambuPengaman}/100</strong></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="card p-3 bg-dark border-0">
                                <h6 class="text-white font-weight-bold mb-1">Catatan &amp; Rekomendasi</h6>
                                <p class="mb-1 text-muted" style="font-size:12px;">Catatan: <span class="text-white">${data.catatan || '-'}</span></p>
                                <p class="mb-1 text-muted" style="font-size:12px;">Rekomendasi: <span class="text-white">${data.tindakanPerbaikan || '-'}</span></p>
                                <p class="mb-0 text-muted" style="font-size:12px;">PIC: <span class="text-white">${data.pic || '-'}</span></p>
                            </div>
                        </div>
                    </div>
                `;

                document.getElementById('detailModalBody').innerHTML = html;
                new bootstrap.Modal(document.getElementById('spiDetailModal')).show();
            })
            .catch(err => alert('Gagal memuat detail laporan: ' + err));
    }

    function confirmDelete(id) {
        document.getElementById('deleteForm').action = '/Spi/Delete/' + id;
        new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
    }

    function previewPhoto(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('photoPreviewImg').src = e.target.result;
                document.getElementById('photoPreviewWrap').classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function getLiveGps() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                pos => {
                    const lat = pos.coords.latitude.toFixed(6);
                    const lng = pos.coords.longitude.toFixed(6);
                    document.getElementById('inputLat').value = lat;
                    document.getElementById('inputLong').value = lng;
                    document.getElementById('inputGps').value = `${lat}, ${lng}`;
                },
                err => {
                    document.getElementById('clientAlertTitle').innerText = 'Gagal Deteksi GPS';
                    document.getElementById('clientAlertMsg').innerText = 'Gagal mendapatkan koordinat: ' + err.message;
                    new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        } else {
            document.getElementById('clientAlertTitle').innerText = 'GPS Tidak Didukung';
            document.getElementById('clientAlertMsg').innerText = 'Browser perangkat Anda tidak mendukung Geolocation.';
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Wire score buttons click
        document.querySelectorAll('.btn-score-card').forEach(btn => {
            btn.addEventListener('click', function() {
                const param = this.dataset.param;
                const val = this.dataset.val;
                document.querySelectorAll(`.btn-score-card[data-param="${param}"]`).forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                document.getElementById(param).value = val;
                calcLiveScore();
            });
        });

        // WhatsApp Share button
        document.getElementById('btnShareDetailWa').addEventListener('click', function() {
            if (!currentDetailData) return;
            const d = currentDetailData;
            const text = `*LAPORAN SEDIMENT POND INDEX (SPI)*%0A%0A` +
                         `*Kolam:* ${d.namaKolam || '-' } (%0A` +
                         `*Titik Pantau:* ${d.titikPenaatan || '-' }%0A` +
                         `*Lokasi:* ${d.lokasi} (${d.area})%0A` +
                         `*Tanggal:* ${d.tanggal} ${d.waktu}%0A` +
                         `*Surveyor:* ${d.nama} (${d.nik})%0A%0A` +
                         `*Skor SPI:* ${d.totalScore}%25 (${d.kategoriIndex})%0A` +
                         `1. Kapasitas Endapan: ${d.skorKapasitasEndapan}/100%0A` +
                         `2. Kondisi Tanggul: ${d.skorKondisiTanggul}/100%0A` +
                         `3. Sekat Baffle: ${d.skorSekatBaffle}/100%0A` +
                         `4. Pelimpah Spillway: ${d.skorPelimpahSpillway}/100%0A` +
                         `5. Fasilitas Dosing: ${d.skorFasilitasDosing}/100%0A` +
                         `6. Kualitas Air Fisik: ${d.skorKualitasAirFisik}/100%0A` +
                         `7. Titik Pantau Debit: ${d.skorTitikPenaatanDebit}/100%0A` +
                         `8. Rambu & Pengaman: ${d.skorRambuPengaman}/100%0A%0A` +
                         `*Rekomendasi:* ${d.tindakanPerbaikan || '-'}%0A` +
                         `*PIC:* ${d.pic || '-'}`;
            window.open(`https://wa.me/?text=${text}`, '_blank');
        });

        // Show modals if TempData feedback exists
        const successModal = document.getElementById('statusSuccessModal');
        if (successModal) new bootstrap.Modal(successModal).show();

        const errorModal = document.getElementById('statusErrorModal');
        if (errorModal) new bootstrap.Modal(errorModal).show();
    });
</script>
}
