@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Display Pemenang & Executive Summary Liga SAP &mdash; PT INDEXIM COALINDO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Google Fonts: Poppins (Primary) & Futuristic Monospace / Display Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,600;1,800&family=Orbitron:wght@600;700;800;900&family=Chakra+Petch:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti for Celebration Effect -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

    <style>
    :root {
        --font-main:     'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-digit:    'Chakra Petch', 'Orbitron', monospace;
        --font-tech:     'Orbitron', 'Poppins', sans-serif;

        --bg-space:      #020612;
        --bg-surface:    rgba(11, 20, 38, 0.82);
        --bg-surface-hover: rgba(16, 29, 56, 0.95);
        --panel:         rgba(7, 14, 28, 0.92);
        --border-glass:  rgba(56, 189, 248, 0.18);
        --border-bright: rgba(0, 240, 255, 0.45);
        
        --text-pure:     #ffffff;
        --text-sub:      #e2e8f0;
        --text-muted:    #94a3b8;
        
        /* Futuristic Neon Palette */
        --gold:          #ffc700;
        --gold-glow:     0 0 25px rgba(255, 199, 0, 0.45);
        --emerald:       #00ff9d;
        --emerald-glow:  0 0 25px rgba(0, 255, 157, 0.45);
        --cyan:          #00f0ff;
        --cyan-glow:     0 0 25px rgba(0, 240, 255, 0.45);
        --ruby:          #ff2a5f;
        --ruby-glow:     0 0 25px rgba(255, 42, 95, 0.45);
        --violet:        #a855f7;
        --blue-electric: #38bdf8;
        
        --radius:        18px;
    }

    html { background: var(--bg-space); color-scheme: dark; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: var(--bg-space);
        background-image: 
            radial-gradient(rgba(0, 240, 255, 0.05) 1px, transparent 1px),
            radial-gradient(circle at 10% 10%, rgba(0, 240, 255, 0.12) 0%, transparent 40%),
            radial-gradient(circle at 90% 10%, rgba(255, 199, 0, 0.10) 0%, transparent 40%),
            radial-gradient(circle at 50% 90%, rgba(0, 255, 157, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 85% 65%, rgba(255, 42, 95, 0.09) 0%, transparent 40%);
        background-size: 32px 32px, 100% 100%, 100% 100%, 100% 100%, 100% 100%;
        font-family: var(--font-main);
        color: var(--text-pure);
        min-height: 100vh;
        overflow-x: hidden;
        position: relative;
    }

    /* ── Progress Bar Top (for Auto Presentation) ── */
    .slide-progress-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.06);
        z-index: 9999;
    }
    .slide-progress-bar {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, var(--gold), var(--emerald), var(--cyan), var(--ruby));
        box-shadow: 0 0 16px var(--cyan);
        transition: width 0.3s linear;
    }

    /* ── Main App Wrapper ── */
    .summary-app {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        padding: 16px 22px 24px 22px;
        gap: 16px;
        max-width: 1850px;
        margin: 0 auto;
    }

    /* ── Top Futuristic Header ── */
    .hdr-bar {
        background: var(--panel);
        border: 1px solid var(--border-glass);
        border-radius: var(--radius);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        padding: 14px 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), inset 0 1px 2px rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
        gap: 14px;
        position: relative;
        overflow: hidden;
    }
    .hdr-bar::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--cyan), var(--gold), var(--emerald), transparent);
    }

    .hdr-brand {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .hdr-brand-logo {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(255, 199, 0, 0.2), rgba(0, 240, 255, 0.25));
        border: 1.5px solid var(--border-bright);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: var(--gold);
        box-shadow: var(--gold-glow);
        animation: pulseLogo 3s infinite alternate;
    }
    @@keyframes pulseLogo {
        0% { transform: scale(1); box-shadow: 0 0 15px rgba(255, 199, 0, 0.3); }
        100% { transform: scale(1.05); box-shadow: 0 0 30px rgba(0, 240, 255, 0.6); }
    }

    .hdr-title-group h1 {
        font-size: 21px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .hdr-title-group .hdr-sub {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: 2px;
    }

    /* Header Controls */
    .hdr-controls {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .period-picker {
        display: flex;
        align-items: center;
        background: rgba(15, 25, 48, 0.9);
        border: 1px solid var(--border-bright);
        border-radius: 30px;
        padding: 5px 14px;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(0, 240, 255, 0.15);
    }
    .period-picker select {
        background: transparent;
        border: none;
        color: #ffffff;
        font-family: var(--font-main);
        font-weight: 700;
        font-size: 13px;
        outline: none;
        cursor: pointer;
        padding: 2px 4px;
    }
    .period-picker select option {
        background: #0b1426;
        color: #fff;
    }

    .btn-ctrl {
        background: rgba(15, 25, 48, 0.9);
        border: 1px solid var(--border-glass);
        border-radius: 30px;
        color: var(--text-sub);
        font-family: var(--font-main);
        font-weight: 700;
        font-size: 12px;
        padding: 7px 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-ctrl:hover {
        background: rgba(0, 240, 255, 0.2);
        border-color: var(--cyan);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: var(--cyan-glow);
    }
    .btn-ctrl.active {
        background: rgba(0, 255, 157, 0.25);
        border-color: var(--emerald);
        color: var(--emerald);
        box-shadow: var(--emerald-glow);
    }

    .live-clock {
        font-family: var(--font-tech);
        font-size: 15px;
        font-weight: 800;
        color: var(--cyan);
        background: rgba(0, 240, 255, 0.1);
        border: 1px solid rgba(0, 240, 255, 0.35);
        border-radius: 30px;
        padding: 6px 16px;
        letter-spacing: 1.5px;
        box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
    }

    /* ── Section Title ── */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 4px;
        margin-bottom: 2px;
        padding: 0 4px;
    }
    .section-header h2 {
        font-size: 16px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }
    .period-tag-pill {
        background: linear-gradient(135deg, rgba(255, 199, 0, 0.2), rgba(0, 240, 255, 0.2));
        border: 1px solid var(--border-bright);
        color: var(--text-pure);
        font-family: var(--font-main);
        font-size: 12px;
        font-weight: 800;
        padding: 5px 14px;
        border-radius: 20px;
        letter-spacing: 0.8px;
        box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
    }

    /* ── PODIUM OF CHAMPIONS (THE 3 WINNER CARDS) ── */
    .podium-title {
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--gold);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }
    .podium-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 8px;
    }
    @@media (max-width: 1200px) {
        .podium-grid { grid-template-columns: 1fr; }
    }

    .winner-card {
        background: linear-gradient(145deg, rgba(16, 29, 56, 0.9), rgba(9, 16, 31, 0.95));
        border-radius: var(--radius);
        padding: 20px 22px;
        backdrop-filter: blur(20px);
        position: relative;
        overflow: hidden;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        gap: 14px;
        border: 1.5px solid var(--card-accent-border, var(--border-bright));
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), var(--card-glow, none);
    }
    .winner-card:hover {
        transform: translateY(-4px) scale(1.01);
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.8), var(--card-glow-hover, none);
    }
    .winner-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: var(--card-accent-color, var(--gold));
    }

    /* Card Top Bar */
    .card-meta-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }
    .winner-trophy-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--card-accent-color, #fff);
    }
    .winner-rank-tag {
        font-family: var(--font-tech);
        font-size: 11px;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        background: var(--tag-bg, rgba(255, 199, 0, 0.2));
        color: var(--tag-text, #ffc700);
        border: 1px solid var(--tag-border, #ffc700);
    }

    /* Card Center Body */
    .winner-body {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
    }
    .entity-primary-name {
        font-family: var(--font-tech);
        font-size: 26px;
        font-weight: 900;
        color: #ffffff;
        letter-spacing: 0.5px;
        line-height: 1.1;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    }
    .entity-full-desc {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-sub);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-top: 4px;
    }
    .entity-context-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* Score Callout */
    .score-gauge {
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }
    .score-big-num {
        font-family: var(--font-digit);
        font-size: 36px;
        font-weight: 800;
        color: var(--card-accent-color, #fff);
        line-height: 1;
        text-shadow: 0 0 20px var(--card-accent-color, rgba(255,255,255,0.4));
    }
    .score-ratio-text {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
        margin-top: 4px;
    }

    /* Progress Track */
    .progress-track-neo {
        width: 100%;
        height: 7px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        overflow: hidden;
    }
    .progress-fill-neo {
        height: 100%;
        border-radius: 6px;
        background: var(--card-accent-color, var(--gold));
        box-shadow: 0 0 12px var(--card-accent-color, var(--gold));
        transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .winner-comment-box {
        font-size: 12px;
        color: var(--text-sub);
        background: rgba(0, 0, 0, 0.35);
        padding: 8px 12px;
        border-radius: 10px;
        border-left: 3px solid var(--card-accent-color, var(--gold));
        line-height: 1.45;
        font-weight: 500;
    }

    /* ── EVALUATION / LOWEST SECTION (3 WARNING CARDS) ── */
    .eval-title {
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--ruby);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        margin-bottom: 8px;
    }
    .eval-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 12px;
    }
    @@media (max-width: 1200px) {
        .eval-grid { grid-template-columns: 1fr; }
    }

    .eval-card {
        background: linear-gradient(145deg, rgba(28, 14, 24, 0.85), rgba(12, 10, 20, 0.95));
        border: 1.5px solid rgba(255, 42, 95, 0.35);
        border-radius: var(--radius);
        padding: 18px 20px;
        backdrop-filter: blur(20px);
        position: relative;
        overflow: hidden;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    }
    .eval-card:hover {
        transform: translateY(-3px);
        border-color: var(--ruby);
        box-shadow: 0 16px 40px rgba(255, 42, 95, 0.25);
    }
    .eval-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: var(--ruby);
    }

    /* Winner Colors */
    .card-gold {
        --card-accent-color: var(--gold);
        --card-accent-border: rgba(255, 199, 0, 0.5);
        --card-glow: 0 0 25px rgba(255, 199, 0, 0.2);
        --card-glow-hover: 0 0 40px rgba(255, 199, 0, 0.4);
        --tag-bg: rgba(255, 199, 0, 0.2);
        --tag-text: #ffc700;
        --tag-border: #ffc700;
    }
    .card-emerald {
        --card-accent-color: var(--emerald);
        --card-accent-border: rgba(0, 255, 157, 0.5);
        --card-glow: 0 0 25px rgba(0, 255, 157, 0.2);
        --card-glow-hover: 0 0 40px rgba(0, 255, 157, 0.4);
        --tag-bg: rgba(0, 255, 157, 0.2);
        --tag-text: #00ff9d;
        --tag-border: #00ff9d;
    }
    .card-cyan {
        --card-accent-color: var(--cyan);
        --card-accent-border: rgba(0, 240, 255, 0.5);
        --card-glow: 0 0 25px rgba(0, 240, 255, 0.2);
        --card-glow-hover: 0 0 40px rgba(0, 240, 255, 0.4);
        --tag-bg: rgba(0, 240, 255, 0.2);
        --tag-text: #00f0ff;
        --tag-border: #00f0ff;
    }

    /* ── Tab Navigation ── */
    .summary-tabs {
        display: flex;
        gap: 10px;
        background: rgba(11, 20, 38, 0.7);
        padding: 6px 8px;
        border-radius: 40px;
        border: 1px solid var(--border-glass);
        width: fit-content;
        align-self: center;
        flex-wrap: wrap;
        justify-content: center;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        margin-top: 4px;
    }
    .tab-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-family: var(--font-main);
        font-weight: 700;
        font-size: 13px;
        padding: 9px 22px;
        border-radius: 30px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .tab-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.06);
    }
    .tab-btn.active {
        background: linear-gradient(135deg, rgba(0, 240, 255, 0.3), rgba(0, 255, 157, 0.3));
        border: 1.5px solid var(--cyan);
        color: #ffffff;
        box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
    }

    /* ── Tab Panes & Table View ── */
    .tab-pane-content {
        display: none;
        animation: fadeInTab 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .tab-pane-content.active {
        display: block;
    }

    @@keyframes fadeInTab {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .table-card {
        background: var(--panel);
        border: 1px solid var(--border-glass);
        border-radius: var(--radius);
        padding: 18px 24px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }

    .table-hdr-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .table-hdr-row h3 {
        font-size: 17px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .table-search-box {
        background: rgba(15, 25, 48, 0.9);
        border: 1px solid var(--border-bright);
        border-radius: 25px;
        padding: 6px 16px;
        color: #fff;
        font-family: var(--font-main);
        font-size: 13px;
        outline: none;
        width: 240px;
        transition: width 0.3s ease;
    }
    .table-search-box:focus {
        width: 300px;
        box-shadow: var(--cyan-glow);
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 6px;
    }
    .custom-table th {
        background: rgba(15, 25, 48, 0.7);
        color: var(--text-muted);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border-glass);
    }
    .custom-table td {
        background: rgba(11, 20, 38, 0.6);
        color: var(--text-sub);
        font-size: 13px;
        font-weight: 600;
        padding: 12px 16px;
        vertical-align: middle;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }
    .custom-table tr:hover td {
        background: rgba(20, 35, 68, 0.85);
    }
    .custom-table tr td:first-child {
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
    }
    .custom-table tr td:last-child {
        border-top-right-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    /* Rank Number Badges */
    .rank-num {
        font-family: var(--font-digit);
        font-weight: 900;
        font-size: 15px;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #cbd5e1;
    }
    .rank-1 {
        background: linear-gradient(135deg, rgba(255, 199, 0, 0.35), rgba(245, 158, 11, 0.45));
        border-color: var(--gold);
        color: var(--gold);
        box-shadow: var(--gold-glow);
    }
    .rank-2 {
        background: linear-gradient(135deg, rgba(226, 232, 240, 0.25), rgba(148, 163, 184, 0.35));
        border-color: #e2e8f0;
        color: #ffffff;
    }
    .rank-3 {
        background: linear-gradient(135deg, rgba(217, 119, 6, 0.25), rgba(180, 83, 9, 0.35));
        border-color: #d97706;
        color: #f59e0b;
    }

    .pct-bar-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .pct-bar-track {
        flex: 1;
        height: 8px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        overflow: hidden;
        min-width: 90px;
    }
    .pct-bar-fill {
        height: 100%;
        border-radius: 4px;
    }
    .pct-label {
        font-family: var(--font-digit);
        font-weight: 800;
        font-size: 15px;
        min-width: 52px;
        text-align: right;
    }

    /* Overall Statistics Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 16px;
    }
    @@media (max-width: 992px) {
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .stat-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-glass);
        border-radius: var(--radius);
