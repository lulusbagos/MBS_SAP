    <script>
        let currentTabList = ['tabMitra', 'tabDept', 'tabSubcon', 'tabOverview'];
        let currentTabIndex = 0;
        let isAutoCycle = false;
        let countdownTimer = null;
        let secondsRemaining = 20;
        const CYCLE_SECONDS = 20;

        // Digital Clock
        function updateClock() {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            const s = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('liveClock').textContent = `${h}:${m}:${s}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Celebration Confetti
        function fireConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 80,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: ['#ffc700', '#00ff9d', '#00f0ff', '#ffffff']
                });
            }
        }

        // Switch Tab
        function switchTab(tabId, el) {
            $('.tab-pane-content').removeClass('active');
            $('.tab-btn').removeClass('active');
            $(`#${tabId}`).addClass('active');
            if (el) $(el).addClass('active');

            currentTabIndex = currentTabList.indexOf(tabId);
            resetCycleTimer();
        }

        // Auto Cycle (for TV Display)
        function toggleAutoCycle() {
            isAutoCycle = !isAutoCycle;
            const btn = document.getElementById('btnAutoPlay');
            const status = document.getElementById('autoPlayStatus');
            if (isAutoCycle) {
                btn.classList.add('active');
                status.textContent = 'ON';
                startCycle();
            } else {
                btn.classList.remove('active');
                status.textContent = 'OFF';
                stopCycle();
            }
        }

        function startCycle() {
            stopCycle();
            secondsRemaining = CYCLE_SECONDS;
            countdownTimer = setInterval(() => {
                secondsRemaining--;
                let pct = ((CYCLE_SECONDS - secondsRemaining) / CYCLE_SECONDS) * 100;
                document.getElementById('slideProgressBar').style.width = pct + '%';
                if (secondsRemaining <= 0) {
                    currentTabIndex = (currentTabIndex + 1) % currentTabList.length;
                    const nextTabId = currentTabList[currentTabIndex];
                    const tabButtons = document.querySelectorAll('.tab-btn');
                    switchTab(nextTabId, tabButtons[currentTabIndex]);
                    secondsRemaining = CYCLE_SECONDS;
                }
            }, 1000);
        }

        function stopCycle() {
            if (countdownTimer) clearInterval(countdownTimer);
            document.getElementById('slideProgressBar').style.width = '0%';
        }

        function resetCycleTimer() {
            if (isAutoCycle) {
                secondsRemaining = CYCLE_SECONDS;
                document.getElementById('slideProgressBar').style.width = '0%';
            }
        }

        // Fullscreen Toggle
        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => console.log(err));
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        // Filter Table rows
        function filterTable(input, tableId) {
            const query = input.value.toLowerCase();
            $(`#${tableId} tbody tr`).each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(query) > -1);
            });
        }

        function onPeriodChange() {
            loadSummaryData();
        }

        // Load Data from API
        function loadSummaryData() {
            const year = document.getElementById('selectYear').value;
            const month = document.getElementById('selectMonth').value;

            document.getElementById('loadingOverlay').classList.remove('hidden');

            $.ajax({
                url: `/Display/GetDisplaySummaryData?year=${year}&month=${month}`,
                type: 'GET',
                dataType: 'json',
                success: function(res) {
                    document.getElementById('loadingOverlay').classList.add('hidden');
                    if (res && res.success) {
                        renderSummary(res);
                        fireConfetti();
                    } else {
                        alert('Gagal memuat data: ' + (res ? res.error : 'Unknown error'));
                    }
                },
                error: function(err) {
                    document.getElementById('loadingOverlay').classList.add('hidden');
                    console.error(err);
                }
            });
        }

        function renderSummary(data) {
            const p = data.period;
            document.getElementById('periodBadge').textContent = `PERIODE: ${p.formatted.toUpperCase()}`;

            const h = data.highlights;

            // 1. Mitra Inti Terbaik
            const mb = h.mitraInti.terbaik;
            document.getElementById('cardCodeMitraBest').textContent = mb.code;
            document.getElementById('cardNameMitraBest').textContent = mb.name;
            document.getElementById('cardRankMitraBest').textContent = `RANK #${mb.rank} DARI ${data.coreStandings.length} MITRA INTI`;
            document.getElementById('cardPctMitraBest').textContent = mb.achievementRate.toFixed(1) + '%';
            document.getElementById('cardRatioMitraBest').textContent = `${mb.totalActual.toLocaleString()} / ${mb.totalTarget.toLocaleString()}`;
            document.getElementById('cardBarMitraBest').style.width = mb.achievementRate + '%';
            document.getElementById('cardNoteMitraBest').textContent = mb.note;

            // 2. Mitra Inti Terburuk
            const mw = h.mitraInti.terburuk;
            document.getElementById('cardCodeMitraWorst').textContent = mw.code;
            document.getElementById('cardNameMitraWorst').textContent = mw.name;
            document.getElementById('cardRankMitraWorst').textContent = `RANK #${mw.rank} (TERBAWAH AKTIF)`;
            document.getElementById('cardPctMitraWorst').textContent = mw.achievementRate.toFixed(1) + '%';
            document.getElementById('cardRatioMitraWorst').textContent = `${mw.totalActual.toLocaleString()} / ${mw.totalTarget.toLocaleString()}`;
            document.getElementById('cardBarMitraWorst').style.width = mw.achievementRate + '%';
            document.getElementById('cardNoteMitraWorst').textContent = mw.note;

            // 3. Dept IC Terbaik
            const db = h.deptIC.terbaik;
            document.getElementById('cardCodeDeptBest').textContent = db.name;
            document.getElementById('cardNameDeptBest').textContent = `DEPARTEMEN ${db.name}`;
            document.getElementById('cardRankDeptBest').textContent = `RANK #${db.rank} DARI ${data.deptStandings.length} DEPT IC`;
            document.getElementById('cardPctDeptBest').textContent = db.achievementRate.toFixed(1) + '%';
            document.getElementById('cardRatioDeptBest').textContent = `${db.totalActual.toLocaleString()} / ${db.totalTarget.toLocaleString()}`;
            document.getElementById('cardBarDeptBest').style.width = db.achievementRate + '%';
            document.getElementById('cardNoteDeptBest').textContent = db.note;

            // 4. Dept IC Terburuk
            const dw = h.deptIC.terburuk;
            document.getElementById('cardCodeDeptWorst').textContent = dw.name;
            document.getElementById('cardNameDeptWorst').textContent = `DEPT ${dw.name}`;
            document.getElementById('cardRankDeptWorst').textContent = `RANK #${dw.rank} (TERENDAH AKTIF)`;
            document.getElementById('cardPctDeptWorst').textContent = dw.achievementRate.toFixed(1) + '%';
            document.getElementById('cardRatioDeptWorst').textContent = `${dw.totalActual.toLocaleString()} / ${dw.totalTarget.toLocaleString()}`;
            document.getElementById('cardBarDeptWorst').style.width = dw.achievementRate + '%';
            document.getElementById('cardNoteDeptWorst').textContent = dw.note;

            // 5. Subkont Terbaik
            const sb = h.subkont.terbaik;
            document.getElementById('cardCodeSubBest').textContent = sb.code;
            document.getElementById('cardNameSubBest').textContent = sb.name;
            document.getElementById('cardRankSubBest').textContent = `VENDOR INDUK: ${sb.parentCode} &bull; SAMUDERA 100%`;
            document.getElementById('cardPctSubBest').textContent = sb.achievementRate.toFixed(1) + '%';
            document.getElementById('cardRatioSubBest').textContent = `${sb.totalActual.toLocaleString()} / ${sb.totalTarget.toLocaleString()}`;
            document.getElementById('cardBarSubBest').style.width = sb.achievementRate + '%';
            document.getElementById('cardNoteSubBest').textContent = sb.note;

            // 6. Subkont Terburuk
            const sw = h.subkont.terburuk;
            document.getElementById('cardCodeSubWorst').textContent = sw.code;
            document.getElementById('cardNameSubWorst').textContent = sw.name;
            document.getElementById('cardRankSubWorst').textContent = `SUBKONT INDUK: ${sw.parentCode}`;
            document.getElementById('cardPctSubWorst').textContent = sw.achievementRate.toFixed(1) + '%';
            document.getElementById('cardRatioSubWorst').textContent = `${sw.totalActual.toLocaleString()} / ${sw.totalTarget.toLocaleString()}`;
            document.getElementById('cardBarSubWorst').style.width = sw.achievementRate + '%';
            document.getElementById('cardNoteSubWorst').textContent = sw.note;

            // Render Tables
            renderCoreTable(data.coreStandings);
            renderDeptTable(data.deptStandings);
            renderSubconTable(data.subconStandings);

            // Render Overview
            const s = data.statistics;
            document.getElementById('statEmployees').textContent = s.totalEmployees.toLocaleString();
            document.getElementById('statCompanies').textContent = s.totalCompanies.toLocaleString();
            document.getElementById('statTarget').textContent = s.grandTotalTarget.toLocaleString();
            document.getElementById('statCompliance').textContent = s.overallCompliance.toFixed(1) + '%';

            renderPillarsGrid(s.pillars);
        }

        function renderCoreTable(list) {
            let html = '';
            list.forEach(c => {
                const rankClass = c.rank === 1 ? 'rank-1' : (c.rank === 2 ? 'rank-2' : (c.rank === 3 ? 'rank-3' : ''));
                const color = c.achievementRate >= 80 ? 'var(--emerald)' : (c.achievementRate >= 50 ? 'var(--cyan)' : (c.achievementRate > 0 ? 'var(--gold)' : 'var(--ruby)'));

                html += `
                <tr>
                    <td><div class="rank-num ${rankClass}">#${c.rank}</div></td>
                    <td><span style="font-family:var(--font-tech); font-weight:800; color:#fff;">${c.companyCode}</span></td>
                    <td>
                        <div style="font-weight:700; color:#fff;">${c.companyName}</div>
                    </td>
                    <td><span style="color:var(--text-muted); font-size:12px;">${c.pjoName || '-'}</span></td>
                    <td style="text-align:center;">${c.employeeCount}</td>
                    <td style="text-align:center; font-family:var(--font-digit); font-weight:700;">
                        ${c.totalActual.toLocaleString()} / ${c.totalTarget.toLocaleString()}
                    </td>
                    <td>
                        <div class="pct-bar-wrap">
                            <div class="pct-bar-track">
                                <div class="pct-bar-fill" style="width:${c.achievementRate}%; background:${color}; box-shadow:0 0 8px ${color};"></div>
                            </div>
                            <div class="pct-label" style="color:${color};">${c.achievementRate.toFixed(1)}%</div>
                        </div>
                    </td>
                    <td style="text-align:center;">
                        <span class="winner-rank-tag" style="background:${c.statusColor}22; color:${c.statusColor}; border:1px solid ${c.statusColor}55;">
                            ${c.statusBadge}
                        </span>
                    </td>
                </tr>`;
            });
            document.getElementById('tbodyMitra').innerHTML = html;
        }

