<script>
/* ──────────────────────────────────────────────────────────────────────────
   AUDIO SYNTHESIZER & REAL VOICE NOTIFICATIONS
   ────────────────────────────────────────────────────────────────────────── */
const defaultSound = new Audio('/notifikasi/freesound_community-plopp-84863.mp3');
defaultSound.preload = 'auto';

const customSounds = {
    'hazard': new Audio('/notifikasi/laporan hazard baru telah masuk.MP3'),
    'inspection': new Audio('/notifikasi/LAPORAN INSPEKSI BARU TELAH MASUK.MP3'),
    'inspeksi': new Audio('/notifikasi/LAPORAN INSPEKSI BARU TELAH MASUK.MP3'),
    'safetytalk': new Audio('/notifikasi/SAEFTY TALK.MP3'),
    'p5m': new Audio('/notifikasi/P5M.MP3'),
    'observation': new Audio('/notifikasi/OBSERVASI.MP3'),
    'coaching': new Audio('/notifikasi/COACHING.MP3')
};

defaultSound.volume = 0.05;
defaultSound.load();
for (const key in customSounds) {
    customSounds[key].preload = 'auto';
    customSounds[key].volume = key === 'hazard' ? 0.2 : 0.05;
    customSounds[key].load();
}

function beep(type) {
    let activeSound = defaultSound;
    if (type && customSounds[type.toLowerCase()]) {
        activeSound = customSounds[type.toLowerCase()];
    }
    activeSound.currentTime = 0;
    activeSound.play()
        .then(() => {
            const badge = document.getElementById('audioUnlockBadge');
            if (badge) badge.style.display = 'none';
        })
        .catch(e => {
            console.warn("Failed to play sound: ", e);
            const badge = document.getElementById('audioUnlockBadge');
            if (badge) badge.style.display = 'flex';
        });
}

function unlockAudio() {
    defaultSound.currentTime = 0;
    defaultSound.play()
        .then(() => console.log("Default sound unlocked."))
        .catch(e => console.warn(e));
        
    for (const key in customSounds) {
        const sound = customSounds[key];
        const origVolume = sound.volume;
        sound.volume = 0;
        sound.play()
            .then(() => {
                sound.pause();
                sound.volume = origVolume;
                sound.currentTime = 0;
            })
            .catch(e => console.warn(e));
    }
    const badge = document.getElementById('audioUnlockBadge');
    if (badge) badge.style.display = 'none';
}

function checkAutoplay() {
    const origVol = defaultSound.volume;
    defaultSound.volume = 0;
    defaultSound.play()
        .then(() => {
            defaultSound.pause();
            defaultSound.volume = origVol;
            defaultSound.currentTime = 0;
            const badge = document.getElementById('audioUnlockBadge');
            if (badge) badge.style.display = 'none';
        })
        .catch(err => {
            defaultSound.volume = origVol;
            const badge = document.getElementById('audioUnlockBadge');
            if (badge) badge.style.display = 'flex';
        });
}
document.addEventListener('DOMContentLoaded', () => {
    checkAutoplay();

    const badge = document.getElementById('audioUnlockBadge');
    if (badge) {
        badge.addEventListener('click', (e) => {
            e.stopPropagation();
            unlockAudio();
        });
    }

    // Unlock on the very first interaction anywhere on the page
    const unlockEvents = ['click', 'keydown', 'mousedown', 'pointerdown', 'touchstart'];
    function unlockOnFirstInteraction() {
        unlockAudio();
        unlockEvents.forEach(evt => document.removeEventListener(evt, unlockOnFirstInteraction));
    }
    unlockEvents.forEach(evt => document.addEventListener(evt, unlockOnFirstInteraction, { once: true }));
});

/* ──────────────────────────────────────────────────────────────────────────
   LIVE FEED LISTENER & ACTIVITY POPUP TRIGGER
   ────────────────────────────────────────────────────────────────────────── */
let lastTopKey = '';
let isFirstFeedLoad = true;

function getCardBackupBgAndIcon(type) {
    const t = (type || '').toLowerCase();
    if (t === 'hazard') return { bg: 'rgba(239, 68, 68, 0.2)', color: '#ef4444', icon: 'bi-exclamation-triangle-fill' };
    if (t === 'inspection' || t === 'inspeksi') return { bg: 'rgba(56, 189, 248, 0.2)', color: '#38bdf8', icon: 'bi-clipboard2-check-fill' };
    if (t === 'safetytalk') return { bg: 'rgba(168, 85, 247, 0.2)', color: '#a855f7', icon: 'bi-megaphone-fill' };
    if (t === 'p5m') return { bg: 'rgba(16, 185, 129, 0.2)', color: '#10b981', icon: 'bi-shield-fill-check' };
    if (t === 'observation') return { bg: 'rgba(20, 184, 166, 0.2)', color: '#14b8a6', icon: 'bi-binoculars-fill' };
    if (t === 'coaching') return { bg: 'rgba(245, 158, 11, 0.2)', color: '#f59e0b', icon: 'bi-person-video3' };
    return { bg: 'rgba(56, 189, 248, 0.2)', color: '#38bdf8', icon: 'bi-activity' };
}

function triggerNewAlert(item) {
    beep(item.type || '');
    
    // Screen Flash Anim
    const f = document.getElementById('screenFlash');
    if (f) {
        f.classList.add('flash'); 
        setTimeout(() => f.classList.remove('flash'), 1200);
    }

    const colors = {
        'hazard': '#ef4444',
        'inspection': '#38bdf8',
        'inspeksi': '#38bdf8',
        'safetytalk': '#a855f7',
        'p5m': '#10b981',
        'observation': '#14b8a6',
        'coaching': '#f59e0b'
    };
    const notifColor = colors[(item.type || '').toLowerCase()] || '#38bdf8';

    // Populate data
    const hdr = document.getElementById('notifTypeHeader');
    if (hdr) hdr.innerText = `Laporan K3 Baru: ${(item.type || 'Kegiatan').toUpperCase()}`;
    
    const uloc = document.getElementById('notifUserLoc');
    if (uloc) {
        uloc.innerHTML = `<strong style="color:#fff;">${item.name || 'Karyawan'}</strong> (${item.nik || '-'}) &bull; <i class="bi bi-geo-alt-fill"></i> ${item.area || item.location || 'Site PT Indexim'}`;
    }

    const ttl = document.getElementById('notifTitle');
    if (ttl) ttl.innerText = item.title || 'Aktivitas K3';

    const desc = document.getElementById('notifDesc');
    const descText = item.description || item.konten || '';
    if (desc) desc.innerText = descText.length > 90 ? descText.substring(0, 90) + '...' : descText;

    const imgContainer = document.getElementById('notifImgContainer');
    const backup = getCardBackupBgAndIcon(item.type);
    if (imgContainer) {
        if (item.imageUrl) {
            imgContainer.innerHTML = `<img src="${item.imageUrl}" class="notif-card-img" 
                onerror="this.outerHTML='<div class=notif-card-noimg style=\\'background: ${backup.bg}; color: ${backup.color};\\'><i class=\\'bi ${backup.icon}\\'></i></div>'" />`;
        } else {
            imgContainer.innerHTML = `<div class="notif-card-noimg" style="background: ${backup.bg}; color: ${backup.color};"><i class="bi ${backup.icon}"></i></div>`;
        }
    }

    const p = document.getElementById('notifPopup');
    if (p) {
        p.style.border = `1px solid ${notifColor}`;
        p.style.boxShadow = `0 20px 50px rgba(0,0,0,0.8), 0 0 35px ${notifColor}4D`;

        const progressBar = document.getElementById('notifProgressBar');
        if (progressBar) {
            progressBar.style.transition = 'none';
            progressBar.style.width = '100%';
            progressBar.style.background = `linear-gradient(90deg, ${notifColor}, #fff)`;
        }

        p.classList.add('show');

        setTimeout(() => {
            if (progressBar) {
                progressBar.style.transition = 'width 6s linear';
                progressBar.style.width = '0%';
            }
        }, 50);

        setTimeout(() => {
            p.classList.remove('show');
        }, 6000);
    }
}

async function fetchFeed() {
    try {
        const res = await fetch('/Display/GetLatestFeed');
        if (!res.ok) return;
        const items = await res.json();
        if (!items || !items.length) return;

        const topKey = `${items[0].type}_${items[0].id}_${items[0].createdAt}`;
        if (topKey !== lastTopKey) {
            const hasNew = !isFirstFeedLoad && lastTopKey !== '';
            lastTopKey = topKey;
            if (hasNew) {
                triggerNewAlert(items[0]);
                fetchDisplay2Data();
            }
        }
        isFirstFeedLoad = false;
    } catch(e) {
        console.warn('Feed fetch error in Display 2:', e);
    }
}

/* ──────────────────────────────────────────────────────────────────────────
   1. REALTIME DIGITAL CLOCK
   ────────────────────────────────────────────────────────────────────────── */
function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    const s = String(now.getSeconds()).padStart(2, '0');
    document.getElementById('liveClock').innerText = `${h}:${m}:${s}`;

    const opts = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' };
    document.getElementById('liveDate').innerText = now.toLocaleDateString('id-ID', opts);
}
setInterval(updateClock, 1000);
updateClock();

/* ──────────────────────────────────────────────────────────────────────────
   2. 5-MINUTE AUTO SLIDE ROTATION (/Display2 -> /Display)
   ────────────────────────────────────────────────────────────────────────── */
const SLIDE_DURATION_SECONDS = 300; // 5 minutes = 300 seconds
let slideTimeRemaining = SLIDE_DURATION_SECONDS;
let isSlidePaused = false;

function updateSlideTimer() {
    if (isSlidePaused) return;

    slideTimeRemaining--;
    if (slideTimeRemaining < 0) {
        // Transition to Display 1
        window.location.href = '/Display';
        return;
    }

    const mins = Math.floor(slideTimeRemaining / 60);
    const secs = slideTimeRemaining % 60;
    document.getElementById('slideCountdown').innerText = 
        `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

    const progressPct = ((SLIDE_DURATION_SECONDS - slideTimeRemaining) / SLIDE_DURATION_SECONDS) * 100;
    document.getElementById('slideProgressBar').style.width = `${progressPct}%`;
}
setInterval(updateSlideTimer, 1000);

function togglePauseSlide() {
    isSlidePaused = !isSlidePaused;
    const icon = document.getElementById('pauseIcon');
    const text = document.getElementById('pauseText');
    if (isSlidePaused) {
        icon.className = 'bi bi-play-fill';
        text.innerText = 'Lanjut';
        document.getElementById('togglePauseBtn').style.background = 'rgba(239, 68, 68, 0.3)';
        document.getElementById('togglePauseBtn').style.borderColor = '#ef4444';
    } else {
        icon.className = 'bi bi-pause-fill';
        text.innerText = 'Jeda';
        document.getElementById('togglePauseBtn').style.background = 'rgba(255, 255, 255, 0.06)';
        document.getElementById('togglePauseBtn').style.borderColor = 'rgba(255, 255, 255, 0.12)';
    }
}

