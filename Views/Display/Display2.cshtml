/* ──────────────────────────────────────────────────────────────────────────
   4. DATA FETCH, AUTO TAB ROTATION & UI RENDERING
   ────────────────────────────────────────────────────────────────────────── */
let currentData = null;
let currentLeagueTab = 'core';

async function fetchDisplay2Data() {
    try {
        const res = await fetch('/Display/GetDisplay2Data');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (data && data.success) {
            currentData = data;
            renderAll(data);
        }
    } catch (e) {
        console.error('Error fetching Display2 data:', e);
    }
}

const TAB_ROTATION_SECONDS = 90; // 1.5 minutes = 90 seconds
let tabTimeRemaining = TAB_ROTATION_SECONDS;

function updateTabTimer() {
    tabTimeRemaining--;
    if (tabTimeRemaining < 0) {
        const nextTab = currentLeagueTab === 'core' ? 'all' : 'core';
        switchLeagueTab(nextTab, false);
        tabTimeRemaining = TAB_ROTATION_SECONDS;
    }
    const mins = Math.floor(tabTimeRemaining / 60);
    const secs = tabTimeRemaining % 60;
    const badge = document.getElementById('tabCountdown');
    if (badge) {
        badge.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
}
setInterval(updateTabTimer, 1000);

function switchLeagueTab(tab, resetTimer = true) {
    currentLeagueTab = tab;
    if (resetTimer) {
        tabTimeRemaining = TAB_ROTATION_SECONDS;
    }
    document.getElementById('tabCoreBtn').classList.toggle('active', tab === 'core');
    document.getElementById('tabAllBtn').classList.toggle('active', tab === 'all');
    
    document.getElementById('coreStandingsView').style.display = tab === 'core' ? 'flex' : 'none';
    document.getElementById('allStandingsView').style.display = tab === 'all' ? 'flex' : 'none';
    
    document.getElementById('leaguePanelTitle').innerText = 
        tab === 'core' ? 'Liga Safety Perusahaan Inti' : 'Klasemen Semua Kontraktor';

    if (currentData) {
        renderLeagueKPIs(currentData);
    }
}

function renderLeagueKPIs(data) {
    const stats = data.stats || {};
    const isCore = currentLeagueTab === 'core';

    const squadVal = isCore ? (stats.totalCoreSquad || '--') : (stats.totalAllSquad || '--');
    const avgVal = isCore ? (Number(stats.coreAvgPct || 0).toFixed(1)) : (Number(stats.allAvgPct || 0).toFixed(1));
    const greenVal = isCore ? (stats.coreChampionsCount || 0) : (stats.allChampionsCount || 0);
    const redVal = isCore ? (stats.coreRedCount || 0) : (stats.allRedCount || 0);

    const elSquad = document.getElementById('kpiSquadVal');
    if (elSquad) elSquad.innerText = `${squadVal} Org`;

    const elAvg = document.getElementById('kpiAvgVal');
    if (elAvg) elAvg.innerText = `${avgVal}%`;

    const elGreen = document.getElementById('kpiGreenVal');
    if (elGreen) elGreen.innerText = `${greenVal} Klub`;

    const elRed = document.getElementById('kpiRedVal');
    if (elRed) elRed.innerText = `${redVal} Klub`;

    const elTotalReal = document.getElementById('kpiTotalLapsVal');
    if (elTotalReal) {
        elTotalReal.innerText = `${stats.totalLapsReal || 0} / ${stats.totalLapsTarget || 0}`;
    }
}

function renderSectorLeaders(f1Teams) {
    if (!f1Teams || f1Teams.length === 0) return;

    // Sector 1: Hazard Leader
    const s1List = [...f1Teams].sort((a,b) => {
        const pA = a.sector1?.percentage ?? a.Sector1?.Percentage ?? a.hazard?.percentage ?? 0;
        const pB = b.sector1?.percentage ?? b.Sector1?.Percentage ?? b.hazard?.percentage ?? 0;
        return pB - pA;
    });
    if (s1List.length > 0) {
        const top1 = s1List[0];
        const name = top1.shortName || top1.ShortName || top1.teamCode || 'P1';
        const p = top1.sector1?.percentage ?? top1.Sector1?.Percentage ?? top1.hazard?.percentage ?? 0;
        document.getElementById('sec1LeaderVal').innerText = `${name} (${Number(p).toFixed(0)}%)`;
    }

    // Sector 2: Inspeksi & Talk Leader
    const s2List = [...f1Teams].sort((a,b) => {
        const pA = a.sector2?.percentage ?? a.Sector2?.Percentage ?? 0;
        const pB = b.sector2?.percentage ?? b.Sector2?.Percentage ?? 0;
        return pB - pA;
    });
    if (s2List.length > 0) {
        const top2 = s2List[0];
        const name = top2.shortName || top2.ShortName || top2.teamCode || 'P1';
        const p = top2.sector2?.percentage ?? top2.Sector2?.Percentage ?? 0;
        document.getElementById('sec2LeaderVal').innerText = `${name} (${Number(p).toFixed(0)}%)`;
    }

    // Sector 3: Coaching & Observasi Leader
    const s3List = [...f1Teams].sort((a,b) => {
        const pA = a.sector3?.percentage ?? a.Sector3?.Percentage ?? 0;
        const pB = b.sector3?.percentage ?? b.Sector3?.Percentage ?? 0;
        return pB - pA;
    });
    if (s3List.length > 0) {
        const top3 = s3List[0];
        const name = top3.shortName || top3.ShortName || top3.teamCode || 'P1';
        const p = top3.sector3?.percentage ?? top3.Sector3?.Percentage ?? 0;
        document.getElementById('sec3LeaderVal').innerText = `${name} (${Number(p).toFixed(0)}%)`;
    }
}

function renderAll(data) {
    renderMarquee(data.marqueeText);
    renderTopCards(data);
    renderLeagueKPIs(data);
    renderSectorLeaders(data.f1Teams || []);
    
    // Update tab counters
    const coreCount = data.totalCore || ((data.coreStandings?.length || 0) + (data.coreRedZone?.length || 0));
    const allCount = data.totalCompanies || ((data.leagueStandings?.length || 0) + (data.leagueRedZone?.length || 0));
    
    const coreBadge = document.getElementById('coreCountBadge');
    if (coreBadge) coreBadge.innerText = coreCount;
    
    const allBadge = document.getElementById('allCountBadge');
    if (allBadge) allBadge.innerText = allCount;

    // Render Football Standings Tables
    renderFootballTable('coreTableBody', data.coreStandings || [], data.coreRedZone || []);
    renderFootballTable('leagueTableBody', data.leagueStandings || [], data.leagueRedZone || []);

    // Render F1 Track, Winner Driver Profile & Paddock Fast Lane
    renderF1Circuit(data.f1Teams || []);
    renderDriverWinnerProfile(data.f1Teams || [], data.coreStandings || []);
    renderPaddockFastLane(data.fastestMitra || [], data.f1Teams || []);
}

function getCompanyInitials(name) {
    if (!name) return 'FC';
    let clean = name.replace(/^(PT|CV|UD|KOPERASI)\.?\s+/i, '').trim();
    const parts = clean.split(/\s+/);
    if (parts.length >= 2) {
        return (parts[0][0] + parts[1][0]).toUpperCase();
    }
    return clean.substring(0, 2).toUpperCase();
}

function getShieldGradient(companyId, companyName) {
    const nameUpper = (companyName || '').toUpperCase();
    if (nameUpper.includes('INDEXIM')) return ['#ff7b00', '#c2410c'];
    if (nameUpper.includes('KALIMANTAN PRIMA')) return ['#10b981', '#047857'];
    if (nameUpper.includes('UNGGUL')) return ['#eab308', '#ca8a04'];
    if (nameUpper.includes('MEG GLOBAL') || nameUpper.includes('MEGA GLOBAL')) return ['#00d2ff', '#0284c7'];
    if (nameUpper.includes('DAHANA')) return ['#3b82f6', '#1d4ed8'];
    if (nameUpper.includes('SUCOFINDO')) return ['#06b6d4', '#0e7490'];
    if (nameUpper.includes('ORICA')) return ['#8b5cf6', '#6d28d9'];
    if (nameUpper.includes('GANESHA')) return ['#ec4899', '#be185d'];
    if (nameUpper.includes('SURYA')) return ['#f97316', '#c2410c'];
    if (nameUpper.includes('BUMA')) return ['#10b981', '#065f46'];

    const palettes = [
        ['#0284c7', '#0369a1'],
        ['#059669', '#047857'],
        ['#d97706', '#b45309'],
        ['#7c3aed', '#6d28d9'],
        ['#db2777', '#be185d'],
        ['#dc2626', '#b91c1c'],
        ['#ea580c', '#c2410c'],
        ['#0891b2', '#0e7490'],
        ['#4f46e5', '#4338ca'],
        ['#16a34a', '#15803d']
    ];
    const idx = Math.abs((typeof companyId === 'number' ? companyId : 0) + (companyName ? companyName.length : 0)) % palettes.length;
    return palettes[idx];
}

function formatPillarCell(rate, target, real) {
    const val = Number(rate || 0);
    let color = '#64748b'; // default 0%
    if (val >= 100) color = '#34d399';
    else if (val >= 80) color = '#38bdf8';
    else if (val >= 40) color = '#fbbf24';
    else if (val > 0) color = '#f97316';
    else if (target > 0 && real === 0) color = '#ef4444';

    return `<div class="pillar-cell" style="color: ${color};" title="Target: ${target} | Real: ${real}">${val.toFixed(0)}%</div>`;
}

function formatFormDots(formArray) {
    if (!formArray || !Array.isArray(formArray)) {
        formArray = ['D','D','D','D','D'];
    }
    return formArray.slice(0, 5).map(f => {
        const char = (f || 'D').toUpperCase();
        let cls = 'dot-d';
        if (char === 'W') cls = 'dot-w';
        else if (char === 'L') cls = 'dot-l';
        return `<span class="league-form-dot ${cls}">${char}</span>`;
    }).join('');
}

/* ──────────────────────────────────────────────────────────────────────────
   5. RENDER PREMIER LEAGUE FOOTBALL STANDINGS TABLE (CORE & ALL MITRAS)
   ────────────────────────────────────────────────────────────────────────── */
function renderFootballTable(containerId, standings, redZone) {
    const container = document.getElementById(containerId);
    if (!container) return;

    if ((!standings || standings.length === 0) && (!redZone || redZone.length === 0)) {
        container.innerHTML = `<div style="text-align:center; padding: 40px; color: var(--muted); font-size:12px;">Tidak ada data klasemen liga untuk periode ini.</div>`;
        return;
    }

    let rowsHtml = '';

    // 1. Regular Standings Rows
    if (standings && standings.length > 0) {
        rowsHtml += standings.map((item, idx) => {
            const rank = item.rank ?? item.Rank ?? (idx + 1);
            const compId = item.companyId ?? item.CompanyId ?? idx;
            const compName = item.companyName ?? item.CompanyName ?? 'Perusahaan';
            const compCode = item.companyCode ?? item.CompanyCode ?? '';
            const pjoName = item.pjoName ?? item.PjoName ?? '';
            const isMaincon = item.isMaincon ?? item.IsMaincon ?? false;
            const empCount = item.employeeCount ?? item.EmployeeCount ?? '-';
            const target = item.target ?? item.Target ?? 0;
            const realization = item.realization ?? item.Realization ?? 0;
            const pct = Number(item.percentage ?? item.Percentage ?? 0);
            const form = item.form ?? item.Form ?? ['D','D','D','D','D'];

            // Pillar rates
            const hRate = item.mtdHazardRate ?? item.MtdHazardRate ?? item.hazard?.rate ?? item.Hazard?.Rate ?? 0;
            const iRate = item.mtdInspeksiRate ?? item.MtdInspeksiRate ?? item.inspeksi?.rate ?? item.Inspeksi?.Rate ?? 0;
            const stRate = item.mtdSafetyTalkRate ?? item.MtdSafetyTalkRate ?? item.safetyTalk?.rate ?? item.SafetyTalk?.Rate ?? 0;
            const oRate = item.mtdObservasiRate ?? item.MtdObservasiRate ?? item.observasi?.rate ?? item.Observasi?.Rate ?? 0;
            const cRate = item.mtdCoachingRate ?? item.MtdCoachingRate ?? item.coaching?.rate ?? item.Coaching?.Rate ?? 0;
            const p5Rate = item.mtdP5mRate ?? item.MtdP5mRate ?? item.p5m?.rate ?? item.P5m?.Rate ?? 0;

            const hTgt = item.hazard?.target ?? item.Hazard?.Target ?? 0;
            const hReal = item.hazard?.real ?? item.Hazard?.Real ?? 0;
            const iTgt = item.inspeksi?.target ?? item.Inspeksi?.Target ?? 0;
            const iReal = item.inspeksi?.real ?? item.Inspeksi?.Real ?? 0;
            const stTgt = item.safetyTalk?.target ?? item.SafetyTalk?.Target ?? 0;
            const stReal = item.safetyTalk?.real ?? item.SafetyTalk?.Real ?? 0;
            const oTgt = item.observasi?.target ?? item.Observasi?.Target ?? 0;
            const oReal = item.observasi?.real ?? item.Observasi?.Real ?? 0;
            const cTgt = item.coaching?.target ?? item.Coaching?.Target ?? 0;
            const cReal = item.coaching?.real ?? item.Coaching?.Real ?? 0;
            const p5Tgt = item.p5m?.target ?? item.P5m?.Target ?? 0;
            const p5Real = item.p5m?.real ?? item.P5m?.Real ?? 0;

            // Row CSS class & Rank Medals
            let rowCls = '';
            let rankBadge = `<span class="league-rank-pill">${rank}</span>`;
            if (rank === 1 && pct > 0) {
                rowCls = 'league-tr-champions';
                rankBadge = `<span class="league-rank-pill rank-pill-1">🥇 1</span>`;
            } else if (rank === 2) {
                rowCls = 'league-tr-ucl';
                rankBadge = `<span class="league-rank-pill rank-pill-2">🥈 2</span>`;
            } else if (rank === 3) {
                rowCls = 'league-tr-ucl';
                rankBadge = `<span class="league-rank-pill rank-pill-3">🥉 3</span>`;
            } else if (rank <= 4) {
                rowCls = 'league-tr-ucl';
            } else if (rank <= 8) {
                rowCls = 'league-tr-europa';
            }

            // Shield Initials & Gradient
            const initials = getCompanyInitials(compName);
            const [sc1, sc2] = getShieldGradient(compId, compName);

            // Bar Color
            let barColor = '#38bdf8';
            if (pct >= 100) barColor = '#fbbf24';
            else if (pct >= 80) barColor = '#34d399';
            else if (pct >= 50) barColor = '#38bdf8';
            else if (pct > 0) barColor = '#f59e0b';
            else barColor = '#ef4444';

            // Subtitle info
            const subText = pjoName ? `PJO: ${pjoName}` : (isMaincon ? 'MAIN CONTRACTOR' : (compCode ? `KODE: ${compCode}` : 'MITRA KERJA'));

            return `
            <div class="league-row ${rowCls}">
                <!-- Pos -->
                <div style="text-align:center;">${rankBadge}</div>

                <!-- Club Info -->
                <div class="club-info">
                    <div class="football-badge" style="background: linear-gradient(145deg, ${sc1}, ${sc2});">${initials}</div>
                    <div class="club-name-box">
                        <div class="club-name" title="${compName}">${compName}</div>
                        <div class="club-tag" title="${subText}">${subText}</div>
                    </div>
                </div>

                <!-- Skuad -->
                <div class="stat-num" style="color:#cbd5e1; font-size:10px;">${empCount}</div>

                <!-- PTS (%) -->
                <div class="pct-box">
                    <div class="pct-val" style="color: ${barColor}; font-size:10.5px;">${pct.toFixed(1)}%</div>
                    <div class="pct-bar-bg">
                        <div class="pct-bar-fill" style="width: ${Math.min(100, pct)}%; background: ${barColor};"></div>
                    </div>
                </div>

                <!-- Form (5 Pillars W/D/L) -->
                <div class="form-dots">${formatFormDots(form)}</div>

                <!-- 6 Pillars (HZ, IP, ST, OB, CC, P5M) -->
                ${formatPillarCell(hRate, hTgt, hReal)}
                ${formatPillarCell(iRate, iTgt, iReal)}
                ${formatPillarCell(stRate, stTgt, stReal)}
                ${formatPillarCell(oRate, oTgt, oReal)}
                ${formatPillarCell(cRate, cTgt, cReal)}
                ${formatPillarCell(p5Rate, p5Tgt, p5Real)}
            </div>
            `;
        }).join('');
    }

    // 2. Red Zone (Relegation Zone)
    if (redZone && redZone.length > 0) {
        rowsHtml += `
        <div class="relegation-divider">
            <i class="bi bi-exclamation-octagon-fill"></i> ZONA DEGRADASI / PERFORMA 0% (${redZone.length} Tim)
        </div>
        `;

        rowsHtml += redZone.map((item, idx) => {
            const compId = item.companyId ?? item.CompanyId ?? (100 + idx);
            const compName = item.companyName ?? item.CompanyName ?? 'Perusahaan';
            const pjoName = item.pjoName ?? item.PjoName ?? '';
            const empCount = item.employeeCount ?? item.EmployeeCount ?? '-';
            const initials = getCompanyInitials(compName);
            const subText = pjoName ? `PJO: ${pjoName}` : 'REALISASI BULAN INI 0%';

            return `
            <div class="league-row league-tr-relegation">
                <!-- Pos -->
                <div style="text-align:center;">
                    <span class="league-rank-pill rank-pill-relegation">⚠️</span>
                </div>

                <!-- Club Info -->
                <div class="club-info">
                    <div class="football-badge" style="background: linear-gradient(145deg, #7f1d1d, #450a0a); border-color:#ef4444;">${initials}</div>
                    <div class="club-name-box">
                        <div class="club-name" style="color:#fca5a5;" title="${compName}">${compName}</div>
                        <div class="club-tag" style="color:#f87171;">${subText}</div>
                    </div>
                </div>

                <!-- Skuad -->
                <div class="stat-num" style="color:#fca5a5; font-size:10px;">${empCount}</div>

                <!-- PTS (0.0%) -->
                <div class="pct-box">
                    <div class="pct-val" style="color: #ef4444; font-size:10.5px;">0.0%</div>
                    <div class="pct-bar-bg">
                        <div class="pct-bar-fill" style="width: 0%; background: #ef4444;"></div>
                    </div>
                </div>

                <!-- Form (All L) -->
                <div class="form-dots">${formatFormDots(['L','L','L','L','L'])}</div>

                <!-- 6 Pillars -->
                <div class="pillar-cell" style="color:#ef4444;">0%</div>
                <div class="pillar-cell" style="color:#ef4444;">0%</div>
                <div class="pillar-cell" style="color:#ef4444;">0%</div>
                <div class="pillar-cell" style="color:#ef4444;">0%</div>
                <div class="pillar-cell" style="color:#ef4444;">0%</div>
                <div class="pillar-cell" style="color:#ef4444;">0%</div>
            </div>
            `;
        }).join('');
    }

    container.innerHTML = rowsHtml;
}

function renderMarquee(text) {
    if (text) {
        document.getElementById('marqueeText').innerText = text;
    }
}

function renderTopCards(data) {
    const teams = data.f1Teams || [];
    if (teams.length > 0) {
        const p1 = teams[0];
        const p1Name = p1.shortName || p1.ShortName || p1.teamName || p1.TeamName || 'P1';
        const p1Pct = Number(p1.percentage ?? p1.Percentage ?? 0).toFixed(1);
        document.getElementById('poleLeaderName').innerText = `P1: ${p1Name} (${p1Pct}%)`;

        let maxSpeed = 0;
        teams.forEach(t => {
            const s = Number(t.speedKmh ?? t.SpeedKmh ?? 0);
            if (s > maxSpeed) maxSpeed = s;
        });
        document.getElementById('topSpeedVal').innerText = `${maxSpeed.toFixed(1)} km/h`;
    }
    document.getElementById('safeDaysVal').innerText = `${data.safeDays || 0} HARI`;
}

/* ──────────────────────────────────────────────────────────────────────────
   6. RENDER F1 GRAND PRIX RACE CIRCUIT & REAL-TIME TELEMETRY
   ────────────────────────────────────────────────────────────────────────── */
function renderF1Circuit(f1Teams) {
    if (!f1Teams || f1Teams.length === 0) return;

    const container = document.getElementById('f1LanesContainer');

    const html = f1Teams.map((team, idx) => {
        const gridPos = team.gridPosition ?? team.GridPosition ?? (idx + 1);
        const teamCode = team.teamCode ?? team.TeamCode ?? 'F1';
        const teamName = team.teamName ?? team.TeamName ?? 'Team';
        const colorPrimary = team.colorPrimary ?? team.ColorPrimary ?? '#00d2ff';
        const colorSecondary = team.colorSecondary ?? team.ColorSecondary ?? '#3b82f6';
        const pct = Number(team.percentage ?? team.Percentage ?? 0);
        const speed = Number(team.speedKmh ?? team.SpeedKmh ?? 0);
        const lapCount = team.lapCount ?? team.LapCount ?? '0/0';
        const drsStatus = team.drsStatus ?? team.DrsStatus ?? 'DISABLED';
        const isPit = pct === 0;

        // Position on track:
        // Lane starts at 270px from left (right next to team HUD label).
        // Finish line is at right: 18px.
        // At 0% -> car is at 270px (Start Grid).
        // At 100% -> car is right at the finish checkered line.
        const carLeft = isPit ? '275px' : `calc(275px + (${Math.min(100, Math.max(0, pct)) / 100} * (100% - 470px)))`;

        const carSvg = generateF1CarSvg(colorPrimary, colorSecondary, teamCode, gridPos);

        // DRS Indicator
        let drsBadge = '';
        if (drsStatus.includes('TURBO')) {
            drsBadge = `<span style="background:#fbbf24; color:#000; padding:1px 5px; border-radius:3px; font-weight:900;">⚡ TURBO</span>`;
        } else if (drsStatus.includes('OPEN') || drsStatus.includes('ACTIVE')) {
            drsBadge = `<span style="background:#34d399; color:#000; padding:1px 5px; border-radius:3px; font-weight:900;">DRS ON</span>`;
        }

        const speedColor = pct >= 80 ? '#34d399' : (pct >= 40 ? '#38bdf8' : '#fbbf24');

        return `
        <div class="race-lane">
            <!-- Start Grid, Sector lines & Checkered finish line -->
            <div class="track-start-line"></div>
            <div class="track-line-s1"></div>
            <div class="track-line-s2"></div>
            <div class="track-finish-line" title="Finish Line (100% Target)"></div>

            <!-- Team HUD Label on Left (270px WIDE & FULL NAME) -->
            <div class="team-hud-label">
                <div class="team-hud-header">
                    <div class="team-hud-pos">
                        <span class="team-pos-pill" style="background:${colorPrimary}; color:#000;">P${gridPos}</span>
                        <span class="team-code-pill">${teamCode}</span>
                    </div>
                    <div class="team-hud-speed" style="color: ${speedColor};">
                        <i class="bi bi-speedometer2"></i>
                        ${isPit ? '<span style="color:#ef4444; font-weight:900;">BOX BOX</span>' : speed.toFixed(1) + ' KM/H'}
                    </div>
                </div>

                <div class="team-hud-name" title="${teamName}">
                    ${teamName}
                </div>

                <div class="team-hud-footer">
                    <span><i class="bi bi-flag-fill" style="color:${colorPrimary}; font-size:9px;"></i> ${lapCount} LAPS</span>
                    <span style="color:${colorPrimary}; font-weight:900; font-family:'Orbitron', monospace; font-size:11px;">${pct.toFixed(1)}%</span>
                </div>
            </div>

            ${isPit ? `
            <!-- Pit Box Mode when 0% -->
            <div class="pit-box-mode">
                <i class="bi bi-wrench-adjustable-circle-fill" style="font-size:14px;"></i>
                <span>PIT STOP / 0% REALISASI BULAN INI</span>
            </div>
            ` : ''}

            <!-- Dynamic Animated F1 Race Car -->
            <div class="f1-car-positioner" style="left: ${carLeft};">
                <!-- Glowing Particle Exhaust Jet Stream -->
                ${!isPit ? `
                <div class="exhaust-nitro-stream">
                    <div class="nitro-flame-outer"></div>
                    <div class="nitro-flame-core"></div>
                </div>
                ` : ''}

                <!-- Overhead Telemetry HUD Badge -->
                <div class="car-hud-badge" style="border-color: ${colorPrimary}; box-shadow: 0 4px 14px rgba(0,0,0,0.8), 0 0 10px ${colorPrimary}44;">
                    <span style="color:${colorPrimary}; font-weight:900; font-size:11px;">${pct.toFixed(1)}%</span>
                    <span>&bull;</span>
                    <span>${lapCount} LAPS</span>
                    ${drsBadge}
                </div>

                <!-- Car 3D Graphic -->
                <div class="f1-car-sprite">
                    ${carSvg}
                </div>
            </div>
        </div>
        `;
    }).join('');

    container.innerHTML = html;
}

/* ──────────────────────────────────────────────────────────────────────────
   7. RENDER F1 DRIVER CAROUSEL & 6-PILLAR SAP PERFORMANCE TELEMETRY
   ────────────────────────────────────────────────────────────────────────── */
let currentDriverIndex = 0;
let driverCarouselTimer = null;
let savedF1Teams = [];
let savedCoreStandings = [];

function selectDriver(index) {
    if (!savedF1Teams || savedF1Teams.length === 0) return;
    currentDriverIndex = Math.max(0, Math.min(index, savedF1Teams.length - 1));
    renderActiveDriver();
}

function rotateDriverProfile() {
    if (!savedF1Teams || savedF1Teams.length === 0) return;
    currentDriverIndex = (currentDriverIndex + 1) % savedF1Teams.length;
    renderActiveDriver();
}

// Auto-rotate driver carousel every 7 seconds
if (!driverCarouselTimer) {
    driverCarouselTimer = setInterval(rotateDriverProfile, 7000);
}

function renderDriverWinnerProfile(f1Teams, coreStandings) {
    savedF1Teams = f1Teams || [];
    savedCoreStandings = coreStandings || [];
    renderActiveDriver();
}

function renderActiveDriver() {
    const container = document.getElementById('driverWinnerBody');
    const tabsContainer = document.getElementById('driverTeamTabs');
    if (!container || !savedF1Teams || savedF1Teams.length === 0) return;

    // Render 4-Team Position Tabs in Header (cukup POS saja)
    if (tabsContainer) {
        tabsContainer.innerHTML = savedF1Teams.map((t, idx) => {
            const color = t.colorPrimary ?? t.ColorPrimary ?? '#fbbf24';
            const isActive = idx === currentDriverIndex;
            const pos = t.gridPosition ?? t.GridPosition ?? (idx + 1);
            const medal = pos === 1 ? '🥇' : (pos === 2 ? '🥈' : (pos === 3 ? '🥉' : '🏁'));
            return `
            <div class="driver-team-pill ${isActive ? 'active' : ''}" 
                style="${isActive ? `background:${color}; border-color:${color}; color:#000; font-weight:900;` : `border-color:${color}55; color:${color};`}"
                onclick="selectDriver(${idx})" title="Lihat telemetri POS ${pos}">
                <span style="font-size:11px;">${medal}</span>
                <span class="driver-tab-pos">POS ${pos}</span>
            </div>
            `;
        }).join('');
    }

    const team = savedF1Teams[currentDriverIndex] || savedF1Teams[0];
    const gridPos = team.gridPosition ?? team.GridPosition ?? (currentDriverIndex + 1);
    const teamName = team.teamName ?? team.TeamName ?? 'Team';
    const shortName = team.shortName ?? team.ShortName ?? team.teamCode ?? 'F1';
    const teamCode = team.teamCode ?? team.TeamCode ?? `P${gridPos}`;
    const primaryColor = team.colorPrimary ?? team.ColorPrimary ?? '#fbbf24';
    const secondaryColor = team.colorSecondary ?? team.ColorSecondary ?? '#d97706';
    const pct = Number(team.percentage ?? team.Percentage ?? 0);
    const speed = Number(team.speedKmh ?? team.SpeedKmh ?? 0);
    const tgt = team.target ?? team.Target ?? 0;
    const real = team.realization ?? team.Realization ?? 0;

    // PJO Name
    let pjoName = team.pjoName ?? team.PjoName ?? '';
    if (!pjoName && savedCoreStandings && savedCoreStandings.length > 0) {
        const found = savedCoreStandings.find(c => (c.companyName || '').toUpperCase().includes(shortName.toUpperCase()) || (c.companyId ?? c.CompanyId) === (team.teamId ?? team.TeamId));
        if (found) {
            pjoName = found.pjoName || found.PjoName || '';
        }
    }
    const driverSubtitle = pjoName ? `PJO: ${pjoName}` : `${shortName} RACING DRIVER #${String(gridPos).padStart(2, '0')}`;

    // Select dynamic driver avatar with cache-buster
    let driverImgSrc = '/images/f1_driver_udu.jpg?v=clean_20260905';
    const tUpper = (teamName + ' ' + shortName + ' ' + teamCode).toUpperCase();
    if (tUpper.includes('UNGGUL') || tUpper.includes('UDU')) {
        driverImgSrc = '/images/f1_driver_udu.jpg?v=clean_20260905';
    } else if (tUpper.includes('MEGA') || tUpper.includes('MEG') || tUpper.includes('MGE')) {
        driverImgSrc = '/images/f1_driver_mge.jpg?v=clean_20260905';
    } else if (tUpper.includes('INDEXIM') || tUpper.includes('IDX')) {
        driverImgSrc = '/images/f1_driver_idx.jpg?v=clean_20260905';
    } else if (tUpper.includes('KALIMANTAN') || tUpper.includes('KPP')) {
        driverImgSrc = '/images/f1_driver_kpp.jpg?v=clean_20260905';
    }

    // 6 Pillars data
    const hzTgt = Number(team.hazard?.target ?? team.Hazard?.Target ?? 0);
    const hzReal = Number(team.hazard?.real ?? team.Hazard?.Real ?? 0);
    const hzRate = hzTgt > 0 ? (hzReal / hzTgt * 100) : (team.hazard?.rate ?? team.Hazard?.Rate ?? (team.sector1?.percentage ?? 0));

    const ipTgt = Number(team.inspeksi?.target ?? team.Inspeksi?.Target ?? 0);
    const ipReal = Number(team.inspeksi?.real ?? team.Inspeksi?.Real ?? 0);
    const ipRate = ipTgt > 0 ? (ipReal / ipTgt * 100) : (team.inspeksi?.rate ?? team.Inspeksi?.Rate ?? 0);

    const stTgt = Number(team.safetyTalk?.target ?? team.SafetyTalk?.Target ?? 0);
    const stReal = Number(team.safetyTalk?.real ?? team.SafetyTalk?.Real ?? 0);
    const stRate = stTgt > 0 ? (stReal / stTgt * 100) : (team.safetyTalk?.rate ?? team.SafetyTalk?.Rate ?? 0);

    const p5Tgt = Number(team.p5m?.target ?? team.P5m?.Target ?? 0);
    const p5Real = Number(team.p5m?.real ?? team.P5m?.Real ?? 0);
    const p5Rate = p5Tgt > 0 ? (p5Real / p5Tgt * 100) : (team.p5m?.rate ?? team.P5m?.Rate ?? 0);

    const ccTgt = Number(team.coaching?.target ?? team.Coaching?.Target ?? 0);
    const ccReal = Number(team.coaching?.real ?? team.Coaching?.Real ?? 0);
    const ccRate = ccTgt > 0 ? (ccReal / ccTgt * 100) : (team.coaching?.rate ?? team.Coaching?.Rate ?? 0);

    const obTgt = Number(team.observasi?.target ?? team.Observasi?.Target ?? 0);
    const obReal = Number(team.observasi?.real ?? team.Observasi?.Real ?? 0);
    const obRate = obTgt > 0 ? (obReal / obTgt * 100) : (team.observasi?.rate ?? team.Observasi?.Rate ?? 0);

    const statusBadgeText = gridPos === 1 ? 'POLE POSITION' : (gridPos === 2 ? 'PODIUM P2' : (gridPos === 3 ? 'PODIUM P3' : 'GRID P4'));

    const driverHtml = `
        <!-- Left: Driver Persona Column -->
        <div class="driver-persona-col">
            <div class="driver-avatar-wrap" style="border-color: ${primaryColor}; box-shadow: 0 0 16px ${primaryColor}40;">
                <img src="${driverImgSrc}" class="driver-avatar-img" alt="${teamName} Driver" 
                    onerror="this.style.display='none'; document.getElementById('driverSvgFallback').style.display='block';" />
                <div id="driverSvgFallback" style="display:none; width:100%; height:100%;">
                    <svg viewBox="0 0 100 120" width="100%" height="100%">
                        <rect width="100" height="120" fill="#0b1329" />
                        <circle cx="50" cy="42" r="24" fill="${primaryColor}" />
                        <ellipse cx="52" cy="44" rx="17" ry="11" fill="#090f1d" stroke="#fff" stroke-width="1" />
                        <path d="M 40 44 Q 52 40 64 44" stroke="#00f0ff" stroke-width="2.5" fill="none" />
                        <path d="M 22 120 L 28 72 L 72 72 L 78 120 Z" fill="${primaryColor}" />
                        <path d="M 42 72 L 50 120 L 58 72 Z" fill="#0f172a" />
                    </svg>
                </div>
                <div class="driver-number-stamp" style="color: ${primaryColor};">#${String(gridPos).padStart(2, '0')}</div>
                <div class="driver-flag-badge">🇮🇩 ID</div>
            </div>

            <div class="driver-speed-bar" style="border-color: ${primaryColor}44;">
                <div class="driver-speed-item">
                    <span class="driver-speed-lbl">CAPAIAN</span>
                    <span class="driver-speed-num" style="color:${primaryColor};">${pct.toFixed(1)}%</span>
                </div>
                <div class="driver-speed-item" style="border-left: 1px solid rgba(255,255,255,0.08); border-right: 1px solid rgba(255,255,255,0.08);">
                    <span class="driver-speed-lbl">SPEED</span>
                    <span class="driver-speed-num" style="color:#38bdf8;">${speed.toFixed(0)} <small style="font-size:7px; color:#64748b;">km/h</small></span>
                </div>
                <div class="driver-speed-item">
                    <span class="driver-speed-lbl">TOTAL LAPS</span>
                    <span class="driver-speed-num" style="color:#ffffff; font-size:9.5px;">${real}<small style="color:#94a3b8; font-size:7.5px;">/${tgt}</small></span>
                </div>
            </div>
        </div>

        <!-- Right: 6 SAP Pillars Loading Bar Telemetry Matrix -->
        <div class="driver-sap-col">
            <div class="driver-team-header-bar" style="border-left: 3px solid ${primaryColor};">
                <div style="min-width:0;">
                    <div class="driver-comp-title" title="${teamName}">
                        <span style="color:${primaryColor}; font-weight:900;">[${teamCode}]</span> ${teamName}
                    </div>
                    <div class="driver-pjo-title">
                        <i class="bi bi-person-badge-fill" style="color:${primaryColor};"></i> ${driverSubtitle}
                    </div>
                </div>
                <div class="driver-status-badge" style="background:${primaryColor}; color:#000;">
                    POS ${gridPos} &bull; ${statusBadgeText}
                </div>
            </div>

            <div class="driver-telemetry-loading-grid">
                <!-- 1. Hazard Report -->
                <div class="sap-loading-meter">
                    <div class="sap-meter-header">
                        <span class="sap-meter-title"><i class="bi bi-exclamation-triangle-fill" style="color:#ef4444;"></i> HAZARD REPORT</span>
                        <span class="sap-meter-counts">${hzReal} / ${hzTgt} Temuan</span>
                        <span class="sap-meter-pct" style="color:#ef4444;">${hzRate.toFixed(1)}%</span>
                    </div>
                    <div class="sap-loading-track">
                        <div class="sap-loading-bar" style="width:${Math.min(100, Math.max(0, hzRate))}%; background: linear-gradient(90deg, #dc2626, #f87171); box-shadow: 0 0 8px rgba(239,68,68,0.5);"></div>
                    </div>
                </div>

                <!-- 2. Inspeksi K3 -->
                <div class="sap-loading-meter">
                    <div class="sap-meter-header">
                        <span class="sap-meter-title"><i class="bi bi-clipboard2-check-fill" style="color:#38bdf8;"></i> INSPEKSI K3</span>
                        <span class="sap-meter-counts">${ipReal} / ${ipTgt} Agenda</span>
                        <span class="sap-meter-pct" style="color:#38bdf8;">${ipRate.toFixed(1)}%</span>
                    </div>
                    <div class="sap-loading-track">
                        <div class="sap-loading-bar" style="width:${Math.min(100, Math.max(0, ipRate))}%; background: linear-gradient(90deg, #0284c7, #38bdf8); box-shadow: 0 0 8px rgba(56,189,248,0.5);"></div>
                    </div>
                </div>

                <!-- 3. Safety Talk -->
                <div class="sap-loading-meter">
                    <div class="sap-meter-header">
                        <span class="sap-meter-title"><i class="bi bi-megaphone-fill" style="color:#c084fc;"></i> SAFETY TALK</span>
                        <span class="sap-meter-counts">${stReal} / ${stTgt} Sesi</span>
                        <span class="sap-meter-pct" style="color:#c084fc;">${stRate.toFixed(1)}%</span>
                    </div>
                    <div class="sap-loading-track">
                        <div class="sap-loading-bar" style="width:${Math.min(100, Math.max(0, stRate))}%; background: linear-gradient(90deg, #9333ea, #c084fc); box-shadow: 0 0 8px rgba(192,132,252,0.5);"></div>
                    </div>
                </div>

                <!-- 4. P5M Briefing -->
                <div class="sap-loading-meter">
                    <div class="sap-meter-header">
                        <span class="sap-meter-title"><i class="bi bi-shield-fill-check" style="color:#34d399;"></i> P5M BRIEFING</span>
                        <span class="sap-meter-counts">${p5Real} / ${p5Tgt} Briefing</span>
                        <span class="sap-meter-pct" style="color:#34d399;">${p5Rate.toFixed(1)}%</span>
                    </div>
                    <div class="sap-loading-track">
                        <div class="sap-loading-bar" style="width:${Math.min(100, Math.max(0, p5Rate))}%; background: linear-gradient(90deg, #059669, #34d399); box-shadow: 0 0 8px rgba(52,211,153,0.5);"></div>
                    </div>
                </div>

                <!-- 5. Coaching K3 -->
                <div class="sap-loading-meter">
                    <div class="sap-meter-header">
                        <span class="sap-meter-title"><i class="bi bi-person-video3" style="color:#fbbf24;"></i> COACHING K3</span>
                        <span class="sap-meter-counts">${ccReal} / ${ccTgt} Orang</span>
                        <span class="sap-meter-pct" style="color:#fbbf24;">${ccRate.toFixed(1)}%</span>
                    </div>
                    <div class="sap-loading-track">
                        <div class="sap-loading-bar" style="width:${Math.min(100, Math.max(0, ccRate))}%; background: linear-gradient(90deg, #d97706, #fbbf24); box-shadow: 0 0 8px rgba(251,191,36,0.5);"></div>
                    </div>
                </div>

                <!-- 6. Observasi Tugas -->
                <div class="sap-loading-meter">
                    <div class="sap-meter-header">
                        <span class="sap-meter-title"><i class="bi bi-binoculars-fill" style="color:#2dd4bf;"></i> OBSERVASI TUGAS</span>
                        <span class="sap-meter-counts">${obReal} / ${obTgt} Observasi</span>
                        <span class="sap-meter-pct" style="color:#2dd4bf;">${obRate.toFixed(1)}%</span>
                    </div>
                    <div class="sap-loading-track">
                        <div class="sap-loading-bar" style="width:${Math.min(100, Math.max(0, obRate))}%; background: linear-gradient(90deg, #0d9488, #2dd4bf); box-shadow: 0 0 8px rgba(45,212,191,0.5);"></div>
                    </div>
                </div>
            </div>

            <!-- Telemetry Footer Row -->
            <div class="driver-telemetry-footer-bar">
                <div class="telemetry-footer-item">
                    <span style="color:#94a3b8;">SEC 1 (HZ):</span>
                    <span style="color:#ef4444; font-family:'Orbitron', monospace;">${hzRate.toFixed(0)}%</span>
                </div>
                <div class="telemetry-footer-item">
                    <span style="color:#94a3b8;">SEC 2 (IP/ST):</span>
                    <span style="color:#38bdf8; font-family:'Orbitron', monospace;">${((ipTgt + stTgt) > 0 ? Math.round((ipReal + stReal)/(ipTgt + stTgt)*100) : 0)}%</span>
                </div>
                <div class="telemetry-footer-item">
                    <span style="color:#94a3b8;">SEC 3 (CC/OB):</span>
                    <span style="color:#34d399; font-family:'Orbitron', monospace;">${((ccTgt + obTgt) > 0 ? Math.round((ccReal + obReal)/(ccTgt + obTgt)*100) : 0)}%</span>
                </div>
                <div class="telemetry-footer-item" style="text-align:right;">
                    <span style="color:${primaryColor}; font-weight:900;">⚡ TELEMETRY OK</span>
                </div>
            </div>
        </div>
    `;

    container.innerHTML = driverHtml;

    const panel = document.getElementById('f1DriverWinnerPanel');
    if (panel) {
        panel.style.borderColor = `${primaryColor}88`;
        panel.style.boxShadow = `0 8px 24px rgba(0,0,0,0.6), inset 0 0 30px ${primaryColor}18`;
        panel.style.setProperty('--active-driver-grad', `linear-gradient(90deg, ${primaryColor}, ${secondaryColor}, #ef4444)`);
    }
}

/* ──────────────────────────────────────────────────────────────────────────
   8. RENDER PADDOCK FAST LANE — TOP 5 MITRA TERCEPAT NAIK
   ────────────────────────────────────────────────────────────────────────── */
function renderPaddockFastLane(fastestList, f1Teams) {
    const list = (fastestList && fastestList.length > 0) 
        ? fastestList.slice(0, 5) 
        : (f1Teams || []).slice(0, 5);

    const body = document.getElementById('fastestMitraBody');
    if (!body) return;

    if (!list || list.length === 0) {
        body.innerHTML = `
            <div style="text-align:center; padding: 15px; color: var(--muted); font-size:11px;">
                Belum ada data capaian mitra tercepat.
            </div>`;
        return;
    }

    const html = list.map((item, idx) => {
        const rank = item.rank ?? item.Rank ?? (idx + 1);
        const compName = item.companyName ?? item.CompanyName ?? 'Mitra Kerja';
        const compCode = item.companyCode ?? item.CompanyCode ?? '';
        const target = item.target ?? item.Target ?? 0;
        const real = item.realization ?? item.Realization ?? 0;
        const pct = Number(item.percentage ?? item.Percentage ?? 0);
        const speed = Number(item.speedKmh ?? item.SpeedKmh ?? 0);
        
        let rankColor = rank === 1 ? '#fbbf24' : (rank === 2 ? '#38bdf8' : (rank === 3 ? '#fb923c' : '#a3e635'));
        let rankLabel = rank === 1 ? '🥇' : (rank === 2 ? '🥈' : (rank === 3 ? '🥉' : `#0${rank}`));
        let barColor = pct >= 100 ? '#fbbf24' : (pct >= 80 ? '#34d399' : (pct >= 40 ? '#38bdf8' : (pct > 0 ? '#fb923c' : '#ef4444')));
        
        let statusBadge = pct >= 80 
            ? '<span style="color:#34d399; font-weight:900; font-size:8.5px;"><i class="bi bi-lightning-charge-fill"></i> DRS OPEN</span>'
            : (pct >= 40 
                ? '<span style="color:#38bdf8; font-weight:800; font-size:8.5px;">⚡ TOP PACE</span>' 
                : '<span style="color:#a3e635; font-weight:700; font-size:8.5px;">🏎️ ON TRACK</span>');

        return `
        <div class="mge-child-row">
            <div style="text-align:center; font-weight:900; color:${rankColor}; font-size:10.5px; font-family:'Orbitron', monospace;">
                ${rankLabel}
            </div>
            <div class="mge-child-name" title="${compName}">
                <span style="color:${rankColor}; font-weight:900; font-size:8.5px;">[${compCode || 'CORP'}]</span> ${compName}
            </div>
            <div style="text-align:center; color:#94a3b8; font-weight:700;">${target}</div>
            <div style="text-align:center; color:#fff; font-weight:800;">${real}</div>
            <div style="text-align:right;">
                <div style="font-weight:900; color:${barColor}; font-size:10.5px; font-family:'Orbitron', monospace;">${pct.toFixed(1)}%</div>
                <div style="height:4px; background:rgba(255,255,255,0.08); border-radius:2px; margin-top:2px; overflow:hidden;">
                    <div style="height:100%; width:${Math.min(100, pct)}%; background:${barColor}; border-radius:2px; box-shadow: 0 0 6px ${barColor}88;"></div>
                </div>
            </div>
            <div style="text-align:center; color:#38bdf8; font-family:'Orbitron', monospace; font-size:9.5px; font-weight:800;">
                ${speed.toFixed(1)} <small style="font-size:7px; color:#64748b;">km/h</small>
            </div>
            <div style="text-align:center;">
                ${statusBadge}
            </div>
        </div>
        `;
    }).join('');

    body.innerHTML = html;
}

/* ──────────────────────────────────────────────────────────────────────────
   8. SMOOTH AUTO-SCROLLER LOOPS (CORE LEAGUE, ALL MITRAS & MGE FLEET)
   ────────────────────────────────────────────────────────────────────────── */
let isCorePaused = false;
let isLeaguePaused = false;
let isMgePaused = false;

let coreScrollPos = 0;
let leagueScrollPos = 0;
let mgeScrollPos = 0;

function runAutoScroll() {
    // 1. Core League Auto-Scroll (active when tab is 'core')
    if (!isCorePaused && currentLeagueTab === 'core') {
        const box = document.getElementById('coreScrollBox');
        const content = document.getElementById('coreTableBody');
        if (box && content) {
            const maxScroll = content.scrollHeight - box.clientHeight;
            if (maxScroll > 10) {
                coreScrollPos += 0.55;
                if (coreScrollPos >= maxScroll) {
                    coreScrollPos = maxScroll;
                    isCorePaused = true;
                    setTimeout(() => {
                        coreScrollPos = 0;
                        content.style.transform = `translateY(-${coreScrollPos}px)`;
                        setTimeout(() => { isCorePaused = false; }, 1500);
                    }, 3500);
                }
                content.style.transform = `translateY(-${coreScrollPos}px)`;
            }
        }
    }

    // 2. All Mitras League Auto-Scroll (active when tab is 'all')
    if (!isLeaguePaused && currentLeagueTab === 'all') {
        const box = document.getElementById('leagueScrollBox');
        const content = document.getElementById('leagueTableBody');
        if (box && content) {
            const maxScroll = content.scrollHeight - box.clientHeight;
            if (maxScroll > 10) {
                leagueScrollPos += 0.65;
                if (leagueScrollPos >= maxScroll) {
                    leagueScrollPos = maxScroll;
                    isLeaguePaused = true;
                    setTimeout(() => {
                        leagueScrollPos = 0;
                        content.style.transform = `translateY(-${leagueScrollPos}px)`;
                        setTimeout(() => { isLeaguePaused = false; }, 1500);
                    }, 3500);
                }
                content.style.transform = `translateY(-${leagueScrollPos}px)`;
            }
        }
    }

    // 3. MGE Fleet Auto-Scroll
    if (!isMgePaused) {
        const boxM = document.getElementById('mgeScrollBox');
        const contentM = document.getElementById('mgeFleetBody');
        if (boxM && contentM) {
            const maxScrollM = contentM.scrollHeight - boxM.clientHeight;
            if (maxScrollM > 10) {
                mgeScrollPos += 0.5;
                if (mgeScrollPos >= maxScrollM) {
                    mgeScrollPos = maxScrollM;
                    isMgePaused = true;
                    setTimeout(() => {
                        mgeScrollPos = 0;
                        contentM.style.transform = `translateY(-${mgeScrollPos}px)`;
                        setTimeout(() => { isMgePaused = false; }, 1500);
                    }, 3000);
                }
                contentM.style.transform = `translateY(-${mgeScrollPos}px)`;
            }
        }
    }

    requestAnimationFrame(runAutoScroll);
}
requestAnimationFrame(runAutoScroll);

/* ──────────────────────────────────────────────────────────────────────────
   9. INITIALIZATION & REFRESH INTERVAL (EVERY 30 SECONDS / 6S FEED)
   ────────────────────────────────────────────────────────────────────────── */
fetchDisplay2Data();
setInterval(fetchDisplay2Data, 30000); // 30 seconds data refresh

fetchFeed();
setInterval(fetchFeed, 6000); // 6 seconds fast feed polling for real-time popups
</script>
</body>
