                                    <button type="button" class="area-pill" onclick="filterMapArea('CENTRAL')">Central</button>
                                    <button type="button" class="area-pill" onclick="filterMapArea('JL Mawar')">Mawar</button>
                                    <button type="button" class="area-pill" onclick="filterMapArea('PE')">PE</button>
                                    <button type="button" class="area-pill" onclick="filterMapArea('HAULING')">Hauling</button>
                                    <button type="button" class="area-pill" onclick="filterMapArea('KONTAINER')">Kontainer</button>
