    </div>

    <!-- AUDIO ELEMENT & JAVASCRIPT LOGIC -->
    <script>
    /* ──────────────────────────────────────────────────────────────────────────
       1. 5-MINUTE AUTO SLIDE ROTATION (/Display5 -> /Display)
       ────────────────────────────────────────────────────────────────────────── */
    const SLIDE_DURATION_SECONDS = 300; // 5 minutes
    let slideTimeRemaining = SLIDE_DURATION_SECONDS;
    let isSlidePaused = false;

    function updateSlideTimer() {
        if (isSlidePaused) return;

        slideTimeRemaining--;

        if (slideTimeRemaining <= 0) {
            // Rotate back to Display 1 (continuous loop: 1 -> 2 -> 3 -> 4 -> 5 -> 1)
            window.location.href = '/Display';
            return;
        }

        const mins = Math.floor(slideTimeRemaining / 60);
        const secs = slideTimeRemaining % 60;
        const countdownEl = document.getElementById('slideCountdown');
        if (countdownEl) {
            countdownEl.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        const progressPct = ((SLIDE_DURATION_SECONDS - slideTimeRemaining) / SLIDE_DURATION_SECONDS) * 100;
        const barEl = document.getElementById('slideProgressBar');
        if (barEl) {
            barEl.style.width = `${progressPct}%`;
        }
    }
    setInterval(updateSlideTimer, 1000);

    function togglePauseSlide() {
        isSlidePaused = !isSlidePaused;
        const icon = document.getElementById('pauseIcon');
        const text = document.getElementById('pauseText');
        if (isSlidePaused) {
            if (icon) icon.className = 'bi bi-play-fill';
            if (text) text.innerText = 'Lanjut';
        } else {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (text) text.innerText = 'Jeda';
        }
    }

    function toggleFullScreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen().catch(() => {});
            }
        }
    }

    /* ── Live Digital Clock ── */
    function updateClock() {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).replace(/\./g, ':');
        const dateStr = now.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase();
        
        const cTime = document.getElementById('liveClock');
        const cDate = document.getElementById('liveDate');
        if (cTime) cTime.innerText = timeStr;
        if (cDate) cDate.innerText = `WITA \u2022 ${dateStr}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    /* ──────────────────────────────────────────────────────────────────────────
       2. WEB AUDIO ALERT SYSTEM
       ────────────────────────────────────────────────────────────────────────── */
    let soundEnabled = true;
    let audioCtx = null;
    let lastScanSoundTime = 0;
    let lastCriticalAlertSoundTime = 0;
    let previousOverallStatus = null;
    let isRotaryTriggeredGlobal = false;
    let isRotarySirenPlaying = false;
    let rotarySirenInterval = null;

    function toggleSoundAlert() {
        soundEnabled = !soundEnabled;
        const btn = document.getElementById('btnToggleSound');
        const icon = document.getElementById('soundIcon');
        const text = document.getElementById('soundText');

        if (soundEnabled) {
            if (btn) btn.className = 'hdr-ctrl-btn sound-active';
            if (icon) icon.className = 'bi bi-volume-up-fill';
            if (text) text.innerText = 'Suara: ON';
            playTone(880, 0.1, 'sine');
            if (isRotaryTriggeredGlobal) {
                startRotaryEmergencySiren();
            }
        } else {
            if (btn) btn.className = 'hdr-ctrl-btn';
            if (icon) icon.className = 'bi bi-volume-mute-fill';
            if (text) text.innerText = 'Suara: OFF';
            stopRotaryEmergencySiren();
        }
    }

    function updateRotaryAlarm(isTriggered) {
        isRotaryTriggeredGlobal = isTriggered;
        const beaconBox = document.getElementById('rotaryBeaconBox');
        const statusText = document.getElementById('rotaryStatusText');

        if (isTriggered) {
            if (beaconBox) beaconBox.classList.add('active');
            if (statusText) statusText.innerText = 'ROTARY ALARM AKTIF!';
            document.body.classList.add('alarm-rotary-triggered');

            if (soundEnabled && !isRotarySirenPlaying) {
                startRotaryEmergencySiren();
            }
        } else {
            if (beaconBox) beaconBox.classList.remove('active');
            if (statusText) statusText.innerText = 'ROTARY STANDBY';
            document.body.classList.remove('alarm-rotary-triggered');
            stopRotaryEmergencySiren();
        }
    }

    function startRotaryEmergencySiren() {
        isRotarySirenPlaying = true;
        playRotaryTone();
        if (!rotarySirenInterval) {
            rotarySirenInterval = setInterval(() => {
                if (isRotarySirenPlaying && soundEnabled) {
                    playRotaryTone();
                }
            }, 1800);
        }
    }

    function stopRotaryEmergencySiren() {
        isRotarySirenPlaying = false;
        if (rotarySirenInterval) {
            clearInterval(rotarySirenInterval);
            rotarySirenInterval = null;
        }
    }

    function playRotaryTone() {
        if (!soundEnabled) return;
        try {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const now = audioCtx.currentTime;

            // Sirene wail naik-turun khas lampu rotary darurat (600Hz -> 1150Hz -> 600Hz)
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(600, now);
            osc.frequency.exponentialRampToValueAtTime(1150, now + 0.45);
            osc.frequency.exponentialRampToValueAtTime(600, now + 0.9);
            gain.gain.setValueAtTime(0.045, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.95);

            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.95);
        } catch(e) {}
    }

    function playTone(freq, duration, type = 'sine') {
        if (!soundEnabled) return;
        try {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            // Volume sangat lembut (ambient) agar tidak mengagetkan
            gain.gain.setValueAtTime(0.02, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0005, audioCtx.currentTime + duration);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + duration);
        } catch(e) {}
    }

    /* ── RANDOM SCAN INTERVAL GENERATOR (Acak 3 Jam, 5 Jam, 8 Jam) ── */
    const XTENS_SOUND_SCHEDULE_KEY = 'MBS_XTENS_NEXT_SCAN_SOUND_TS';

    function getRandomScanIntervalMs() {
        // Pilihan acak interval jam: 3 jam, 5 jam, atau 8 jam
        const hourPresets = [3, 5, 8];
        const selectedHours = hourPresets[Math.floor(Math.random() * hourPresets.length)];
        // Variasi jitter menit acak (+/- 10 menit) agar variatif & natural
        const jitterMinutes = (Math.random() * 20 - 10);
        const totalMinutes = Math.max(180, (selectedHours * 60) + jitterMinutes); // minimal 3 jam
        return Math.round(totalMinutes * 60 * 1000);
    }

    function checkAndPlayPeriodicScanSound(isManual = false) {
        if (!soundEnabled) return;
        const now = Date.now();
        let nextScheduledTs = parseInt(localStorage.getItem(XTENS_SOUND_SCHEDULE_KEY) || '0', 10);

        // Jika belum ada jadwal atau sudah terlewat lebih dari 24 jam, jadwalkan pertama kali
        if (!nextScheduledTs || isNaN(nextScheduledTs) || nextScheduledTs < (now - 86400000)) {
            nextScheduledTs = now + getRandomScanIntervalMs();
            localStorage.setItem(XTENS_SOUND_SCHEDULE_KEY, nextScheduledTs);
        }

        // Cek apakah tombol manual ditekan atau waktu random 3h / 5h / 8h telah tiba
        if (isManual || now >= nextScheduledTs) {
            playExtensometerScanSound();
            // Jadwalkan sesi berikutnya acak (3 jam, 5 jam, atau 8 jam ke depan)
            const nextInterval = getRandomScanIntervalMs();
            const nextTime = now + nextInterval;
            localStorage.setItem(XTENS_SOUND_SCHEDULE_KEY, nextTime);
        }
    }

    /* ── Audio Telemetry Extensometer Scanning (Lembut & Elegan) ── */
    function playExtensometerScanSound() {
        if (!soundEnabled) return;
        try {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            const now = audioCtx.currentTime;

            // Pulse 1: Handshake sensor extensometer (950Hz -> 1300Hz)
            const osc1 = audioCtx.createOscillator();
            const gain1 = audioCtx.createGain();
            osc1.type = 'sine';
            osc1.frequency.setValueAtTime(950, now);
            osc1.frequency.exponentialRampToValueAtTime(1300, now + 0.1);
            gain1.gain.setValueAtTime(0.016, now);
            gain1.gain.exponentialRampToValueAtTime(0.0005, now + 0.12);
            osc1.connect(gain1);
            gain1.connect(audioCtx.destination);
            osc1.start(now);
            osc1.stop(now + 0.12);

            // Pulse 2: Telemetry Data Packet Sync (1400Hz -> 1800Hz)
            const osc2 = audioCtx.createOscillator();
            const gain2 = audioCtx.createGain();
            osc2.type = 'sine';
            osc2.frequency.setValueAtTime(1400, now + 0.14);
            osc2.frequency.exponentialRampToValueAtTime(1800, now + 0.24);
            gain2.gain.setValueAtTime(0.014, now + 0.14);
            gain2.gain.exponentialRampToValueAtTime(0.0005, now + 0.26);
            osc2.connect(gain2);
            gain2.connect(audioCtx.destination);
            osc2.start(now + 0.14);
            osc2.stop(now + 0.26);

            // Pulse 3: Chime Verifikasi Telemetri (2100Hz lembut)
            const osc3 = audioCtx.createOscillator();
            const gain3 = audioCtx.createGain();
            osc3.type = 'sine';
            osc3.frequency.setValueAtTime(2100, now + 0.28);
            gain3.gain.setValueAtTime(0.012, now + 0.28);
            gain3.gain.exponentialRampToValueAtTime(0.0005, now + 0.42);
            osc3.connect(gain3);
            gain3.connect(audioCtx.destination);
            osc3.start(now + 0.28);
            osc3.stop(now + 0.42);
        } catch(e) {}
    }

    /* ──────────────────────────────────────────────────────────────────────────
       3. CHART.JS INITIALIZATION (24-Hour Slope Movement Trend)
       ────────────────────────────────────────────────────────────────────────── */
    let slopeChart = null;

    function initSlopeChart() {
        const ctx = document.getElementById('slopeTrendChart');
        if (!ctx) return;

        slopeChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: []
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 600 },
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            color: '#94a3b8',
                            font: { family: 'Outfit', size: 10, weight: '700' },
                            boxWidth: 10,
                            padding: 8
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.92)',
                        borderColor: 'rgba(56, 189, 248, 0.3)',
                        borderWidth: 1,
                        titleColor: '#38bdf8',
                        bodyColor: '#ffffff',
                        titleFont: { family: 'Outfit', weight: 'bold', size: 11 },
                        bodyFont: { family: 'JetBrains Mono', size: 10 }
                    }
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.04)' },
                        ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 9 }, maxRotation: 0 }
                    },
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        ticks: {
                            color: '#94a3b8',
                            font: { family: 'JetBrains Mono', size: 9.5 },
                            callback: function(v) { return v + ' mm'; }
                        },
                        title: {
                            display: true,
                            text: 'Akumulasi Pergeseran (mm)',
                            color: '#94a3b8',
                            font: { family: 'Outfit', size: 10, weight: '700' }
                        }
                    }
                }
            }
        });
    }

    function updateChartData(hourlyList) {
        if (!slopeChart || !hourlyList || hourlyList.length === 0) return;

        // Group by hour
        const hourSet = new Set();
        const deviceMap = {};

        const palette = [
            '#a855f7', '#38bdf8', '#10b981', '#f59e0b', '#ec4899', '#6366f1', '#14b8a6'
        ];

        hourlyList.forEach(item => {
            const h = item.hourStr.substring(11); // HH:mm
            hourSet.add(h);

            const devName = item.deviceName;
            if (!deviceMap[devName]) {
                deviceMap[devName] = {};
            }
            // Use maximum absolute accumulative or average
            if (!deviceMap[devName][h] || Math.abs(item.avgAccumulative) > Math.abs(deviceMap[devName][h])) {
                deviceMap[devName][h] = item.avgAccumulative;
            }
        });

        const sortedHours = Array.from(hourSet).sort();

        const datasets = [];
        let pIdx = 0;
        for (const [devName, hData] of Object.entries(deviceMap)) {
            const color = palette[pIdx % palette.length];
            const dataPoints = sortedHours.map(h => hData[h] !== undefined ? hData[h] : null);

            datasets.push({
                label: devName.replace('EXT IC_', '').replace('EXT IC', 'EXT'),
                data: dataPoints,
                borderColor: color,
                backgroundColor: color + '22',
                borderWidth: 2,
                pointRadius: 2.5,
                pointHoverRadius: 5,
                tension: 0.35,
                fill: false,
                spanGaps: true
            });
            pIdx++;
        }

        slopeChart.data.labels = sortedHours;
        slopeChart.data.datasets = datasets;
        slopeChart.update();
    }

    /* ──────────────────────────────────────────────────────────────────────────
       4. REALTIME DATA FETCHING & UI RENDERING
       ────────────────────────────────────────────────────────────────────────── */
    const DISPLAY5_CACHE_KEY = 'MBS_DISPLAY5_CACHE_V1';
    let isFetchingDisplay5 = false;

    // Restore instant cache
    (function restoreCache() {
        try {
            const raw = localStorage.getItem(DISPLAY5_CACHE_KEY);
            if (raw) {
                const data = JSON.parse(raw);
                renderDashboard(data);
            }
        } catch(e) {}
    })();

    async function fetchDisplay5Data(forceRefresh = false) {
        if (isFetchingDisplay5) return;
        isFetchingDisplay5 = true;
        // 🎵 Suara scan acak 3 jam, 5 jam, atau 8 jam sekali (atau saat tombol manual scan ditekan)
        checkAndPlayPeriodicScanSound(forceRefresh === true);

        const scanPing = document.getElementById('scanRadarPing');
        if (scanPing) scanPing.style.animation = 'radarPing 0.3s infinite ease-in-out';

        try {
            const url = forceRefresh ? '/Display/GetDisplay5Data?refresh=true' : '/Display/GetDisplay5Data';
            const res = await fetch(url);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            
            if (data && data.success) {
                renderDashboard(data);
                try {
                    localStorage.setItem(DISPLAY5_CACHE_KEY, JSON.stringify(data));
                } catch(e) {}
            }
        } catch(e) {
            console.error('Error fetching Display5 data:', e);
        } finally {
            isFetchingDisplay5 = false;
            if (scanPing) scanPing.style.animation = 'radarPing 1s infinite ease-in-out';
        }
    }

    function renderDashboard(data) {
