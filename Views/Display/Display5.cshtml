            if (panelTitle) panelTitle.innerText = 'Model 3 Dimensi Relief Lereng Tambang & Titik Extensometer';
            if (panelIcon) panelIcon.className = 'bi bi-box-fill text-warning';
            setTimeout(() => {
                initPit3D();
                update3DSensorPins();
            }, 50);
        } else if (mode === 'map') {
            if (btnMap) btnMap.classList.add('active');
            if (mapContainer) mapContainer.classList.remove('d-none');
            if (panelTitle) panelTitle.innerText = 'Peta Ortofoto Spasial Pit (25 Titik Extensometer ECW)';
            if (panelIcon) panelIcon.className = 'bi bi-map-fill text-info';
            initPitMapCanvas();
            renderPitMap();
        } else {
            if (btnCards) btnCards.classList.add('active');
            if (devContainer) devContainer.classList.remove('d-none');
            if (panelTitle) panelTitle.innerText = 'Status Sensor Extensometer Per Lokasi';
            if (panelIcon) panelIcon.className = 'bi bi-grid-3x3-gap-fill text-purple';
        }
    }

    function filterMapArea(area) {
        mapFilterArea = area;
        const container = document.getElementById('mapAreaFilters');
        if (container) {
            container.querySelectorAll('.area-pill').forEach(btn => {
                btn.classList.toggle('active', btn.textContent.includes(area) || (area === 'ALL' && btn.textContent.includes('Semua')));
            });
        }
        renderPitMap();
    }

    function zoomMap(factor) {
        mapZoom = Math.max(0.5, Math.min(4.0, mapZoom * factor));
        renderPitMap();
    }

    function resetMap() {
        mapZoom = 1.35;
        mapPanX = 140;
        mapPanY = 40;
        renderPitMap();
    }

    let mapCanvasInited = false;
    let animFrame2dId = null;

    function start2DMapAnimation() {
        if (animFrame2dId) cancelAnimationFrame(animFrame2dId);
        function loop() {
            if (activeLeftView === 'map') {
                renderPitMap();
            }
            animFrame2dId = requestAnimationFrame(loop);
        }
        animFrame2dId = requestAnimationFrame(loop);
    }

    function initPitMapCanvas() {
        if (mapCanvasInited) return;
        const wrapper = document.getElementById('pitCanvasWrapper');
        const canvas = document.getElementById('pitMapCanvas');
        if (!wrapper || !canvas) return;

        mapCanvasInited = true;

        // Mouse drag pan
        wrapper.addEventListener('mousedown', (e) => {
            isMapDragging = true;
            mapDragStartX = e.clientX - mapPanX;
            mapDragStartY = e.clientY - mapPanY;
        });

        window.addEventListener('mouseup', () => {
            isMapDragging = false;
        });

        wrapper.addEventListener('mousemove', (e) => {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.clientX - rect.left;
            const clientY = e.clientY - rect.top;

            if (isMapDragging) {
                mapPanX = e.clientX - mapDragStartX;
                mapPanY = e.clientY - mapDragStartY;
                renderPitMap();
                return;
            }

            // Hitung koordinat Mine Grid (E, N)
            const cw = canvas.width;
            const ch = canvas.height;
            const drawW = cw * mapZoom;
            const drawH = ch * mapZoom;
            const startX = (cw - drawW) / 2 + mapPanX;
            const startY = (ch - drawH) / 2 + mapPanY;

            const normX = (clientX - startX) / drawW;
            const normY = (clientY - startY) / drawH;

            const curE = MINE_BOUNDS.minE + normX * (MINE_BOUNDS.maxE - MINE_BOUNDS.minE);
            const curN = MINE_BOUNDS.maxN - normY * (MINE_BOUNDS.maxN - MINE_BOUNDS.minN);

            const disp = document.getElementById('mouseCoordsDisplay');
            if (disp && normX >= 0 && normX <= 1 && normY >= 0 && normY <= 1) {
                disp.innerText = `E: ${Math.round(curE).toLocaleString('id-ID')} | N: ${Math.round(curN).toLocaleString('id-ID')}`;
            }

            // Cek hover pin sensor
            checkPinHover(clientX, clientY);
        });

        // Wheel zoom
        wrapper.addEventListener('wheel', (e) => {
            e.preventDefault();
            const factor = e.deltaY < 0 ? 1.15 : 0.85;
            zoomMap(factor);
        }, { passive: false });

        window.addEventListener('resize', () => {
            if (activeLeftView === 'map') renderPitMap();
        });

        // Jalankan loop animasi kontinu untuk kedip merah dan radar pulsa
        start2DMapAnimation();
    }

    let renderedPinCoords = [];

    function renderPitMap() {
        const canvas = document.getElementById('pitMapCanvas');
        const wrapper = document.getElementById('pitCanvasWrapper');
        if (!canvas || !wrapper) return;

        // Resize canvas to display size
        const w = wrapper.clientWidth;
        const h = wrapper.clientHeight;
        if (canvas.width !== w || canvas.height !== h) {
            canvas.width = w;
            canvas.height = h;
        }

        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, w, h);

        // Transformasi zoom & pan
        const drawW = w * mapZoom;
        const drawH = h * mapZoom;
        const startX = (w - drawW) / 2 + mapPanX;
        const startY = (h - drawH) / 2 + mapPanY;

        // 1. Gambar Background Radar Grid Pit
        ctx.fillStyle = '#060a17';
        ctx.fillRect(startX, startY, drawW, drawH);

        // 1b. Render Ortofoto Udara Asli Tambang (GeoTIFF / ECW Pit Central)
        if (showOrthoLayer && orthoImgLoaded) {
            const imgX = startX + ((ORTHO_BOUNDS.minE - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            const imgY = startY + (1 - (ORTHO_BOUNDS.maxN - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;
            const imgW = ((ORTHO_BOUNDS.maxE - ORTHO_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            const imgH = ((ORTHO_BOUNDS.maxN - ORTHO_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;

            ctx.save();
            ctx.globalAlpha = 0.94;
            ctx.drawImage(orthoImg, imgX, imgY, imgW, imgH);
            
            // Border & label ortofoto
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.5)';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(imgX, imgY, imgW, imgH);

            ctx.fillStyle = 'rgba(56, 189, 248, 0.95)';
            ctx.font = 'bold 9.5px "JetBrains Mono", monospace';
            ctx.fillText('CITRA ORTOFOTO UDARA PIT CENTRAL (EOM OKTOBER 2026)', imgX + 8, imgY + 16);
            ctx.restore();
        }

        // ── GARIS PEMBANTU KOORDINAT TAMBANG (MINE GRID LINES) ── LEBIH JELAS & TEGAS
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.28)';
        ctx.lineWidth = 1.2;
        ctx.setLineDash([6, 6]);

        // Vertikal (Easting lines setiap 2,000 meter)
        for (let e = 570000; e <= 588000; e += 2000) {
            const gx = startX + ((e - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            ctx.beginPath();
            ctx.moveTo(gx, startY);
            ctx.lineTo(gx, startY + drawH);
            ctx.stroke();

            // Label Kapsul Koordinat E di bagian atas (Kontras & Sangat Terbaca)
            ctx.save();
            ctx.setLineDash([]);
            const eText = `${(e / 1000).toFixed(0)}k E`;
            ctx.font = 'bold 9.5px "JetBrains Mono", monospace';
            const tw = ctx.measureText(eText).width;
            ctx.fillStyle = 'rgba(6, 11, 26, 0.92)';
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.65)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.roundRect(gx - (tw / 2) - 5, startY + 4, tw + 10, 16, 4);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = '#38bdf8';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(eText, gx, startY + 12);
            ctx.restore();
        }

        // Horisontal (Northing lines setiap 2,000 meter)
        for (let n = 100000; n <= 122000; n += 2000) {
            const gy = startY + (1 - (n - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;
            ctx.beginPath();
            ctx.moveTo(startX, gy);
            ctx.lineTo(startX + drawW, gy);
            ctx.stroke();

            // Label Kapsul Koordinat N di sisi kiri (Kontras & Sangat Terbaca)
            ctx.save();
            ctx.setLineDash([]);
            const nText = `${(n / 1000).toFixed(0)}k N`;
            ctx.font = 'bold 9.5px "JetBrains Mono", monospace';
            const tw = ctx.measureText(nText).width;
            ctx.fillStyle = 'rgba(6, 11, 26, 0.92)';
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.65)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.roundRect(startX + 4, gy - 8, tw + 10, 16, 4);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = '#38bdf8';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(nText, startX + 4 + (tw + 10) / 2, gy);
            ctx.restore();
        }

        // Tanda silang crosshair (+) di setiap perpotongan koordinat grid
        ctx.setLineDash([]);
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.65)';
        ctx.lineWidth = 1.4;
        for (let e = 570000; e <= 588000; e += 2000) {
            const gx = startX + ((e - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            for (let n = 100000; n <= 122000; n += 2000) {
                const gy = startY + (1 - (n - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;
                ctx.beginPath();
                ctx.moveTo(gx - 5, gy);
                ctx.lineTo(gx + 5, gy);
                ctx.moveTo(gx, gy - 5);
                ctx.lineTo(gx, gy + 5);
                ctx.stroke();
            }
        }

        // 2. Gambar Zona Sektor Tambang (Sektor Pit & Hauling)
        const SECTORS = [
            { name: "SEKTOR CENTRAL", e: 575000, n: 121900, r: 42, color: "rgba(168, 85, 247, 0.18)", border: "#c084fc" },
            { name: "SEKTOR GAM / GPE", e: 577400, n: 120150, r: 38, color: "rgba(56, 189, 248, 0.15)", border: "#38bdf8" },
            { name: "SEKTOR T4 KPP", e: 571200, n: 115700, r: 45, color: "rgba(16, 185, 129, 0.15)", border: "#34d399" },
            { name: "SEKTOR T6 SOUTH", e: 573000, n: 114800, r: 40, color: "rgba(245, 158, 11, 0.15)", border: "#fbbf24" },
            { name: "DISPOSAL WD9", e: 570900, n: 113000, r: 36, color: "rgba(239, 68, 68, 0.15)", border: "#f87171" },
            { name: "JL MAWAR 5.5", e: 575080, n: 113940, r: 30, color: "rgba(14, 165, 233, 0.15)", border: "#0ea5e9" },
            { name: "SEKTOR PE_HW", e: 574400, n: 113000, r: 28, color: "rgba(217, 70, 239, 0.15)", border: "#d946ef" },
            { name: "HAULING KM 15-17", e: 587100, n: 100800, r: 46, color: "rgba(234, 179, 8, 0.15)", border: "#eab308" },
            { name: "BASE KONTAINER", e: 574550, n: 109263, r: 32, color: "rgba(148, 163, 184, 0.15)", border: "#94a3b8" }
        ];

        SECTORS.forEach(sec => {
            const sx = startX + ((sec.e - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            const sy = startY + (1 - (sec.n - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;
            const sr = sec.r * mapZoom;

            ctx.beginPath();
            ctx.arc(sx, sy, sr, 0, Math.PI * 2);
            ctx.fillStyle = sec.color;
            ctx.fill();
            ctx.strokeStyle = sec.border;
            ctx.setLineDash([4, 4]);
            ctx.lineWidth = 1.4;
            ctx.stroke();
            ctx.setLineDash([]);

            // Label sektor
            ctx.font = 'bold 10px "Outfit", sans-serif';
            ctx.fillStyle = sec.border;
            ctx.textAlign = 'center';
            ctx.fillText(sec.name, sx, sy - sr - 4);
        });

        // 3. Render 25 Pin Sensor Extensometer ECW (NAMA DIPERJELAS & MERAH BERKEDIP)
        renderedPinCoords = [];

        // Gabungkan dengan telemetri live
        const allSensors = [];
        (window.latestDevicesData || []).forEach(d => {
            (d.sensors || []).forEach(s => allSensors.push(s));
        });

        const nowMs = performance.now();
        // Siklus kedip strobo cepat (4 kali per detik)
        const isCriticalStrobe = (Math.sin(nowMs * 0.012) > 0);
        // Gelombang radar membesar terus-menerus
        const radarWaveCycle = (nowMs * 0.002) % 1;
        const radarWaveR = 8 + radarWaveCycle * 32;
        const radarWaveAlpha = Math.max(0, 1 - radarWaveCycle);

        ECW_PINS.forEach(p => {
            if (mapFilterArea !== 'ALL' && !p.area.toLowerCase().includes(mapFilterArea.toLowerCase())) {
                return;
            }

            const px = startX + ((p.e - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            const py = startY + (1 - (p.n - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;

            // Cari telemetri sensor
            const uid = p.uniqueId.toLowerCase();
            const extId = p.extensoId.toLowerCase();
            const liveSensor = allSensors.find(s => 
                (s.uniqueId && s.uniqueId.toLowerCase() === uid) ||
                (s.sensorName && s.sensorName.toLowerCase().includes(uid)) ||
                (s.sensorCode && s.sensorCode.toLowerCase() === extId)
            );

            const dispVal = liveSensor ? Math.max(Math.abs(liveSensor.latestValue || 0), Math.abs(liveSensor.accumulativeDisplacement || 0)) : 0;
            const isCritical = dispVal > 200 || (liveSensor && liveSensor.alertStatus === 'CRITICAL');
            const isWarning = !isCritical && (liveSensor && liveSensor.alertStatus === 'WARNING');

            renderedPinCoords.push({
                x: px,
                y: py,
                pin: p,
                sensor: liveSensor,
                dispVal,
                isCritical,
                isWarning
            });

            // ── 3A. EFEK GELOMBANG RADAR MERAH BERKEDIP & MELUAS ──
            if (isCritical) {
                // Gelombang kejut membesar keluar
                ctx.beginPath();
                ctx.arc(px, py, radarWaveR, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(239, 68, 68, ${0.4 * radarWaveAlpha})`;
                ctx.fill();
                ctx.strokeStyle = `rgba(255, 68, 68, ${0.85 * radarWaveAlpha})`;
                ctx.lineWidth = 2;
                ctx.stroke();

                // Lingkaran halo strobo merah berkedip
                ctx.beginPath();
                ctx.arc(px, py, isCriticalStrobe ? 22 : 14, 0, Math.PI * 2);
                ctx.fillStyle = isCriticalStrobe ? 'rgba(239, 68, 68, 0.7)' : 'rgba(239, 68, 68, 0.25)';
                ctx.fill();
            } else if (isWarning) {
                ctx.beginPath();
                ctx.arc(px, py, 12, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(245, 158, 11, 0.25)';
                ctx.fill();
            } else {
                ctx.beginPath();
                ctx.arc(px, py, 10, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(16, 185, 129, 0.2)';
                ctx.fill();
            }

            // ── 3B. TITIK PIN TENGAH ──
            ctx.beginPath();
            ctx.arc(px, py, isCritical ? (isCriticalStrobe ? 8.5 : 6.5) : 6, 0, Math.PI * 2);
            ctx.fillStyle = isCritical ? (isCriticalStrobe ? '#ff0033' : '#ef4444') : (isWarning ? '#fbbf24' : '#10b981');
            ctx.fill();
            ctx.strokeStyle = isCritical ? (isCriticalStrobe ? '#ffffff' : '#ff9999') : '#ffffff';
            ctx.lineWidth = isCritical ? 2.5 : 1.5;
            ctx.stroke();

            // Titik inti putih
            ctx.beginPath();
            ctx.arc(px, py, 2.5, 0, Math.PI * 2);
            ctx.fillStyle = '#ffffff';
            ctx.fill();

            // ── 3C. GARIS PENUNJUK (LEADER LINE) SUPAYA NAMA TIDAK MENUMPUK ──
            // Stagger vertikal berbasis nomor urut (0, 1, 2) agar sensor yang berdekatan tidak tumpang tindih
            const staggerIdx = p.no % 3;
            const leaderH = 22 + (staggerIdx * 16);
            const leaderEndY = py - leaderH;

            ctx.beginPath();
            ctx.moveTo(px, py - 6);
            ctx.lineTo(px, leaderEndY);
            ctx.strokeStyle = isCritical ? (isCriticalStrobe ? '#ffffff' : '#ff3344') : (isWarning ? '#fbbf24' : 'rgba(56, 189, 248, 0.85)');
            ctx.lineWidth = isCritical ? 2 : 1.2;
            ctx.stroke();

            // ── 3D. KAPSUL NAMA SENSOR SANGAT JELAS & TEGAS (FONT 11PX DENGAN GLOWING SHADOW) ──
            const dispStr = `${dispVal.toFixed(0)}mm`;
            const labelText = `${p.uniqueId} (${dispStr})`;
            ctx.font = 'bold 11px "JetBrains Mono", monospace';
            const textWidth = ctx.measureText(labelText).width;
            const pillW = textWidth + 24;
            const pillH = 22;
            const pillX = px - (pillW / 2);
            const pillY = leaderEndY - pillH;

            // Efek shadow glowing
            ctx.save();
            if (isCritical) {
                ctx.shadowColor = isCriticalStrobe ? '#ff0033' : '#ff4444';
                ctx.shadowBlur = isCriticalStrobe ? 18 : 8;
            } else if (isWarning) {
                ctx.shadowColor = '#fbbf24';
                ctx.shadowBlur = 6;
            } else {
                ctx.shadowColor = '#0ea5e9';
                ctx.shadowBlur = 6;
            }

            // Latar belakang kapsul pekat gelap 95% opacity agar terbaca jelas di atas tekstur drone
            ctx.fillStyle = isCritical 
                ? (isCriticalStrobe ? 'rgba(185, 28, 28, 0.96)' : 'rgba(15, 23, 42, 0.95)') 
                : 'rgba(6, 11, 25, 0.95)';
            ctx.strokeStyle = isCritical 
                ? (isCriticalStrobe ? '#ffffff' : '#ff2244') 
                : (isWarning ? '#fbbf24' : '#38bdf8');
            ctx.lineWidth = isCritical ? 2.5 : 1.5;

            ctx.beginPath();
            ctx.roundRect(pillX, pillY, pillW, pillH, 6);
            ctx.fill();
            ctx.stroke();
            ctx.restore();

            // Titik status indikator di dalam kapsul
            ctx.beginPath();
            ctx.arc(pillX + 11, pillY + 11, 3.5, 0, Math.PI * 2);
            ctx.fillStyle = isCritical ? (isCriticalStrobe ? '#ffffff' : '#ff4444') : (isWarning ? '#fbbf24' : '#34d399');
            ctx.fill();

            // Teks Nama & Nilai MM
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 11px "JetBrains Mono", monospace';
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText(labelText, pillX + 19, pillY + 11);
        });
    }

    function checkPinHover(mouseX, mouseY) {
        const tooltip = document.getElementById('mapPinTooltip');
        const wrapper = document.getElementById('pitCanvasWrapper');
        if (!tooltip || !wrapper) return;

        let found = null;
        for (const item of renderedPinCoords) {
            const dist = Math.hypot(item.x - mouseX, item.y - mouseY);
            if (dist <= 14) {
                found = item;
                break;
            }
        }

        if (found) {
            wrapper.style.cursor = 'pointer';
            const p = found.pin;
            const s = found.sensor;
            const statusBadge = found.isCritical 
                ? '<span class="badge bg-danger text-white">KRITIS &gt; 200 mm</span>' 
                : (found.isWarning ? '<span class="badge bg-warning text-dark">Waspada</span>' : '<span class="badge bg-success text-white">Normal</span>');

            tooltip.innerHTML = `
                <div class="fw-bold text-info mb-1" style="font-size: 12px;">
                    <i class="bi bi-geo-alt-fill text-purple me-1"></i>${escapeHtml(p.uniqueId)} (${escapeHtml(p.extensoId)})
                </div>
                <div style="font-size: 10px; color: #94a3b8; margin-bottom: 4px;">
                    Area: <strong class="text-white">${escapeHtml(p.area)}</strong> &bull; Lokasi: ${escapeHtml(p.location)}
                </div>
                <div class="font-monospace text-warning small mb-1" style="font-size: 10.5px;">
                    N: ${p.n.toLocaleString('id-ID')} &bull; E: ${p.e.toLocaleString('id-ID')}
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top border-secondary">
                    <span>Pergeseran: <strong class="${found.isCritical ? 'text-danger' : 'text-success'}">${found.dispVal.toFixed(1)} mm</strong></span>
                    ${statusBadge}
                </div>
                ${s ? `<div class="text-muted small mt-1" style="font-size: 9.5px;">Kecepatan: ${s.velocityPerHour.toFixed(2)} mm/jam &bull; Tren: ${s.movementTrend}</div>` : ''}
            `;

            tooltip.style.left = `${Math.min(wrapper.clientWidth - 270, Math.max(10, found.x + 12))}px`;
            tooltip.style.top = `${Math.min(wrapper.clientHeight - 130, Math.max(10, found.y - 40))}px`;
            tooltip.style.display = 'block';
        } else {
            wrapper.style.cursor = isMapDragging ? 'grabbing' : 'grab';
            tooltip.style.display = 'none';
        }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 6. THREE.JS 3D TERRAIN & EXTENSOMETER PINS ENGINE
    // ──────────────────────────────────────────────────────────────────────────
    let scene3d = null, camera3d = null, renderer3d = null, controls3d = null;
    let terrainMesh3d = null;
    let pinObjects3d = [];
    let is3dInited = false;
    let is3dAutoRotate = true;
    let is3dWireframe = false;
    let current3dExaggeration = 1.5;
    let animFrame3dId = null;
    let raycaster3d = null, mouse3d = null;
    let hovered3dPin = null;

    function initPit3D() {
        if (is3dInited) {
            onWindowResize3D();
            return;
        }

        const container = document.getElementById('pit3dWrapper');
        const canvas = document.getElementById('pit3dCanvas');
        if (!container || !canvas || typeof THREE === 'undefined') {
            console.warn('Three.js belum tersedia di halaman');
            return;
        }

        is3dInited = true;
        const width = container.clientWidth || 600;
        const height = container.clientHeight || 400;

        // 1. Scene
        scene3d = new THREE.Scene();
        scene3d.background = new THREE.Color(0x060b19);
        scene3d.fog = new THREE.FogExp2(0x060b19, 0.0032);

        // 2. Camera
        camera3d = new THREE.PerspectiveCamera(45, width / height, 0.5, 3000);
        camera3d.position.set(0, 115, 135);

        // 3. Renderer
        renderer3d = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
        renderer3d.setSize(width, height);
        renderer3d.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer3d.shadowMap.enabled = true;
        renderer3d.shadowMap.type = THREE.PCFSoftShadowMap;

        // 4. OrbitControls
        if (THREE.OrbitControls) {
            controls3d = new THREE.OrbitControls(camera3d, renderer3d.domElement);
            controls3d.enableDamping = true;
            controls3d.dampingFactor = 0.05;
            controls3d.autoRotate = is3dAutoRotate;
            controls3d.autoRotateSpeed = 0.7;
            controls3d.maxPolarAngle = Math.PI / 2 - 0.05; // Mencegah kamera tembus bawah tanah
            controls3d.minDistance = 20;
            controls3d.maxDistance = 500;
            controls3d.target.set(0, -6, 0);
        }

        // 5. Lighting
        const hemiLight = new THREE.HemisphereLight(0xffffff, 0x0f172a, 0.75);
        scene3d.add(hemiLight);

        const sunLight = new THREE.DirectionalLight(0xfff6e8, 1.4);
        sunLight.position.set(130, 190, 80);
        sunLight.castShadow = true;
        sunLight.shadow.mapSize.width = 2048;
        sunLight.shadow.mapSize.height = 2048;
        sunLight.shadow.camera.near = 10;
        sunLight.shadow.camera.far = 600;
        sunLight.shadow.camera.left = -90;
        sunLight.shadow.camera.right = 90;
        sunLight.shadow.camera.top = 90;
        sunLight.shadow.camera.bottom = -90;
        scene3d.add(sunLight);

        // Fill Light Sky-Blue (memberikan estetika cinematic pit)
        const fillLight = new THREE.DirectionalLight(0x38bdf8, 0.35);
        fillLight.position.set(-110, 70, -90);
        scene3d.add(fillLight);

        // 6. Terrain Mesh
        build3DTerrain();

        // 7. Raycaster for Hover & Click
        raycaster3d = new THREE.Raycaster();
        mouse3d = new THREE.Vector2(-999, -999);

        container.addEventListener('mousemove', onMouseMove3D);
        container.addEventListener('click', onClick3D);
        window.addEventListener('resize', onWindowResize3D);

        // 8. Start Loop
        animate3D();
    }

    function getTerrainElevation3D(e, n) {
        // Model elevasi lereng pit tambang berbasis koordinat survei
        let elev = 100.0;
        const dCentral = Math.hypot(e - 575000, (n - 121500) * 1.2);
        if (dCentral < 1800) {
            const m = 1 - dCentral / 1800;
            elev -= (Math.floor(m * 8) / 8 * 0.7 + m * 0.3) * 75;
        }
        const dT6 = Math.hypot(e - 573000, (n - 114800) * 0.9);
        if (dT6 < 1500) {
            const m = 1 - dT6 / 1500;
            elev -= (Math.floor(m * 7) / 7 * 0.7 + m * 0.3) * 65;
        }
        const dT4 = Math.hypot(e - 571200, (n - 115700) * 1.1);
        if (dT4 < 1400) {
            const m = 1 - dT4 / 1400;
            elev -= (Math.floor(m * 6) / 6 * 0.7 + m * 0.3) * 60;
        }
        const dWD9 = Math.hypot(e - 570900, n - 113000);
        if (dWD9 < 1200) {
            elev += (1 - dWD9 / 1200) * 35;
        }
        const dPE = Math.hypot(e - 574400, n - 113000);
        if (dPE < 1100) {
            elev -= (1 - dPE / 1100) * 40;
        }
        const norm = (elev - 32.36) / (133.34 - 32.36);
        return (norm * 22 * current3dExaggeration) - (11 * current3dExaggeration);
    }

    function build3DTerrain() {
        if (!scene3d) return;

        const baseUrl = (window.baseUrl || '/').replace(/\/$/, '') + '/';
        const texLoader = new THREE.TextureLoader();

        const orthoTexture = texLoader.load(baseUrl + 'images/pit_ortho_central.jpg', () => {
            if (renderer3d) renderer3d.render(scene3d, camera3d);
        });
        orthoTexture.wrapS = THREE.ClampToEdgeWrapping;
        orthoTexture.wrapT = THREE.ClampToEdgeWrapping;

        const heightTexture = texLoader.load(baseUrl + 'images/pit_heightmap.png', () => {
            if (renderer3d) renderer3d.render(scene3d, camera3d);
        });

        const geo = new THREE.PlaneGeometry(120, 160, 160, 160);
        const mat = new THREE.MeshStandardMaterial({
            map: orthoTexture,
            displacementMap: heightTexture,
            displacementScale: 22 * current3dExaggeration,
            displacementBias: -11 * current3dExaggeration,
            roughness: 0.85,
            metalness: 0.05,
            wireframe: is3dWireframe
        });

        terrainMesh3d = new THREE.Mesh(geo, mat);
        terrainMesh3d.rotation.x = -Math.PI / 2;
        terrainMesh3d.receiveShadow = true;
        scene3d.add(terrainMesh3d);

        // Build 25 3D Sensor Pins
        build3DSensorPins();
    }

    function build3DSensorPins() {
        if (!scene3d) return;

        // Bersihkan pin lama jika ada
        pinObjects3d.forEach(obj => scene3d.remove(obj));
        pinObjects3d = [];

        ECW_PINS.forEach((p, idx) => {
            const x3d = ((p.e - 568543) / (577749 - 568543) - 0.5) * 120;
            const z3d = ((121755 - p.n) / (121755 - 108343) - 0.5) * 160;
            const y3d = getTerrainElevation3D(p.e, p.n);

            const pinGroup = new THREE.Group();
            pinGroup.position.set(x3d, y3d, z3d);

            // Tiang Tower Sensor (Cylinder)
            const poleGeo = new THREE.CylinderGeometry(0.35, 0.45, 7.5, 8);
            const poleMat = new THREE.MeshStandardMaterial({
                color: 0x94a3b8,
                metalness: 0.8,
                roughness: 0.2
            });
            const poleMesh = new THREE.Mesh(poleGeo, poleMat);
            poleMesh.position.y = 3.75;
            poleMesh.castShadow = true;
            pinGroup.add(poleMesh);

            // Base Anchor Pelat Landasan
            const baseGeo = new THREE.CylinderGeometry(1.6, 1.8, 0.5, 8);
            const baseMat = new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.6 });
            const baseMesh = new THREE.Mesh(baseGeo, baseMat);
            baseMesh.position.y = 0.25;
            pinGroup.add(baseMesh);

            // Top Beacon Orb (Sphere)
            const orbGeo = new THREE.SphereGeometry(1.3, 16, 16);
            const orbMat = new THREE.MeshStandardMaterial({
                color: 0x10b981,
                emissive: 0x10b981,
                emissiveIntensity: 0.8,
                roughness: 0.1
            });
            const orbMesh = new THREE.Mesh(orbGeo, orbMat);
            orbMesh.position.y = 8.2;
            pinGroup.add(orbMesh);

            // Pulsing Radar Ring (Ground Disc)
            const ringGeo = new THREE.RingGeometry(0.8, 3.2, 32);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0x10b981,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.6
            });
            const ringMesh = new THREE.Mesh(ringGeo, ringMat);
            ringMesh.rotation.x = -Math.PI / 2;
            ringMesh.position.y = 0.35;
            pinGroup.add(ringMesh);

            // 3D Canvas Sprite Label
            const sprite = create3DLabelSprite(`${p.uniqueId} (0mm)`, false, false);
            sprite.position.y = 12.0;
            pinGroup.add(sprite);

            // Simpan metadata
            pinGroup.userData = {
                pin: p,
                pole: poleMesh,
                orb: orbMesh,
                ring: ringMesh,
                sprite: sprite,
                dispVal: 0,
                isCritical: false,
                isWarning: false,
                pulseTimer: Math.random() * Math.PI
            };

            scene3d.add(pinGroup);
            pinObjects3d.push(pinGroup);
        });
    }

    function create3DLabelSprite(text, isCritical, isWarning) {
        const c = document.createElement('canvas');
        c.width = 256;
        c.height = 64;
        const ctx = c.getContext('2d');

        // Background capsule
        ctx.fillStyle = isCritical ? 'rgba(239, 68, 68, 0.92)' : (isWarning ? 'rgba(245, 158, 11, 0.92)' : 'rgba(15, 23, 42, 0.88)');
        ctx.strokeStyle = isCritical ? '#ffffff' : (isWarning ? '#fef08a' : 'rgba(56, 189, 248, 0.6)');
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.roundRect(6, 6, 244, 52, 14);
        ctx.fill();
        ctx.stroke();

        // Text
        ctx.font = 'bold 20px "JetBrains Mono", monospace';
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, 128, 32);

        const tex = new THREE.CanvasTexture(c);
        tex.needsUpdate = true;
        const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false });
        const sprite = new THREE.Sprite(mat);
        sprite.scale.set(15, 3.8, 1);
        return sprite;
    }

    function update3DSensorPins() {
        if (!is3dInited || pinObjects3d.length === 0) return;

        const allSensors = [];
        (window.latestDevicesData || []).forEach(d => {
            (d.sensors || []).forEach(s => allSensors.push(s));
        });

        pinObjects3d.forEach(group => {
            const data = group.userData;
            const p = data.pin;
            const uid = p.uniqueId.toLowerCase();
            const extId = p.extensoId.toLowerCase();

            const liveSensor = allSensors.find(s => 
                (s.uniqueId && s.uniqueId.toLowerCase() === uid) ||
                (s.sensorName && s.sensorName.toLowerCase().includes(uid)) ||
                (s.sensorCode && s.sensorCode.toLowerCase() === extId)
            );

            const dispVal = liveSensor ? Math.max(Math.abs(liveSensor.latestValue || 0), Math.abs(liveSensor.accumulativeDisplacement || 0)) : 0;
            const isCritical = dispVal > 200 || (liveSensor && liveSensor.alertStatus === 'CRITICAL');
            const isWarning = !isCritical && (liveSensor && liveSensor.alertStatus === 'WARNING');

            data.sensor = liveSensor;
            data.dispVal = dispVal;
            data.isCritical = isCritical;
            data.isWarning = isWarning;

            // Update Orb Color
            const targetColor = isCritical ? 0xef4444 : (isWarning ? 0xfbbf24 : 0x10b981);
            data.orb.material.color.setHex(targetColor);
            data.orb.material.emissive.setHex(targetColor);
            data.orb.material.emissiveIntensity = isCritical ? 1.6 : (isWarning ? 1.1 : 0.7);

            // Update Ground Ring Color
            data.ring.material.color.setHex(targetColor);

            // Update Sprite Label
            group.remove(data.sprite);
            data.sprite = create3DLabelSprite(`${p.uniqueId} (${dispVal.toFixed(0)}mm)`, isCritical, isWarning);
            data.sprite.position.y = 12.0;
            group.add(data.sprite);
        });
    }

