    const CYCLE_VIEWS = ['cards', 'map', '3d'];
    const CYCLE_DURATION = 20; // 20 detik per tampilan
    let autoCycleEnabled = true;
    let autoCycleRemaining = CYCLE_DURATION;
    let autoCycleTimer = null;
    let manualPauseRemaining = 0; // Waktu jeda jika user klik manual

    function initAutoCycleLeftView() {
        if (autoCycleTimer) clearInterval(autoCycleTimer);
        autoCycleTimer = setInterval(() => {
            if (!autoCycleEnabled) return;

            if (manualPauseRemaining > 0) {
                manualPauseRemaining--;
                const txt = document.getElementById('textAutoCycle');
                if (txt) txt.innerText = `Jeda (${manualPauseRemaining}s)`;
                return;
            }

            autoCycleRemaining--;
            const txt = document.getElementById('textAutoCycle');
            if (txt) txt.innerText = `Auto (${autoCycleRemaining}s)`;

            if (autoCycleRemaining <= 0) {
                autoCycleRemaining = CYCLE_DURATION;
                const curIdx = CYCLE_VIEWS.indexOf(activeLeftView);
                const nextIdx = (curIdx + 1) % CYCLE_VIEWS.length;
                switchLeftView(CYCLE_VIEWS[nextIdx]);
            }
        }, 1000);
    }

    function manualSwitchLeftView(mode) {
        switchLeftView(mode);
        // Jeda auto-cycle selama 45 detik saat user berinteraksi manual
        if (autoCycleEnabled) {
            manualPauseRemaining = 45;
            const txt = document.getElementById('textAutoCycle');
            if (txt) txt.innerText = `Jeda (45s)`;
        }
    }

