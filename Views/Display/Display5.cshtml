                    <div class="alerts-scroll-area" id="alertsContainer">
                        <!-- Rendered dynamically by JS -->
                        <div class="text-center p-3 text-muted">
                            <div class="spinner-border spinner-border-sm text-info me-2"></div> Memuat log alarm...
