                                <button type="button" class="area-pill active" id="btnToggleOrtho" onclick="toggleOrthoLayer()" title="Aktif/Nonaktifkan Tampilan Foto Udara Drone"><i class="bi bi-camera-fill text-info me-1"></i>Foto Udara (ON)</button>
