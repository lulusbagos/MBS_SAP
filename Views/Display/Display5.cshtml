    function reset3dCamera() {
        if (!camera3d || !controls3d) return;
        camera3d.position.set(0, 115, 135);
        controls3d.target.set(0, -6, 0);
        controls3d.update();
    }

    function onMouseMove3D(e) {
        const container = document.getElementById('pit3dWrapper');
        const tooltip = document.getElementById('pit3dTooltip');
        if (!container || !raycaster3d || !camera3d) return;

        const rect = container.getBoundingClientRect();
        mouse3d.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
        mouse3d.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;

        raycaster3d.setFromCamera(mouse3d, camera3d);
        const intersectable = [];
        pinObjects3d.forEach(g => {
            intersectable.push(g.userData.orb);
            intersectable.push(g.userData.pole);
        });

        const hits = raycaster3d.intersectObjects(intersectable, false);

        if (hits.length > 0) {
            container.style.cursor = 'pointer';
            const hitGroup = hits[0].object.parent;
            if (hitGroup && hitGroup.userData) {
                const data = hitGroup.userData;
                const p = data.pin;
                const s = data.sensor;
                const statusBadge = data.isCritical 
                    ? '<span class="badge bg-danger text-white">KRITIS &gt; 200 mm</span>' 
                    : (data.isWarning ? '<span class="badge bg-warning text-dark">Waspada</span>' : '<span class="badge bg-success text-white">Normal</span>');

                tooltip.innerHTML = `
                    <div class="fw-bold text-info mb-1" style="font-size: 12px;">
                        <i class="bi bi-box-fill text-warning me-1"></i>${escapeHtml(p.uniqueId)} (${escapeHtml(p.extensoId)})
                    </div>
                    <div style="font-size: 10px; color: #94a3b8; margin-bottom: 4px;">
                        Area: <strong class="text-white">${escapeHtml(p.area)}</strong> &bull; Lokasi: ${escapeHtml(p.location)}
                    </div>
                    <div class="font-monospace text-warning small mb-1" style="font-size: 10.5px;">
                        N: ${p.n.toLocaleString('id-ID')} &bull; E: ${p.e.toLocaleString('id-ID')}
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top border-secondary">
                        <span>Pergeseran: <strong class="${data.isCritical ? 'text-danger' : 'text-success'}">${data.dispVal.toFixed(1)} mm</strong></span>
                        ${statusBadge}
                    </div>
                    ${s ? `<div class="text-muted small mt-1" style="font-size: 9.5px;">Kecepatan: ${s.velocityPerHour.toFixed(2)} mm/jam &bull; Tren: ${s.movementTrend}</div>` : ''}
                `;
                tooltip.style.left = `${Math.min(container.clientWidth - 270, Math.max(10, e.clientX - rect.left + 15))}px`;
                tooltip.style.top = `${Math.min(container.clientHeight - 130, Math.max(10, e.clientY - rect.top - 40))}px`;
                tooltip.style.display = 'block';
            }
        } else {
            container.style.cursor = 'grab';
            if (tooltip) tooltip.style.display = 'none';
        }
    }

    function onClick3D(e) {
        const container = document.getElementById('pit3dWrapper');
        if (!container || !raycaster3d || !camera3d || !controls3d) return;

        raycaster3d.setFromCamera(mouse3d, camera3d);
        const intersectable = [];
        pinObjects3d.forEach(g => {
            intersectable.push(g.userData.orb);
            intersectable.push(g.userData.pole);
        });

        const hits = raycaster3d.intersectObjects(intersectable, false);
        if (hits.length > 0) {
            const hitGroup = hits[0].object.parent;
            if (hitGroup) {
                // Haluskan target kamera ke pin yang diklik
                controls3d.target.set(hitGroup.position.x, hitGroup.position.y + 4, hitGroup.position.z);
                controls3d.update();
            }
        }
    }

    function onWindowResize3D() {
        const container = document.getElementById('pit3dWrapper');
        if (!container || !renderer3d || !camera3d) return;

        const width = container.clientWidth;
        const height = container.clientHeight;
        if (width > 0 && height > 0) {
            camera3d.aspect = width / height;
            camera3d.updateProjectionMatrix();
            renderer3d.setSize(width, height);
        }
    }

    function animate3D() {
        animFrame3dId = requestAnimationFrame(animate3D);

        if (activeLeftView === '3d' && renderer3d && scene3d && camera3d) {
            if (controls3d) controls3d.update();

            // Animasi Pulsa Cincin Radar di Tanah
            const time = performance.now() * 0.0025;
            pinObjects3d.forEach(group => {
                const data = group.userData;
                if (data.ring) {
                    const cycle = (time + data.pulseTimer) % (Math.PI * 2);
                    const scale = 1.0 + Math.sin(cycle) * 0.4;
                    data.ring.scale.set(scale, scale, 1);
                    data.ring.material.opacity = Math.max(0.1, 0.7 - Math.sin(cycle) * 0.5);

                    // Efek kedip strobo untuk status Kritis (> 200 mm)
                    if (data.isCritical && data.orb) {
                        const strobe = Math.sin(time * 6) > 0 ? 2.5 : 0.8;
                        data.orb.material.emissiveIntensity = strobe;
                    }
                }
            });

            renderer3d.render(scene3d, camera3d);
        }
    }

