                <!-- Bottom: Geotech Advisory & Action Protocol -->
                <section class="panel-box">
                    <div class="panel-hdr">
                        <div class="panel-title">
                            <i class="bi bi-shield-exclamation text-warning"></i> Protokol Tanggap Darurat Pergerakan Lereng
                        </div>
                        <span class="panel-badge" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24; border-color: rgba(251, 191, 36, 0.3);">
                            SOP K3 Geoteknik
                        </span>
