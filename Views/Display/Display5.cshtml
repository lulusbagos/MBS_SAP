                            <div class="map-tooltip" id="mapPinTooltip"></div>
                        </div>
                    </div>

                    <!-- Mode C: Pit 3D WebGL Three.js Container -->
                    <div class="pit-3d-container d-none" id="pit3dContainer">
                        <div class="pit-map-toolbar">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="map-badge-tag" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.35);">
