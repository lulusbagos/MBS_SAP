    function toggle3dExaggeration() {
        current3dExaggeration = current3dExaggeration === 1.5 ? 2.2 : (current3dExaggeration === 2.2 ? 1.0 : 1.5);
        if (terrainMesh3d) {
            terrainMesh3d.material.displacementScale = 22 * current3dExaggeration;
            terrainMesh3d.material.displacementBias = -11 * current3dExaggeration;
            terrainMesh3d.material.needsUpdate = true;
        }
        // Update ketinggian pin
        pinObjects3d.forEach(group => {
            const p = group.userData.pin;
            group.position.y = getTerrainElevation3D(p.e, p.n);
