                                <button type="button" class="view-tab-btn" id="btnView3D" onclick="manualSwitchLeftView('3d')" title="Model 3 Dimensi Relief Lereng Tambang & Titik Extensometer">
                                    <i class="bi bi-box-fill text-warning"></i> Model 3D Pit
                                </button>
                                <button type="button" class="view-tab-btn" id="btnAutoCycle" onclick="toggleAutoCycleLeftView()" title="Putar Bergantian Otomatis: Kartu -> Peta 2D -> Model 3D" style="border-left: 1px solid rgba(56, 189, 248, 0.25); color: #38bdf8;">
                                    <i class="bi bi-arrow-repeat text-info me-1" id="iconAutoCycle"></i> <span id="textAutoCycle">Auto (20s)</span>
                                </button>
