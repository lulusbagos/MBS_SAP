    function filterMapArea(area) {
        mapFilterArea = area;
        const container = document.getElementById('mapAreaFilters');
        if (container) {
            container.querySelectorAll('.area-pill').forEach(btn => {
                btn.classList.toggle('active', btn.textContent.includes(area) || (area === 'ALL' && btn.textContent.includes('Semua')));
            });
        }
        renderPitMap();
    }

    function zoomMap(factor) {
        mapZoom = Math.max(0.5, Math.min(4.0, mapZoom * factor));
        renderPitMap();
    }

    function resetMap() {
        mapZoom = 1.0;
        mapPanX = 0;
        mapPanY = 0;
        renderPitMap();
    }

    let mapCanvasInited = false;
    function initPitMapCanvas() {
        if (mapCanvasInited) return;
        const wrapper = document.getElementById('pitCanvasWrapper');
        const canvas = document.getElementById('pitMapCanvas');
        if (!wrapper || !canvas) return;

        mapCanvasInited = true;

        // Mouse drag pan
        wrapper.addEventListener('mousedown', (e) => {
            isMapDragging = true;
            mapDragStartX = e.clientX - mapPanX;
            mapDragStartY = e.clientY - mapPanY;
        });

        window.addEventListener('mouseup', () => {
            isMapDragging = false;
        });

        wrapper.addEventListener('mousemove', (e) => {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.clientX - rect.left;
            const clientY = e.clientY - rect.top;

            if (isMapDragging) {
                mapPanX = e.clientX - mapDragStartX;
                mapPanY = e.clientY - mapDragStartY;
                renderPitMap();
                return;
            }

            // Hitung koordinat Mine Grid (E, N)
            const cw = canvas.width;
            const ch = canvas.height;
            const drawW = cw * mapZoom;
            const drawH = ch * mapZoom;
            const startX = (cw - drawW) / 2 + mapPanX;
            const startY = (ch - drawH) / 2 + mapPanY;

            const normX = (clientX - startX) / drawW;
            const normY = (clientY - startY) / drawH;

            const curE = MINE_BOUNDS.minE + normX * (MINE_BOUNDS.maxE - MINE_BOUNDS.minE);
            const curN = MINE_BOUNDS.maxN - normY * (MINE_BOUNDS.maxN - MINE_BOUNDS.minN);

            const disp = document.getElementById('mouseCoordsDisplay');
            if (disp && normX >= 0 && normX <= 1 && normY >= 0 && normY <= 1) {
                disp.innerText = `E: ${Math.round(curE).toLocaleString('id-ID')} | N: ${Math.round(curN).toLocaleString('id-ID')}`;
            }

            // Cek hover pin sensor
            checkPinHover(clientX, clientY);
        });

        // Wheel zoom
        wrapper.addEventListener('wheel', (e) => {
            e.preventDefault();
            const factor = e.deltaY < 0 ? 1.15 : 0.85;
            zoomMap(factor);
        }, { passive: false });

        window.addEventListener('resize', () => {
            if (activeLeftView === 'map') renderPitMap();
        });
    }

    let renderedPinCoords = [];

    function renderPitMap() {
        const canvas = document.getElementById('pitMapCanvas');
        const wrapper = document.getElementById('pitCanvasWrapper');
        if (!canvas || !wrapper) return;

        // Resize canvas to display size
        const w = wrapper.clientWidth;
        const h = wrapper.clientHeight;
        if (canvas.width !== w || canvas.height !== h) {
            canvas.width = w;
            canvas.height = h;
        }

        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, w, h);

        // Transformasi zoom & pan
        const drawW = w * mapZoom;
        const drawH = h * mapZoom;
        const startX = (w - drawW) / 2 + mapPanX;
        const startY = (h - drawH) / 2 + mapPanY;

        // 1. Gambar Background Radar Grid Pit
        ctx.fillStyle = '#060a17';
        ctx.fillRect(startX, startY, drawW, drawH);

        // Grid lines (setiap 2,000 meter)
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.08)';
        ctx.lineWidth = 1;
        ctx.font = '9px "JetBrains Mono", monospace';
        ctx.fillStyle = 'rgba(148, 163, 184, 0.45)';

        for (let e = 570000; e <= 588000; e += 2000) {
            const gx = startX + ((e - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            ctx.beginPath();
            ctx.moveTo(gx, startY);
            ctx.lineTo(gx, startY + drawH);
            ctx.stroke();
            ctx.fillText(`${(e / 1000).toFixed(0)}k E`, gx + 3, startY + 12);
        }

        for (let n = 100000; n <= 122000; n += 2000) {
            const gy = startY + (1 - (n - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;
            ctx.beginPath();
            ctx.moveTo(startX, gy);
            ctx.lineTo(startX + drawW, gy);
            ctx.stroke();
            ctx.fillText(`${(n / 1000).toFixed(0)}k N`, startX + 4, gy - 3);
        }

        // 2. Gambar Zona Sektor Tambang (Sektor Pit & Hauling)
        const SECTORS = [
            { name: "SEKTOR CENTRAL", e: 575000, n: 121900, r: 42, color: "rgba(168, 85, 247, 0.15)", border: "#c084fc" },
            { name: "SEKTOR GAM / GPE", e: 577400, n: 120150, r: 38, color: "rgba(56, 189, 248, 0.12)", border: "#38bdf8" },
            { name: "SEKTOR T4 KPP", e: 571200, n: 115700, r: 45, color: "rgba(16, 185, 129, 0.12)", border: "#34d399" },
            { name: "SEKTOR T6 SOUTH", e: 573000, n: 114800, r: 40, color: "rgba(245, 158, 11, 0.12)", border: "#fbbf24" },
            { name: "DISPOSAL WD9", e: 570900, n: 113000, r: 36, color: "rgba(239, 68, 68, 0.12)", border: "#f87171" },
            { name: "JL MAWAR 5.5", e: 575080, n: 113940, r: 30, color: "rgba(14, 165, 233, 0.12)", border: "#0ea5e9" },
            { name: "SEKTOR PE_HW", e: 574400, n: 113000, r: 28, color: "rgba(217, 70, 239, 0.12)", border: "#d946ef" },
            { name: "HAULING KM 15-17", e: 587100, n: 100800, r: 46, color: "rgba(234, 179, 8, 0.12)", border: "#eab308" },
            { name: "BASE KONTAINER", e: 574550, n: 109263, r: 32, color: "rgba(148, 163, 184, 0.12)", border: "#94a3b8" }
        ];

        SECTORS.forEach(sec => {
            const sx = startX + ((sec.e - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            const sy = startY + (1 - (sec.n - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;
            const sr = sec.r * mapZoom;

            ctx.beginPath();
            ctx.arc(sx, sy, sr, 0, Math.PI * 2);
            ctx.fillStyle = sec.color;
            ctx.fill();
            ctx.strokeStyle = sec.border;
            ctx.setLineDash([4, 4]);
            ctx.lineWidth = 1.2;
            ctx.stroke();
            ctx.setLineDash([]);

            // Label sektor
            ctx.font = 'bold 9.5px "Outfit", sans-serif';
            ctx.fillStyle = sec.border;
            ctx.textAlign = 'center';
            ctx.fillText(sec.name, sx, sy - sr - 4);
        });

        // 3. Render 25 Pin Sensor Extensometer ECW
        renderedPinCoords = [];

        // Gabungkan dengan telemetri live
        const allSensors = [];
        (window.latestDevicesData || []).forEach(d => {
            (d.sensors || []).forEach(s => allSensors.push(s));
        });

        ECW_PINS.forEach(p => {
            if (mapFilterArea !== 'ALL' && !p.area.toLowerCase().includes(mapFilterArea.toLowerCase())) {
                return;
            }

            const px = startX + ((p.e - MINE_BOUNDS.minE) / (MINE_BOUNDS.maxE - MINE_BOUNDS.minE)) * drawW;
            const py = startY + (1 - (p.n - MINE_BOUNDS.minN) / (MINE_BOUNDS.maxN - MINE_BOUNDS.minN)) * drawH;

            // Cari telemetri sensor
            const uid = p.uniqueId.toLowerCase();
            const extId = p.extensoId.toLowerCase();
            const liveSensor = allSensors.find(s => 
                (s.uniqueId && s.uniqueId.toLowerCase() === uid) ||
                (s.sensorName && s.sensorName.toLowerCase().includes(uid)) ||
                (s.sensorCode && s.sensorCode.toLowerCase() === extId)
            );

            const dispVal = liveSensor ? Math.max(Math.abs(liveSensor.latestValue || 0), Math.abs(liveSensor.accumulativeDisplacement || 0)) : 0;
            const isCritical = dispVal > 200 || (liveSensor && liveSensor.alertStatus === 'CRITICAL');
            const isWarning = !isCritical && (liveSensor && liveSensor.alertStatus === 'WARNING');

            renderedPinCoords.push({
                x: px,
                y: py,
                pin: p,
                sensor: liveSensor,
                dispVal,
                isCritical,
                isWarning
            });

            // Efek gelombang radar pulsa
            const pulseR = isCritical ? 18 : 10;
            ctx.beginPath();
            ctx.arc(px, py, pulseR, 0, Math.PI * 2);
            ctx.fillStyle = isCritical ? 'rgba(239, 68, 68, 0.25)' : (isWarning ? 'rgba(245, 158, 11, 0.2)' : 'rgba(16, 185, 129, 0.15)');
            ctx.fill();

            // Lingkaran pin luar
            ctx.beginPath();
            ctx.arc(px, py, 6, 0, Math.PI * 2);
            ctx.fillStyle = isCritical ? '#ef4444' : (isWarning ? '#fbbf24' : '#10b981');
            ctx.fill();
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;
            ctx.stroke();

            // Titik tengah
            ctx.beginPath();
            ctx.arc(px, py, 2.5, 0, Math.PI * 2);
            ctx.fillStyle = '#ffffff';
            ctx.fill();

            // Label Kapsul Sensor
            const labelText = `${p.uniqueId} (${dispVal.toFixed(0)}mm)`;
            ctx.font = 'bold 8.5px "JetBrains Mono", monospace';
            const textWidth = ctx.measureText(labelText).width;
            const padX = 5;
            const pillH = 15;
            const pillY = py - 20;
            const pillX = px - (textWidth / 2) - padX;

            ctx.fillStyle = isCritical ? 'rgba(239, 68, 68, 0.85)' : 'rgba(15, 23, 42, 0.85)';
            ctx.strokeStyle = isCritical ? '#ff6666' : (isWarning ? '#fbbf24' : 'rgba(56, 189, 248, 0.4)');
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.roundRect(pillX, pillY, textWidth + padX * 2, pillH, 4);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.textAlign = 'center';
            ctx.fillText(labelText, px, pillY + 11);
        });
    }

    function checkPinHover(mouseX, mouseY) {
        const tooltip = document.getElementById('mapPinTooltip');
        const wrapper = document.getElementById('pitCanvasWrapper');
        if (!tooltip || !wrapper) return;

        let found = null;
        for (const item of renderedPinCoords) {
            const dist = Math.hypot(item.x - mouseX, item.y - mouseY);
            if (dist <= 14) {
                found = item;
                break;
            }
        }

        if (found) {
            wrapper.style.cursor = 'pointer';
            const p = found.pin;
            const s = found.sensor;
            const statusBadge = found.isCritical 
                ? '<span class="badge bg-danger text-white">KRITIS &gt; 200 mm</span>' 
                : (found.isWarning ? '<span class="badge bg-warning text-dark">Waspada</span>' : '<span class="badge bg-success text-white">Normal</span>');

            tooltip.innerHTML = `
                <div class="fw-bold text-info mb-1" style="font-size: 12px;">
                    <i class="bi bi-geo-alt-fill text-purple me-1"></i>${escapeHtml(p.uniqueId)} (${escapeHtml(p.extensoId)})
                </div>
                <div style="font-size: 10px; color: #94a3b8; margin-bottom: 4px;">
                    Area: <strong class="text-white">${escapeHtml(p.area)}</strong> &bull; Lokasi: ${escapeHtml(p.location)}
                </div>
                <div class="font-monospace text-warning small mb-1" style="font-size: 10.5px;">
                    N: ${p.n.toLocaleString('id-ID')} &bull; E: ${p.e.toLocaleString('id-ID')}
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top border-secondary">
                    <span>Pergeseran: <strong class="${found.isCritical ? 'text-danger' : 'text-success'}">${found.dispVal.toFixed(1)} mm</strong></span>
                    ${statusBadge}
                </div>
                ${s ? `<div class="text-muted small mt-1" style="font-size: 9.5px;">Kecepatan: ${s.velocityPerHour.toFixed(2)} mm/jam &bull; Tren: ${s.movementTrend}</div>` : ''}
            `;

            tooltip.style.left = `${Math.min(wrapper.clientWidth - 270, Math.max(10, found.x + 12))}px`;
            tooltip.style.top = `${Math.min(wrapper.clientHeight - 130, Math.max(10, found.y - 40))}px`;
            tooltip.style.display = 'block';
        } else {
            wrapper.style.cursor = isMapDragging ? 'grabbing' : 'grab';
            tooltip.style.display = 'none';
        }
    }

