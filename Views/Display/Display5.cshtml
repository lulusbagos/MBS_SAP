    function switchLeftView(mode) {
        activeLeftView = mode;
        const btnCards = document.getElementById('btnViewCards');
        const btnMap = document.getElementById('btnViewMap');
        const devContainer = document.getElementById('devicesContainer');
        const mapContainer = document.getElementById('pitMapContainer');
        const panelTitle = document.getElementById('panelLeftTitle');
        const panelIcon = document.getElementById('panelLeftIcon');

        if (mode === 'map') {
            if (btnCards) btnCards.classList.remove('active');
            if (btnMap) btnMap.classList.add('active');
            if (devContainer) devContainer.classList.add('d-none');
            if (mapContainer) mapContainer.classList.remove('d-none');
            if (panelTitle) panelTitle.innerText = 'Peta Ortofoto Spasial Pit (25 Titik Extensometer ECW)';
            if (panelIcon) panelIcon.className = 'bi bi-map-fill text-info';
            initPitMapCanvas();
            renderPitMap();
        } else {
            if (btnMap) btnMap.classList.remove('active');
            if (btnCards) btnCards.classList.add('active');
            if (mapContainer) mapContainer.classList.add('d-none');
