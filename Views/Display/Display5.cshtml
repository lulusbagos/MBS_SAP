        if (btn) btn.classList.toggle('active', autoCycleEnabled);
        if (icon) icon.className = autoCycleEnabled ? 'bi bi-arrow-repeat text-info me-1' : 'bi bi-pause-circle-fill text-muted me-1';
        if (txt) {
            txt.innerText = autoCycleEnabled ? `Auto (${CYCLE_DURATION}s)` : 'Auto (OFF)';
        }
        if (autoCycleEnabled) {
            manualPauseRemaining = 0;
            autoCycleRemaining = CYCLE_DURATION;
        }
