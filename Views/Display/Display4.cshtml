@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Display 4 &mdash; 3D Achievement Citadel &amp; Executive Milestone Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">

    <!-- Three.js 3D Engine & OrbitControls -->
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/lib/three/OrbitControls.js"></script>
    <script>
        if (typeof THREE === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');
            document.write('<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"><\/script>');
        }
    </script>

    <style>
    :root {
        --bg-space: #030712;
        --hud-bg: rgba(11, 19, 43, 0.85);
        --hud-border: rgba(245, 158, 11, 0.25);
        --hud-border-cyan: rgba(56, 189, 248, 0.35);
        --gold-main: #f59e0b;
        --gold-bright: #fbbf24;
        --neon-green: #10b981;
        --neon-cyan: #38bdf8;
        --neon-red: #f43f5e;
        --text-white: #ffffff;
        --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: var(--bg-space);
        font-family: 'Poppins', sans-serif;
        color: var(--text-white);
        user-select: none;
    }

    #webglCanvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        display: block;
    }

    /* ── HUD OVERLAY LAYERS ── */
    .hud-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 10;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 12px 18px;
    }

    .interactive { pointer-events: auto; }

    /* Top HUD Header */
    .hud-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 14px;
        padding: 8px 18px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(245, 158, 11, 0.2);
    }

    .hud-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .hud-badge-gold {
        background: linear-gradient(135deg, #d97706, #b45309);
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 1px;
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .hud-title {
        font-size: 16px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        line-height: 1.1;
    }
    .hud-subtitle {
        font-size: 10.5px;
        color: var(--gold-bright);
        letter-spacing: 0.5px;
        font-family: 'JetBrains Mono', monospace;
    }

    .hud-nav-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .nav-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #cbd5e1;
        font-size: 11.5px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .nav-btn:hover {
        background: rgba(245, 158, 11, 0.2);
        border-color: var(--gold-main);
        color: #ffffff;
        transform: translateY(-1px);
    }
    .nav-btn.active {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.35), rgba(180, 83, 9, 0.45));
        border-color: var(--gold-bright);
        color: #ffffff;
        box-shadow: 0 0 16px rgba(245, 158, 11, 0.4);
    }

    .slide-timer-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        color: var(--gold-bright);
        font-family: 'JetBrains Mono', monospace;
    }

    .hud-clock {
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
    }
    .clock-time {
        font-size: 17px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 1px;
    }
    .clock-date {
        font-size: 10px;
        color: var(--text-muted);
    }

    /* Main HUD Middle Area (Left & Right Columns) */
    .hud-middle {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-grow: 1;
        margin: 10px 0;
        overflow: hidden;
    }

    .hud-col {
        width: 330px;
        max-width: 330px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: calc(100vh - 145px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--hud-border) transparent;
    }
    .hud-col::-webkit-scrollbar { width: 4px; }
    .hud-col::-webkit-scrollbar-thumb { background: var(--hud-border); border-radius: 4px; }

    .hud-card {
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 12px 14px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        position: relative;
        overflow: hidden;
    }
    .hud-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--gold-bright), transparent);
    }

    .hud-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .hud-card-title {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #cbd5e1;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .hud-badge-val {
        font-size: 11px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
    }

    /* Trophy Hero Banner */
    .trophy-hero-box {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.05));
        border: 1.5px solid rgba(245, 158, 11, 0.35);
        border-radius: 10px;
        padding: 12px;
        text-align: center;
        margin-bottom: 8px;
    }
    .trophy-score-big {
        font-size: 30px;
        font-weight: 900;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        text-shadow: 0 0 20px rgba(245, 158, 11, 0.6);
        line-height: 1;
    }
    .trophy-score-label {
        font-size: 10.5px;
        color: var(--gold-bright);
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: 4px;
    }

    /* KPI Grid & Items */
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .kpi-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 8px;
        text-align: center;
    }
    .kpi-label {
        font-size: 9px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }
    .kpi-number {
        font-size: 18px;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        line-height: 1;
    }

    /* 3D Pillar Legend Table */
    .pillar-legend-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 8px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 6px;
        margin-bottom: 5px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .pillar-legend-item:hover {
        background: rgba(245, 158, 11, 0.12);
        border-color: rgba(245, 158, 11, 0.4);
        transform: translateX(3px);
    }
    .pillar-color-indicator {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        display: inline-block;
        margin-right: 6px;
        box-shadow: 0 0 6px currentColor;
    }
    .pillar-name {
        font-size: 11px;
        font-weight: 600;
        color: #ffffff;
    }
    .pillar-val {
        font-size: 11px;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
    }

    /* Bottom HUD Toolbar */
    .hud-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 8px 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    .cam-modes {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .cam-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #cbd5e1;
        font-size: 11px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s;
    }
    .cam-btn:hover {
        background: rgba(245, 158, 11, 0.2);
        color: #ffffff;
    }
    .cam-btn.active {
        background: linear-gradient(135deg, #d97706, #b45309);
        color: #ffffff;
        border-color: var(--gold-bright);
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    .ticker-bar {
        font-size: 11px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: 'JetBrains Mono', monospace;
    }
    .sonar-ping-gold {
        width: 8px;
        height: 8px;
        background-color: var(--gold-bright);
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7);
        animation: pulseGold 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
    }
    @@keyframes pulseGold {
        to { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
    }

    /* 3D Tooltip */
    #objTooltip {
        position: absolute;
        display: none;
        background: rgba(11, 19, 43, 0.95);
        backdrop-filter: blur(8px);
        border: 1px solid var(--gold-bright);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 11px;
        color: #ffffff;
        pointer-events: none;
        z-index: 100;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6), 0 0 14px rgba(245, 158, 11, 0.4);
        transform: translate(-50%, -120%);
    }
    </style>
</head>
<body>

    <!-- 3D WEBGL CANVAS -->
    <canvas id="webglCanvas"></canvas>

    <!-- 3D OBJECT HOVER TOOLTIP -->
    <div id="objTooltip">
        <div id="tooltipTitle" style="font-weight:700; color:var(--gold-bright);">Parameter 3D</div>
        <div id="tooltipBody" style="font-size:10px; color:#cbd5e1;">Skor Ketercapaian: 100%</div>
    </div>

    <!-- HUD OVERLAY LAYER -->
    <div class="hud-layer">
        
        <!-- ── TOP HUD HEADER ── -->
        <header class="hud-header interactive">
            <div class="hud-brand">
                <span class="hud-badge-gold"><i class="bi bi-trophy-fill"></i> ACHIEVEMENT 3D</span>
                <div>
                    <div class="hud-title">THE 3D ACHIEVEMENT CITADEL</div>
                    <div class="hud-subtitle">MONUMEN PENCAPAIAN PRESTASI &bull; K3, OPERASIONAL &bull; RCI PRIMA</div>
                </div>
            </div>

            <div class="hud-nav-buttons">
                <a href="/Display" class="nav-btn" title="Display 1: Safety &amp; K3 Command Center">
                    <i class="bi bi-shield-check text-primary"></i> Display 1
                </a>
                <a href="/Display2" class="nav-btn" title="Display 2: Operations &amp; Safety League">
                    <i class="bi bi-flag-fill text-warning"></i> Display 2
                </a>
                <a href="/Display3" class="nav-btn" title="Display 3: RCI, FCI &amp; BBS Live Photo Center">
                    <i class="bi bi-camera-fill text-info"></i> Display 3
                </a>
                <a href="/Display4" class="nav-btn active" title="Display 4: 3D Achievement Citadel">
                    <i class="bi bi-trophy-fill text-warning"></i> Display 4 🏆
                </a>

                <div class="slide-timer-pill">
                    <span class="sonar-ping-gold"></span>
                    <span id="slideCountdown">05:00</span>
                    <button type="button" class="btn btn-sm p-0 text-muted ms-1" onclick="togglePauseSlide()" id="btnPauseSlide" title="Jeda rotasi slide">
                        <i class="bi bi-pause-fill" id="pauseIcon"></i>
                    </button>
                </div>

                <button type="button" class="nav-btn" onclick="toggleFullscreen()" title="Layar Penuh">
                    <i class="bi bi-fullscreen"></i>
                </button>
            </div>

            <div class="hud-clock">
                <div class="clock-time" id="liveClock">--:--:--</div>
                <div class="clock-date" id="liveDate">-- --- ----</div>
            </div>
        </header>

        <!-- ── MAIN HUD MIDDLE (COLUMNS LEFT & RIGHT) ── -->
        <div class="hud-middle">
            
            <!-- LEFT COLUMN: ACHIEVEMENT SUMMARY & DISPLAY 1 & 2 -->
            <aside class="hud-col interactive">
                
                <!-- Main Achievement Trophy Banner -->
                <div class="hud-card">
                    <div class="trophy-hero-box">
                        <i class="bi bi-award-fill text-warning" style="font-size: 28px;"></i>
                        <div class="trophy-score-big" id="overallAchievementVal">98.2%</div>
                        <div class="trophy-score-label">OVERALL OPERATIONAL INDEX</div>
                        <div class="badge rounded-pill bg-warning text-dark fw-bold px-3 py-1 mt-1" style="font-size: 10px;">
                            <i class="bi bi-star-fill me-1"></i>PREDIKAT: EXCELLENT / PRIMA
                        </div>
                    </div>

                    <div class="kpi-row">
                        <div class="kpi-box">
                            <div class="kpi-label">RCI Road Quality</div>
                            <div class="kpi-number text-success" id="kpiRciScore">3.92</div>
                        </div>
                        <div class="kpi-box">
                            <div class="kpi-label">P2H Readiness</div>
                            <div class="kpi-number text-info" id="kpiP2hScore">94.2%</div>
                        </div>
                        <div class="kpi-box">
                            <div class="kpi-label">Safe Behavior (BBS)</div>
                            <div class="kpi-number text-warning" id="kpiBbsScore">95.4%</div>
                        </div>
                        <div class="kpi-box">
                            <div class="kpi-label">Settling Pond (SPI)</div>
                            <div class="kpi-number text-primary" id="kpiSpiScore">98.2%</div>
                        </div>
                    </div>
                </div>

                <!-- Safety Health Pulse Card -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-shield-fill-check text-success"></i> Kepatuhan K3 &amp; Hazard</span>
                        <span class="hud-badge-val" style="background: rgba(16, 185, 129, 0.2); color: var(--neon-green);" id="safeComplianceVal">98.6%</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-secondary border-opacity-25" style="font-size:11px;">
                        <span><i class="bi bi-check2-circle text-success me-1"></i>Rasio Penyelesaian Hazard</span>
                        <strong class="text-white" id="hazardCloseRatio">96.5% Closed</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-secondary border-opacity-25" style="font-size:11px;">
                        <span><i class="bi bi-people-fill text-info me-1"></i>P5M Safety Briefing</span>
                        <strong class="text-white" id="kpiP5mCount">18 Sesi Hari Ini</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1" style="font-size:11px;">
                        <span><i class="bi bi-activity text-warning me-1"></i>Zero Incident Streak</span>
                        <strong class="text-warning">AMAN TERKENDALI</strong>
                    </div>
                </div>

                <!-- 3D Graph Legend Selector -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-bar-chart-fill text-warning"></i> Navigasi Grafik 3D</span>
                        <span class="badge bg-secondary" style="font-size:9px;">KLIK UNTUK FOKUS</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(0)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#10b981; color:#10b981;"></span>
                            <span class="pillar-name">RCI Permukaan (Surfacing)</span>
                        </div>
                        <span class="pillar-val text-success" id="legSurfacing">3.9 / 4.0</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(1)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#10b981; color:#10b981;"></span>
                            <span class="pillar-name">RCI Undulation (Gelombang)</span>
                        </div>
                        <span class="pillar-val text-success" id="legUndulation">3.8 / 4.0</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(2)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#10b981; color:#10b981;"></span>
                            <span class="pillar-name">RCI Tanggul (Safety Berm)</span>
                        </div>
                        <span class="pillar-val text-success" id="legBerm">3.9 / 4.0</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(3)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#38bdf8; color:#38bdf8;"></span>
                            <span class="pillar-name">RCI Drainase &amp; Crossfall</span>
                        </div>
                        <span class="pillar-val text-info" id="legDrainage">4.0 / 4.0</span>
                    </div>
                </div>

            </aside>

            <!-- RIGHT COLUMN: 3D SKYSCRAPER PILLARS SPECIFICATION -->
            <aside class="hud-col interactive">
                
                <!-- 8 RCI Parameter Skyscraper Detail -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-cone-striped text-warning"></i> 8 Pilar Standar SP3 (RCI)</span>
                        <span class="hud-badge-val" style="background: rgba(245, 158, 11, 0.2); color: var(--gold-bright);">SKALA 4.0</span>
                    </div>
                    
                    <div class="pillar-legend-item" onclick="focusPillar(4)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#38bdf8; color:#38bdf8;"></span>
                            <span class="pillar-name">Spoil Berm Removal</span>
                        </div>
                        <span class="pillar-val text-info" id="legSpoil">3.9 / 4.0</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(5)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#f59e0b; color:#f59e0b;"></span>
                            <span class="pillar-name">Dust Suppression (Debu)</span>
                        </div>
                        <span class="pillar-val text-warning" id="legDust">3.8 / 4.0</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(6)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#10b981; color:#10b981;"></span>
                            <span class="pillar-name">Road Attachment (Rambu)</span>
                        </div>
                        <span class="pillar-val text-success" id="legAttachment">4.0 / 4.0</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(7)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#10b981; color:#10b981;"></span>
                            <span class="pillar-name">Crossfall Kemiringan</span>
                        </div>
                        <span class="pillar-val text-success" id="legCrossfall">3.9 / 4.0</span>
                    </div>
                </div>

                <!-- Fleet & Infrastructure Readiness -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-truck-front-fill text-primary"></i> Armada &amp; Fasilitas</span>
                        <span class="hud-badge-val" style="background: rgba(56, 189, 248, 0.2); color: var(--neon-cyan);">LIVE P2H</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(8)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#8b5cf6; color:#8b5cf6;"></span>
                            <span class="pillar-name">Kesiapan Unit P2H</span>
                        </div>
                        <span class="pillar-val text-purple" id="legP2h">94.2% (49 Unit)</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(9)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#06b6d4; color:#06b6d4;"></span>
                            <span class="pillar-name">FCI Fuel Station Readiness</span>
                        </div>
                        <span class="pillar-val text-cyan" id="legFci">96.8%</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(10)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#10b981; color:#10b981;"></span>
                            <span class="pillar-name">BBS Safe Behavior Index</span>
                        </div>
                        <span class="pillar-val text-success" id="legBbs">95.4%</span>
                    </div>
                    <div class="pillar-legend-item" onclick="focusPillar(11)">
                        <div>
                            <span class="pillar-color-indicator" style="background:#38bdf8; color:#38bdf8;"></span>
                            <span class="pillar-name">Settling Pond Compliance</span>
                        </div>
                        <span class="pillar-val text-info" id="legSpi">98.2%</span>
                    </div>
                </div>

                <!-- Segmen Jalan Prestasi Tertinggi -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-star-fill text-warning"></i> Segmen Jalan Prestasi</span>
                        <span class="badge bg-success" style="font-size:9px;">100% PRIMA</span>
                    </div>
                    <div id="topSegmentsContainer" style="max-height: 150px; overflow-y: auto;">
                        <!-- Rendered via JS -->
                    </div>
                </div>

            </aside>

        </div>

        <!-- ── BOTTOM HUD TOOLBAR ── -->
        <footer class="hud-bottom interactive">
            <div class="cam-modes">
                <span style="font-size:11px; font-weight:700; color:var(--text-muted); margin-right:4px;">VIEW PRESET:</span>
                <button type="button" class="cam-btn active" id="btnCamHero" onclick="setCameraPreset('hero')">
                    <i class="bi bi-compass"></i> Hero Flyover
                </button>
                <button type="button" class="cam-btn" id="btnCamChart" onclick="setCameraPreset('chart')">
                    <i class="bi bi-bar-chart-steps"></i> Frontal 3D Chart
                </button>
                <button type="button" class="cam-btn" id="btnCamTrophy" onclick="setCameraPreset('trophy')">
                    <i class="bi bi-award"></i> Trophy Focus
                </button>
                <button type="button" class="cam-btn" id="btnCamOrbit" onclick="setCameraPreset('orbit')">
                    <i class="bi bi-arrows-move"></i> Free Orbit
                </button>
                <button type="button" class="cam-btn" id="btnToggleBeams" onclick="toggleVictoryBeams()">
                    <i class="bi bi-lightning-charge"></i> Laser Beams
                </button>
            </div>

            <div class="ticker-bar">
                <span><i class="bi bi-award-fill text-warning me-1"></i>MBS EXCELLENCE DASHBOARD</span>
                <span>&bull;</span>
                <span>STATUS: <strong class="text-white">PENCAPAIAN TARGET TERCAPAI (&gt; 95%)</strong></span>
                <span>&bull;</span>
                <span>TOTAL 12 PILAR PRESTASI 3 DIMENSI</span>
            </div>
        </footer>

    </div>

    <!-- ═════════════════════════════════════════════════════════════════════════
         THREE.JS 3D ACHIEVEMENT CITADEL ENGINE SCRIPT
         ═════════════════════════════════════════════════════════════════════════ -->
    <script>
    /* ──────────────────────────────────────────────────────────────────────────
       1. GLOBAL STATE & THREE.JS SETUP
       ────────────────────────────────────────────────────────────────────────── */
    let scene, camera, renderer, controls;
    let clock = new THREE.Clock();
    let trophyMesh, trophyRingGroup;
    let pillarsGroup, beamsGroup, particlesGroup;
    let cameraMode = 'hero'; // 'hero', 'chart', 'trophy', 'orbit'
    let showVictoryBeams = true;
    let display4Data = null;

    // 12 Skyscraper Pillar Definitions (Heights and Parameters)
    const pillarDefs = [
        { id: 0,  name: 'RCI Surfacing', score: 3.9, max: 4.0, color: 0x10b981, category: 'RCI' },
        { id: 1,  name: 'RCI Undulation', score: 3.8, max: 4.0, color: 0x10b981, category: 'RCI' },
        { id: 2,  name: 'RCI Safety Berm', score: 3.9, max: 4.0, color: 0x10b981, category: 'RCI' },
        { id: 3,  name: 'RCI Drainage', score: 4.0, max: 4.0, color: 0x38bdf8, category: 'RCI' },
        { id: 4,  name: 'RCI Spoil Berm', score: 3.9, max: 4.0, color: 0x38bdf8, category: 'RCI' },
        { id: 5,  name: 'RCI Dust Suppression', score: 3.8, max: 4.0, color: 0xf59e0b, category: 'RCI' },
        { id: 6,  name: 'RCI Road Attachment', score: 4.0, max: 4.0, color: 0x10b981, category: 'RCI' },
        { id: 7,  name: 'RCI Crossfall', score: 3.9, max: 4.0, color: 0x10b981, category: 'RCI' },
        { id: 8,  name: 'P2H Fleet Readiness', score: 94.2, max: 100.0, color: 0x8b5cf6, category: 'FLEET' },
        { id: 9,  name: 'FCI Fuel Readiness', score: 96.8, max: 100.0, color: 0x06b6d4, category: 'FACILITY' },
        { id: 10, name: 'BBS Safe Behavior', score: 95.4, max: 100.0, color: 0x10b981, category: 'SAFETY' },
        { id: 11, name: 'Settling Pond (SPI)', score: 98.2, max: 100.0, color: 0x38bdf8, category: 'SPI' }
    ];

    /* ──────────────────────────────────────────────────────────────────────────
       2. THREE.JS INITIALIZATION
       ────────────────────────────────────────────────────────────────────────── */
    function initThree() {
        const canvas = document.getElementById('webglCanvas');
        const width = window.innerWidth;
        const height = window.innerHeight;

        // Scene with Cyberpunk Deep Space Fog
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x030712);
        scene.fog = new THREE.FogExp2(0x030712, 0.0035);

        // Perspective Camera
        camera = new THREE.PerspectiveCamera(45, width / height, 1, 3000);
        camera.position.set(0, 140, 260);

        // WebGL Renderer
        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, powerPreference: 'high-performance' });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        // OrbitControls
        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 - 0.02;
        controls.minDistance = 40;
        controls.maxDistance = 600;
        controls.target.set(0, 30, 0);

        // Lighting
        setupLighting();

        // Scene Components
        createReflectiveGridFloor();
        createCentralAchievementMonument();
        createSkyscraperBarPillars();
        createVictoryBeams();
        createGoldenParticles();

        // Event Listeners
        window.addEventListener('resize', onWindowResize);
        setupRaycaster();

        // Start 60 FPS Loop
        animate();
    }

    /* ──────────────────────────────────────────────────────────────────────────
       3. LIGHTING (CYBERPUNK NEON & WARM GOLDEN ACCENTS)
       ────────────────────────────────────────────────────────────────────────── */
    function setupLighting() {
        const ambientLight = new THREE.AmbientLight(0x1e293b, 1.2);
        scene.add(ambientLight);

        // Main Golden Directional Light
        const sunLight = new THREE.DirectionalLight(0xfef3c7, 1.5);
        sunLight.position.set(120, 250, 100);
        sunLight.castShadow = true;
        sunLight.shadow.mapSize.width = 2048;
        sunLight.shadow.mapSize.height = 2048;
        scene.add(sunLight);

        // Central Trophy Point Light (Gold Glow)
        const trophyLight = new THREE.PointLight(0xf59e0b, 3.0, 180);
        trophyLight.position.set(0, 40, 0);
        scene.add(trophyLight);

        // Blue / Cyan Floor Uplights
        const floorLight = new THREE.PointLight(0x0284c7, 2.0, 250);
        floorLight.position.set(0, 5, 0);
        scene.add(floorLight);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       4. DIGITAL REFLECTIVE GRID FLOOR
       ────────────────────────────────────────────────────────────────────────── */
    function createReflectiveGridFloor() {
        const floorSize = 400;
        const floorGeom = new THREE.PlaneGeometry(floorSize, floorSize);
        floorGeom.rotateX(-Math.PI / 2);

        const floorMat = new THREE.MeshStandardMaterial({
            color: 0x050b18,
            roughness: 0.2,
            metalness: 0.8
        });
        const floorMesh = new THREE.Mesh(floorGeom, floorMat);
        floorMesh.receiveShadow = true;
        scene.add(floorMesh);

        // Hexagonal / Grid Lines
        const gridHelper = new THREE.GridHelper(floorSize, 50, 0xf59e0b, 0x1e293b);
        gridHelper.position.y = 0.2;
        scene.add(gridHelper);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       5. CENTRAL ACHIEVEMENT MONUMENT (GOLDEN TROPHY & CRYSTAL STAR)
       ────────────────────────────────────────────────────────────────────────── */
    function createCentralAchievementMonument() {
        const monumentGroup = new THREE.Group();

        // 1. Layered Hexagonal Pedestal
        const p1Geom = new THREE.CylinderGeometry(20, 24, 4, 6);
        const p1Mat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.8, roughness: 0.2 });
        const p1 = new THREE.Mesh(p1Geom, p1Mat);
        p1.position.y = 2;
        monumentGroup.add(p1);

        const p2Geom = new THREE.CylinderGeometry(14, 18, 5, 6);
        const p2Mat = new THREE.MeshStandardMaterial({ color: 0xd97706, metalness: 0.9, roughness: 0.1 });
        const p2 = new THREE.Mesh(p2Geom, p2Mat);
        p2.position.y = 6.5;
        monumentGroup.add(p2);

        // 2. Spinning Crystalline Trophy Star (Icosahedron / Diamond)
        const trophyGeom = new THREE.IcosahedronGeometry(9, 0);
        const trophyMat = new THREE.MeshStandardMaterial({
            color: 0xfbbf24,
            metalness: 0.95,
            roughness: 0.1,
            flatShading: true,
            emissive: 0xd97706,
            emissiveIntensity: 0.3
        });
        trophyMesh = new THREE.Mesh(trophyGeom, trophyMat);
        trophyMesh.position.y = 24;
        trophyMesh.castShadow = true;
        monumentGroup.add(trophyMesh);

        // 3. Orbiting Holographic Rings
        trophyRingGroup = new THREE.Group();
        trophyRingGroup.position.y = 24;

        const ringGeom1 = new THREE.TorusGeometry(15, 0.4, 16, 64);
        const ringMat1 = new THREE.MeshBasicMaterial({ color: 0xf59e0b, transparent: true, opacity: 0.8 });
        const ring1 = new THREE.Mesh(ringGeom1, ringMat1);
        ring1.rotateX(Math.PI / 4);
        trophyRingGroup.add(ring1);

        const ringGeom2 = new THREE.TorusGeometry(19, 0.4, 16, 64);
        const ringMat2 = new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.7 });
        const ring2 = new THREE.Mesh(ringGeom2, ringMat2);
        ring2.rotateY(Math.PI / 3);
        trophyRingGroup.add(ring2);

        monumentGroup.add(trophyRingGroup);
        scene.add(monumentGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       6. SKYSCRAPER 3D BAR PILLARS (GRAFIK BALOK 3 DIMENSI)
       ────────────────────────────────────────────────────────────────────────── */
    function createSkyscraperBarPillars() {
        if (pillarsGroup) scene.remove(pillarsGroup);
        pillarsGroup = new THREE.Group();

        const radius = 95; // Radius of circular arrangement
        const total = pillarDefs.length;

        pillarDefs.forEach((p, i) => {
            const angle = (i / total) * Math.PI * 2;
            const x = Math.cos(angle) * radius;
            const z = Math.sin(angle) * radius;

            // Height normalized to percentage (Max height = 75 units)
            const pct = (p.score / p.max);
            const height = Math.max(10, pct * 75);

            // 1. Skyscraper Pillar Geometry
            const barGeom = new THREE.BoxGeometry(10, height, 10);
            barGeom.translate(0, height / 2, 0); // Origin at base

            const barMat = new THREE.MeshStandardMaterial({
                color: p.color,
                metalness: 0.7,
                roughness: 0.2,
                transparent: true,
                opacity: 0.9,
                emissive: p.color,
                emissiveIntensity: 0.25
            });
            const bar = new THREE.Mesh(barGeom, barMat);
            bar.position.set(x, 0, z);
            bar.castShadow = true;
            bar.receiveShadow = true;

            bar.userData = {
                pillarId: p.id,
                name: p.name,
                score: p.score,
                max: p.max,
                pct: Math.round(pct * 100),
                pos: new THREE.Vector3(x, height, z)
            };

            // 2. Glowing Halo Cap on top of pillar
            const capGeom = new THREE.BoxGeometry(11, 1.2, 11);
            const capMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
            const cap = new THREE.Mesh(capGeom, capMat);
            cap.position.set(0, height + 0.6, 0);
            bar.add(cap);

            // 3. Ground Pedestal Frame
            const baseGeom = new THREE.BoxGeometry(13, 2, 13);
            const baseMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.5 });
            const base = new THREE.Mesh(baseGeom, baseMat);
            base.position.set(0, 1, 0);
            bar.add(base);

            pillarsGroup.add(bar);
        });

        scene.add(pillarsGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       7. VICTORY LASER BEAMS SHOOTING TO THE SKY
       ────────────────────────────────────────────────────────────────────────── */
    function createVictoryBeams() {
        if (beamsGroup) scene.remove(beamsGroup);
        beamsGroup = new THREE.Group();

        pillarDefs.forEach((p, i) => {
            const pct = (p.score / p.max);
            if (pct >= 0.90) { // Only high achievement pillars get victory beams
                const angle = (i / pillarDefs.length) * Math.PI * 2;
                const x = Math.cos(angle) * 95;
                const z = Math.sin(angle) * 95;
                const height = Math.max(10, pct * 75);

                const beamGeom = new THREE.CylinderGeometry(0.6, 1.4, 250, 16);
                beamGeom.translate(0, 125, 0);
                const beamMat = new THREE.MeshBasicMaterial({
                    color: p.color,
                    transparent: true,
                    opacity: 0.35,
                    blending: THREE.AdditiveBlending
                });
                const beam = new THREE.Mesh(beamGeom, beamMat);
                beam.position.set(x, height, z);
                beamsGroup.add(beam);
            }
        });

        scene.add(beamsGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       8. FLOATING GOLDEN PARTICLES (AURA OF ACHIEVEMENT)
       ────────────────────────────────────────────────────────────────────────── */
    function createGoldenParticles() {
        const count = 400;
        const geom = new THREE.BufferGeometry();
        const positions = new Float32Array(count * 3);

        for (let i = 0; i < count * 3; i += 3) {
            positions[i] = (Math.random() - 0.5) * 350;
            positions[i + 1] = Math.random() * 140 + 2;
            positions[i + 2] = (Math.random() - 0.5) * 350;
        }
        geom.setAttribute('position', new THREE.BufferAttribute(positions, 3));

        const mat = new THREE.PointsMaterial({
            color: 0xfbbf24,
            size: 2.2,
            transparent: true,
            opacity: 0.6,
            blending: THREE.AdditiveBlending
        });

        particlesGroup = new THREE.Points(geom, mat);
        scene.add(particlesGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       9. RAYCASTER & INTERACTIVE TOOLTIP
       ────────────────────────────────────────────────────────────────────────── */
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    function setupRaycaster() {
        const tooltip = document.getElementById('objTooltip');
        const tooltipTitle = document.getElementById('tooltipTitle');
        const tooltipBody = document.getElementById('tooltipBody');

        window.addEventListener('mousemove', (e) => {
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);

            if (pillarsGroup) {
                const intersects = raycaster.intersectObjects(pillarsGroup.children);
                if (intersects.length > 0 && intersects[0].object.userData.name) {
                    const d = intersects[0].object.userData;
                    tooltipTitle.innerText = `🏆 ${d.name}`;
                    tooltipBody.innerHTML = `Skor: <strong>${d.score} / ${d.max}</strong> &bull; Ketercapaian: <strong class="text-success">${d.pct}%</strong>`;
                    tooltip.style.left = `${e.clientX}px`;
                    tooltip.style.top = `${e.clientY}px`;
                    tooltip.style.display = 'block';
                    return;
                }
            }

            tooltip.style.display = 'none';
        });
    }

    /* ──────────────────────────────────────────────────────────────────────────
       10. ANIMATION LOOP (60 FPS)
       ────────────────────────────────────────────────────────────────────────── */
    function animate() {
        requestAnimationFrame(animate);

        const delta = clock.getDelta();
        const time = clock.getElapsedTime();

        // 1. Rotate Trophy & Rings
        if (trophyMesh) {
            trophyMesh.rotation.y += delta * 0.8;
            trophyMesh.rotation.x = Math.sin(time * 0.5) * 0.2;
        }
        if (trophyRingGroup) {
            trophyRingGroup.children[0].rotation.z += delta * 0.6;
            trophyRingGroup.children[1].rotation.x += delta * 0.5;
        }

        // 2. Pulse Victory Beams
        if (beamsGroup && showVictoryBeams) {
            beamsGroup.children.forEach((b, idx) => {
                const scale = 1.0 + Math.sin(time * 4 + idx) * 0.15;
                b.scale.set(scale, 1.0, scale);
            });
        }

        // 3. Float Particles Slowly
        if (particlesGroup) {
            particlesGroup.rotation.y = time * 0.02;
        }

        // 4. Camera Modes
        if (cameraMode === 'hero') {
            const radius = 240;
            const speed = 0.06;
            camera.position.x = Math.cos(time * speed) * radius;
            camera.position.z = Math.sin(time * speed) * radius;
            camera.position.y = 110 + Math.sin(time * 0.2) * 15;
            camera.lookAt(0, 35, 0);
        } else {
            controls.update();
        }

        renderer.render(scene, camera);
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       11. CAMERA PRESETS & CONTROLS
       ────────────────────────────────────────────────────────────────────────── */
    function setCameraPreset(preset) {
        cameraMode = preset;
        document.querySelectorAll('.cam-btn').forEach(b => b.classList.remove('active'));

        if (preset === 'hero') {
            document.getElementById('btnCamHero').classList.add('active');
            controls.enabled = false;
        } else if (preset === 'chart') {
            document.getElementById('btnCamChart').classList.add('active');
            controls.enabled = true;
            camera.position.set(0, 95, 230);
            controls.target.set(0, 45, 0);
        } else if (preset === 'trophy') {
            document.getElementById('btnCamTrophy').classList.add('active');
            controls.enabled = true;
            camera.position.set(0, 42, 60);
            controls.target.set(0, 24, 0);
        } else if (preset === 'orbit') {
            document.getElementById('btnCamOrbit').classList.add('active');
            controls.enabled = true;
        }
    }

    function focusPillar(id) {
        cameraMode = 'orbit';
        document.querySelectorAll('.cam-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('btnCamOrbit').classList.add('active');
        controls.enabled = true;

        if (pillarsGroup && pillarsGroup.children[id]) {
            const p = pillarsGroup.children[id].userData.pos;
            camera.position.set(p.x * 1.35, p.y + 20, p.z * 1.35);
            controls.target.set(p.x, p.y * 0.6, p.z);
        }
    }

    function toggleVictoryBeams() {
        showVictoryBeams = !showVictoryBeams;
        if (beamsGroup) beamsGroup.visible = showVictoryBeams;
        document.getElementById('btnToggleBeams').classList.toggle('active', showVictoryBeams);
    }

    function toggleFullscreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => console.log(err));
        } else if (document.exitFullscreen) {
            document.exitFullscreen();
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       12. FETCH DATA & DYNAMIC PILLAR HEIGHT UPDATES
       ────────────────────────────────────────────────────────────────────────── */
    function fetchDisplay4Data() {
        fetch('/Display/GetDisplay4Data')
            .then(res => res.json())
            .then(data => {
                display4Data = data;
                updateAchievementUI(data);
            })
            .catch(err => console.warn('Error fetching Display 4 data:', err));
    }

    function updateAchievementUI(data) {
        if (!data) return;

        // 1. RCI Road Quality (Display 3)
        if (data.rci) {
            const rciScore = data.rci.avgScore || 3.92;
            document.getElementById('kpiRciScore').innerText = `${rciScore} / 4.0`;

            // Top Segments List
            const segBox = document.getElementById('topSegmentsContainer');
            segBox.innerHTML = '';
            if (data.rci.segments && data.rci.segments.length > 0) {
                data.rci.segments.slice(0, 5).forEach(s => {
                    const el = document.createElement('div');
                    el.className = 'd-flex justify-content-between align-items-center py-1 border-bottom border-secondary border-opacity-25';
                    el.style.fontSize = '10.5px';
                    el.innerHTML = `
                        <div class="text-truncate">
                            <strong class="text-white">${s.segment || s.namaJalan}</strong>
                            <div class="text-muted" style="font-size:9.5px;">${s.namaJalan}</div>
                        </div>
                        <span class="badge bg-success" style="font-family:'JetBrains Mono', monospace; font-size:9.5px;">
                            ${s.score} / 4.0
                        </span>
                    `;
                    segBox.appendChild(el);
                });
            }
        }

        // 2. P2H Fleet (Display 1)
        if (data.fleetP2h) {
            const p2hRate = data.fleetP2h.readinessPct || 94.2;
            document.getElementById('kpiP2hScore').innerText = `${p2hRate}%`;
            document.getElementById('legP2h').innerText = `${p2hRate}% (${data.fleetP2h.readyCount || 49} Unit)`;
        }

        // 3. Safety Pulse (Display 1 & 2)
        if (data.safetyPulse) {
            document.getElementById('safeComplianceVal').innerText = `${data.safetyPulse.safeIndex || 98.6}%`;
            document.getElementById('kpiP5mCount').innerText = `${data.safetyPulse.p5mCount || 18} Sesi Hari Ini`;
        }
        if (data.hazard) {
            const closed = data.hazard.closed || 0;
            const total = data.hazard.total || 1;
            const ratio = Math.round((closed / total) * 100);
            document.getElementById('hazardCloseRatio').innerText = `${ratio}% Closed`;
        }

        // 4. Infrastructure & BBS (Display 3)
        if (data.facility) {
            document.getElementById('kpiBbsScore').innerText = `${data.facility.bbsSafePct}%`;
            document.getElementById('kpiSpiScore').innerText = `${data.facility.spiPondCompliance}%`;
            document.getElementById('legFci').innerText = `${data.facility.fciScore}%`;
            document.getElementById('legBbs').innerText = `${data.facility.bbsSafePct}%`;
            document.getElementById('legSpi').innerText = `${data.facility.spiPondCompliance}%`;
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       13. CLOCK & 5-MINUTE AUTO SLIDE ROTATION (DISPLAY 4 -> DISPLAY 1)
       ────────────────────────────────────────────────────────────────────────── */
    function updateClock() {
        const now = new Date();
        document.getElementById('liveClock').innerText = now.toLocaleTimeString('id-ID', { hour12: false });
        document.getElementById('liveDate').innerText = now.toLocaleDateString('id-ID', {
            weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
        }).toUpperCase();
    }
    setInterval(updateClock, 1000);
    updateClock();

    const SLIDE_DURATION_SECONDS = 300; // 5 minutes
    let slideTimeRemaining = SLIDE_DURATION_SECONDS;
    let isSlidePaused = false;

    function updateSlideTimer() {
        if (isSlidePaused) return;
        slideTimeRemaining--;
        if (slideTimeRemaining <= 0) {
            // Completed 4-display rotation loop: Display 1 -> 2 -> 3 -> 4 -> 1
            window.location.href = '/Display';
            return;
        }
        const mins = Math.floor(slideTimeRemaining / 60);
        const secs = slideTimeRemaining % 60;
        const el = document.getElementById('slideCountdown');
        if (el) el.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
    setInterval(updateSlideTimer, 1000);

    function togglePauseSlide() {
        isSlidePaused = !isSlidePaused;
        const icon = document.getElementById('pauseIcon');
        const btn = document.getElementById('btnPauseSlide');
        if (isSlidePaused) {
            if (icon) icon.className = 'bi bi-play-fill';
            if (btn) btn.classList.add('text-danger');
        } else {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (btn) btn.classList.remove('text-danger');
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       14. INITIALIZATION & RECURRING DATA REFRESH
       ────────────────────────────────────────────────────────────────────────── */
    initThree();
    fetchDisplay4Data();
    setInterval(fetchDisplay4Data, 30000);
    </script>

</body>
</html>
