@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Display 4 &mdash; 3D Mine Digital Twin &amp; Spatial Radar Command Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">

    <!-- Three.js 3D Engine & OrbitControls (Local offline with CDN fallback) -->
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/lib/three/OrbitControls.js"></script>
    <script>
        if (typeof THREE === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');
            document.write('<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"><\/script>');
        }
    </script>

    <style>
    :root {
        --bg-space: #030712;
        --hud-bg: rgba(10, 17, 34, 0.82);
        --hud-border: rgba(56, 189, 248, 0.22);
        --hud-border-glow: rgba(56, 189, 248, 0.6);
        --neon-blue: #38bdf8;
        --neon-cyan: #06b6d4;
        --neon-green: #10b981;
        --neon-amber: #f59e0b;
        --neon-red: #f43f5e;
        --neon-purple: #8b5cf6;
        --text-primary: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: var(--bg-space);
        font-family: 'Poppins', sans-serif;
        color: var(--text-primary);
        user-select: none;
    }

    #webglCanvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        display: block;
    }

    /* ── HUD OVERLAY LAYERS ── */
    .hud-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 10;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 12px 18px;
    }

    .interactive { pointer-events: auto; }

    /* Top HUD Header */
    .hud-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hud-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--hud-border);
        border-radius: 14px;
        padding: 8px 18px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.1);
    }

    .hud-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .hud-badge-3d {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 6px;
        letter-spacing: 1px;
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .hud-title {
        font-size: 16px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        line-height: 1.1;
    }
    .hud-subtitle {
        font-size: 10.5px;
        color: var(--neon-cyan);
        letter-spacing: 0.5px;
        font-family: 'JetBrains Mono', monospace;
    }

    .hud-nav-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .nav-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #cbd5e1;
        font-size: 11.5px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .nav-btn:hover {
        background: rgba(56, 189, 248, 0.18);
        border-color: var(--neon-blue);
        color: #ffffff;
        transform: translateY(-1px);
    }
    .nav-btn.active {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(2, 132, 199, 0.4));
        border-color: var(--neon-cyan);
        color: #ffffff;
        box-shadow: 0 0 14px rgba(56, 189, 248, 0.35);
    }

    .hud-clock {
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
    }
    .clock-time {
        font-size: 17px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 1px;
    }
    .clock-date {
        font-size: 10px;
        color: var(--text-muted);
    }

    /* Main HUD Middle Area (Left & Right Columns) */
    .hud-middle {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-grow: 1;
        margin: 10px 0;
        overflow: hidden;
    }

    .hud-col {
        width: 320px;
        max-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: calc(100vh - 145px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--hud-border) transparent;
    }
    .hud-col::-webkit-scrollbar { width: 4px; }
    .hud-col::-webkit-scrollbar-thumb { background: var(--hud-border); border-radius: 4px; }

    .hud-card {
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 12px 14px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        position: relative;
        overflow: hidden;
    }
    .hud-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--neon-blue), transparent);
    }

    .hud-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .hud-card-title {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #cbd5e1;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .hud-badge-val {
        font-size: 11px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
    }

    /* KPI Grid & Items */
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .kpi-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 8px;
        text-align: center;
    }
    .kpi-label {
        font-size: 9.5px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }
    .kpi-number {
        font-size: 18px;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        line-height: 1;
    }

    /* Mini Progress Bar */
    .hud-prog-item { margin-bottom: 6px; }
    .hud-prog-meta {
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: var(--text-muted);
        margin-bottom: 2px;
    }
    .hud-prog-bar {
        height: 5px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        overflow: hidden;
    }
    .hud-prog-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.6s ease;
    }

    /* Hazard Radar List */
    .hazard-radar-item {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 7px 10px;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        transition: all 0.2s;
    }
    .hazard-radar-item:hover {
        background: rgba(56, 189, 248, 0.08);
        border-color: rgba(56, 189, 248, 0.4);
        transform: translateX(3px);
    }
    .hazard-radar-title {
        font-size: 11px;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
    }
    .hazard-radar-sub {
        font-size: 9.5px;
        color: var(--text-muted);
    }
    .btn-focus-cam {
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: var(--neon-blue);
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
        flex-shrink: 0;
    }
    .btn-focus-cam:hover {
        background: var(--neon-blue);
        color: #000000;
    }

    /* Bottom HUD Toolbar */
    .hud-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hud-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 8px 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
    .cam-modes {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .cam-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #cbd5e1;
        font-size: 11px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s;
    }
    .cam-btn:hover {
        background: rgba(56, 189, 248, 0.15);
        color: #ffffff;
    }
    .cam-btn.active {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #ffffff;
        border-color: var(--neon-cyan);
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
    }

    .ticker-bar {
        font-size: 11px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: 'JetBrains Mono', monospace;
    }
    .sonar-ping {
        width: 8px;
        height: 8px;
        background-color: var(--neon-green);
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulseSonar 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
    }
    @@keyframes pulseSonar {
        to { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    }

    /* 3D Object Label Hover Tooltip */
    #objTooltip {
        position: absolute;
        display: none;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(8px);
        border: 1px solid var(--neon-cyan);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 11px;
        color: #ffffff;
        pointer-events: none;
        z-index: 100;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6), 0 0 12px rgba(6, 182, 212, 0.3);
        transform: translate(-50%, -120%);
    }

    /* Slide Pause Pill */
    .slide-timer-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
    }
    </style>
</head>
<body>

    <!-- 3D WEBGL OPENGL CANVAS -->
    <canvas id="webglCanvas"></canvas>

    <!-- 3D OBJECT HOVER TOOLTIP -->
    <div id="objTooltip">
        <div id="tooltipTitle" style="font-weight:700; color:var(--neon-cyan);">Segment Info</div>
        <div id="tooltipBody" style="font-size:10px; color:#cbd5e1;">Skor: 4.00 / 4.00</div>
    </div>

    <!-- HUD OVERLAY LAYER -->
    <div class="hud-layer">
        
        <!-- ── TOP HUD HEADER ── -->
        <header class="hud-header interactive">
            <div class="hud-brand">
                <span class="hud-badge-3d"><i class="bi bi-box"></i> OPENGL 3D</span>
                <div>
                    <div class="hud-title">MBS COMMAND CENTER &bull; DIGITAL TWIN</div>
                    <div class="hud-subtitle">SPATIAL RADAR &bull; RCI ROAD PROFILE &bull; PIT FLEET TELEMETRY</div>
                </div>
            </div>

            <div class="hud-nav-buttons">
                <a href="/Display" class="nav-btn" title="Display 1: Safety &amp; K3 Command Center">
                    <i class="bi bi-shield-check text-primary"></i> Display 1
                </a>
                <a href="/Display2" class="nav-btn" title="Display 2: Operations &amp; Safety League">
                    <i class="bi bi-flag-fill text-warning"></i> Display 2
                </a>
                <a href="/Display3" class="nav-btn" title="Display 3: RCI, FCI &amp; BBS Live Photo Center">
                    <i class="bi bi-camera-fill text-info"></i> Display 3
                </a>
                <a href="/Display4" class="nav-btn active" title="Display 4: 3D Mine Spatial Digital Twin">
                    <i class="bi bi-globe text-cyan"></i> Display 4 🌐
                </a>

                <div class="slide-timer-pill">
                    <span class="sonar-ping"></span>
                    <span id="slideCountdown">05:00</span>
                    <button type="button" class="btn btn-sm p-0 text-muted ms-1" onclick="togglePauseSlide()" id="btnPauseSlide" title="Jeda rotasi slide">
                        <i class="bi bi-pause-fill" id="pauseIcon"></i>
                    </button>
                </div>

                <button type="button" class="nav-btn" onclick="toggleFullscreen()" title="Layar Penuh">
                    <i class="bi bi-fullscreen"></i>
                </button>
            </div>

            <div class="hud-clock">
                <div class="clock-time" id="liveClock">--:--:--</div>
                <div class="clock-date" id="liveDate">-- --- ----</div>
            </div>
        </header>

        <!-- ── MAIN HUD MIDDLE (COLUMNS LEFT & RIGHT) ── -->
        <div class="hud-middle">
            
            <!-- LEFT COLUMN: DISPLAY 1 & 2 SAFETY, HAZARD & P2H -->
            <aside class="hud-col interactive">
                
                <!-- Safety Health Pulse Card -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-heart-pulse-fill text-danger"></i> Safety Pulse (K3)</span>
                        <span class="hud-badge-val" style="background: rgba(16, 185, 129, 0.2); color: var(--neon-green);" id="safeIndexVal">98.6%</span>
                    </div>
                    <div class="kpi-row">
                        <div class="kpi-box">
                            <div class="kpi-label">Open Hazard</div>
                            <div class="kpi-number text-warning" id="kpiOpenHazard">0</div>
                        </div>
                        <div class="kpi-box">
                            <div class="kpi-label">Closed Hazard</div>
                            <div class="kpi-number text-success" id="kpiClosedHazard">0</div>
                        </div>
                        <div class="kpi-box">
                            <div class="kpi-label">P5M Hari Ini</div>
                            <div class="kpi-number text-info" id="kpiP5m">0</div>
                        </div>
                        <div class="kpi-box">
                            <div class="kpi-label">Critical / KTA</div>
                            <div class="kpi-number text-danger" id="kpiCriticalHazard">0</div>
                        </div>
                    </div>
                </div>

                <!-- P2H Fleet Readiness Card -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-truck-front-fill text-primary"></i> Armada P2H Aktif</span>
                        <span class="hud-badge-val" style="background: rgba(56, 189, 248, 0.2); color: var(--neon-blue);" id="p2hRateVal">94.2%</span>
                    </div>
                    <div class="hud-prog-item">
                        <div class="hud-prog-meta">
                            <span>Unit Siap Operasi</span>
                            <span id="p2hReadyLabel">49 / 52 Unit</span>
                        </div>
                        <div class="hud-prog-bar">
                            <div class="hud-prog-fill" style="width: 94%; background: linear-gradient(90deg, #0284c7, #10b981);" id="p2hFill"></div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2" style="font-size:10px; color:var(--text-muted);">
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i>Layak Jalan: <strong class="text-white" id="p2hReadyCount">49</strong></span>
                        <span><i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Defect: <strong class="text-white" id="p2hDefectCount">3</strong></span>
                    </div>
                </div>

                <!-- 3D Spatial Hazard Radar List -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-radar text-cyan"></i> Hazard Spatial Radar</span>
                        <span class="badge rounded-pill bg-danger" style="font-size:9px;" id="badgeHazardCount">0 PINS</span>
                    </div>
                    <div id="hazardRadarContainer" style="max-height: 200px; overflow-y: auto;">
                        <!-- Rendered via JS -->
                    </div>
                </div>

            </aside>

            <!-- RIGHT COLUMN: DISPLAY 3 RCI HAULING ROAD, 8 PARAMETERS & INFRASTRUCTURE -->
            <aside class="hud-col interactive">
                
                <!-- RCI Road Condition Card -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-cone-striped text-warning"></i> RCI Road Index</span>
                        <span class="hud-badge-val" style="background: rgba(16, 185, 129, 0.25); color: var(--neon-green);" id="rciAvgScoreBadge">3.92 / 4.00</span>
                    </div>
                    <div class="kpi-row">
                        <div class="kpi-box">
                            <div class="kpi-label">Pita Segmen Baik</div>
                            <div class="kpi-number text-success" id="kpiRciBaik">0</div>
                        </div>
                        <div class="kpi-box">
                            <div class="kpi-label">Segmen Perhatian</div>
                            <div class="kpi-number text-warning" id="kpiRciSedang">0</div>
                        </div>
                    </div>

                    <!-- 8 Parameter Mini Gauges -->
                    <div class="mt-3">
                        <div class="hud-prog-item">
                            <div class="hud-prog-meta"><span>Surfacing (Batu Lepas)</span><span id="valSurfacing">3.9 / 4</span></div>
                            <div class="hud-prog-bar"><div class="hud-prog-fill" style="width: 98%; background: #10b981;" id="barSurfacing"></div></div>
                        </div>
                        <div class="hud-prog-item">
                            <div class="hud-prog-meta"><span>Undulation (Bergelombang)</span><span id="valUndulation">3.8 / 4</span></div>
                            <div class="hud-prog-bar"><div class="hud-prog-fill" style="width: 95%; background: #10b981;" id="barUndulation"></div></div>
                        </div>
                        <div class="hud-prog-item">
                            <div class="hud-prog-meta"><span>Safety Berm (Tanggul)</span><span id="valBerm">3.9 / 4</span></div>
                            <div class="hud-prog-bar"><div class="hud-prog-fill" style="width: 98%; background: #10b981;" id="barBerm"></div></div>
                        </div>
                        <div class="hud-prog-item">
                            <div class="hud-prog-meta"><span>Drainage &amp; Crossfall</span><span id="valDrainage">4.0 / 4</span></div>
                            <div class="hud-prog-bar"><div class="hud-prog-fill" style="width: 100%; background: #10b981;" id="barDrainage"></div></div>
                        </div>
                    </div>
                </div>

                <!-- Field Infrastructure Compliance (FCI, BBS, SPI) -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-buildings-fill text-info"></i> Fasilitas &amp; Lingkungan</span>
                        <span class="hud-badge-val" style="background: rgba(56, 189, 248, 0.2); color: var(--neon-blue);">SP3 AKTIF</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-secondary border-opacity-25" style="font-size:11px;">
                        <span><i class="bi bi-fuel-pump text-primary me-1"></i>FCI Fuel Readiness</span>
                        <strong class="text-white" id="fciVal">96.8%</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-secondary border-opacity-25" style="font-size:11px;">
                        <span><i class="bi bi-person-check-fill text-success me-1"></i>BBS Perilaku Selamat</span>
                        <strong class="text-white" id="bbsVal">95.4%</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1" style="font-size:11px;">
                        <span><i class="bi bi-droplet-half text-cyan me-1"></i>Settling Pond (SPI)</span>
                        <strong class="text-white" id="spiVal">98.2%</strong>
                    </div>
                </div>

                <!-- Hauling Road Segments Interactive List -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-signpost-split text-warning"></i> Segmen Jalan 3D</span>
                        <span class="badge bg-secondary" style="font-size:9px;" id="badgeSegmentCount">0 STA</span>
                    </div>
                    <div id="segmentListContainer" style="max-height: 180px; overflow-y: auto;">
                        <!-- Rendered via JS -->
                    </div>
                </div>

            </aside>

        </div>

        <!-- ── BOTTOM HUD TOOLBAR ── -->
        <footer class="hud-bottom interactive">
            <div class="cam-modes">
                <span style="font-size:11px; font-weight:700; color:var(--text-muted); margin-right:4px;">KAMERA:</span>
                <button type="button" class="cam-btn active" id="btnCamDrone" onclick="setCameraMode('drone')">
                    <i class="bi bi-compass"></i> Drone Patrol
                </button>
                <button type="button" class="cam-btn" id="btnCamSat" onclick="setCameraMode('satellite')">
                    <i class="bi bi-map"></i> Top-Down GIS
                </button>
                <button type="button" class="cam-btn" id="btnCamPov" onclick="setCameraMode('pov')">
                    <i class="bi bi-truck"></i> Haul Road POV
                </button>
                <button type="button" class="cam-btn" id="btnCamReset" onclick="resetCamera()">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset View
                </button>
                <button type="button" class="cam-btn" id="btnToggleWireframe" onclick="toggleWireframe()">
                    <i class="bi bi-grid-3x3"></i> Wireframe
                </button>
            </div>

            <div class="ticker-bar">
                <span><i class="bi bi-geo-alt-fill text-danger me-1"></i>CPP33 - EXIT PIT HAUL ROUTE</span>
                <span>&bull;</span>
                <span>ELEVASI: <strong class="text-white">RL +45m s/d +110m</strong></span>
                <span>&bull;</span>
                <span id="fleetStatusText"><i class="bi bi-truck text-primary me-1"></i>5 DUMP TRUCK AKTIF BERGERAK</span>
            </div>
        </footer>

    </div>

    <!-- ═════════════════════════════════════════════════════════════════════════
         THREE.JS 3D ENGINE & CONTROLLER SCRIPT
         ═════════════════════════════════════════════════════════════════════════ -->
    <script>
    /* ──────────────────────────────────────────────────────────────────────────
       1. GLOBAL STATE & CONFIGURATION
       ────────────────────────────────────────────────────────────────────────── */
    let scene, camera, renderer, controls;
    let terrainMesh, roadGroup, hazardGroup, trucksGroup, radarBeamMesh;
    let cameraMode = 'drone'; // 'drone', 'satellite', 'pov', 'manual'
    let isWireframe = false;
    let clock = new THREE.Clock();
    let display4Data = null;

    // Haul Road Spline Curve in 3D Mine Coordinates
    const roadPoints = [
        new THREE.Vector3(-180, 22, -140), // CPP33 ROM Stockpile
        new THREE.Vector3(-120, 18, -100),
        new THREE.Vector3(-60,  15, -60),
        new THREE.Vector3(-10,  12, -20),
        new THREE.Vector3(30,   9,  30),
        new THREE.Vector3(80,   7,  70),
        new THREE.Vector3(130,  5,  110),
        new THREE.Vector3(170,  3,  150),  // Exit Pit / Port
    ];
    const roadCurve = new THREE.CatmullRomCurve3(roadPoints);

    // Fleet Trucks Moving on Road
    const trucks = [
        { id: 'HD-777-01', t: 0.10, speed: 0.022, mesh: null, color: 0xf59e0b },
        { id: 'HD-777-02', t: 0.35, speed: 0.025, mesh: null, color: 0x38bdf8 },
        { id: 'HD-777-03', t: 0.65, speed: 0.020, mesh: null, color: 0x10b981 },
        { id: 'WT-02-WATER', t: 0.85, speed: 0.015, mesh: null, color: 0x06b6d4 },
    ];

    /* ──────────────────────────────────────────────────────────────────────────
       2. THREE.JS INITIALIZATION
       ────────────────────────────────────────────────────────────────────────── */
    function initThree() {
        const canvas = document.getElementById('webglCanvas');
        const width = window.innerWidth;
        const height = window.innerHeight;

        // Scene with Atmospheric Fog
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x050a17);
        scene.fog = new THREE.FogExp2(0x050a17, 0.0028);

        // Perspective Camera
        camera = new THREE.PerspectiveCamera(45, width / height, 1, 2500);
        camera.position.set(220, 160, 260);

        // WebGL Renderer
        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, powerPreference: 'high-performance' });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        // OrbitControls
        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 - 0.05; // Don't clip underground
        controls.minDistance = 30;
        controls.maxDistance = 650;
        controls.target.set(0, 10, 0);

        // Lighting
        setupLighting();

        // 3D Elements
        createTerrain();
        createSettlingPond();
        createHaulRoad();
        createRadarScanner();
        createTrucks();
        createAtmosphereParticles();

        // Event Listeners
        window.addEventListener('resize', onWindowResize);
        setupRaycaster();

        // Start Animation Loop
        animate();
    }

    /* ──────────────────────────────────────────────────────────────────────────
       3. LIGHTING & ATMOSPHERE
       ────────────────────────────────────────────────────────────────────────── */
    function setupLighting() {
        const ambientLight = new THREE.AmbientLight(0x38bdf8, 0.45);
        scene.add(ambientLight);

        // Main Sun Light (warm industrial sunlight)
        const sunLight = new THREE.DirectionalLight(0xfff7ed, 1.2);
        sunLight.position.set(150, 300, 120);
        sunLight.castShadow = true;
        sunLight.shadow.mapSize.width = 2048;
        sunLight.shadow.mapSize.height = 2048;
        sunLight.shadow.camera.near = 10;
        sunLight.shadow.camera.far = 800;
        const d = 250;
        sunLight.shadow.camera.left = -d;
        sunLight.shadow.camera.right = d;
        sunLight.shadow.camera.top = d;
        sunLight.shadow.camera.bottom = -d;
        scene.add(sunLight);

        // Cyan Accent Light for Pit Bottom
        const pitLight = new THREE.PointLight(0x06b6d4, 1.5, 300);
        pitLight.position.set(0, 10, 0);
        scene.add(pitLight);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       4. PROCEDURAL TOPOGRAPHICAL MINE TERRAIN & BENCHES
       ────────────────────────────────────────────────────────────────────────── */
    function createTerrain() {
        const size = 500;
        const segments = 100;
        const geom = new THREE.PlaneGeometry(size, size, segments, segments);
        geom.rotateX(-Math.PI / 2);

        const pos = geom.attributes.position;
        for (let i = 0; i < pos.count; i++) {
            const x = pos.getX(i);
            const z = pos.getZ(i);
            const dist = Math.sqrt(x * x + z * z);

            // Stepped Pit Benches
            let height = 0;
            if (dist < 70) {
                height = 2; // Pit Bottom
            } else if (dist < 140) {
                height = 12 + Math.sin(dist * 0.15) * 2; // Bench 1
            } else if (dist < 200) {
                height = 26 + Math.sin(dist * 0.12) * 3; // Bench 2
            } else {
                height = 42 + Math.sin(x * 0.05) * 4 + Math.cos(z * 0.05) * 4; // Highwall & Natural Ridge
            }

            // Hauling Road Valley cut
            const roadDist = Math.abs(z - (x * 0.9));
            if (roadDist < 25) {
                height = Math.min(height, 10 + (x + 180) * 0.04);
            }

            pos.setY(i, height);
        }
        geom.computeVertexNormals();

        // Custom Mine Soil & Rock Material
        const mat = new THREE.MeshStandardMaterial({
            color: 0x1e293b,
            roughness: 0.85,
            metalness: 0.15,
            flatShading: true,
        });

        terrainMesh = new THREE.Mesh(geom, mat);
        terrainMesh.receiveShadow = true;
        scene.add(terrainMesh);

        // Contour Grid Lines (Digital Twin Wireframe Effect)
        const wireframeMat = new THREE.MeshBasicMaterial({
            color: 0x0284c7,
            wireframe: true,
            transparent: true,
            opacity: 0.12
        });
        const wireMesh = new THREE.Mesh(geom, wireframeMat);
        wireMesh.position.y += 0.2;
        scene.add(wireMesh);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       5. SETTLING POND WATER BODY (SPI REFLECTION)
       ────────────────────────────────────────────────────────────────────────── */
    function createSettlingPond() {
        const pondGeom = new THREE.CircleGeometry(45, 32);
        pondGeom.rotateX(-Math.PI / 2);
        const pondMat = new THREE.MeshStandardMaterial({
            color: 0x0284c7,
            metalness: 0.8,
            roughness: 0.1,
            transparent: true,
            opacity: 0.75
        });
        const pond = new THREE.Mesh(pondGeom, pondMat);
        pond.position.set(-60, 3.2, 50);
        scene.add(pond);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       6. 3D HAULING ROAD RIBBON (COLOR-CODED RCI SEGMENTS)
       ────────────────────────────────────────────────────────────────────────── */
    function createHaulRoad() {
        if (roadGroup) scene.remove(roadGroup);
        roadGroup = new THREE.Group();

        const numSegments = 16;
        const roadWidth = 10;

        for (let i = 0; i < numSegments; i++) {
            const tStart = i / numSegments;
            const tEnd = (i + 1) / numSegments;

            const p1 = roadCurve.getPointAt(tStart);
            const p2 = roadCurve.getPointAt(tEnd);

            const dir = new THREE.Vector3().subVectors(p2, p1).normalize();
            const normal = new THREE.Vector3(-dir.z, 0, dir.x).normalize().multiplyScalar(roadWidth / 2);

            // Plane for this road segment
            const segGeom = new THREE.BufferGeometry();
            const vertices = new Float32Array([
                p1.x - normal.x, p1.y + 0.3, p1.z - normal.z,
                p1.x + normal.x, p1.y + 0.3, p1.z + normal.z,
                p2.x - normal.x, p2.y + 0.3, p2.z - normal.z,

                p1.x + normal.x, p1.y + 0.3, p1.z + normal.z,
                p2.x + normal.x, p2.y + 0.3, p2.z + normal.z,
                p2.x - normal.x, p2.y + 0.3, p2.z - normal.z,
            ]);
            segGeom.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
            segGeom.computeVertexNormals();

            // Default color emerald, updated dynamically by RCI scores
            const segMat = new THREE.MeshStandardMaterial({
                color: (i === 4 || i === 9) ? 0xf59e0b : 0x10b981, // sample highlights
                roughness: 0.6,
                metalness: 0.2,
                side: THREE.DoubleSide
            });

            const segMesh = new THREE.Mesh(segGeom, segMat);
            segMesh.userData = {
                segmentIndex: i,
                name: `Sta ${i * 100}+000 - ${(i + 1) * 100}+000`,
                score: (i === 4 || i === 9) ? 3.45 : 3.95,
                kategori: (i === 4 || i === 9) ? 'Sedang' : 'Baik'
            };
            roadGroup.add(segMesh);

            // Guard Berm Wall on Road Shoulder
            const bermGeom = new THREE.BoxGeometry(0.8, 1.4, p1.distanceTo(p2));
            const bermMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.9 });
            const berm = new THREE.Mesh(bermGeom, bermMat);
            berm.position.copy(p1).add(p2).multiplyScalar(0.5);
            berm.position.add(normal);
            berm.position.y += 0.8;
            berm.lookAt(p2.clone().add(normal));
            roadGroup.add(berm);
        }

        scene.add(roadGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       7. 3D GEOTECHNICAL SSR RADAR SCANNER (ROTATING CONE)
       ────────────────────────────────────────────────────────────────────────── */
    function createRadarScanner() {
        const radarGroup = new THREE.Group();
        radarGroup.position.set(-110, 32, -60); // Placed on top of highwall overlooking the pit

        // Radar Dish Base Tower
        const baseGeom = new THREE.CylinderGeometry(1.5, 2.5, 8, 8);
        const baseMat = new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.5 });
        const baseMesh = new THREE.Mesh(baseGeom, baseMat);
        radarGroup.add(baseMesh);

        // Radar Sweeping Cone (Transparent glowing beam)
        const coneGeom = new THREE.ConeGeometry(90, 160, 32, 1, true);
        coneGeom.rotateX(Math.PI / 2);
        const coneMat = new THREE.MeshBasicMaterial({
            color: 0x06b6d4,
            transparent: true,
            opacity: 0.08,
            side: THREE.DoubleSide,
            wireframe: false
        });
        radarBeamMesh = new THREE.Mesh(coneGeom, coneMat);
        radarBeamMesh.position.set(0, 4, 0);
        radarGroup.add(radarBeamMesh);

        scene.add(radarGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       8. 3D FLEET HAUL TRUCKS (MOVING ON ROAD)
       ────────────────────────────────────────────────────────────────────────── */
    function createTrucks() {
        trucksGroup = new THREE.Group();

        trucks.forEach(t => {
            const truckMesh = new THREE.Group();

            // Truck Body (Dump Bed)
            const bedGeom = new THREE.BoxGeometry(5.5, 3.2, 8.5);
            const bedMat = new THREE.MeshStandardMaterial({ color: t.color, roughness: 0.4, metalness: 0.6 });
            const bed = new THREE.Mesh(bedGeom, bedMat);
            bed.position.y = 2.8;
            bed.castShadow = true;
            truckMesh.add(bed);

            // Truck Cabin
            const cabGeom = new THREE.BoxGeometry(4.2, 2.4, 3.2);
            const cabMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.5 });
            const cab = new THREE.Mesh(cabGeom, cabMat);
            cab.position.set(0, 3.8, 3.2);
            truckMesh.add(cab);

            // Headlights
            const lightL = new THREE.PointLight(0xfef08a, 1.2, 25);
            lightL.position.set(-1.8, 2.8, 5.0);
            truckMesh.add(lightL);
            const lightR = new THREE.PointLight(0xfef08a, 1.2, 25);
            lightR.position.set(1.8, 2.8, 5.0);
            truckMesh.add(lightR);

            // Big Mining Wheels
            const wheelGeom = new THREE.CylinderGeometry(1.4, 1.4, 1.2, 16);
            wheelGeom.rotateZ(Math.PI / 2);
            const wheelMat = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.9 });
            const wPositions = [
                [-2.8, 1.4, 2.6], [2.8, 1.4, 2.6],
                [-2.8, 1.4, -2.6], [2.8, 1.4, -2.6]
            ];
            wPositions.forEach(wp => {
                const w = new THREE.Mesh(wheelGeom, wheelMat);
                w.position.set(...wp);
                truckMesh.add(w);
            });

            t.mesh = truckMesh;
            trucksGroup.add(truckMesh);
        });

        scene.add(trucksGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       9. 3D ATMOSPHERIC DUST & SPARK PARTICLES
       ────────────────────────────────────────────────────────────────────────── */
    function createAtmosphereParticles() {
        const pCount = 350;
        const geom = new THREE.BufferGeometry();
        const positions = new Float32Array(pCount * 3);

        for (let i = 0; i < pCount * 3; i += 3) {
            positions[i] = (Math.random() - 0.5) * 500;
            positions[i + 1] = Math.random() * 80 + 5;
            positions[i + 2] = (Math.random() - 0.5) * 500;
        }
        geom.setAttribute('position', new THREE.BufferAttribute(positions, 3));

        const mat = new THREE.PointsMaterial({
            color: 0x38bdf8,
            size: 1.8,
            transparent: true,
            opacity: 0.45,
            blending: THREE.AdditiveBlending
        });

        const particles = new THREE.Points(geom, mat);
        scene.add(particles);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       10. 3D HAZARD RADAR BEACONS (PULSING PILLARS & SONAR RINGS)
       ────────────────────────────────────────────────────────────────────────── */
    function renderHazard3DBeacons(hazards) {
        if (hazardGroup) scene.remove(hazardGroup);
        hazardGroup = new THREE.Group();

        if (!hazards || hazards.length === 0) return;

        hazards.slice(0, 15).forEach((h, idx) => {
            // Position spaced along the pit and road corridor
            const tPos = (idx * 0.065) % 0.95;
            const roadPoint = roadCurve.getPointAt(tPos);
            const offsetX = (idx % 2 === 0 ? 1 : -1) * (14 + (idx % 4) * 5);
            const pos = new THREE.Vector3(roadPoint.x + offsetX, roadPoint.y, roadPoint.z);

            const isCritical = h.resiko === 'High' || h.resiko === 'Tinggi';
            const colorHex = isCritical ? 0xf43f5e : 0xf59e0b;

            // 1. Holographic Laser Cylinder
            const cylGeom = new THREE.CylinderGeometry(0.5, 0.5, 45, 12);
            cylGeom.translate(0, 22.5, 0);
            const cylMat = new THREE.MeshBasicMaterial({
                color: colorHex,
                transparent: true,
                opacity: 0.65
            });
            const cyl = new THREE.Mesh(cylGeom, cylMat);
            cyl.position.copy(pos);

            // 2. Sonar Ground Ping Ring
            const ringGeom = new THREE.RingGeometry(2, 6, 32);
            ringGeom.rotateX(-Math.PI / 2);
            const ringMat = new THREE.MeshBasicMaterial({
                color: colorHex,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.5
            });
            const ring = new THREE.Mesh(ringGeom, ringMat);
            ring.position.copy(pos);
            ring.position.y += 0.2;

            // Group
            const pinGroup = new THREE.Group();
            pinGroup.add(cyl);
            pinGroup.add(ring);
            pinGroup.userData = {
                hazardData: h,
                pos: pos
            };

            hazardGroup.add(pinGroup);
        });

        scene.add(hazardGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       11. INTERACTIVE RAYCASTER (HOVER & CLICK DETECTION)
       ────────────────────────────────────────────────────────────────────────── */
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    function setupRaycaster() {
        const tooltip = document.getElementById('objTooltip');
        const tooltipTitle = document.getElementById('tooltipTitle');
        const tooltipBody = document.getElementById('tooltipBody');

        window.addEventListener('mousemove', (e) => {
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);

            // Check road segments
            if (roadGroup) {
                const intersects = raycaster.intersectObjects(roadGroup.children);
                if (intersects.length > 0 && intersects[0].object.userData.name) {
                    const d = intersects[0].object.userData;
                    tooltipTitle.innerText = d.name;
                    tooltipBody.innerHTML = `Skor RCI: <strong>${d.score} / 4.00</strong> (${d.kategori})`;
                    tooltip.style.left = `${e.clientX}px`;
                    tooltip.style.top = `${e.clientY}px`;
                    tooltip.style.display = 'block';
                    return;
                }
            }

            tooltip.style.display = 'none';
        });
    }

    /* ──────────────────────────────────────────────────────────────────────────
       12. ANIMATION LOOP & CAMERA PATROLS
       ────────────────────────────────────────────────────────────────────────── */
    function animate() {
        requestAnimationFrame(animate);

        const delta = clock.getDelta();
        const time = clock.getElapsedTime();

        // 1. Move Haul Trucks along road curve
        trucks.forEach(t => {
            if (t.mesh) {
                t.t = (t.t + t.speed * delta) % 1.0;
                const pos = roadCurve.getPointAt(t.t);
                t.mesh.position.copy(pos);

                // Look at next point ahead
                const nextPos = roadCurve.getPointAt((t.t + 0.01) % 1.0);
                t.mesh.lookAt(nextPos);
            }
        });

        // 2. Rotate Radar Scanner Beam
        if (radarBeamMesh) {
            radarBeamMesh.rotation.z += delta * 1.2;
        }

        // 3. Pulse Hazard Beacons
        if (hazardGroup) {
            hazardGroup.children.forEach((hg, i) => {
                const ring = hg.children[1];
                if (ring) {
                    const scale = 1.0 + Math.sin(time * 3 + i) * 0.4;
                    ring.scale.set(scale, scale, scale);
                }
            });
        }

        // 4. Camera Modes
        if (cameraMode === 'drone') {
            const radius = 280;
            const camSpeed = 0.05;
            camera.position.x = Math.cos(time * camSpeed) * radius;
            camera.position.z = Math.sin(time * camSpeed) * radius;
            camera.position.y = 140 + Math.sin(time * 0.1) * 20;
            camera.lookAt(0, 15, 0);
        } else if (cameraMode === 'pov' && trucks[0].mesh) {
            // Chase camera behind Truck 0
            const truckPos = trucks[0].mesh.position;
            const truckRot = trucks[0].mesh.rotation.y;
            camera.position.set(
                truckPos.x - Math.sin(truckRot) * 25,
                truckPos.y + 12,
                truckPos.z - Math.cos(truckRot) * 25
            );
            camera.lookAt(truckPos.x, truckPos.y + 3, truckPos.z);
        } else {
            controls.update();
        }

        renderer.render(scene, camera);
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       13. CAMERA & DISPLAY CONTROLS
       ────────────────────────────────────────────────────────────────────────── */
    function setCameraMode(mode) {
        cameraMode = mode;
        document.querySelectorAll('.cam-btn').forEach(b => b.classList.remove('active'));

        if (mode === 'drone') {
            document.getElementById('btnCamDrone').classList.add('active');
            controls.enabled = false;
        } else if (mode === 'satellite') {
            document.getElementById('btnCamSat').classList.add('active');
            controls.enabled = true;
            camera.position.set(0, 380, 10);
            camera.lookAt(0, 0, 0);
            controls.target.set(0, 0, 0);
        } else if (mode === 'pov') {
            document.getElementById('btnCamPov').classList.add('active');
            controls.enabled = false;
        }
    }

    function resetCamera() {
        cameraMode = 'manual';
        document.querySelectorAll('.cam-btn').forEach(b => b.classList.remove('active'));
        controls.enabled = true;
        camera.position.set(220, 160, 260);
        controls.target.set(0, 10, 0);
    }

    function toggleWireframe() {
        isWireframe = !isWireframe;
        if (terrainMesh) {
            terrainMesh.material.wireframe = isWireframe;
        }
        const btn = document.getElementById('btnToggleWireframe');
        if (isWireframe) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    }

    function focusHazard(hazardId) {
        if (!hazardGroup) return;
        const target = hazardGroup.children.find(h => h.userData.hazardData && h.userData.hazardData.id === hazardId);
        if (target) {
            cameraMode = 'manual';
            document.querySelectorAll('.cam-btn').forEach(b => b.classList.remove('active'));
            controls.enabled = true;
            const p = target.userData.pos;
            camera.position.set(p.x + 35, p.y + 30, p.z + 35);
            controls.target.copy(p);
        }
    }

    function toggleFullscreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => console.log(err));
        } else if (document.exitFullscreen) {
            document.exitFullscreen();
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       14. FETCH DISPLAY 4 INTEGRATED DATA (RCI, HAZARD, P2H, OPERATIONS)
       ────────────────────────────────────────────────────────────────────────── */
    function fetchDisplay4Data() {
        fetch('/Display/GetDisplay4Data')
            .then(res => res.json())
            .then(data => {
                display4Data = data;
                updateHudUI(data);
                if (data.hazard && data.hazard.points) {
                    renderHazard3DBeacons(data.hazard.points);
                }
            })
            .catch(err => console.warn('Error fetching Display 4 data:', err));
    }

    function updateHudUI(data) {
        // 1. Safety Pulse & Hazards (Display 1)
        if (data.hazard) {
            document.getElementById('kpiOpenHazard').innerText = data.hazard.open || 0;
            document.getElementById('kpiClosedHazard').innerText = data.hazard.closed || 0;
            document.getElementById('kpiCriticalHazard').innerText = data.hazard.critical || 0;
            document.getElementById('badgeHazardCount').innerText = `${data.hazard.points ? data.hazard.points.length : 0} PINS`;

            // Hazard List Container
            const hzBox = document.getElementById('hazardRadarContainer');
            hzBox.innerHTML = '';
            if (data.hazard.points && data.hazard.points.length > 0) {
                data.hazard.points.slice(0, 8).forEach(h => {
                    const isHigh = h.resiko === 'High' || h.resiko === 'Tinggi';
                    const el = document.createElement('div');
                    el.className = 'hazard-radar-item';
                    el.innerHTML = `
                        <div class="text-truncate">
                            <div class="hazard-radar-title text-truncate">
                                <span class="badge ${isHigh ? 'bg-danger' : 'bg-warning text-dark'} py-0 px-1 me-1" style="font-size:8.5px;">${h.resiko}</span>
                                ${h.temuan || h.lokasi}
                            </div>
                            <div class="hazard-radar-sub text-truncate">📍 ${h.lokasi} &bull; ${h.status}</div>
                        </div>
                        <button type="button" class="btn-focus-cam" onclick="focusHazard(${h.id})">
                            <i class="bi bi-crosshair"></i> Fokus
                        </button>
                    `;
                    hzBox.appendChild(el);
                });
            } else {
                hzBox.innerHTML = '<div class="text-muted p-2 text-center" style="font-size:10px;">Semua area hauling aman. Zero open hazard.</div>';
            }
        }

        if (data.safetyPulse) {
            document.getElementById('kpiP5m').innerText = data.safetyPulse.p5mCount || 0;
            document.getElementById('safeIndexVal').innerText = `${data.safetyPulse.safeIndex || 98.6}%`;
        }

        // 2. P2H Fleet Readiness (Display 1)
        if (data.fleetP2h) {
            const ready = data.fleetP2h.readyCount || 0;
            const total = data.fleetP2h.todayCount || 0;
            const defects = data.fleetP2h.breakdownCount || 0;
            const pct = data.fleetP2h.readinessPct || 94.2;

            document.getElementById('p2hRateVal').innerText = `${pct}%`;
            document.getElementById('p2hReadyLabel').innerText = `${ready} / ${total} Unit`;
            document.getElementById('p2hReadyCount').innerText = ready;
            document.getElementById('p2hDefectCount').innerText = defects;
            document.getElementById('p2hFill').style.width = `${pct}%`;
        }

        // 3. RCI Road Index (Display 3)
        if (data.rci) {
            document.getElementById('rciAvgScoreBadge').innerText = `${data.rci.avgScore} / 4.00`;
            document.getElementById('kpiRciBaik').innerText = data.rci.baik || 0;
            document.getElementById('kpiRciSedang').innerText = data.rci.sedang || 0;

            const segBox = document.getElementById('segmentListContainer');
            segBox.innerHTML = '';
            if (data.rci.segments && data.rci.segments.length > 0) {
                document.getElementById('badgeSegmentCount').innerText = `${data.rci.segments.length} STA`;
                data.rci.segments.slice(0, 10).forEach(s => {
                    const isGood = s.score >= 3.8;
                    const el = document.createElement('div');
                    el.className = 'd-flex justify-content-between align-items-center py-1 border-bottom border-secondary border-opacity-25';
                    el.style.fontSize = '10.5px';
                    el.innerHTML = `
                        <div class="text-truncate">
                            <strong>${s.segment || s.namaJalan}</strong>
                            <div class="text-muted" style="font-size:9.5px;">${s.namaJalan}</div>
                        </div>
                        <span class="badge ${isGood ? 'bg-success' : 'bg-warning text-dark'}" style="font-family:'JetBrains Mono', monospace; font-size:9.5px;">
                            ${s.score} / 4
                        </span>
                    `;
                    segBox.appendChild(el);
                });
            }
        }

        // 4. Infrastructure & Facility (Display 3)
        if (data.facility) {
            document.getElementById('fciVal').innerText = `${data.facility.fciScore}%`;
            document.getElementById('bbsVal').innerText = `${data.facility.bbsSafePct}%`;
            document.getElementById('spiVal').innerText = `${data.facility.spiPondCompliance}%`;
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       15. CLOCK & 5-MINUTE AUTO SLIDE ROTATION (DISPLAY 4 -> DISPLAY 1)
       ────────────────────────────────────────────────────────────────────────── */
    function updateClock() {
        const now = new Date();
        document.getElementById('liveClock').innerText = now.toLocaleTimeString('id-ID', { hour12: false });
        document.getElementById('liveDate').innerText = now.toLocaleDateString('id-ID', {
            weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
        }).toUpperCase();
    }
    setInterval(updateClock, 1000);
    updateClock();

    const SLIDE_DURATION_SECONDS = 300; // 5 minutes
    let slideTimeRemaining = SLIDE_DURATION_SECONDS;
    let isSlidePaused = false;

    function updateSlideTimer() {
        if (isSlidePaused) return;
        slideTimeRemaining--;
        if (slideTimeRemaining <= 0) {
            // Completed 4-display rotation loop: Display 1 -> 2 -> 3 -> 4 -> 1
            window.location.href = '/Display';
            return;
        }
        const mins = Math.floor(slideTimeRemaining / 60);
        const secs = slideTimeRemaining % 60;
        const el = document.getElementById('slideCountdown');
        if (el) el.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
    setInterval(updateSlideTimer, 1000);

    function togglePauseSlide() {
        isSlidePaused = !isSlidePaused;
        const icon = document.getElementById('pauseIcon');
        const btn = document.getElementById('btnPauseSlide');
        if (isSlidePaused) {
            if (icon) icon.className = 'bi bi-play-fill';
            if (btn) btn.classList.add('text-danger');
        } else {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (btn) btn.classList.remove('text-danger');
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       16. INITIALIZATION & RECURRING DATA REFRESH
       ────────────────────────────────────────────────────────────────────────── */
    initThree();
    fetchDisplay4Data();
    setInterval(fetchDisplay4Data, 30000); // refresh data every 30s
    </script>

</body>
</html>
