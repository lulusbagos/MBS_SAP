@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Display 4 &mdash; 3D Hazard Analytics: Top 5 KTA &amp; TTA &bull; MTD vs YTD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Three.js 3D Engine & OrbitControls -->
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/lib/three/OrbitControls.js"></script>
    <script>
        if (typeof THREE === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');
            document.write('<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"><\/script>');
        }
    </script>

    <style>
    :root {
        --bg-space: #030712;
        --hud-bg: rgba(7, 13, 31, 0.92);
        --hud-border: rgba(56, 189, 248, 0.35);
        --neon-cyan: #00f0ff;
        --neon-amber: #ff9e00;
        --neon-emerald: #00e676;
        --neon-purple: #c084fc;
        --neon-red: #ff3366;
        --gold-bright: #ffb703;
        --table-green: #007A3D;
        --text-white: #ffffff;
        --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: var(--bg-space);
        font-family: 'Poppins', sans-serif;
        color: var(--text-white);
        user-select: none;
    }

    #webglCanvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        display: block;
    }

    /* ── HUD OVERLAY LAYERS ── */
    .hud-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 10;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 10px 16px;
    }

    .interactive { pointer-events: auto; }

    /* Top HUD Header */
    .hud-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 8px 18px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(56, 189, 248, 0.3);
        margin-bottom: 6px;
    }

    .hud-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .hud-badge-k3 {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        padding: 5px 10px;
        border-radius: 6px;
        letter-spacing: 1px;
        box-shadow: 0 0 16px rgba(0, 240, 255, 0.5);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .hud-title {
        font-size: 16px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        line-height: 1.1;
    }
    .hud-subtitle {
        font-size: 11px;
        color: var(--neon-cyan);
        letter-spacing: 0.5px;
        font-family: 'JetBrains Mono', monospace;
    }

    .hud-nav-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .nav-btn {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #e2e8f0;
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 11px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .nav-btn:hover {
        background: rgba(56, 189, 248, 0.25);
        border-color: var(--neon-cyan);
        color: #ffffff;
        transform: translateY(-1px);
    }
    .nav-btn.active {
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.6), rgba(37, 99, 235, 0.7));
        border-color: var(--neon-cyan);
        color: #ffffff;
        box-shadow: 0 0 16px rgba(0, 240, 255, 0.6);
    }

    .slide-timer-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.4);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        color: var(--neon-cyan);
        font-family: 'JetBrains Mono', monospace;
    }
    .sonar-ping {
        width: 8px;
        height: 8px;
        background-color: var(--neon-cyan);
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(0, 240, 255, 0.8);
        animation: pulseCyan 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
    }
    @@keyframes pulseCyan {
        to { box-shadow: 0 0 0 10px rgba(0, 240, 255, 0); }
    }

    .hud-clock {
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
    }
    .clock-time {
        font-size: 16px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 1px;
    }
    .clock-date {
        font-size: 10px;
        color: var(--text-muted);
    }

    /* ── VIEWPORT FLOATING KPI CHIPS ── */
    .viewport-overlay-kpi {
        display: flex;
        justify-content: space-between;
        pointer-events: none;
        margin-bottom: auto;
    }
    .floating-mini-card {
        background: rgba(10, 18, 42, 0.88);
        border: 1px solid var(--hud-border);
        border-radius: 10px;
        padding: 8px 14px;
        backdrop-filter: blur(10px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* ── BOTTOM DOCKED TABLES SECTION (EXACT SCREENSHOT IMPLEMENTATION) ── */
    .hud-tables-section {
        background: rgba(6, 11, 25, 0.94);
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 12px;
        padding: 10px 14px;
        box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        margin-top: auto;
        transition: all 0.3s ease;
    }

    .tables-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .tables-section-title {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .view-mode-toggle {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .mode-btn {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #cbd5e1;
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .mode-btn:hover, .mode-btn.active {
        background: var(--table-green);
        border-color: #10b981;
        color: #ffffff;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
    }

    .tables-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    /* White Paper Card for Tables with Exact Signature Green Header #007A3D */
    .table-container-card {
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        border: 1px solid #d1d5db;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
        color: #1f2937;
    }
    .report-table thead tr {
        background: var(--table-green);
        height: 36px;
    }
    .report-table thead th {
        color: #ffffff;
        font-weight: 800;
        padding: 7px 10px;
        border: none;
        letter-spacing: 0.3px;
    }
    .report-table tbody tr {
        border-bottom: 1px solid #e5e7eb;
        height: 30px;
        transition: background 0.15s;
    }
    .report-table tbody tr:hover {
        background-color: #f3f4f6;
    }
    .report-table tbody td {
        padding: 6px 10px;
        vertical-align: middle;
    }
    .report-table tfoot tr {
        background: #f8fafc;
        border-top: 2px solid var(--table-green);
        border-bottom: 2px solid var(--table-green);
        height: 34px;
        font-weight: 800;
    }
    .report-table tfoot td {
        padding: 6px 10px;
        color: var(--table-green);
    }

    .cat-name-cell {
        font-weight: 600;
        color: #111827;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .val-cell {
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        color: #1f2937;
    }
    .total-cell {
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 800;
        color: #111827;
    }
    .pct-cell {
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        color: #4b5563;
    }
    .trend-cell {
        text-align: center;
        width: 45px;
    }

    /* Trend Arrows */
    .arrow-up {
        color: #dc2626;
        font-weight: 900;
        font-size: 12px;
    }
    .arrow-down {
        color: #16a34a;
        font-weight: 900;
        font-size: 12px;
    }
    .arrow-same {
        color: #9ca3af;
        font-size: 12px;
    }

    /* ── BOTTOM HUD TOOLBAR ── */
    .hud-bottom-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 8px;
        font-size: 11px;
    }
    .legend-indicators {
        display: flex;
        align-items: center;
        gap: 16px;
        font-weight: 600;
    }
    .legend-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .color-dot {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        display: inline-block;
        box-shadow: 0 0 8px currentColor;
    }

    /* Collapsed state for tables */
    .hud-tables-section.collapsed .tables-grid {
        display: none;
    }
    .hud-tables-section.collapsed {
        padding: 6px 14px;
    }
    </style>
</head>
<body>

    <!-- 3D WEBGL OPENGL CANVAS -->
    <canvas id="webglCanvas"></canvas>

    <!-- HUD OVERLAY LAYER -->
    <div class="hud-layer">
        
        <!-- ── TOP HUD HEADER ── -->
        <header class="hud-header interactive">
            <div class="hud-brand">
                <span class="hud-badge-k3"><i class="bi bi-shield-shaded"></i> 3D HAZARD RADAR</span>
                <div>
                    <div class="hud-title">ANALISIS KATEGORI HAZARD &amp; KOMPARASI WAKTU</div>
                    <div class="hud-subtitle">3D CAROUSEL BARS &bull; TOP 5 KONDISI TIDAK AMAN (KTA) vs TINDAKAN TIDAK AMAN (TTA) &bull; MTD vs YTD</div>
                </div>
            </div>

            <div class="hud-nav-buttons">
                <!-- Rotate Control Button -->
                <button type="button" class="nav-btn" onclick="toggleAutoRotate()" id="btnAutoRotate" title="Jeda / Putar Animasi 3D">
                    <i class="bi bi-arrow-repeat text-info" id="rotateIcon"></i> <span id="rotateStatus">Rotasi: Aktif</span>
                </button>

                <a href="/Display" class="nav-btn" title="Display 1: Safety Command Center">
                    <i class="bi bi-shield-check text-primary"></i> Display 1
                </a>
                <a href="/Display2" class="nav-btn" title="Display 2: Operations &amp; Safety League">
                    <i class="bi bi-flag-fill text-warning"></i> Display 2
                </a>
                <a href="/Display3" class="nav-btn" title="Display 3: RCI, FCI &amp; BBS Live Photo Center">
                    <i class="bi bi-camera-fill text-info"></i> Display 3
                </a>
                <a href="/Display4" class="nav-btn active" title="Display 4: 3D Hazard Analytics">
                    <i class="bi bi-bar-chart-fill text-cyan"></i> Display 4 📊
                </a>

                <div class="slide-timer-pill">
                    <span class="sonar-ping"></span>
                    <span id="slideCountdown">05:00</span>
                    <button type="button" class="btn btn-sm p-0 text-muted ms-1" onclick="togglePauseSlide()" id="btnPauseSlide" title="Jeda rotasi slide">
                        <i class="bi bi-pause-fill" id="pauseIcon"></i>
                    </button>
                </div>

                <button type="button" class="nav-btn" onclick="toggleFullscreen()" title="Layar Penuh">
                    <i class="bi bi-fullscreen"></i>
                </button>
            </div>

            <div class="hud-clock">
                <div class="clock-time" id="liveClock">--:--:--</div>
                <div class="clock-date" id="liveDate">-- --- ----</div>
            </div>
        </header>

        <!-- ── VIEWPORT FLOATING KPI CHIPS ── -->
        <div class="viewport-overlay-kpi interactive">
            <div class="floating-mini-card" style="border-left: 4px solid var(--neon-cyan);">
                <div>
                    <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Podium Kiri &bull; Berputar 360&deg;</div>
                    <div style="font-size: 13px; font-weight: 800; color: var(--neon-cyan);">TOP 5 KONDISI TIDAK AMAN (KTA)</div>
                </div>
                <div style="text-align: right; border-left: 1px solid rgba(255,255,255,0.1); padding-left: 10px;">
                    <div style="font-size: 16px; font-weight: 900; font-family: 'JetBrains Mono', monospace; color: #fff;" id="chipKtaTotal">--</div>
                    <div style="font-size: 10px; color: var(--neon-cyan);" id="chipKtaPct">--% Laporan</div>
                </div>
            </div>

            <div class="floating-mini-card" style="border-left: 4px solid var(--neon-emerald);">
                <div style="text-align: center;">
                    <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Komparasi Periode</div>
                    <div style="font-size: 13px; font-weight: 800; color: #fff;">
                        MTD: <span class="text-success" id="chipMtdTotal">--</span> &bull; 
                        YTD: <span style="color:var(--neon-purple);" id="chipYtdTotal">--</span>
                    </div>
                </div>
            </div>

            <div class="floating-mini-card" style="border-left: 4px solid var(--neon-amber);">
                <div>
                    <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Podium Kanan &bull; Berputar 360&deg;</div>
                    <div style="font-size: 13px; font-weight: 800; color: var(--neon-amber);">TOP 5 TINDAKAN TIDAK AMAN (TTA)</div>
                </div>
                <div style="text-align: right; border-left: 1px solid rgba(255,255,255,0.1); padding-left: 10px;">
                    <div style="font-size: 16px; font-weight: 900; font-family: 'JetBrains Mono', monospace; color: #fff;" id="chipTtaTotal">--</div>
                    <div style="font-size: 10px; color: var(--neon-amber);" id="chipTtaPct">--% Laporan</div>
                </div>
            </div>
        </div>

        <!-- ── BOTTOM DOCKED TABLES (EXACT USER SCREENSHOT) ── -->
        <section class="hud-tables-section interactive" id="tablesSection">
            <div class="tables-header-row">
                <div class="tables-section-title">
                    <i class="bi bi-table text-success"></i>
                    <span>TABEL DATA 3 BULAN &bull; TOP 5 TINDAKAN &amp; KONDISI TIDAK AMAN</span>
                    <span class="badge" style="background:var(--table-green); font-size:10px;" id="badgeMonthsRange">Jul - Sep</span>
                </div>

                <div class="view-mode-toggle">
                    <button type="button" class="mode-btn active" id="btnModeSplit" onclick="setTablesVisible(true)">
                        <i class="bi bi-layout-split me-1"></i>3D + Tabel Lengkap
                    </button>
                    <button type="button" class="mode-btn" id="btnMode3D" onclick="setTablesVisible(false)">
                        <i class="bi bi-boxes me-1"></i>Hanya 3D Skyscraper
                    </button>
                </div>
            </div>

            <!-- DUAL TABLES GRID -->
            <div class="tables-grid" id="tablesGrid">
                
                <!-- 1. LEFT TABLE: TOP 5 UNSAFE ACTION (3 BULAN) -->
                <div class="table-container-card">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th class="ps-3">TOP 5 UNSAFE ACTION (3 BULAN)</th>
                                <th class="text-center" style="width: 55px;" id="thTtaM1">M1</th>
                                <th class="text-center" style="width: 65px;" id="thTtaM2">M2</th>
                                <th class="text-center" style="width: 65px;" id="thTtaM3">M3</th>
                                <th class="text-center" style="width: 60px;">Total</th>
                                <th class="text-center" style="width: 50px;">%</th>
                                <th class="text-center pe-3" style="width: 48px;">Trend</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyTta">
                            <tr><td colspan="7" class="text-center py-3 text-muted">Memuat data 3 bulan Unsafe Action...</td></tr>
                        </tbody>
                        <tfoot id="tfootTta">
                            <tr>
                                <td class="ps-3 fw-bold">TOTAL TOP 5 TTA</td>
                                <td class="text-center fw-bold" id="tfTtaM1">--</td>
                                <td class="text-center fw-bold" id="tfTtaM2">--</td>
                                <td class="text-center fw-bold" id="tfTtaM3">--</td>
                                <td class="text-center fw-bold text-success" id="tfTtaTotal">--</td>
                                <td class="text-center fw-bold" id="tfTtaPct">--%</td>
                                <td class="text-center fw-bold text-success" id="tfTtaTrend">▼</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- 2. RIGHT TABLE: TOP 5 UNSAFE CONDITION (3 BULAN) -->
                <div class="table-container-card">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th class="ps-3">TOP 5 UNSAFE CONDITION (3 BULAN)</th>
                                <th class="text-center" style="width: 55px;" id="thKtaM1">M1</th>
                                <th class="text-center" style="width: 65px;" id="thKtaM2">M2</th>
                                <th class="text-center" style="width: 65px;" id="thKtaM3">M3</th>
                                <th class="text-center" style="width: 60px;">Total</th>
                                <th class="text-center" style="width: 50px;">%</th>
                                <th class="text-center pe-3" style="width: 48px;">Trend</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyKta">
                            <tr><td colspan="7" class="text-center py-3 text-muted">Memuat data 3 bulan Unsafe Condition...</td></tr>
                        </tbody>
                        <tfoot id="tfootKta">
                            <tr>
                                <td class="ps-3 fw-bold">TOTAL TOP 5 KTA</td>
                                <td class="text-center fw-bold" id="tfKtaM1">--</td>
                                <td class="text-center fw-bold" id="tfKtaM2">--</td>
                                <td class="text-center fw-bold" id="tfKtaM3">--</td>
                                <td class="text-center fw-bold text-success" id="tfKtaTotal">--</td>
                                <td class="text-center fw-bold" id="tfKtaPct">--%</td>
                                <td class="text-center fw-bold text-success" id="tfKtaTrend">▼</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>

            <!-- BOTTOM HUD FOOTER -->
            <div class="hud-bottom-bar">
                <div class="legend-indicators">
                    <span style="color:var(--text-muted); font-size:10.5px; text-transform:uppercase;">LEGENDA GRAFIK 3D:</span>
                    <span class="legend-pill"><span class="color-dot" style="background:var(--neon-cyan); color:var(--neon-cyan);"></span> KTA (Kondisi Tidak Aman)</span>
                    <span class="legend-pill"><span class="color-dot" style="background:var(--neon-amber); color:var(--neon-amber);"></span> TTA (Tindakan Tidak Aman)</span>
                    <span class="legend-pill"><span class="color-dot" style="background:var(--neon-emerald); color:var(--neon-emerald);"></span> MTD (Bulan Berjalan)</span>
                    <span class="legend-pill"><span class="color-dot" style="background:var(--neon-purple); color:var(--neon-purple);"></span> YTD (Tahun Berjalan)</span>
                </div>

                <div style="font-family:'JetBrains Mono', monospace; color:var(--text-muted); font-size:10.5px;">
                    <i class="bi bi-tv me-1 text-cyan"></i>WALL DISPLAY AUTO-KIOSK &bull; GRAFIK BERPUTAR 360&deg; AKTIF &bull; ZERO-OVERLAP BILLBOARDS
                </div>
            </div>
        </section>

    </div>

    <!-- ═════════════════════════════════════════════════════════════════════════
         THREE.JS 3D ENGINE SCRIPT (ROTATING 3D CAROUSELS & ZERO OVERLAP BILLBOARDS)
         ═════════════════════════════════════════════════════════════════════════ -->
    <script>
    let scene, camera, renderer, controls;
    let clock = new THREE.Clock();
    let ktaCarousel, ttaCarousel, komparasiGroup, particlesGroup;
    let radarRingLeft, radarRingRight;
    let animatedSprites = [];
    let barMeshes = [];
    let display4Data = null;

    // Rotation & Orbit Controls State
    let isAutoRotate = true;
    let orbitAngle = 0;
    let isUserInteracting = false;
    let userInteractTimer = null;

    /* ──────────────────────────────────────────────────────────────────────────
       1. INITIALIZE THREE.JS SCENE
       ────────────────────────────────────────────────────────────────────────── */
    function initThree() {
        const canvas = document.getElementById('webglCanvas');
        const width = window.innerWidth;
        const height = window.innerHeight;

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x020617);
        scene.fog = new THREE.FogExp2(0x020617, 0.0024);

        camera = new THREE.PerspectiveCamera(45, width / height, 1, 3000);
        camera.position.set(0, 110, 260);

        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, powerPreference: 'high-performance' });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 - 0.02;
        controls.minDistance = 60;
        controls.maxDistance = 650;
        controls.target.set(0, 35, 0);

        // Resume auto-orbit 5s after user stops dragging
        controls.addEventListener('start', () => {
            isUserInteracting = true;
            if (userInteractTimer) clearTimeout(userInteractTimer);
        });
        controls.addEventListener('end', () => {
            userInteractTimer = setTimeout(() => { isUserInteracting = false; }, 4000);
        });

        setupLighting();
        createReflectiveGridFloor();
        createCyberDustParticles();

        window.addEventListener('resize', onWindowResize);
        animate();
    }

    function setupLighting() {
        const ambientLight = new THREE.AmbientLight(0x334155, 2.0);
        scene.add(ambientLight);

        const sunLight = new THREE.DirectionalLight(0xffffff, 2.6);
        sunLight.position.set(80, 240, 160);
        sunLight.castShadow = true;
        scene.add(sunLight);

        // Vibrant Pointlights
        const lightKta = new THREE.PointLight(0x00f0ff, 4.5, 260);
        lightKta.position.set(-80, 45, 10);
        scene.add(lightKta);

        const lightTta = new THREE.PointLight(0xff9e00, 4.5, 260);
        lightTta.position.set(80, 45, 10);
        scene.add(lightTta);

        const lightKomparasi = new THREE.PointLight(0x00e676, 3.2, 200);
        lightKomparasi.position.set(0, 50, -40);
        scene.add(lightKomparasi);
    }

    function createReflectiveGridFloor() {
        const floorGeom = new THREE.PlaneGeometry(650, 650);
        floorGeom.rotateX(-Math.PI / 2);
        const floorMat = new THREE.MeshStandardMaterial({
            color: 0x050b18,
            roughness: 0.12,
            metalness: 0.88
        });
        const floor = new THREE.Mesh(floorGeom, floorMat);
        floor.receiveShadow = true;
        scene.add(floor);

        const gridHelper = new THREE.GridHelper(650, 65, 0x00f0ff, 0x1e293b);
        gridHelper.position.y = 0.15;
        scene.add(gridHelper);
    }

    function createCyberDustParticles() {
        const count = 450;
        const geom = new THREE.BufferGeometry();
        const positions = new Float32Array(count * 3);
        for (let i = 0; i < count * 3; i += 3) {
            positions[i] = (Math.random() - 0.5) * 480;
            positions[i + 1] = Math.random() * 160 + 5;
            positions[i + 2] = (Math.random() - 0.5) * 480;
        }
        geom.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const mat = new THREE.PointsMaterial({
            color: 0x38bdf8,
            size: 2.2,
            transparent: true,
            opacity: 0.65,
            blending: THREE.AdditiveBlending
        });
        particlesGroup = new THREE.Points(geom, mat);
        scene.add(particlesGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       2. ULTRA HIGH-CONTRAST 3D BILLBOARD SPRITE GENERATOR (NO HORIZONTAL OVERLAP)
       ────────────────────────────────────────────────────────────────────────── */
    function createHighContrastBillboard(options) {
        const canvas = document.createElement('canvas');
        canvas.width = 1024;
        canvas.height = 512;
        const ctx = canvas.getContext('2d');

        const borderColor = options.borderColor || '#00f0ff';
        const rankText = options.rankText || '#1';
        const titleText = options.titleText || 'Kategori';
        const valueText = options.valueText || '0 Laporan';
        const subText = options.subText || '';
        const isTrendUp = options.isTrendUp || false;

        // 1. Solid High Contrast Deep Space Navy Background
        ctx.fillStyle = '#050e24';
        ctx.fillRect(0, 0, 1024, 512);

        // 2. Thick Glowing Neon Border
        ctx.strokeStyle = borderColor;
        ctx.lineWidth = 14;
        roundRect(ctx, 12, 12, 1000, 488, 28);
        ctx.stroke();

        // 3. Top Accent Header Banner
        ctx.fillStyle = borderColor;
        ctx.fillRect(12, 12, 1000, 84);

        // Rank Badge
        ctx.fillStyle = '#000000';
        ctx.font = '900 44px "Poppins", sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(rankText, 40, 70);

        ctx.textAlign = 'right';
        ctx.font = '800 32px "Poppins", sans-serif';
        ctx.fillText(options.categoryType || 'HAZARD REPORT', 980, 68);

        // 4. Main Category Name (Pure White, Bold 46px)
        ctx.textAlign = 'center';
        ctx.fillStyle = '#ffffff';
        ctx.font = '900 46px "Poppins", sans-serif';
        let displayTitle = titleText;
        if (displayTitle.length > 25) {
            displayTitle = displayTitle.substring(0, 23) + '...';
        }
        ctx.fillText(displayTitle, 512, 175);

        // 5. Huge Bright Number Value
        ctx.fillStyle = borderColor;
        ctx.font = '900 68px "JetBrains Mono", monospace';
        ctx.fillText(valueText, 512, 275);

        // 6. Subtitle / 3-Month Breakdown Text
        ctx.fillStyle = '#94a3b8';
        ctx.font = '700 34px "JetBrains Mono", monospace';
        ctx.fillText(subText, 512, 365);

        // 7. Trend Tag Pill at Bottom
        const trendBg = isTrendUp ? '#dc2626' : '#16a34a';
        ctx.fillStyle = trendBg;
        roundRect(ctx, 350, 412, 324, 60, 16);
        ctx.fill();

        ctx.fillStyle = '#ffffff';
        ctx.font = '800 32px "Poppins", sans-serif';
        ctx.fillText(isTrendUp ? '▲ TREN NAIK' : '▼ TREN TURUN', 512, 454);

        const texture = new THREE.CanvasTexture(canvas);
        texture.minFilter = THREE.LinearFilter;
        texture.magFilter = THREE.LinearFilter;

        const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: false });
        const sprite = new THREE.Sprite(spriteMat);
        // Compact proportion with ZERO overlap along circular placement
        sprite.scale.set(22, 11, 1);
        return sprite;
    }

    function createPodiumTitleSprite(title, color) {
        const canvas = document.createElement('canvas');
        canvas.width = 1024;
        canvas.height = 256;
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = '#050e24';
        ctx.fillRect(0, 0, 1024, 256);

        ctx.strokeStyle = color;
        ctx.lineWidth = 10;
        roundRect(ctx, 8, 8, 1008, 240, 24);
        ctx.stroke();

        ctx.fillStyle = color;
        ctx.font = '900 48px "Poppins", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(title, 512, 145);

        const texture = new THREE.CanvasTexture(canvas);
        const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: false });
        const sprite = new THREE.Sprite(spriteMat);
        sprite.scale.set(40, 10, 1);
        return sprite;
    }

    function createRadarRingMesh(radius, color) {
        const ringGeom = new THREE.RingGeometry(radius - 0.8, radius + 0.8, 64);
        ringGeom.rotateX(-Math.PI / 2);
        const ringMat = new THREE.MeshBasicMaterial({ color: color, side: THREE.DoubleSide });
        return new THREE.Mesh(ringGeom, ringMat);
    }

    function roundRect(ctx, x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
    }

