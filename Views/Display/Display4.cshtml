    /* ──────────────────────────────────────────────────────────────────────────
       4. ANIMATION LOOP: ACTIVE ROTATION, FLOATING BOBBING & TURNTABLE GLIDE
       ────────────────────────────────────────────────────────────────────────── */
    function animate() {
        requestAnimationFrame(animate);

        const time = clock.getElapsedTime();
        const delta = clock.getDelta();

        // 1. Continuous Carousel 360 Rotation for Both Podiums
        if (isAutoRotate) {
            if (ktaCarousel) ktaCarousel.rotation.y += 0.005;
            if (ttaCarousel) ttaCarousel.rotation.y -= 0.005;

            if (radarRingLeft) radarRingLeft.rotation.z += 0.008;
            if (radarRingRight) radarRingRight.rotation.z -= 0.008;

            // 2. Smooth Cinematic Camera Glide (Turntable Orbit)
            if (!isUserInteracting) {
                orbitAngle += 0.0025;
                camera.position.x = Math.sin(orbitAngle) * 230;
                camera.position.z = Math.cos(orbitAngle) * 230;
                camera.position.y = 105 + Math.sin(time * 0.3) * 10;
                camera.lookAt(0, 34, 0);
            }
        }

        // 3. Floating Levitation Breathing Animation for Billboard Cards
        for (let i = 0; i < animatedSprites.length; i++) {
            const item = animatedSprites[i];
            item.sprite.position.y = item.baseY + Math.sin(time * 2.4 + item.index) * 1.5;
        }

        // 4. Smooth Bar Growth Lerp on Load
        for (let i = 0; i < barMeshes.length; i++) {
            const b = barMeshes[i];
            if (b.mesh.scale.y < b.targetScaleY) {
                b.mesh.scale.y += (b.targetScaleY - b.mesh.scale.y) * 0.08;
            }
        }

        if (particlesGroup) {
            particlesGroup.rotation.y = time * 0.025;
        }

        renderer.render(scene, camera);
    }

    function toggleAutoRotate() {
        isAutoRotate = !isAutoRotate;
        const icon = document.getElementById('rotateIcon');
        const text = document.getElementById('rotateStatus');
        if (isAutoRotate) {
            if (icon) icon.className = 'bi bi-arrow-repeat text-info';
            if (text) text.innerText = 'Rotasi: Aktif';
        } else {
            if (icon) icon.className = 'bi bi-pause-circle text-warning';
            if (text) text.innerText = 'Rotasi: Jeda';
        }
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function toggleFullscreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => console.log(err));
        } else if (document.exitFullscreen) {
            document.exitFullscreen();
        }
    }

    function setTablesVisible(show) {
        const sec = document.getElementById('tablesSection');
        const btnSplit = document.getElementById('btnModeSplit');
        const btn3D = document.getElementById('btnMode3D');

        if (show) {
            sec.classList.remove('collapsed');
            btnSplit.classList.add('active');
            btn3D.classList.remove('active');
        } else {
            sec.classList.add('collapsed');
            btnSplit.classList.remove('active');
            btn3D.classList.add('active');
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       5. FETCH DATA & POPULATE TABLES & 3D BILLBOARDS
       ────────────────────────────────────────────────────────────────────────── */
    function fetchDisplay4Data() {
        fetch('/Display/GetDisplay4Data')
            .then(res => res.json())
            .then(data => {
                display4Data = data;
                renderDualTables(data);
                build3DCharts(data);
                updateHudChips(data);
            })
            .catch(err => console.warn('Error fetching Display 4 data:', err));
    }

    function updateHudChips(data) {
        if (!data) return;
        const totKta = data.totalTop5Kta || {};
        const totTta = data.totalTop5Tta || {};
        const kom = data.komparasi || {};
        const mtd = kom.mtd || {};
        const ytd = kom.ytd || {};

        document.getElementById('chipKtaTotal').innerText = (totKta.total || 0).toLocaleString('id-ID');
        document.getElementById('chipKtaPct').innerText = `${totKta.pct || 0}% Laporan`;

        document.getElementById('chipTtaTotal').innerText = (totTta.total || 0).toLocaleString('id-ID');
        document.getElementById('chipTtaPct').innerText = `${totTta.pct || 0}% Laporan`;

        document.getElementById('chipMtdTotal').innerText = (mtd.total || 0).toLocaleString('id-ID');
        document.getElementById('chipYtdTotal').innerText = (ytd.total || 0).toLocaleString('id-ID');

        if (data.months && data.months.length === 3) {
            document.getElementById('badgeMonthsRange').innerText = `${data.months[0]} - ${data.months[2]}`;
        }
    }

    /* ── POPULATE EXACT DUAL TABLES (UNSAFE ACTION & UNSAFE CONDITION) ── */
    function renderDualTables(data) {
        const months = data.months || ['M1', 'M2', 'M3'];
        const top5Tta = data.top5Tta || [];
        const top5Kta = data.top5Kta || [];
        const totTta = data.totalTop5Tta || {};
        const totKta = data.totalTop5Kta || {};

        // Update Table Headers
        document.getElementById('thTtaM1').innerText = months[0];
        document.getElementById('thTtaM2').innerText = months[1];
        document.getElementById('thTtaM3').innerText = months[2];
        document.getElementById('thKtaM1').innerText = months[0];
        document.getElementById('thKtaM2').innerText = months[1];
        document.getElementById('thKtaM3').innerText = months[2];

        // 1. Render TTA Table
        let htmlTta = '';
        top5Tta.forEach(item => {
            const m2Arrow = renderArrow(item.delta1);
            const m3Arrow = renderArrow(item.delta2);
            const trendBadge = item.trend === 'up'
                ? '<span class="arrow-up" title="Tren Naik">▲</span>'
                : (item.trend === 'down' ? '<span class="arrow-down" title="Tren Turun">▼</span>' : '<span class="arrow-same">━</span>');

            htmlTta += `
                <tr>
                    <td class="cat-name-cell ps-3" title="${item.name}">${item.name}</td>
                    <td class="val-cell">${item.m1.toLocaleString('id-ID')}</td>
                    <td class="val-cell">${item.m2.toLocaleString('id-ID')} ${m2Arrow}</td>
                    <td class="val-cell">${item.m3.toLocaleString('id-ID')} ${m3Arrow}</td>
                    <td class="total-cell">${item.total.toLocaleString('id-ID')}</td>
                    <td class="pct-cell">${item.pct}%</td>
                    <td class="trend-cell pe-3">${trendBadge}</td>
                </tr>
            `;
        });
        document.getElementById('tbodyTta').innerHTML = htmlTta || '<tr><td colspan="7" class="text-center py-2">Data tidak tersedia</td></tr>';

        // TTA Footer
        document.getElementById('tfTtaM1').innerText = (totTta.m1 || 0).toLocaleString('id-ID');
        document.getElementById('tfTtaM2').innerText = (totTta.m2 || 0).toLocaleString('id-ID');
        document.getElementById('tfTtaM3').innerText = (totTta.m3 || 0).toLocaleString('id-ID');
        document.getElementById('tfTtaTotal').innerText = (totTta.total || 0).toLocaleString('id-ID');
        document.getElementById('tfTtaPct').innerText = `${totTta.pct || 0}%`;

        // 2. Render KTA Table
        let htmlKta = '';
        top5Kta.forEach(item => {
            const m2Arrow = renderArrow(item.delta1);
            const m3Arrow = renderArrow(item.delta2);
            const trendBadge = item.trend === 'up'
                ? '<span class="arrow-up" title="Tren Naik">▲</span>'
                : (item.trend === 'down' ? '<span class="arrow-down" title="Tren Turun">▼</span>' : '<span class="arrow-same">━</span>');

            htmlKta += `
                <tr>
                    <td class="cat-name-cell ps-3" title="${item.name}">${item.name}</td>
                    <td class="val-cell">${item.m1.toLocaleString('id-ID')}</td>
                    <td class="val-cell">${item.m2.toLocaleString('id-ID')} ${m2Arrow}</td>
                    <td class="val-cell">${item.m3.toLocaleString('id-ID')} ${m3Arrow}</td>
                    <td class="total-cell">${item.total.toLocaleString('id-ID')}</td>
                    <td class="pct-cell">${item.pct}%</td>
                    <td class="trend-cell pe-3">${trendBadge}</td>
                </tr>
            `;
        });
        document.getElementById('tbodyKta').innerHTML = htmlKta || '<tr><td colspan="7" class="text-center py-2">Data tidak tersedia</td></tr>';

        // KTA Footer
        document.getElementById('tfKtaM1').innerText = (totKta.m1 || 0).toLocaleString('id-ID');
        document.getElementById('tfKtaM2').innerText = (totKta.m2 || 0).toLocaleString('id-ID');
        document.getElementById('tfKtaM3').innerText = (totKta.m3 || 0).toLocaleString('id-ID');
        document.getElementById('tfKtaTotal').innerText = (totKta.total || 0).toLocaleString('id-ID');
        document.getElementById('tfKtaPct').innerText = `${totKta.pct || 0}%`;
    }

    function renderArrow(delta) {
        if (delta > 0) return `<span class="arrow-up" title="+${delta}">▲</span>`;
        if (delta < 0) return `<span class="arrow-down" title="${delta}">▼</span>`;
        return `<span class="arrow-same">━</span>`;
    }

    /* ──────────────────────────────────────────────────────────────────────────
       6. CLOCK & 5-MINUTE AUTO SLIDE ROTATION (DISPLAY 4 -> DISPLAY 1)
       ────────────────────────────────────────────────────────────────────────── */
    function updateClock() {
        const now = new Date();
        document.getElementById('liveClock').innerText = now.toLocaleTimeString('id-ID', { hour12: false });
        document.getElementById('liveDate').innerText = now.toLocaleDateString('id-ID', {
            weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
        }).toUpperCase();
    }
    setInterval(updateClock, 1000);
    updateClock();

    const SLIDE_DURATION_SECONDS = 300; // 5 minutes
    let slideTimeRemaining = SLIDE_DURATION_SECONDS;
    let isSlidePaused = false;

    function updateSlideTimer() {
        if (isSlidePaused) return;
        slideTimeRemaining--;
        if (slideTimeRemaining <= 0) {
            window.location.href = '/Display';
            return;
        }
        const mins = Math.floor(slideTimeRemaining / 60);
        const secs = slideTimeRemaining % 60;
        const el = document.getElementById('slideCountdown');
        if (el) el.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
    setInterval(updateSlideTimer, 1000);

    function togglePauseSlide() {
        isSlidePaused = !isSlidePaused;
        const icon = document.getElementById('pauseIcon');
        const btn = document.getElementById('btnPauseSlide');
        if (isSlidePaused) {
            if (icon) icon.className = 'bi bi-play-fill';
            if (btn) btn.classList.add('text-danger');
        } else {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (btn) btn.classList.remove('text-danger');
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       7. INITIALIZATION
       ────────────────────────────────────────────────────────────────────────── */
    initThree();
    fetchDisplay4Data();
    setInterval(fetchDisplay4Data, 30000);
    </script>

</body>
</html>
