@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Display 4 &mdash; Analisis 3D Hazard: TTA vs KTA &amp; MTD vs YTD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=JetBrains+Mono:wght@400;600;800;900&display=swap" rel="stylesheet">

    <!-- Three.js 3D Engine & OrbitControls -->
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/lib/three/OrbitControls.js"></script>
    <script>
        if (typeof THREE === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');
            document.write('<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"><\/script>');
        }
    </script>

    <style>
    :root {
        --bg-space: #030712;
        --hud-bg: rgba(10, 16, 35, 0.88);
        --hud-border: rgba(56, 189, 248, 0.28);
        --neon-cyan: #38bdf8;
        --neon-amber: #f59e0b;
        --neon-emerald: #10b981;
        --neon-purple: #a855f7;
        --neon-red: #f43f5e;
        --gold-bright: #fbbf24;
        --text-white: #ffffff;
        --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: var(--bg-space);
        font-family: 'Poppins', sans-serif;
        color: var(--text-white);
        user-select: none;
    }

    #webglCanvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        display: block;
    }

    /* ── HUD OVERLAY LAYERS ── */
    .hud-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 10;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 14px 20px;
    }

    .interactive { pointer-events: auto; }

    /* Top HUD Header */
    .hud-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 14px;
        padding: 10px 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(56, 189, 248, 0.25);
    }

    .hud-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .hud-badge-k3 {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        padding: 5px 10px;
        border-radius: 6px;
        letter-spacing: 1px;
        box-shadow: 0 0 16px rgba(56, 189, 248, 0.5);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .hud-title {
        font-size: 17px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        line-height: 1.1;
    }
    .hud-subtitle {
        font-size: 11px;
        color: var(--neon-cyan);
        letter-spacing: 0.5px;
        font-family: 'JetBrains Mono', monospace;
    }

    .hud-nav-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .nav-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #cbd5e1;
        font-size: 11.5px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .nav-btn:hover {
        background: rgba(56, 189, 248, 0.2);
        border-color: var(--neon-cyan);
        color: #ffffff;
        transform: translateY(-1px);
    }
    .nav-btn.active {
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.4), rgba(37, 99, 235, 0.5));
        border-color: var(--neon-cyan);
        color: #ffffff;
        box-shadow: 0 0 16px rgba(56, 189, 248, 0.45);
    }

    .slide-timer-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.3);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 11.5px;
        color: var(--neon-cyan);
        font-family: 'JetBrains Mono', monospace;
    }
    .sonar-ping {
        width: 8px;
        height: 8px;
        background-color: var(--neon-cyan);
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7);
        animation: pulseCyan 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
    }
    @@keyframes pulseCyan {
        to { box-shadow: 0 0 0 10px rgba(56, 189, 248, 0); }
    }

    .hud-clock {
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
    }
    .clock-time {
        font-size: 17px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 1px;
    }
    .clock-date {
        font-size: 10px;
        color: var(--text-muted);
    }

    /* Main HUD Middle Area */
    .hud-middle {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-grow: 1;
        margin: 12px 0;
        overflow: hidden;
    }

    .hud-col {
        width: 340px;
        max-width: 340px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: calc(100vh - 150px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--hud-border) transparent;
    }
    .hud-col::-webkit-scrollbar { width: 4px; }
    .hud-col::-webkit-scrollbar-thumb { background: var(--hud-border); border-radius: 4px; }

    .hud-card {
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 14px 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        position: relative;
        overflow: hidden;
    }
    .hud-card.card-cyan::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
    }
    .hud-card.card-amber::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--neon-amber), transparent);
    }

    .hud-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .hud-card-title {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #f1f5f9;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .hud-badge-val {
        font-size: 11px;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
    }

    /* KPI Row & Box */
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .kpi-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 9px;
        text-align: center;
    }
    .kpi-label {
        font-size: 9.5px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 3px;
    }
    .kpi-number {
        font-size: 20px;
        font-weight: 900;
        font-family: 'JetBrains Mono', monospace;
        line-height: 1;
    }
    .kpi-sub {
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 3px;
    }

    /* Ratio Progress Bar */
    .ratio-bar-wrap {
        margin-top: 10px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 6px;
        overflow: hidden;
        height: 10px;
        display: flex;
    }
    .ratio-bar-kta {
        background: var(--neon-cyan);
        height: 100%;
        transition: width 0.6s ease;
        box-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
    }
    .ratio-bar-tta {
        background: var(--neon-amber);
        height: 100%;
        transition: width 0.6s ease;
        box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
    }

    /* Bottom HUD Toolbar */
    .hud-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hud-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 9px 18px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .legend-indicators {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 11.5px;
        font-weight: 600;
    }
    .legend-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .color-dot {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        display: inline-block;
        box-shadow: 0 0 8px currentColor;
    }

    .ticker-bar {
        font-size: 11px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: 'JetBrains Mono', monospace;
    }
    </style>
</head>
<body>

    <!-- 3D WEBGL OPENGL CANVAS -->
    <canvas id="webglCanvas"></canvas>

    <!-- HUD OVERLAY LAYER -->
    <div class="hud-layer">
        
        <!-- ── TOP HUD HEADER ── -->
        <header class="hud-header interactive">
            <div class="hud-brand">
                <span class="hud-badge-k3"><i class="bi bi-shield-shaded"></i> 3D HAZARD RADAR</span>
                <div>
                    <div class="hud-title">ANALISIS KATEGORI HAZARD &amp; KOMPARASI WAKTU</div>
                    <div class="hud-subtitle">GRAFIK 3 DIMENSI &bull; UNSAFE ACTION (TTA) vs UNSAFE CONDITION (KTA) &bull; MTD vs YTD</div>
                </div>
            </div>

            <div class="hud-nav-buttons">
                <a href="/Display" class="nav-btn" title="Display 1: Safety &amp; K3 Command Center">
                    <i class="bi bi-shield-check text-primary"></i> Display 1
                </a>
                <a href="/Display2" class="nav-btn" title="Display 2: Operations &amp; Safety League">
                    <i class="bi bi-flag-fill text-warning"></i> Display 2
                </a>
                <a href="/Display3" class="nav-btn" title="Display 3: RCI, FCI &amp; BBS Live Photo Center">
                    <i class="bi bi-camera-fill text-info"></i> Display 3
                </a>
                <a href="/Display4" class="nav-btn active" title="Display 4: 3D Hazard Analytics">
                    <i class="bi bi-bar-chart-fill text-cyan"></i> Display 4 📊
                </a>

                <div class="slide-timer-pill">
                    <span class="sonar-ping"></span>
                    <span id="slideCountdown">05:00</span>
                    <button type="button" class="btn btn-sm p-0 text-muted ms-1" onclick="togglePauseSlide()" id="btnPauseSlide" title="Jeda rotasi slide">
                        <i class="bi bi-pause-fill" id="pauseIcon"></i>
                    </button>
                </div>

                <button type="button" class="nav-btn" onclick="toggleFullscreen()" title="Layar Penuh">
                    <i class="bi bi-fullscreen"></i>
                </button>
            </div>

            <div class="hud-clock">
                <div class="clock-time" id="liveClock">--:--:--</div>
                <div class="clock-date" id="liveDate">-- --- ----</div>
            </div>
        </header>

        <!-- ── MAIN HUD MIDDLE (COLUMNS LEFT & RIGHT) ── -->
        <div class="hud-middle">
            
            <!-- LEFT COLUMN: REPORT 1 - ANALISIS KATEGORI (TTA VS KTA) -->
            <aside class="hud-col interactive">
                
                <div class="hud-card card-cyan">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-pie-chart-fill text-cyan"></i> GRAFIK 1: KATEGORI HAZARD</span>
                        <span class="hud-badge-val" style="background: rgba(56, 189, 248, 0.2); color: var(--neon-cyan);">PROPORSI TOTAL</span>
                    </div>

                    <div class="kpi-row">
                        <div class="kpi-box" style="border-top: 3px solid var(--neon-cyan);">
                            <div class="kpi-label">Kondisi Tdk Aman (KTA)</div>
                            <div class="kpi-number text-cyan" id="kpiKtaTotal">--</div>
                            <div class="kpi-sub" id="kpiKtaPct">--% dari total</div>
                        </div>
                        <div class="kpi-box" style="border-top: 3px solid var(--neon-amber);">
                            <div class="kpi-label">Tindakan Tdk Aman (TTA)</div>
                            <div class="kpi-number text-warning" id="kpiTtaTotal">--</div>
                            <div class="kpi-sub" id="kpiTtaPct">--% dari total</div>
                        </div>
                    </div>

                    <!-- Visual Ratio Bar -->
                    <div class="ratio-bar-wrap" title="Rasio KTA vs TTA">
                        <div class="ratio-bar-kta" id="ratioBarKta" style="width: 65%;"></div>
                        <div class="ratio-bar-tta" id="ratioBarTta" style="width: 35%;"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2" style="font-size:10px; color:var(--text-muted);">
                        <span><span class="color-dot" style="background:var(--neon-cyan); color:var(--neon-cyan);"></span> KTA (Unsafe Condition)</span>
                        <span><span class="color-dot" style="background:var(--neon-amber); color:var(--neon-amber);"></span> TTA (Unsafe Action)</span>
                    </div>
                </div>

                <!-- Detail Kategori MTD -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-calendar2-month text-primary"></i> Rincian Bulan Ini (MTD)</span>
                        <span class="badge bg-secondary" style="font-size:9.5px;" id="badgeBulanNama">Bulan Berjalan</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-25" style="font-size:11.5px;">
                        <span><i class="bi bi-cone text-cyan me-1"></i>KTA (Kondisi Tidak Aman)</span>
                        <strong class="text-white" id="mtdKtaDetail">-- Laporan (--%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-25" style="font-size:11.5px;">
                        <span><i class="bi bi-person-exclamation text-warning me-1"></i>TTA (Tindakan Tidak Aman)</span>
                        <strong class="text-white" id="mtdTtaDetail">-- Laporan (--%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2" style="font-size:11.5px;">
                        <span><i class="bi bi-clipboard2-check text-success me-1"></i>Total Hazard Bulan Ini</span>
                        <strong class="text-cyan" id="mtdTotalDetail">-- Laporan</strong>
                    </div>
                </div>

            </aside>

            <!-- RIGHT COLUMN: REPORT 2 - KOMPARASI WAKTU (MTD VS YTD) -->
            <aside class="hud-col interactive">
                
                <div class="hud-card card-amber">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-bar-chart-steps text-warning"></i> GRAFIK 2: KOMPARASI PERIODE</span>
                        <span class="hud-badge-val" style="background: rgba(245, 158, 11, 0.2); color: var(--gold-bright);">MTD vs YTD</span>
                    </div>

                    <div class="kpi-row">
                        <div class="kpi-box" style="border-top: 3px solid var(--neon-emerald);">
                            <div class="kpi-label">MTD (Bulan Ini)</div>
                            <div class="kpi-number text-success" id="kpiMtdTotal">--</div>
                            <div class="kpi-sub" id="kpiMtdClosedRate">--% Closed</div>
                        </div>
                        <div class="kpi-box" style="border-top: 3px solid var(--neon-purple);">
                            <div class="kpi-label">YTD (Tahun Berjalan)</div>
                            <div class="kpi-number" style="color: var(--neon-purple);" id="kpiYtdTotal">--</div>
                            <div class="kpi-sub" id="kpiYtdClosedRate">--% Closed</div>
                        </div>
                    </div>
                </div>

                <!-- Status Penyelesaian MTD & YTD -->
                <div class="hud-card">
                    <div class="hud-card-header">
                        <span class="hud-card-title"><i class="bi bi-check2-circle text-success"></i> Status Penyelesaian (Closed)</span>
                        <span class="badge bg-success" style="font-size:9.5px;">TARGET &ge; 90%</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-25" style="font-size:11.5px;">
                        <span><i class="bi bi-check-all text-success me-1"></i>Closed Hazard MTD</span>
                        <strong class="text-white" id="mtdClosedDetail">-- Temuan (--%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-25" style="font-size:11.5px;">
                        <span><i class="bi bi-check-all text-success me-1"></i>Closed Hazard YTD</span>
                        <strong class="text-white" id="ytdClosedDetail">-- Temuan (--%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2" style="font-size:11.5px;">
                        <span><i class="bi bi-clock-history text-danger me-1"></i>Sisa Temuan Open (MTD)</span>
                        <strong class="text-danger" id="mtdOpenDetail">-- Temuan Aktif</strong>
                    </div>
                </div>

            </aside>

        </div>

        <!-- ── BOTTOM HUD TOOLBAR ── -->
        <footer class="hud-bottom interactive">
            <div class="legend-indicators">
                <span style="color:var(--text-muted); font-size:11px; text-transform:uppercase;">KETERANGAN GRAFIK 3D:</span>
                <span class="legend-pill"><span class="color-dot" style="background:var(--neon-cyan); color:var(--neon-cyan);"></span> KTA (Kondisi Tidak Aman)</span>
                <span class="legend-pill"><span class="color-dot" style="background:var(--neon-amber); color:var(--neon-amber);"></span> TTA (Tindakan Tidak Aman)</span>
                <span class="legend-pill"><span class="color-dot" style="background:var(--neon-emerald); color:var(--neon-emerald);"></span> MTD (Bulan Ini)</span>
                <span class="legend-pill"><span class="color-dot" style="background:var(--neon-purple); color:var(--neon-purple);"></span> YTD (Tahun Berjalan)</span>
            </div>

            <div class="ticker-bar">
                <span><i class="bi bi-display text-cyan me-1"></i>WALL DISPLAY MODE</span>
                <span>&bull;</span>
                <span>SEMUA LABEL &amp; ANGKA TAMPIL PERMANEN TANPA PERLU MOUSE</span>
            </div>
        </footer>

    </div>

    <!-- ═════════════════════════════════════════════════════════════════════════
         THREE.JS 3D ENGINE SCRIPT (PERMANENT FLOATING 3D BILLBOARDS)
         ═════════════════════════════════════════════════════════════════════════ -->
    <script>
    let scene, camera, renderer, controls;
    let clock = new THREE.Clock();
    let chartGroup1, chartGroup2, lasersGroup, particlesGroup;
    let display4Data = null;

    /* ──────────────────────────────────────────────────────────────────────────
       1. INITIALIZE THREE.JS SCENE
       ────────────────────────────────────────────────────────────────────────── */
    function initThree() {
        const canvas = document.getElementById('webglCanvas');
        const width = window.innerWidth;
        const height = window.innerHeight;

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x030712);
        scene.fog = new THREE.FogExp2(0x030712, 0.0032);

        camera = new THREE.PerspectiveCamera(45, width / height, 1, 3000);
        camera.position.set(0, 110, 280);

        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, powerPreference: 'high-performance' });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 - 0.02;
        controls.minDistance = 60;
        controls.maxDistance = 650;
        controls.target.set(0, 45, 0);

        setupLighting();
        createReflectiveGridFloor();
        createGoldenParticles();

        window.addEventListener('resize', onWindowResize);
        animate();
    }

    function setupLighting() {
        const ambientLight = new THREE.AmbientLight(0x1e293b, 1.4);
        scene.add(ambientLight);

        const sunLight = new THREE.DirectionalLight(0xffffff, 1.6);
        sunLight.position.set(100, 220, 150);
        sunLight.castShadow = true;
        scene.add(sunLight);

        // Cyan uplight for Left Pod
        const light1 = new THREE.PointLight(0x38bdf8, 2.5, 200);
        light1.position.set(-80, 20, 0);
        scene.add(light1);

        // Purple uplight for Right Pod
        const light2 = new THREE.PointLight(0xa855f7, 2.5, 200);
        light2.position.set(80, 20, 0);
        scene.add(light2);
    }

    function createReflectiveGridFloor() {
        const floorGeom = new THREE.PlaneGeometry(500, 500);
        floorGeom.rotateX(-Math.PI / 2);
        const floorMat = new THREE.MeshStandardMaterial({
            color: 0x050b18,
            roughness: 0.15,
            metalness: 0.85
        });
        const floor = new THREE.Mesh(floorGeom, floorMat);
        floor.receiveShadow = true;
        scene.add(floor);

        const gridHelper = new THREE.GridHelper(500, 60, 0x38bdf8, 0x1e293b);
        gridHelper.position.y = 0.1;
        scene.add(gridHelper);
    }

    function createGoldenParticles() {
        const count = 350;
        const geom = new THREE.BufferGeometry();
        const positions = new Float32Array(count * 3);
        for (let i = 0; i < count * 3; i += 3) {
            positions[i] = (Math.random() - 0.5) * 400;
            positions[i + 1] = Math.random() * 150 + 5;
            positions[i + 2] = (Math.random() - 0.5) * 400;
        }
        geom.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const mat = new THREE.PointsMaterial({
            color: 0x38bdf8,
            size: 2.0,
            transparent: true,
            opacity: 0.5,
            blending: THREE.AdditiveBlending
        });
        particlesGroup = new THREE.Points(geom, mat);
        scene.add(particlesGroup);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       2. HIGH-RES BILLBOARD TEXT SPRITE GENERATOR (NO-MOUSE WALL TV)
       ────────────────────────────────────────────────────────────────────────── */
    function createBillboardSprite(lines, options = {}) {
        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 256;
        const ctx = canvas.getContext('2d');

        const bgColor = options.bgColor || 'rgba(11, 19, 43, 0.92)';
        const borderColor = options.borderColor || '#38bdf8';
        const titleColor = options.titleColor || '#ffffff';

        // Draw Rounded Card Background
        ctx.fillStyle = bgColor;
        ctx.strokeStyle = borderColor;
        ctx.lineWidth = 6;
        roundRect(ctx, 10, 10, 492, 236, 20);
        ctx.fill();
        ctx.stroke();

        // Top Accent Line
        ctx.fillStyle = borderColor;
        ctx.fillRect(20, 16, 472, 6);

        // Header / Category Title
        ctx.textAlign = 'center';
        ctx.font = 'bold 26px Poppins, sans-serif';
        ctx.fillStyle = titleColor;
        ctx.fillText(lines[0] || '', 256, 60);

        // Subtitle (e.g. Unsafe Condition)
        ctx.font = '600 18px Poppins, sans-serif';
        ctx.fillStyle = '#94a3b8';
        ctx.fillText(lines[1] || '', 256, 92);

        // Big Main Value (e.g. 68.4% • 184 Laporan)
        ctx.font = '900 36px "JetBrains Mono", monospace';
        ctx.fillStyle = borderColor;
        ctx.fillText(lines[2] || '', 256, 150);

        // Secondary Metric (e.g. YTD: 1,420 • Closed: 96%)
        ctx.font = '600 20px "JetBrains Mono", monospace';
        ctx.fillStyle = '#e2e8f0';
        ctx.fillText(lines[3] || '', 256, 195);

        const texture = new THREE.CanvasTexture(canvas);
        texture.minFilter = THREE.LinearFilter;
        texture.magFilter = THREE.LinearFilter;

        const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true });
        const sprite = new THREE.Sprite(spriteMat);
        sprite.scale.set(38, 19, 1);
        return sprite;
    }

    function createHeaderSignSprite(text, color) {
        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 128;
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
        ctx.strokeStyle = color;
        ctx.lineWidth = 4;
        roundRect(ctx, 10, 10, 492, 108, 14);
        ctx.fill();
        ctx.stroke();

        ctx.textAlign = 'center';
        ctx.font = 'bold 24px Poppins, sans-serif';
        ctx.fillStyle = color;
        ctx.fillText(text, 256, 72);

        const texture = new THREE.CanvasTexture(canvas);
        const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true });
        const sprite = new THREE.Sprite(spriteMat);
        sprite.scale.set(45, 11, 1);
        return sprite;
    }

    function roundRect(ctx, x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
    }

    /* ──────────────────────────────────────────────────────────────────────────
       3. BUILD 3D BARS FOR REPORT 1 (TTA VS KTA) & REPORT 2 (MTD VS YTD)
       ────────────────────────────────────────────────────────────────────────── */
    function build3DCharts(data) {
        if (chartGroup1) scene.remove(chartGroup1);
        if (chartGroup2) scene.remove(chartGroup2);
        if (lasersGroup) scene.remove(lasersGroup);

        chartGroup1 = new THREE.Group();
        chartGroup2 = new THREE.Group();
        lasersGroup = new THREE.Group();

        const kat = data.kategori || {};
        const kom = data.komparasi || {};
        const mtd = kom.mtd || {};
        const ytd = kom.ytd || {};

        // ═════════════════════════════════════════════════════════════════════
        // PODIUM 1 (LEFT): KATEGORI HAZARD (KTA vs TTA)
        // ═════════════════════════════════════════════════════════════════════
        chartGroup1.position.set(-80, 0, 0);

        // Pedestal Platform Left
        const ped1Geom = new THREE.BoxGeometry(60, 4, 35);
        const ped1Mat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.4, metalness: 0.6 });
        const ped1 = new THREE.Mesh(ped1Geom, ped1Mat);
        ped1.position.y = 2;
        chartGroup1.add(ped1);

        // Header Title Sign Left
        const sign1 = createHeaderSignSprite('GRAFIK 1: KATEGORI HAZARD (KTA vs TTA)', '#38bdf8');
        sign1.position.set(0, 78, 0);
        chartGroup1.add(sign1);

        // Bar 1: KTA (Unsafe Condition) - Cyan
        const ktaVal = kat.ktaAll || 68;
        const ktaPct = kat.ktaAllPct || 68.0;
        const ktaHeight = Math.max(20, (ktaPct / 100) * 65);

        const ktaBarGeom = new THREE.BoxGeometry(16, ktaHeight, 16);
        ktaBarGeom.translate(0, ktaHeight / 2, 0);
        const ktaBarMat = new THREE.MeshStandardMaterial({
            color: 0x0284c7,
            metalness: 0.7,
            roughness: 0.2,
            transparent: true,
            opacity: 0.9,
            emissive: 0x0284c7,
            emissiveIntensity: 0.35
        });
        const ktaBar = new THREE.Mesh(ktaBarGeom, ktaBarMat);
        ktaBar.position.set(-15, 4, 0);
        chartGroup1.add(ktaBar);

        // Permanent Label Sprite on top of KTA Bar
        const ktaSprite = createBillboardSprite([
            'KONDISI TIDAK AMAN (KTA)',
            'UNSAFE CONDITION',
            `${ktaPct}% • ${ktaVal} LAPORAN`,
            `MTD: ${kat.ktaMtd || 0}  |  YTD: ${kat.ktaYtd || 0}`
        ], { borderColor: '#38bdf8', titleColor: '#ffffff' });
        ktaSprite.position.set(-15, ktaHeight + 16, 0);
        chartGroup1.add(ktaSprite);

        // Bar 2: TTA (Unsafe Action) - Amber
        const ttaVal = kat.ttaAll || 32;
        const ttaPct = kat.ttaAllPct || 32.0;
        const ttaHeight = Math.max(20, (ttaPct / 100) * 65);

        const ttaBarGeom = new THREE.BoxGeometry(16, ttaHeight, 16);
        ttaBarGeom.translate(0, ttaHeight / 2, 0);
        const ttaBarMat = new THREE.MeshStandardMaterial({
            color: 0xd97706,
            metalness: 0.7,
            roughness: 0.2,
            transparent: true,
            opacity: 0.9,
            emissive: 0xd97706,
            emissiveIntensity: 0.35
        });
        const ttaBar = new THREE.Mesh(ttaBarGeom, ttaBarMat);
        ttaBar.position.set(15, 4, 0);
        chartGroup1.add(ttaBar);

        // Permanent Label Sprite on top of TTA Bar
        const ttaSprite = createBillboardSprite([
            'TINDAKAN TIDAK AMAN (TTA)',
            'UNSAFE ACTION',
            `${ttaPct}% • ${ttaVal} LAPORAN`,
            `MTD: ${kat.ttaMtd || 0}  |  YTD: ${kat.ttaYtd || 0}`
        ], { borderColor: '#f59e0b', titleColor: '#ffffff' });
        ttaSprite.position.set(15, ttaHeight + 16, 0);
        chartGroup1.add(ttaSprite);

        // ═════════════════════════════════════════════════════════════════════
        // PODIUM 2 (RIGHT): KOMPARASI WAKTU (MTD vs YTD)
        // ═════════════════════════════════════════════════════════════════════
        chartGroup2.position.set(80, 0, 0);

        // Pedestal Platform Right
        const ped2Geom = new THREE.BoxGeometry(60, 4, 35);
        const ped2Mat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.4, metalness: 0.6 });
        const ped2 = new THREE.Mesh(ped2Geom, ped2Mat);
        ped2.position.y = 2;
        chartGroup2.add(ped2);

        // Header Title Sign Right
        const sign2 = createHeaderSignSprite('GRAFIK 2: KOMPARASI PERIODE (MTD vs YTD)', '#10b981');
        sign2.position.set(0, 78, 0);
        chartGroup2.add(sign2);

        // Bar 3: MTD (Bulan Berjalan) - Emerald
        const mtdTotal = mtd.total || 140;
        const mtdClosed = mtd.closed || 135;
        const mtdClosedPct = mtd.closedPct || 96.4;
        const mtdHeight = 36; // Scaled display height

        const mtdBarGeom = new THREE.BoxGeometry(16, mtdHeight, 16);
        mtdBarGeom.translate(0, mtdHeight / 2, 0);
        const mtdBarMat = new THREE.MeshStandardMaterial({
            color: 0x059669,
            metalness: 0.7,
            roughness: 0.2,
            transparent: true,
            opacity: 0.9,
            emissive: 0x059669,
            emissiveIntensity: 0.35
        });
        const mtdBar = new THREE.Mesh(mtdBarGeom, mtdBarMat);
        mtdBar.position.set(-15, 4, 0);
        chartGroup2.add(mtdBar);

        // Permanent Label Sprite on top of MTD Bar
        const mtdSprite = createBillboardSprite([
            'MTD (BULAN INI)',
            data.periode ? data.periode.bulanNama : 'Bulan Berjalan',
            `${mtdTotal} TOTAL HAZARD`,
            `Closed: ${mtdClosedPct}% (${mtdClosed} Selesai)`
        ], { borderColor: '#10b981', titleColor: '#ffffff' });
        mtdSprite.position.set(-15, mtdHeight + 16, 0);
        chartGroup2.add(mtdSprite);

        // Bar 4: YTD (Tahun Berjalan) - Purple / Gold
        const ytdTotal = ytd.total || 1450;
        const ytdClosed = ytd.closed || 1410;
        const ytdClosedPct = ytd.closedPct || 97.2;
        const ytdHeight = 58; // Higher skyscraper reflecting year accumulation

        const ytdBarGeom = new THREE.BoxGeometry(16, ytdHeight, 16);
        ytdBarGeom.translate(0, ytdHeight / 2, 0);
        const ytdBarMat = new THREE.MeshStandardMaterial({
            color: 0x7c3aed,
            metalness: 0.8,
            roughness: 0.15,
            transparent: true,
            opacity: 0.9,
            emissive: 0x7c3aed,
            emissiveIntensity: 0.4
        });
        const ytdBar = new THREE.Mesh(ytdBarGeom, ytdBarMat);
        ytdBar.position.set(15, 4, 0);
        chartGroup2.add(ytdBar);

        // Permanent Label Sprite on top of YTD Bar
        const ytdSprite = createBillboardSprite([
            'YTD (TAHUN BERJALAN)',
            `Akumulasi Tahun ${data.periode ? data.periode.tahun : 2026}`,
            `${ytdTotal} TOTAL HAZARD`,
            `Closed: ${ytdClosedPct}% (${ytdClosed} Selesai)`
        ], { borderColor: '#a855f7', titleColor: '#ffffff' });
        ytdSprite.position.set(15, ytdHeight + 16, 0);
        chartGroup2.add(ytdSprite);

        // Add Groups to Scene
        scene.add(chartGroup1);
        scene.add(chartGroup2);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       4. ANIMATION LOOP & AUTOMATIC SMOOTH CAMERA GLIDE
       ────────────────────────────────────────────────────────────────────────── */
    function animate() {
        requestAnimationFrame(animate);

        const time = clock.getElapsedTime();

        // Smooth subtle cinematic floating camera for TV Wall (no mouse needed)
        // Camera glides gently left-to-right to give depth to the 3D bars and labels
        camera.position.x = Math.sin(time * 0.15) * 45;
        camera.position.y = 85 + Math.cos(time * 0.2) * 8;
        camera.position.z = 240 + Math.sin(time * 0.1) * 12;
        camera.lookAt(0, 42, 0);

        if (particlesGroup) {
            particlesGroup.rotation.y = time * 0.03;
        }

        renderer.render(scene, camera);
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function toggleFullscreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => console.log(err));
        } else if (document.exitFullscreen) {
            document.exitFullscreen();
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       5. FETCH DATA & UPDATE HUD & 3D BILLBOARDS
       ────────────────────────────────────────────────────────────────────────── */
    function fetchDisplay4Data() {
        fetch('/Display/GetDisplay4Data')
            .then(res => res.json())
            .then(data => {
                display4Data = data;
                updateHud(data);
                build3DCharts(data);
            })
            .catch(err => console.warn('Error fetching Display 4 data:', err));
    }

    function updateHud(data) {
        if (!data) return;

        const kat = data.kategori || {};
        const kom = data.komparasi || {};
        const mtd = kom.mtd || {};
        const ytd = kom.ytd || {};

        // 1. Report 1 (KTA vs TTA)
        document.getElementById('kpiKtaTotal').innerText = kat.ktaAll || 0;
        document.getElementById('kpiTtaTotal').innerText = kat.ttaAll || 0;
        document.getElementById('kpiKtaPct').innerText = `${kat.ktaAllPct || 0}% dari total`;
        document.getElementById('kpiTtaPct').innerText = `${kat.ttaAllPct || 0}% dari total`;

        document.getElementById('ratioBarKta').style.width = `${kat.ktaAllPct || 50}%`;
        document.getElementById('ratioBarTta').style.width = `${kat.ttaAllPct || 50}%`;

        document.getElementById('badgeBulanNama').innerText = data.periode ? data.periode.bulanNama : 'Bulan Berjalan';
        document.getElementById('mtdKtaDetail').innerText = `${kat.ktaMtd || 0} Laporan (${kat.ktaMtdPct || 0}%)`;
        document.getElementById('mtdTtaDetail').innerText = `${kat.ttaMtd || 0} Laporan (${kat.ttaMtdPct || 0}%)`;
        document.getElementById('mtdTotalDetail').innerText = `${mtd.total || 0} Laporan`;

        // 2. Report 2 (MTD vs YTD)
        document.getElementById('kpiMtdTotal').innerText = mtd.total || 0;
        document.getElementById('kpiYtdTotal').innerText = ytd.total || 0;
        document.getElementById('kpiMtdClosedRate').innerText = `${mtd.closedPct || 0}% Closed`;
        document.getElementById('kpiYtdClosedRate').innerText = `${ytd.closedPct || 0}% Closed`;

        document.getElementById('mtdClosedDetail').innerText = `${mtd.closed || 0} Temuan (${mtd.closedPct || 0}%)`;
        document.getElementById('ytdClosedDetail').innerText = `${ytd.closed || 0} Temuan (${ytd.closedPct || 0}%)`;
        document.getElementById('mtdOpenDetail').innerText = `${mtd.open || 0} Temuan Aktif`;
    }

    /* ──────────────────────────────────────────────────────────────────────────
       6. CLOCK & 5-MINUTE AUTO SLIDE ROTATION (DISPLAY 4 -> DISPLAY 1)
       ────────────────────────────────────────────────────────────────────────── */
    function updateClock() {
        const now = new Date();
        document.getElementById('liveClock').innerText = now.toLocaleTimeString('id-ID', { hour12: false });
        document.getElementById('liveDate').innerText = now.toLocaleDateString('id-ID', {
            weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
        }).toUpperCase();
    }
    setInterval(updateClock, 1000);
    updateClock();

    const SLIDE_DURATION_SECONDS = 300; // 5 minutes
    let slideTimeRemaining = SLIDE_DURATION_SECONDS;
    let isSlidePaused = false;

    function updateSlideTimer() {
        if (isSlidePaused) return;
        slideTimeRemaining--;
        if (slideTimeRemaining <= 0) {
            window.location.href = '/Display';
            return;
        }
        const mins = Math.floor(slideTimeRemaining / 60);
        const secs = slideTimeRemaining % 60;
        const el = document.getElementById('slideCountdown');
        if (el) el.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
    setInterval(updateSlideTimer, 1000);

    function togglePauseSlide() {
        isSlidePaused = !isSlidePaused;
        const icon = document.getElementById('pauseIcon');
        const btn = document.getElementById('btnPauseSlide');
        if (isSlidePaused) {
            if (icon) icon.className = 'bi bi-play-fill';
            if (btn) btn.classList.add('text-danger');
        } else {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (btn) btn.classList.remove('text-danger');
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       7. INITIALIZATION
       ────────────────────────────────────────────────────────────────────────── */
    initThree();
    fetchDisplay4Data();
    setInterval(fetchDisplay4Data, 30000);
    </script>

</body>
