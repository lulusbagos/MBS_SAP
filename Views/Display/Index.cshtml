function statusClass(s) {
    const v = (s||'').toLowerCase();
    if (v === 'closed' || v === 'selesai' || v === 'good') return 'bgt-closed';
    if (v.includes('progres') || v.includes('progress') || v.includes('progress')) return 'bgt-progres';
    return 'bgt-open';
}

function getCardBackupBgAndIcon(type) {
    const t = (type || '').toLowerCase();
    if (t === 'hazard') {
        return {
            bg: 'linear-gradient(135deg, #450a0a, #7f1d1d)',
            icon: 'bi-exclamation-triangle-fill',
            color: '#ef4444'
        };
    } else if (t === 'inspection' || t === 'inspeksi') {
        return {
            bg: 'linear-gradient(135deg, #172554, #1e3a8a)',
            icon: 'bi-clipboard2-check-fill',
            color: '#38bdf8'
        };
    } else if (t === 'actionplan') {
        return {
            bg: 'linear-gradient(135deg, #451a03, #78350f)',
            icon: 'bi-tools',
            color: '#fbbf24'
        };
    } else if (t === 'safetytalk') {
        return {
            bg: 'linear-gradient(135deg, #3b0764, #581c87)',
            icon: 'bi-megaphone-fill',
            color: '#c084fc'
        };
    } else if (t === 'observation') {
        return {
            bg: 'linear-gradient(135deg, #042f2e, #115e59)',
            icon: 'bi-eye-fill',
            color: '#14b8a6'
        };
    } else if (t === 'p5m') {
        return {
            bg: 'linear-gradient(135deg, #022c22, #064e3b)',
            icon: 'bi-chat-left-text-fill',
            color: '#10b981'
        };
    } else {
        return {
            bg: 'linear-gradient(135deg, #1e1b4b, #312e81)',
            icon: 'bi-truck',
            color: '#818cf8'
        };
    }
}

async function fetchFeed() {
    try {
        const res = await fetch('/Display/GetLatestFeed');
        if (!res.ok) return;
        const items = await res.json();
        if (!items || !items.length) return;

        rawFeedItems = items;

        const topKey = `${items[0].type}_${items[0].id}_${items[0].createdAt}`;
        if (topKey !== lastTopKey) {
            const hasNew = !isFirstLoad && lastTopKey !== '';
            lastTopKey = topKey;
            if (hasNew) triggerNewAlert(items[0]);
            renderFeed(items);
        } else if (isFirstLoad) {
            renderFeed(items);
        }
        isFirstLoad = false;
    } catch(e) {
        console.warn('Feed fetch error:', e);
    }
}

function setFeedFilter(filter) {
    currentFeedFilter = filter;
    currentFeedPage = 0;
    document.querySelectorAll('.feed-tabs .tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.id === `btn-feed-${filter}`);
    });
    renderFeed(rawFeedItems);
}

function renderFeed(items) {
    const grid = document.getElementById('feedGrid');
    
    if (feedRotationInterval) {
        clearInterval(feedRotationInterval);
        feedRotationInterval = null;
    }

    let filteredItems = [];
    if (currentFeedFilter === 'highlight') {
        const seenKeys = new Set();
        items.forEach(item => {
            if (!item.imageUrl) return;
            const key = (item.nik || item.name || '').trim().toLowerCase();
            if (!seenKeys.has(key)) {
                seenKeys.add(key);
                filteredItems.push(item);
            }
        });
    } else if (currentFeedFilter === 'open') {
        filteredItems = items.filter(item => {
            const s = (item.status || '').toLowerCase();
            return s === 'open' || s === 'not_good';
        });
    } else if (currentFeedFilter === 'progres') {
        filteredItems = items.filter(item => {
            const s = (item.status || '').toLowerCase();
            return s.includes('progres') || s.includes('progress');
        });
    } else if (currentFeedFilter === 'closed') {
        filteredItems = items.filter(item => {
            const s = (item.status || '').toLowerCase();
            return s === 'closed' || s === 'selesai' || s === 'good';
        });
    }

    const totalItems = filteredItems.length;
    if (totalItems === 0) {
        grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 48px 16px; color: var(--muted); font-size: 11.5px; font-weight: 500;"><i class="bi bi-info-circle" style="font-size: 20px; display: block; margin-bottom: 8px;"></i>Tidak ada aktivitas K3 yang sesuai filter ini.</div>';
        document.getElementById('feedCount').innerText = '0 aktivitas';
        document.getElementById('feedPageIndicator').style.display = 'none';
        return;
    }

    const totalPages = Math.ceil(totalItems / feedPageSize);
    if (currentFeedPage >= totalPages) {
        currentFeedPage = 0;
    }

    function displayPage(pageIdx) {
        grid.style.opacity = '0';
        grid.style.transition = 'opacity 0.4s ease';

        setTimeout(() => {
            grid.innerHTML = '';
            const start = pageIdx * feedPageSize;
            const end = Math.min(start + feedPageSize, totalItems);
            const pageItems = filteredItems.slice(start, end);

            pageItems.forEach(item => {
                const id  = `fc-${item.type}-${item.id}`;
                const sc  = statusClass(item.status);
                const backup = getCardBackupBgAndIcon(item.type);

                const card = document.createElement('div');
                card.className = 'fcard';
                card.id = id;

                let imgHTML = '';
                if (item.imageUrl) {
                    imgHTML = `<img src="${item.imageUrl}" class="fcard-img" loading="lazy"
                                   onerror="this.outerHTML='<div class=fcard-noimg style=\\'background: ${backup.bg}; color: ${backup.color}\\'>&nbsp;<i class=\\'bi ${backup.icon}\\'></i></div>'" />`;
                } else {
                    imgHTML = `<div class="fcard-noimg" style="background: ${backup.bg}; color: ${backup.color}; font-size: 32px; display: flex; align-items: center; justify-content: center;">
                                   <i class="bi ${backup.icon}"></i>
                               </div>`;
                }

                const companyText = item.companyName ? ` &#127970; ${item.companyName}` : '';

                card.innerHTML = `
                    ${imgHTML}
                    <div class="fcard-body">
                        <div class="fcard-user">
                            <div class="fcard-avatar-initials" style="background-color: ${getAvatarColor(item.name)}">
                                ${getInitials(item.name)}
                            </div>
                            <div style="min-width: 0; flex: 1;">
                                <div class="fcard-uname">${item.name||'User'}</div>
                                <div class="fcard-uloc" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${item.area||item.location||'General'}${companyText}">
                                    ${item.area||item.location||'General'}${companyText}
                                </div>
                            </div>
                        </div>
                        <div class="fcard-badges">
                            <span class="bgt bgt-type">${(item.type||'').toUpperCase()}</span>
                            <span class="bgt ${sc}">${item.status||'OPEN'}</span>
                        </div>
                        <div class="fcard-ttl">${item.title}</div>
                    </div>`;

                grid.appendChild(card);
            });

            if (totalPages > 1) {
                const indicator = document.getElementById('feedPageIndicator');
                indicator.innerText = `HALAMAN ${pageIdx + 1}/${totalPages}`;
                indicator.style.display = 'inline-block';
            } else {
                document.getElementById('feedPageIndicator').style.display = 'none';
            }

            grid.style.opacity = '1';
        }, 400);
    }

    displayPage(currentFeedPage);

    if (totalItems > feedPageSize) {
        feedRotationInterval = setInterval(() => {
            currentFeedPage = (currentFeedPage + 1) % totalPages;
            displayPage(currentFeedPage);
        }, 8000);
    } else {
        document.getElementById('feedPageIndicator').style.display = 'none';
    }

    let countText = '';
    if (currentFeedFilter === 'highlight') {
        countText = `${totalItems} highlight aktivitas K3`;
    } else {
        countText = `${totalItems} aktivitas K3 (${currentFeedFilter.toUpperCase()})`;
    }
    document.getElementById('feedCount').innerText = countText;
}

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   AVATAR INITIALS UTILITIES
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function getInitials(name) {
    if (!name) return '??';
    const parts = name.trim().split(/\s+/);
    if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
    return (parts[0][0] + (parts[1][0] || '')).toUpperCase();
}

function getAvatarColor(name) {
    const colors = ['#38bdf8', '#10b981', '#f59e0b', '#a855f7', '#ec4899', '#14b8a6', '#f43f5e'];
    let hash = 0;
    const clean = name || '';
    for (let i = 0; i < clean.length; i++) {
        hash = clean.charCodeAt(i) + ((hash << 5) - hash);
    }
    const idx = Math.abs(hash) % colors.length;
    return colors[idx];
}

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   NEW ITEM ALERT
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function triggerNewAlert(item) {
    beep();
    
    // Screen Flash Anim
    const f = document.getElementById('screenFlash');
    f.classList.add('flash'); 
    setTimeout(() => f.classList.remove('flash'), 1200);

    // Color code based on type
    const colors = {
        'hazard': '#ef4444',
        'inspection': '#38bdf8',
        'inspeksi': '#38bdf8',
        'safetytalk': '#a855f7',
        'p5m': '#10b981',
        'observation': '#14b8a6'
    };
    const notifColor = colors[(item.type || '').toLowerCase()] || '#38bdf8';

    // Populate data
    document.getElementById('notifTypeHeader').innerText = `Laporan K3 Baru: ${(item.type || 'Kegiatan')}`;
    document.getElementById('notifUserLoc').innerHTML = 
        `<span style="color:#fff; font-weight:700;">${item.name || 'Karyawan'}</span> 
         (${item.nik || '-'}) &bull; <i class=\"bi bi-geo-alt-fill\"></i> ${item.area || item.location || 'General'}`;
    document.getElementById('notifTitle').innerText = item.title || 'Aktivitas K3';
    
    // Description text (truncated)
    const descText = item.description || '';
    document.getElementById('notifDesc').innerText = descText.length > 80 ? descText.substring(0, 80) + '...' : descText;

    // Image container
    const imgContainer = document.getElementById('notifImgContainer');
    const backup = getCardBackupBgAndIcon(item.type);
    if (item.imageUrl) {
        imgContainer.innerHTML = `<img src="${item.imageUrl}" class="notif-card-img" 
                                       onerror="this.outerHTML='<div class=notif-card-noimg style=\\'background: ${backup.bg}; color: ${backup.color}; border: none; font-size: 36px; display: flex; align-items: center; justify-content: center;\\'><i class=\\'bi ${backup.icon}\\'></i></div>'" />`;
    } else {
        imgContainer.innerHTML = 
            `<div class="notif-card-noimg" style="background: ${backup.bg}; color: ${backup.color}; border: none; font-size: 36px; display: flex; align-items: center; justify-content: center;">
                <i class="bi ${backup.icon}"></i>
             </div>`;
    }

    // Set custom neon glow & border color for card
    const p = document.getElementById('notifPopup');
    p.style.border = `1px solid ${notifColor}`;
    p.style.boxShadow = `0 20px 50px rgba(0,0,0,0.8), 0 0 35px ${notifColor}4D`;

    // Progress Bar reset and animation
    const progressBar = document.getElementById('notifProgressBar');
    progressBar.style.transition = 'none';
    progressBar.style.width = '100%';
    progressBar.style.background = `linear-gradient(90deg, ${notifColor}, #fff)`;

    // Show popup
    p.classList.add('show');

    // Start progress bar shrink animation
    setTimeout(() => {
        progressBar.style.transition = 'width 6s linear';
        progressBar.style.width = '0%';
    }, 50);

    // Hide after 6 seconds
    setTimeout(() => {
        p.classList.remove('show');
    }, 6000);
}

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   UPDATE TOAST HELPER
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
let toastTimer = null;
function showUpdateToast(msg) {
    const t = document.getElementById('updateToast');
    document.getElementById('updateToastMsg').innerText = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 3500);
}

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   AUTO REFRESH LOOP  (DATA: every 30s, PAGE: every 15min)
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
async function refreshAll() {
    await Promise.all([fetchPerformance(), fetchFeed()]);
    showUpdateToast('Data diperbarui &mdash; ' + new Date().toLocaleTimeString('id-ID'));
    nextDataAt = Date.now() + DATA_INTERVAL_S * 1000;
}

// Initial load
buildCharts();
refreshAll();

// Data polling: every 30 seconds
setInterval(refreshAll, DATA_INTERVAL_S * 1000);

// Page hard reload: every 15 minutes (to prevent memory leaks on TV)
setTimeout(() => location.reload(), PAGE_RELOAD_MIN * 60 * 1000);

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   AUTO ROTATION LOOPS (TV Display Mode)
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
// 1. Chart Slide Rotation (Every 10 seconds)
let currentChartIdx = 0;
const chartTitles = [
    '<i class="bi bi-bar-chart-fill" style="color:var(--blue)"></i> Pencapaian Per Kategori SAP &mdash; Bulan Ini',
    '<i class="bi bi-pie-chart-fill" style="color:var(--purple)"></i> Distribusi Aktivitas Laporan K3',
    '<i class="bi bi-shield-exclamation" style="color:var(--red)"></i> Distribusi Tingkat Risiko Laporan K3',
    '<i class="bi bi-check-circle-fill" style="color:var(--green)"></i> Status Temuan & Action Plan (Open vs Closed)',
    '<i class="bi bi-calendar-event" style="color:var(--amber)"></i> Laporan K3 Masuk Hari Ini'
];

function setChartIndex(idx) {
    currentChartIdx = idx;
    // Update indicator dots
    document.querySelectorAll('.chart-dot').forEach((d, i) => {
        d.classList.toggle('active', i === idx);
    });
    // Update slides visibility
    document.querySelectorAll('.chart-slide').forEach((s, i) => {
        s.classList.toggle('active', i === idx);
    });
    // Update title
    document.getElementById('rotatingChartTitle').innerHTML = chartTitles[idx];
}

function rotateCharts() {
    const nextIdx = (currentChartIdx + 1) % 5;
    setChartIndex(nextIdx);
}
setInterval(rotateCharts, 10000);

// 2. Company Rankings Tab Rotation (Every 8 seconds)
let currentRankTab = 0;
const rankTabs = ['fastest', 'stagnant', 'all'];

function rotateRankings() {
    currentRankTab = (currentRankTab + 1) % rankTabs.length;
    const tabId = rankTabs[currentRankTab];
    const buttons = document.querySelectorAll('.tab-row .tab-btn');
    if (buttons && buttons[currentRankTab]) {
        // Simple manual switch
        document.querySelectorAll('.tab-row .tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        buttons[currentRankTab].classList.add('active');
        document.getElementById('tab-' + tabId).classList.add('active');
    }
}
setInterval(rotateRankings, 8000);
</script>
