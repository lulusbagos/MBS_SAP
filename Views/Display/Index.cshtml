    }

    /* Screen flash */
    .screen-flash { position: fixed; inset: 0; background: #38bdf8; z-index: 9999; opacity: 0; pointer-events: none; }
    .screen-flash.flash { animation: flashAnim 1.2s ease-out; }
    @@keyframes flashAnim { 0%{opacity:0} 25%{opacity:.18} 100%{opacity:0} }

    /* â”€â”€ Update overlay â”€â”€ */
    .update-toast {
        position: fixed; top: 24px; right: 24px;
        background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.3);
        border-radius: 10px; padding: 10px 16px;
        display: flex; align-items: center; gap: 8px;
