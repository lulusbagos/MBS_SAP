        padding: 10px 16px;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .notif-card-body {
        display: grid;
        grid-template-columns: 130px 1fr;
        gap: 14px;
        padding: 16px;
    }
    .notif-card-img {
        width: 130px;
        height: 130px;
        object-fit: cover;
        border-radius: 10px;
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .notif-card-noimg {
        width: 130px;
        height: 130px;
