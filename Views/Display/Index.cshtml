        z-index: 9000; opacity: 0; transform: translateY(-8px);
        transition: all .35s ease;
        pointer-events: none;
    }
    .update-toast.show { opacity: 1; transform: translateY(0); }

    /* Audio unlock badge pulse anim */
    @@keyframes pulseAlert {
        0% { transform: scale(1); box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35); }
        50% { transform: scale(1.04); box-shadow: 0 8px 36px rgba(239, 68, 68, 0.6); }
        100% { transform: scale(1); box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35); }
    }
    </style>
</head>
