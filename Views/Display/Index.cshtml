<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   AUDIO
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const alertSound = new Audio('/notifikasi/freesound_community-plopp-84863.mp3');

function beep() {
    // Reset playback position to allow overlapping playbacks
    alertSound.currentTime = 0;
    alertSound.play()
        .then(() => {
            // Successfully played, hide warning badge
            const badge = document.getElementById('audioUnlockBadge');
            if (badge) badge.style.display = 'none';
        })
        .catch(e => {
            console.warn("Failed to play sound: ", e);
            // Autoplay blocked - show the unlock badge
            const badge = document.getElementById('audioUnlockBadge');
            if (badge) badge.style.display = 'flex';
        });
}

function unlockAudio() {
    alertSound.currentTime = 0;
    alertSound.play()
        .then(() => {
            const badge = document.getElementById('audioUnlockBadge');
            if (badge) badge.style.display = 'none';
            console.log("Audio unlocked successfully.");
        })
        .catch(e => console.warn("Could not unlock audio yet:", e));
}

// Attach event listeners to unlock audio
document.addEventListener('DOMContentLoaded', () => {
    const badge = document.getElementById('audioUnlockBadge');
    if (badge) {
        badge.addEventListener('click', (e) => {
            e.stopPropagation();
            unlockAudio();
        });
    }
    
    // Unlock on the very first interaction anywhere on the page
    const unlockEvents = ['click', 'keydown', 'mousedown', 'pointerdown', 'touchstart'];
    function unlockOnFirstInteraction() {
        unlockAudio();
        unlockEvents.forEach(evt => document.removeEventListener(evt, unlockOnFirstInteraction));
    }
    unlockEvents.forEach(evt => document.addEventListener(evt, unlockOnFirstInteraction, { once: true }));
});

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   CLOCK
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function tickClock() {
    const n = new Date();
    document.getElementById('liveClock').innerText = n.toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    document.getElementById('liveDate').innerText  = n.toLocaleDateString('id-ID',  { weekday:'long', year:'numeric', month:'long', day:'numeric' });
}
setInterval(tickClock, 1000); tickClock();

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   COUNTDOWN TIMER
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const DATA_INTERVAL_S  = 30;   // fetch data every 30 sec
const PAGE_RELOAD_MIN  = 15;   // full page reload every 15 min

let nextDataAt    = Date.now() + DATA_INTERVAL_S * 1000;
let pageReloadAt  = Date.now() + PAGE_RELOAD_MIN * 60 * 1000;

function updateCountdown() {
    const secsLeft = Math.max(0, Math.round((nextDataAt - Date.now()) / 1000));
    document.getElementById('nextRefreshLabel').innerText =
        secsLeft > 0
            ? `Refresh berikutnya: ${secsLeft}s`
            : 'Memperbarui...';

    const pageLeft = Math.round((pageReloadAt - Date.now()) / 1000);
    if (pageLeft <= 0) location.reload();
}
setInterval(updateCountdown, 1000); updateCountdown();

