function switchTab(id, btn) {
    document.querySelectorAll('.tab-row .tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + id).classList.add('active');

    const index = rankTabs.indexOf(id);
    if (index !== -1) currentRankTab = index;
}

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   RENDER COMPANY ROW
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const RANK_COLORS = ['#fbbf24','#d1d5db','#d97706','#6b7280','#6b7280'];

function companyRowHtml(c, idx, mode) {
    const pct    = c.percentage ?? c.Percentage ?? 0;
    const real   = c.realization ?? c.Realization ?? 0;
    const tgt    = c.target ?? c.Target ?? 0;
    const name   = c.companyName ?? c.CompanyName ?? '-';
    const fill   = Math.min(pct, 100);
    const color  = pct >= 100 ? '#10b981' : pct >= 50 ? '#38bdf8' : pct > 0 ? '#f59e0b' : '#ef4444';
    const rankClr= RANK_COLORS[idx] ?? '#6b7280';

    let extra = '';
    if (mode === 'stagnant') {
        extra = `<span class="stagnant-tag">Belum ada laporan</span>`;
    }

    return `
    <div class="co-row">
        <span class="co-rank" style="background:${rankClr};">${idx+1}</span>
        <div style="flex:1;min-width:0;">
            <div class="co-name">${name}</div>
            <div class="co-bar-wrap">
                <div class="co-bar-fill" style="width:${fill}%;background:${color};"></div>
            </div>
        </div>
        ${extra}
        <div>
            <div class="co-pct" style="color:${color};">${pct}%</div>
            <div class="co-detail">${real} / ${tgt}</div>
        </div>
    </div>`;
}

function renderCompanyTabs(data) {
    const fastest  = data.fastestCompanies  || [];
    const stagnant = data.stagnantCompanies || [];
    const all      = data.allCompanies      || [];

    document.getElementById('tab-fastest').innerHTML =
        fastest.length
            ? fastest.map((c,i) => companyRowHtml(c, i, 'fastest')).join('')
            : '<div style="font-size:11px;color:var(--muted);text-align:center;padding:16px;">Belum ada data.</div>';

    document.getElementById('tab-stagnant').innerHTML =
        stagnant.length
            ? stagnant.map((c,i) => companyRowHtml(c, i, 'stagnant')).join('')
            : '<div style="font-size:11px;color:var(--muted);text-align:center;padding:16px;">&#10003; Semua mitra sudah bergerak!</div>';

    document.getElementById('tab-all').innerHTML =
        all.length
            ? all.map((c,i) => companyRowHtml(c, i, 'all')).join('')
            : '<div style="font-size:11px;color:var(--muted);text-align:center;padding:16px;">Belum ada data.</div>';
}

/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   FETCH PERFORMANCE
â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
async function fetchPerformance() {
    try {
        const res  = await fetch('/Display/GetCompanyPerformance');
        if (!res.ok) return;
        const d = await res.json();

        // KPI
        document.getElementById('kv-kar').innerText   = d.totalKaryawan   ?? '-';
        document.getElementById('kv-tgt').innerText   = d.monthlyTarget   ?? '-';
        document.getElementById('kv-real').innerText  = d.monthlyRealization ?? '-';
        document.getElementById('kv-open').innerText  = d.totalOpenHazards ?? '-';
        document.getElementById('kv-close').innerText = (d.complianceClose ?? 0) + '%';
        
        // Zero Incident Safe Days
        const safeDaysEl = document.getElementById('kv-safe-days');
        if (safeDaysEl) {
            safeDaysEl.innerText = (d.safeDays ?? 0) + ' HARI';
        }

        // Running Text Marquee
        const marqueeEl = document.getElementById('marqueeText');
        if (marqueeEl && d.marqueeText) {
            if (marqueeEl.innerText !== d.marqueeText) {
                marqueeEl.innerText = d.marqueeText;
            }
        }

        // SAP bar chart
        if (cSap) {
            cSap.data.datasets[0].data = [
                d.targetHazard    ?? 0,
                d.targetInspeksi  ?? 0,
                d.targetSafetyTalk?? 0,
                d.targetObs       ?? 0,
                d.targetCoaching  ?? 0,
                d.targetP5m       ?? 0
            ];
            cSap.data.datasets[1].data = [
                d.monthHazards    ?? 0,
                d.monthInspections?? 0,
                d.monthSafetyTalks?? 0,
                d.monthObs        ?? 0,
                d.monthCoachings  ?? 0,
                d.monthP5ms       ?? 0
            ];
            cSap.update('active');
        }

        // Donut
        if (cDonut) {
            cDonut.data.datasets[0].data = [
                d.monthHazards    ?? 0,
                d.monthInspections?? 0,
                d.monthSafetyTalks?? 0,
                d.monthObs        ?? 0,
                d.monthCoachings  ?? 0,
                d.monthP5ms       ?? 0
            ];
            cDonut.update('active');
        }

        // Update RHR indicators
        const rriVal = d.rri ?? 0;
        document.getElementById('lbl-rri').innerText = rriVal + '%';
        document.getElementById('bar-rri').style.width = rriVal + '%';

        const compRiskVal = d.complianceRisk ?? 0;
        document.getElementById('lbl-comp-risk').innerText = compRiskVal + '%';
        document.getElementById('bar-comp-risk').style.width = compRiskVal + '%';

        const wTarget = d.weeklyTarget ?? 0;
        const wReal = d.weeklyRealization ?? 0;
        const weeklyPct = wTarget > 0 ? Math.min(Math.round((wReal / wTarget) * 100), 100) : 0;
        document.getElementById('lbl-weekly-pct').innerText = weeklyPct + '%';
        document.getElementById('bar-weekly-pct').style.width = weeklyPct + '%';

        // Render Top Areas/Locations list
        const locs = d.topLocations || [];
        const locList = document.getElementById('location-list');
        if (locs.length === 0) {
            locList.innerHTML = '<div style="font-size:11px; color:var(--muted); text-align:center;">Belum ada data temuan.</div>';
        } else {
            let maxCount = Math.max(...locs.map(l => l.count), 1);
            locList.innerHTML = locs.map((l, i) => {
                const colors = ['var(--amber)', 'var(--blue)', 'var(--green)', 'var(--purple)', 'var(--pink)'];
                const color = colors[i] || 'var(--blue)';
                const pct = Math.round((l.count / maxCount) * 100);
                return `
                <div>
                    <div class="d-flex justify-content-between" style="font-size:10.5px; font-weight:700;">
                        <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px;">${l.locationName}</span>
                        <span>${l.count} temuan</span>
                    </div>
                    <div style="height:4px; background:rgba(255,255,255,0.15); border-radius:2px; margin-top:2px; overflow:hidden;">
                        <div style="height:100%; width:${pct}%; background:${color}; border-radius:2px; transition:width 1s ease;"></div>
                    </div>
                </div>`;
            }).join('');
        }

        // Update Location Polar Chart
        if (cLoc) {
            cLoc.data.labels = locs.map(l => l.locationName);
            cLoc.data.datasets[0].data = locs.map(l => l.count);
            cLoc.update('active');
        }

        // Update Risks Chart
        if (cRisks) {
            cRisks.data.datasets[0].data = [
                d.riskExtreme ?? 0,
                d.riskHigh    ?? 0,
                d.riskMedium  ?? 0,
                d.riskLow     ?? 0
            ];
            cRisks.update('active');
        }

        // Update Status Chart
        if (cStatus) {
            cStatus.data.datasets[0].data = [
                d.totalOpenHazards    ?? 0,
                d.totalOpenActionPlans  ?? 0
            ];
            cStatus.data.datasets[1].data = [
                d.totalProgresHazards  ?? 0,
                d.totalProgresActionPlans ?? 0
            ];
            cStatus.data.datasets[2].data = [
                d.totalClosedHazards  ?? 0,
                d.totalClosedActionPlans ?? 0
            ];
            cStatus.update('active');
        }

        // Update Today's Submissions Chart
        if (cToday) {
            cToday.data.datasets[0].data = [
                d.todayHazards     ?? 0,
                d.todayP2h         ?? 0,
                d.todayP5ms        ?? 0,
                d.todayInspections ?? 0,
                d.todayObservations?? 0,
                d.todaySafetyTalks ?? 0,
                d.todayCoachings   ?? 0
            ];
            cToday.update('active');
        }

        renderCompanyTabs(d);

    } catch(e) {
        console.warn('Performance fetch error:', e);
    }
}

