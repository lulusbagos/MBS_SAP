            catEl.textContent = `RATA-RATA EVALUASI AREA DUMPING & DISPOSAL TAMBANG`;
            colorGrad = 'linear-gradient(90deg, #c2410c, #f97316)';
            const p = d.dci?.paramAvg || {};
            params = [
                { name: 'Lantai Dump (Pad)', val: p.lantai || 100 },
                { name: 'Safety Berm / Bund', val: p.berm || 100 },
                { name: 'Kondisi Crest & Edge', val: p.crest || 100 },
                { name: 'Grade Dumping', val: p.grade || 100 },
                { name: 'Drainase Dump', val: p.drainase || 100 },
                { name: 'Penataan Spillage', val: p.spillage || 100 },
        } else if (d.spi && (currentMode === 'spi' || (currentMode === 'all' && heroSlides[currentHeroIndex]?.type === 'SPI'))) {
            titleEl.innerHTML = `<i class="bi bi-droplet-half text-success"></i> 8 PARAMETER SEDIMENT POND INDEX (SPI)`;
