                { name: 'Risiko Tinggi', val: r.tinggi || 0, max: Math.max(1, b.total || 1), suffix: ' Kasus' },
                { name: 'Sangat Tinggi', val: r.sangatTinggi || 0, max: Math.max(1, b.total || 1), suffix: ' Kasus' },
                { name: 'Observasi Aman', val: b.safeCount || 0, max: Math.max(1, b.total || 1), suffix: ' Orang' },
