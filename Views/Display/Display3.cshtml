    <!-- JAVASCRIPT LOGIC & REAL-TIME AUTO-ROTATION -->
    <script>
    /* ──────────────────────────────────────────────────────────────────────────
       1. STATE & GLOBAL CONFIGURATION
       ────────────────────────────────────────────────────────────────────────── */
    let currentData = null;
    let currentMode = 'all'; // 'all', 'rci', 'fci', 'bbs', 'photo'
    let isAutoRotating = true;
    let currentHeroIndex = 0;
    let heroSlides = [];

    const REFRESH_INTERVAL_SECONDS = 30; // Data refresh
    const HERO_SLIDE_SECONDS = 7;       // Hero photo slide duration
    let slideTimer = null;
    let progressTimer = null;
    let slideProgress = 0;

    /* ──────────────────────────────────────────────────────────────────────────
       2. LIVE DIGITAL CLOCK
       ────────────────────────────────────────────────────────────────────────── */
    function updateLiveClock() {
        const now = new Date();
        const hh = String(now.getHours()).padStart(2, '0');
        const mm = String(now.getMinutes()).padStart(2, '0');
        const ss = String(now.getSeconds()).padStart(2, '0');
        document.getElementById('liveClock').textContent = `${hh}:${mm}:${ss}`;

        const months = ['JAN', 'FEB', 'MAR', 'APR', 'MEI', 'JUN', 'JUL', 'AGU', 'SEP', 'OKT', 'NOV', 'DES'];
        const day = now.getDate();
        const mon = months[now.getMonth()];
        const yr = now.getFullYear();
        document.getElementById('liveDate').textContent = `WITA \u2022 ${day} ${mon} ${yr}`;
    }
    setInterval(updateLiveClock, 1000);
    updateLiveClock();

    /* ──────────────────────────────────────────────────────────────────────────
       3. FETCH DISPLAY 3 DATA (RCI, FCI & BBS)
       ────────────────────────────────────────────────────────────────────────── */
    async function fetchDisplay3Data() {
        try {
            const res = await fetch('/Display/GetDisplay3Data');
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            currentData = data;

            renderKPIs(data);
            prepareHeroSlides(data);
            renderFeed(data);
            renderTelemetry(data);
            renderTicker(data.marqueeText);
        } catch (err) {
            console.error('Error fetching Display 3 data:', err);
        }
    }

