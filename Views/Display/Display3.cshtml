    /* ──────────────────────────────────────────────────────────────────────────
       5. PREPARE & RENDER HERO PHOTO SPOTLIGHT
       ────────────────────────────────────────────────────────────────────────── */
    function prepareHeroSlides(d) {
        if (!d) return;

        let items = [];
        if (currentMode === 'all') {
            items = (d.photoHighlights && d.photoHighlights.length > 0) ? d.photoHighlights : (d.feed || []);
        } else if (currentMode === 'photo') {
            items = d.photoHighlights || [];
        } else {
            const feed = d.feed || [];
            items = feed.filter(x => x.type && x.type.toLowerCase() === currentMode.toLowerCase());
            // prioritize those with photos
            items.sort((a,b) => (b.fotoUrl ? 1 : 0) - (a.fotoUrl ? 1 : 0));
        }

        heroSlides = items.length > 0 ? items : (d.feed || []);
        if (currentHeroIndex >= heroSlides.length) currentHeroIndex = 0;
        renderHeroSlide(currentHeroIndex);
    }

    function renderHeroSlide(idx) {
        if (!heroSlides || heroSlides.length === 0) return;
        const item = heroSlides[idx];
        if (!item) return;

        // Image
        const imgEl = document.getElementById('heroImg');
        const fallbackEl = document.getElementById('heroFallbackPlaceholder');

        if (item.fotoUrl) {
            imgEl.src = item.fotoUrl;
            imgEl.style.display = 'block';
            fallbackEl.style.display = 'none';
        } else {
            imgEl.style.display = 'none';
            fallbackEl.style.display = 'block';
        }

        // Badges
        const typeEl = document.getElementById('heroTypeBadge');
        typeEl.textContent = `${item.type} ${item.typeLabel || ''}`.trim();
        typeEl.style.background = item.type === 'RCI' ? '#0284c7' : (item.type === 'FCI' ? '#d97706' : (item.type === 'DCI' ? '#ea580c' : (item.kategori === 'Aman' ? '#059669' : '#dc2626')));

        document.getElementById('heroAreaBadge').innerHTML = `<i class="bi bi-geo-alt-fill text-warning me-1"></i>${item.area || 'Area Lapangan'}`;
        
        const scoreEl = document.getElementById('heroScoreBadge');
        scoreEl.textContent = item.scoreDisplay || `${item.score}/100`;
        scoreEl.style.background = item.statusColor || '#0284c7';

        // Titles
        document.getElementById('heroTitle').textContent = item.title || 'Laporan Pengamatan';
        document.getElementById('heroSubtitle').textContent = item.subtitle || (item.catatan || 'Detail hasil inspeksi visual di area kerja');
        
        const statusText = document.getElementById('heroStatusText');
        statusText.textContent = item.statusBadge || item.kategori;
        statusText.style.background = item.statusColor || '#475569';

        // Meta
        document.getElementById('heroSurveyor').textContent = item.surveyorNama || item.surveyorNik || 'Observer';
        document.getElementById('heroCompany').textContent = item.surveyorPerusahaan || 'PT Indexim Coalindo';
        document.getElementById('heroDate').textContent = item.tanggal || '-';
        document.getElementById('heroTime').textContent = item.waktu || '-';
    }

    function nextHeroSlide() {
        if (heroSlides.length === 0) return;
        currentHeroIndex = (currentHeroIndex + 1) % heroSlides.length;
        renderHeroSlide(currentHeroIndex);
        resetSlideProgressBar();
    }

    function prevHeroSlide() {
        if (heroSlides.length === 0) return;
        currentHeroIndex = (currentHeroIndex - 1 + heroSlides.length) % heroSlides.length;
        renderHeroSlide(currentHeroIndex);
        resetSlideProgressBar();
    }

    function handleHeroImgError() {
        document.getElementById('heroImg').style.display = 'none';
        document.getElementById('heroFallbackPlaceholder').style.display = 'block';
    }

    /* ──────────────────────────────────────────────────────────────────────────
       6. RENDER DYNAMIC PARAMETER TELEMETRY (RADAR)
