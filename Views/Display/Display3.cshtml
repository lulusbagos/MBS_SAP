@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Display 3 &mdash; RCI, FCI & BBS Field Command Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap" rel="stylesheet">

    <style>
    :root {
        --bg:            #050811;
        --bg-card:       rgba(15, 23, 42, 0.65);
        --panel:         rgba(10, 18, 32, 0.85);
        --border:        rgba(56, 189, 248, 0.15);
        --border-bright: rgba(56, 189, 248, 0.45);
        --txt:           #ffffff;
        --muted:         #94a3b8;
        --blue:          #38bdf8;
        --cyan:          #00d2ff;
        --green:         #34d399;
        --red:           #f87171;
        --amber:         #fbbf24;
        --purple:        #a78bfa;
        --orange:        #fb923c;
        --r:             16px;
    }

    html { background: #050811; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; font-family: inherit; }

    body {
        background: var(--bg);
        background-image: 
            radial-gradient(rgba(56, 189, 248, 0.035) 1px, transparent 1px),
            radial-gradient(circle at 10% 10%, rgba(56, 189, 248, 0.08) 0%, transparent 40%),
            radial-gradient(circle at 90% 90%, rgba(52, 211, 153, 0.06) 0%, transparent 40%),
            radial-gradient(circle at 80% 20%, rgba(251, 191, 36, 0.05) 0%, transparent 35%);
        background-size: 28px 28px, 100% 100%, 100% 100%, 100% 100%;
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: var(--txt);
        height: 100vh;
        overflow: hidden;
        position: relative;
    }

    /* ── Top Countdown Progress Bar ── */
    .top-progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.06);
        z-index: 9999;
    }
    .top-progress-inner {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #00d2ff, #38bdf8, #34d399, #fbbf24);
        box-shadow: 0 0 12px rgba(0, 210, 255, 0.8);
        transition: width 1s linear;
    }

    /* ── TV Main Layout ── */
    .tv-container {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        height: 100vh;
        padding: 10px 16px 10px 16px;
        gap: 10px;
    }

    /* ── Header ── */
    .tv-header {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--r);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 8px 18px;
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        align-items: center;
        gap: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 1px 1px rgba(255,255,255,0.06);
    }

    .brand-box { display: flex; align-items: center; gap: 12px; }
    .brand-icon {
        width: 44px; height: 44px; border-radius: 12px;
        background: linear-gradient(135deg, rgba(0, 210, 255, 0.2), rgba(52, 211, 153, 0.2));
        border: 1.5px solid var(--cyan);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 15px rgba(0, 210, 255, 0.35);
    }
    .brand-title {
        font-family: 'Poppins', sans-serif;
        font-size: 19px; font-weight: 800;
        letter-spacing: 0.2px;
        background: linear-gradient(90deg, #ffffff, #38bdf8, #34d399);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex; align-items: center; gap: 8px;
    }
    .brand-sub {
        font-size: 11px; color: var(--muted); font-weight: 500;
        letter-spacing: 0.6px; text-transform: uppercase;
    }

    /* Mode Switcher Tabs */
    .view-mode-tabs {
        display: flex; align-items: center; gap: 6px;
        background: rgba(0, 0, 0, 0.4);
        padding: 4px 6px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        justify-self: center;
    }
    .mode-btn {
        background: transparent; border: none;
        color: var(--muted); font-size: 11.5px; font-weight: 600;
        padding: 6px 14px; border-radius: 8px;
        cursor: pointer; transition: all 0.25s ease;
        display: inline-flex; align-items: center; gap: 6px;
        font-family: 'Poppins', sans-serif;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .mode-btn:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
    .mode-btn.active {
        background: linear-gradient(135deg, #0284c7, #0369a1);
        color: #ffffff;
        box-shadow: 0 0 14px rgba(2, 132, 199, 0.6);
        border: 1px solid rgba(56, 189, 248, 0.4);
    }
    .mode-btn.active.rci {
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
        box-shadow: 0 0 14px rgba(14, 165, 233, 0.6);
    }
    .mode-btn.active.fci {
        background: linear-gradient(135deg, #d97706, #b45309);
        box-shadow: 0 0 14px rgba(217, 119, 6, 0.6);
    }
    .mode-btn.active.dci {
        background: linear-gradient(135deg, #ea580c, #c2410c);
        box-shadow: 0 0 14px rgba(234, 88, 12, 0.6);
    }
    .mode-btn.active.spi {
        background: linear-gradient(135deg, #059669, #10b981);
        box-shadow: 0 0 14px rgba(16, 185, 129, 0.6);
    }
    .mode-btn.active.bbs {
        background: linear-gradient(135deg, #0284c7, #0369a1);
        box-shadow: 0 0 14px rgba(2, 132, 199, 0.6);
    }

    /* Header Right: Clock & Actions */
    .hdr-actions { display: flex; align-items: center; gap: 12px; }
    .clock-widget {
        display: flex; flex-direction: column; align-items: flex-end;
        padding: 4px 12px; background: rgba(0, 0, 0, 0.35);
        border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .clock-time {
        font-family: 'Poppins', sans-serif;
        font-size: 18px; font-weight: 800;
        color: #38bdf8; letter-spacing: 0.5px;
        font-variant-numeric: tabular-nums;
    }
    .clock-date { font-size: 10px; color: var(--muted); font-weight: 500; }

    .hdr-ctrl-btn {
        width: 38px; height: 38px; border-radius: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
        color: var(--txt); display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: all 0.2s;
    }
    /* Slide Switcher Widget in Header */
    .slide-indicator-widget {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid var(--border);
        border-radius: 30px;
        padding: 4px 12px 4px 10px;
    }
    .slide-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 800;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.3);
        padding: 3px 9px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .slide-timer-text {
        font-size: 11.5px;
        font-weight: 700;
        color: #cbd5e1;
        font-variant-numeric: tabular-nums;
    }
    .slide-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #fff;
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
    }
    .slide-btn:hover {
        background: rgba(56, 189, 248, 0.2);
        border-color: var(--blue);
        color: #fff;
    }

    /* Switch Display Dropdown */
    .switch-display-btn {
        padding: 6px 12px; border-radius: 10px;
        background: rgba(168, 85, 247, 0.15);
        border: 1px solid rgba(168, 85, 247, 0.4);
        color: #c084fc; font-weight: 700; font-size: 11px;
        display: inline-flex; align-items: center; gap: 6px;
        text-decoration: none; transition: all 0.2s;
    }
    .switch-display-btn:hover {
        background: rgba(168, 85, 247, 0.3); color: #fff;
        border-color: #c084fc; box-shadow: 0 0 10px rgba(168, 85, 247, 0.4);
    }

    /* ── Row 1: KPI HUD Cards (No Targets) ── */
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
    }
    .kpi-card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 10px 14px;
        backdrop-filter: blur(16px);
        position: relative; overflow: hidden;
        transition: transform 0.25s, border-color 0.25s;
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        border-color: var(--border-bright);
    }
    .kpi-card::before {
        content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%;
    }
    .kpi-card.rci::before { background: linear-gradient(180deg, #00d2ff, #0284c7); }
    .kpi-card.fci::before { background: linear-gradient(180deg, #fbbf24, #d97706); }
    .kpi-card.dci::before { background: linear-gradient(180deg, #fb923c, #ea580c); }
    .kpi-card.spi::before { background: linear-gradient(180deg, #10b981, #059669); }
    .kpi-card.bbs::before { background: linear-gradient(180deg, #38bdf8, #0284c7); }
    .kpi-card.photo::before { background: linear-gradient(180deg, #a78bfa, #7c3aed); }

    .kpi-hdr {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 6px;
    }
    .kpi-title {
        font-family: 'Poppins', sans-serif;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: var(--muted); display: flex; align-items: center; gap: 6px;
    }
    .kpi-tag {
        font-size: 9.5px; font-weight: 700; padding: 2px 8px; border-radius: 6px;
        font-family: 'Poppins', sans-serif;
    }
    .kpi-body {
        display: flex; align-items: baseline; justify-content: space-between;
    }
    .kpi-num {
        font-family: 'Poppins', sans-serif;
        font-size: 26px; font-weight: 800;
        line-height: 1.1; letter-spacing: -0.5px;
        font-variant-numeric: tabular-nums;
    }
    .kpi-sub { font-size: 11px; color: var(--muted); font-weight: 500; }
    .kpi-footer {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: 8px; padding-top: 6px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 10.5px; color: #cbd5e1;
        font-weight: 500;
    }

    /* ── Main Workstage Grid ── */
    .tv-main-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 12px;
        min-height: 0;
        height: 100%;
        overflow: hidden;
    }

    /* Left Stage: Hero Spotlight & Parameter Radar */
    .stage-left {
        display: grid;
        grid-template-rows: 1fr auto;
        gap: 10px;
        min-height: 0;
        height: 100%;
    }

    /* Hero Photo Card */
    .hero-photo-card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--r);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 12px 35px rgba(0,0,0,0.45);
    }
    .hero-photo-wrap {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 200px;
        background: #020617;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .hero-photo-img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.8s ease;
    }
    .hero-photo-card:hover .hero-photo-img {
        transform: scale(1.03);
    }
    .hero-photo-gradient {
        position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(5,8,17,0.3) 0%, rgba(5,8,17,0.1) 40%, rgba(5,8,17,0.95) 100%);
        pointer-events: none;
    }

    /* Hero Badges & HUD Overlays */
    .hero-badge-top-left {
        position: absolute; top: 14px; left: 14px;
        display: flex; align-items: center; gap: 8px; z-index: 10;
    }
    .hero-badge-top-right {
        position: absolute; top: 14px; right: 14px;
        display: flex; align-items: center; gap: 8px; z-index: 10;
    }
    .hero-badge-type {
        font-family: 'Poppins', sans-serif;
        font-size: 11px; font-weight: 800;
        padding: 5px 12px; border-radius: 8px;
        letter-spacing: 0.5px;
        box-shadow: 0 0 15px rgba(0,0,0,0.6);
        display: inline-flex; align-items: center; gap: 6px;
    }
    .hero-badge-score {
        font-family: 'Poppins', sans-serif;
        font-size: 14px; font-weight: 800;
        padding: 5px 14px; border-radius: 8px;
        box-shadow: 0 0 15px rgba(0,0,0,0.6);
        font-variant-numeric: tabular-nums;
    }

    /* Hero Info Overlay (Bottom) */
    .hero-info-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 16px 20px 14px 20px;
        z-index: 10;
    }
    .hero-title {
        font-size: 20px; font-weight: 800; color: #ffffff;
        font-family: 'Poppins', sans-serif;
        text-shadow: 0 2px 8px rgba(0,0,0,0.8);
        margin-bottom: 2px;
        display: flex; align-items: center; gap: 10px;
    }
    .hero-subtitle {
        font-size: 12px; color: #cbd5e1; font-weight: 500;
        margin-bottom: 8px; text-shadow: 0 1px 4px rgba(0,0,0,0.8);
    }
    .hero-meta-row {
        display: flex; align-items: center; flex-wrap: wrap; gap: 14px;
        font-size: 11px; color: var(--muted);
    }
    .hero-meta-item { display: inline-flex; align-items: center; gap: 5px; }

    /* Hero Navigation Buttons */
    .hero-nav-btn {
        position: absolute; top: 50%; transform: translateY(-50%);
        width: 38px; height: 38px; border-radius: 50%;
        background: rgba(10, 18, 32, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff; display: flex; align-items: center; justify-content: center;
        cursor: pointer; z-index: 15; transition: all 0.2s;
    }
    .hero-nav-btn:hover {
        background: rgba(56, 189, 248, 0.4);
        border-color: var(--blue);
        box-shadow: 0 0 15px rgba(56, 189, 248, 0.5);
    }
    .hero-nav-btn.prev { left: 12px; }
    .hero-nav-btn.next { right: 12px; }

    /* Parameters Telemetry Matrix Box */
    .telemetry-box {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 12px 16px;
        backdrop-filter: blur(16px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
    .telemetry-hdr {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 10px;
    }
    .telemetry-title {
        font-family: 'Poppins', sans-serif;
        font-size: 12px; font-weight: 800;
        color: var(--txt); text-transform: uppercase; letter-spacing: 0.6px;
        display: flex; align-items: center; gap: 6px;
    }
    .telemetry-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }
    .param-bar-item {
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 8px; padding: 6px 10px;
    }
    .param-bar-lbl {
        display: flex; justify-content: space-between; align-items: center;
        font-size: 9.5px; font-weight: 700; color: var(--muted); margin-bottom: 4px;
        text-transform: uppercase;
    }
    .param-bar-val {
        font-family: 'Poppins', sans-serif; font-variant-numeric: tabular-nums; font-size: 11px; font-weight: 800;
    }
    .param-track {
        height: 5px; width: 100%; background: rgba(255, 255, 255, 0.08);
        border-radius: 3px; overflow: hidden;
    }
    .param-fill {
        height: 100%; border-radius: 3px;
        transition: width 0.6s ease;
    }

    /* Right Stage: Continuous Auto-Scrolling Live Feed */
    .stage-right {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--r);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        backdrop-filter: blur(16px);
        box-shadow: 0 12px 35px rgba(0,0,0,0.45);
    }
    .feed-header {
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
        background: rgba(0,0,0,0.25);
    }
    .feed-title {
        font-family: 'Poppins', sans-serif;
        font-size: 13px; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.8px;
        color: #ffffff; display: flex; align-items: center; gap: 8px;
    }
    .feed-badge {
        font-size: 10px; font-weight: 800;
        padding: 3px 8px; border-radius: 6px;
        background: rgba(56, 189, 248, 0.15); color: var(--blue);
        border: 1px solid rgba(56, 189, 248, 0.3);
        font-family: 'Poppins', sans-serif;
    }

    /* Feed Scroll Box */
    .feed-scroll-box {
        flex: 1;
        overflow-y: hidden;
        position: relative;
        padding: 10px 12px;
    }
    .feed-items-container {
        display: flex; flex-direction: column; gap: 8px;
        transition: transform 0.1s linear;
    }

    /* Feed Card */
    .feed-card {
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 12px;
        padding: 9px 12px;
        display: grid;
        grid-template-columns: 60px 1fr auto;
        gap: 12px;
        align-items: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .feed-card:hover {
        background: rgba(30, 41, 59, 0.7);
        border-color: var(--blue);
        transform: translateX(3px);
        box-shadow: 0 4px 15px rgba(0, 210, 255, 0.15);
    }
    .feed-thumb-box {
        width: 60px; height: 50px; border-radius: 8px;
        overflow: hidden; background: #0b1329;
        position: relative; border: 1px solid rgba(255,255,255,0.1);
        display: flex; align-items: center; justify-content: center;
    }
    .feed-thumb-img {
        width: 100%; height: 100%; object-fit: cover;
    }
    .feed-thumb-placeholder {
        font-size: 20px; color: var(--muted);
    }
    .feed-info-box { min-width: 0; }
    .feed-item-hdr {
        display: flex; align-items: center; gap: 6px; margin-bottom: 2px;
    }
    .feed-type-pill {
        font-size: 8.5px; font-weight: 800; padding: 1px 6px; border-radius: 4px;
        font-family: 'Poppins', sans-serif; text-transform: uppercase; letter-spacing: 0.4px;
    }
    .feed-item-title {
        font-size: 12.5px; font-weight: 800; color: #ffffff;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .feed-item-sub {
        font-size: 10.5px; color: var(--muted);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .feed-meta-row {
        font-size: 9.5px; color: #64748b; margin-top: 2px;
        display: flex; align-items: center; gap: 8px;
    }
    .feed-score-col {
        text-align: right; min-width: 75px;
    }
    .feed-score-num {
        font-family: 'Poppins', sans-serif; font-variant-numeric: tabular-nums;
        font-size: 13px; font-weight: 900;
    }
    .feed-status-pill {
        font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px;
        display: inline-block; margin-top: 2px;
    }

    /* ── Bottom Ticker / Newsflash ── */
    .tv-footer-ticker {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 6px 14px;
        display: flex; align-items: center; gap: 12px;
        overflow: hidden;
    }
    .ticker-lbl {
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        color: #fff; font-family: 'Poppins', sans-serif;
        font-size: 11px; font-weight: 800;
        padding: 4px 10px; border-radius: 6px;
        white-space: nowrap;
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    }
    .ticker-scroll-wrap {
        flex: 1; overflow: hidden; white-space: nowrap; position: relative;
    }
    .ticker-text {
        display: inline-block;
        padding-left: 100%;
        animation: marqueeAnim 45s linear infinite;
        font-size: 12px; font-weight: 600; color: #e2e8f0;
        letter-spacing: 0.5px;
    }
    @@keyframes marqueeAnim {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }

    /* ── High-Tech Lightbox Modal ── */
    .tech-modal-overlay {
        position: fixed; inset: 0;
        background: rgba(2, 6, 23, 0.88);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        z-index: 10000;
        display: none; align-items: center; justify-content: center;
        padding: 20px;
    }
    .tech-modal-card {
        background: #090f1e;
        border: 1px solid var(--border-bright);
        box-shadow: 0 25px 60px rgba(0,0,0,0.8), 0 0 30px rgba(56, 189, 248, 0.25);
