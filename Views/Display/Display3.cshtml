    /* ──────────────────────────────────────────────────────────────────────────
       7. RENDER LIVE CARDS STREAM FEED & AUTO-SCROLL
       ────────────────────────────────────────────────────────────────────────── */
    function renderFeed(d) {
        if (!d) return;

        let items = d.feed || [];
        if (currentMode === 'rci') items = items.filter(x => x.type === 'RCI');
        else if (currentMode === 'fci') items = items.filter(x => x.type === 'FCI');
        else if (currentMode === 'dci') items = items.filter(x => x.type === 'DCI');
        else if (currentMode === 'spi') items = items.filter(x => x.type === 'SPI');
        else if (currentMode === 'bbs') items = items.filter(x => x.type === 'BBS');
        else if (currentMode === 'photo') items = items.filter(x => !stringIsNullOrEmpty(x.fotoUrl));

        document.getElementById('feedCounter').textContent = `${items.length} LAPORAN`;

        const container = document.getElementById('feedContainer');
        if (items.length === 0) {
            container.innerHTML = `<div class="p-4 text-center text-muted" style="font-size:12.5px;">Belum ada laporan pada kategori ini.</div>`;
            return;
        }

        container.innerHTML = items.map((item, index) => {
            const hasPhoto = Boolean(item.fotoUrl);
            const thumbHtml = hasPhoto
                ? `<img src="${item.fotoUrl}" class="feed-thumb-img" alt="Foto" onerror="this.src='/img/placeholder-photo.png'" />`
                : `<i class="bi ${item.type === 'RCI' ? 'bi-cone-striped text-info' : (item.type === 'FCI' ? 'bi-truck-front-fill text-warning' : (item.type === 'DCI' ? 'bi-layers-fill text-warning' : (item.type === 'SPI' ? 'bi-droplet-half text-success' : 'bi-shield-check text-info')))} feed-thumb-placeholder"></i>`;

            const pillBg = item.type === 'RCI' ? 'rgba(14, 165, 233, 0.2); color:#38bdf8;' : (item.type === 'FCI' ? 'rgba(217, 119, 6, 0.2); color:#fbbf24;' : (item.type === 'DCI' ? 'rgba(249, 115, 22, 0.2); color:#fb923c;' : (item.type === 'SPI' ? 'rgba(16, 185, 129, 0.2); color:#10b981;' : 'rgba(2, 132, 199, 0.2); color:#38bdf8;')));

            return `
            <div class="feed-card" onclick='openModalWithItem(${JSON.stringify(item).replace(/'/g, "&#39;")})'>
                <div class="feed-thumb-box">
                    ${thumbHtml}
                </div>
                <div class="feed-info-box">
                    <div class="feed-item-hdr">
                        <span class="feed-type-pill" style="background:${pillBg}">${item.type}</span>
                        <div class="feed-item-title" title="${item.title}">${item.title}</div>
                    </div>
                    <div class="feed-item-sub" title="${item.subtitle}">${item.subtitle}</div>
                    <div class="feed-meta-row">
                        <span><i class="bi bi-person me-1"></i>${item.surveyorNama || item.surveyorNik}</span>
                        <span><i class="bi bi-geo-alt me-1"></i>${item.area}</span>
                        <span><i class="bi bi-clock me-1"></i>${item.waktu}</span>
                        ${hasPhoto ? '<span class="text-warning"><i class="bi bi-camera-fill me-0.5"></i>Foto</span>' : ''}
                    </div>
                </div>
                <div class="feed-score-col">
                    <div class="feed-score-num" style="color:${item.statusColor};">${item.scoreDisplay}</div>
                    <div class="feed-status-pill" style="background:${item.statusColor}22; color:${item.statusColor}; border:1px solid ${item.statusColor}44;">
                        ${item.statusBadge}
                    </div>
                </div>
            </div>
            `;
        }).join('');
    }

    function stringIsNullOrEmpty(str) {
        return !str || str.trim() === '';
    }

    /* ── Smooth Auto-Scroll Feed Loop ── */
    let isFeedPaused = false;
    let feedScrollPos = 0;

    function runFeedAutoScroll() {
        if (!isFeedPaused) {
            const box = document.getElementById('feedScrollBox');
            const content = document.getElementById('feedContainer');
            if (box && content) {
                const maxScroll = content.scrollHeight - box.clientHeight;
                if (maxScroll > 15) {
                    feedScrollPos += 0.45;
                    if (feedScrollPos >= maxScroll) {
                        feedScrollPos = maxScroll;
                        isFeedPaused = true;
                        setTimeout(() => {
                            feedScrollPos = 0;
                            content.style.transform = `translateY(-${feedScrollPos}px)`;
                            setTimeout(() => { isFeedPaused = false; }, 2000);
                        }, 4000);
                    }
                    content.style.transform = `translateY(-${feedScrollPos}px)`;
                }
            }
        }
        requestAnimationFrame(runFeedAutoScroll);
    }
    requestAnimationFrame(runFeedAutoScroll);

    function pauseFeedScroll() { isFeedPaused = true; }
    function resumeFeedScroll() { isFeedPaused = false; }

    /* ──────────────────────────────────────────────────────────────────────────
       8. MARQUEE TICKER
       ────────────────────────────────────────────────────────────────────────── */
    function renderTicker(text) {
        if (text) {
            document.getElementById('tickerText').textContent = text;
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       9. MODE SWITCHER & CATEGORY SLIDESHOW ROTATION
       ────────────────────────────────────────────────────────────────────────── */
    const MENU_SLIDES = ['all', 'bbs', 'rci', 'fci', 'dci', 'spi'];
    const MENU_LABELS = {
        all: 'SEMUA RADAR',
        bbs: 'BBS PERILAKU',
        rci: 'RCI ROAD',
        fci: 'FCI FRONT',
        dci: 'DCI DUMP',
        spi: 'SPI KOLAM'
    };
    let menuSlideIndex = 0;
    let isMenuAutoSlide = true;
    let menuSecondsLeft = 20;
    const MENU_CYCLE_SECONDS = 20;

    function userSelectMode(mode) {
        // Find index if in rotation
        const idx = MENU_SLIDES.indexOf(mode.toLowerCase());
        if (idx !== -1) {
            menuSlideIndex = idx;
        }
        menuSecondsLeft = MENU_CYCLE_SECONDS;
        switchDisplayMode(mode);
    }

    function switchDisplayMode(mode) {
        currentMode = mode;
        ['All', 'Rci', 'Fci', 'Dci', 'Spi', 'Bbs', 'Photo'].forEach(m => {
            const btn = document.getElementById(`tab${m}Btn`);
            if (btn) btn.classList.toggle('active', m.toLowerCase() === mode.toLowerCase());
        });

        // Update menu indicator
        const labelEl = document.getElementById('currentMenuLabel');
        if (labelEl) {
            labelEl.textContent = MENU_LABELS[mode.toLowerCase()] || mode.toUpperCase();
        }

        if (currentData) {
            prepareHeroSlides(currentData);
            renderFeed(currentData);
            renderTelemetry(currentData);
        }
        resetSlideProgressBar();
    }

    function updateMenuRotateTimer() {
        if (!isMenuAutoSlide) return;
        menuSecondsLeft--;
        const cdEl = document.getElementById('menuCountdown');
        if (cdEl) cdEl.textContent = `${menuSecondsLeft}s`;

        if (menuSecondsLeft <= 0) {
            menuSecondsLeft = MENU_CYCLE_SECONDS;
            menuSlideIndex = (menuSlideIndex + 1) % MENU_SLIDES.length;
            const nextMode = MENU_SLIDES[menuSlideIndex];
            switchDisplayMode(nextMode);
        }
    }
    setInterval(updateMenuRotateTimer, 1000);

    function toggleMenuAutoSlide() {
        isMenuAutoSlide = !isMenuAutoSlide;
        const icon = document.getElementById('menuPauseIcon');
        const text = document.getElementById('menuPauseText');
        const badge = document.getElementById('menuRotateBadge');
        if (isMenuAutoSlide) {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (text) text.innerText = 'Jeda';
            if (badge) {
                badge.style.background = 'rgba(16, 185, 129, 0.18)';
                badge.style.color = '#10b981';
            }
        } else {
            if (icon) icon.className = 'bi bi-play-fill';
            if (text) text.innerText = 'Lanjut';
            if (badge) {
                badge.style.background = 'rgba(239, 68, 68, 0.2)';
                badge.style.color = '#ef4444';
            }
        }
    }

    function toggleAutoRotation() {
        isAutoRotating = !isAutoRotating;
        const icon = document.getElementById('playPauseIcon');
        if (isAutoRotating) {
            icon.className = 'bi bi-pause-fill';
            startSlideLoop();
        } else {
            icon.className = 'bi bi-play-fill';
            stopSlideLoop();
        }
    }

    let heroSlideInterval = null;
    function startSlideLoop() {
        if (heroSlideInterval) clearInterval(heroSlideInterval);
        heroSlideInterval = setInterval(() => {
            if (isAutoRotating) {
                nextHeroSlide();
            }
        }, HERO_SLIDE_SECONDS * 1000);
    }

    function stopSlideLoop() {
        if (heroSlideInterval) clearInterval(heroSlideInterval);
    }

    /* ──────────────────────────────────────────────────────────────────────────
       10. LIGHTBOX MODAL WITH FULL AUDIT DETAILS
       ────────────────────────────────────────────────────────────────────────── */
    function openHeroInLightbox() {
        if (!heroSlides || heroSlides.length === 0) return;
        const item = heroSlides[currentHeroIndex];
        if (item) openModalWithItem(item);
    }

    function openModalWithItem(item) {
        const modal = document.getElementById('techModal');
        document.getElementById('modalImg').src = item.fotoUrl || '/img/placeholder-photo.png';
        
        const typeBadge = document.getElementById('modalTypeBadge');
        typeBadge.textContent = `${item.type} - ${item.typeLabel || ''}`;
        typeBadge.style.background = item.type === 'RCI' ? '#0284c7' : (item.type === 'FCI' ? '#d97706' : (item.type === 'DCI' ? '#f97316' : (item.type === 'SPI' ? '#059669' : (item.kategori === 'Aman' ? '#059669' : '#dc2626'))));

        const scoreBadge = document.getElementById('modalScoreBadge');
        scoreBadge.textContent = item.scoreDisplay || `${item.score}/100`;
        scoreBadge.style.background = item.statusColor || '#0284c7';

        document.getElementById('modalTitle').textContent = item.title || 'Laporan Lapangan';
        document.getElementById('modalSubtitle').textContent = item.subtitle || '-';
        document.getElementById('modalArea').textContent = item.area || '-';
        document.getElementById('modalSurveyor').textContent = item.surveyorNama || item.surveyorNik;
        document.getElementById('modalCompany').textContent = item.surveyorPerusahaan || 'PT Indexim Coalindo';
        document.getElementById('modalDateTime').textContent = `${item.tanggal} \u2022 ${item.waktu} WITA`;

        const gpsWrap = document.getElementById('modalGpsWrap');
        if (item.lat && item.lng) {
            document.getElementById('modalGps').textContent = `${item.lat}, ${item.lng}`;
            gpsWrap.classList.remove('d-none');
        } else {
            gpsWrap.classList.add('d-none');
        }

        // Details / Parameters List
        const listEl = document.getElementById('modalParamsList');
        if (item.details && item.details.length > 0) {
            listEl.innerHTML = item.details.map(d => `
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="border-color: rgba(255,255,255,0.06) !important; font-size: 12px;">
                    <span class="text-muted">${d.label}</span>
                    <span class="fw-bold text-white">${d.val}/100</span>
                </div>
            `).join('');
            document.getElementById('modalParamsBox').style.display = 'block';
        } else {
            document.getElementById('modalParamsBox').style.display = 'none';
        }

        // Catatan
        const catBox = document.getElementById('modalCatatanBox');
        if (item.catatan && item.catatan !== '-') {
            document.getElementById('modalCatatan').textContent = item.catatan;
            catBox.style.display = 'block';
        } else {
            catBox.style.display = 'none';
        }

        // Tindakan
        const tinBox = document.getElementById('modalTindakanBox');
        if (item.tindakan && item.tindakan !== '-') {
            document.getElementById('modalTindakan').textContent = item.tindakan;
            tinBox.style.display = 'block';
        } else {
            tinBox.style.display = 'none';
        }

        modal.style.display = 'flex';
    }

    function closeLightbox() {
        document.getElementById('techModal').style.display = 'none';
    }

    // Fullscreen Toggle
    function toggleFullScreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => console.log(err));
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       11. 5-MINUTE AUTO SLIDE TRANSITION (DISPLAY 3 -> DISPLAY 1 ROTATION LOOP)
       ────────────────────────────────────────────────────────────────────────── */
    const SLIDE_DURATION_SECONDS = 300; // 5 minutes = 300 seconds
    let slideTimeRemaining = SLIDE_DURATION_SECONDS;
    let isSlidePaused = false;

    function updateSlideTimer() {
        if (isSlidePaused) return;

        slideTimeRemaining--;
        if (slideTimeRemaining < 0) {
            // Transition back to Display 1 (creating continuous 3-display rotation)
            window.location.href = '/Display';
            return;
        }

        const mins = Math.floor(slideTimeRemaining / 60);
        const secs = slideTimeRemaining % 60;
        const countdownEl = document.getElementById('slideCountdown');
        if (countdownEl) {
            countdownEl.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        const progressPct = ((SLIDE_DURATION_SECONDS - slideTimeRemaining) / SLIDE_DURATION_SECONDS) * 100;
        const progressEl = document.getElementById('topProgressBar');
        if (progressEl) {
            progressEl.style.width = `${progressPct}%`;
        }
    }
    setInterval(updateSlideTimer, 1000);

    function togglePauseSlide() {
        isSlidePaused = !isSlidePaused;
        const icon = document.getElementById('pauseIcon');
        const text = document.getElementById('pauseText');
        const btn = document.getElementById('togglePauseBtn');
        if (isSlidePaused) {
            if (icon) icon.className = 'bi bi-play-fill';
            if (text) text.innerText = 'Lanjut';
            if (btn) {
                btn.style.background = 'rgba(239, 68, 68, 0.3)';
                btn.style.borderColor = '#ef4444';
            }
        } else {
            if (icon) icon.className = 'bi bi-pause-fill';
            if (text) text.innerText = 'Jeda';
            if (btn) {
                btn.style.background = 'rgba(255, 255, 255, 0.06)';
                btn.style.borderColor = 'rgba(255, 255, 255, 0.12)';
            }
        }
    }

    /* ──────────────────────────────────────────────────────────────────────────
       12. INITIALIZATION & RECURRING DATA REFRESH
       ────────────────────────────────────────────────────────────────────────── */
    fetchDisplay3Data();
    startSlideLoop();
    setInterval(fetchDisplay3Data, REFRESH_INTERVAL_SECONDS * 1000);
    </script>
</body>
</html>
