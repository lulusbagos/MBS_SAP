            colorGrad = 'linear-gradient(90deg, #d97706, #fbbf24)';
            const p = d.fci?.paramAvg || {};
            params = [
                { name: 'Lantai Front', val: p.lantai || 100 },
                { name: 'Ruang Manuver', val: p.manuver || 100 },
                { name: 'Safety Berm', val: p.berm || 100 },
                { name: 'Kondisi Dinding', val: p.dinding || 100 },
                { name: 'Drainase Sump', val: p.sump || 100 },
                { name: 'Kebersihan', val: p.spillage || 100 },
