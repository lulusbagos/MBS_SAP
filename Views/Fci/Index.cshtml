</style>

@section Scripts {
<script>
    let currentFciSummaryData = {};

    $(document).ready(function() {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            var sElem = document.getElementById('statusSuccessModal');
            if (sElem) { new bootstrap.Modal(sElem).show(); }
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            var eElem = document.getElementById('statusErrorModal');
            if (eElem) { new bootstrap.Modal(eElem).show(); }
            </text>
        }
        calculateFciScore();
    });

    function confirmDeleteFci(id) {
        $('#deleteForm').attr('action', '/Fci/Delete/' + id);
        var delModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        delModal.show();
    }

    $('#fciForm').on('submit', function(e) {
        const area = $('#area').val();
        const pit = ($('#pit').val() || '').trim();
        const front = ($('#namaFront').val() || '').trim();
        const lokasi = ($('#lokasi').val() || '').trim();

        if (!area || !pit || !front || !lokasi) {
            e.preventDefault();
            $('#clientAlertTitle').text('Data Belum Lengkap');
            $('#clientAlertMsg').text('Mohon lengkapi Area Utama, Pit/Sektor, Nama Front, dan Lokasi Spesifik sebelum menyimpan.');
            var alertModal = new bootstrap.Modal(document.getElementById('clientAlertModal'));
            alertModal.show();
            return false;
        }
    });

    // Dynamic Live Score, Conclusion, Feasibility & Findings Calculator
    function calculateFciScore() {
        const p1 = parseInt($('#skorLantaiFront').val()) || 100;
        const p2 = parseInt($('#skorRuangManuver').val()) || 100;
        const p3 = parseInt($('#skorSafetyBerm').val()) || 100;
        const p4 = parseInt($('#skorKondisiDinding').val()) || 100;
        const p5 = parseInt($('#skorDrainaseSump').val()) || 100;
        const p6 = parseInt($('#skorKebersihanSpillage').val()) || 100;
        const p7 = parseInt($('#skorPosisiAlat').val()) || 100;
        const p8 = parseInt($('#skorRambuPenerangan').val()) || 100;

        const total = (p1 * 0.15) + (p2 * 0.15) + (p3 * 0.15) + (p4 * 0.15) + (p5 * 0.10) + (p6 * 0.10) + (p7 * 0.10) + (p8 * 0.10);
        const rounded = total.toFixed(1);

        const paramsList = [
            { name: "Lantai Front (Floor)", val: p1, desc100: "Rata & Padat Standar", desc70: "Bergelombang / Undulasi Sedang", desc40: "Amblas / Becek Parah (Rawan Amblas)" },
            { name: "Ruang Manuver & Spotting", val: p2, desc100: "Luas & Double Spotting", desc70: "Pas-pasan (Single Spotting)", desc40: "Sempit / Bahaya Senggolan Unit" },
            { name: "Safety Berm Front", val: p3, desc100: "≥ 3/4 Roda & Kokoh", desc70: "Kurang Tinggi (1/2 Roda)", desc40: "Tidak Ada Tanggul / Drop-off Rawan" },
            { name: "Kondisi Dinding (Highwall)", val: p4, desc100: "Dinding Stabil & Aman", desc70: "Retak Halus / Potensi Menggantung", desc40: "Overhang / Rawan Longsor Kritis" },
            { name: "Drainase & Sump Front", val: p5, desc100: "Kering & Lancar (Sump Terawat)", desc70: "Ada Genangan di Sudut Front", desc40: "Terendam Air / Sump Penuh Meluap" },
            { name: "Kebersihan Ceceran Material", val: p6, desc100: "Bersih Rapi Bebas Boulder", desc70: "Ada Ceceran Batuan Sedang", desc40: "Boulder Berserakan di Lantai (Merusak Ban)" },
            { name: "Posisi & Ketinggian Bench", val: p7, desc100: "Optimal Jangkauan Gali", desc70: "Agak Tinggi / Sudut Terbatas", desc40: "Terlalu Tinggi / Undercut Bahaya Tertimbun" },
            { name: "Rambu & Penerangan Front", val: p8, desc100: "Terang & Rambu Lengkap", desc70: "Kurang Terang / Kusam", desc40: "Gelap / Tanpa Rambu Peringatan" }
        ];

        let cnt100 = 0, cnt70 = 0, cnt40 = 0;
        let findings = [];
        let autoActions = [];

        paramsList.forEach(p => {
            if (p.val === 100) cnt100++;
            else if (p.val === 70) {
                cnt70++;
                findings.push(`<b>${p.name}</b>: Skor 70 (${p.desc70})`);
                if (p.name.includes("Lantai")) autoActions.push("Dukungan dozer merapikan dan memadatkan lantai kerja front");
                else if (p.name.includes("Berm")) autoActions.push("Peninggian tanggul crest front minimal 3/4 roda alat angkut");
                else if (p.name.includes("Drainase") || p.name.includes("Sump")) autoActions.push("Dewatering sump front dan parit pengalir air");
                else if (p.name.includes("Manuver")) autoActions.push("Perluasan area manuver dan penataan pola spotting");
                else if (p.name.includes("Dinding")) autoActions.push("Scaling batuan gantung dan pemantauan retakan berkala");
                else if (p.name.includes("Material")) autoActions.push("Pembersihan boulder ceceran di area lintasan loading");
                else if (p.name.includes("Rambu")) autoActions.push("Optimalisasi penataan tower lamp dan perbaikan rambu front");
                else autoActions.push(`Penyesuaian perbaikan pada ${p.name}`);
            } else if (p.val === 40) {
                cnt40++;
                findings.push(`<span class="text-danger"><b>${p.name}</b>: Skor 40 (${p.desc40}) [KRITIS]</span>`);
                if (p.name.includes("Dinding")) autoActions.push("URGENT / STOP: Penanganan segera overhang / retakan highwall oleh alat gali");
                else if (p.name.includes("Berm")) autoActions.push("URGENT: Rekonstruksi segera safety berm crest sebelum aktivitas loading dilanjutkan");
                else if (p.name.includes("Lantai")) autoActions.push("URGENT: Re-sheeting material kering & pemadatan intensif");
                else if (p.name.includes("Drainase")) autoActions.push("URGENT: Tambah pompa aktif & sodetan pembuangan air front");
                else if (p.name.includes("Material")) autoActions.push("URGENT: Singkirkan bongkahan boulder besar dengan wheel loader");
                else autoActions.push(`URGENT: Rekayasa penanganan keselamatan pada ${p.name}`);
            }
        });

        $('#cntStandar').text(cnt100);
        $('#cntPerhatian').text(cnt70);
        $('#cntKritis').text(cnt40);

        let label = "Baik";
        let color = "#10b981";
        let bg = "rgba(16, 185, 129, 0.15)";
        let border = "rgba(16, 185, 129, 0.4)";
        let statusTitle = "STATUS: FRONT LAYAK OPERASI PENUH (OPTIMAL)";
        let statusDesc = "Seluruh 8 parameter front memenuhi standar keselamatan loading & digging area tambang.";
        let statusIcon = "bi-shield-fill-check";

        if (total < 70) {
            label = "Kurang";
            color = "#f43f5e";
            bg = "rgba(244, 63, 94, 0.15)";
            border = "rgba(244, 63, 94, 0.4)";
            statusTitle = "STATUS: FRONT RAWAN / PERLU PERBAIKAN SEGERA";
            statusDesc = "Ditemukan parameter kritis di bawah standar keselamatan loading front. Hentikan/batasi operasional hingga direkayasa aman.";
            statusIcon = "bi-x-octagon-fill";
        } else if (total < 85) {
            label = "Sedang";
            color = "#f59e0b";
            bg = "rgba(245, 158, 11, 0.15)";
            border = "rgba(245, 158, 11, 0.4)";
            statusTitle = "STATUS: FRONT LAYAK DENGAN PENGAWASAN & CATATAN";
            statusDesc = "Operasi pemuatan dapat berjalan dengan perhatian khusus pada parameter yang perlu perbaikan/dozer support.";
            statusIcon = "bi-exclamation-triangle-fill";
        }

        $('#liveScoreVal').text(rounded);
        $('#liveScoreBadge').html(`Skor FCI: <span>${rounded}</span>% (${label})`).css({ 'background': bg, 'color': color, 'border-color': border });

        $('#summaryScoreVal').text(rounded + '%').css('color', color);
        $('#summaryCategoryBadge').html(`<i class="bi ${statusIcon} me-1"></i> ${label.toUpperCase()}`).css({ 'background': bg, 'color': color });

        $('#feasibilityBanner').css({ 'background': bg, 'border-color': border, 'color': color });
        $('#feasibilityIcon').attr('class', `bi ${statusIcon}`);
        $('#feasibilityTitle').text(statusTitle);
        $('#feasibilityDesc').text(statusDesc);

        // Update findings list
        if (findings.length === 0) {
            $('#findingsCountBadge').text('0 Defisit').attr('class', 'badge bg-success');
            $('#findingsList').html('<i class="bi bi-check2-circle text-success me-1"></i> Semua parameter berada dalam batas optimal.');
            $('#autoRecText').text('Pertahankan kondisi standar kerja di front loading.');
        } else {
            $('#findingsCountBadge').text(`${findings.length} Temuan Defisit`).attr('class', 'badge bg-warning text-dark');
            let listHtml = '<ul class="mb-0 ps-3">' + findings.map(f => `<li class="mb-1">${f}</li>`).join('') + '</ul>';
            $('#findingsList').html(listHtml);
            let recText = autoActions.length > 0 ? autoActions.join("; ") + "." : "Lakukan perbaikan terarah pada parameter defisit.";
            $('#autoRecText').text(recText);
        }

        // Store summary for sharing
        currentFciSummaryData = {
            totalScore: rounded,
            kategori: label,
            statusTitle: statusTitle,
            cnt100: cnt100,
            cnt70: cnt70,
            cnt40: cnt40,
            findings: findings,
            autoRec: $('#autoRecText').text()
        };
    }

    // Button Score Selector (Supports both classes)
    $(document).on('click', '.btn-score-card, .btn-fci-score', function() {
        const param = $(this).data('param');
        const val = $(this).data('val');

        $(`.btn-score-card[data-param="${param}"], .btn-fci-score[data-param="${param}"]`).removeClass('active');
        $(this).addClass('active');

        $(`#${param}`).val(val);
        calculateFciScore();
    });

    function applyAutoRecommendationFci() {
        const rec = $('#autoRecText').text().trim();
        if (rec) {
            $('#tindakanPerbaikan').val(rec);
            $('#clientAlertTitle').text('Rekomendasi Diterapkan');
            $('#clientAlertMsg').text('Rekomendasi tindakan otomatis telah disalin ke formulir rekomendasi perbaikan front.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
        }
    }

    function generateFciShareText() {
        const tgl = $('#tanggal').val() || '';
        const wkt = $('#waktuStr').val() || '';
        const area = $('#area').val() || '-';
        const pit = $('#pit').val() || '-';
        const front = $('#namaFront').val() || $('#lokasi').val() || '-';
        const shift = $('#shift').val() || '';
        const loc = $('#lokasi').val() || '';
        const rl = $('#detilLokasi').val() || '';
        const pic = $('#pic').val() || '-';
        const perbaikan = $('#tindakanPerbaikan').val() || currentFciSummaryData.autoRec || '-';

        let text = `⛏️ *LAPORAN INSPEKSI FRONT CONDITION INDEX (FCI)* ⛏️\n`;
        text += `*PT MEGA GLOBAL ENERGY GROUP*\n\n`;
        text += `📅 Tanggal: ${tgl} ${wkt} (${shift})\n`;
        text += `📍 Nama Front: ${front}\n`;
        text += `📌 Area / Pit: ${area} | ${pit} ${rl ? `[RL: ${rl}]` : ''}\n`;
        text += `🗺️ Lokasi: ${loc}\n\n`;
        text += `⭐ *SKOR AKHIR: ${currentFciSummaryData.totalScore || '100'}% (${currentFciSummaryData.kategori || 'Baik'})*\n`;
        text += `📋 *${currentFciSummaryData.statusTitle || 'STATUS: FRONT LAYAK OPERASI PENUH'}*\n\n`;
        text += `📊 *Komposisi Parameter:*\n`;
        text += `• Sesuai Standar (100): ${currentFciSummaryData.cnt100 || 8}\n`;
        text += `• Perlu Perhatian (70): ${currentFciSummaryData.cnt70 || 0}\n`;
        text += `• Kritis / Substandard (40): ${currentFciSummaryData.cnt40 || 0}\n\n`;

        if (currentFciSummaryData.findings && currentFciSummaryData.findings.length > 0) {
            text += `🔍 *Temuan Defisit:*\n`;
            currentFciSummaryData.findings.forEach(f => {
                text += `• ${f.replace(/<[^>]*>/g, '')}\n`;
            });
            text += `\n`;
        } else {
            text += `🔍 *Temuan:* Seluruh parameter front dalam batas optimal.\n\n`;
        }

        text += `🛠️ *Rekomendasi Tindakan:*\n${perbaikan}\n`;
        text += `👷 PIC: ${pic}\n`;
        return text;
    }

    function shareFciToWhatsApp() {
        const text = encodeURIComponent(generateFciShareText());
        window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    function shareFciNative() {
        const text = generateFciShareText();
        if (navigator.share) {
            navigator.share({
                title: 'Laporan Front Condition Index (FCI)',
                text: text
            }).catch(err => {
                console.log('Share dismissed', err);
            });
        } else {
            shareFciToWhatsApp();
        }
    }

    function copyFciSummaryToClipboard() {
        const text = generateFciShareText();
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
                $('#clientAlertTitle').text('Berhasil Disalin!');
                $('#clientAlertMsg').text('Ringkasan laporan FCI telah disalin ke clipboard. Anda dapat menempelkannya di WhatsApp atau laporan kerja.');
                new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            });
        } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            $('#clientAlertTitle').text('Berhasil Disalin!');
            $('#clientAlertMsg').text('Ringkasan laporan FCI telah disalin ke clipboard.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
        }
    }

    function shareSavedFci(id) {
        $.getJSON('/Fci/GetDetail/' + id, function(d) {
            let text = `⛏️ *LAPORAN INSPEKSI FRONT CONDITION INDEX (FCI)* ⛏️\n`;
            text += `*PT MEGA GLOBAL ENERGY GROUP*\n\n`;
            text += `📅 Tanggal: ${d.tanggal} ${d.waktu} (${d.shift || '-'})\n`;
            text += `📍 Front: ${d.namaFront || d.lokasi}\n`;
            text += `📌 Pit / Area: ${d.pit || '-'} | ${d.area || '-'} ${d.detilLokasi ? `[${d.detilLokasi}]` : ''}\n`;
            text += `👮 Inspector: ${d.nama} (${d.nik})\n\n`;
            text += `⭐ *SKOR AKHIR: ${d.totalScore}% (${d.kategoriIndex})*\n\n`;
            text += `📊 *Rincian Nilai 8 Parameter:*\n`;
            text += `• Lantai Front: ${d.skorLantaiFront}/100\n`;
            text += `• Ruang Manuver: ${d.skorRuangManuver}/100\n`;
            text += `• Safety Berm: ${d.skorSafetyBerm}/100\n`;
            text += `• Kondisi Dinding: ${d.skorKondisiDinding}/100\n`;
            text += `• Drainase Sump: ${d.skorDrainaseSump}/100\n`;
            text += `• Ceceran Material: ${d.skorKebersihanSpillage}/100\n`;
            text += `• Bench / Posisi: ${d.skorPosisiAlat}/100\n`;
            text += `• Rambu & Lampu: ${d.skorRambuPenerangan}/100\n\n`;
            if (d.catatan) text += `📝 Catatan: ${d.catatan}\n`;
            if (d.tindakanPerbaikan) text += `🛠️ Rekomendasi: ${d.tindakanPerbaikan} (PIC: ${d.pic || '-'})\n`;

            if (navigator.share) {
                navigator.share({ title: 'Laporan FCI #' + d.id, text: text }).catch(() => {});
            } else {
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
