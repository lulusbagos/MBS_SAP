    // Auto GPS Location
    function getLocationFci() {
        if (!navigator.geolocation) {
            $('#clientAlertTitle').text('GPS Tidak Didukung');
            $('#clientAlertMsg').text('Browser atau perangkat Anda tidak mendukung fitur Geolocation.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            return;
        }

        const btn = $('#btnGetLocation');
        btn.html('<span class="spinner-border spinner-border-sm" role="status"></span>');

        navigator.geolocation.getCurrentPosition(
            function(pos) {
                const lat = pos.coords.latitude.toFixed(6);
                const lng = pos.coords.longitude.toFixed(6);
                $('#latitude').val(lat);
                $('#longitude').val(lng);

                const currentLoc = $('#lokasi').val().trim();
                if (!currentLoc) {
                    $('#lokasi').val(`Koordinat: ${lat}, ${lng}`);
                } else if (!currentLoc.includes(lat)) {
                    $('#lokasi').val(`${currentLoc} (${lat}, ${lng})`);
                }

                btn.html('<i class="bi bi-check-circle-fill text-success" style="font-size: 18px;"></i>');
                setTimeout(() => {
                    btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                }, 2000);
            },
            function(err) {
                btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                $('#clientAlertTitle').text('Gagal Mengambil GPS');
                $('#clientAlertMsg').text('Tidak dapat mendeteksi koordinat lokasi: ' + err.message + '. Silakan isi lokasi secara manual.');
                new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    // Reset Form
    function resetForm() {
        $('#fciForm')[0].reset();
        $('#fciId').val('');
        $('#formTitle').html('<i class="bi bi-pencil-square" style="color: #14b8a6;"></i> <span>Form Penilaian FCI</span>');
        $('#btnCancelEdit').addClass('d-none');

        $('.btn-score-card, .btn-fci-score').removeClass('active');
        $('.btn-score-card[data-val="100"], .btn-fci-score[data-val="100"]').addClass('active');
        $('input[id^="skor"]').val('100');
        calculateFciScore();
    }

    // Edit FCI
    function editFci(id) {
        $.getJSON('/Fci/GetDetail/' + id, function(data) {
            $('#fciId').val(data.id);
            $('#tanggal').val(data.tanggal);
            $('#waktuStr').val(data.waktu);
            $('#area').val(data.area);
            $('#pit').val(data.pit);
            $('#namaFront').val(data.namaFront);
            $('#shift').val(data.shift);
            $('#lokasi').val(data.lokasi);
            $('#detilLokasi').val(data.detilLokasi);
            $('#latitude').val(data.latitude);
            $('#longitude').val(data.longitude);
            $('#catatan').val(data.catatan);
            $('#tindakanPerbaikan').val(data.tindakanPerbaikan);
            $('#pic').val(data.pic);

            const params = ['skorLantaiFront', 'skorRuangManuver', 'skorSafetyBerm', 'skorKondisiDinding',
                            'skorDrainaseSump', 'skorKebersihanSpillage', 'skorPosisiAlat', 'skorRambuPenerangan'];

            params.forEach(p => {
                const val = data[p];
                $(`#${p}`).val(val);
                $(`.btn-score-card[data-param="${p}"], .btn-fci-score[data-param="${p}"]`).removeClass('active');
                $(`.btn-score-card[data-param="${p}"][data-val="${val}"], .btn-fci-score[data-param="${p}"][data-val="${val}"]`).addClass('active');
            });

            calculateFciScore();

            $('#formTitle').html(`<i class="bi bi-pencil-square text-warning"></i> <span>Edit Penilaian FCI #${data.id}</span>`);
            $('#btnCancelEdit').removeClass('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

