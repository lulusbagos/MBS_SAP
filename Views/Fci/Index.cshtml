@model IEnumerable<MBS_SAP.Models.FciReport>
@{
    ViewData["Title"] = "Front Condition Index (FCI) - SAP";
    var userNik = ViewBag.UserNik as string ?? "";
    var userNama = ViewBag.UserNama as string ?? "";
    var userDept = ViewBag.UserDept as string ?? "";
    var userCompany = ViewBag.UserCompany as string ?? "PT MEGA GLOBAL ENERGY";
    var areaList = ViewBag.AreaList as List<string> ?? new List<string>();
    var pitList = ViewBag.PitList as List<string> ?? new List<string>();
    var totalReports = ViewBag.TotalReports as int? ?? 0;
    var avgScore = ViewBag.AvgScore as double? ?? 100.0;
    var goodCount = ViewBag.GoodCount as int? ?? 0;
    var fairCount = ViewBag.FairCount as int? ?? 0;
    var poorCount = ViewBag.PoorCount as int? ?? 0;
}

<div class="animate-fade-in">
    <!-- Header Screen Title -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="screen-title d-flex align-items-center gap-2">
                <i class="bi bi-compass text-teal" style="color: #14b8a6;"></i>
                <span>Front Condition Index (FCI)</span>
                <span class="badge" style="background: rgba(20, 184, 166, 0.15); color: #14b8a6; border: 1px solid rgba(20, 184, 166, 0.3); font-size: 11px; padding: 4px 10px; border-radius: 8px;">MGE Group</span>
            </div>
            <p class="screen-subtitle mb-0">Inspeksi & Penilaian Standar Kelayakan Front Loading & Digging Area Tambang.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 shadow-sm" style="border-radius: 10px; padding: 8px 14px; font-weight: 600;">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Export Excel</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(244, 63, 94, 0.15); color: var(--color-red); border-radius: 12px;">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(34, 197, 94, 0.15); color: var(--color-primary); border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Summary Metrics Cards (30 Days) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #14b8a6;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Total Inspeksi</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: var(--text-main);">@totalReports</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(20, 184, 166, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-clipboard-data-fill" style="color: #14b8a6; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">30 Hari Terakhir</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #3b82f6;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Rata-rata Skor FCI</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: @(avgScore >= 85 ? "#10b981" : (avgScore >= 70 ? "#f59e0b" : "#f43f5e"));">@avgScore%</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(59, 130, 246, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-speedometer2" style="color: #3b82f6; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Target Operasi: &gt;= 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #10b981;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Kondisi Baik</div>
                        <h3 class="mb-0 mt-1 font-weight-bold text-success">@goodCount</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Skor Index &gt;= 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #f43f5e;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Perlu Perbaikan</div>
                        <h3 class="mb-0 mt-1 font-weight-bold text-danger">@(fairCount + poorCount)</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(244, 63, 94, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">@poorCount Kritis, @fairCount Sedang</div>
            </div>
        </div>
    </div>

    <!-- Main Layout Grid: Form (Left) & Riwayat (Right) -->
    <div class="row g-4">
        <!-- FORM COLUMN -->
        <div class="col-lg-6">
            <div class="card-sap border-primary-accent" style="border-top: 4px solid #14b8a6;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-white font-weight-bold d-flex align-items-center gap-2" id="formTitle">
                        <i class="bi bi-pencil-square" style="color: #14b8a6;"></i>
                        <span>Form Penilaian FCI</span>
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelEdit" onclick="resetForm()">
                        <i class="bi bi-x-circle me-1"></i> Batal Edit
                    </button>
                </div>

                <form asp-action="Submit" method="post" id="fciForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="fciId" name="id" value="" />

                    <!-- Section 1: Basic Info -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="bi bi-info-circle me-1" style="color: #14b8a6;"></i> 1. Informasi Lokasi & Waktu
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="tanggal">Tanggal</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-calendar-event-fill input-sap-icon"></i>
                                    <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="waktuStr">Waktu</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-clock-fill input-sap-icon"></i>
                                    <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="area">Area Utama</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-geo-alt-fill input-sap-icon"></i>
                                    <select id="area" name="area" class="input-sap" required>
                                        <option value="" disabled selected>Pilih Area Utama...</option>
                                        @if (areaList.Any())
                                        {
                                            foreach (var a in areaList)
                                            {
                                                <option value="@a">@a</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="Pit Barat">Pit Barat</option>
                                            <option value="Pit Timur">Pit Timur</option>
                                            <option value="Pit North">Pit North</option>
                                            <option value="Pit South">Pit South</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="pit">Pit / Sektor</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-layers-fill input-sap-icon"></i>
                                    <input type="text" id="pit" name="pit" class="input-sap text-uppercase" placeholder="Misal: Pit 1, Pit Tengah" required />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="namaFront">Nama Front / Loading Point</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-cone-striped input-sap-icon"></i>
                                    <input type="text" id="namaFront" name="namaFront" class="input-sap text-uppercase" placeholder="Misal: Front OB EX-01 RL 45" required />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="shift">Shift</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-sun-fill input-sap-icon"></i>
                                    <select id="shift" name="shift" class="input-sap">
                                        <option value="Shift 1 (Siang)">Shift 1 (Siang)</option>
                                        <option value="Shift 2 (Malam)">Shift 2 (Malam)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" for="lokasi">Lokasi Spesifik & Koordinat GPS</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-geo-fill input-sap-icon"></i>
                                <input type="text" id="lokasi" name="lokasi" class="input-sap" placeholder="Masukkan lokasi spesifik / Klik tombol GPS di kanan..." style="padding-right: 44px;" required />
                                <button type="button" class="btn btn-link p-0 position-absolute" id="btnGetLocation" style="right: 12px; top: 10px; color: #14b8a6;" onclick="getLocationFci()" title="Ambil Lokasi Aktual GPS">
                                    <i class="bi bi-crosshair" style="font-size: 18px;"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="detilLokasi">Detail Benchmark / RL</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-compass-fill input-sap-icon"></i>
                                    <input type="text" id="detilLokasi" name="detilLokasi" class="input-sap" placeholder="Misal: RL 50, BM-22, Seam B" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap">GPS Lat / Long</label>
                                <div class="d-flex gap-1">
                                    <input type="text" id="latitude" name="latitude" class="input-sap" placeholder="Latitude" style="font-size: 11px;" readonly />
                                    <input type="text" id="longitude" name="longitude" class="input-sap" placeholder="Longitude" style="font-size: 11px;" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Assessment Parameters -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="text-white font-weight-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="bi bi-check2-square me-1" style="color: #14b8a6;"></i> 2. Penilaian 8 Parameter Front
                            </div>
                            <div class="badge px-3 py-1.5 shadow-sm" id="liveScoreBadge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); font-size: 13px; font-weight: 700;">
                                Skor FCI: <span id="liveScoreVal">100.0</span>% (Baik)
                            </div>
                        </div>

                        <!-- Param 1 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">1. Lantai Front (Front Floor) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Rata, padat, tidak bergelombang/amblas</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorLantaiFront" data-val="100">100 - Standar</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorLantaiFront" data-val="70">70 - Bergelombang</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorLantaiFront" data-val="40">40 - Amblas / Becek</button>
                            </div>
                            <input type="hidden" id="skorLantaiFront" name="skorLantaiFront" value="100" />
                        </div>

                        <!-- Param 2 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">2. Ruang Manuver & Spotting <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Cukup untuk antrean &amp; double spotting</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorRuangManuver" data-val="100">100 - Luas &amp; Cukup</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorRuangManuver" data-val="70">70 - Pas-pasan</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorRuangManuver" data-val="40">40 - Sempit / Bahaya</button>
                            </div>
                            <input type="hidden" id="skorRuangManuver" name="skorRuangManuver" value="100" />
                        </div>

                        <!-- Param 3 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">3. Safety Berm / Tanggul Front <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Tinggi minimal 3/4 diameter roda alat angkut</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorSafetyBerm" data-val="100">100 - &ge; 3/4 Ban</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorSafetyBerm" data-val="70">70 - Kurang Tinggi</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorSafetyBerm" data-val="40">40 - Tidak Ada Tanggul</button>
                            </div>
                            <input type="hidden" id="skorSafetyBerm" name="skorSafetyBerm" value="100" />
                        </div>

                        <!-- Param 4 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">4. Kondisi Dinding / Highwall <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Bebas batu menggantung (overhang) / retakan</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorKondisiDinding" data-val="100">100 - Dinding Aman</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorKondisiDinding" data-val="70">70 - Retak Halus</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorKondisiDinding" data-val="40">40 - Overhang / Rawan</button>
                            </div>
                            <input type="hidden" id="skorKondisiDinding" name="skorKondisiDinding" value="100" />
                        </div>

                        <!-- Param 5 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">5. Drainase &amp; Sump Front <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Air mengalir lancar, bebas genangan</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorDrainaseSump" data-val="100">100 - Kering / Lancar</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorDrainaseSump" data-val="70">70 - Ada Genangan</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorDrainaseSump" data-val="40">40 - Terendam Air</button>
                            </div>
                            <input type="hidden" id="skorDrainaseSump" name="skorDrainaseSump" value="100" />
                        </div>

                        <!-- Param 6 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">6. Kebersihan Ceceran Material <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Bebas ceceran batuan tajam / boulder di lantai</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorKebersihanSpillage" data-val="100">100 - Bersih Rapi</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorKebersihanSpillage" data-val="70">70 - Ada Ceceran</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorKebersihanSpillage" data-val="40">40 - Boulder Berserakan</button>
                            </div>
                            <input type="hidden" id="skorKebersihanSpillage" name="skorKebersihanSpillage" value="100" />
                        </div>

                        <!-- Param 7 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">7. Posisi &amp; Ketinggian Alat (Bench) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Bench height pas dengan jangkauan alat gali</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorPosisiAlat" data-val="100">100 - Optimal</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorPosisiAlat" data-val="70">70 - Agak Tinggi</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorPosisiAlat" data-val="40">40 - Terlalu Tinggi / Undercut</button>
                            </div>
                            <input type="hidden" id="skorPosisiAlat" name="skorPosisiAlat" value="100" />
                        </div>

                        <!-- Param 8 -->
                        <div class="mb-2 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">8. Rambu &amp; Penerangan Front <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Rambu petunjuk jelas, tower lamp aktif malam hari</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-fci-score active flex-fill" data-param="skorRambuPenerangan" data-val="100">100 - Terang &amp; Jelas</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorRambuPenerangan" data-val="70">70 - Kurang Terang</button>
                                <button type="button" class="btn btn-sm btn-fci-score flex-fill" data-param="skorRambuPenerangan" data-val="40">40 - Gelap / Tanpa Rambu</button>
                            </div>
                            <input type="hidden" id="skorRambuPenerangan" name="skorRambuPenerangan" value="100" />
                        </div>
                    </div>

                    <!-- Section 3: Notes, Photos & Actions -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="bi bi-camera me-1" style="color: #14b8a6;"></i> 3. Foto Dokumentasi &amp; Tindakan
                        </div>

                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" for="catatan">Catatan Observasi Kondisi Front</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-card-text input-sap-icon" style="top: 14px;"></i>
                                <textarea id="catatan" name="catatan" class="input-sap" rows="2" placeholder="Tuliskan temuan atau catatan kondisi aktual di front..."></textarea>
                            </div>
                        </div>

                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" for="tindakanPerbaikan">Rekomendasi Tindakan Perbaikan</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-tools input-sap-icon" style="top: 14px;"></i>
                                <textarea id="tindakanPerbaikan" name="tindakanPerbaikan" class="input-sap" rows="2" placeholder="Misal: Perlu dozer merapikan lantai &amp; menaikkan tanggul crest..."></textarea>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="pic">PIC Tindakan Perbaikan</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-person-fill input-sap-icon"></i>
                                    <input type="text" id="pic" name="pic" class="input-sap" placeholder="Misal: Pengawas Pit / Foreman Dozer" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="foto">Foto Kondisi Front</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-image-fill input-sap-icon"></i>
                                    <input type="file" id="foto" name="foto" class="input-sap" accept="image/*" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm font-weight-bold" style="height: 48px; border-radius: 12px; background: linear-gradient(135deg, #0f766e, #14b8a6); border: none;">
                            <i class="bi bi-save-fill me-2"></i> Simpan Penilaian FCI
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIWAYAT & FILTER COLUMN -->
        <div class="col-lg-6">
            <!-- Filter Bar -->
            <div class="card-sap mb-3 p-3">
                <form method="get" asp-action="Index">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label-sap" style="font-size: 11px;">Cari Lokasi / Front / NIK</label>
                            <input type="text" name="search" class="input-sap" value="@ViewBag.CurrentSearch" placeholder="Ketik kata kunci..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Filter Pit</label>
                            <select name="pit" class="input-sap">
                                <option value="">Semua Pit</option>
                                @foreach (var p in pitList)
                                {
                                    <option value="@p" selected="@(ViewBag.CurrentPit == p ? "selected" : null)">@p</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Kategori Skor</label>
                            <select name="kategori" class="input-sap">
                                <option value="">Semua Skor</option>
                                <option value="Baik" selected="@(ViewBag.CurrentKategori == "Baik" ? "selected" : null)">Baik (&ge; 85%)</option>
                                <option value="Sedang" selected="@(ViewBag.CurrentKategori == "Sedang" ? "selected" : null)">Sedang (70 - 84%)</option>
                                <option value="Kurang" selected="@(ViewBag.CurrentKategori == "Kurang" ? "selected" : null)">Kurang (&lt; 70%)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm" style="height: 44px; border-radius: 10px; background: #14b8a6; border: none;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- List of Reports -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 text-white font-weight-bold" style="font-size: 13px;">
                    <i class="bi bi-clock-history me-1 text-teal"></i> Riwayat Inspeksi FCI (@Model.Count())
                </h6>
            </div>

            @if (!Model.Any())
            {
                <div class="card-sap p-5 text-center text-muted">
                    <i class="bi bi-inbox" style="font-size: 40px; color: var(--text-muted);"></i>
                    <p class="mt-2 mb-0" style="font-size: 13px;">Belum ada data inspeksi FCI pada periode ini.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3" style="max-height: 800px; overflow-y: auto; padding-right: 4px;">
                    @foreach (var item in Model)
                    {
                        var badgeBg = item.TotalScore >= 85 ? "rgba(16, 185, 129, 0.15)" : (item.TotalScore >= 70 ? "rgba(245, 158, 11, 0.15)" : "rgba(244, 63, 94, 0.15)");
                        var badgeColor = item.TotalScore >= 85 ? "#10b981" : (item.TotalScore >= 70 ? "#f59e0b" : "#f43f5e");
                        var borderAccent = item.TotalScore >= 85 ? "#10b981" : (item.TotalScore >= 70 ? "#f59e0b" : "#f43f5e");

                        <div class="card-sap p-3 position-relative animate-fade-in" style="border-left: 4px solid @borderAccent;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="mb-0 font-weight-bold text-white">@(item.NamaFront ?? item.Lokasi)</h6>
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.Pit</span>
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.Shift</span>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size: 11px;">
                                        <i class="bi bi-geo-alt me-1"></i> @item.Area | @item.Lokasi @(!string.IsNullOrEmpty(item.DetilLokasi) ? $"({item.DetilLokasi})" : "")
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge px-2 py-1" style="background: @badgeBg; color: @badgeColor; font-size: 13px; font-weight: 800; border-radius: 8px;">
                                        @item.TotalScore%
                                    </span>
                                    <div style="font-size: 10px; font-weight: 600; color: @badgeColor; margin-top: 2px;">@item.KategoriIndex</div>
                                </div>
                            </div>

                            <!-- Score Pills Summary -->
                            <div class="d-flex flex-wrap gap-1 mb-2 pt-1 border-top border-secondary border-opacity-25" style="font-size: 10.5px;">
                                <span class="badge bg-dark text-muted">Lantai: @item.SkorLantaiFront</span>
                                <span class="badge bg-dark text-muted">Manuver: @item.SkorRuangManuver</span>
                                <span class="badge bg-dark text-muted">Berm: @item.SkorSafetyBerm</span>
                                <span class="badge bg-dark text-muted">Dinding: @item.SkorKondisiDinding</span>
                                <span class="badge bg-dark text-muted">Sump: @item.SkorDrainaseSump</span>
                                <span class="badge bg-dark text-muted">Spillage: @item.SkorKebersihanSpillage</span>
                                <span class="badge bg-dark text-muted">Alat: @item.SkorPosisiAlat</span>
                                <span class="badge bg-dark text-muted">Rambu: @item.SkorRambuPenerangan</span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Catatan))
                            {
                                <div class="p-2 rounded mb-2" style="background: rgba(255,255,255,0.02); font-size: 11.5px; color: var(--text-main);">
                                    <i class="bi bi-chat-left-text me-1 text-muted"></i> @item.Catatan
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.TindakanPerbaikan))
                            {
                                <div class="p-2 rounded mb-2" style="background: rgba(245, 158, 11, 0.08); border-left: 2px solid #f59e0b; font-size: 11px; color: #f59e0b;">
                                    <strong><i class="bi bi-tools me-1"></i> Perbaikan:</strong> @item.TindakanPerbaikan @(!string.IsNullOrEmpty(item.Pic) ? $"(PIC: {item.Pic})" : "")
                                </div>
                            }

                            <!-- Footer Card: Inspector & Actions -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25" style="font-size: 11px; color: var(--text-muted);">
                                <div>
                                    <i class="bi bi-person me-1"></i> @item.Nama (@item.Nik) | @item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-info" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="showDetailFci(@item.Id)">
                                        <i class="bi bi-eye"></i> Detail
                                    </button>
                                    @if (item.Nik == userNik || User.IsInRole("Admin"))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="editFci(@item.Id)">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus laporan FCI ini?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Detail FCI -->
<div class="modal fade" id="fciDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title text-white font-weight-bold" id="detailModalTitle"><i class="bi bi-compass text-teal me-2"></i>Detail Laporan FCI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailModalBody" style="font-size: 13px;">
                <!-- Loaded via JS -->
            </div>
        </div>
    </div>
</div>

<style>
    .btn-fci-score {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        font-size: 11px;
        padding: 5px 8px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }
    .btn-fci-score:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }
    .btn-fci-score.active[data-val="100"] {
        background: rgba(16, 185, 129, 0.25);
        color: #10b981;
        border-color: #10b981;
        font-weight: 700;
    }
    .btn-fci-score.active[data-val="70"] {
        background: rgba(245, 158, 11, 0.25);
        color: #f59e0b;
        border-color: #f59e0b;
        font-weight: 700;
    }
    .btn-fci-score.active[data-val="40"] {
        background: rgba(244, 63, 94, 0.25);
        color: #f43f5e;
        border-color: #f43f5e;
        font-weight: 700;
    }
</style>

@section Scripts {
<script>
    // Live Score Calculator
    function calculateFciScore() {
        const p1 = parseInt($('#skorLantaiFront').val()) || 100;
        const p2 = parseInt($('#skorRuangManuver').val()) || 100;
        const p3 = parseInt($('#skorSafetyBerm').val()) || 100;
        const p4 = parseInt($('#skorKondisiDinding').val()) || 100;
        const p5 = parseInt($('#skorDrainaseSump').val()) || 100;
        const p6 = parseInt($('#skorKebersihanSpillage').val()) || 100;
        const p7 = parseInt($('#skorPosisiAlat').val()) || 100;
        const p8 = parseInt($('#skorRambuPenerangan').val()) || 100;

        const total = (p1 * 0.15) + (p2 * 0.15) + (p3 * 0.15) + (p4 * 0.15) + (p5 * 0.10) + (p6 * 0.10) + (p7 * 0.10) + (p8 * 0.10);
        const rounded = total.toFixed(1);

        let label = "Baik";
        let color = "#10b981";
        let bg = "rgba(16, 185, 129, 0.2)";
        let border = "rgba(16, 185, 129, 0.4)";

        if (total < 70) {
            label = "Kurang";
            color = "#f43f5e";
            bg = "rgba(244, 63, 94, 0.2)";
            border = "rgba(244, 63, 94, 0.4)";
        } else if (total < 85) {
            label = "Sedang";
            color = "#f59e0b";
            bg = "rgba(245, 158, 11, 0.2)";
            border = "rgba(245, 158, 11, 0.4)";
        }

        $('#liveScoreVal').text(rounded);
        $('#liveScoreBadge').html(`Skor FCI: <span>${rounded}</span>% (${label})`);
        $('#liveScoreBadge').css({
            'background': bg,
            'color': color,
            'border-color': border
        });
    }

    // Button Score Selector
    $(document).on('click', '.btn-fci-score', function() {
        const param = $(this).data('param');
        const val = $(this).data('val');

        $(`.btn-fci-score[data-param="${param}"]`).removeClass('active');
        $(this).addClass('active');

        $(`#${param}`).val(val);
        calculateFciScore();
    });

    // Auto GPS Location
    function getLocationFci() {
        if (!navigator.geolocation) {
            alert('Browser Anda tidak mendukung Geolocation.');
            return;
        }

        const btn = $('#btnGetLocation');
        btn.html('<span class="spinner-border spinner-border-sm" role="status"></span>');

        navigator.geolocation.getCurrentPosition(
            function(pos) {
                const lat = pos.coords.latitude.toFixed(6);
                const lng = pos.coords.longitude.toFixed(6);
                $('#latitude').val(lat);
                $('#longitude').val(lng);

                const currentLoc = $('#lokasi').val().trim();
                if (!currentLoc) {
                    $('#lokasi').val(`Koordinat: ${lat}, ${lng}`);
                } else if (!currentLoc.includes(lat)) {
                    $('#lokasi').val(`${currentLoc} (${lat}, ${lng})`);
                }

                btn.html('<i class="bi bi-check-circle-fill text-success" style="font-size: 18px;"></i>');
                setTimeout(() => {
                    btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                }, 2000);
            },
            function(err) {
                btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                alert('Gagal mengambil lokasi GPS: ' + err.message);
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    // Reset Form
    function resetForm() {
        $('#fciForm')[0].reset();
        $('#fciId').val('');
        $('#formTitle').html('<i class="bi bi-pencil-square" style="color: #14b8a6;"></i> <span>Form Penilaian FCI</span>');
        $('#btnCancelEdit').addClass('d-none');

        $('.btn-fci-score').removeClass('active');
        $('.btn-fci-score[data-val="100"]').addClass('active');
        $('input[id^="skor"]').val('100');
        calculateFciScore();
    }

    // Edit FCI
    function editFci(id) {
        $.getJSON('/Fci/GetDetail/' + id, function(data) {
            $('#fciId').val(data.id);
            $('#tanggal').val(data.tanggal);
            $('#waktuStr').val(data.waktu);
            $('#area').val(data.area);
            $('#pit').val(data.pit);
            $('#namaFront').val(data.namaFront);
            $('#shift').val(data.shift);
            $('#lokasi').val(data.lokasi);
            $('#detilLokasi').val(data.detilLokasi);
            $('#latitude').val(data.latitude);
            $('#longitude').val(data.longitude);
            $('#catatan').val(data.catatan);
            $('#tindakanPerbaikan').val(data.tindakanPerbaikan);
            $('#pic').val(data.pic);

            const params = ['skorLantaiFront', 'skorRuangManuver', 'skorSafetyBerm', 'skorKondisiDinding',
                            'skorDrainaseSump', 'skorKebersihanSpillage', 'skorPosisiAlat', 'skorRambuPenerangan'];

            params.forEach(p => {
                const val = data[p];
                $(`#${p}`).val(val);
                $(`.btn-fci-score[data-param="${p}"]`).removeClass('active');
                $(`.btn-fci-score[data-param="${p}"][data-val="${val}"]`).addClass('active');
            });

            calculateFciScore();

            $('#formTitle').html(`<i class="bi bi-pencil-square text-warning"></i> <span>Edit Penilaian FCI #${data.id}</span>`);
            $('#btnCancelEdit').removeClass('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    // Show Detail Modal
    function showDetailFci(id) {
        $.getJSON('/Fci/GetDetail/' + id, function(d) {
            let html = `
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-white font-weight-bold mb-2">Informasi Front</h6>
                            <table class="table table-sm table-borderless text-white mb-0" style="font-size: 12px;">
                                <tr><td class="text-muted" style="width: 130px;">Nama Front</td><td>: <strong>${d.namaFront || '-'}</strong></td></tr>
                                <tr><td class="text-muted">Pit / Sektor</td><td>: ${d.pit || '-'}</td></tr>
                                <tr><td class="text-muted">Area Utama</td><td>: ${d.area || '-'}</td></tr>
                                <tr><td class="text-muted">Lokasi</td><td>: ${d.lokasi || '-'}</td></tr>
                                <tr><td class="text-muted">Detail RL/BM</td><td>: ${d.detilLokasi || '-'}</td></tr>
                                <tr><td class="text-muted">Shift</td><td>: ${d.shift || '-'}</td></tr>
                                <tr><td class="text-muted">Waktu Inspeksi</td><td>: ${d.tanggal} ${d.waktu}</td></tr>
                                <tr><td class="text-muted">Inspector</td><td>: ${d.nama} (${d.nik})</td></tr>
                                <tr><td class="text-muted">Perusahaan</td><td>: ${d.perusahaan || '-'}</td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <div class="text-muted mb-1" style="font-size: 12px;">SKOR INDEKS KELAYAKAN FRONT</div>
                            <h1 class="display-4 font-weight-bold mb-0" style="color: ${d.totalScore >= 85 ? '#10b981' : (d.totalScore >= 70 ? '#f59e0b' : '#f43f5e')};">${d.totalScore}%</h1>
                            <span class="badge px-3 py-1 mt-1" style="font-size: 12px; background: ${d.totalScore >= 85 ? 'rgba(16,185,129,0.2)' : (d.totalScore >= 70 ? 'rgba(245,158,11,0.2)' : 'rgba(244,63,94,0.2)')}; color: ${d.totalScore >= 85 ? '#10b981' : (d.totalScore >= 70 ? '#f59e0b' : '#f43f5e')};">
                                Kategori: ${d.kategoriIndex}
                            </span>
                        </div>
                    </div>
                </div>

                <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                    <h6 class="text-white font-weight-bold mb-2">Rincian Nilai 8 Parameter</h6>
                    <div class="row g-2" style="font-size: 12px;">
                        <div class="col-md-6">1. Lantai Front: <strong>${d.skorLantaiFront}</strong>/100</div>
                        <div class="col-md-6">2. Ruang Manuver: <strong>${d.skorRuangManuver}</strong>/100</div>
                        <div class="col-md-6">3. Safety Berm: <strong>${d.skorSafetyBerm}</strong>/100</div>
                        <div class="col-md-6">4. Kondisi Dinding: <strong>${d.skorKondisiDinding}</strong>/100</div>
                        <div class="col-md-6">5. Drainase Sump: <strong>${d.skorDrainaseSump}</strong>/100</div>
                        <div class="col-md-6">6. Kebersihan Spillage: <strong>${d.skorKebersihanSpillage}</strong>/100</div>
                        <div class="col-md-6">7. Posisi Alat: <strong>${d.skorPosisiAlat}</strong>/100</div>
                        <div class="col-md-6">8. Rambu & Lampu: <strong>${d.skorRambuPenerangan}</strong>/100</div>
                    </div>
                </div>

                ${d.catatan ? `
                    <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color);">
                        <strong class="text-white">Catatan Observasi:</strong>
                        <p class="mb-0 text-muted mt-1">${d.catatan}</p>
                    </div>
                ` : ''}

                ${d.tindakanPerbaikan ? `
                    <div class="mt-3 p-3 rounded-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3);">
                        <strong style="color: #f59e0b;"><i class="bi bi-tools me-1"></i> Rekomendasi Perbaikan:</strong>
                        <p class="mb-0 mt-1" style="color: var(--text-main);">${d.tindakanPerbaikan}</p>
                        ${d.pic ? `<small class="text-muted d-block mt-1">PIC: <strong>${d.pic}</strong></small>` : ''}
                    </div>
                ` : ''}

                ${d.fotoUrl ? `
                    <div class="mt-3 p-3 rounded-3 text-center" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px;">Foto Dokumentasi:</div>
                        <img src="${d.fotoUrl}" class="img-fluid rounded-3 shadow-sm" style="max-height: 380px; object-fit: contain;" alt="Foto Front" />
                    </div>
                ` : ''}
            `;

            $('#detailModalBody').html(html);
            $('#fciDetailModal').modal('show');
        });
    }
</script>
}
