        <div class="history-header">
            <h6>Aktivitas K3 Terbaru</h6>
            <span class="badge bg-secondary text-dark" style="font-size: 10px; font-weight: 700;">LIVE FEED</span>
        </div>
        
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-4 text-muted" style="font-size: 13px;">
                <i class="bi bi-card-list d-block mb-2" style="font-size: 28px;"></i>
                Belum ada aktivitas tercatat hari ini.
            </div>
        }
        else
        {
            <div style="display: flex; flex-direction: column;">
                @foreach (var activity in Model)
                {
                    <div class="history-item">
                        <div class="history-item-left">
                            <div class="history-badge @(activity.Type.ToLower())">
                                <i class="bi @(
                                    activity.Type == "Hazard" ? "bi-exclamation-triangle-fill" : 
                                    activity.Type == "Inspection" ? "bi-clipboard-check-fill" : 
                                    activity.Type == "ActionPlan" ? "bi-calendar-check-fill" : 
                                    activity.Type == "SafetyTalk" ? "bi-megaphone-fill" : 
                                    "bi-people-fill"
                                )"></i>
                            </div>
                            <div class="history-details">
                                <h7>@activity.Title</h7>
                                <span><i class="bi bi-person me-1"></i>@activity.User &bull; @activity.Date.ToString("dd MMM, HH:mm")</span>
                            </div>
                        </div>
                        <div>
                            <span class="status-badge @(activity.Status.ToLower())">@activity.Status</span>
                        </div>
                    </div>
                }
            </div>
        }
        </div>
</div>
</div>

</div>
<!-- Roster Settings Modal -->
