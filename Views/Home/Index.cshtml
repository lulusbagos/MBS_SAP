    <div class="modal fade" id="rosterSettingsModal" tabindex="-1" aria-labelledby="rosterSettingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content roster-modal-content">
                <div class="roster-header-banner">
                    <div class="roster-header-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <h5 style="font-weight: 800; color: var(--text-main); margin-bottom: 4px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        Pengaturan Roster & Penugasan
                        @if (ViewData["IsEditMode"] is bool edit && edit)
                        {
                            <span style="font-size: 9.5px; background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); padding: 2px 8px; border-radius: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">Edit Status Aktif</span>
                        }
                        else
                        {
                            <span style="font-size: 9.5px; background: rgba(168, 85, 247, 0.15); color: #a855f7; border: 1px solid rgba(168, 85, 247, 0.3); padding: 2px 8px; border-radius: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">Siklus Baru</span>
                        }
                    </h5>
                    <p style="font-size: 11.5px; color: var(--text-muted); max-width: 340px; margin: 0 auto;">Sesuaikan siklus dinas/cuti atau periode penugasan luar Anda.</p>
                    <button type="button" class="btn-close position-absolute" data-bs-dismiss="modal" aria-label="Close" style="top: 20px; right: 20px; filter: invert(var(--text-contrast));"></button>
                </div>
                
                <div class="modal-body" style="padding: 20px; max-height: calc(100vh - 200px); overflow-y: auto;">
                    <form id="rosterSettingsForm">
                        @{
                            var currentTipe = (ViewData["RosterTipe"] as string) ?? "REGULER";
                            var isTugasActive = currentTipe.Equals("TUGAS", StringComparison.OrdinalIgnoreCase);
                        }
                        <div id="rosterFormAlert" class="alert alert-danger d-none" style="font-size: 12px; border-radius: 12px; padding: 10px 14px;"></div>

                        <!-- Segmented Switcher for Tipe Roster -->
                        <div class="roster-type-switcher mb-3" style="display: flex; background: rgba(0,0,0,0.06); padding: 4px; border-radius: 14px; border: 1px solid var(--border-color); gap: 4px;">
                            <button type="button" class="btn btn-sm flex-fill roster-tab-btn @(!isTugasActive ? "active" : "")" id="tabRosterReguler" style="border-radius: 10px; font-weight: 700; font-size: 11.5px; padding: 8px 12px; transition: all 0.2s;">
                                <i class="bi bi-briefcase-fill me-1"></i> Roster Reguler
                            </button>
                            <button type="button" class="btn btn-sm flex-fill roster-tab-btn @(isTugasActive ? "active" : "")" id="tabPeriodeTugas" style="border-radius: 10px; font-weight: 700; font-size: 11.5px; padding: 8px 12px; transition: all 0.2s;">
                                <i class="bi bi-airplane-fill me-1"></i> Periode Tugas (Bebas SAP)
                            </button>
                        </div>
                        <input type="hidden" id="tipeRosterSelected" name="tipeRosterSelected" value="@currentTipe" />
                        <input type="hidden" id="rosterEditId" name="rosterEditId" value="@(ViewData["RosterId"] ?? "")" />

                        <!-- Edit Mode Notice -->
                        <div id="rosterEditModeNotice" class="d-none alert alert-warning d-flex justify-content-between align-items-center py-2 px-3 mb-3" style="border-radius: 12px; font-size: 11.5px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #f59e0b;">
                            <div class="d-flex align-items-center gap-1.5">
                                <i class="bi bi-pencil-square"></i> <span id="rosterEditNoticeText">Sedang Mengedit Tugas</span>
                            </div>
                            <button type="button" class="btn btn-sm p-0 text-decoration-none fw-bold" id="btnCancelEditMode" style="font-size: 11px; color: #f59e0b;">
                                <i class="bi bi-x-circle me-1"></i> Batal Edit
                            </button>
                        </div>

                        <!-- SECTION 1: ROSTER REGULER -->
                        <div id="sectionRosterReguler" style="@(isTugasActive ? "display: none;" : "")">
                            <!-- Target Calculation Info Banner -->
                            <div style="background: linear-gradient(135deg, #f0f9ff, #e0f2fe); border: 2px solid #0ea5e9; border-radius: 16px; padding: 14px 16px; margin-bottom: 20px; text-align: center; box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.05);">
                                <span style="font-size: 9px; background: #0ea5e9; color: #ffffff; padding: 2px 8px; border-radius: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; display: inline-block; margin-bottom: 8px;">Informasi Target</span>
                                <h5 style="color: #0369a1; font-weight: 850; font-size: 13px; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; line-height: 1.4;">
                                    Perhitungan Target dihitung dari jumlah hari Onsite
                                </h5>
                            </div>
                            
                            <!-- Flexible Roster Notice -->
                            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 16px; padding: 14px 16px; margin-bottom: 20px; display: flex; gap: 12px; align-items: start;">
                                <i class="bi bi-calendar-check-fill" style="color: #059669; font-size: 18px; line-height: 1;"></i>
                                <div>
                                    <h6 style="color: #059669; font-weight: 800; font-size: 12px; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.5px;">PENGATURAN ROSTER</h6>
                                    <p style="color: var(--text-main); font-size: 11px; margin: 0; line-height: 1.5; opacity: 0.9;">
                                        Isi tanggal Mulai &amp; Akhir Dinas serta Cuti secara manual sesuai jadwal aktual dinas Anda di site.
                                    </p>
                                </div>
                            </div>

                            <!-- Dinas Section Card -->
                            <div class="roster-card">
                                <h6 style="font-size: 11.5px; font-weight: 800; color: var(--color-primary); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                                    <i class="bi bi-geo-alt-fill"></i> Periode Dinas (Onsite)
                                </h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="roster-label">Mulai Dinas</label>
                                        <input type="date" class="roster-date-input" id="awalDinas" name="awalDinas" value="@ViewData["RosterAwalDinas"]" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="roster-label">Akhir Dinas</label>
                                        <input type="date" class="roster-date-input" id="akhirDinas" name="akhirDinas" value="@ViewData["RosterAkhirDinas"]" required />
                                    </div>
                                </div>
                            </div>

                            <!-- Cuti Section Card -->
                            <div class="roster-card">
                                <h6 style="font-size: 11.5px; font-weight: 800; color: var(--color-orange); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                                    <i class="bi bi-airplane-fill"></i> Periode Roster (Cuti)
                                </h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="roster-label">Mulai Cuti</label>
                                        <input type="date" class="roster-date-input" id="awalCuti" name="awalCuti" value="@ViewData["RosterAwalCuti"]" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="roster-label">Akhir Cuti</label>
                                        <input type="date" class="roster-date-input" id="akhirCuti" name="akhirCuti" value="@ViewData["RosterAkhirCuti"]" required />
                                    </div>
                                </div>
                            </div>

                            <!-- Info Box Notice -->
                            <div class="roster-info-box" style="margin-bottom: 24px;">
                                <i class="bi bi-info-circle-fill"></i>
                                <p>Target K3 bulanan Anda wajib dipenuhi secara proporsional sesuai jumlah hari dinas aktif (onsite). Saat cuti, target program ditiadakan.</p>
                            </div>
                        </div>

                        <!-- SECTION 2: PERIODE TUGAS (BEBAS SAP) -->
                        <div id="sectionPeriodeTugas" style="@(!isTugasActive ? "display: none;" : "")">
                            <!-- Free SAP Banner -->
                            <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(6, 182, 212, 0.12)); border: 2px solid #10b981; border-radius: 16px; padding: 14px 16px; margin-bottom: 20px; text-align: center; box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.05);">
                                <span style="font-size: 9px; background: #10b981; color: #ffffff; padding: 2px 8px; border-radius: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; display: inline-block; margin-bottom: 8px;">Bebas SAP</span>
                                <h5 style="color: #059669; font-weight: 850; font-size: 13px; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; line-height: 1.4;">
                                    Target SAP = 0 Selama Masa Penugasan
                                </h5>
                            </div>

                            <!-- Ketentuan Periode Tugas Notice -->
                            <div style="background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.2); border-radius: 16px; padding: 14px 16px; margin-bottom: 20px; display: flex; gap: 12px; align-items: start;">
                                <i class="bi bi-info-circle-fill" style="color: #0284c7; font-size: 18px; line-height: 1;"></i>
                                <div>
                                    <h6 style="color: #0284c7; font-weight: 800; font-size: 12px; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.5px;">KETENTUAN PERIODE TUGAS</h6>
                                    <p style="color: var(--text-main); font-size: 11px; margin: 0; line-height: 1.5; opacity: 0.9;">
                                        Fitur ini digunakan jika Anda mendapatkan surat penugasan khusus, dinas luar site, audit HO, training eksternal, atau bebas tugas di site.
                                    </p>
                                    <p style="color: var(--text-muted); font-size: 10.5px; margin: 4px 0 0 0; line-height: 1.5; opacity: 0.85;">
                                        Selama periode penugasan ini, Anda <strong>tidak memiliki kewajiban pengisian target bulanan SAP (Target = 0)</strong>.
                                    </p>
                                </div>
                            </div>

                            <!-- Tugas Card -->
                            <div class="roster-card">
                                <h6 style="font-size: 11.5px; font-weight: 800; color: #0284c7; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                                    <i class="bi bi-calendar-range-fill"></i> Jadwal & Keterangan Penugasan
                                </h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="roster-label">Mulai Tugas</label>
                                        <input type="date" class="roster-date-input" id="awalTugas" name="awalTugas" value="@(isTugasActive ? ViewData["RosterAwalDinas"] : (ViewData["RosterAwalDinas"] ?? DateTime.Today.ToString("yyyy-MM-dd")))" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="roster-label">Akhir Tugas</label>
                                        <input type="date" class="roster-date-input" id="akhirTugas" name="akhirTugas" value="@(isTugasActive ? ViewData["RosterAkhirDinas"] : (ViewData["RosterAkhirDinas"] ?? DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")))" required />
                                    </div>
                                </div>
                                <div>
                                    <label class="roster-label">Keterangan / Keperluan Penugasan</label>
                                    <input type="text" class="roster-date-input" id="keteranganTugas" name="keteranganTugas" placeholder="Contoh: Tugas HO / Diklat Luar / Penugasan Khusus" value="@(ViewData["RosterKeterangan"] ?? "")" maxlength="255" />
                                </div>
                            </div>
                        </div>

                        <!-- Roster History Section -->
                        <div class="roster-card" style="margin-bottom: 0; padding-top: 14px; background: rgba(255,255,255,0.01);">
                            <h6 style="font-size: 11.5px; font-weight: 800; color: var(--text-main); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-clock-history" style="color: #a855f7;"></i> Riwayat Pengaturan
                            </h6>
                            
                            @{
                                var historyList = ViewData["RosterHistory"] as List<MBS_SAP.Models.Roster>;
                            }
                            @if (historyList == null || !historyList.Any())
                            {
                                <div class="text-center py-3 text-muted" style="font-size: 11px;">
                                    Belum ada riwayat pengaturan roster tercatat.
                                </div>
                            }
                            else
                            {
                                <div style="max-height: 180px; overflow-y: auto; padding-right: 4px;">
                                    <div class="table-responsive" style="overflow-x: hidden;">
                                        <table class="table table-borderless" style="font-size: 11px; margin-bottom: 0; color: var(--text-main);">
                                            <thead>
                                                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-weight: 700;">
                                                    <th class="ps-0" style="padding-bottom: 6px;">Tipe & Periode</th>
                                                    <th style="padding-bottom: 6px;">Detail / Cuti</th>
                                                    <th style="padding-bottom: 6px;">Diatur Pada</th>
                                                    <th class="text-end pe-0" style="padding-bottom: 6px; min-width: 68px;">Aksi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var h in historyList)
                                                {
                                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                                        @if (h.TipeRoster == "TUGAS")
                                                        {
                                                            <td class="ps-0 py-2">
                                                                <div class="d-flex align-items-center gap-1.5 mb-1">
                                                                    <span class="badge" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; border: 1px solid rgba(14, 165, 233, 0.3); font-size: 9.5px; padding: 2px 6px; border-radius: 6px; font-weight: 700;">
                                                                        <i class="bi bi-airplane-fill me-1"></i> Periode Tugas
                                                                    </span>
                                                                </div>
                                                                <div class="fw-bold" style="color: #0284c7;">@h.AwalDinas.ToString("dd MMM") - @h.AkhirDinas.ToString("dd MMM yy")</div>
                                                                <div class="text-muted" style="font-size: 10px;">@((h.AkhirDinas - h.AwalDinas).Days + 1) hari penugasan</div>
                                                            </td>
                                                            <td class="py-2">
                                                                <div class="fw-bold" style="color: #10b981;"><i class="bi bi-check-circle-fill me-1"></i> Bebas SAP</div>
                                                                <div class="text-muted" style="font-size: 10px; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                                    @(string.IsNullOrEmpty(h.Keterangan) ? "Target SAP = 0" : h.Keterangan)
                                                                </div>
                                                            </td>
                                                            <td class="py-2 text-muted" style="font-size: 10px; vertical-align: middle;">
                                                                @h.CreatedAt.ToString("dd/MM/yy HH:mm")
                                                            </td>
                                                            <td class="text-end pe-0 py-2" style="vertical-align: middle;">
                                                                <div class="d-flex justify-content-end gap-1">
                                                                    <button type="button" class="btn btn-sm btn-outline-info btn-edit-roster" 
                                                                            data-id="@h.Id" 
                                                                            data-tipe="@h.TipeRoster" 
                                                                            data-awal-dinas="@h.AwalDinas.ToString("yyyy-MM-dd")" 
                                                                            data-akhir-dinas="@h.AkhirDinas.ToString("yyyy-MM-dd")" 
                                                                            data-awal-cuti="@h.AwalCuti.ToString("yyyy-MM-dd")" 
                                                                            data-akhir-cuti="@h.AkhirCuti.ToString("yyyy-MM-dd")" 
                                                                            data-keterangan="@(h.Keterangan ?? "")" 
                                                                            title="Edit Tugas" 
                                                                            style="padding: 2px 7px; font-size: 11px; border-radius: 6px;">
                                                                        <i class="bi bi-pencil-square"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-roster-item" 
                                                                            data-id="@h.Id" 
                                                                            data-tipe="@h.TipeRoster" 
                                                                            title="Hapus Tugas" 
                                                                            style="padding: 2px 7px; font-size: 11px; border-radius: 6px;">
                                                                        <i class="bi bi-trash3"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="ps-0 py-2">
                                                                <div class="d-flex align-items-center gap-1.5 mb-1">
                                                                    <span class="badge" style="background: rgba(168, 85, 247, 0.15); color: #a855f7; border: 1px solid rgba(168, 85, 247, 0.3); font-size: 9.5px; padding: 2px 6px; border-radius: 6px; font-weight: 700;">
                                                                        <i class="bi bi-briefcase-fill me-1"></i> Roster Reguler
                                                                    </span>
                                                                </div>
                                                                <div class="fw-bold">@h.AwalDinas.ToString("dd MMM") - @h.AkhirDinas.ToString("dd MMM yy")</div>
                                                                <div class="text-muted" style="font-size: 10px;">@((h.AkhirDinas - h.AwalDinas).Days + 1) hari dinas</div>
                                                            </td>
                                                            <td class="py-2">
                                                                <div class="fw-bold" style="color: var(--color-orange);">@h.AwalCuti.ToString("dd MMM") - @h.AkhirCuti.ToString("dd MMM yy")</div>
                                                                <div class="text-muted" style="font-size: 10px;">@((h.AkhirCuti - h.AwalCuti).Days + 1) hari cuti</div>
                                                            </td>
                                                            <td class="py-2 text-muted" style="font-size: 10px; vertical-align: middle;">
                                                                @h.CreatedAt.ToString("dd/MM/yy HH:mm")
                                                            </td>
                                                            <td class="text-end pe-0 py-2" style="vertical-align: middle;">
                                                                <div class="d-flex justify-content-end gap-1">
                                                                    <button type="button" class="btn btn-sm btn-outline-info btn-edit-roster" 
                                                                            data-id="@h.Id" 
                                                                            data-tipe="@h.TipeRoster" 
                                                                            data-awal-dinas="@h.AwalDinas.ToString("yyyy-MM-dd")" 
                                                                            data-akhir-dinas="@h.AkhirDinas.ToString("yyyy-MM-dd")" 
                                                                            data-awal-cuti="@h.AwalCuti.ToString("yyyy-MM-dd")" 
                                                                            data-akhir-cuti="@h.AkhirCuti.ToString("yyyy-MM-dd")" 
                                                                            data-keterangan="@(h.Keterangan ?? "")" 
                                                                            title="Edit Roster" 
                                                                            style="padding: 2px 7px; font-size: 11px; border-radius: 6px;">
                                                                        <i class="bi bi-pencil-square"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-roster-item" 
                                                                            data-id="@h.Id" 
                                                                            data-tipe="@h.TipeRoster" 
                                                                            title="Hapus Roster" 
                                                                            style="padding: 2px 7px; font-size: 11px; border-radius: 6px;">
                                                                        <i class="bi bi-trash3"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </form>
                </div>
                
                <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 16px 20px; background: rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center; width: 100%;">
                    <div>
                        @if (ViewData["IsEditMode"] is bool deleteAllowed && deleteAllowed)
                        {
                            <button type="button" id="btnDeleteRoster" class="btn btn-danger animate-pop-in" style="background-color: var(--color-red, #dc2626); border-color: var(--color-red, #dc2626); border-radius: 12px; padding: 10px 16px; font-weight: 600; font-size: 13px; color: white;">
                                <i class="bi bi-trash3-fill me-1"></i> Hapus Status
                            </button>
                        }
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn btn-roster-cancel" data-bs-dismiss="modal">Batal</button>
                        <button type="button" id="btnSaveRoster" class="btn btn-roster-save">Simpan</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function() {
                // Auto-trigger popup via query parameter
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('openRoster') === 'true') {
                    setTimeout(function() {
                        var myModal = new bootstrap.Modal(document.getElementById('rosterSettingsModal'), {
                            backdrop: 'static',
                            keyboard: false
                        });
                        myModal.show();
                    }, 300);
                }

                // Auto-trigger popup if configured by backend, taking care not to overlap with incident popup
                @if (ViewData["ShowRosterPopup"] is bool show && show)
                {
                    <text>
                    setTimeout(function() {
                        // Roster wajib diset jika belum pernah diset sama sekali atau sudah kedaluwarsa.
                        var $incidentModal = $('#incidentPopupModal');
                        if ($incidentModal.length) {
                            var incidentId = $incidentModal.attr('data-incident-id');
                            var incidentShown = sessionStorage.getItem('incident_popup_shown');
                            
                            if (incidentId && incidentShown !== incidentId) {
                                $incidentModal.on('hidden.bs.modal', function() {
                                    showRosterModal();
                                });
                                return;
                            }
                        }
                        
                        showRosterModal();
                    }, 500);

                    function showRosterModal() {
                        var rosterModal = new bootstrap.Modal(document.getElementById('rosterSettingsModal'), {
                            backdrop: 'static',
                            keyboard: false
                        });
                        rosterModal.show();
                    }
                    </text>
                }

                function updateRosterStatusLabel() {
                    const awalDinas = $('#awalDinas').val();
                    const akhirDinas = $('#akhirDinas').val();
                    const awalCuti = $('#awalCuti').val();
                    const akhirCuti = $('#akhirCuti').val();
                    
                    if (awalDinas && akhirDinas && awalCuti && akhirCuti) {
                        const today = new Date();
                        today.setHours(0,0,0,0);
                        const endCuti = new Date(akhirCuti);
                        endCuti.setHours(0,0,0,0);
                        
                        if (endCuti >= today) {
                            $('#rosterStatusBadge').text('Aktif').css({
                                'background-color': 'rgba(16, 185, 129, 0.15)',
                                'color': '#10b981'
                            });
                        } else {
                            $('#rosterStatusBadge').text('Expired').css({
                                'background-color': 'rgba(244, 63, 94, 0.15)',
                                'color': '#f43f5e'
                            });
                        }
                    } else {
                        $('#rosterStatusBadge').text('Belum Set').css({
                            'background-color': 'rgba(245, 158, 11, 0.15)',
                            'color': '#f59e0b'
                        });
                    }
                }
                
                updateRosterStatusLabel();

                // Handler edit roster / tugas dari tabel riwayat
                $(document).on('click', '.btn-edit-roster', function() {
                    const id = $(this).data('id');
                    const tipe = $(this).data('tipe') || 'REGULER';
                    const awalDinas = $(this).data('awal-dinas');
                    const akhirDinas = $(this).data('akhir-dinas');
                    const awalCuti = $(this).data('awal-cuti');
                    const akhirCuti = $(this).data('akhir-cuti');
                    const keterangan = $(this).data('keterangan') || '';

                    $('#rosterEditId').val(id);

                    if (tipe === 'TUGAS') {
                        $('#tabPeriodeTugas').trigger('click');
                        $('#awalTugas').val(awalDinas);
                        $('#akhirTugas').val(akhirDinas);
                        $('#keteranganTugas').val(keterangan);
                        $('#rosterEditNoticeText').html('<strong>Mode Edit Tugas:</strong> Mengedit Periode Penugasan (' + awalDinas + ' s/d ' + akhirDinas + ')');
                    } else {
                        $('#tabRosterReguler').trigger('click');
                        $('#awalDinas').val(awalDinas);
                        $('#akhirDinas').val(akhirDinas);
                        $('#awalCuti').val(awalCuti);
                        $('#akhirCuti').val(akhirCuti);
                        updateRosterStatusLabel();
                        $('#rosterEditNoticeText').html('<strong>Mode Edit Roster:</strong> Mengedit Roster Reguler (' + awalDinas + ' s/d ' + akhirCuti + ')');
                    }

                    $('#rosterEditModeNotice').removeClass('d-none');
                    $('#btnSaveRoster').text('Simpan Perubahan');
                    $('.modal-body').animate({ scrollTop: 0 }, 200);
                });

                // Batal edit mode
                $('#btnCancelEditMode').on('click', function() {
                    $('#rosterEditId').val('');
                    $('#rosterEditModeNotice').addClass('d-none');
                    $('#btnSaveRoster').text('Simpan');
                    $('#rosterFormAlert').addClass('d-none').text('');
                });

                // Handler hapus spesifik item roster / tugas dari tabel riwayat
                $(document).on('click', '.btn-delete-roster-item', function() {
                    const id = $(this).data('id');
                    const tipe = $(this).data('tipe') || 'REGULER';
                    const labelTipe = tipe === 'TUGAS' ? 'Periode Tugas' : 'Roster';

                    if (confirm('Apakah Anda yakin ingin menghapus ' + labelTipe + ' ini?')) {
                        const btn = $(this);
                        const originalHtml = btn.html();
                        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

                        $.ajax({
                            url: '/Api/DeleteRoster?id=' + id,
                            type: 'POST',
                            success: function(response) {
                                window.rosterSavedSuccess = true;
                                localStorage.removeItem('roster_popup_dismissed_date');
                                alert(response.message || (labelTipe + ' berhasil dihapus.'));
                                window.location.href = '/Home/Index?openRoster=true';
                            },
                            error: function(xhr) {
                                btn.prop('disabled', false).html(originalHtml);
                                const errorMsg = xhr.responseJSON?.message || xhr.responseText || ('Gagal menghapus ' + labelTipe + '. Coba lagi.');
                                alert(errorMsg);
                            }
                        });
                    }
                });

                $('#btnDeleteRoster').on('click', function() {
                    if (confirm('Apakah Anda yakin ingin menghapus status/roster aktif Anda? Tindakan ini akan mengembalikan status target bulanan Anda ke "Belum Set".')) {
                        const btn = $(this);
                        const originalText = btn.html();
                        btn.prop('disabled', true).text('Menghapus...');

                        const editId = $('#rosterEditId').val();
                        const url = editId ? ('/Api/DeleteRoster?id=' + editId) : '/Api/DeleteRoster';

                        $.ajax({
                            url: url,
                            type: 'POST',
                            success: function(response) {
                                window.rosterSavedSuccess = true;
                                localStorage.removeItem('roster_popup_dismissed_date');
                                alert('Status/roster berhasil dihapus.');
                                window.location.href = '/Home/Index';
                            },
                            error: function(xhr) {
                                btn.prop('disabled', false).html(originalText);
                                const errorMsg = xhr.responseJSON?.message || xhr.responseText || 'Gagal menghapus roster. Coba lagi.';
                                alert(errorMsg);
                            }
                        });
                    }
                });

                // Tab switching between Roster Reguler and Periode Tugas
                $('#tabRosterReguler').on('click', function() {
                    $(this).addClass('active');
                    $('#tabPeriodeTugas').removeClass('active');
                    $('#sectionRosterReguler').show();
                    $('#sectionPeriodeTugas').hide();
                    $('#tipeRosterSelected').val('REGULER');
                });

                $('#tabPeriodeTugas').on('click', function() {
                    $(this).addClass('active');
                    $('#tabRosterReguler').removeClass('active');
                    $('#sectionPeriodeTugas').show();
                    $('#sectionRosterReguler').hide();
                    $('#tipeRosterSelected').val('TUGAS');
                });

                $('#btnSaveRoster').on('click', function() {
                    const alertContainer = $('#rosterFormAlert');
                    alertContainer.addClass('d-none').text('');

                    const currentTipe = $('#tipeRosterSelected').val() || 'REGULER';
                    const editIdVal = $('#rosterEditId').val();
                    const editId = editIdVal ? parseInt(editIdVal) : null;

                    if (currentTipe === 'TUGAS') {
                        const awalTugasVal = $('#awalTugas').val();
                        const akhirTugasVal = $('#akhirTugas').val();
                        const keteranganVal = $('#keteranganTugas').val();

                        if (!awalTugasVal || !akhirTugasVal) {
                            alertContainer.removeClass('d-none')
                                .removeClass('alert-success')
                                .addClass('alert-danger')
                                .css({
                                    'background-color': 'rgba(244, 63, 94, 0.12)',
                                    'border-color': 'rgba(244, 63, 94, 0.2)',
                                    'color': 'var(--color-red)'
                                })
                                .text('Tanggal mulai dan selesai tugas wajib diisi!');
                            return;
                        }

                        const awalTugas = new Date(awalTugasVal);
                        const akhirTugas = new Date(akhirTugasVal);

                        if (awalTugas > akhirTugas) {
                            alertContainer.removeClass('d-none')
                                .removeClass('alert-success')
                                .addClass('alert-danger')
                                .css({
                                    'background-color': 'rgba(244, 63, 94, 0.12)',
                                    'border-color': 'rgba(244, 63, 94, 0.2)',
                                    'color': 'var(--color-red)'
                                })
                                .text('Tanggal mulai tugas tidak boleh melebihi selesai tugas.');
                            return;
                        }

                        const btn = $(this);
                        const originalText = btn.text();
                        btn.prop('disabled', true).text('Menyimpan...');

                        const requestData = {
                            id: editId,
                            tipeRoster: 'TUGAS',
                            awalDinas: awalTugasVal,
                            akhirDinas: akhirTugasVal,
                            keterangan: keteranganVal
                        };

                        $.ajax({
                            url: '/Api/SaveRoster',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(requestData),
                            success: function(response) {
                                window.rosterSavedSuccess = true;
                                localStorage.removeItem('roster_popup_dismissed_date');
                                alertContainer.removeClass('d-none')
                                    .removeClass('alert-danger')
                                    .addClass('alert-success')
                                    .css({
                                        'background-color': 'rgba(16, 185, 129, 0.15)',
                                        'border-color': 'rgba(16, 185, 129, 0.2)',
                                        'color': '#10b981'
                                    })
                                    .text(response.message || 'Periode tugas berhasil disimpan!');

                                setTimeout(function() {
                                    const modalEl = document.getElementById('rosterSettingsModal');
                                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                                    if (modalInstance) {
                                        modalInstance.hide();
                                    }
                                    window.location.href = '/Home/Index';
                                }, 1000);
                            },
                            error: function(xhr) {
                                btn.prop('disabled', false).text(originalText);
                                const errorMsg = xhr.responseJSON?.message || xhr.responseText || 'Gagal menyimpan periode tugas. Coba lagi.';
                                alertContainer.removeClass('d-none')
                                    .removeClass('alert-success')
                                    .addClass('alert-danger')
                                    .css({
                                        'background-color': 'rgba(244, 63, 94, 0.12)',
                                        'border-color': 'rgba(244, 63, 94, 0.2)',
                                        'color': 'var(--color-red)'
                                    })
                                    .text(errorMsg);
                            }
                        });
                        return;
                    }

                    // ROSTER REGULER
                    const awalDinasVal = $('#awalDinas').val();
                    const akhirDinasVal = $('#akhirDinas').val();
                    const awalCutiVal = $('#awalCuti').val();
                    const akhirCutiVal = $('#akhirCuti').val();

                    if (!awalDinasVal || !akhirDinasVal || !awalCutiVal || !akhirCutiVal) {
                        alertContainer.removeClass('d-none')
                            .removeClass('alert-success')
                            .addClass('alert-danger')
                            .css({
                                'background-color': 'rgba(244, 63, 94, 0.12)',
                                'border-color': 'rgba(244, 63, 94, 0.2)',
                                'color': 'var(--color-red)'
                            })
                            .text('Semua tanggal dinas dan cuti wajib diisi!');
                        return;
                    }

                    const awalDinas = new Date(awalDinasVal);
                    const akhirDinas = new Date(akhirDinasVal);
                    const awalCuti = new Date(awalCutiVal);
                    const akhirCuti = new Date(akhirCutiVal);

                    if (awalDinas > akhirDinas) {
                        alertContainer.removeClass('d-none')
                            .removeClass('alert-success')
                            .addClass('alert-danger')
                            .css({
                                'background-color': 'rgba(244, 63, 94, 0.12)',
                                'border-color': 'rgba(244, 63, 94, 0.2)',
                                'color': 'var(--color-red)'
                            })
                            .text('Tanggal awal dinas tidak boleh melebihi akhir dinas.');
                        return;
                    }
                    if (akhirDinas >= awalCuti) {
                        alertContainer.removeClass('d-none')
                            .removeClass('alert-success')
                            .addClass('alert-danger')
                            .css({
                                'background-color': 'rgba(244, 63, 94, 0.12)',
                                'border-color': 'rgba(244, 63, 94, 0.2)',
                                'color': 'var(--color-red)'
                            })
                            .text('Tanggal akhir dinas harus sebelum awal cuti.');
                        return;
                    }
                    if (awalCuti > akhirCuti) {
                        alertContainer.removeClass('d-none')
                            .removeClass('alert-success')
                            .addClass('alert-danger')
                            .css({
                                'background-color': 'rgba(244, 63, 94, 0.12)',
                                'border-color': 'rgba(244, 63, 94, 0.2)',
                                'color': 'var(--color-red)'
                            })
                            .text('Tanggal awal cuti tidak boleh melebihi akhir cuti.');
                        return;
                    }

                    const btn = $(this);
                    const originalText = btn.text();
                    btn.prop('disabled', true).text('Menyimpan...');

                    const requestData = {
                        id: editId,
                        tipeRoster: 'REGULER',
                        awalDinas: awalDinasVal,
                        akhirDinas: akhirDinasVal,
                        awalCuti: awalCutiVal,
                        akhirCuti: akhirCutiVal
                    };

                    $.ajax({
                        url: '/Api/SaveRoster',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function(response) {
                            window.rosterSavedSuccess = true;
                            localStorage.removeItem('roster_popup_dismissed_date');
                            alertContainer.removeClass('d-none')
                                .removeClass('alert-danger')
                                .addClass('alert-success')
                                .css({
                                    'background-color': 'rgba(16, 185, 129, 0.15)',
                                    'border-color': 'rgba(16, 185, 129, 0.2)',
                                    'color': '#10b981'
                                })
                                .text(response.message || 'Roster berhasil disimpan!');

                            setTimeout(function() {
                                const modalEl = document.getElementById('rosterSettingsModal');
                                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                                if (modalInstance) {
                                    modalInstance.hide();
                                }
                                updateRosterStatusLabel();
                                window.location.href = '/Home/Index';
                            }, 1000);
                        },
                        error: function(xhr) {
                            btn.prop('disabled', false).text(originalText);
                            const errorMsg = xhr.responseJSON?.message || xhr.responseText || 'Gagal menyimpan roster. Coba lagi.';
                            alertContainer.removeClass('d-none')
                                .removeClass('alert-success')
                                .addClass('alert-danger')
                                .css({
                                    'background-color': 'rgba(244, 63, 94, 0.12)',
                                    'border-color': 'rgba(244, 63, 94, 0.2)',
                                    'color': 'var(--color-red)'
                                })
                                .text(errorMsg);
                        }
                    });
                });

                // Simpan status ditolak jika modal roster ditutup tanpa disimpan
                $('#rosterSettingsModal').on('hidden.bs.modal', function () {
                    if (!window.rosterSavedSuccess) {
                        const todayStr = new Date().toDateString();
                        localStorage.setItem('roster_popup_dismissed_date', todayStr);
                    }
                });
            });
        </script>
    }
