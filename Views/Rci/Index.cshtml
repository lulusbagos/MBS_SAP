    // Geolocation GPS
    function getLocationRci() {
        const btn = $('#btnGetLocation');
        btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    const lat = position.coords.latitude.toFixed(6);
                    const lon = position.coords.longitude.toFixed(6);
                    $('#latitude').val(lat);
                    $('#longitude').val(lon);
                    const currentLoc = $('#lokasi').val();
                    if (!currentLoc || currentLoc.startsWith('GPS:')) {
                        $('#lokasi').val(`GPS: ${lat}, ${lon}`);
                    }
                    btn.html('<i class="bi bi-crosshair text-success" style="font-size: 18px;"></i>');
                },
                function(error) {
                    btn.html('<i class="bi bi-crosshair text-danger" style="font-size: 18px;"></i>');
                    $('#clientAlertTitle').text('GPS Gagal Diambil');
                    $('#clientAlertMsg').text('Pastikan izin lokasi browser Anda aktif: ' + error.message);
                    new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        } else {
            btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
            $('#clientAlertTitle').text('Browser Tidak Mendukung');
            $('#clientAlertMsg').text('Perangkat atau browser tidak mendukung fitur Geolocation.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
        }
    }

