</style>

@section Scripts {
<script>
    let currentRciSummaryData = {};

    $(document).ready(function() {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            var sElem = document.getElementById('statusSuccessModal');
            if (sElem) { new bootstrap.Modal(sElem).show(); }
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            var eElem = document.getElementById('statusErrorModal');
            if (eElem) { new bootstrap.Modal(eElem).show(); }
            </text>
        }

        calculateRciScore();
    });

    function confirmDeleteRci(id) {
        $('#deleteForm').attr('action', '/Rci/Delete/' + id);
        var delModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        delModal.show();
    }

    $('#rciForm').on('submit', function(e) {
        const area = $('#area').val();
        const namaJalan = ($('#namaJalan').val() || '').trim();
        const lokasi = ($('#lokasi').val() || '').trim();

        if (!area || !namaJalan || !lokasi) {
            e.preventDefault();
            $('#clientAlertTitle').text('Data Belum Lengkap');
            $('#clientAlertMsg').text('Mohon lengkapi Area Utama, Nama Jalan / Jalur Hauling, dan Lokasi Spesifik sebelum menyimpan.');
            var alertModal = new bootstrap.Modal(document.getElementById('clientAlertModal'));
            alertModal.show();
            return false;
        }
    });

    // Live Score Calculator & Dynamic Conclusion Analysis
    function calculateRciScore() {
        const p1 = parseInt($('#skorLebarJalan').val()) || 100;
        const p2 = parseInt($('#skorGradeJalan').val()) || 100;
        const p3 = parseInt($('#skorPermukaanJalan').val()) || 100;
        const p4 = parseInt($('#skorSafetyBerm').val()) || 100;
        const p5 = parseInt($('#skorDrainaseParit').val()) || 100;
        const p6 = parseInt($('#skorSuperelevasiTikungan').val()) || 100;
        const p7 = parseInt($('#skorBebasSpillage').val()) || 100;
        const p8 = parseInt($('#skorRambuDebu').val()) || 100;

        const total = (p1 * 0.15) + (p2 * 0.10) + (p3 * 0.15) + (p4 * 0.15) + (p5 * 0.15) + (p6 * 0.10) + (p7 * 0.10) + (p8 * 0.10);
        const rounded = total.toFixed(1);

        const paramsList = [
            { name: "Lebar Jalan Angkut", val: p1, desc100: ">= 3.5x Lebar Unit", desc70: "Pas 3x Lebar Unit (Sempit berpapasan)", desc40: "Sempit (< 3x Lebar Unit - Rawan senggolan)" },
            { name: "Kemiringan Jalan (Grade)", val: p2, desc100: "Standar (<= 8%)", desc70: "Agak Curam (8 - 10%)", desc40: "Terlalu Curam (> 10% - Rawan amblas/meluncur)" },
            { name: "Kondisi Permukaan (Surface)", val: p3, desc100: "Mulus & Padat", desc70: "Bergelombang / Lubang Kecil", desc40: "Lubang Dalam / Amblas (Rawan patah as)" },
            { name: "Tanggul Pengaman (Safety Berm)", val: p4, desc100: ">= 3/4 Roda & Kokoh", desc70: "Ada Bagian Rendah / Kurang Padat", desc40: "Terputus / Tidak Ada Tanggul" },
            { name: "Kemiringan Melintang & Parit", val: p5, desc100: "Parit Bersih, Aliran Lancar", desc70: "Tersumbat Sebagian", desc40: "Buntu / Air Meluap ke Jalan" },
            { name: "Superelevasi & Tikungan", val: p6, desc100: "Radius & Miring Pas", desc70: "Agak Tajam / Pandang Terhalang", desc40: "Miring Terbalik (Negative Camber - Rawan Terguling)" },
            { name: "Bebas Batu Lepas / Spillage", val: p7, desc100: "Bersih Total dari Batu", desc70: "Ada Kerikil / Spillage Tipis", desc40: "Bongkahan Batu Tajam / Ceceran Banyak (Merusak Ban)" },
            { name: "Rambu, Patok Pandu & Debu", val: p8, desc100: "Rambu Jelas & Minim Debu", desc70: "Berdebu Sedang (Perlu Water Truck)", desc40: "Debu Sangat Tebal / Rambu Rusak" }
        ];

        let cnt100 = 0, cnt70 = 0, cnt40 = 0;
        let findings = [];
        let autoActions = [];

        paramsList.forEach(p => {
            if (p.val === 100) cnt100++;
            else if (p.val === 70) {
                cnt70++;
                findings.push(`<b>${p.name}</b>: Skor 70 (${p.desc70})`);
                if (p.name.includes("Parit") || p.name.includes("Drainase")) autoActions.push("Normalisasi dan pembersihan parit drainase");
                else if (p.name.includes("Permukaan")) autoActions.push("Scraping & perataan jalan dengan motor grader");
                else if (p.name.includes("Berm")) autoActions.push("Peninggian dan pemadatan tanggul pengaman (safety berm)");
                else if (p.name.includes("Debu")) autoActions.push("Tingkatkan frekuensi penyiraman jalan dengan water truck");
                else if (p.name.includes("Spillage")) autoActions.push("Pembersihan ceceran batu lepas di jalur aktif");
                else autoActions.push(`Penyesuaian perbaikan pada ${p.name}`);
            } else if (p.val === 40) {
                cnt40++;
                findings.push(`<span class="text-danger"><b>${p.name}</b>: Skor 40 (${p.desc40}) [KRITIS]</span>`);
                if (p.name.includes("Permukaan") || p.name.includes("Grade")) autoActions.push("URGENT: Grading ulang lapis pondasi & pemadatan compactor");
                else if (p.name.includes("Berm")) autoActions.push("URGENT: Rekonstruksi tanggul pengaman minimal 3/4 tinggi roda alat");
                else if (p.name.includes("Parit") || p.name.includes("Drainase")) autoActions.push("URGENT: Penggalian kembali parit buntu & sodetan darurat");
                else if (p.name.includes("Spillage")) autoActions.push("URGENT: Singkirkan bongkahan batu besar dengan wheel loader");
                else autoActions.push(`URGENT: Rekayasa penanganan keselamatan pada ${p.name}`);
            }
        });

        $('#cntStandar').text(cnt100);
        $('#cntPerhatian').text(cnt70);
        $('#cntKritis').text(cnt40);

        let label = "Baik";
        let color = "#10b981";
        let bg = "rgba(16, 185, 129, 0.15)";
        let border = "rgba(16, 185, 129, 0.4)";
        let statusTitle = "STATUS: LAYAK OPERASIONAL (OPTIMAL)";
        let statusDesc = "Seluruh 8 parameter memenuhi standar teknis jalan hauling tambang. Kondisi prima dan aman.";
        let statusIcon = "bi-shield-fill-check";

        if (total < 70) {
            label = "Kurang";
            color = "#f43f5e";
            bg = "rgba(244, 63, 94, 0.15)";
            border = "rgba(244, 63, 94, 0.4)";
            statusTitle = "STATUS: TIDAK LAYAK / RAWAN BAHAYA (PERBAIKAN SEGERA)";
            statusDesc = "Ditemukan parameter kritis di bawah standar keselamatan tambang. Batasi muatan & segera lakukan perbaikan.";
            statusIcon = "bi-x-octagon-fill";
        } else if (total < 85) {
            label = "Sedang";
            color = "#f59e0b";
            bg = "rgba(245, 158, 11, 0.15)";
            border = "rgba(245, 158, 11, 0.4)";
            statusTitle = "STATUS: LAYAK DENGAN PENGAWASAN & CATATAN";
            statusDesc = "Jalan dapat dilalui dengan kewaspadaan. Terdapat parameter yang memerlukan pemeliharaan rutin.";
            statusIcon = "bi-exclamation-triangle-fill";
        }

        $('#liveScoreVal').text(rounded);
        $('#liveScoreBadge').html(`Skor RCI: <span>${rounded}</span>% (${label})`).css({ 'background': bg, 'color': color, 'border-color': border });

        $('#summaryScoreVal').text(rounded + '%').css('color', color);
        $('#summaryCategoryBadge').html(`<i class="bi ${statusIcon} me-1"></i> ${label.toUpperCase()}`).css({ 'background': bg, 'color': color });

        $('#feasibilityBanner').css({ 'background': bg, 'border-color': border, 'color': color });
        $('#feasibilityIcon').attr('class', `bi ${statusIcon}`);
        $('#feasibilityTitle').text(statusTitle);
        $('#feasibilityDesc').text(statusDesc);

        // Update findings list
        if (findings.length === 0) {
            $('#findingsCountBadge').text('0 Defisit').attr('class', 'badge bg-success');
            $('#findingsList').html('<i class="bi bi-check2-circle text-success me-1"></i> Semua parameter berada dalam batas optimal.');
            $('#autoRecText').text('Pertahankan pemeliharaan rutin jalan angkut.');
        } else {
            $('#findingsCountBadge').text(`${findings.length} Temuan Defisit`).attr('class', 'badge bg-warning text-dark');
            let listHtml = '<ul class="mb-0 ps-3">' + findings.map(f => `<li class="mb-1">${f}</li>`).join('') + '</ul>';
            $('#findingsList').html(listHtml);
            let recText = autoActions.length > 0 ? autoActions.join("; ") + "." : "Lakukan pemeliharaan dan perbaikan terarah pada parameter defisit.";
            $('#autoRecText').text(recText);
        }

        // Store summary for sharing
        currentRciSummaryData = {
            totalScore: rounded,
            kategori: label,
            statusTitle: statusTitle,
            cnt100: cnt100,
            cnt70: cnt70,
            cnt40: cnt40,
            findings: findings,
            autoRec: $('#autoRecText').text()
        };
    }

    // Button Score Selector (Supports both classes)
    $(document).on('click', '.btn-score-card, .btn-rci-score', function() {
        const param = $(this).data('param');
        const val = $(this).data('val');

        $(`.btn-score-card[data-param="${param}"], .btn-rci-score[data-param="${param}"]`).removeClass('active');
        $(this).addClass('active');

        $(`#${param}`).val(val);
        calculateRciScore();
    });

    function applyAutoRecommendationRci() {
        const rec = $('#autoRecText').text().trim();
        if (rec) {
            $('#tindakanPerbaikan').val(rec);
            $('#clientAlertTitle').text('Rekomendasi Diterapkan');
            $('#clientAlertMsg').text('Rekomendasi tindakan otomatis telah disalin ke formulir rekomendasi perbaikan.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
        }
    }

    function generateRciShareText() {
        const tgl = $('#tanggal').val() || '';
        const wkt = $('#waktuStr').val() || '';
        const area = $('#area').val() || '-';
        const namaJalan = $('#namaJalan').val() || $('#lokasi').val() || '-';
        const seg = $('#segmentJalan').val() || '';
        const shift = $('#shift').val() || '';
        const loc = $('#lokasi').val() || '';
        const pic = $('#pic').val() || '-';
        const perbaikan = $('#tindakanPerbaikan').val() || currentRciSummaryData.autoRec || '-';

        let text = `🚧 *LAPORAN INSPEKSI ROAD CONDITION INDEX (RCI)* 🚧\n`;
        text += `*PT MEGA GLOBAL ENERGY GROUP*\n\n`;
        text += `📅 Tanggal: ${tgl} ${wkt} (${shift})\n`;
        text += `📍 Ruas Jalan: ${namaJalan} ${seg ? `[${seg}]` : ''}\n`;
        text += `📌 Area / Lokasi: ${area} | ${loc}\n\n`;
        text += `⭐ *SKOR AKHIR: ${currentRciSummaryData.totalScore || '100'}% (${currentRciSummaryData.kategori || 'Baik'})*\n`;
        text += `📋 *${currentRciSummaryData.statusTitle || 'STATUS: LAYAK OPERASIONAL'}*\n\n`;
        text += `📊 *Komposisi Parameter:*\n`;
        text += `• Sesuai Standar (100): ${currentRciSummaryData.cnt100 || 8}\n`;
        text += `• Perlu Perhatian (70): ${currentRciSummaryData.cnt70 || 0}\n`;
        text += `• Kritis / Substandard (40): ${currentRciSummaryData.cnt40 || 0}\n\n`;

        if (currentRciSummaryData.findings && currentRciSummaryData.findings.length > 0) {
            text += `🔍 *Temuan Defisit:*\n`;
            currentRciSummaryData.findings.forEach(f => {
                text += `• ${f.replace(/<[^>]*>/g, '')}\n`;
            });
            text += `\n`;
        } else {
            text += `🔍 *Temuan:* Seluruh parameter sesuai standar teknis operasional.\n\n`;
        }

        text += `🛠️ *Rekomendasi Tindakan:*\n${perbaikan}\n`;
        text += `👷 PIC: ${pic}\n`;
        return text;
    }

    function shareRciToWhatsApp() {
        const text = encodeURIComponent(generateRciShareText());
        window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    function shareRciNative() {
        const text = generateRciShareText();
        if (navigator.share) {
            navigator.share({
                title: 'Laporan Road Condition Index (RCI)',
                text: text
            }).catch(err => {
                console.log('Share dismissed', err);
            });
        } else {
            shareRciToWhatsApp();
        }
    }

    function copyRciSummaryToClipboard() {
        const text = generateRciShareText();
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
                $('#clientAlertTitle').text('Berhasil Disalin!');
                $('#clientAlertMsg').text('Ringkasan laporan RCI telah disalin ke clipboard. Anda dapat menempelkannya di chat WhatsApp atau dokumen lain.');
                new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            });
        } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            $('#clientAlertTitle').text('Berhasil Disalin!');
            $('#clientAlertMsg').text('Ringkasan laporan RCI telah disalin ke clipboard.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
        }
    }

    function shareSavedRci(id) {
        $.getJSON('/Rci/GetDetail/' + id, function(d) {
            let text = `🚧 *LAPORAN INSPEKSI ROAD CONDITION INDEX (RCI)* 🚧\n`;
            text += `*PT MEGA GLOBAL ENERGY GROUP*\n\n`;
            text += `📅 Tanggal: ${d.tanggal} ${d.waktu} (${d.shift || '-'})\n`;
            text += `📍 Ruas Jalan: ${d.namaJalan || d.lokasi} ${d.segmentJalan ? `[${d.segmentJalan}]` : ''}\n`;
            text += `📌 Area / Lokasi: ${d.area} | ${d.lokasi}\n`;
            text += `👮 Inspector: ${d.nama} (${d.nik})\n\n`;
            text += `⭐ *SKOR AKHIR: ${d.totalScore}% (${d.kategoriIndex})*\n\n`;
            text += `📊 *Rincian Nilai 8 Parameter:*\n`;
            text += `• Lebar Jalan: ${d.skorLebarJalan}/100\n`;
            text += `• Grade Jalan: ${d.skorGradeJalan}/100\n`;
            text += `• Permukaan: ${d.skorPermukaanJalan}/100\n`;
            text += `• Safety Berm: ${d.skorSafetyBerm}/100\n`;
            text += `• Drainase Parit: ${d.skorDrainaseParit}/100\n`;
            text += `• Superelevasi: ${d.skorSuperelevasiTikungan}/100\n`;
            text += `• Bebas Spillage: ${d.skorBebasSpillage}/100\n`;
            text += `• Rambu & Debu: ${d.skorRambuDebu}/100\n\n`;
            if (d.catatan) text += `📝 Catatan: ${d.catatan}\n`;
            if (d.tindakanPerbaikan) text += `🛠️ Rekomendasi: ${d.tindakanPerbaikan} (PIC: ${d.pic || '-'})\n`;

            if (navigator.share) {
                navigator.share({ title: 'Laporan RCI #' + d.id, text: text }).catch(() => {});
            } else {
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
            }
        });
    }

    // Auto GPS Location
    function getLocationRci() {
        if (!navigator.geolocation) {
            $('#clientAlertTitle').text('GPS Tidak Didukung');
            $('#clientAlertMsg').text('Browser atau perangkat Anda tidak mendukung fitur Geolocation.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            return;
        }

        const btn = $('#btnGetLocation');
        btn.html('<span class="spinner-border spinner-border-sm" role="status"></span>');

        navigator.geolocation.getCurrentPosition(
            function(pos) {
                const lat = pos.coords.latitude.toFixed(6);
                const lng = pos.coords.longitude.toFixed(6);
                $('#latitude').val(lat);
                $('#longitude').val(lng);

                const currentLoc = $('#lokasi').val().trim();
                if (!currentLoc) {
                    $('#lokasi').val(`Koordinat: ${lat}, ${lng}`);
                } else if (!currentLoc.includes(lat)) {
                    $('#lokasi').val(`${currentLoc} (${lat}, ${lng})`);
                }

                btn.html('<i class="bi bi-check-circle-fill text-success" style="font-size: 18px;"></i>');
                setTimeout(() => {
                    btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                }, 2000);
            },
            function(err) {
                btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                $('#clientAlertTitle').text('Gagal Mengambil GPS');
                $('#clientAlertMsg').text('Tidak dapat mendeteksi koordinat lokasi: ' + err.message + '. Silakan isi lokasi secara manual.');
                new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    // Reset Form
    function resetForm() {
        $('#rciForm')[0].reset();
        $('#rciId').val('');
        $('#formTitle').html('<i class="bi bi-pencil-square" style="color: #3b82f6;"></i> <span>Form Penilaian RCI</span> <span class="badge" style="background: linear-gradient(135deg, #ef4444, #f43f5e); color: white; font-size: 9.5px; font-weight: 800; padding: 2.5px 7px; border-radius: 6px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(244, 63, 94, 0.4); display: inline-flex; align-items: center; gap: 2px;"><i class="bi bi-stars" style="font-size: 9px;"></i> NEW</span>');
        $('#btnCancelEdit').addClass('d-none');

        $('.btn-score-card, .btn-rci-score').removeClass('active');
        $('.btn-score-card[data-val="100"], .btn-rci-score[data-val="100"]').addClass('active');
        $('input[id^="skor"]').val('100');
        calculateRciScore();
    }

    // Edit RCI
    function editRci(id) {
        $.getJSON('/Rci/GetDetail/' + id, function(data) {
            $('#rciId').val(data.id);
            $('#tanggal').val(data.tanggal);
            $('#waktuStr').val(data.waktu);
            $('#area').val(data.area);
            $('#namaJalan').val(data.namaJalan);
            $('#segmentJalan').val(data.segmentJalan);
            $('#shift').val(data.shift);
            $('#lokasi').val(data.lokasi);
            $('#detilLokasi').val(data.detilLokasi);
            $('#latitude').val(data.latitude);
            $('#longitude').val(data.longitude);
            $('#catatan').val(data.catatan);
            $('#tindakanPerbaikan').val(data.tindakanPerbaikan);
            $('#pic').val(data.pic);

            const params = ['skorLebarJalan', 'skorGradeJalan', 'skorPermukaanJalan', 'skorSafetyBerm',
                            'skorDrainaseParit', 'skorSuperelevasiTikungan', 'skorBebasSpillage', 'skorRambuDebu'];

            params.forEach(p => {
                const val = data[p];
                $(`#${p}`).val(val);
                $(`.btn-score-card[data-param="${p}"], .btn-rci-score[data-param="${p}"]`).removeClass('active');
                $(`.btn-score-card[data-param="${p}"][data-val="${val}"], .btn-rci-score[data-param="${p}"][data-val="${val}"]`).addClass('active');
            });

            calculateRciScore();

            $('#formTitle').html(`<i class="bi bi-pencil-square text-warning"></i> <span>Edit Penilaian RCI #${data.id}</span>`);
            $('#btnCancelEdit').removeClass('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

