</style>

@section Scripts {
<script>
    let currentRciSummaryData = {};

    var globalAreasList = [
        { id: 1, namaArea: "Port/Jetty - Indexim" },
        { id: 2, namaArea: "CPP-33 & ROM - Indexim" },
        { id: 3, namaArea: "Kantor - Indexim" },
        { id: 4, namaArea: "Mess & Fasilitas - Indexim" },
        { id: 5, namaArea: "Nursery - Indexim" },
        { id: 6, namaArea: "Settling Pond - Indexim" },
        { id: 7, namaArea: "PIT - Unggul" },
        { id: 8, namaArea: "Road PIT Overburden - Unggul" },
        { id: 9, namaArea: "Kantor - Unggul" },
        { id: 10, namaArea: "Mess & Fasilitas - Unggul" },
        { id: 11, namaArea: "Settling Pond - Unggul" },
        { id: 12, namaArea: "PIT - KPP" },
        { id: 13, namaArea: "Road PIT Overburden - KPP" },
        { id: 14, namaArea: "Kantor - KPP" },
        { id: 15, namaArea: "Mess & Fasilitas - KPP" },
        { id: 16, namaArea: "Settling Pond - KPP" },
        { id: 17, namaArea: "PIT - MGE" },
        { id: 18, namaArea: "Road PIT Overburden - MGE" },
        { id: 19, namaArea: "Kantor - MGE" },
        { id: 20, namaArea: "Mess & Fasilitas - MGE" },
        { id: 21, namaArea: "Settling Pond - MGE" },
        { id: 22, namaArea: "Magazine/Gudang Handak" },
        { id: 23, namaArea: "Road Coal Mining (Jl. Anggrek)" },
        { id: 24, namaArea: "Road Coal Mining (Jl. Mawar)" },
        { id: 25, namaArea: "Road Coal Hauling (Jl. Nusantara)" },
        { id: 26, namaArea: "Other Area" }
    ];

    @if (areaList != null && areaList.Any())
    {
        <text>
        var serverAreas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(areaList));
        if (serverAreas && serverAreas.length > 0) {
            globalAreasList = serverAreas.map((a, i) => ({ id: i + 1, namaArea: a }));
        }
        </text>
    }

    // 8 Parameter Standar & Bobot Aktual SP3 Excel
    const rciParamsMetadata = [
        // Pilar 1: Permukaan Jalan (Bobot Pilar 60%)
        { key: "Surfacing", name: "Surfacing and Material", weight: 0.20, pilar: "Permukaan", desc: "Surface batu split & tidak terkupas" },
        { key: "Undulation", name: "Undulation / Corrugation", weight: 0.35, pilar: "Permukaan", desc: "Bebas lendutan & jalan keriting" },
        { key: "Spoil", name: "Spoil (Lebar 18m)", weight: 0.05, pilar: "Permukaan", desc: "Lebar jalan 18m, bebas penyempitan mud spoil/batubara" },

        // Pilar 2: Safety Berm (Bobot Pilar 20%)
        { key: "SafetyBerm", name: "Safety Berm (3/4 Ban)", weight: 0.10, pilar: "Berm", desc: "Tinggi >= 3/4 ban, bersih tanaman" },
        { key: "RoadAttachment", name: "Road Attachment", weight: 0.05, pilar: "Berm", desc: "Delineator per 35m & rambu terpasang" },
        { key: "Dust", name: "Dust Control", weight: 0.05, pilar: "Berm", desc: "Debu tidak mengurangi jarak pandang dumptruck" },

        // Pilar 3: Drainage (Bobot Pilar 20%)
        { key: "Crossfall", name: "Crossfall (0.5% - 1%)", weight: 0.10, pilar: "Drainage", desc: "Grade crossfall penirisan jalan 0.5% - 1%" },
        { key: "Drainage", name: "Drainage (Saluran)", weight: 0.10, pilar: "Drainage", desc: "Bebas genangan air badan jalan & parit lancar" }
    ];

    $(document).ready(function() {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            var successModal = new bootstrap.Modal(document.getElementById('statusSuccessModal'));
            successModal.show();
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            var errorModal = new bootstrap.Modal(document.getElementById('statusErrorModal'));
            errorModal.show();
            </text>
        }

        initAreaDropdown();
        initBenchmarkDropdown();
        calculateRciScore();
    });

    // Area Dropdown Functionality
    function initAreaDropdown() {
        const input = $('#areaSearch');
        const menu = $('#areaDropdownMenu');
        const hidden = $('#area');

        function renderList(filter = '') {
            menu.empty();
            const filtered = globalAreasList.filter(a => a.namaArea.toLowerCase().includes(filter.toLowerCase()));
            if (filtered.length === 0) {
                menu.append('<div class="p-2 text-muted text-center" style="font-size:12px;">Tidak ditemukan</div>');
            } else {
                filtered.forEach(a => {
                    const item = $(`<div class="p-2 border-bottom border-secondary border-opacity-10 area-item" style="cursor:pointer; font-size:12px; color:var(--text-main);">${a.namaArea}</div>`);
                    item.hover(
                        function() { $(this).css('background', 'rgba(59, 130, 246, 0.15)'); },
                        function() { $(this).css('background', 'transparent'); }
                    );
                    item.on('click', function() {
                        input.val(a.namaArea);
                        hidden.val(a.namaArea);
                        menu.hide();
                        onAreaSelected(a.namaArea);
                    });
                    menu.append(item);
                });
            }
        }

        input.on('focus input', function() {
            renderList($(this).val());
            menu.show();
        });

        $('#toggleAreaDropdown').on('click', function(e) {
            e.stopPropagation();
            if (menu.is(':visible')) menu.hide();
            else { renderList(input.val()); menu.show(); }
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#areaSearch, #areaDropdownMenu, #toggleAreaDropdown').length) {
                menu.hide();
            }
        });
    }

    function onAreaSelected(areaName) {
        $('#newBenchmarkArea').val(areaName);
        $('#benchmarkSearch').prop('disabled', false).val('').attr('placeholder', 'Pilih atau ketik Benchmark...');
        $('#detilLokasi').val('');
        $('#btnAddBenchmark').prop('disabled', false);
        loadBenchmarks(areaName);
    }

    // Benchmark Cascading
    let currentBenchmarks = [];
    function loadBenchmarks(areaName, selectValue = '') {
        $.getJSON('/P5m/GetBenchmarks?areaUtama=' + encodeURIComponent(areaName), function(data) {
            currentBenchmarks = data || [];
            renderBenchmarkMenu();
            if (selectValue) {
                $('#benchmarkSearch').val(selectValue);
                $('#detilLokasi').val(selectValue);
            }
        });
    }

    function renderBenchmarkMenu(filter = '') {
        const menu = $('#benchmarkDropdownMenu');
        menu.empty();
        const filtered = currentBenchmarks.filter(b => b.namaBenchmark.toLowerCase().includes(filter.toLowerCase()));
        if (filtered.length === 0) {
            menu.append('<div class="p-2 text-muted text-center" style="font-size:12px;">Belum ada benchmark terdaftar.</div>');
        } else {
            filtered.forEach(b => {
                const item = $(`<div class="p-2 border-bottom border-secondary border-opacity-10" style="cursor:pointer; font-size:12px; color:var(--text-main);">${b.namaBenchmark}</div>`);
                item.hover(
                    function() { $(this).css('background', 'rgba(59, 130, 246, 0.15)'); },
                    function() { $(this).css('background', 'transparent'); }
                );
                item.on('click', function() {
                    $('#benchmarkSearch').val(b.namaBenchmark);
                    $('#detilLokasi').val(b.namaBenchmark);
                    menu.hide();
                });
                menu.append(item);
            });
        }
    }

    function initBenchmarkDropdown() {
        const input = $('#benchmarkSearch');
        const menu = $('#benchmarkDropdownMenu');

        input.on('focus input', function() {
            renderBenchmarkMenu($(this).val());
            menu.show();
        });

        input.on('change', function() {
            $('#detilLokasi').val($(this).val());
        });

        $('#toggleBenchmarkDropdown').on('click', function(e) {
            e.stopPropagation();
            if (input.prop('disabled')) return;
            if (menu.is(':visible')) menu.hide();
            else { renderBenchmarkMenu(input.val()); menu.show(); }
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#benchmarkSearch, #benchmarkDropdownMenu, #toggleBenchmarkDropdown').length) {
                menu.hide();
            }
        });
    }

    function saveNewBenchmark() {
        const area = $('#area').val();
        const name = $('#newBenchmarkName').val().trim();
        if (!name) {
            $('#addBenchmarkError').text('Nama benchmark tidak boleh kosong').show();
            return;
        }

        $.ajax({
            url: '/P5m/AddBenchmark',
            type: 'POST',
            data: {
                areaUtama: area,
                namaBenchmark: name,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(resp) {
                if (resp.success) {
                    $('#addBenchmarkModal').modal('hide');
                    $('#newBenchmarkName').val('');
                    loadBenchmarks(area, name);
                } else {
                    $('#addBenchmarkError').text(resp.message || 'Gagal menyimpan').show();
                }
            },
            error: function() {
                $('#addBenchmarkError').text('Terjadi kesalahan sistem').show();
            }
        });
    }

    // Segmen Length & Defisit Live Calculation (PERSIS EXCEL SP3 J20 FORMULA)
    function onPanjangSegmentChange() {
        const p = parseFloat($('#panjangSegment').val()) || 100;
        if (p <= 0) return;
        rciParamsMetadata.forEach(meta => {
            calcParamFromDeficit(meta.key);
        });
    }

    function calcParamFromDeficit(paramKey) {
        const totalPanjang = parseFloat($('#panjangSegment').val()) || 100;
        const defisitInput = parseFloat($(`#defisit${paramKey}`).val()) || 0;

        // Persentase Ketercapaian = (Panjang - Defisit) / Panjang
        let ketercapaian = 1.0;
        if (totalPanjang > 0) {
            ketercapaian = Math.max(0, Math.min(1.0, (totalPanjang - defisitInput) / totalPanjang));
        }
        const pctKetercapaian = (ketercapaian * 100.0).toFixed(1);
        $(`#badgePersen${paramKey}`).text(`Ketercapaian: ${pctKetercapaian}% (Defisit: ${defisitInput}m)`);

        // RUMUS ASLI EXCEL SP3 CELL J20:
        // =IF((100-Defisit)/100 <= 0.50, 2, IF(<= 0.80, 2.5, IF(<= 0.90, 3, IF(<= 0.99, 3.5, 4))))
        let score = 4.0;
        if (ketercapaian <= 0.50) {
            score = 2.0;
        } else if (ketercapaian <= 0.80) {
            score = 2.5;
        } else if (ketercapaian <= 0.90) {
            score = 3.0;
        } else if (ketercapaian <= 0.99) {
            score = 3.5;
        } else {
            score = 4.0;
        }

        // Update score button active
        $(`.btn-score-card[data-param="skor${paramKey}"]`).removeClass('active');
        $(`.btn-score-card[data-param="skor${paramKey}"][data-val="${score}"], .btn-score-card[data-param="skor${paramKey}"][data-val="${score.toFixed(1)}"]`).addClass('active');
        $(`#skor${paramKey}`).val(score);

        calculateRciScore();
    }

    function selectScoreManual(paramKey, val) {
        $(`.btn-score-card[data-param="skor${paramKey}"]`).removeClass('active');
        $(`.btn-score-card[data-param="skor${paramKey}"][data-val="${val}"], .btn-score-card[data-param="skor${paramKey}"][data-val="${val.toFixed(1)}"]`).addClass('active');
        $(`#skor${paramKey}`).val(val);

        calculateRciScore();
    }

    // Live Total RCI Calculator (PERSIS EXCEL SP3 SUMMARY & WEST ROAD SCORE)
    function calculateRciScore() {
        const s1 = parseFloat($('#skorSurfacing').val()) || 4.0;
        const s2 = parseFloat($('#skorUndulation').val()) || 4.0;
        const s3 = parseFloat($('#skorSpoil').val()) || 4.0;
        const s4 = parseFloat($('#skorSafetyBerm').val()) || 4.0;
        const s5 = parseFloat($('#skorRoadAttachment').val()) || 4.0;
        const s6 = parseFloat($('#skorDust').val()) || 4.0;
        const s7 = parseFloat($('#skorCrossfall').val()) || 4.0;
        const s8 = parseFloat($('#skorDrainage').val()) || 4.0;

        // Pilar 1: Permukaan Jalan (Total Bobot 60% = 0.60)
        // Surfacing 20%, Undulation 35%, Spoil 5%
        const grpPermukaan = ((s1 * 0.20) + (s2 * 0.35) + (s3 * 0.05)) / 0.60;

        // Pilar 2: Safety Berm & Fasilitas (Total Bobot 20% = 0.20)
        // Safety Berm 10%, Road Attachment 5%, Dust 5%
        const grpBerm = ((s4 * 0.10) + (s5 * 0.05) + (s6 * 0.05)) / 0.20;

        // Pilar 3: Drainage & Penirisan (Total Bobot 20% = 0.20)
        // Crossfall 10%, Drainage 10%
        const grpDrainase = ((s7 * 0.10) + (s8 * 0.10)) / 0.20;

        // Total Actual Road Score = (Permukaan * 0.60) + (Berm * 0.20) + (Drainase * 0.20)
        const actualScore = (grpPermukaan * 0.60) + (grpBerm * 0.20) + (grpDrainase * 0.20);
        const actualRounded = actualScore.toFixed(2);
        const target = 4.00;
        const achievement = ((actualScore / target) * 100.0).toFixed(2);

        // Update Tabel Rekapitulasi 3 Pilar (Format Sheet Summary)
        $('#grpPermukaanVal').text(grpPermukaan.toFixed(2));
        $('#grpBermVal').text(grpBerm.toFixed(2));
        $('#grpDrainaseVal').text(grpDrainase.toFixed(2));
        $('#grpTotalVal').text(`${actualRounded} / 4.00`);
        $('#grpAchVal').text(`${achievement}%`);

        // Defisit Findings & Action Recommendations
        let findings = [];
        let autoActions = [];
        let cnt4 = 0, cnt35 = 0, cnt3 = 0, cnt25 = 0, cnt2 = 0;

        rciParamsMetadata.forEach(m => {
            const val = parseFloat($(`#skor${m.key}`).val()) || 4.0;
            const defM = parseFloat($(`#defisit${m.key}`).val()) || 0;

            if (val >= 4.0) cnt4++;
            else if (val >= 3.5) {
                cnt35++;
                findings.push(`<b>${m.name}</b>: Skor 3.5 (Defisit ${defM}m / &le;10% Cacat)`);
                if (m.key === "Dust") autoActions.push("Jadwalkan penyiraman ringan water truck");
                else autoActions.push(`Inspeksi rutin lanjutan pada ${m.name}`);
            } else if (val >= 3.0) {
                cnt3++;
                findings.push(`<b>${m.name}</b>: Skor 3.0 (Defisit ${defM}m / 11%-20% Cacat)`);
                if (m.key === "Surfacing") autoActions.push("Scraping ringan & penambahan batu split tipis");
                else if (m.key === "Undulation") autoActions.push("Perataan gelombang jalan dengan motor grader");
                else if (m.key === "Spoil") autoActions.push("Pembersihan ceceran spoil & pelebaran ke 18m");
                else if (m.key === "SafetyBerm") autoActions.push("Perapihan tanggul & pembersihan gulma");
                else if (m.key === "Dust") autoActions.push("Tingkatkan ritasi penyiraman water truck");
                else if (m.key === "Crossfall") autoActions.push("Bentuk crossfall kemiringan 0.5% - 1% penirisan");
                else if (m.key === "Drainage") autoActions.push("Pembersihan endapan parit drainase");
            } else if (val >= 2.5) {
                cnt25++;
                findings.push(`<span class="text-warning"><b>${m.name}</b>: Skor 2.5 (Defisit ${defM}m / 21%-50% Cacat) [PERHATIAN]</span>`);
                if (m.key === "Surfacing") autoActions.push("URGENT: Re-sheeting batu split lapis aus & pemadatan compactor");
                else if (m.key === "Undulation") autoActions.push("URGENT: Grading mendalam menghilangkan lendutan keriting");
                else if (m.key === "Spoil") autoActions.push("URGENT: Singkirkan tumpukan spoil / batubara penyempitan");
                else if (m.key === "SafetyBerm") autoActions.push("URGENT: Peninggian tanggul pengaman minimum 3/4 tinggi ban alat");
                else if (m.key === "Drainage") autoActions.push("URGENT: Penggalian kembali parit yang tersumbat / buat sodetan");
                else autoActions.push(`Penanganan terarah pada parameter ${m.name}`);
            } else {
                cnt2++;
                findings.push(`<span class="text-danger"><b>${m.name}</b>: Skor 2.0 (Defisit ${defM}m / &gt;50% Cacat) [KRITIS]</span>`);
                autoActions.push(`TINDAKAN DARURAT: Rekonstruksi & perbaikan mendesak pada ${m.name}`);
            }
        });

        // Determine Status & Colors
        let label = "Baik";
        let color = "#10b981";
        let bg = "rgba(16, 185, 129, 0.15)";
        let border = "rgba(16, 185, 129, 0.4)";
        let statusTitle = "STATUS: LAYAK OPERASIONAL (OPTIMAL)";
        let statusDesc = "Seluruh 8 parameter memenuhi standar teknis jalan hauling tambang. Kondisi prima dan aman.";
        let statusIcon = "bi-shield-fill-check";

        const achNum = parseFloat(achievement);
        if (achNum < 70) {
            label = "Kurang";
            color = "#f43f5e";
            bg = "rgba(244, 63, 94, 0.15)";
            border = "rgba(244, 63, 94, 0.4)";
            statusTitle = "STATUS: TIDAK LAYAK / RAWAN BAHAYA (PERBAIKAN SEGERA)";
            statusDesc = "Kondisi jalan berada di bawah standar keselamatan tambang. Batasi muatan & segera lakukan perbaikan grader/compactor.";
            statusIcon = "bi-x-octagon-fill";
        } else if (achNum < 85) {
            label = "Sedang";
            color = "#f59e0b";
            bg = "rgba(245, 158, 11, 0.15)";
            border = "rgba(245, 158, 11, 0.4)";
            statusTitle = "STATUS: LAYAK DENGAN PENGAWASAN & CATATAN";
            statusDesc = "Jalan dapat dilalui dengan kewaspadaan pengawas. Terdapat parameter yang memerlukan pemeliharaan terarah.";
            statusIcon = "bi-exclamation-triangle-fill";
        }

        $('#liveScoreVal').text(actualRounded);
        $('#liveAchVal').text(achievement);
        $('#liveScoreBadge').html(`Skor: <span>${actualRounded}</span>/4.00 (<span>${achievement}%</span> - ${label})`).css({ 'background': bg, 'color': color, 'border-color': border });

        $('#summaryScoreVal').text(actualRounded).css('color', color);
        $('#summaryAchVal').text(achievement + '%').css('color', color);
        $('#summaryCategoryBadge').html(`<i class="bi ${statusIcon} me-1"></i> ${label.toUpperCase()}`).css({ 'background': bg, 'color': color });

        $('#feasibilityBanner').css({ 'background': bg, 'border-color': border, 'color': color });
        $('#feasibilityIcon').attr('class', `bi ${statusIcon}`);
        $('#feasibilityTitle').text(statusTitle);
        $('#feasibilityDesc').text(statusDesc);

        // Update findings list
        if (findings.length === 0) {
            $('#findingsCountBadge').text('0 Defisit').attr('class', 'badge bg-success');
            $('#findingsList').html('<i class="bi bi-check2-circle text-success me-1"></i> Seluruh parameter segmen berada dalam kondisi optimal (100%).');
            $('#autoRecText').text('Pertahankan pemeliharaan rutin jalan angkut.');
        } else {
            $('#findingsCountBadge').text(`${findings.length} Temuan Defisit`).attr('class', 'badge bg-warning text-dark');
            let listHtml = '<ul class="mb-0 ps-3">' + findings.map(f => `<li class="mb-1">${f}</li>`).join('') + '</ul>';
            $('#findingsList').html(listHtml);
            let recText = autoActions.length > 0 ? autoActions.join("; ") + "." : "Lakukan pemeliharaan dan perbaikan terarah pada parameter defisit.";
            $('#autoRecText').text(recText);
        }

        // Store summary for sharing
        currentRciSummaryData = {
            actualScore: actualRounded,
            achievement: achievement,
            kategori: label,
            statusTitle: statusTitle,
            panjangSegment: $('#panjangSegment').val() || 100,
            grpPermukaan: grpPermukaan.toFixed(2),
            grpBerm: grpBerm.toFixed(2),
            grpDrainase: grpDrainase.toFixed(2),
            findings: findings,
            autoRec: $('#autoRecText').text()
        };
    }

