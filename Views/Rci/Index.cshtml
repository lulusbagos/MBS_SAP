@model IEnumerable<MBS_SAP.Models.RciReport>
@{
    ViewData["Title"] = "Road Condition Index (RCI) - SAP";
    var userNik = ViewBag.UserNik as string ?? "";
    var userNama = ViewBag.UserNama as string ?? "";
    var userDept = ViewBag.UserDept as string ?? "";
    var userCompany = ViewBag.UserCompany as string ?? "PT MEGA GLOBAL ENERGY";
    var areaList = ViewBag.AreaList as List<string> ?? new List<string>();
    var jalanList = ViewBag.JalanList as List<string> ?? new List<string>();
    var totalReports = ViewBag.TotalReports as int? ?? 0;
    var avgScore = ViewBag.AvgScore as double? ?? 100.0;
    var goodCount = ViewBag.GoodCount as int? ?? 0;
    var fairCount = ViewBag.FairCount as int? ?? 0;
    var poorCount = ViewBag.PoorCount as int? ?? 0;
}

<div class="animate-fade-in">
    <!-- Header Screen Title -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="screen-title d-flex align-items-center gap-2">
                <i class="bi bi-cone-striped text-primary" style="color: #3b82f6;"></i>
                <span>Road Condition Index (RCI)</span>
                <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); font-size: 11px; padding: 4px 10px; border-radius: 8px;">MGE Group</span>
            </div>
            <p class="screen-subtitle mb-0">Inspeksi & Penilaian Standar Kualitas Jalan Hauling & Tambang.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 shadow-sm" style="border-radius: 10px; padding: 8px 14px; font-weight: 600;">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Export Excel</span>
            </a>
        </div>
    </div>

    <!-- Status Feedback Popup Modal (Desktop & Mobile) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="modal fade" id="statusSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 16px auto;">
                <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); border: 2px solid #10b981;">
                        <i class="bi bi-check-lg text-success" style="font-size: 38px;"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2">Berhasil Disimpan!</h4>
                    <p class="text-muted mb-4" style="font-size: 13.5px; line-height: 1.5;">@TempData["SuccessMessage"]</p>
                    <button type="button" class="btn btn-primary w-100 py-2.5 font-weight-bold shadow-sm" style="background: linear-gradient(135deg, #1d4ed8, #3b82f6); border: none; border-radius: 14px;" data-bs-dismiss="modal">
                        <i class="bi bi-check2-circle me-1"></i> Selesai
                    </button>
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="modal fade" id="statusErrorModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 16px auto;">
                <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(244, 63, 94, 0.15); border: 2px solid #f43f5e;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 32px;"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2">Gagal Menyimpan!</h4>
                    <p class="text-muted mb-4" style="font-size: 13.5px; line-height: 1.5;">@TempData["ErrorMessage"]</p>
                    <button type="button" class="btn btn-outline-danger w-100 py-2.5 font-weight-bold shadow-sm" style="border-radius: 14px;" data-bs-dismiss="modal">
                        Tutup &amp; Periksa Kembali
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Client Validation Popup Modal (Desktop & Mobile) -->
    <div class="modal fade" id="clientAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px; margin: 16px auto;">
            <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 22px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(245, 158, 11, 0.15); border: 2px solid #f59e0b;">
                    <i class="bi bi-exclamation-circle-fill" style="color: #f59e0b; font-size: 28px;"></i>
                </div>
                <h5 class="text-white font-weight-bold mb-2" id="clientAlertTitle">Perhatian</h5>
                <p class="text-muted mb-4" id="clientAlertMsg" style="font-size: 13px;"></p>
                <button type="button" class="btn btn-warning w-100 py-2 font-weight-bold shadow-sm" style="border-radius: 12px; color: #000;" data-bs-dismiss="modal">
                    Mengerti &amp; Lengkapi
                </button>
            </div>
        </div>
    </div>

    <!-- Delete Confirm Popup Modal (Desktop & Mobile) -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px; margin: 16px auto;">
            <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 22px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(244, 63, 94, 0.15); border: 2px solid #f43f5e;">
                    <i class="bi bi-trash3-fill text-danger" style="font-size: 28px;"></i>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Hapus Laporan?</h5>
                <p class="text-muted mb-4" style="font-size: 13px;">Data laporan inspeksi jalan ini akan dihapus dari sistem. Tindakan ini tidak dapat dibatalkan.</p>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill py-2" data-bs-dismiss="modal" style="border-radius: 12px;">Batal</button>
                        <button type="submit" class="btn btn-danger flex-fill py-2 font-weight-bold" style="border-radius: 12px;">Ya, Hapus</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Top Summary Metrics Cards (30 Days) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #3b82f6;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Total Inspeksi Jalan</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: var(--text-main);">@totalReports</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(59, 130, 246, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-signpost-split-fill" style="color: #3b82f6; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">30 Hari Terakhir</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #06b6d4;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Rata-rata Skor RCI</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: @(avgScore >= 85 ? "#10b981" : (avgScore >= 70 ? "#f59e0b" : "#f43f5e"));">@avgScore%</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(6, 182, 212, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-speedometer2" style="color: #06b6d4; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Target Operasi: &gt;= 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #10b981;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Jalan Prima</div>
                        <h3 class="mb-0 mt-1 font-weight-bold text-success">@goodCount</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Skor Index &gt;= 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #f43f5e;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Perlu Grader / Perbaikan</div>
                        <h3 class="mb-0 mt-1 font-weight-bold text-danger">@(fairCount + poorCount)</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(244, 63, 94, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">@poorCount Rusak, @fairCount Perawatan</div>
            </div>
        </div>
    </div>

    <!-- Main Layout Grid: Form (Left) & Riwayat (Right) -->
    <div class="row g-4">
        <!-- FORM COLUMN -->
        <div class="col-lg-6">
            <div class="card-sap border-primary-accent" style="border-top: 4px solid #3b82f6;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-white font-weight-bold d-flex align-items-center gap-2" id="formTitle">
                        <i class="bi bi-pencil-square" style="color: #3b82f6;"></i>
                        <span>Form Penilaian RCI</span>
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelEdit" onclick="resetForm()">
                        <i class="bi bi-x-circle me-1"></i> Batal Edit
                    </button>
                </div>

                <form asp-action="Submit" method="post" id="rciForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="rciId" name="id" value="" />

                    <!-- Section 1: Basic Info -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="bi bi-info-circle me-1" style="color: #3b82f6;"></i> 1. Informasi Lokasi &amp; Ruas Jalan
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="tanggal">Tanggal</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-calendar-event-fill input-sap-icon"></i>
                                    <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="waktuStr">Waktu</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-clock-fill input-sap-icon"></i>
                                    <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="area">Area Utama</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-geo-alt-fill input-sap-icon"></i>
                                    <select id="area" name="area" class="input-sap" required>
                                        <option value="" disabled selected>Pilih Area Utama...</option>
                                        @if (areaList.Any())
                                        {
                                            foreach (var a in areaList)
                                            {
                                                <option value="@a">@a</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="Hauling Road">Hauling Road</option>
                                            <option value="Pit Access Road">Pit Access Road</option>
                                            <option value="Disposal Road">Disposal Road</option>
                                            <option value="ROM Access">ROM Access</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="namaJalan">Nama Jalan / Jalur Hauling</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-signpost-fill input-sap-icon"></i>
                                    <input type="text" id="namaJalan" name="namaJalan" class="input-sap text-uppercase" placeholder="Misal: Hauling KM 0 - KM 5, Ramp Barat" required />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="segmentJalan">Segment / Sta / KM</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-pin-map-fill input-sap-icon"></i>
                                    <input type="text" id="segmentJalan" name="segmentJalan" class="input-sap text-uppercase" placeholder="Misal: Sta 0+500 s/d 1+200, KM 2.5" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="shift">Shift</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-sun-fill input-sap-icon"></i>
                                    <select id="shift" name="shift" class="input-sap">
                                        <option value="Shift 1 (Siang)">Shift 1 (Siang)</option>
                                        <option value="Shift 2 (Malam)">Shift 2 (Malam)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" for="lokasi">Lokasi Spesifik &amp; Koordinat GPS</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-geo-fill input-sap-icon"></i>
                                <input type="text" id="lokasi" name="lokasi" class="input-sap" placeholder="Masukkan lokasi spesifik / Klik tombol GPS di kanan..." style="padding-right: 44px;" required />
                                <button type="button" class="btn btn-link p-0 position-absolute" id="btnGetLocation" style="right: 12px; top: 10px; color: #3b82f6;" onclick="getLocationRci()" title="Ambil Lokasi Aktual GPS">
                                    <i class="bi bi-crosshair" style="font-size: 18px;"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="detilLokasi">Detail Lokasi / Patok Pandu</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-compass-fill input-sap-icon"></i>
                                    <input type="text" id="detilLokasi" name="detilLokasi" class="input-sap" placeholder="Misal: Dekat Simpang 3, Pos Pantau" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap">GPS Lat / Long</label>
                                <div class="d-flex gap-1">
                                    <input type="text" id="latitude" name="latitude" class="input-sap" placeholder="Latitude" style="font-size: 11px;" readonly />
                                    <input type="text" id="longitude" name="longitude" class="input-sap" placeholder="Longitude" style="font-size: 11px;" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Assessment Parameters -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="text-white font-weight-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="bi bi-check2-square me-1" style="color: #3b82f6;"></i> 2. Penilaian 8 Parameter Jalan
                            </div>
                            <div class="badge px-3 py-1.5 shadow-sm" id="liveScoreBadge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); font-size: 13px; font-weight: 700;">
                                Skor RCI: <span id="liveScoreVal">100.0</span>% (Baik)
                            </div>
                        </div>

                        <!-- Param 1 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">1. Lebar Jalan Angkut (Road Width) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Standar &ge; 3.5x lebar unit terbesar (2 arah)</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorLebarJalan" data-val="100">100 - &ge; 3.5x Lebar Unit</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorLebarJalan" data-val="70">70 - Pas 3x Lebar Unit</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorLebarJalan" data-val="40">40 - Sempit / &lt; 3x</button>
                            </div>
                            <input type="hidden" id="skorLebarJalan" name="skorLebarJalan" value="100" />
                        </div>

                        <!-- Param 2 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">2. Kemiringan Jalan (Grade / Slope) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Grade maksimal aman 8% - 10%</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorGradeJalan" data-val="100">100 - Grade Standar (&le; 8%)</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorGradeJalan" data-val="70">70 - Agak Curam (8 - 10%)</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorGradeJalan" data-val="40">40 - Terlalu Curam (&gt; 10%)</button>
                            </div>
                            <input type="hidden" id="skorGradeJalan" name="skorGradeJalan" value="100" />
                        </div>

                        <!-- Param 3 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">3. Kondisi Permukaan Jalan (Surface) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Rata, tidak bergelombang (corrugation), bebas lubang/potholes</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorPermukaanJalan" data-val="100">100 - Mulus &amp; Padat</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorPermukaanJalan" data-val="70">70 - Bergelombang / Lubang Kecil</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorPermukaanJalan" data-val="40">40 - Lubang Dalam / Amblas</button>
                            </div>
                            <input type="hidden" id="skorPermukaanJalan" name="skorPermukaanJalan" value="100" />
                        </div>

                        <!-- Param 4 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">4. Tanggul Pengaman Jalan (Safety Berm) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Tinggi minimal 3/4 diameter ban unit terbesar, padat</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorSafetyBerm" data-val="100">100 - &ge; 3/4 Ban &amp; Kokoh</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorSafetyBerm" data-val="70">70 - Ada Bagian Rendah</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorSafetyBerm" data-val="40">40 - Terputus / Tidak Ada</button>
                            </div>
                            <input type="hidden" id="skorSafetyBerm" name="skorSafetyBerm" value="100" />
                        </div>

                        <!-- Param 5 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">5. Kemiringan Melintang &amp; Parit (Drainase) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 15%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Camber 2-3%, parit bersih dan air mengalir bebas</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorDrainaseParit" data-val="100">100 - Parit Bersih &amp; Kering</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorDrainaseParit" data-val="70">70 - Parit Tersumbat Sebagian</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorDrainaseParit" data-val="40">40 - Air Meluap ke Jalan</button>
                            </div>
                            <input type="hidden" id="skorDrainaseParit" name="skorDrainaseParit" value="100" />
                        </div>

                        <!-- Param 6 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">6. Superelevasi &amp; Tikungan (Curvature) <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Kemiringan tikungan memadai, jarak pandang luas</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorSuperelevasiTikungan" data-val="100">100 - Radius &amp; Miring Pas</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorSuperelevasiTikungan" data-val="70">70 - Agak Tajam / Pandang Terhalang</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorSuperelevasiTikungan" data-val="40">40 - Miring Terbalik / Rawan Terbalik</button>
                            </div>
                            <input type="hidden" id="skorSuperelevasiTikungan" name="skorSuperelevasiTikungan" value="100" />
                        </div>

                        <!-- Param 7 -->
                        <div class="mb-3 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">7. Bebas Batu Lepas / Spillage <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Bebas batu tajam / bongkahan yang merusak ban alat</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorBebasSpillage" data-val="100">100 - Bersih dari Batu</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorBebasSpillage" data-val="70">70 - Ada Kerikil / Spillage Sedikit</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorBebasSpillage" data-val="40">40 - Batu Tajam / Ceceran Banyak</button>
                            </div>
                            <input type="hidden" id="skorBebasSpillage" name="skorBebasSpillage" value="100" />
                        </div>

                        <!-- Param 8 -->
                        <div class="mb-2 p-2 rounded-2" style="background: rgba(0,0,0,0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">8. Rambu, Patok Pandu &amp; Debu <span class="badge bg-secondary" style="font-size: 9px;">Bobot 10%</span></label>
                                <small class="text-muted" style="font-size: 10px;">Delineator reflektif lengkap, penyiraman debu teratur</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-rci-score active flex-fill" data-param="skorRambuDebu" data-val="100">100 - Rambu Jelas &amp; Minim Debu</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorRambuDebu" data-val="70">70 - Berdebu Sedang / Perlu Water Truck</button>
                                <button type="button" class="btn btn-sm btn-rci-score flex-fill" data-param="skorRambuDebu" data-val="40">40 - Debu Tebal / Rambu Rusak</button>
                            </div>
                            <input type="hidden" id="skorRambuDebu" name="skorRambuDebu" value="100" />
                        </div>
                    </div>

                    <!-- Section 3: Notes, Photos & Actions -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="bi bi-camera me-1" style="color: #3b82f6;"></i> 3. Foto Dokumentasi &amp; Tindakan
                        </div>

                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" for="catatan">Catatan Observasi Kondisi Jalan</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-card-text input-sap-icon" style="top: 14px;"></i>
                                <textarea id="catatan" name="catatan" class="input-sap" rows="2" placeholder="Tuliskan temuan atau catatan kondisi aktual di jalan..."></textarea>
                            </div>
                        </div>

                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" for="tindakanPerbaikan">Rekomendasi Tindakan Perbaikan</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-tools input-sap-icon" style="top: 14px;"></i>
                                <textarea id="tindakanPerbaikan" name="tindakanPerbaikan" class="input-sap" rows="2" placeholder="Misal: Perlu motor grader meratakan jalan &amp; compactor memadatkan..."></textarea>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="pic">PIC Tindakan Perbaikan</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-person-fill input-sap-icon"></i>
                                    <input type="text" id="pic" name="pic" class="input-sap" placeholder="Misal: Road Maintenance / Foreman Grader" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="foto">Foto Kondisi Jalan</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-image-fill input-sap-icon"></i>
                                    <input type="file" id="foto" name="foto" class="input-sap" accept="image/*" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm font-weight-bold" style="height: 48px; border-radius: 12px; background: linear-gradient(135deg, #1e3a8a, #3b82f6); border: none;">
                            <i class="bi bi-save-fill me-2"></i> Simpan Penilaian RCI
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIWAYAT & FILTER COLUMN -->
        <div class="col-lg-6">
            <!-- Filter Bar -->
            <div class="card-sap mb-3 p-3">
                <form method="get" asp-action="Index">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label-sap" style="font-size: 11px;">Cari Lokasi / Jalan / NIK</label>
                            <input type="text" name="search" class="input-sap" value="@ViewBag.CurrentSearch" placeholder="Ketik kata kunci..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Filter Jalan</label>
                            <select name="namaJalan" class="input-sap">
                                <option value="">Semua Jalan</option>
                                @foreach (var j in jalanList)
                                {
                                    <option value="@j" selected="@(ViewBag.CurrentJalan == j ? "selected" : null)">@j</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Kategori Skor</label>
                            <select name="kategori" class="input-sap">
                                <option value="">Semua Skor</option>
                                <option value="Baik" selected="@(ViewBag.CurrentKategori == "Baik" ? "selected" : null)">Baik (&ge; 85%)</option>
                                <option value="Sedang" selected="@(ViewBag.CurrentKategori == "Sedang" ? "selected" : null)">Sedang (70 - 84%)</option>
                                <option value="Kurang" selected="@(ViewBag.CurrentKategori == "Kurang" ? "selected" : null)">Kurang (&lt; 70%)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm" style="height: 44px; border-radius: 10px; background: #3b82f6; border: none;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- List of Reports -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 text-white font-weight-bold" style="font-size: 13px;">
                    <i class="bi bi-clock-history me-1 text-primary"></i> Riwayat Inspeksi RCI (@Model.Count())
                </h6>
            </div>

            @if (!Model.Any())
            {
                <div class="card-sap p-5 text-center text-muted">
                    <i class="bi bi-inbox" style="font-size: 40px; color: var(--text-muted);"></i>
                    <p class="mt-2 mb-0" style="font-size: 13px;">Belum ada data inspeksi RCI pada periode ini.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3" style="max-height: 800px; overflow-y: auto; padding-right: 4px;">
                    @foreach (var item in Model)
                    {
                        var badgeBg = item.TotalScore >= 85 ? "rgba(16, 185, 129, 0.15)" : (item.TotalScore >= 70 ? "rgba(245, 158, 11, 0.15)" : "rgba(244, 63, 94, 0.15)");
                        var badgeColor = item.TotalScore >= 85 ? "#10b981" : (item.TotalScore >= 70 ? "#f59e0b" : "#f43f5e");
                        var borderAccent = item.TotalScore >= 85 ? "#10b981" : (item.TotalScore >= 70 ? "#f59e0b" : "#f43f5e");

                        <div class="card-sap p-3 position-relative animate-fade-in" style="border-left: 4px solid @borderAccent;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="mb-0 font-weight-bold text-white">@(item.NamaJalan ?? item.Lokasi)</h6>
                                        @if (!string.IsNullOrEmpty(item.SegmentJalan))
                                        {
                                            <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.SegmentJalan</span>
                                        }
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.Shift</span>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size: 11px;">
                                        <i class="bi bi-geo-alt me-1"></i> @item.Area | @item.Lokasi @(!string.IsNullOrEmpty(item.DetilLokasi) ? $"({item.DetilLokasi})" : "")
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge px-2 py-1" style="background: @badgeBg; color: @badgeColor; font-size: 13px; font-weight: 800; border-radius: 8px;">
                                        @item.TotalScore%
                                    </span>
                                    <div style="font-size: 10px; font-weight: 600; color: @badgeColor; margin-top: 2px;">@item.KategoriIndex</div>
                                </div>
                            </div>

                            <!-- Score Pills Summary -->
                            <div class="d-flex flex-wrap gap-1 mb-2 pt-1 border-top border-secondary border-opacity-25" style="font-size: 10.5px;">
                                <span class="badge bg-dark text-muted">Lebar: @item.SkorLebarJalan</span>
                                <span class="badge bg-dark text-muted">Grade: @item.SkorGradeJalan</span>
                                <span class="badge bg-dark text-muted">Surface: @item.SkorPermukaanJalan</span>
                                <span class="badge bg-dark text-muted">Berm: @item.SkorSafetyBerm</span>
                                <span class="badge bg-dark text-muted">Drainase: @item.SkorDrainaseParit</span>
                                <span class="badge bg-dark text-muted">Tikungan: @item.SkorSuperelevasiTikungan</span>
                                <span class="badge bg-dark text-muted">Spillage: @item.SkorBebasSpillage</span>
                                <span class="badge bg-dark text-muted">Rambu: @item.SkorRambuDebu</span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Catatan))
                            {
                                <div class="p-2 rounded mb-2" style="background: rgba(255,255,255,0.02); font-size: 11.5px; color: var(--text-main);">
                                    <i class="bi bi-chat-left-text me-1 text-muted"></i> @item.Catatan
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.TindakanPerbaikan))
                            {
                                <div class="p-2 rounded mb-2" style="background: rgba(245, 158, 11, 0.08); border-left: 2px solid #f59e0b; font-size: 11px; color: #f59e0b;">
                                    <strong><i class="bi bi-tools me-1"></i> Perbaikan:</strong> @item.TindakanPerbaikan @(!string.IsNullOrEmpty(item.Pic) ? $"(PIC: {item.Pic})" : "")
                                </div>
                            }

                            <!-- Footer Card: Inspector & Actions -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25" style="font-size: 11px; color: var(--text-muted);">
                                <div>
                                    <i class="bi bi-person me-1"></i> @item.Nama (@item.Nik) | @item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-info" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="showDetailRci(@item.Id)">
                                        <i class="bi bi-eye"></i> Detail
                                    </button>
                                    @if (item.Nik == userNik || MBS_SAP.Services.CompanyHierarchyService.IsAdminUser(User))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="editRci(@item.Id)">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="confirmDeleteRci(@item.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Detail RCI -->
<div class="modal fade" id="rciDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title text-white font-weight-bold" id="detailModalTitle"><i class="bi bi-signpost-split-fill text-primary me-2"></i>Detail Laporan RCI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailModalBody" style="font-size: 13px;">
                <!-- Loaded via JS -->
            </div>
        </div>
    </div>
</div>

<style>
    .btn-rci-score {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        font-size: 11px;
        padding: 5px 8px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }
    .btn-rci-score:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }
    .btn-rci-score.active[data-val="100"] {
        background: rgba(16, 185, 129, 0.25);
        color: #10b981;
        border-color: #10b981;
        font-weight: 700;
    }
    .btn-rci-score.active[data-val="70"] {
        background: rgba(245, 158, 11, 0.25);
        color: #f59e0b;
        border-color: #f59e0b;
        font-weight: 700;
    }
    .btn-rci-score.active[data-val="40"] {
        background: rgba(244, 63, 94, 0.25);
        color: #f43f5e;
        border-color: #f43f5e;
        font-weight: 700;
    }
</style>

@section Scripts {
<script>
    $(document).ready(function() {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            var sElem = document.getElementById('statusSuccessModal');
            if (sElem) { new bootstrap.Modal(sElem).show(); }
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            var eElem = document.getElementById('statusErrorModal');
            if (eElem) { new bootstrap.Modal(eElem).show(); }
            </text>
        }
    });

    function confirmDeleteRci(id) {
        $('#deleteForm').attr('action', '/Rci/Delete/' + id);
        var delModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        delModal.show();
    }

    $('#rciForm').on('submit', function(e) {
        const area = $('#area').val();
        const namaJalan = ($('#namaJalan').val() || '').trim();
        const lokasi = ($('#lokasi').val() || '').trim();

        if (!area || !namaJalan || !lokasi) {
            e.preventDefault();
            $('#clientAlertTitle').text('Data Belum Lengkap');
            $('#clientAlertMsg').text('Mohon lengkapi Area Utama, Nama Jalan / Jalur Hauling, dan Lokasi Spesifik sebelum menyimpan.');
            var alertModal = new bootstrap.Modal(document.getElementById('clientAlertModal'));
            alertModal.show();
            return false;
        }
    });

    // Live Score Calculator
    function calculateRciScore() {
        const p1 = parseInt($('#skorLebarJalan').val()) || 100;
        const p2 = parseInt($('#skorGradeJalan').val()) || 100;
        const p3 = parseInt($('#skorPermukaanJalan').val()) || 100;
        const p4 = parseInt($('#skorSafetyBerm').val()) || 100;
        const p5 = parseInt($('#skorDrainaseParit').val()) || 100;
        const p6 = parseInt($('#skorSuperelevasiTikungan').val()) || 100;
        const p7 = parseInt($('#skorBebasSpillage').val()) || 100;
        const p8 = parseInt($('#skorRambuDebu').val()) || 100;

        const total = (p1 * 0.15) + (p2 * 0.10) + (p3 * 0.15) + (p4 * 0.15) + (p5 * 0.15) + (p6 * 0.10) + (p7 * 0.10) + (p8 * 0.10);
        const rounded = total.toFixed(1);

        let label = "Baik";
        let color = "#10b981";
        let bg = "rgba(16, 185, 129, 0.2)";
        let border = "rgba(16, 185, 129, 0.4)";

        if (total < 70) {
            label = "Kurang";
            color = "#f43f5e";
            bg = "rgba(244, 63, 94, 0.2)";
            border = "rgba(244, 63, 94, 0.4)";
        } else if (total < 85) {
            label = "Sedang";
            color = "#f59e0b";
            bg = "rgba(245, 158, 11, 0.2)";
            border = "rgba(245, 158, 11, 0.4)";
        }

        $('#liveScoreVal').text(rounded);
        $('#liveScoreBadge').html(`Skor RCI: <span>${rounded}</span>% (${label})`);
        $('#liveScoreBadge').css({
            'background': bg,
            'color': color,
            'border-color': border
        });
    }

    // Button Score Selector
    $(document).on('click', '.btn-rci-score', function() {
        const param = $(this).data('param');
        const val = $(this).data('val');

        $(`.btn-rci-score[data-param="${param}"]`).removeClass('active');
        $(this).addClass('active');

        $(`#${param}`).val(val);
        calculateRciScore();
    });

    // Auto GPS Location
    function getLocationRci() {
        if (!navigator.geolocation) {
            $('#clientAlertTitle').text('GPS Tidak Didukung');
            $('#clientAlertMsg').text('Browser atau perangkat Anda tidak mendukung fitur Geolocation.');
            new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            return;
        }

        const btn = $('#btnGetLocation');
        btn.html('<span class="spinner-border spinner-border-sm" role="status"></span>');

        navigator.geolocation.getCurrentPosition(
            function(pos) {
                const lat = pos.coords.latitude.toFixed(6);
                const lng = pos.coords.longitude.toFixed(6);
                $('#latitude').val(lat);
                $('#longitude').val(lng);

                const currentLoc = $('#lokasi').val().trim();
                if (!currentLoc) {
                    $('#lokasi').val(`Koordinat: ${lat}, ${lng}`);
                } else if (!currentLoc.includes(lat)) {
                    $('#lokasi').val(`${currentLoc} (${lat}, ${lng})`);
                }

                btn.html('<i class="bi bi-check-circle-fill text-success" style="font-size: 18px;"></i>');
                setTimeout(() => {
                    btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                }, 2000);
            },
            function(err) {
                btn.html('<i class="bi bi-crosshair" style="font-size: 18px;"></i>');
                $('#clientAlertTitle').text('Gagal Mengambil GPS');
                $('#clientAlertMsg').text('Tidak dapat mendeteksi koordinat lokasi: ' + err.message + '. Silakan isi lokasi secara manual.');
                new bootstrap.Modal(document.getElementById('clientAlertModal')).show();
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    // Reset Form
    function resetForm() {
        $('#rciForm')[0].reset();
        $('#rciId').val('');
        $('#formTitle').html('<i class="bi bi-pencil-square" style="color: #3b82f6;"></i> <span>Form Penilaian RCI</span>');
        $('#btnCancelEdit').addClass('d-none');

        $('.btn-rci-score').removeClass('active');
        $('.btn-rci-score[data-val="100"]').addClass('active');
        $('input[id^="skor"]').val('100');
        calculateRciScore();
    }

    // Edit RCI
    function editRci(id) {
        $.getJSON('/Rci/GetDetail/' + id, function(data) {
            $('#rciId').val(data.id);
            $('#tanggal').val(data.tanggal);
            $('#waktuStr').val(data.waktu);
            $('#area').val(data.area);
            $('#namaJalan').val(data.namaJalan);
            $('#segmentJalan').val(data.segmentJalan);
            $('#shift').val(data.shift);
            $('#lokasi').val(data.lokasi);
            $('#detilLokasi').val(data.detilLokasi);
            $('#latitude').val(data.latitude);
            $('#longitude').val(data.longitude);
            $('#catatan').val(data.catatan);
            $('#tindakanPerbaikan').val(data.tindakanPerbaikan);
            $('#pic').val(data.pic);

            const params = ['skorLebarJalan', 'skorGradeJalan', 'skorPermukaanJalan', 'skorSafetyBerm',
                            'skorDrainaseParit', 'skorSuperelevasiTikungan', 'skorBebasSpillage', 'skorRambuDebu'];

            params.forEach(p => {
                const val = data[p];
                $(`#${p}`).val(val);
                $(`.btn-rci-score[data-param="${p}"]`).removeClass('active');
                $(`.btn-rci-score[data-param="${p}"][data-val="${val}"]`).addClass('active');
            });

            calculateRciScore();

            $('#formTitle').html(`<i class="bi bi-pencil-square text-warning"></i> <span>Edit Penilaian RCI #${data.id}</span>`);
            $('#btnCancelEdit').removeClass('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    // Show Detail Modal
    function showDetailRci(id) {
        $.getJSON('/Rci/GetDetail/' + id, function(d) {
            let html = `
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-white font-weight-bold mb-2">Informasi Ruas Jalan</h6>
                            <table class="table table-sm table-borderless text-white mb-0" style="font-size: 12px;">
                                <tr><td class="text-muted" style="width: 130px;">Nama Jalan</td><td>: <strong>${d.namaJalan || '-'}</strong></td></tr>
                                <tr><td class="text-muted">Segment / KM</td><td>: ${d.segmentJalan || '-'}</td></tr>
                                <tr><td class="text-muted">Area Utama</td><td>: ${d.area || '-'}</td></tr>
                                <tr><td class="text-muted">Lokasi</td><td>: ${d.lokasi || '-'}</td></tr>
                                <tr><td class="text-muted">Detail Patok</td><td>: ${d.detilLokasi || '-'}</td></tr>
                                <tr><td class="text-muted">Shift</td><td>: ${d.shift || '-'}</td></tr>
                                <tr><td class="text-muted">Waktu Inspeksi</td><td>: ${d.tanggal} ${d.waktu}</td></tr>
                                <tr><td class="text-muted">Inspector</td><td>: ${d.nama} (${d.nik})</td></tr>
                                <tr><td class="text-muted">Perusahaan</td><td>: ${d.perusahaan || '-'}</td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <div class="text-muted mb-1" style="font-size: 12px;">SKOR INDEKS KONDISI JALAN</div>
                            <h1 class="display-4 font-weight-bold mb-0" style="color: ${d.totalScore >= 85 ? '#10b981' : (d.totalScore >= 70 ? '#f59e0b' : '#f43f5e')};">${d.totalScore}%</h1>
                            <span class="badge px-3 py-1 mt-1" style="font-size: 12px; background: ${d.totalScore >= 85 ? 'rgba(16,185,129,0.2)' : (d.totalScore >= 70 ? 'rgba(245,158,11,0.2)' : 'rgba(244,63,94,0.2)')}; color: ${d.totalScore >= 85 ? '#10b981' : (d.totalScore >= 70 ? '#f59e0b' : '#f43f5e')};">
                                Kategori: ${d.kategoriIndex}
                            </span>
                        </div>
                    </div>
                </div>

                <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                    <h6 class="text-white font-weight-bold mb-2">Rincian Nilai 8 Parameter</h6>
                    <div class="row g-2" style="font-size: 12px;">
                        <div class="col-md-6">1. Lebar Jalan: <strong>${d.skorLebarJalan}</strong>/100</div>
                        <div class="col-md-6">2. Grade / Kemiringan: <strong>${d.skorGradeJalan}</strong>/100</div>
                        <div class="col-md-6">3. Permukaan Jalan: <strong>${d.skorPermukaanJalan}</strong>/100</div>
                        <div class="col-md-6">4. Tanggul Berm: <strong>${d.skorSafetyBerm}</strong>/100</div>
                        <div class="col-md-6">5. Drainase Parit: <strong>${d.skorDrainaseParit}</strong>/100</div>
                        <div class="col-md-6">6. Superelevasi: <strong>${d.skorSuperelevasiTikungan}</strong>/100</div>
                        <div class="col-md-6">7. Bebas Spillage: <strong>${d.skorBebasSpillage}</strong>/100</div>
                        <div class="col-md-6">8. Rambu & Debu: <strong>${d.skorRambuDebu}</strong>/100</div>
                    </div>
                </div>

                ${d.catatan ? `
                    <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color);">
                        <strong class="text-white">Catatan Observasi:</strong>
                        <p class="mb-0 text-muted mt-1">${d.catatan}</p>
                    </div>
                ` : ''}

                ${d.tindakanPerbaikan ? `
                    <div class="mt-3 p-3 rounded-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3);">
                        <strong style="color: #f59e0b;"><i class="bi bi-tools me-1"></i> Rekomendasi Perbaikan:</strong>
                        <p class="mb-0 mt-1" style="color: var(--text-main);">${d.tindakanPerbaikan}</p>
                        ${d.pic ? `<small class="text-muted d-block mt-1">PIC: <strong>${d.pic}</strong></small>` : ''}
                    </div>
                ` : ''}

                ${d.fotoUrl ? `
                    <div class="mt-3 p-3 rounded-3 text-center" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px;">Foto Dokumentasi:</div>
                        <img src="${d.fotoUrl}" class="img-fluid rounded-3 shadow-sm" style="max-height: 380px; object-fit: contain;" alt="Foto Jalan" />
                    </div>
                ` : ''}
            `;

            $('#detailModalBody').html(html);
            $('#rciDetailModal').modal('show');
        });
    }
</script>
}
