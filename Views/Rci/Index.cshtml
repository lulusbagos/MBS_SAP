    // Edit RCI
    function editRci(id) {
        $.getJSON('/Rci/GetDetail/' + id, function(data) {
            $('#rciId').val(data.id);
            $('#tanggal').val(data.tanggal);
            $('#waktuStr').val(data.waktu);
            $('#area').val(data.area);
            $('#areaSearch').val(data.area);
            $('#namaJalan').val(data.namaJalan);
            $('#segmentJalan').val(data.segmentJalan);
            $('#shift').val(data.shift);
            $('#lokasi').val(data.lokasi);
            $('#detilLokasi').val(data.detilLokasi);
            if (data.area) {
                loadBenchmarks(data.area, data.detilLokasi);
            } else {
                $('#benchmarkSearch').prop('disabled', true).val('Pilih Area Utama dulu...');
                $('#btnAddBenchmark').prop('disabled', true);
            }
            $('#latitude').val(data.latitude);
            $('#longitude').val(data.longitude);
            $('#catatan').val(data.catatan);
            $('#tindakanPerbaikan').val(data.tindakanPerbaikan);
            $('#pic').val(data.pic);

            $('#panjangSegment').val(data.panjangSegment || 100);

            rciParamsMetadata.forEach(m => {
                const defVal = data[`defisit${m.key}`] || 0;
                const scoreVal = data[`skor${m.key}`] || 4.0;
                $(`#defisit${m.key}`).val(defVal);
                $(`#skor${m.key}`).val(scoreVal);
                $(`.btn-score-card[data-param="skor${m.key}"]`).removeClass('active');
                $(`.btn-score-card[data-param="skor${m.key}"][data-val="${scoreVal}"], .btn-score-card[data-param="skor${m.key}"][data-val="${scoreVal.toFixed(1)}"]`).addClass('active');

                const totalP = parseFloat(data.panjangSegment) || 100;
                const pct = totalP > 0 ? Math.max(0, Math.min(100, ((totalP - defVal) / totalP) * 100)) : 100;
                $(`#badgePersen${m.key}`).text(`Ketercapaian: ${pct.toFixed(1)}% (Defisit: ${defVal}m)`);
            });

            calculateRciScore();

            $('#formTitle').html(`<i class="bi bi-pencil-square text-warning"></i> <span>Edit Penilaian RCI #${data.id}</span>`);
            $('#btnCancelEdit').removeClass('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    // Show Detail Modal
    function showDetailRci(id) {
        $.getJSON('/Rci/GetDetail/' + id, function(d) {
            const actual = d.actualRoadScore > 0 ? d.actualRoadScore : (d.totalScore > 4 ? (d.totalScore / 25.0).toFixed(2) : d.totalScore);
            const ach = d.achievement > 0 ? d.achievement : (actual / 4.0 * 100.0).toFixed(1);
            const isGood = ach >= 85;
            const isFair = ach >= 70 && ach < 85;

            const color = isGood ? '#10b981' : (isFair ? '#f59e0b' : '#f43f5e');

            let html = `
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-white font-weight-bold mb-2">Informasi Ruas Jalan</h6>
                            <table class="table table-sm table-borderless text-white mb-0" style="font-size: 12px;">
                                <tr><td class="text-muted" style="width: 130px;">Nama Jalan</td><td>: <strong>${d.namaJalan || '-'}</strong></td></tr>
                                <tr><td class="text-muted">Segment / KM</td><td>: ${d.segmentJalan || '-'}</td></tr>
                                <tr><td class="text-muted">Panjang Segmen</td><td>: <strong>${d.panjangSegment || 100} Meter</strong></td></tr>
                                <tr><td class="text-muted">Area Utama</td><td>: ${d.area || '-'}</td></tr>
                                <tr><td class="text-muted">Lokasi</td><td>: ${d.lokasi || '-'}</td></tr>
                                <tr><td class="text-muted">Detail Patok</td><td>: ${d.detilLokasi || '-'}</td></tr>
                                <tr><td class="text-muted">Shift</td><td>: ${d.shift || '-'}</td></tr>
                                <tr><td class="text-muted">Waktu Inspeksi</td><td>: ${d.tanggal} ${d.waktu}</td></tr>
                                <tr><td class="text-muted">Inspector</td><td>: ${d.nama} (${d.nik})</td></tr>
                                <tr><td class="text-muted">Perusahaan</td><td>: ${d.perusahaan || '-'}</td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                            <div class="text-muted mb-1" style="font-size: 12px;">SKOR INDEKS &amp; KETERCAPAIAN</div>
                            <h1 class="display-5 font-weight-bold mb-0" style="color: ${color};">${actual} / 4.00</h1>
                            <div class="h5 mb-1 font-weight-bold" style="color: ${color};">Pencapaian: ${ach}%</div>
                            <span class="badge px-3 py-1 mt-1" style="font-size: 12px; background: rgba(255,255,255,0.08); color: ${color};">
                                Kategori: ${d.kategoriIndex}
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 3 Pillars Table -->
                <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                    <h6 class="text-white font-weight-bold mb-2">Nilai 3 Pilar Utama (SP3 Excel)</h6>
                    <table class="table table-sm table-bordered text-center text-white mb-0" style="font-size: 11.5px;">
                        <thead style="background: rgba(255,255,255,0.08);">
                            <tr>
                                <th>Permukaan Jalan (60%)</th>
                                <th>Safety Berm (20%)</th>
                                <th>Drainage (20%)</th>
                                <th>TOTAL SCORE</th>
                            </tr>
                        </thead>
                        <tbody class="fw-bold">
                            <tr>
                                <td class="text-primary">${d.skorPermukaanGroup || '-'}</td>
                                <td class="text-success">${d.skorSafetyBermGroup || '-'}</td>
                                <td class="text-info">${d.skorDrainageGroup || '-'}</td>
                                <td style="color: ${color};">${actual} / 4.00</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- 8 Parameters Detail Table -->
                <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color);">
                    <h6 class="text-white font-weight-bold mb-2">Rincian 8 Parameter Jalan</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered text-white mb-0" style="font-size: 11.5px;">
                            <thead style="background: rgba(255,255,255,0.08);">
                                <tr>
                                    <th>Parameter</th>
                                    <th>Pilar</th>
                                    <th>Bobot</th>
                                    <th>Defisit (m)</th>
                                    <th>Skor (2.0 - 4.0)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>1. Surfacing and Material</td><td>Permukaan</td><td>20%</td><td>${d.defisitSurfacing || 0} m</td><td><span class="badge bg-primary">${d.skorSurfacing}</span></td></tr>
                                <tr><td>2. Undulation / Corrugation</td><td>Permukaan</td><td>35%</td><td>${d.defisitUndulation || 0} m</td><td><span class="badge bg-primary">${d.skorUndulation}</span></td></tr>
                                <tr><td>3. Spoil &amp; Lebar Efektif (18m)</td><td>Permukaan</td><td>5%</td><td>${d.defisitSpoil || 0} m</td><td><span class="badge bg-primary">${d.skorSpoil}</span></td></tr>
                                <tr><td>4. Safety Berm (3/4 Ban)</td><td>Safety Berm</td><td>10%</td><td>${d.defisitSafetyBerm || 0} m</td><td><span class="badge bg-success">${d.skorSafetyBerm}</span></td></tr>
                                <tr><td>5. Road Attachment</td><td>Safety Berm</td><td>5%</td><td>${d.defisitRoadAttachment || 0} m</td><td><span class="badge bg-success">${d.skorRoadAttachment}</span></td></tr>
                                <tr><td>6. Dust (Pengendalian Debu)</td><td>Safety Berm</td><td>5%</td><td>${d.defisitDust || 0} m</td><td><span class="badge bg-success">${d.skorDust}</span></td></tr>
                                <tr><td>7. Crossfall (0.5% - 1%)</td><td>Drainage</td><td>10%</td><td>${d.defisitCrossfall || 0} m</td><td><span class="badge bg-info text-dark">${d.skorCrossfall}</span></td></tr>
                                <tr><td>8. Drainage (Parit &amp; Aliran)</td><td>Drainage</td><td>10%</td><td>${d.defisitDrainage || 0} m</td><td><span class="badge bg-info text-dark">${d.skorDrainage}</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                ${d.catatan ? `
                    <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color);">
                        <strong class="text-white">Catatan Observasi:</strong>
                        <p class="mb-0 text-muted mt-1">${d.catatan}</p>
                    </div>
                ` : ''}

                ${d.tindakanPerbaikan ? `
                    <div class="mt-3 p-3 rounded-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3);">
                        <strong style="color: #f59e0b;"><i class="bi bi-tools me-1"></i> Rekomendasi Perbaikan:</strong>
                        <p class="mb-0 mt-1" style="color: var(--text-main);">${d.tindakanPerbaikan}</p>
                        ${d.pic ? `<small class="text-muted d-block mt-1">PIC: <strong>${d.pic}</strong></small>` : ''}
                    </div>
                ` : ''}

                ${d.fotoUrl ? `
                    <div class="mt-3 p-3 rounded-3 text-center" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px;">Foto Dokumentasi:</div>
                        <img src="${d.fotoUrl}" class="img-fluid rounded-3 shadow-sm" style="max-height: 380px; object-fit: contain;" alt="Foto Jalan" />
                    </div>
                ` : ''}

                <div class="mt-3 text-end">
                    <button type="button" class="btn btn-sm btn-success px-3 py-1.5" onclick="shareSavedRci(${d.id})" style="border-radius: 8px;">
                        <i class="bi bi-whatsapp me-1"></i> Bagikan Laporan ke WhatsApp
                    </button>
                </div>
            `;

            $('#detailModalBody').html(html);
            $('#rciDetailModal').modal('show');
        });
    }
</script>
}
