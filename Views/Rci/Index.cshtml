                                </div>
                                <div id="findingsList" class="text-white mt-1" style="font-size: 12px; line-height: 1.4;">
                                    <i class="bi bi-check2-circle text-success me-1"></i> Seluruh parameter segmen berada dalam kondisi optimal (100%).
                                </div>
                            </div>

                            <div class="p-2.5 rounded-3 mb-3" style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span style="color: #60a5fa; font-size: 11px; text-transform: uppercase; font-weight: 700;">
                                        <i class="bi bi-lightbulb-fill me-1 text-warning"></i> Rekomendasi Tindakan Otomatis:
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 10px; border-radius: 6px;" onclick="applyAutoRecommendationRci()">
                                        Salin ke Form
                                    </button>
                                </div>
                                <div id="autoRecText" class="text-white" style="font-size: 12px; font-style: italic;">
                                    Pertahankan pemeliharaan rutin jalan angkut.
                                </div>
                            </div>

                            <!-- Quick Action Buttons -->
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-success flex-fill py-2.5 d-flex align-items-center justify-content-center gap-1 font-weight-bold shadow-sm" style="background: #25D366; border: none; border-radius: 12px; color: white;" onclick="shareRciToWhatsApp()">
                                    <i class="bi bi-whatsapp" style="font-size: 15px;"></i>
                                    <span>Bagikan ke WhatsApp</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info flex-fill py-2.5 d-flex align-items-center justify-content-center gap-1 font-weight-bold" style="border-radius: 12px;" onclick="shareRciNative()">
                                    <i class="bi bi-share"></i>
                                    <span>Share System</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-2.5 px-3 d-flex align-items-center justify-content-center gap-1" style="border-radius: 12px;" onclick="copyRciSummaryToClipboard()" title="Salin Ringkasan">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Dokumentasi Foto & Tindakan Perbaikan -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
