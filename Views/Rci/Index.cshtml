                                    <i class="bi bi-shield-fill-check" id="feasibilityIcon" style="font-size: 24px;"></i>
                                    <div>
                                        <strong id="feasibilityTitle" style="font-size: 13px;">STATUS: LAYAK OPERASIONAL (OPTIMAL)</strong>
                                        <div id="feasibilityDesc" class="mt-0.5" style="font-size: 11.5px; opacity: 0.9;">Seluruh 8 parameter memenuhi standar teknis jalan hauling tambang. Kondisi prima dan aman.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Deficit Breakdown & Action Auto-Recommendation -->
                            <div class="p-2.5 rounded-3 mb-3" style="background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.05);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted" style="font-size: 11px; text-transform: uppercase; font-weight: 700;">
                                        <i class="bi bi-list-check me-1 text-primary"></i> Temuan Defisit Segmen:
                                    </span>
