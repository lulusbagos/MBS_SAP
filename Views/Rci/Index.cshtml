@model IEnumerable<MBS_SAP.Models.RciReport>
@{
    ViewData["Title"] = "Road Condition Index (RCI) - SAP";
    var userNik = ViewBag.UserNik as string ?? "";
    var userNama = ViewBag.UserNama as string ?? "";
    var userDept = ViewBag.UserDept as string ?? "";
    var userCompany = ViewBag.UserCompany as string ?? "PT MEGA GLOBAL ENERGY";
    var areaList = ViewBag.AreaList as List<string> ?? new List<string>();
    var jalanList = ViewBag.JalanList as List<string> ?? new List<string>();
    var totalReports = ViewBag.TotalReports as int? ?? 0;
    var avgScore = ViewBag.AvgScore as double? ?? 100.0;
    var goodCount = ViewBag.GoodCount as int? ?? 0;
    var fairCount = ViewBag.FairCount as int? ?? 0;
    var poorCount = ViewBag.PoorCount as int? ?? 0;
}

<div class="animate-fade-in">
    <!-- Header Screen Title -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="screen-title d-flex align-items-center gap-2">
                <i class="bi bi-cone-striped text-primary" style="color: #3b82f6;"></i>
                <span>Road Condition Index (RCI)</span>
                <span class="badge" style="background: linear-gradient(135deg, #ef4444, #f43f5e); color: white; font-size: 10px; font-weight: 800; padding: 2.5px 7px; border-radius: 6px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(244, 63, 94, 0.4); display: inline-flex; align-items: center; gap: 2px;">
                    <i class="bi bi-stars" style="font-size: 9px;"></i> NEW
                </span>
                <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); font-size: 11px; padding: 4px 10px; border-radius: 8px;">Road Assessment</span>
            </div>
            <p class="screen-subtitle mb-0">Inspeksi & Penilaian Standar Kualitas Jalan Hauling & Tambang.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 shadow-sm" style="border-radius: 10px; padding: 8px 14px; font-weight: 600;">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Export Excel</span>
            </a>
        </div>
    </div>

    <!-- Status Feedback Popup Modal (Desktop & Mobile) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="modal fade" id="statusSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 16px auto;">
                <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); border: 2px solid #10b981;">
                        <i class="bi bi-check-lg text-success" style="font-size: 38px;"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2">Berhasil Disimpan!</h4>
                    <p class="text-muted mb-4" style="font-size: 13.5px; line-height: 1.5;">@TempData["SuccessMessage"]</p>
                    <button type="button" class="btn btn-primary w-100 py-2.5 font-weight-bold shadow-sm" style="background: linear-gradient(135deg, #1d4ed8, #3b82f6); border: none; border-radius: 14px;" data-bs-dismiss="modal">
                        <i class="bi bi-check2-circle me-1"></i> Selesai
                    </button>
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="modal fade" id="statusErrorModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 16px auto;">
                <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(244, 63, 94, 0.15); border: 2px solid #f43f5e;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 32px;"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2">Gagal Menyimpan!</h4>
                    <p class="text-muted mb-4" style="font-size: 13.5px; line-height: 1.5;">@TempData["ErrorMessage"]</p>
                    <button type="button" class="btn btn-outline-danger w-100 py-2.5 font-weight-bold shadow-sm" style="border-radius: 14px;" data-bs-dismiss="modal">
                        Tutup &amp; Periksa Kembali
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Client Validation Popup Modal (Desktop & Mobile) -->
    <div class="modal fade" id="clientAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px; margin: 16px auto;">
            <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 22px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(245, 158, 11, 0.15); border: 2px solid #f59e0b;">
                    <i class="bi bi-exclamation-circle-fill" style="color: #f59e0b; font-size: 28px;"></i>
                </div>
                <h5 class="text-white font-weight-bold mb-2" id="clientAlertTitle">Perhatian</h5>
                <p class="text-muted mb-4" id="clientAlertMsg" style="font-size: 13px;"></p>
                <button type="button" class="btn btn-warning w-100 py-2 font-weight-bold shadow-sm" style="border-radius: 12px; color: #000;" data-bs-dismiss="modal">
                    Mengerti &amp; Lengkapi
                </button>
            </div>
        </div>
    </div>

    <!-- Delete Confirm Popup Modal (Desktop & Mobile) -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px; margin: 16px auto;">
            <div class="modal-content text-center p-4" style="background: var(--bg-card); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 22px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                <div class="mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(244, 63, 94, 0.15); border: 2px solid #f43f5e;">
                    <i class="bi bi-trash3-fill text-danger" style="font-size: 28px;"></i>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Hapus Laporan?</h5>
                <p class="text-muted mb-4" style="font-size: 13px;">Data laporan inspeksi jalan ini akan dihapus dari sistem. Tindakan ini tidak dapat dibatalkan.</p>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill py-2" data-bs-dismiss="modal" style="border-radius: 12px;">Batal</button>
                        <button type="submit" class="btn btn-danger flex-fill py-2 font-weight-bold" style="border-radius: 12px;">Ya, Hapus</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Top Summary Metrics Cards (30 Days) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #3b82f6;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Total Inspeksi Jalan</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: var(--text-main);">@totalReports</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(59, 130, 246, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-signpost-split-fill" style="color: #3b82f6; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">30 Hari Terakhir</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #06b6d4;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Rata-rata Skor RCI</div>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color: @(avgScore >= 85 ? "#10b981" : (avgScore >= 70 ? "#f59e0b" : "#f43f5e"));">@avgScore%</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(6, 182, 212, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-speedometer2" style="color: #06b6d4; font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Target Operasi: &gt;= 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #10b981;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Jalan Prima</div>
                        <h3 class="mb-0 mt-1 font-weight-bold text-success">@goodCount</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">Skor Index &gt;= 85%</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-sap p-3 h-100" style="border-left: 4px solid #f43f5e;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Perlu Grader / Perbaikan</div>
                        <h3 class="mb-0 mt-1 font-weight-bold text-danger">@(fairCount + poorCount)</h3>
                    </div>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: rgba(244, 63, 94, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 20px;"></i>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 11px;">@poorCount Rusak, @fairCount Perawatan</div>
            </div>
        </div>
    </div>

    <!-- Main Layout Grid: Form (Left) & Riwayat (Right) -->
    <div class="row g-4">
        <!-- FORM COLUMN -->
        <div class="col-lg-6">
            <div class="card-sap border-primary-accent" style="border-top: 4px solid #3b82f6;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-white font-weight-bold d-flex align-items-center gap-2" id="formTitle">
                        <i class="bi bi-pencil-square" style="color: #3b82f6;"></i>
                        <span>Form Penilaian RCI</span>
                        <span class="badge" style="background: linear-gradient(135deg, #ef4444, #f43f5e); color: white; font-size: 9.5px; font-weight: 800; padding: 2.5px 7px; border-radius: 6px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(244, 63, 94, 0.4); display: inline-flex; align-items: center; gap: 2px;">
                            <i class="bi bi-stars" style="font-size: 9px;"></i> NEW
                        </span>
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelEdit" onclick="resetForm()">
                        <i class="bi bi-x-circle me-1"></i> Batal Edit
                    </button>
                </div>

                <form asp-action="Submit" method="post" id="rciForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="rciId" name="id" value="" />

                    <!-- Section 1: Basic Info -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="text-white mb-2 font-weight-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="bi bi-info-circle me-1" style="color: #3b82f6;"></i> 1. Informasi Lokasi &amp; Ruas Jalan
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="tanggal">Tanggal</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-calendar-event-fill input-sap-icon"></i>
                                    <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="waktuStr">Waktu</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-clock-fill input-sap-icon"></i>
                                    <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="area">Area Utama</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-geo-alt-fill input-sap-icon"></i>
                                    <select id="area" name="area" class="input-sap" required>
                                        <option value="" disabled selected>Pilih Area Utama...</option>
                                        @if (areaList.Any())
                                        {
                                            foreach (var a in areaList)
                                            {
                                                <option value="@a">@a</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="Hauling Road">Hauling Road</option>
                                            <option value="Pit Access Road">Pit Access Road</option>
                                            <option value="Disposal Road">Disposal Road</option>
                                            <option value="ROM Access">ROM Access</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="namaJalan">Nama Jalan / Jalur Hauling</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-signpost-fill input-sap-icon"></i>
                                    <input type="text" id="namaJalan" name="namaJalan" class="input-sap text-uppercase" placeholder="Misal: Hauling KM 0 - KM 5, Ramp Barat" required />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="segmentJalan">Segment / Sta / KM</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-pin-map-fill input-sap-icon"></i>
                                    <input type="text" id="segmentJalan" name="segmentJalan" class="input-sap text-uppercase" placeholder="Misal: Sta 0+500 s/d 1+200, KM 2.5" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap">
                                <label class="form-label-sap" for="shift">Shift</label>
                                <div class="input-sap-wrapper">
                                    <i class="bi bi-sun-fill input-sap-icon"></i>
                                    <select id="shift" name="shift" class="input-sap">
                                        <option value="Shift 1 (Siang)">Shift 1 (Siang)</option>
                                        <option value="Shift 2 (Malam)">Shift 2 (Malam)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" for="lokasi">Lokasi Spesifik &amp; Koordinat GPS</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-geo-fill input-sap-icon"></i>
                                <input type="text" id="lokasi" name="lokasi" class="input-sap" placeholder="Masukkan lokasi spesifik / Klik tombol GPS di kanan..." style="padding-right: 44px;" required />
                                <button type="button" class="btn btn-link p-0 position-absolute" id="btnGetLocation" style="right: 12px; top: 10px; color: #3b82f6;" onclick="getLocationRci()" title="Ambil Lokasi Aktual GPS">
                                    <i class="bi bi-crosshair" style="font-size: 18px;"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="detilLokasi">Detail Lokasi / Patok Pandu</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-compass-fill input-sap-icon"></i>
                                    <input type="text" id="detilLokasi" name="detilLokasi" class="input-sap" placeholder="Misal: Dekat Simpang 3, Pos Pantau" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap">GPS Lat / Long</label>
                                <div class="d-flex gap-1">
                                    <input type="text" id="latitude" name="latitude" class="input-sap" placeholder="Latitude" style="font-size: 11px;" readonly />
                                    <input type="text" id="longitude" name="longitude" class="input-sap" placeholder="Longitude" style="font-size: 11px;" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Assessment Parameters -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="text-white font-weight-bold" style="font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="bi bi-cone-striped me-1" style="color: #3b82f6;"></i> 2. Penilaian 8 Parameter Jalan
                            </div>
                            <div class="badge px-3 py-1.5 shadow-sm" id="liveScoreBadge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); font-size: 13px; font-weight: 700; border-radius: 10px;">
                                Skor RCI: <span id="liveScoreVal">100.0</span>% (Baik)
                            </div>
                        </div>

                        <!-- Param 1 -->
                        <div class="param-box-premium">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="param-icon-badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                                        <i class="bi bi-arrows-expand"></i>
                                    </div>
                                    <div>
                                        <span class="param-header-title">1. Lebar Jalan Angkut (Road Width)</span>
                                        <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); font-size: 10px; margin-left: 6px;">Bobot 15%</span>
                                    </div>
                                </div>
                                <div class="param-guideline-badge">
                                    <i class="bi bi-info-circle me-1"></i> Standar &ge; 3.5x lebar unit terbesar (2 arah)
                                </div>
                            </div>
                            <div class="score-btn-grid">
                                <button type="button" class="btn-score-card active" data-param="skorLebarJalan" data-val="100">
                                    <span class="btn-score-pill">100</span>
                                    <span class="btn-score-text">&ge; 3.5x Lebar Unit</span>
                                    <i class="bi bi-check-circle-fill btn-score-icon"></i>
                                </button>
                                <button type="button" class="btn-score-card" data-param="skorLebarJalan" data-val="70">
                                    <span class="btn-score-pill">70</span>
                                    <span class="btn-score-text">Pas 3x Lebar Unit</span>
                                    <i class="bi bi-exclamation-circle-fill btn-score-icon"></i>
                                </button>
                                <button type="button" class="btn-score-card" data-param="skorLebarJalan" data-val="40">
                                    <span class="btn-score-pill">40</span>
                                    <span class="btn-score-text">Sempit (&lt; 3x)</span>
                                    <i class="bi bi-x-circle-fill btn-score-icon"></i>
                                </button>
                            </div>
                            <input type="hidden" id="skorLebarJalan" name="skorLebarJalan" value="100" />
                        </div>

                        <!-- Param 2 -->
                        <div class="param-box-premium">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="param-icon-badge" style="background: rgba(147, 51, 234, 0.15); color: #a855f7;">
                                        <i class="bi bi-graph-up-arrow"></i>
                                    </div>
                                    <div>
                                        <span class="param-header-title">2. Kemiringan Jalan (Grade / Slope)</span>
                                        <span class="badge" style="background: rgba(147, 51, 234, 0.15); color: #a855f7; border: 1px solid rgba(147, 51, 234, 0.3); font-size: 10px; margin-left: 6px;">Bobot 10%</span>
                                    </div>
                                </div>
                                <div class="param-guideline-badge">
                                    <i class="bi bi-info-circle me-1"></i> Grade maksimal aman 8% - 10%
                                </div>
                            </div>
                            <div class="score-btn-grid">
                                <button type="button" class="btn-score-card active" data-param="skorGradeJalan" data-val="100">
                                    <span class="btn-score-pill">100</span>
                                    <span class="btn-score-text">Standar (&le; 8%)</span>
                                    <i class="bi bi-check-circle-fill btn-score-icon"></i>
                                </button>
                                <button type="button" class="btn-score-card" data-param="skorGradeJalan" data-val="70">
                                    <span class="btn-score-pill">70</span>
                                    <span class="btn-score-text">Agak Curam (8 - 10%)</span>
                                    <i class="bi bi-exclamation-circle-fill btn-score-icon"></i>
                                </button>
                                <button type="button" class="btn-score-card" data-param="skorGradeJalan" data-val="40">
                                    <span class="btn-score-pill">40</span>
                                    <span class="btn-score-text">Terlalu Curam (&gt; 10%)</span>
                                    <i class="bi bi-x-circle-fill btn-score-icon"></i>
                                </button>
                            </div>
                            <input type="hidden" id="skorGradeJalan" name="skorGradeJalan" value="100" />
                        </div>

                        <!-- Param 3 -->
                        <div class="param-box-premium">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
