                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="pic">PIC Tindakan Perbaikan</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-person-fill input-sap-icon"></i>
                                    <input type="text" id="pic" name="pic" class="input-sap" placeholder="Misal: Road Maintenance / Foreman Grader" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group-sap mb-0">
                                <label class="form-label-sap" for="foto">Foto Kondisi Jalan</label>
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-image-fill input-sap-icon"></i>
                                    <input type="file" id="foto" name="foto" class="input-sap" accept="image/*" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm font-weight-bold" style="height: 48px; border-radius: 12px; background: linear-gradient(135deg, #1e3a8a, #3b82f6); border: none;">
                            <i class="bi bi-save-fill me-2"></i> Simpan Penilaian RCI
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIWAYAT & FILTER COLUMN (RIGHT) -->
        <div class="col-lg-6">
            <!-- Filter Bar -->
            <div class="card-sap mb-3 p-3">
                <form method="get" asp-action="Index">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label-sap" style="font-size: 11px;">Cari Lokasi / Jalan / NIK</label>
                            <input type="text" name="search" class="input-sap" value="@ViewBag.CurrentSearch" placeholder="Ketik kata kunci..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Filter Jalan</label>
                            <select name="namaJalan" class="input-sap">
                                <option value="">Semua Jalan</option>
                                @foreach (var j in jalanList)
                                {
                                    <option value="@j" selected="@(ViewBag.CurrentJalan == j ? "selected" : null)">@j</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sap" style="font-size: 11px;">Kategori Skor</label>
                            <select name="kategori" class="input-sap">
                                <option value="">Semua Skor</option>
                                <option value="Baik" selected="@(ViewBag.CurrentKategori == "Baik" ? "selected" : null)">Baik (&ge; 3.6 / &ge; 85%)</option>
                                <option value="Sedang" selected="@(ViewBag.CurrentKategori == "Sedang" ? "selected" : null)">Sedang (3.0 - 3.5)</option>
                                <option value="Kurang" selected="@(ViewBag.CurrentKategori == "Kurang" ? "selected" : null)">Kurang (&lt; 3.0)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm" style="height: 44px; border-radius: 10px; background: #3b82f6; border: none;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- List of Reports -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 text-white font-weight-bold" style="font-size: 13px;">
                    <i class="bi bi-clock-history me-1 text-primary"></i> Riwayat Inspeksi RCI (@Model.Count())
                </h6>
            </div>

            @if (!Model.Any())
            {
                <div class="card-sap p-5 text-center text-muted">
                    <i class="bi bi-inbox" style="font-size: 40px; color: var(--text-muted);"></i>
                    <p class="mt-2 mb-0" style="font-size: 13px;">Belum ada data inspeksi RCI pada periode ini.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3" style="max-height: 850px; overflow-y: auto; padding-right: 4px;">
                    @foreach (var item in Model)
                    {
                        var actual = item.ActualRoadScore > 0 ? item.ActualRoadScore : (item.TotalScore > 4 ? Math.Round(item.TotalScore / 25.0, 2) : item.TotalScore);
                        var ach = item.Achievement > 0 ? item.Achievement : (actual / 4.0 * 100.0);
                        var isGood = ach >= 85;
                        var isFair = ach >= 70 && ach < 85;

                        var badgeBg = isGood ? "rgba(16, 185, 129, 0.15)" : (isFair ? "rgba(245, 158, 11, 0.15)" : "rgba(244, 63, 94, 0.15)");
                        var badgeColor = isGood ? "#10b981" : (isFair ? "#f59e0b" : "#f43f5e");
                        var borderAccent = isGood ? "#10b981" : (isFair ? "#f59e0b" : "#f43f5e");

                        <div class="card-sap p-3 position-relative animate-fade-in" style="border-left: 4px solid @borderAccent;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="mb-0 font-weight-bold text-white">@(item.NamaJalan ?? item.Lokasi)</h6>
                                        @if (!string.IsNullOrEmpty(item.SegmentJalan))
                                        {
                                            <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.SegmentJalan</span>
                                        }
                                        <span class="badge" style="background: rgba(255,255,255,0.08); font-size: 10px; color: var(--text-muted);">@item.Shift</span>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size: 11px;">
                                        <i class="bi bi-geo-alt me-1"></i> @item.Area | @item.Lokasi @(!string.IsNullOrEmpty(item.DetilLokasi) ? $"({item.DetilLokasi})" : "")
                                        @if (item.PanjangSegment.HasValue && item.PanjangSegment.Value > 0)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size: 9.5px;">Segmen: @item.PanjangSegment.Value m</span>
                                        }
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge px-2.5 py-1" style="background: @badgeBg; color: @badgeColor; font-size: 13.5px; font-weight: 800; border-radius: 8px;">
                                        @actual.ToString("F2") / 4.00
                                    </span>
                                    <div style="font-size: 10px; font-weight: 600; color: @badgeColor; margin-top: 2px;">
                                        @ach.ToString("F1")% (@item.KategoriIndex)
                                    </div>
                                </div>
                            </div>

                            <!-- 3 Group Pillars Pills -->
                            <div class="d-flex flex-wrap gap-1 mb-2 pt-1 border-top border-secondary border-opacity-25" style="font-size: 10.5px;">
                                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25">Permukaan (60%): @(item.SkorPermukaanGroup > 0 ? item.SkorPermukaanGroup.ToString("F2") : "-")</span>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Safety Berm (20%): @(item.SkorSafetyBermGroup > 0 ? item.SkorSafetyBermGroup.ToString("F2") : "-")</span>
                                <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25">Drainage (20%): @(item.SkorDrainageGroup > 0 ? item.SkorDrainageGroup.ToString("F2") : "-")</span>
                            </div>

                            <!-- 8 Parameters Pills -->
                            <div class="d-flex flex-wrap gap-1 mb-2" style="font-size: 10px;">
                                <span class="badge bg-dark text-muted">Surfacing: @item.SkorSurfacing.ToString("0.#")</span>
                                <span class="badge bg-dark text-muted">Undulation: @item.SkorUndulation.ToString("0.#")</span>
                                <span class="badge bg-dark text-muted">Spoil: @item.SkorSpoil.ToString("0.#")</span>
                                <span class="badge bg-dark text-muted">Berm: @item.SkorSafetyBerm.ToString("0.#")</span>
                                <span class="badge bg-dark text-muted">Attachment: @item.SkorRoadAttachment.ToString("0.#")</span>
                                <span class="badge bg-dark text-muted">Dust: @item.SkorDust.ToString("0.#")</span>
                                <span class="badge bg-dark text-muted">Crossfall: @item.SkorCrossfall.ToString("0.#")</span>
                                <span class="badge bg-dark text-muted">Drainage: @item.SkorDrainage.ToString("0.#")</span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Catatan))
                            {
                                <div class="p-2 rounded mb-2" style="background: rgba(255,255,255,0.02); font-size: 11.5px; color: var(--text-main);">
                                    <i class="bi bi-chat-left-text me-1 text-muted"></i> @item.Catatan
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.TindakanPerbaikan))
                            {
                                <div class="p-2 rounded mb-2" style="background: rgba(245, 158, 11, 0.08); border-left: 2px solid #f59e0b; font-size: 11px; color: #f59e0b;">
                                    <strong><i class="bi bi-tools me-1"></i> Perbaikan:</strong> @item.TindakanPerbaikan @(!string.IsNullOrEmpty(item.Pic) ? $"(PIC: {item.Pic})" : "")
                                </div>
                            }

                            <!-- Footer Card: Inspector & Actions -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25" style="font-size: 11px; color: var(--text-muted);">
                                <div>
                                    <i class="bi bi-person me-1"></i> @item.Nama (@item.Nik) | @item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-info" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="showDetailRci(@item.Id)">
                                        <i class="bi bi-eye"></i> Detail
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-success" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="shareSavedRci(@item.Id)" title="Bagikan Laporan">
                                        <i class="bi bi-share"></i> Share
                                    </button>
                                    @if (item.Nik == userNik || MBS_SAP.Services.CompanyHierarchyService.IsAdminUser(User))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="editRci(@item.Id)">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" style="font-size: 11px; padding: 2px 8px; border-radius: 6px;" onclick="confirmDeleteRci(@item.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Detail RCI -->
<div class="modal fade" id="rciDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title text-white font-weight-bold" id="detailModalTitle"><i class="bi bi-signpost-split-fill text-primary me-2"></i>Detail Laporan RCI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailModalBody" style="font-size: 13px;">
                <!-- Loaded via JS -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Benchmark -->
<div class="modal fade" id="addBenchmarkModal" tabindex="-1" aria-labelledby="addBenchmarkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold" id="addBenchmarkModalLabel"><i class="bi bi-plus-square-fill text-primary me-2"></i>Tambah Benchmark Baru</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-4">
                <div class="alert alert-info py-2" style="font-size: 12px; border-radius: 8px;">
                    <i class="bi bi-info-circle me-1"></i> Benchmark yang Anda tambahkan hanya akan terlihat oleh karyawan di perusahaan Anda untuk area yang sedang dipilih.
                </div>
                <div class="form-group-sap mb-3">
                    <label class="form-label-sap">Area Utama</label>
                    <input type="text" id="newBenchmarkArea" class="form-control input-sap" disabled />
                </div>
                <div class="form-group-sap mb-3">
                    <label class="form-label-sap">Nama Benchmark / Detail Lokasi</label>
                    <input type="text" id="newBenchmarkName" class="form-control input-sap text-uppercase" placeholder="Misal: DEPAN POS SECURITY KM 3" />
                    <div id="addBenchmarkError" class="text-danger mt-2" style="font-size: 12px; display: none;"></div>
                </div>
                <div class="mt-3">
                    <h6 class="text-white fw-bold mb-2" style="font-size: 13px;"><i class="bi bi-list-task me-1 text-primary"></i>Daftar Benchmark Terdaftar (di area ini)</h6>
                    <div id="existingBenchmarksList" class="list-group" style="max-height: 180px; overflow-y: auto; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2);">
                        <div class="p-3 text-center text-muted" style="font-size: 12px;">Memuat daftar benchmark...</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">Tutup</button>
                <button type="button" class="btn btn-primary" id="btnSaveBenchmark" onclick="saveNewBenchmark()" style="border-radius: 8px; font-weight: 600;">Simpan Benchmark</button>
            </div>
        </div>
    </div>
</div>

