@model IEnumerable<MBS_SAP.Models.ActionPlan>
@{
    ViewData["Title"] = "Action Plan - SAP";
    var userNik = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var userName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
    var isAdmin = User.IsInRole("Admin");
}

<style>
    /* ─── Filter Bar ─────────────────────────────────────────────── */
    .ap-filter-bar {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 18px 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    .ap-filter-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .ap-filter-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--text-muted);
        white-space: nowrap;
        margin-right: 2px;
    }

    .ap-pill {
        padding: 6px 16px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
        border: 1.5px solid var(--border-color);
        background: transparent;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.18s ease;
        line-height: 1;
    }

    .ap-pill:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    .ap-pill.active {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: #fff;
        box-shadow: 0 2px 8px rgba(56, 189, 248, 0.35);
    }

    .ap-pill.active-green {
        background: #10b981;
        border-color: #10b981;
        color: #fff;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.35);
    }

    .ap-pill.active-red {
        background: #f43f5e;
        border-color: #f43f5e;
        color: #fff;
        box-shadow: 0 2px 8px rgba(244, 63, 94, 0.35);
    }

    .ap-divider {
        width: 1px;
        height: 28px;
        background: var(--border-color);
    }

    /* ─── Dialihkan Badge ─────────────────────────────────────────── */
    .reassigned-banner {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 12px;
        font-size: 11px;
        color: #f59e0b;
        line-height: 1.5;
    }

    .reassigned-banner i {
        font-size: 14px;
        margin-top: 1px;
        flex-shrink: 0;
    }

    /* ─── Card accent ─────────────────────────────────────────────── */
    .border-red-accent  { border-left: 3px solid var(--color-red)  !important; }
    .border-green-accent { border-left: 3px solid var(--color-green) !important; }
</style>

<div class="animate-fade-in pb-4">

    <!-- ── Header Banner ──────────────────────────────────────────── -->
    <div class="position-relative mb-4" style="margin: -20px -20px 20px -20px;">
        <div style="background: linear-gradient(135deg, #059669, #10b981); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; padding: 32px 20px 24px; text-align: center; position: relative; overflow: hidden;">
            <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: -30px; left: -10px; width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <i class="bi bi-calendar-check-fill text-white mb-2 d-block" style="font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
            <h4 style="font-weight: 800; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.2); margin-bottom: 4px; letter-spacing: 0.5px;">ACTION PLAN</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 12px; margin: 0; font-weight: 500;">Monitor dan tindak lanjuti temuan.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.15); color: var(--color-green); border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(244, 63, 94, 0.15); color: var(--color-red); border-radius: 12px;">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ── Modern Pill Filter Bar ─────────────────────────────────── -->
    <div class="ap-filter-bar flex-column align-items-stretch">
        <div class="d-flex flex-wrap align-items-center gap-3 justify-content-between w-100 mb-3 pb-3 border-bottom">
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
                <span class="ap-filter-label"><i class="bi bi-calendar3 me-1"></i>Periode Tanggal</span>
                <input type="date" name="startDate" class="form-control form-control-sm" style="width: auto; border-radius: 99px; font-size: 12px;" value="@ViewBag.StartDate" />
                <span class="text-muted" style="font-size: 12px;">s/d</span>
                <input type="date" name="endDate" class="form-control form-control-sm" style="width: auto; border-radius: 99px; font-size: 12px;" value="@ViewBag.EndDate" />
                <button type="submit" class="btn btn-sm btn-primary" style="border-radius: 99px; font-size: 11px; font-weight: 600; padding: 4px 12px;">Terapkan</button>
            </form>
            <div class="d-flex align-items-center gap-2">
                <span id="visibleCount" class="badge" style="background: rgba(56,189,248,0.15); color: var(--color-primary); font-size: 11px; font-weight: 700; padding: 5px 12px; border-radius: 99px; border: 1px solid rgba(56,189,248,0.25);">
                    @(Model?.Count() ?? 0) item
                </span>
                <a asp-controller="ActionPlan" asp-action="DownloadExcel" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-sm btn-outline-success" style="border-radius: 999px; font-weight: 700; font-size: 11px; padding: 4px 12px; display: flex; align-items: center; gap: 4px;">
                    <i class="bi bi-file-earmark-excel-fill"></i> Export Excel
                </a>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 w-100">
            <!-- Tipe -->
            <div class="ap-filter-group">
                <span class="ap-filter-label">Tipe</span>
                <button class="ap-pill active filter-type" data-type="all">Semua</button>
                <button class="ap-pill filter-type" data-type="hazard" data-active-class="active">Hazard</button>
                <button class="ap-pill filter-type" data-type="inspection" data-active-class="active">Inspeksi</button>
            </div>

            <div class="ap-divider d-none d-md-block"></div>

            <!-- Status -->
            <div class="ap-filter-group">
                <span class="ap-filter-label">Status</span>
                <button class="ap-pill filter-status" data-status="all">Semua</button>
                <button class="ap-pill active-red filter-status" data-status="open" data-active-class="active-red">Open</button>
                <button class="ap-pill filter-status" data-status="closed" data-active-class="active-green">Closed</button>
            </div>
            
            <div class="ap-divider d-none d-md-block"></div>

            <!-- Perusahaan -->
            <div class="ap-filter-group">
                <span class="ap-filter-label">Perusahaan</span>
                <select id="filterPerusahaan" class="form-select form-select-sm" style="width: auto; border-radius: 99px; font-size: 12px; font-weight: 600; padding: 4px 28px 4px 12px; border-color: var(--border-color); color: var(--text-muted); cursor: pointer;">
                    <option value="all">Semua Perusahaan</option>
                    @if (ViewBag.Perusahaans != null) {
                        foreach (var p in (IEnumerable<MBS_SAP.Models.PerusahaanView>)ViewBag.Perusahaans) {
                            <option value="@p.PerusahaanId">@p.NamaPerusahaan</option>
                        }
                    }
                </select>
            </div>
            
            <!-- Departemen -->
            <div class="ap-filter-group">
                <span class="ap-filter-label">Departemen</span>
                <select id="filterDepartemen" class="form-select form-select-sm" style="width: auto; border-radius: 99px; font-size: 12px; font-weight: 600; padding: 4px 28px 4px 12px; border-color: var(--border-color); color: var(--text-muted); cursor: pointer;">
                    <option value="all">Semua Departemen</option>
                    @if (ViewBag.Departemens != null) {
                        foreach (var d in (IEnumerable<string>)ViewBag.Departemens) {
                            <option value="@d">@d</option>
                        }
                    }
                </select>
            </div>
            
            <div class="ap-divider d-none d-md-block"></div>

            <!-- Kriteria Resiko -->
            <div class="ap-filter-group">
                <span class="ap-filter-label">Resiko</span>
                <select id="filterResiko" class="form-select form-select-sm" style="width: auto; border-radius: 99px; font-size: 12px; font-weight: 600; padding: 4px 28px 4px 12px; border-color: var(--border-color); color: var(--text-muted); cursor: pointer;">
                    <option value="all">Semua Resiko</option>
                    <option value="low">Low (Rendah)</option>
                    <option value="medium">Medium (Sedang)</option>
                    <option value="high">High (Tinggi)</option>
                    <option value="ekstrim">Ekstrim</option>
                </select>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card-sap text-center py-5 text-muted">
            <i class="bi bi-shield-fill-check d-block mb-3" style="font-size: 48px; color: var(--color-green);"></i>
            <h5>Semua Aman!</h5>
            <p class="mb-0">Tidak ada action plan temuan safety yang terbuka saat ini.</p>
        </div>
    }
    else
    {
        <div class="row action-plan-container">
            @foreach (var item in Model)
            {
                var isOpen = item.Status?.Equals("Open", StringComparison.OrdinalIgnoreCase) ?? true;
                var displayType = item.ItemSap;
                if (!string.IsNullOrEmpty(displayType) && displayType.Contains(":"))
                {
                    displayType = displayType.Split(':')[0];
                }
                var isReassigned = !string.IsNullOrEmpty(item.ReassignedFrom) && !string.IsNullOrEmpty(item.ReassignedTo);

                <div class="col-md-6 mb-4 action-plan-item"
                     data-type="@(displayType?.ToLower() ?? "hazard")"
                     data-status="@(isOpen ? "open" : "closed")"
                     data-perusahaan="@(item.PerusahaanId)"
                     data-departemen="@(item.Departemen)"
                     data-resiko="@(item.TingkatResiko?.ToLower() ?? "unknown")">
                    <div class="card-sap @(isOpen ? "border-red-accent" : "border-green-accent") h-100 d-flex flex-column justify-content-between" style="@(isOpen ? "box-shadow: 0 4px 15px rgba(244, 63, 94, 0.15);" : "")">
                        <div>
                            <!-- ── Card Header ── -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-secondary text-white" style="font-size: 10px; font-weight: 700; text-transform: uppercase;">
                                        @displayType
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.TingkatResiko))
                                    {
                                        var riskColor = item.TingkatResiko.ToLower() == "high" || item.TingkatResiko.ToLower() == "tinggi" || item.TingkatResiko.ToLower() == "ekstrim" ? "bg-danger" :
                                                        item.TingkatResiko.ToLower() == "medium" || item.TingkatResiko.ToLower() == "sedang" ? "bg-warning text-dark" : "bg-info";
                                        <span class="badge @riskColor ms-1" style="font-size: 10px; font-weight: 700; text-transform: uppercase;">
                                            @item.TingkatResiko
                                        </span>
                                    }
                                    <h6 class="text-white mt-1 mb-0" style="font-weight: 800; font-size: 16px;">
                                        @item.KategoriTemuan
                                    </h6>
                                </div>
                                <span class="status-badge @(isOpen ? "pending" : "approved")" style="@(isOpen ? "animation: pulse 2s infinite; border: 1px solid #f43f5e;" : "")">
                                    @(isOpen ? "PRIORITY - OPEN" : "Closed")
                                </span>
                            </div>

                            <!-- ── Location & Date ── -->
                            <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">
                                <i class="bi bi-geo-alt-fill me-1"></i>@(item.Lokasi ?? item.Area ?? "General")
                                &bull;
                                <i class="bi bi-calendar3 me-1"></i>@item.Tanggal.ToString("dd MMM yyyy")
                            </div>

                            <!-- ── Dialihkan Banner ── -->
                            @if (isReassigned)
                            {
                                <div class="reassigned-banner">
                                    <i class="bi bi-arrow-left-right"></i>
                                    <div>
                                        <strong>Laporan telah dialihkan</strong><br />
                                        Dari <strong>@item.ReassignedFrom</strong> → kepada <strong>@item.ReassignedTo</strong>
                                        @if (item.ReassignedAt.HasValue)
                                        {
                                            <span class="ms-1" style="opacity:.75;">(@item.ReassignedAt.Value.ToString("dd MMM yyyy, HH:mm"))</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- ── Temuan ── -->
                            <p style="font-size: 12px; color: var(--text-main); background-color: var(--bg-layout); padding: 10px; border-radius: 8px; margin-bottom: 14px; text-align: justify; line-height: 1.4; border-left: 3px solid var(--color-primary);">
                                <strong>Temuan:</strong> @item.DetilTemuan
                            </p>

                            <!-- ── Foto ── -->
                             @{
                                 var hasPhotos = !string.IsNullOrEmpty(item.FotoTemuan) || !string.IsNullOrEmpty(item.FotoPerbaikan);
                             }
                             @if (hasPhotos)
                             {
                                 var isAuthorized = item.Nik == userNik || item.NikPja == userNik;
                                 @if (isAuthorized)
                                 {
                                     <div class="row g-2 mb-3">
                                         @if (!string.IsNullOrEmpty(item.FotoTemuan))
                                         {
                                             var proxyFotoTemuan = item.FotoTemuan.StartsWith("http") ? "/ImageProxy/Get?url=" + Uri.EscapeDataString(item.FotoTemuan) : item.FotoTemuan;
                                             <div class="col-6">
                                                 <span class="d-block text-muted mb-1" style="font-size: 10px; font-weight: 600;">FOTO TEMUAN (BEFORE)</span>
                                                 <a href="@proxyFotoTemuan" target="_blank">
                                                     <img src="@proxyFotoTemuan" alt="Before" class="img-fluid rounded border" style="max-height: 100px; object-fit: cover; width: 100%;" />
                                                 </a>
                                             </div>
                                         }
                                         @if (!string.IsNullOrEmpty(item.FotoPerbaikan))
                                         {
                                             var proxyFotoPerbaikan = item.FotoPerbaikan.StartsWith("http") ? "/ImageProxy/Get?url=" + Uri.EscapeDataString(item.FotoPerbaikan) : item.FotoPerbaikan;
                                             <div class="col-6">
                                                 <span class="d-block text-muted mb-1" style="font-size: 10px; font-weight: 600;">FOTO PERBAIKAN (AFTER)</span>
                                                 <a href="@proxyFotoPerbaikan" target="_blank">
                                                     <img src="@proxyFotoPerbaikan" alt="After" class="img-fluid rounded border" style="max-height: 100px; object-fit: cover; width: 100%;" />
                                                 </a>
                                             </div>
                                         }
                                     </div>
                                 }
                                 else
                                 {
                                     <div class="px-2 py-1.5 d-flex align-items-center gap-1.5 mb-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; max-width: fit-content;">
                                         <i class="bi bi-shield-lock-fill text-warning" style="font-size: 13px;"></i>
                                         <span class="text-muted" style="font-size: 10px;">Foto dikunci</span>
                                     </div>
                                 }
                             }

                            <!-- ── PJA & PIC ── -->
                            <div class="mb-3" style="font-size: 11px; color: var(--text-muted); background-color: var(--bg-card-hover); padding: 10px 12px; border-radius: 8px;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-badge-fill me-1" style="color: var(--color-primary);"></i>
                                        <strong>PJA:</strong> @item.Pja (@item.NikPja) — @item.DepartemenPja
                                    </div>
                                    @if (isOpen)
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 m-0"
                                                style="font-size: 11px; color: var(--color-primary); text-decoration: none;"
                                                onclick="openReassignModal(@item.Id, 'ActionPlan')">
                                            <i class="bi bi-person-lines-fill me-1"></i>Alihkan
                                        </button>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.Pic))
                                {
                                    <div class="mt-1">
                                        <i class="bi bi-tools me-1" style="color: var(--color-green);"></i>
                                        <strong>PIC Perbaikan:</strong> @item.Pic (@item.NikPic) — @item.DepartemenPic
                                    </div>
                                }
                            </div>

                            @if (!isOpen)
                            {
                                <div class="alert border-0 px-3 py-2" role="alert"
                                     style="font-size: 11px; background-color: rgba(16, 185, 129, 0.1); color: var(--color-green); border-radius: 8px;">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    <strong>Perbaikan Selesai:</strong> @item.Perbaikan (@(item.TanggalPerbaikan?.ToString("dd MMM yyyy") ?? "-"))
                                </div>
                            }
                        </div>

                        <!-- ── Update Form ── -->
                        @if (isOpen)
                        {
                            <div class="mt-3">
                                <button class="btn w-100 py-2 btn-sm" style="background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3); font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s; border-radius: 8px;" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#updateForm-@item.Id" aria-expanded="false"
                                        onmouseover="this.style.background='#f43f5e'; this.style.color='#fff';"
                                        onmouseout="this.style.background='rgba(244, 63, 94, 0.1)'; this.style.color='#f43f5e';">
                                    <i class="bi bi-rocket-takeoff-fill me-1"></i> Take Up & Tindak Lanjut
                                </button>

                                <div class="collapse mt-3" id="updateForm-@item.Id">
                                    <div class="card-sap bg-dark-card border-0 p-3 mb-0">
                                        <form asp-controller="ActionPlan" asp-action="Update" method="post" enctype="multipart/form-data">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />

                                            <div class="row">
                                                <div class="col-md-6 form-group-sap">
                                                    <label class="form-label-sap" style="font-size: 11px;">Nama PIC Perbaikan</label>
                                                    <input type="text" name="pic" class="input-sap" style="height: 36px; font-size: 12px;" placeholder="Nama PIC" value="@(string.IsNullOrEmpty(item.Pic) ? userName : item.Pic)" required />
                                                </div>
                                                <div class="col-md-6 form-group-sap">
                                                    <label class="form-label-sap" style="font-size: 11px;">NIK PIC</label>
                                                    <input type="text" name="nikPic" class="input-sap" style="height: 36px; font-size: 12px;" placeholder="NIK PIC" value="@(string.IsNullOrEmpty(item.NikPic) ? userNik : item.NikPic)" required />
                                                </div>
                                            </div>

                                            <div class="form-group-sap">
                                                <label class="form-label-sap" style="font-size: 11px;">Departemen PIC</label>
                                                <input type="text" name="departemenPic" class="input-sap" style="height: 36px; font-size: 12px;" placeholder="Departemen PIC" required />
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 form-group-sap">
                                                    <label class="form-label-sap" style="font-size: 11px;">Rencana Perbaikan</label>
                                                    <input type="text" name="rencanaPerbaikan" class="input-sap" style="height: 36px; font-size: 12px;" placeholder="Rencana Tindakan" required />
                                                </div>
                                                <div class="col-md-6 form-group-sap">
                                                    <label class="form-label-sap" style="font-size: 11px;">Target Tanggal</label>
                                                    <input type="date" name="tanggalRencanaPerbaikan" class="input-sap" style="height: 36px; font-size: 12px;" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                                                </div>
                                            </div>

                                            <div class="form-group-sap">
                                                <label class="form-label-sap" style="font-size: 11px;">Tindakan Perbaikan Nyata</label>
                                                <textarea name="perbaikan" class="input-sap" rows="2" style="font-size: 12px;" placeholder="Apa perbaikan konkrit yang dikerjakan?" required></textarea>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 form-group-sap">
                                                    <label class="form-label-sap" style="font-size: 11px;">Tanggal Selesai</label>
                                                    <input type="date" name="tanggalPerbaikan" class="input-sap" style="height: 36px; font-size: 12px;" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                </div>
                                                <div class="col-md-6 form-group-sap">
                                                    <label class="form-label-sap" style="font-size: 11px;">Status</label>
                                                    <select name="status" class="input-sap" style="height: 36px; font-size: 12px;" required>
                                                        <option value="Closed" selected>Closed (Selesai)</option>
                                                        <option value="Open">Open (Masih Berjalan)</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group-sap">
                                                <label class="form-label-sap" style="font-size: 11px;">Foto Bukti Perbaikan (Opsional)</label>
                                                <input type="file" name="fotoPerbaikan" class="input-sap" style="height: auto; font-size: 12px; padding: 8px 12px;" accept="image/*" />
                                            </div>

                                            <button type="submit" class="btn btn-sap-primary w-100 py-2 btn-sm mt-2">
                                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Simpan Perubahan
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            let selectedType   = (urlParams.get('type') || 'all').toLowerCase();
            let selectedStatus = (urlParams.get('status') || 'open').toLowerCase();

            // Set initial active pill for status
            if (selectedStatus !== 'open') {
                $('.filter-status').removeClass('active active-green active-red');
                const $statusPill = $('.filter-status[data-status="' + selectedStatus + '"]');
                if ($statusPill.length) {
                    const cls = $statusPill.data('active-class') || 'active';
                    $statusPill.addClass(cls);
                }
            }

            // Set initial active pill for type if passed in URL
            if (selectedType !== 'all') {
                $('.filter-type').removeClass('active active-green active-red');
                const $typePill = $('.filter-type[data-type="' + selectedType + '"]');
                if ($typePill.length) {
                    $typePill.addClass('active');
                }
            }

            applyFilters();

            let selectedPerusahaan = 'all';
            let selectedDepartemen = 'all';
            let selectedResiko = 'all';

            $('#filterPerusahaan').on('change', function() {
                selectedPerusahaan = $(this).val();
                applyFilters();
            });

            $('#filterDepartemen').on('change', function() {
                selectedDepartemen = $(this).val();
                applyFilters();
            });

            $('#filterResiko').on('change', function() {
                selectedResiko = $(this).val();
                applyFilters();
            });

            function applyFilters() {
                let visible = 0;
                $('.action-plan-item').each(function () {
                    const t = $(this).attr('data-type') || '';
                    const s = $(this).attr('data-status') || '';
                    const p = $(this).attr('data-perusahaan') || '';
                    const d = $(this).attr('data-departemen') || '';
                    const r = $(this).attr('data-resiko') || '';

                    const matchT = (selectedType === 'all' || t === selectedType);
                    const matchS = (selectedStatus === 'all' || s === selectedStatus);
                    const matchP = (selectedPerusahaan === 'all' || p === selectedPerusahaan);
                    const matchD = (selectedDepartemen === 'all' || d === selectedDepartemen);
                    
                    let matchR = (selectedResiko === 'all');
                    if (!matchR) {
                        if (selectedResiko === 'low' && (r === 'low' || r === 'rendah')) matchR = true;
                        else if (selectedResiko === 'medium' && (r === 'medium' || r === 'sedang')) matchR = true;
                        else if (selectedResiko === 'high' && (r === 'high' || r === 'tinggi')) matchR = true;
                        else if (selectedResiko === 'ekstrim' && r === 'ekstrim') matchR = true;
                        else if (r === selectedResiko) matchR = true;
                    }

                    if (matchT && matchS && matchP && matchD && matchR) {
                        $(this).show();
                        visible++;
                    } else {
                        $(this).hide();
                    }
                });

                $('#visibleCount').text(visible + ' item');

                if (visible === 0) {
                    if ($('#empty-filter-state').length === 0) {
                        $('.action-plan-container').append(`
                            <div id="empty-filter-state" class="col-12 card-sap text-center py-5 text-muted">
                                <i class="bi bi-funnel d-block mb-3" style="font-size: 32px; color: var(--text-muted);"></i>
                                <p class="mb-0">Tidak ada action plan yang cocok dengan filter yang dipilih.</p>
                            </div>`);
                    } else {
                        $('#empty-filter-state').show();
                    }
                } else {
                    $('#empty-filter-state').hide();
                }
            }

            // Tipe filter
            $('.filter-type').on('click', function () {
                $('.filter-type').removeClass('active active-green active-red');
                $(this).addClass('active');
                selectedType = $(this).data('type');
                applyFilters();
            });

            // Status filter
            $('.filter-status').on('click', function () {
                $('.filter-status').removeClass('active active-green active-red');
                const cls = $(this).data('active-class') || 'active';
                $(this).addClass(cls);
                selectedStatus = $(this).data('status');
                applyFilters();
            });
        });
    </script>
}
