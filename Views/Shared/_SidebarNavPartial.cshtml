<!-- Interactive Sidebar Script -->
<script>
    (function () {
        // Auto-expand and activate group of the current page
        var activeItem = document.querySelector('.sidebar-menu .sub-menu-item.active, .sidebar-menu .menu-item-standalone.active');
        if (activeItem) {
            var parentCollapse = activeItem.closest('.menu-sub-collapse');
            if (parentCollapse) {
                parentCollapse.classList.add('show');
                var toggleBtn = document.querySelector('[data-bs-target="#' + parentCollapse.id + '"]');
                if (toggleBtn) {
                    toggleBtn.classList.remove('collapsed');
                    toggleBtn.classList.add('active-parent');
                    toggleBtn.setAttribute('aria-expanded', 'true');
                }
            }
        }

        // Live Search Filter
        var searchInput = document.getElementById('sidebarMenuSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var query = this.value.trim().toLowerCase();
                var sections = document.querySelectorAll('.sidebar-menu .menu-section');

                if (!query) {
                    // Reset to normal state
                    document.querySelectorAll('.sidebar-menu .menu-section, .sidebar-menu .menu-group, .sidebar-menu .sub-menu-item, .sidebar-menu .menu-item-standalone').forEach(function (el) {
                        el.style.display = '';
                    });
                    // Restore active collapse only
                    document.querySelectorAll('.sidebar-menu .menu-sub-collapse').forEach(function (c) {
                        if (c.querySelector('.sub-menu-item.active')) {
                            c.classList.add('show');
                        } else {
                            c.classList.remove('show');
                        }
                    });
                    document.querySelectorAll('.sidebar-menu .menu-group-toggle').forEach(function (btn) {
                        var targetId = btn.getAttribute('data-bs-target');
                        var target = document.querySelector(targetId);
                        if (target && target.classList.contains('show')) {
                            btn.classList.remove('collapsed');
                            btn.setAttribute('aria-expanded', 'true');
                        } else {
                            btn.classList.add('collapsed');
                            btn.setAttribute('aria-expanded', 'false');
                        }
                    });
                    return;
                }

                // Filter items
                sections.forEach(function (sec) {
                    var secHasMatch = false;

                    // Standalone links
                    var standalones = sec.querySelectorAll('.menu-item-standalone');
                    standalones.forEach(function (item) {
                        var text = item.textContent.toLowerCase();
                        if (text.indexOf(query) !== -1) {
                            item.style.display = 'flex';
                            secHasMatch = true;
                        } else {
                            item.style.display = 'none';
                        }
                    });

                    // Submenu groups
                    var groups = sec.querySelectorAll('.menu-group');
                    groups.forEach(function (grp) {
                        var grpHasMatch = false;
                        var subItems = grp.querySelectorAll('.sub-menu-item');
                        subItems.forEach(function (sub) {
                            var subText = sub.textContent.toLowerCase();
                            if (subText.indexOf(query) !== -1) {
                                sub.style.display = 'flex';
                                grpHasMatch = true;
                                secHasMatch = true;
                            } else {
                                sub.style.display = 'none';
                            }
                        });

                        var collapseEl = grp.querySelector('.menu-sub-collapse');
                        var toggleBtn = grp.querySelector('.menu-group-toggle');
                        if (grpHasMatch) {
                            grp.style.display = 'block';
                            if (collapseEl) collapseEl.classList.add('show');
                            if (toggleBtn) {
                                toggleBtn.classList.remove('collapsed');
                                toggleBtn.setAttribute('aria-expanded', 'true');
                            }
                        } else {
                            grp.style.display = 'none';
                        }
                    });

                    sec.style.display = secHasMatch ? 'block' : 'none';
                });
            });

            // Keyboard shortcut Ctrl+K or Cmd+K
            window.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                } else if (e.key === 'Escape' && document.activeElement === searchInput) {
                    searchInput.value = '';
                    searchInput.dispatchEvent(new Event('input'));
                    searchInput.blur();
                }
            });
        }
    })();
</script>
