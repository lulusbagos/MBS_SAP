@{
    var isAdminUser = MBS_SAP.Services.CompanyHierarchyService.IsAdminUser(User); 
    var userCompany = User.FindFirst("Company")?.Value;
    var isKPPUser = string.Equals(userCompany?.Trim(), "PT KALIMANTAN PRIMA PERSADA", StringComparison.OrdinalIgnoreCase);
    var canAccessUploadData = isAdminUser || isKPPUser;
    var jobTitle = User.FindFirst("JobTitle")?.Value ?? "";
    var department = User.FindFirst("Department")?.Value ?? "";
    var isSafetyAdmin = isAdminUser || 
                        jobTitle.Contains("Safety", StringComparison.OrdinalIgnoreCase) || 
                        jobTitle.Contains("HSE", StringComparison.OrdinalIgnoreCase) || 
                        jobTitle.Contains("OHS", StringComparison.OrdinalIgnoreCase) || 
                        jobTitle.Contains("SHE", StringComparison.OrdinalIgnoreCase) || 
                        department.Contains("Safety", StringComparison.OrdinalIgnoreCase) ||
                        department.Contains("HSE", StringComparison.OrdinalIgnoreCase) ||
                        department.Contains("OHS", StringComparison.OrdinalIgnoreCase) ||
                        department.Contains("SHE", StringComparison.OrdinalIgnoreCase);
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "";
    var userCompanyId = User.FindFirst("CompanyId")?.Value ?? "";

    // Count items for badges
    var kpiCount = 2 + (canAccessUploadData ? 1 : 0);
    var sheCount = 8;
    var ciCount = 5;
    var transportCount = 1 + (userCompanyId == "1" ? 1 : 0);
    var qrCount = 1 + (isAdminUser ? 2 : 0);
    var masterCount = (isAdminUser ? 2 : 0) + (isSafetyAdmin ? 3 : 0) + (canAccessUploadData ? 1 : 0);

    // Active state checkers for parent groups
    var isKpiActive = activeTab == "Performance" || activeTab == "League" || activeTab == "SapQuality";
    var isSheActive = activeTab == "Hazard" || activeTab == "Inspection" || activeTab == "BBS" || activeTab == "Observation" || activeTab == "ActionPlan" || activeTab == "SafetyTalk" || activeTab == "P5m" || activeTab == "Coaching";
    var isCiActive = activeTab == "Rci" || activeTab == "Fci" || activeTab == "Dci" || activeTab == "Spi" || activeTab == "Gci";
    var isTransportActive = activeTab == "P2h" || activeTab == "Dpa";
    var isQrActive = activeTab == "QrCode" || activeTab == "EventQrAdmin" || activeTab == "UserScanAdmin";
    var isIncidentActive = activeTab == "Incident";
    var isMasterActive = activeTab == "BbsMaster" || activeTab == "RosterSap" || activeTab == "SapTarget" || activeTab == "Admin" || activeTab == "UserMgmt" || activeTab == "ResetPassword";
}


