<div class="sidebar-footer">
    <a asp-controller="Account" asp-action="Profile"
       class="user-profile-sidebar text-decoration-none"
       title="Lihat Profil Saya"
       style="cursor: pointer; transition: opacity 0.2s; flex: 1;">
        <div class="user-avatar-mini" style="background: linear-gradient(135deg, #a855f7, #f43f5e);">
            <i class="bi bi-person-fill"></i>
        </div>
        <div class="user-info-sidebar">
            <span class="user-name">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Budi Santoso")</span>
            <span class="user-role" style="color: #a855f7;">@(User.FindFirst("JobTitle")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff/Operator")</span>
        </div>
    </a>
    <a asp-controller="Account" asp-action="Logout" class="btn-logout-sidebar" title="Log Out">
        <i class="bi bi-box-arrow-right"></i>
    </a>
</div>
