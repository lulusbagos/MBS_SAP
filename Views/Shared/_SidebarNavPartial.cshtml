    <div class="brand-card-info">
        <span class="brand-card-company">PT INDEXIM COALINDO</span>
        <span class="brand-card-app">SAFETY ACCOUNTABILITY</span>
        <span class="brand-card-sub"><span class="badge-dot"></span> HSE SYSTEM</span>
