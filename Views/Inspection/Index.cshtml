                    <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" id="btnShowFormBuilder" style="font-weight: 600; border-radius: 8px; font-size: 11px; padding: 6px 12px;" onclick="toggleFormBuilder(true)">
                        <i class="bi bi-plus-circle"></i> Tambah Pertanyaan
                    </button>

                    <!-- Dynamic Form Builder (hidden by default) -->
                    <div id="formBuilderBox" class="mt-3 p-3 border border-secondary rounded" style="display: none; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px dashed rgba(255,255,255,0.15) !important;">
                        <h6 class="text-white mb-3" style="font-size: 12px; font-weight: 700;" id="builderTitle">
                            <i class="bi bi-plus-square text-primary me-1"></i> Buat Pertanyaan Baru
                        </h6>
                        
                        <input type="hidden" id="editQuestionId" value="" />
                        
                        <div class="form-group-sap mb-2">
                            <label class="form-label-sap" style="font-size: 11px;">Pertanyaan / Checkpoint</label>
                            <input type="text" id="customQuestionText" class="form-control input-sap" placeholder="Misal: Apakah APD lengkap di area kerja?" style="font-size: 12px; height: 38px; border-radius: 8px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); color: white;" />
                        </div>

                        <div class="form-group-sap mb-3">
                            <label class="form-label-sap" style="font-size: 11px;">Tipe Jawaban</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-list-stars input-sap-icon"></i>
                                <select id="customAnswerType" class="input-sap" onchange="handleAnswerTypeChange()">
                                    <option value="text">Free Text / Isian</option>
                                    <option value="choice">Pilihan Ganda / Opsi</option>
                                </select>
                            </div>
                        </div>

                        <!-- Options Count Select Box (Only shown when choice is selected) -->
                        <div id="choiceOptionsCountWrapper" style="display: none;" class="form-group-sap mb-3">
                            <label class="form-label-sap" style="font-size: 11px;">Jumlah Pilihan / Opsi</label>
                            <div class="input-sap-wrapper">
                                <i class="bi bi-hash input-sap-icon"></i>
                                <select id="customOptionsCount" class="input-sap" onchange="handleOptionsCountChange()">
                                    <option value="2">2 Pilihan</option>
                                    <option value="3" selected>3 Pilihan</option>
                                    <option value="4">4 Pilihan</option>
                                    <option value="5">5 Pilihan</option>
                                </select>
                            </div>
                        </div>

                        <!-- Options Input Container (Only shown when choice is selected) -->
                        <div id="choiceOptionsWrapper" style="display: none;" class="mb-3">
                            <label class="form-label-sap mb-2" style="font-size: 11px;">
                                <span>Pilihan Jawaban</span>
                            </label>
                            <div id="optionsListContainer" class="d-flex flex-column gap-2">
                                <!-- Dynamic options text fields -->
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-primary flex-fill" style="border-radius: 8px; font-weight: 600;" onclick="saveCustomQuestion()">
                                <i class="bi bi-check-circle-fill me-1"></i>Simpan
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger flex-fill" style="border-radius: 8px; font-weight: 600;" onclick="toggleFormBuilder(false)">
                                <i class="bi bi-x-circle me-1"></i>Batal / Cancel
                            </button>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-sap-primary w-100 py-3">
                    <i class="bi bi-check-circle-fill me-2"></i> KIRIM LAPORAN INSPEKSI
                </button>
            </form>
        </div>

        <!-- History/List Column -->
        <div>
            <div class="history-header mb-3">
                <h6 class="text-white" style="font-weight: 700;"><i class="bi bi-list-task me-2" style="color: var(--color-primary);"></i>Log Inspeksi 7 Hari Terakhir</h6>
            </div>
            
            @if (Model == null || !Model.Any())
            {
                <div class="card-sap text-center py-4 text-muted">
                    <i class="bi bi-inbox-fill d-block mb-2" style="font-size: 32px;"></i>
                    Belum ada riwayat inspeksi tercatat.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var item in Model)
                    {
                        <div class="card-sap border-green-accent mb-0">
                            
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span style="font-weight: 700; font-size: 14px; color: var(--text-main);">@item.JenisInspeksi</span>
                                    <span class="d-block text-muted" style="font-size: 11px;"><i class="bi bi-geo-alt-fill me-1"></i>@(item.Lokasi ?? item.Area ?? "General")</span>
                                </div>
                                <span class="status-badge approved" style="font-size: 9px;">
                                    Selesai
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.DetilLokasi))
                            {
                                <p style="font-size: 11px; color: var(--text-muted); background-color: var(--bg-layout); padding: 8px; border-radius: 6px; margin: 8px 0 10px; border-left: 3px solid var(--color-primary);">
                                    <strong>Detil:</strong> @item.DetilLokasi
                                </p>
                            }

                            <div class="d-flex justify-content-between align-items-center pt-2 mt-2" style="border-top: 1px solid var(--border-color); font-size: 11px; color: var(--text-muted);">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="status-badge check"><i class="bi bi-check-circle-fill me-1"></i>Selesai</span>
                                    @if (item.Nik == userNik || isAdmin)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border: 1px solid var(--border-color); background: var(--bg-card); font-size: 13px;">
                                                <li><a class="dropdown-item text-white" href="javascript:void(0)" onclick="editInspection(@item.Id)"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Inspeksi</a></li>
                                                <li><a class="dropdown-item text-white" href="javascript:void(0)" onclick="openReassignModal(@item.Id, 'Inspection')"><i class="bi bi-person-lines-fill me-2 text-warning"></i>Alihkan PJA</a></li>
                                                <li><hr class="dropdown-divider border-secondary"></li>
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteInspection(@item.Id)"><i class="bi bi-trash-fill me-2"></i>Hapus Inspeksi</a></li>
                                            </ul>
                                        </div>
                                    }
                                </div>
                                <span><i class="bi bi-clock me-1"></i>@item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
    </div>
</div>

<!-- Modal Add Benchmark -->
