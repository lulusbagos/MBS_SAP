        function handleAnswerTypeChange() {
            const type = $('#customAnswerType').val();
            const wrapperCount = $('#choiceOptionsCountWrapper');
            const wrapperList = $('#choiceOptionsWrapper');
            if (type === 'choice') {
                wrapperCount.slideDown('fast');
                wrapperList.slideDown('fast');
                
                // Set default count to 3 options
                $('#customOptionsCount').val('3');
                handleOptionsCountChange(['YA', 'TIDAK', 'N/A']);
            } else {
                wrapperCount.slideUp('fast');
                wrapperList.slideUp('fast');
            }
        }

        function handleOptionsCountChange(initialValues = []) {
            const count = parseInt($('#customOptionsCount').val()) || 2;
            const container = $('#optionsListContainer');
            
            // Keep existing values if any, so we don't clear inputs when they change the select count
            const currentValues = [];
            $('#optionsListContainer .option-value').each(function() {
                currentValues.push($(this).val());
            });
            
            container.empty();
            
            for (let i = 0; i < count; i++) {
                let val = '';
                if (initialValues && initialValues[i] !== undefined) {
                    val = initialValues[i];
                } else if (currentValues && currentValues[i] !== undefined) {
                    val = currentValues[i];
                } else {
                    // Smart defaults
                    val = i === 0 ? 'YA' : (i === 1 ? 'TIDAK' : (i === 2 ? 'N/A' : ''));
                }
                
                const placeholder = `Opsi ${i + 1}...`;
                const rowHtml = `
                    <div class="form-group mb-2">
                        <label style="font-size: 10px; color: var(--text-muted); display: block; margin-bottom: 2px;">Opsi ${i + 1} <span class="text-danger">*</span></label>
                        <input type="text" class="form-control input-sap option-value" placeholder="${placeholder}" value="${val}" style="font-size: 11px; height: 34px; border-radius: 6px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); color: white;" />
                    </div>
                `;
                container.append(rowHtml);
            }
        }

        function saveCustomQuestion() {
            const questionText = $('#customQuestionText').val().trim();
            const answerType = $('#customAnswerType').val();
            const editId = $('#editQuestionId').val();

            if (!questionText) {
                alert('Teks pertanyaan wajib diisi.');
                return;
            }

            let choicesList = [];
            if (answerType === 'choice') {
                let hasEmptyOption = false;
                $('#optionsListContainer .option-value').each(function(i) {
                    const val = $(this).val().trim();
                    if (!val) {
                        hasEmptyOption = true;
                    }
                    choicesList.push(val);
                });
                
                if (hasEmptyOption) {
                    alert('Semua pilihan ganda / opsi wajib diisi.');
                    return;
                }
                
                if (choicesList.length === 0) {
                    alert('Pilihan ganda / opsi wajib dibuat.');
                    return;
                }
            }

            if (editId) {
                // Update
                const q = customQuestionsList.find(x => x.id === editId);
                if (q) {
                    q.question = questionText;
                    q.type = answerType;
                    q.choices = choicesList;
                    // Reset value if type changed or old value not in new choices
                    if (q.type === 'text') {
                        q.value = '';
                    } else if (!choicesList.includes(q.value)) {
                        q.value = choicesList[0];
                    }
                }
            } else {
                // Insert new
                customQuestionsList.push({
                    id: 'q_' + Date.now(),
                    question: questionText,
                    type: answerType,
                    choices: choicesList,
                    value: answerType === 'choice' ? choicesList[0] : ''
                });
            }

            toggleFormBuilder(false);
            renderCustomQuestions();
        }

        function deleteCustomQuestion(id) {
            if (confirm('Apakah Anda yakin ingin menghapus pertanyaan kustom ini?')) {
                customQuestionsList = customQuestionsList.filter(x => x.id !== id);
                renderCustomQuestions();
            }
        }

        function editCustomQuestion(id) {
            const q = customQuestionsList.find(x => x.id === id);
            if (!q) return;

            $('#editQuestionId').val(q.id);
            $('#customQuestionText').val(q.question);
            
            // Set answer type
            $('#customAnswerType').val(q.type);

            if (q.type === 'choice') {
                $('#choiceOptionsCountWrapper').show();
                $('#choiceOptionsWrapper').show();
                
                // Set options count select
                $('#customOptionsCount').val(q.choices.length);
                
                // Load options inputs
                handleOptionsCountChange(q.choices);
            } else {
                $('#choiceOptionsCountWrapper').hide();
                $('#choiceOptionsWrapper').hide();
            }

            $('#builderTitle').html('<i class="bi bi-pencil-square text-primary me-1"></i> Edit Pertanyaan');
            toggleFormBuilder(true);
        }

        function updateCustomAnswer(id, val) {
            const q = customQuestionsList.find(x => x.id === id);
            if (q) {
                q.value = val;
            }
        }

        function setCustomChoiceAnswer(id, val) {
            const q = customQuestionsList.find(x => x.id === id);
            if (q) {
                q.value = val;
                renderCustomQuestions();
            }
        }

        function renderCustomQuestions() {
            const container = $('#customQuestionsContainer');
            container.empty();

            if (customQuestionsList.length === 0) {
                container.html('<div class="text-muted text-center py-2" style="font-size: 11px; font-style: italic;">Belum ada pertanyaan kustom ditambahkan.</div>');
                return;
            }

            customQuestionsList.forEach((q, idx) => {
                let answerHtml = '';
                if (q.type === 'text') {
                    answerHtml = `
                        <input type="text" class="form-control input-sap custom-answer-input" placeholder="Tulis jawaban..." value="${q.value || ''}" oninput="updateCustomAnswer('${q.id}', this.value)" style="font-size: 12px; height: 38px; border-radius: 8px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); color: white;" />
                    `;
                } else if (q.type === 'choice') {
                    answerHtml = '<div class="d-flex gap-1 flex-wrap">';
                    q.choices.forEach(choice => {
                        const isActive = q.value === choice;
                        // Choose a themed look depending on choice name
                        let activeStyles = 'background: var(--color-primary); color: white; border-color: var(--color-primary);';
                        if (choice.toUpperCase() === 'YA') {
                            activeStyles = 'background: #10b981; color: white; border-color: #10b981;';
                        } else if (choice.toUpperCase() === 'TIDAK') {
                            activeStyles = 'background: #f43f5e; color: white; border-color: #f43f5e;';
                        } else if (choice.toUpperCase() === 'N/A') {
                            activeStyles = 'background: #64748b; color: white; border-color: #64748b;';
                        }
                        
                        const inlineStyle = isActive ? activeStyles : 'background: transparent; color: var(--text-muted); border: 1px solid var(--border-color);';
                        
                        answerHtml += `
                            <button type="button" class="btn btn-sm" onclick="setCustomChoiceAnswer('${q.id}', '${choice}')" style="font-size: 11px; font-weight: 600; padding: 6px 12px; border-radius: 8px; transition: all 0.2s ease; ${inlineStyle}">
                                ${choice}
                            </button>
                        `;
                    });
                    answerHtml += '</div>';
                }

                const html = `
                    <div class="checkpoint-card p-3" style="border-radius: 12px; background: rgba(255,255,255,0.01); border: 1px solid var(--border-color); margin-bottom: 4px;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="text-white fw-semibold" style="font-size: 12.5px;">${idx + 1}. ${q.question}</span>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-link p-0 text-primary" onclick="editCustomQuestion('${q.id}')" title="Edit Pertanyaan"><i class="bi bi-pencil" style="font-size: 12px;"></i></button>
                                <button type="button" class="btn btn-sm btn-link p-0 text-danger" onclick="deleteCustomQuestion('${q.id}')" title="Hapus Pertanyaan"><i class="bi bi-trash" style="font-size: 12px;"></i></button>
                            </div>
                        </div>
                        <div class="mt-2">
                            ${answerHtml}
                        </div>
                    </div>
                `;
                container.append(html);
            });
        }

        $(document).ready(function() {
            loadAreas();
            
            // Initialize custom questions empty display
            renderCustomQuestions();
            
            // Auto fetch GPS if creating new inspection
            if (!$('#inspectionId').val() && typeof getLocation === 'function') {
                getLocation();
            }

            // Prevent double submission & submit via AJAX with compression and progress bar
            $('#inspectionForm').on('submit', function(e) {
                e.preventDefault();

                var btn = $(this).find('button[type="submit"]');
                if (btn.prop('disabled')) {
                    return false;
                }

                // Custom validation
                let isValid = true;
                let firstInvalid = null;
                
                $('#inspectionForm').find('.is-invalid').removeClass('is-invalid');
                $('#inspectionForm').find('.sap-err-msg').remove();

                const fieldsToValidate = {
                    'tanggal': 'Tanggal',
                    'waktuStr': 'Waktu',
                    'area': 'Area Utama',
                    'lokasi': 'Lokasi Spesifik',
                    'penanggungJawabArea': 'Penanggung Jawab Area',
                    'tipeInspeksi': 'Tipe Inspeksi'
                };

                // Validate visible input/select/textarea
                $('#inspectionForm').find('input[required]:visible, select[required]:visible, textarea[required]:visible').each(function() {
                    const $el = $(this);
                    const id = $el.attr('id') || $el.attr('name');
                    const val = $el.val();
                    
                    if (!val || val.toString().trim() === '') {
                        isValid = false;
                        $el.addClass('is-invalid');
                        if (!firstInvalid) firstInvalid = $el;
                        
                        const labelName = fieldsToValidate[id] || $el.closest('.form-group-sap').find('label').text() || 'Field';
                        const errHtml = `<span class="text-danger sap-err-msg d-block mt-1"><i class="bi bi-exclamation-circle-fill me-1"></i>${labelName.replace(':', '').replace('*', '').trim()} wajib diisi.</span>`;
                        
                        const $wrapper = $el.closest('.input-sap-wrapper');
                        if ($wrapper.length) {
                            $wrapper.after(errHtml);
                        } else {
                            $el.after(errHtml);
                        }
                    }
                });

                // Validate PJA selection
                const pjaVal = $('#pja').val();
                if (!pjaVal || pjaVal.trim() === '') {
                    isValid = false;
                    $('#pjaSearchInput').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#pjaSearchInput');
                    
                    if ($('#pjaSearchInput').closest('.form-group-sap').find('.sap-err-msg').length === 0) {
                        $('#pjaSearchInput').after('<span class="text-danger sap-err-msg d-block mt-1"><i class="bi bi-exclamation-circle-fill me-1"></i>Penanggung Jawab Area (PJA) wajib dipilih dari pencarian.</span>');
                    }
                }

                if (!isValid) {
                    if (firstInvalid) {
                        $('html, body').animate({
                            scrollTop: firstInvalid.offset().top - 120
                        }, 300);
                    }
                    return false;
                }

                // Construct custom questions text
                if (customQuestionsList.length > 0) {
                    let originalCatatan = $('#catatan').val() || '';
                    const sepMarker = "--- PERTANYAAN TAMBAHAN ---";
                    const sepIdx = originalCatatan.indexOf(sepMarker);
                    if (sepIdx !== -1) {
                        originalCatatan = originalCatatan.substring(0, sepIdx).trim();
                    }
                    
                    let extraText = "\n\n--- PERTANYAAN TAMBAHAN ---";
                    customQuestionsList.forEach((q, index) => {
                        extraText += `\n${index + 1}. ${q.question}: ${q.value || 'Belum Diisi'}`;
                    });
                    extraText += `\n\n<!--CUSTOM_BUILDER_DATA:${JSON.stringify(customQuestionsList)}-->`;
                    
                    $('#catatan').val(originalCatatan + extraText);
                }

                btn.prop('disabled', true);
                var originalText = btn.html();
                btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>MENYIMPAN...');

                // Form submit via AJAX with upload progress and client-side compression
                const $overlay = $('#loadingOverlay');
                const $progressBar = $('#loadingProgressBar');
                const $progressPercent = $('#loadingProgressPercent');
                const $title = $('#loadingTitle');
                const $subtitle = $('#loadingSubtitle');

                $overlay.css('display', 'flex');
                $title.text('Menyiapkan Data...');
                $subtitle.text('Sedang memproses laporan inspeksi...');
                $progressBar.css('width', '0%');
                $progressPercent.text('0%');

                const rawFormData = new FormData($('#inspectionForm')[0]);
                const compressedFormData = new FormData();

                // Append all non-file fields to compressedFormData
                for (let [key, value] of rawFormData.entries()) {
                    if (!(value instanceof File)) {
                        compressedFormData.append(key, value);
                    }
                }

                // Collect all files to compress
                const filePromises = [];
                const filesToCompress = [];

                $('#inspectionForm').find('input[type="file"]').each(function() {
                    const name = $(this).attr('name');
                    const files = $(this)[0].files;
                    if (files && files.length > 0) {
                        for (let i = 0; i < files.length; i++) {
                            filesToCompress.push({ name: name, file: files[i] });
                        }
                    }
                });

                if (filesToCompress.length === 0) {
                    sendAjaxRequest(rawFormData);
                } else {
                    $title.text('Mengompresi Gambar...');
                    $subtitle.text('Mengompresi ' + filesToCompress.length + ' foto bukti agar unggah lebih cepat...');

                    filesToCompress.forEach(item => {
                        const promise = compressImage(item.file, 1024, 1024, 0.75)
                            .then(compressedFile => {
                                compressedFormData.append(item.name, compressedFile);
                            });
                        filePromises.push(promise);
                    });

                    Promise.all(filePromises).then(() => {
                        $title.text('Mengirim Data...');
                        $subtitle.text('Sedang mengunggah laporan dan lampiran...');
                        sendAjaxRequest(compressedFormData);
                    }).catch(err => {
                        console.error('Compression error:', err);
                        $title.text('Mengirim Data (Tanpa Kompresi)...');
                        sendAjaxRequest(rawFormData);
                    });
                }

                function sendAjaxRequest(formData) {
                    $.ajax({
                        url: $('#inspectionForm').attr('action'),
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        xhr: function() {
                            const xhr = new window.XMLHttpRequest();
                            xhr.upload.addEventListener('progress', function(evt) {
                                if (evt.lengthComputable) {
                                    const percentComplete = Math.round((evt.loaded / evt.total) * 100);
                                    $progressBar.css('width', percentComplete + '%');
                                    $progressPercent.text(percentComplete + '%');
                                    if (percentComplete === 100) {
                                        $title.text('Memproses di Server...');
                                        $subtitle.text('Mohon tunggu, server sedang menyimpan data...');
                                    }
                                }
                            }, false);
                            return xhr;
                        },
                        success: function(response) {
                            $title.text('Selesai!');
                            $subtitle.text('Laporan inspeksi berhasil disimpan.');
                            $progressBar.css('width', '100%');
                            $progressPercent.text('100%');
                            
                            setTimeout(() => {
                                window.location.href = '/Inspection/Index';
                            }, 500);
                        },
                        error: function(xhr, status, error) {
                            $overlay.css('display', 'none');
                            btn.prop('disabled', false).html(originalText);
                            
                            let errMessage = "Gagal mengirim data. Silakan periksa koneksi internet Anda.";
                            if (xhr.status === 400 || xhr.status === 500) {
                                errMessage = "Terjadi kesalahan di server. Silakan hubungi admin.";
                            }
                            
                            if (typeof showSapToast === 'function') {
                                showSapToast(errMessage, "danger");
                            } else if (typeof alert === 'function') {
                                alert(errMessage);
                            }
                        }
                    });
                }
            });

            $('#addBenchmarkModal').on('show.bs.modal', function () {
                var area = $('#area').val();
                if(!area) {
                    alert('Pilih Area Utama terlebih dahulu!');
                    return false; // Prevent modal from opening
                }
                $('#newBenchmarkArea').val(area);
                $('#newBenchmarkName').val('');
                $('#addBenchmarkError').hide();
                
                // Populate existing benchmarks in modal
                var list = $('#existingBenchmarksList');
                list.empty();
                if(globalBenchmarksList.length > 0) {
                    globalBenchmarksList.forEach(function(b) {
                        list.append('<div class="list-group-item" style="font-size: 13px; background: rgba(0,0,0,0.1); border-color: var(--border-color); color: var(--text-main);"><i class="bi bi-compass me-2 text-muted"></i>' + b.namaBenchmark + '</div>');
                    });
                } else {
                    list.append('<div class="p-3 text-center text-muted" style="font-size: 12px;">Belum ada benchmark di area ini</div>');
                }
            });

            // Toggle area dropdown on chevron click
            $('#toggleAreaDropdown').on('click', function() {
                var menu = $('#areaDropdownMenu');
                if (menu.is(':visible')) {
                    menu.hide();
                } else {
                    renderAreaDropdown($('#areaSearch').val());
                    menu.show();
                }
            });

            // Filter dropdown on keyup
            $('#areaSearch').on('input keyup', function() {
                renderAreaDropdown($(this).val());
            });

            // Open dropdown on focus
            $('#areaSearch').on('focus', function() {
                renderAreaDropdown($(this).val());
            });

            // Toggle benchmark dropdown on chevron click
            $('#toggleBenchmarkDropdown').on('click', function() {
                if ($('#benchmarkSearch').prop('disabled')) return;
                var menu = $('#benchmarkDropdownMenu');
                if (menu.is(':visible')) {
                    menu.hide();
                } else {
                    renderBenchmarkDropdown($('#benchmarkSearch').val());
                    menu.show();
                }
            });

            // Filter dropdown on keyup
            $('#benchmarkSearch').on('input keyup', function() {
                renderBenchmarkDropdown($(this).val());
                if($(this).val() === '') $('#detilLokasi').val('');
            });

            // Open dropdown on focus
            $('#benchmarkSearch').on('focus', function() {
                if ($('#benchmarkSearch').prop('disabled')) return;
                renderBenchmarkDropdown($(this).val());
            });

            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#benchmarkSearch, #benchmarkDropdownMenu, #toggleBenchmarkDropdown').length) {
                    $('#benchmarkDropdownMenu').hide();
                }
                if (!$(e.target).closest('#areaSearch, #areaDropdownMenu, #toggleAreaDropdown').length) {
                    $('#areaDropdownMenu').hide();
                }
            });
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('.form-group-sap').length) {
                $('#pjaSearchResults').hide();
            }
        });
    </script>
    <style>
        input[type="text"].input-sap, textarea.input-sap {
            text-transform: uppercase;
        }
    </style>
}






