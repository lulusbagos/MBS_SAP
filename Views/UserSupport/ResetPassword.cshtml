@{
    ViewData["Title"] = "Reset Password User";
    ViewData["HeaderTitle"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card bg-card border-0 shadow-sm rounded-4" style="max-width: 500px; margin: 0 auto; background-color: var(--bg-card);">
        <div class="card-body p-4">
            <h5 class="mb-3 text-white"><i class="bi bi-key-fill text-danger me-2"></i>Reset Password User</h5>
            <p class="text-muted small mb-4">Fitur ini digunakan untuk mengembalikan password user ke default (<strong>123456</strong>) dengan memasukkan NIK/NRP mereka.</p>

            @if (ViewData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert" style="border-radius: 12px; font-size: 13px;">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>
                        @ViewData["Error"]
                    </div>
                </div>
            }

            @if (ViewData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center" role="alert" style="border-radius: 12px; font-size: 13px;">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>
                        @ViewData["Success"]
                    </div>
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                <div class="form-group-sap mb-4">
                    <label class="form-label text-white-50" style="font-size: 12px;">NIK / NRP User</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-person input-sap-icon" style="color: #38bdf8;"></i>
                        <input type="text" name="nik" class="input-sap" placeholder="Ketik NIK atau NRP..." required autocomplete="off" />
                    </div>
                </div>
                
                <button type="submit" class="btn btn-sap-primary w-100 py-2 rounded-3 fw-bold" style="font-size: 14px;">
                    <i class="bi bi-arrow-clockwise me-2"></i>Reset Password
                </button>
            </form>
        </div>
    </div>
</div>
