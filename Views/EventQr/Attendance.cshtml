@model MBS_SAP.Controllers.EventQrAttendanceViewModel
@{
    Layout = null;
    ViewData["Title"] = "Display Kehadiran Event";
    var snapshotUrl = Url.Action("AttendanceSnapshot", "EventQr", new { id = Model.Event.Id }) ?? string.Empty;
    var companyRate = Model.TotalActiveCompanies > 0
        ? Math.Round((double)Model.TotalPresentCompanies / Model.TotalActiveCompanies * 100.0, 1)
        : 0.0;
    var qrUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/QrAttendance/Scan/{Model.Event.QrToken}";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@ViewData["Title"] - INDEXIM SAP</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        * { box-sizing: border-box; }
        
        :root {
            --bg-app: #030712;
            --bg-card: rgba(17, 24, 39, 0.75);
            --border-color: rgba(255, 255, 255, 0.06);
            --color-primary: #38bdf8;
            --color-green: #10b981;
            --color-red: #f43f5e;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --glow-primary: 0 0 25px rgba(56, 189, 248, 0.25);
            --glow-green: 0 0 25px rgba(16, 185, 129, 0.25);
            --glow-red: 0 0 25px rgba(244, 63, 94, 0.25);
        }

        body.kiosk-mode {
            cursor: none !important;
        }

        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
            background-color: var(--bg-app);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
        }

        .display-shell {
            min-height: 100vh;
            padding: 24px;
            background: transparent;
            display: flex;
            flex-direction: column;
            gap: 20px;
            position: relative;
        }

        /* Top Header */
        .dashboard-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 16px 24px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .brand-section {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo {
            width: 50px;
            height: 50px;
            object-fit: contain;
            background: #ffffff;
            border-radius: 12px;
            padding: 6px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }

        .brand-text {
            display: grid;
            gap: 2px;
        }

        .brand-subtitle {
            font-family: 'Outfit', sans-serif;
            font-size: 11px;
            font-weight: 800;
            color: var(--color-primary);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .brand-title {
            font-family: 'Outfit', sans-serif;
            font-size: 18px;
            font-weight: 900;
            line-height: 1.1;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .live-clock {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 700;
            font-family: monospace;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--color-primary);
        }

        .btn-action {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 16px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-action:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: rgba(56, 189, 248, 0.3);
            color: #ffffff;
            transform: translateY(-1px);
        }

        /* Layout Grid */
        .monitor-layout {
            display: grid;
            grid-template-columns: 420px 1fr;
            gap: 20px;
            align-items: start;
        }

        .glass-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            padding: 24px;
        }

        /* Panel Title */
        .panel-header {
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-title {
            font-family: 'Outfit', sans-serif;
            font-size: 16px;
            font-weight: 800;
            margin: 0;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Left Column: QR & Details */
        .qr-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .qr-wrapper {
            background: #ffffff;
            padding: 18px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 40px rgba(56, 189, 248, 0.15);
            display: inline-block;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .qr-wrapper:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 50px rgba(56, 189, 248, 0.25);
        }

        .event-info-title {
            font-family: 'Outfit', sans-serif;
            font-size: 22px;
            font-weight: 900;
            margin: 0 0 10px;
            line-height: 1.2;
            background: linear-gradient(135deg, #ffffff 40%, var(--text-muted) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .event-info-desc {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.5;
            margin: 0 0 20px;
        }

        .info-meta-list {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
            text-align: left;
        }

        .info-meta-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 12px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .info-meta-item i {
            color: var(--color-primary);
            font-size: 16px;
            margin-top: 2px;
        }

        .info-meta-item div {
            display: grid;
            gap: 2px;
        }

        .info-meta-item strong {
            font-size: 10px;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .info-meta-item span {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-main);
        }

        /* Center & Right Column: Stats Row */
        .stats-strip {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-card-glow {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            transition: all 0.3s ease;
        }

        .stat-card-glow:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .stat-card-glow.present {
            border-color: rgba(16, 185, 129, 0.15);
            box-shadow: inset 0 0 15px rgba(16, 185, 129, 0.05);
        }
        
        .stat-card-glow.pending {
            border-color: rgba(244, 63, 94, 0.15);
            box-shadow: inset 0 0 15px rgba(244, 63, 94, 0.05);
        }

        .stat-card-left {
            display: grid;
            gap: 4px;
        }

        .stat-card-label {
            font-size: 11px;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .stat-card-val {
            font-family: 'Outfit', sans-serif;
            font-size: 32px;
            font-weight: 900;
            line-height: 1.1;
        }

        .stat-card-sub {
            font-size: 10px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .stat-card-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
        }

        .stat-card-glow.present .stat-card-icon {
            background: rgba(16, 185, 129, 0.1);
            color: var(--color-green);
            border-color: rgba(16, 185, 129, 0.2);
            box-shadow: var(--glow-green);
        }

        .stat-card-glow.pending .stat-card-icon {
            background: rgba(244, 63, 94, 0.1);
            color: var(--color-red);
            border-color: rgba(244, 63, 94, 0.2);
            box-shadow: var(--glow-red);
        }
        
        .stat-card-glow.active .stat-card-icon {
            background: rgba(56, 189, 248, 0.1);
            color: var(--color-primary);
            border-color: rgba(56, 189, 248, 0.2);
            box-shadow: var(--glow-primary);
        }

        /* Pending list column */
        .pending-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 48vh;
            overflow-y: auto;
            padding-right: 4px;
            scroll-behavior: smooth;
        }

        .pending-item {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .pending-item h4 {
            margin: 0;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-main);
        }

        .pending-item span {
            font-size: 11px;
            color: var(--color-red);
            font-weight: 700;
        }

        /* Live Table section */
        .live-table-wrap {
            max-height: 48vh;
            overflow-y: auto;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            background: rgba(0, 0, 0, 0.15);
        }

        .live-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .live-table th {
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 16px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .live-table tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            transition: background var(--transition-fast);
        }

        .live-table tr:hover {
            background: rgba(255, 255, 255, 0.01);
        }

        .live-table td {
            padding: 12px 16px;
            font-size: 12px;
            color: var(--text-main);
        }

        .live-table td strong {
            font-weight: 700;
            color: var(--color-primary);
        }

        .empty-state {
            padding: 30px;
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 600;
            border: 1px dashed rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.01);
        }

        /* Queue Notification Toast Styling */
        .attendance-toast {
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 20px;
            padding: 20px 24px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(56, 189, 248, 0.25);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            animation: toastSlideIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            width: 380px;
            max-width: 90vw;
            position: relative;
            overflow: hidden;
            margin-top: 10px;
        }

        .attendance-toast.fade-out {
            animation: toastSlideOut 0.4s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards;
        }

        @@keyframes toastSlideIn {
            from {
                opacity: 0;
                transform: translateY(45px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes toastSlideOut {
            from {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            to {
                opacity: 0;
                transform: translateY(-25px) scale(0.92);
            }
        }

        .toast-icon-wrapper {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: var(--color-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: var(--glow-green);
            margin-bottom: 4px;
        }

        .toast-role {
            font-size: 10px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .toast-name {
            font-family: 'Outfit', sans-serif;
            font-size: 20px;
            font-weight: 900;
            color: #ffffff;
            text-align: center;
            margin: 2px 0 0;
            line-height: 1.2;
        }

        .toast-company {
            font-size: 14px;
            font-weight: 800;
            color: var(--color-primary);
            text-align: center;
            margin-bottom: 6px;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--color-primary), var(--color-green));
            width: 100%;
            animation: toastProgress linear forwards;
        }

        @@keyframes toastProgress {
            from { width: 100%; }
            to { width: 0%; }
        }

        /* Responsive Layouts */
        @@media (max-width: 1099px) {
            .monitor-layout {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .display-shell {
                padding: 14px;
            }
            .dashboard-header {
                flex-direction: column;
                align-items: stretch;
                padding: 16px;
                border-radius: 18px;
            }
            .header-actions {
                justify-content: space-between;
            }
            .stats-strip {
                grid-template-columns: 1fr;
            }
        }

        /* Visualizer Canvas */
        #visualizerCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
            opacity: 0.22;
            transition: opacity 0.5s ease;
        }

        /* Music Player Capsule */
        .music-player-capsule {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            padding: 6px 14px;
            border-radius: 18px;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        .music-player-capsule:hover {
            border-color: rgba(56, 189, 248, 0.3);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.15);
        }
        .music-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-main);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s ease;
        }
        .music-btn:hover {
            background: var(--color-primary);
            color: #030712;
            border-color: var(--color-primary);
            transform: scale(1.05);
            box-shadow: var(--glow-primary);
        }
        .music-track-info {
            width: 120px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .music-track-title-container {
            width: 100%;
            overflow: hidden;
            position: relative;
            height: 16px;
        }
        .music-track-title {
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            color: var(--text-main);
            position: absolute;
            will-change: transform;
        }
        .music-track-status {
            font-size: 8px;
            font-weight: 800;
            color: var(--color-primary);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: flex;
            align-items: center;
            gap: 4px;
            height: 10px;
        }
        .music-volume-container {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .music-volume-slider {
            width: 0;
            opacity: 0;
            height: 4px;
            -webkit-appearance: none;
            appearance: none;
            background: rgba(255, 255, 255, 0.2);
            outline: none;
            border-radius: 2px;
            transition: width 0.3s ease, opacity 0.3s ease;
        }
        .music-volume-container:hover .music-volume-slider,
        .music-volume-slider:focus {
            width: 60px;
            opacity: 1;
        }
        .music-volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--color-primary);
            cursor: pointer;
            box-shadow: var(--glow-primary);
        }
        .equalizer-bar-container {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            height: 8px;
            width: 12px;
        }
        .equalizer-bar {
            width: 2px;
            height: 100%;
            background-color: var(--color-primary);
            transform-origin: bottom;
            animation: bounce-eq 0.8s ease infinite alternate;
        }
        .equalizer-bar:nth-child(2) { animation-delay: 0.2s; }
        .equalizer-bar:nth-child(3) { animation-delay: 0.4s; }

        @@keyframes bounce-eq {
            0% { transform: scaleY(0.2); }
            100% { transform: scaleY(1); }
        }
    </style>
</head>
<body>
<canvas id="visualizerCanvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none;"></canvas>
<div class="display-shell" style="background: transparent;">
    <!-- Top Header -->
    <header class="dashboard-header">
        <div class="brand-section">
            <img src="/images/logo_mbs.png" alt="INDEXIM SAP" class="brand-logo" />
            <div class="brand-text">
                <span class="brand-subtitle">Safety Accountability Program</span>
                <span class="brand-title">Live Attendance Display</span>
            </div>
        </div>
        <div class="header-actions">
            <!-- Music Player Widget -->
            <div class="music-player-capsule" id="musicPlayerCapsule">
                <button type="button" class="music-btn" id="musicPlayBtn" title="Mainkan/Jeda Musik Latar">
                    <i class="bi bi-play-fill"></i>
                </button>
                <button type="button" class="music-btn" id="musicNextBtn" title="Lagu Berikutnya">
                    <i class="bi bi-skip-forward-fill"></i>
                </button>
                <div class="music-track-info">
                    <div class="music-track-title-container">
                        <div class="music-track-title" id="musicTrackTitle">Memuat musik...</div>
                    </div>
                    <div class="music-track-status" id="musicTrackStatus">
                        <span>Menghubungkan</span>
                    </div>
                </div>
                <div class="music-volume-container">
                    <button type="button" class="music-btn" id="musicVolumeBtn" title="Mute/Unmute Musik">
                        <i class="bi bi-volume-up-fill" id="musicVolumeIcon"></i>
                    </button>
                    <input type="range" id="musicVolumeSlider" min="0" max="1" step="0.05" value="0.25" class="music-volume-slider" title="Volume Musik" />
                </div>
            </div>
            <!-- Audio Toggle Button -->
            <button type="button" class="btn-action" id="soundToggleBtn" title="Aktifkan/Nonaktifkan Suara Absen">
                <i class="bi bi-volume-up-fill" id="soundIcon" style="color: var(--color-green);"></i>
                <span id="soundLabel">Suara Aktif</span>
            </button>
            <div class="live-clock" id="liveClock">
                <i class="bi bi-clock-history"></i><span>--:--:--</span>
            </div>
            <button type="button" class="btn-action" id="fullscreenToggleBtn">
                <i class="bi bi-arrows-fullscreen"></i><span>Fullscreen</span>
            </button>
            <a class="btn-action" href="/Display">
                <i class="bi bi-arrow-left"></i><span>Kembali</span>
            </a>
        </div>
    </header>

    <!-- Monitor Grid -->
    <main class="monitor-layout">
        <!-- Column 1: QR & Event Info -->
        <section class="glass-card qr-section">
            <div class="panel-header" style="width: 100%;">
                <h3 class="panel-title"><i class="bi bi-qr-code-scan text-primary"></i>Pindai Absensi</h3>
            </div>
            
            <div class="qr-wrapper">
                <div id="eventQrCode"></div>
            </div>
            
            <h1 class="event-info-title">@Model.Event.EventName</h1>
            <p class="event-info-desc">Pindai QR Code di atas menggunakan browser/kamera HP Anda untuk mencatat kehadiran secara otomatis.</p>
            
            <div class="info-meta-list">
                <div class="info-meta-item">
                    <i class="bi bi-geo-alt-fill"></i>
                    <div>
                        <strong>Lokasi Acara</strong>
                        <span>@(string.IsNullOrWhiteSpace(Model.Event.EventLocation) ? "Lokasi belum diisi" : Model.Event.EventLocation)</span>
                    </div>
                </div>
                <div class="info-meta-item">
                    <i class="bi bi-calendar-event-fill"></i>
                    <div>
                        <strong>Waktu Pelaksanaan</strong>
                        <span>@Model.Event.StartAt.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
                <div class="info-meta-item">
                    <i class="bi bi-clock-fill"></i>
                    <div>
                        <strong>Jadwal Jam</strong>
                        <span>@Model.Event.StartAt.ToString("HH:mm") - @Model.Event.EndAt.ToString("HH:mm") WITA</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Column 2: Stats & Details (Live Feed & Pending List) -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
            <!-- Stats strip -->
            <section class="stats-strip">
                <div class="stat-card-glow active">
                    <div class="stat-card-left">
                        <span class="stat-card-label">Perusahaan Terdaftar</span>
                        <span class="stat-card-val" id="activeCompaniesValue">@Model.TotalActiveCompanies</span>
                        <span class="stat-card-sub">total perusahaan aktif</span>
                    </div>
                    <div class="stat-card-icon"><i class="bi bi-buildings-fill"></i></div>
                </div>
                <div class="stat-card-glow present">
                    <div class="stat-card-left">
                        <span class="stat-card-label">Hadir (Perusahaan)</span>
                        <span class="stat-card-val" id="presentCompaniesValue">@Model.TotalPresentCompanies</span>
                        <span class="stat-card-sub" id="presentCompaniesRate">@companyRate% dari total</span>
                    </div>
                    <div class="stat-card-icon"><i class="bi bi-check-circle-fill"></i></div>
                </div>
                <div class="stat-card-glow pending">
                    <div class="stat-card-left">
                        <span class="stat-card-label">Belum Hadir (Perusahaan)</span>
                        <span class="stat-card-val" id="pendingCompaniesValue">@(Model.TotalActiveCompanies - Model.TotalPresentCompanies)</span>
                        <span class="stat-card-sub">menunggu perwakilan</span>
                    </div>
                    <div class="stat-card-icon"><i class="bi bi-exclamation-circle-fill"></i></div>
                </div>
            </section>

            <!-- Bottom Sub-Grid: Live Feed & Pending List -->
            <div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 20px;">
                <!-- Live Attendance Feed Card -->
                <section class="glass-card">
                    <div class="panel-header">
                        <h3 class="panel-title"><i class="bi bi-rss-fill text-primary"></i>Live Attendance Feed</h3>
                        <span class="badge-status present" style="background: rgba(56, 189, 248, 0.15); color: var(--color-primary); border-color: rgba(56, 189, 248, 0.2);" id="totalAttendeesBadge">
                            @Model.TotalPresentEmployees Peserta Hadir
                        </span>
                    </div>
                    <div class="live-table-wrap">
                        <table class="live-table">
                            <thead>
                                <tr>
                                    <th>Waktu</th>
                                    <th>Nama / NIK</th>
                                    <th>Jabatan</th>
                                    <th>Perusahaan</th>
                                </tr>
                            </thead>
                            <tbody id="attendeeFeedTableBody">
                                @if (Model.Attendees.Count == 0)
                                {
                                    <tr><td colspan="4" class="text-center" style="text-align:center; padding: 24px; color: var(--text-muted);">Belum ada absensi masuk untuk event ini.</td></tr>
                                }
                                else
                                {
                                    @foreach (var attendee in Model.Attendees)
                                    {
                                        <tr>
                                            <td>@attendee.ScanAt.ToString("HH:mm:ss")</td>
                                            <td>
                                                <strong>@attendee.Nama</strong>
                                                <div style="font-size: 10px; color: var(--text-muted);">@attendee.Nik</div>
                                            </td>
                                            <td>@attendee.Jabatan</td>
                                            <td>@attendee.CompanyName</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Pending Companies Card -->
                <section class="glass-card">
                    <div class="panel-header">
                        <h3 class="panel-title"><i class="bi bi-clock-history text-danger"></i>Daftar Belum Hadir</h3>
                    </div>
                    <div class="pending-list" id="pendingCompaniesList">
                        @if (Model.PendingCompanies.Count == 0)
                        {
                            <div class="empty-state">Semua perusahaan aktif sudah hadir.</div>
                        }
                        else
                        {
                            @foreach (var company in Model.PendingCompanies)
                            {
                                <article class="pending-item">
                                    <h4>@company.CompanyName</h4>
                                    <span>Belum Hadir</span>
                                </article>
                            }
                        }
                    </div>
                </section>
            </div>
        </div>
    </main>
</div>

<!-- Floating Toast Container for Queue Notifications -->
<div id="toastContainer" style="position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 9999; pointer-events: none; display: flex; flex-direction: column-reverse; align-items: center;"></div>

<!-- QR and Realtime scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<!-- Confetti Library -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
    (function () {
        const REFRESH_MS = 5000;
        const snapshotUrl = '@snapshotUrl';
        const clockEl = document.querySelector('#liveClock span');
        const fullscreenBtn = document.getElementById('fullscreenToggleBtn');
        const pendingCompaniesListEl = document.getElementById('pendingCompaniesList');
        const attendeeFeedBodyEl = document.getElementById('attendeeFeedTableBody');
        
        // Sound and Queue elements
        const soundToggleBtn = document.getElementById('soundToggleBtn');
        const soundIcon = document.getElementById('soundIcon');
        const soundLabel = document.getElementById('soundLabel');
        const toastContainer = document.getElementById('toastContainer');
        const TOAST_DURATION_MS = 3200;

        let soundEnabled = true;
        const processedNiks = new Set();
        const attendanceQueue = [];
        let isQueueProcessing = false;

        // --- BACKGROUND MUSIC & VISUALIZER ENGINE ---
        let playlist = [];
        let shuffledPlaylist = [];
        let currentTrackIndex = -1;
        let isPlaying = false;
        let currentVolume = 0.25;
        let isMuted = false;
        let isDucked = false;

        const bgAudio = new Audio();
        bgAudio.crossOrigin = "anonymous";

        let audioCtx = null;
        let audioSource = null;
        let analyser = null;
        let gainNode = null;

        // Initialize Web Audio Context
        function initAudioContext() {
            if (audioCtx) return;
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext();
                analyser = audioCtx.createAnalyser();
                analyser.fftSize = 256; 
                
                gainNode = audioCtx.createGain();
                gainNode.gain.setValueAtTime(currentVolume, audioCtx.currentTime);
                
                audioSource = audioCtx.createMediaElementSource(bgAudio);
                audioSource.connect(analyser);
                analyser.connect(gainNode);
                gainNode.connect(audioCtx.destination);
            } catch (e) {
                console.warn("Web Audio API initialization failed:", e);
            }
        }

        // Fetch music file list and initialize player
        async function initBackgroundMusic() {
            try {
                const response = await fetch('/EventQr/GetMusicList');
                if (!response.ok) return;
                playlist = await response.json();
                if (playlist && playlist.length > 0) {
                    shuffledPlaylist = [...playlist];
                    shuffleArray(shuffledPlaylist);
                    currentTrackIndex = 0;
                    loadTrack(shuffledPlaylist[currentTrackIndex]);
                } else {
                    document.getElementById('musicTrackTitle').textContent = "Tidak ada file musik";
                    document.getElementById('musicTrackStatus').innerHTML = "<span>KOSONG</span>";
                }
            } catch (err) {
                console.error("Failed to load music list:", err);
                document.getElementById('musicTrackTitle').textContent = "Gagal memuat musik";
                document.getElementById('musicTrackStatus').innerHTML = "<span>ERROR</span>";
            }
        }

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
        }

        function loadTrack(filename) {
            bgAudio.src = '/music/' + encodeURIComponent(filename);
            bgAudio.load();
            
            const displayTitle = filename.replace(/\.[^/.]+$/, "");
            const titleEl = document.getElementById('musicTrackTitle');
            if (titleEl) {
                titleEl.textContent = displayTitle;
                marqueeOffset = 0; // Reset scroll position
            }
            
            // Do not call playMusic() here, let the caller handle it to prevent double-play errors.
        }

        bgAudio.addEventListener('ended', () => {
            playNextTrack();
        });

        function playNextTrack() {
            if (shuffledPlaylist.length === 0) return;
            currentTrackIndex = (currentTrackIndex + 1) % shuffledPlaylist.length;
            if (currentTrackIndex === 0) {
                shuffleArray(shuffledPlaylist);
            }
            loadTrack(shuffledPlaylist[currentTrackIndex]);
            playMusic();
        }

        // --- Auto-play workaround ---
        // Browsers block autoplay without user interaction.
        // We listen for the first click anywhere on the document to start the music automatically.
        document.addEventListener('click', function autoStartMusic() {
            if (!isPlaying && shuffledPlaylist.length > 0) {
                playMusic();
                // Remove listener after first interaction
                document.removeEventListener('click', autoStartMusic);
            }
        });

        async function playMusic() {
            initAudioContext();
            try {
                if (audioCtx && audioCtx.state === 'suspended') {
                    await audioCtx.resume();
                }
                await bgAudio.play();
                isPlaying = true;
                updateMusicUI();
            } catch (e) {
                console.warn("Play request was blocked or failed:", e);
                isPlaying = false;
                updateMusicUI();
            }
        }

        function pauseMusic() {
            bgAudio.pause();
            isPlaying = false;
            updateMusicUI();
        }

        function updateMusicUI() {
            const playBtn = document.getElementById('musicPlayBtn');
            const statusEl = document.getElementById('musicTrackStatus');
            
            if (playBtn) {
                const icon = playBtn.querySelector('i');
                if (icon) {
                    icon.className = isPlaying ? 'bi bi-pause-fill' : 'bi bi-play-fill';
                }
            }
            
            if (statusEl) {
                if (isPlaying) {
                    statusEl.innerHTML = `
                        <div class="equalizer-bar-container">
                            <div class="equalizer-bar"></div>
                            <div class="equalizer-bar"></div>
                            <div class="equalizer-bar"></div>
                        </div>
                        <span>MEMUTAR</span>
                    `;
                } else {
                    statusEl.innerHTML = `<span>JEDA</span>`;
                }
            }
        }

        function setVolumeSmoothly(targetValue, durationMs = 300) {
            if (gainNode && audioCtx) {
                const t = audioCtx.currentTime;
                gainNode.gain.cancelScheduledValues(t);
                gainNode.gain.setValueAtTime(gainNode.gain.value, t);
                gainNode.gain.linearRampToValueAtTime(targetValue, t + durationMs / 1000);
            } else {
                bgAudio.volume = targetValue;
            }
        }

        function updateVolume() {
            let activeVol = isMuted ? 0 : currentVolume;
            if (isDucked) {
                activeVol = activeVol * 0.15; // Duck to 15%
            }
            
            setVolumeSmoothly(activeVol, 150);
            
            if (volumeSlider) {
                volumeSlider.value = isMuted ? 0 : currentVolume;
            }
            
            if (volumeIcon) {
                if (isMuted || activeVol === 0) {
                    volumeIcon.className = 'bi bi-volume-mute-fill';
                    volumeIcon.style.color = 'var(--color-red)';
                } else if (currentVolume < 0.5) {
                    volumeIcon.className = 'bi bi-volume-down-fill';
                    volumeIcon.style.color = 'var(--color-primary)';
                } else {
                    volumeIcon.className = 'bi bi-volume-up-fill';
                    volumeIcon.style.color = 'var(--color-primary)';
                }
            }
        }

        function duckMusic() {
            if (isDucked) return;
            isDucked = true;
            updateVolume();
        }

        function unduckMusic() {
            if (!isDucked) return;
            isDucked = false;
            updateVolume();
        }

        // ---------------------------------------------------------
        // STARTUP
        // ---------------------------------------------------------
        document.addEventListener('DOMContentLoaded', () => {
            updateTime();
            initBackgroundMusic();
            initBackgroundVideo();
            initWebsocket();
            drawVisualizer();
            
            // Allow fullscreen
            const fsBtn = document.getElementById('fullscreenToggleBtn');
            if (fsBtn) {
                fsBtn.addEventListener('click', () => {
                    if (!document.fullscreenElement) {
                        document.documentElement.requestFullscreen().catch(err => {
                            console.log(`Error attempting to enable fullscreen: ${err.message}`);
                        });
                    } else {
                        document.exitFullscreen();
                    }
                });
            }

            // Kiosk Mode: Hide Cursor on Idle
            let idleTimer;
            function resetIdleTimer() {
                document.body.classList.remove('kiosk-mode');
                clearTimeout(idleTimer);
                idleTimer = setTimeout(() => {
                    document.body.classList.add('kiosk-mode');
                }, 3000); // Hide after 3 seconds of inactivity
            }
            window.addEventListener('mousemove', resetIdleTimer);
            window.addEventListener('keydown', resetIdleTimer);
            window.addEventListener('touchstart', resetIdleTimer);
            resetIdleTimer();
        });

        // Setup Controls Listeners
        const playBtn = document.getElementById('musicPlayBtn');
        if (playBtn) {
            playBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (isPlaying) {
                    pauseMusic();
                } else {
                    playMusic();
                }
            });
        }

        const nextBtn = document.getElementById('musicNextBtn');
        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                playNextTrack();
            });
        }

        const volumeSlider = document.getElementById('musicVolumeSlider');
        const volumeBtn = document.getElementById('musicVolumeBtn');
        const volumeIcon = document.getElementById('musicVolumeIcon');
        
        if (volumeSlider) {
            volumeSlider.value = currentVolume;
            volumeSlider.addEventListener('input', (e) => {
                currentVolume = parseFloat(e.target.value);
                isMuted = currentVolume === 0;
                updateVolume();
            });
        }
        
        if (volumeBtn) {
            volumeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                isMuted = !isMuted;
                updateVolume();
            });
        }

        // --- CANVAS AUDIO VISUALIZER ---
        const canvas = document.getElementById('visualizerCanvas');
        let canvasCtx = null;
        let particles = [];
        const numParticles = 75;
        let visualAngle = 0;
        let marqueeOffset = 0;

        if (canvas) {
            canvasCtx = canvas.getContext('2d');
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
            initParticles();
            requestAnimationFrame(renderVisualizer);
        }

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        function initParticles() {
            particles = [];
            for (let i = 0; i < numParticles; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.45,
                    vy: (Math.random() - 0.5) * 0.45,
                    size: Math.random() * 2 + 1,
                    baseSize: Math.random() * 2 + 1,
                    color: getRandomColor()
                });
            }
        }

        function getRandomColor() {
            const colors = [
                'rgba(56, 189, 248, 0.35)', // cyan
                'rgba(16, 185, 129, 0.3)',  // green
                'rgba(139, 92, 246, 0.3)',  // purple
                'rgba(244, 63, 94, 0.3)'    // red
            ];
            return colors[Math.floor(Math.random() * colors.length)];
        }

        function getAverage(array, start, end) {
            let sum = 0;
            const count = end - start + 1;
            for (let i = start; i <= end; i++) {
                sum += array[i] || 0;
            }
            return sum / count;
        }

        function updateMarquee() {
            const titleEl = document.getElementById('musicTrackTitle');
            if (!titleEl) return;
            const containerWidth = titleEl.parentElement.offsetWidth;
            const titleWidth = titleEl.scrollWidth;
            if (titleWidth > containerWidth) {
                marqueeOffset -= 0.45; // scroll speed
                if (marqueeOffset < -titleWidth) {
                    marqueeOffset = containerWidth;
                }
                titleEl.style.transform = `translateX(${marqueeOffset}px)`;
            } else {
                titleEl.style.transform = 'none';
            }
        }

        function renderVisualizer() {
            if (!canvas || !canvasCtx) return;
            
            const bufferLength = analyser ? analyser.frequencyBinCount : 128;
            const dataArray = new Uint8Array(bufferLength);
            if (isPlaying && analyser) {
                analyser.getByteFrequencyData(dataArray);
            }
            
            const bass = getAverage(dataArray, 0, 8) / 255;      
            const mids = getAverage(dataArray, 9, 32) / 255;     
            const treble = getAverage(dataArray, 33, 80) / 255;   
            
            // Clean trail clear
            canvasCtx.fillStyle = 'rgba(3, 7, 18, 0.16)';
            canvasCtx.fillRect(0, 0, canvas.width, canvas.height);
            
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            const maxRadius = Math.min(canvas.width, canvas.height) * 0.65;
            
            // 1. Bass Pulse center glow
            const glowGradient = canvasCtx.createRadialGradient(
                centerX, centerY, 20, 
                centerX, centerY, maxRadius
            );
            
            const r = Math.floor(3 + bass * 25);
            const g = Math.floor(7 + mids * 35);
            const b = Math.floor(18 + treble * 60);
            
            glowGradient.addColorStop(0, `rgba(${r + 35}, ${g + 55}, ${b + 130}, ${0.12 + bass * 0.16})`);
            glowGradient.addColorStop(0.5, `rgba(${r}, ${g}, ${b}, ${0.04 + mids * 0.06})`);
            glowGradient.addColorStop(1, 'rgba(3, 7, 18, 0)');
            
            canvasCtx.fillStyle = glowGradient;
            canvasCtx.fillRect(0, 0, canvas.width, canvas.height);
            
            // 2. Wave circles
            const waveCount = 3;
            visualAngle += 0.002 + bass * 0.004;
            for (let w = 0; w < waveCount; w++) {
                const ringRadius = ((w / waveCount * maxRadius + visualAngle * 90) % maxRadius);
                const opacity = (1 - ringRadius / maxRadius) * (0.08 + bass * 0.22);
                
                canvasCtx.beginPath();
                canvasCtx.arc(centerX, centerY, ringRadius, 0, Math.PI * 2);
                canvasCtx.strokeStyle = `rgba(56, 189, 248, ${opacity})`;
                canvasCtx.lineWidth = 1 + bass * 3.5;
                canvasCtx.shadowBlur = 8 + bass * 18;
                canvasCtx.shadowColor = 'rgba(56, 189, 248, 0.45)';
                canvasCtx.stroke();
            }
            canvasCtx.shadowBlur = 0; 
            
            // 3. Particles
            for (let i = 0; i < particles.length; i++) {
                const p = particles[i];
                
                const speedMult = 1 + bass * 4.2;
                p.x += p.vx * speedMult;
                p.y += p.vy * speedMult;
                
                const sizeMult = 1 + treble * 2.2;
                const drawSize = p.baseSize * sizeMult;
                
                if (p.x < -10) p.x = canvas.width + 10;
                if (p.x > canvas.width + 10) p.x = -10;
                if (p.y < -10) p.y = canvas.height + 10;
                if (p.y > canvas.height + 10) p.y = -10;
                
                canvasCtx.beginPath();
                canvasCtx.arc(p.x, p.y, drawSize, 0, Math.PI * 2);
                canvasCtx.fillStyle = p.color;
                
                if (treble > 0.35) {
                    canvasCtx.shadowBlur = 4 + treble * 10;
                    canvasCtx.shadowColor = p.color;
                }
                canvasCtx.fill();
                canvasCtx.shadowBlur = 0;
            }
            
            // 4. Spectrum Bars at the bottom
            const barWidth = (canvas.width / bufferLength) * 2.5;
            let barHeight;
            let x = 0;
            const baseY = canvas.height;
            
            for (let i = 0; i < bufferLength; i++) {
                barHeight = dataArray[i] * 1.8; // Scale up for better visibility
                if (barHeight > 0) {
                    // Vibrant Cyberpunk Gradient Colors based on frequency and height
                    const hue = (i / bufferLength) * 360 + (visualAngle * 250);
                    const color = `hsl(${hue % 360}, 100%, 60%)`;
                    
                    canvasCtx.fillStyle = color; 
                    // Add glow for "Wow" effect
                    canvasCtx.shadowBlur = 15 + (barHeight * 0.05); 
                    canvasCtx.shadowColor = color;
                    
                    // Main Bar (starting from the very bottom or slightly above)
                    // Draw with a slight border radius effect using roundRect if possible, or just rect
                    canvasCtx.fillRect(x, baseY - barHeight, barWidth - 2, barHeight);
                    
                    // Add a bright core highlight to the bar
                    canvasCtx.fillStyle = '#ffffff';
                    canvasCtx.shadowBlur = 0;
                    canvasCtx.fillRect(x + (barWidth-2)*0.3, baseY - barHeight, (barWidth-2)*0.4, barHeight * 0.1);
                }
                x += barWidth;
            }
            canvasCtx.shadowBlur = 0; // Reset
            
            updateMarquee();
            requestAnimationFrame(renderVisualizer);
        }

        // Initialize set with existing attendees to prevent popping up on first load
        @foreach (var attendee in Model.Attendees)
        {
            @:processedNiks.add('@attendee.Nik.Trim()');
        }

        // Draw Event QR Code Large
        const qrContainer = document.getElementById('eventQrCode');
        if (qrContainer) {
            new QRCode(qrContainer, {
                text: '@qrUrl',
                width: 320,
                height: 320,
                colorDark: '#030712',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.Q
            });
        }

        function updateClock() {
            if (!clockEl) return;
            const now = new Date();
            clockEl.textContent = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WITA';
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatTimeOnly(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return '--:--';
            return date.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }

        function syncFullscreenLabel() {
            if (!fullscreenBtn) return;
            const icon = fullscreenBtn.querySelector('i');
            const label = fullscreenBtn.querySelector('span');
            const isFs = !!document.fullscreenElement;
            if (icon) icon.className = isFs ? 'bi bi-fullscreen-exit' : 'bi bi-arrows-fullscreen';
            if (label) label.textContent = isFs ? 'Keluar Fullscreen' : 'Fullscreen';
        }

        // Play Synthesizer Chime
        function playChime() {
            if (!soundEnabled) return;
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();
                
                // Note 1 (E5 - 659.25 Hz)
                const osc1 = ctx.createOscillator();
                const gain1 = ctx.createGain();
                osc1.connect(gain1);
                gain1.connect(ctx.destination);
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(659.25, ctx.currentTime);
                gain1.gain.setValueAtTime(0.1, ctx.currentTime);
                gain1.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
                osc1.start();
                osc1.stop(ctx.currentTime + 0.3);

                // Note 2 (A5 - 880.00 Hz) after 100ms
                setTimeout(() => {
                    const osc2 = ctx.createOscillator();
                    const gain2 = ctx.createGain();
                    osc2.connect(gain2);
                    gain2.connect(ctx.destination);
                    osc2.type = 'sine';
                    osc2.frequency.setValueAtTime(880.00, ctx.currentTime);
                    gain2.gain.setValueAtTime(0.12, ctx.currentTime);
                    gain2.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.4);
                    osc2.start();
                    osc2.stop(ctx.currentTime + 0.4);
                }, 100);
            } catch (e) {
                console.warn("Audio Context blocked or not supported:", e);
            }
        }

        // Speak Name via TTS
        function speakWelcome(name, company) {
            if (!soundEnabled || !window.speechSynthesis) return;
            try {
                window.speechSynthesis.cancel(); // cancel current speech
                const utterance = new SpeechSynthesisUtterance(`Selamat datang ${name}`);
                utterance.lang = 'id-ID';
                utterance.rate = 0.95;
                utterance.pitch = 1.0;
                window.speechSynthesis.speak(utterance);
            } catch (e) {
                console.warn("Speech synthesis failed:", e);
            }
        }

        // Show Slide-up Toast with promise resolved on animation complete
        function showToast(item) {
            if (!toastContainer) return Promise.resolve();
            return new Promise((resolve) => {
                const firstName = (item.nama || '').trim().split(' ')[0];
                
                const toast = document.createElement('div');
                toast.className = 'attendance-toast';
                toast.innerHTML = `
                    <div class="toast-icon-wrapper">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div class="toast-role">${escapeHtml(item.jabatan)}</div>
                    <div class="toast-name">${escapeHtml(firstName)}</div>
                    <div class="toast-company">${escapeHtml(item.companyName)}</div>
                    <div class="toast-progress" style="animation-duration: ${TOAST_DURATION_MS}ms;"></div>
                `;
                
                toastContainer.appendChild(toast);
                
                // Play notification and text-to-speech
                playChime();
                speakWelcome(firstName, item.companyName);

                // Confetti Explosion
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 150,
                        spread: 80,
                        origin: { y: 0.9 }, // Shoot from bottom
                        colors: ['#38bdf8', '#10b981', '#f8fafc', '#f43f5e', '#f59e0b'],
                        zIndex: 10000
                    });
                }

                setTimeout(() => {
                    toast.classList.add('fade-out');
                    setTimeout(() => {
                        toast.remove();
                        resolve();
                    }, 400); // Wait for fade-out animation to complete
                }, TOAST_DURATION_MS);
            });
        }

        // Queue processing loop
        async function processQueue() {
            if (attendanceQueue.length === 0) {
                isQueueProcessing = false;
                unduckMusic(); // Return background music to normal volume
                return;
            }
            isQueueProcessing = true;
            duckMusic(); // Lower background music volume smoothly
            
            const nextItem = attendanceQueue.shift();
            await showToast(nextItem);
            
            // Brief gap between queue items
            setTimeout(processQueue, 150);
        }

        function renderPendingCompanies(companies) {
            if (!pendingCompaniesListEl) return;
            pendingCompaniesListEl.innerHTML = (companies || []).length === 0
                ? '<div class="empty-state">Semua perusahaan aktif sudah hadir.</div>'
                : companies.map(function (company) {
                    return `<article class="pending-item"><h4>${escapeHtml(company.companyName)}</h4><span>Belum Hadir</span></article>`;
                }).join('');
        }

        function renderAttendees(attendees) {
            if (!attendeeFeedBodyEl) return;
            attendeeFeedBodyEl.innerHTML = (attendees || []).length === 0
                ? '<tr><td colspan="4" class="text-center" style="text-align:center; padding: 24px; color: var(--text-muted);">Belum ada absensi masuk untuk event ini.</td></tr>'
                : attendees.map(function (attendee) {
                    return `<tr><td>${escapeHtml(formatTimeOnly(attendee.scanAt))}</td><td><strong>${escapeHtml(attendee.nama)}</strong><div style="font-size: 10px; color: var(--text-muted);">${escapeHtml(attendee.nik)}</div></td><td>${escapeHtml(attendee.jabatan)}</td><td>${escapeHtml(attendee.companyName)}</td></tr>`;
                }).join('');
        }

        function updateSummary(totals) {
            const companyRate = totals.activeCompanies > 0 ? ((totals.presentCompanies / totals.activeCompanies) * 100).toFixed(1) : '0.0';
            document.getElementById('activeCompaniesValue').textContent = totals.activeCompanies;
            document.getElementById('presentCompaniesValue').textContent = totals.presentCompanies;
            document.getElementById('presentCompaniesRate').textContent = `${companyRate}% dari total`;
            document.getElementById('pendingCompaniesValue').textContent = totals.pendingCompanies;
            
            const attendeeBadge = document.getElementById('totalAttendeesBadge');
            if (attendeeBadge) {
                attendeeBadge.textContent = `${totals.presentEmployees} Peserta Hadir`;
            }
        }

        // Automatic scrolling up and down loop
        function initAutoScroll(elementId) {
            const el = document.getElementById(elementId);
            if (!el) return;
            
            let scrollDirection = 1; // 1 = down, -1 = up
            const speed = 0.4; // Pixels per frame
            
            function step(timestamp) {
                if (el.scrollHeight > el.clientHeight) {
                    el.scrollTop += scrollDirection * speed;
                    
                    if (el.scrollTop + el.clientHeight >= el.scrollHeight - 1) {
                        scrollDirection = -1;
                    } else if (el.scrollTop <= 0) {
                        scrollDirection = 1;
                    }
                } else {
                    el.scrollTop = 0;
                }
                requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

        async function refreshAttendanceSnapshot() {
            if (!snapshotUrl) return;
            try {
                const response = await fetch(snapshotUrl, { cache: 'no-store' });
                if (!response.ok) return;
                const data = await response.json();
                
                // Render view lists first
                renderPendingCompanies(data.pendingCompanies || []);
                renderAttendees(data.attendees || []);
                updateSummary(data.totals || {});

                // Process new check-ins in chronological order (oldest to newest)
                if (data.attendees && data.attendees.length > 0) {
                    let hasNew = false;
                    for (let i = data.attendees.length - 1; i >= 0; i--) {
                        const att = data.attendees[i];
                        const nikKey = att.nik.trim();
                        if (!processedNiks.has(nikKey)) {
                            processedNiks.add(nikKey);
                            attendanceQueue.push({
                                nama: att.nama,
                                companyName: att.companyName,
                                jabatan: att.jabatan,
                                nik: att.nik
                            });
                            hasNew = true;
                        }
                    }
                    if (hasNew && !isQueueProcessing) {
                        processQueue();
                    }
                }
            } catch (err) {
                console.error("Failed to fetch attendance update:", err);
            }
        }

        // Toggle sound status and unlock Audio Context for browser compatibility
        soundToggleBtn?.addEventListener('click', () => {
            soundEnabled = !soundEnabled;
            if (soundEnabled) {
                soundIcon.className = 'bi bi-volume-up-fill';
                soundIcon.style.color = 'var(--color-green)';
                soundLabel.textContent = 'Suara Aktif';
                // Try unlocking context
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    ctx.resume();
                } catch {}
            } else {
                soundIcon.className = 'bi bi-volume-mute-fill';
                soundIcon.style.color = 'var(--color-red)';
                soundLabel.textContent = 'Suara Hening';
            }
        });

        fullscreenBtn?.addEventListener('click', async function () {
            try {
                if (!document.fullscreenElement) {
                    await document.documentElement.requestFullscreen();
                } else {
                    await document.exitFullscreen();
                }
            } catch {
            }
            syncFullscreenLabel();
        });

        // Trigger unlock context on any screen interaction
        document.body.addEventListener('click', () => {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                if (ctx.state === 'suspended') {
                    ctx.resume();
                }
            } catch {}
            // Initialize background music and play if loaded
            initAudioContext();
            if (!isPlaying && shuffledPlaylist.length > 0) {
                playMusic();
            }
        }, { once: true });

        document.addEventListener('fullscreenchange', syncFullscreenLabel);
        updateClock();
        syncFullscreenLabel();
        setInterval(updateClock, 1000);
        setInterval(refreshAttendanceSnapshot, REFRESH_MS);
        
        // Initialize background music playlist
        initBackgroundMusic();

        // Initialize Auto Scroll for Pending Companies
        initAutoScroll('pendingCompaniesList');
    })();
</script>
</body>
</html>
