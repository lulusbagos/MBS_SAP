</div>

@section Scripts {
    <!-- Datatables CSS & JS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <!-- Datatables script logic -->
    <script>
        $(document).ready(function () {
            // Populate bulk update dropdown from the filter dropdown
            function populateBulkDept() {
                var filterDepts = $('#filterDepartemen').html();
                $('#bulkDepartemen').html(filterDepts);
                // Remove the "-- Semua Departemen --" and make it "-- Pilih Departemen --"
                $('#bulkDepartemen option[value=""]').text("-- Pilih Departemen --");
            }
            populateBulkDept();
            
            // Re-populate if filter changes (due to company change)
            $('#filterPerusahaan').change(function() {
                setTimeout(populateBulkDept, 1500); // Wait for the ajax to finish in your existing script
            });

            var table = $('#karyawanTable').DataTable({
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/SapTarget/GetEmployeeTargetsData",
                    "type": "POST",
                    "data": function (d) {
                        d.perusahaanId = $('#filterPerusahaan').val();
                        d.departemen = $('#filterDepartemen').val();
                        d.customSearch = $('#customSearch').val();
                    }
                },
                "dom": 'rt<"row mt-4 align-items-center"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                "columns": [
                    { 
                        "data": "nama",
                        "render": function(data, type, row) {
                            let photoUrl = `https://erp.indexim.co.id/uploads/karyawan/${row.karyawanId}.jpg`;
                            let initials = data ? data.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : "-";
                            return `<div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle shadow-sm border border-light overflow-hidden flex-shrink-0" style="width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: #f8fafc;">
                                            <img src="${photoUrl}" alt="${data}" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.outerHTML='<div class=\\'w-100 h-100 d-flex align-items-center justify-content-center fw-bold text-primary bg-soft-primary\\' style=\\'font-size: 14px;\\'>${initials}</div>';" />
                                        </div>
                                        <div>
                                            <div class="fw-bold" style="color: #0f172a;">${data}</div>
                                            <div style="font-size: 11px; color: #64748b;">${row.perusahaan}</div>
                                        </div>
                                    </div>`;
                        }
                    },
                    { "data": "nik" },
                    { "data": "departemen" },
                    { 
                        "data": "kategori_pengawas",
                        "className": "text-center align-middle",
                        "render": function(data) {
                            if (!data || data === "-") return `<span class="badge rounded-pill bg-secondary" style="font-size: 11px; font-weight: 600; padding: 5px 12px;">NON SAP</span>`;
                            
                            let text = data.replace("Pengawas ", "");
                            let badgeClass = "bg-secondary";
                            
                            if (data.includes("Area Operasional")) {
                                badgeClass = "bg-warning text-dark";
                            } else if (data.includes("Non Office")) {
                                badgeClass = "bg-primary";
                            } else if (data.includes("Office")) {
                                badgeClass = "bg-success";
                            }
                            
                            return `<span class="badge rounded-pill ${badgeClass}" style="font-size: 11px; font-weight: 600; padding: 5px 12px;">${text}</span>`;
                        }
                    },
                    { 
                        "data": "jabatan",
                        "render": function(data, type, row) {
                            let content = `<span class="badge bg-light text-dark border">${data}</span>`;
                            if (row.alasan && row.alasan !== 'Target berdasarkan mapping jabatan') {
                                let alasanText = row.alasan.replace('Kategori NST (non target)', 'Kategori Non-Target (NST)');
                                content += `<div class="mt-1"><span class="badge badge-blink-red" style="font-size: 10px; font-weight: 600;"><i class="bi bi-info-circle me-1"></i>${alasanText}</span></div>`;
                            }
                            return content;
                        }
                    },
                    {
                        "data": "karyawanId",
                        "orderable": false,
                        "className": "text-center",
                        "render": function(data, type, row) {
                            return `<button class="btn btn-sm btn-primary py-1 px-2" style="font-size: 12px; border-radius: 8px;" onclick='openEditModal(${JSON.stringify(row)})'>
                                        <i class="bi bi-pencil-fill me-1"></i>Edit
                                    </button>`;
                        }
                    }
                ],
                "language": {
                    "search": "Cari Karyawan:",
                    "lengthMenu": "Tampilkan _MENU_ data per halaman",
                    "zeroRecords": "Tidak ditemukan data yang sesuai",
                    "info": "Menampilkan halaman _PAGE_ dari _PAGES_",
                    "infoEmpty": "Data tidak tersedia",
                    "infoFiltered": "(difilter dari total _MAX_ data)",
                    "processing": `<div class="loading-card">
                                     <div class="spinner-gradient"></div>
                                     <span class="fw-bold text-dark" style="font-size: 13px; letter-spacing: 0.5px;">Memproses Data...</span>
                                   </div>`
                },
                "ordering": false // Simplified ordering for now
            });

            $('#filterPerusahaan').on('change', function () {
                var perusId = $(this).val();
                var deptSelect = $('#filterDepartemen');
                
                deptSelect.html('<option value="">Sedang memuat...</option>');
                
                $.get('/SapTarget/GetDepartmentsByCompany', { perusahaanId: perusId }, function(data) {
                    deptSelect.empty();
                    deptSelect.append('<option value="">-- Semua Departemen --</option>');
                    if(data && data.length) {
                        $.each(data, function(i, item) {
                            deptSelect.append($('<option></option>').val(item).text(item));
                        });
                    }
                    table.draw();
                }).fail(function() {
                    deptSelect.html('<option value="">-- Semua Departemen --</option>');
                    table.draw();
                });
            });

            $('#filterDepartemen').on('change', function () {
                table.draw();
            });

            let searchTimeout;
            $('#customSearch').on('keyup', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function () {
                    table.draw();
                }, 500);
            });
        });

        function openEditModal(row) {
            $('#karyawanId').val(row.karyawanId);
            $('#lblNamaLengkap').text(row.nama);
            $('#lblNik').text(row.nik);
            
            let infoText = row.departemen;
            if (row.kategori_pengawas && row.kategori_pengawas !== "-") {
                infoText += ' • ' + row.kategori_pengawas;
            }
            infoText += ' • ' + row.jabatan + ' • ' + row.perusahaan;
            $('#lblInfoJabatan').text(infoText);
            
            if (row.alasan && row.alasan !== 'Target berdasarkan mapping jabatan') {
                let alasanText = row.alasan.replace('Kategori NST (non target)', 'Kategori Non-Target (NST)');
                $('#lblAlasanZero').html(`<span class="badge badge-blink-red"><i class="bi bi-info-circle me-1"></i>${alasanText}</span>`).show();
            } else {
                $('#lblAlasanZero').hide();
            }

            // Set targets
            $('#targetInspeksi').val(row.t_inspeksi);
            $('#targetObservasi').val(row.t_observasi);
            $('#targetHazard').val(row.t_hazard);
            $('#targetCoaching').val(row.t_coaching);
            $('#targetSafetyTalk').val(row.t_safetytalk);

            // Attempt to match preset
            let validKategori = ["Pengawas Area Operasional", "Pengawas Support Dept - Non Office", "Pengawas Support Dept - Office", "-"];
            if (row.kategori_pengawas && validKategori.includes(row.kategori_pengawas)) {
                $('#presetKategori').val(row.kategori_pengawas);
            } else {
                $('#presetKategori').val("");
            }

            let validJabs = ["General Manager", "Sr Manager", "Manager", "Sr. Sup/Supt", "Sr Spv/Spv/Officer/Fm"];
            let matchedJab = "";
            if (row.jabatan) {
                matchedJab = validJabs.find(j => row.jabatan.includes(j)) || "Sr Spv/Spv/Officer/Fm";
            }
            $('#presetJabatan').val(matchedJab);

            $('#editTargetModal').modal('show');
        }

        const targetMatrix = {
            "Pengawas Area Operasional": {
                "General Manager": [1, 1, 1, 1, 4],
                "Sr Manager": [2, 2, 1, 1, 4],
                "Manager": [2, 2, 1, 1, 4],
                "Sr. Sup/Supt": [8, 8, 4, 2, 4],
                "Sr Spv/Spv/Officer/Fm": [8, 8, 8, 2, 4]
            },
            "Pengawas Support Dept - Non Office": {
                "General Manager": [1, 1, 1, 1, 4],
                "Sr Manager": [2, 2, 1, 1, 4],
                "Manager": [2, 2, 1, 1, 4],
                "Sr. Sup/Supt": [4, 4, 2, 1, 4],
                "Sr Spv/Spv/Officer/Fm": [4, 4, 4, 1, 4]
            },
            "Pengawas Support Dept - Office": {
                "General Manager": [1, 1, 1, 1, 4],
                "Sr Manager": [2, 2, 1, 1, 4],
                "Manager": [2, 2, 1, 1, 4],
                "Sr. Sup/Supt": [2, 2, 1, 1, 4],
                "Sr Spv/Spv/Officer/Fm": [2, 2, 1, 1, 4]
            }
        };

        function applyPreset() {
            let kat = $('#presetKategori').val();
            let jab = $('#presetJabatan').val();
            
            if (kat === "-") {
                $('#targetInspeksi').val(0);
                $('#targetObservasi').val(0);
                $('#targetHazard').val(0);
                $('#targetCoaching').val(0);
                $('#targetSafetyTalk').val(0);
            } else if (kat && jab && targetMatrix[kat] && targetMatrix[kat][jab]) {
                let vals = targetMatrix[kat][jab];
                $('#targetInspeksi').val(vals[0]);
                $('#targetObservasi').val(vals[1]);
                $('#targetHazard').val(vals[2]);
                $('#targetCoaching').val(vals[3]);
                $('#targetSafetyTalk').val(vals[4]);
            }
        }

        function saveTarget(e) {
            e.preventDefault();
            
            const btn = $('#btnSaveTarget');
            const originalText = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Menyimpan...');

            const data = {
                karyawanId: $('#karyawanId').val(),
                targetInspeksi: $('#targetInspeksi').val(),
                targetObservasi: $('#targetObservasi').val(),
                targetHazard: $('#targetHazard').val(),
                targetCoaching: $('#targetCoaching').val(),
                targetSafetyTalk: $('#targetSafetyTalk').val(),
                kategoriPengawas: $('#presetKategori').val()
            };

            $.post('/SapTarget/SaveTarget', data, function(res) {
                if(res.success) {
                    $('#editTargetModal').modal('hide');
                    $('#karyawanTable').DataTable().ajax.reload(null, false);
                    alert(res.message);
                } else {
                    alert('Error: ' + res.message);
                }
            }).always(function() {
                btn.prop('disabled', false).html(originalText);
            });
        }

        function bulkUpdate(e) {
            e.preventDefault();
            const btn = $('#btnSubmitBulk');
            const originalText = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Memproses...');

            const data = {
                perusahaanId: $('#filterPerusahaan').val() || 0,
                departemen: $('#bulkDepartemen').val(),
                kategoriPengawas: $('#bulkKategori').val()
            };

            $.post('/SapTarget/BulkUpdateDepartemen', data, function(res) {
                if(res.success) {
                    $('#bulkUpdateModal').modal('hide');
                    $('#karyawanTable').DataTable().ajax.reload(null, false);
                    alert(res.message);
                } else {
                    alert('Error: ' + res.message);
                }
            }).fail(function() {
                alert('Terjadi kesalahan koneksi saat memproses update massal.');
            }).always(function() {
                btn.prop('disabled', false).html(originalText);
            });
        }
    </script>
}
