                    <thead style="background: #f8fafc; font-size: 11px; color: #334155;">
                        <tr><th class="text-start">JABATAN</th><th>INSPEKSI</th><th>OBSERVASI</th><th>HAZARD REPORT</th><th>COACHING</th><th>SAFETY TALK</th></tr>
                    </thead>
