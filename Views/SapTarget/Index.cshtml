@{
    ViewData["Title"] = "SAP Target Override";
    var companies = ViewData["Companies"] as IEnumerable<dynamic>;
}

<style>
@@keyframes blinkFade {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(0.98); }
    100% { opacity: 1; transform: scale(1); }
}
.badge-blink-red {
    animation: blinkFade 1.5s infinite ease-in-out;
    background-color: #fee2e2 !important;
    color: #ef4444 !important;
    border: 1px solid #fca5a5 !important;
}
/* Custom DataTables Processing Card Override */
.dataTables_wrapper .dataTables_processing {
    position: absolute;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    width: auto !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: none !important;
    border: none !important;
    z-index: 1000;
    box-shadow: none !important;
}
.loading-card {
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border: 1px solid rgba(209, 213, 219, 0.3);
    border-radius: 20px;
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.12), 0 1px 1px 0 rgba(0,0,0,0.05);
    padding: 1.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: all 0.3s ease;
}
.spinner-gradient {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 30%, var(--bs-primary));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 6px), #000 0);
    mask: radial-gradient(farthest-side, transparent calc(100% - 6px), #000 0);
    animation: spin 1s linear infinite;
}
@@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>

<div class="animate-fade-in" style="color: #0f172a; font-family: 'Inter', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="screen-title d-flex align-items-center gap-2" style="font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 24px; color: #0f172a;">
                <i class="bi bi-sliders text-primary"></i> Override Target SAP
            </div>
            <p class="screen-subtitle mb-0" style="font-size: 13.5px; color: #475569;">Atur target SAP manual per Karyawan (Data Tabel).</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-warning py-2 px-3 fw-bold d-flex align-items-center gap-2 text-dark" style="border-radius: 12px; font-size: 13px;" data-bs-toggle="modal" data-bs-target="#bulkUpdateModal">
                <i class="bi bi-magic"></i> Update Massal
            </button>
            <button class="btn btn-info py-2 px-3 fw-bold d-flex align-items-center gap-2 text-white" style="border-radius: 12px; font-size: 13px;" data-bs-toggle="modal" data-bs-target="#aturanTargetModal">
                <i class="bi bi-info-circle-fill"></i> Aturan Target
            </button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary py-2 px-3 fw-bold d-flex align-items-center gap-2" style="border-radius: 12px; font-size: 13px;">
                <i class="bi bi-arrow-left"></i> Kembali ke Beranda
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; background: #fff;">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold" style="font-size: 13px; color: #475569;"><i class="bi bi-building me-1 text-primary"></i>Filter Perusahaan</label>
                    <select id="filterPerusahaan" class="form-select shadow-none" style="border-radius: 10px; font-size: 14px; border-color: #cbd5e1;">
                        <option value="">-- Semua Perusahaan (Dalam Akses Anda) --</option>
                        @if (companies != null)
                        {
                            foreach (var comp in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)companies)
                            {
                                var isSelected = comp.Value == ViewData["UserCompanyId"]?.ToString() ? "selected" : "";
                                if (isSelected == "selected")
                                {
                                    <option value="@comp.Value" selected>@comp.Text</option>
                                }
                                else
                                {
                                    <option value="@comp.Value">@comp.Text</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold" style="font-size: 13px; color: #475569;"><i class="bi bi-diagram-3 me-1 text-success"></i>Filter Departemen</label>
                    <select id="filterDepartemen" class="form-select shadow-none" style="border-radius: 10px; font-size: 14px; border-color: #cbd5e1;">
                        <option value="">-- Semua Departemen --</option>
                        @if (ViewData["Departments"] != null)
                        {
                            foreach (var dept in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Departments"]!)
                            {
                                <option value="@dept.Value">@dept.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold" style="font-size: 13px; color: #475569;"><i class="bi bi-search me-1 text-warning"></i>Pencarian Karyawan</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-radius: 10px 0 0 10px; border-color: #cbd5e1;"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="customSearch" class="form-control shadow-none border-start-0" placeholder="Ketik Nama atau NIK..." style="border-radius: 0 10px 10px 0; font-size: 14px; border-color: #cbd5e1;" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; background: #fff;">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="karyawanTable" class="table table-hover align-middle w-100" style="font-size: 13px;">
                    <thead style="background: #f8fafc; color: #475569;">
                        <tr>
                            <th>NAMA</th>
                            <th>NIK</th>
                            <th>DEPARTEMEN</th>
                            <th class="text-center">KATEGORI</th>
                            <th>JABATAN</th>
                            <th class="text-center">AKSI</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Target Modal -->
<div class="modal fade" id="editTargetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" style="color: #0f172a;"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Target SAP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 mb-4" style="background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <input type="hidden" id="karyawanId" />
                    <div class="fw-bold" style="font-size: 16px; color: #0f172a;" id="lblNamaLengkap">-</div>
                    <div class="text-muted" style="font-size: 13px;" id="lblNik">-</div>
                    <div class="mt-2" style="font-size: 12px; color: #64748b;" id="lblInfoJabatan">-</div>
                    <div class="mt-1" style="font-size: 11px; color: #f59e0b; font-weight: bold;" id="lblAlasanZero"></div>
                </div>

                <form id="targetForm" onsubmit="saveTarget(event)">
                    <div class="row g-3 mb-4 pb-4 border-bottom">
                        <div class="col-md-12 mb-1">
                            <div class="fw-bold" style="font-size: 13px; color: #0f172a;"><i class="bi bi-magic me-2 text-primary"></i>Sesuaikan Target Otomatis berdasarkan Kategori:</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label" style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Pilih Kategori Pengawas</label>
                            <select id="presetKategori" class="form-select shadow-sm" onchange="applyPreset()" style="font-size: 14px; font-weight: 600; border-radius: 8px; border-color: #cbd5e1; cursor: pointer;">
                                <option value="">-- Kustom (Biarkan Sesuai Jabatan) --</option>
                                <option value="Pengawas Area Operasional">Pengawas Area Operasional</option>
                                <option value="Pengawas Support Dept - Non Office">Pengawas Support Dept - Non Office</option>
                                <option value="Pengawas Support Dept - Office">Pengawas Support Dept - Office</option>
                                <option value="-">NON SAP</option>
                            </select>
                            <input type="hidden" id="presetJabatan" />
                        </div>
                    </div>

                    <div class="fw-bold mb-3" style="font-size: 13px; color: #0f172a;"><i class="bi bi-bullseye me-2 text-danger"></i>Detail Target Akuntabilitas (Bulan Ini):</div>
                    <div class="row g-3 justify-content-center">
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 text-center shadow-sm" style="background: #fff; border-color: #e2e8f0 !important;">
                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 44px; height: 44px; background: #eff6ff;">
                                        <i class="bi bi-search text-primary" style="font-size: 20px;"></i>
                                    </div>
                                </div>
                                <label class="form-label d-block mb-1" style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Inspeksi</label>
                                <input type="text" class="form-control shadow-none border-0 fw-bolder text-center mx-auto" id="targetInspeksi" style="width: 80px; background: #f8fafc; font-size: 18px; border-radius: 8px; color: #0f172a;" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 text-center shadow-sm" style="background: #fff; border-color: #e2e8f0 !important;">
                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 44px; height: 44px; background: #f0fdf4;">
                                        <i class="bi bi-eye text-success" style="font-size: 20px;"></i>
                                    </div>
                                </div>
                                <label class="form-label d-block mb-1" style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Observasi</label>
                                <input type="text" class="form-control shadow-none border-0 fw-bolder text-center mx-auto" id="targetObservasi" style="width: 80px; background: #f8fafc; font-size: 18px; border-radius: 8px; color: #0f172a;" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 text-center shadow-sm" style="background: #fff; border-color: #e2e8f0 !important;">
                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 44px; height: 44px; background: #fffbeb;">
                                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 20px;"></i>
                                    </div>
                                </div>
                                <label class="form-label d-block mb-1" style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Hazard</label>
                                <input type="text" class="form-control shadow-none border-0 fw-bolder text-center mx-auto" id="targetHazard" style="width: 80px; background: #f8fafc; font-size: 18px; border-radius: 8px; color: #0f172a;" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 text-center shadow-sm" style="background: #fff; border-color: #e2e8f0 !important;">
                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 44px; height: 44px; background: #ecfeff;">
                                        <i class="bi bi-chat-dots text-info" style="font-size: 20px;"></i>
                                    </div>
                                </div>
                                <label class="form-label d-block mb-1" style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Coaching</label>
                                <input type="text" class="form-control shadow-none border-0 fw-bolder text-center mx-auto" id="targetCoaching" style="width: 80px; background: #f8fafc; font-size: 18px; border-radius: 8px; color: #0f172a;" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 text-center shadow-sm" style="background: #fff; border-color: #e2e8f0 !important;">
                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 44px; height: 44px; background: #fef2f2;">
                                        <i class="bi bi-megaphone text-danger" style="font-size: 20px;"></i>
                                    </div>
                                </div>
                                <label class="form-label d-block mb-1" style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Safety Talk</label>
                                <input type="text" class="form-control shadow-none border-0 fw-bolder text-center mx-auto" id="targetSafetyTalk" style="width: 80px; background: #f8fafc; font-size: 18px; border-radius: 8px; color: #0f172a;" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 text-end">
                        <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" id="btnSaveTarget" class="btn btn-primary px-4 fw-bold"><i class="bi bi-save me-2"></i>Simpan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Bulk Update -->
<div class="modal fade" id="bulkUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" style="color: #0f172a;"><i class="bi bi-magic text-warning me-2"></i>Update Massal Departemen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-4" style="font-size: 13px;">Ubah kategori pengawas seluruh karyawan di satu departemen sekaligus secara otomatis.</p>
                <form id="formBulkUpdate" onsubmit="bulkUpdate(event)">
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 13px; color: #475569;">Departemen yang akan diupdate</label>
                        <select id="bulkDepartemen" class="form-select shadow-sm" style="font-size: 14px; font-weight: 600; border-radius: 8px; border-color: #cbd5e1; cursor: pointer;" required>
                            <option value="">-- Pilih Departemen --</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold" style="font-size: 13px; color: #475569;">Ubah ke Kategori Pengawas</label>
                        <select id="bulkKategori" class="form-select shadow-sm" style="font-size: 14px; font-weight: 600; border-radius: 8px; border-color: #cbd5e1; cursor: pointer;" required>
                            <option value="Pengawas Area Operasional">Pengawas Area Operasional</option>
                            <option value="Pengawas Support Dept - Non Office">Pengawas Support Dept - Non Office</option>
                            <option value="Pengawas Support Dept - Office">Pengawas Support Dept - Office</option>
                            <option value="-">NON SAP</option>
                        </select>
                        <div class="text-xs text-muted mt-2"><i class="bi bi-info-circle me-1"></i>Angka target tiap individu akan otomatis dihitung berdasarkan Jabatannya.</div>
                    </div>
                    <div class="mt-4 text-end">
                        <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" id="btnSubmitBulk" class="btn btn-warning px-4 fw-bold text-dark"><i class="bi bi-check2-all me-2"></i>Update Semua</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Aturan Target -->
