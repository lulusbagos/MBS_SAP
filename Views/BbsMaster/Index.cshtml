<!-- MODAL 2: TAMBAH / EDIT MASTER DOKUMEN                           -->
<!-- ============================================================== -->
<div class="modal fade" id="modalDocument" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 18px; background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color);">
            <form method="post" action="/BbsMaster/SaveDocument" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="docModalId" value="0" />

                <div class="modal-header py-3 px-4" style="border-bottom: 1px solid var(--border-color);">
                    <h6 class="modal-title fw-bold" id="docModalTitle">Tambah Master Dokumen Standar Baru</h6>
                    <button type="button" class="btn-close btn-close-sap" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row mb-3">
                        <div class="col-12 col-md-5 form-group-sap">
                            <label class="form-label-sap" for="docModalCode">Nomor / Kode Dokumen <span class="text-danger">*</span></label>
                            <input type="text" name="DocCode" id="docModalCode" class="input-sap" required placeholder="Contoh: FM-02-MOP-32.001" />
                        </div>
                        <div class="col-12 col-md-7 form-group-sap">
                            <label class="form-label-sap" for="docModalName">Judul Dokumen / Form <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="docModalName" class="input-sap" required placeholder="Contoh: Form Checklist Pengawas Front Loading Overburden" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6 form-group-sap">
                            <label class="form-label-sap" for="docModalCategory">Kategori Terkait BBS</label>
                            <select name="CategoryId" id="docModalCategory" class="input-sap">
                                <option value="">-- Pilih Kategori --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6 form-group-sap">
                            <label class="form-label-sap" for="docModalTopic">Topik Spesifik Acuan</label>
                            <input type="text" name="TopicName" id="docModalTopic" class="input-sap" placeholder="Contoh: Operasional Front Loading Overburden" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-4 form-group-sap">
                            <label class="form-label-sap" for="docModalRev">Revisi</label>
                            <input type="text" name="Revision" id="docModalRev" class="input-sap" value="00" placeholder="Contoh: Rev. 01" />
                        </div>
                        <div class="col-12 col-md-4 form-group-sap">
                            <label class="form-label-sap" for="docModalDate">Tanggal Efektif</label>
                            <input type="text" name="EffectiveDate" id="docModalDate" class="input-sap" placeholder="Contoh: 10 Sept 2026" />
                        </div>
                        <div class="col-12 col-md-4 form-group-sap">
                            <label class="form-label-sap" for="docModalDept">Departemen</label>
                            <input type="text" name="Department" id="docModalDept" class="input-sap" placeholder="Contoh: Mining Operation" />
                        </div>
                    </div>

                    <div class="mb-3 form-group-sap">
                        <label class="form-label-sap" for="docModalScope">Ruang Lingkup / Cakupan Area</label>
                        <input type="text" name="Scope" id="docModalScope" class="input-sap" placeholder="Contoh: Front Loading OB & Galian Tambang" />
                    </div>

                    <div class="mb-3 form-group-sap">
                        <label class="form-label-sap" for="docModalDesc">Keterangan / Deskripsi Dokumen</label>
                        <textarea name="Description" id="docModalDesc" class="input-sap" rows="2" placeholder="Penjelasan tujuan checklist dan ketentuan pengawasannya..."></textarea>
                    </div>

                    <div class="mb-3 form-group-sap">
                        <label class="form-label-sap" for="docModalFile">Upload Berkas Excel Dokumen (Opsional / Template)</label>
                        <input type="file" name="excelFile" id="docModalFile" class="form-control form-control-sm" accept=".xls,.xlsx" />
                        <small class="text-muted" style="font-size: 11px;">Mendukung format .xlsx dan .xls</small>
                    </div>

                    <div class="row">
                        <div class="col-6 form-group-sap">
                            <label class="form-label-sap" for="docModalSort">Urutan Tampilan</label>
                            <input type="number" name="SortOrder" id="docModalSort" class="input-sap" value="1" />
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="docModalActive" checked />
                                <label class="form-check-label fw-bold" for="docModalActive" style="font-size: 12.5px;">Status Aktif</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2.5 px-4" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn-sap-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-info fw-bold px-4 text-dark" style="border-radius: 14px;">Simpan Dokumen</button>
                </div>
            </form>
        </div>
    </div>
</div>

