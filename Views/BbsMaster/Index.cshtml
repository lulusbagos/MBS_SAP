@{
    ViewData["Title"] = "Master Konten BBS - SAP";
    string activeTab = ViewBag.ActiveTabName ?? "documents";
    int? selCategoryId = ViewBag.CategoryId;
    int? selTopicId = ViewBag.TopicId;
    string searchQuery = ViewBag.SearchQuery ?? "";

    var categories = ViewBag.Categories as List<MBS_SAP.Models.BbsCategory> ?? new List<MBS_SAP.Models.BbsCategory>();
    var topics = ViewBag.Topics as List<MBS_SAP.Models.BbsTopic> ?? new List<MBS_SAP.Models.BbsTopic>();
    var behaviors = ViewBag.Behaviors as List<MBS_SAP.Models.BbsBehavior> ?? new List<MBS_SAP.Models.BbsBehavior>();
    var documents = ViewBag.Documents as List<MBS_SAP.Models.BbsDocument> ?? new List<MBS_SAP.Models.BbsDocument>();

    int totalDocsCount = ViewBag.TotalDocsCount ?? documents.Count;
    int totalChecklistItems = documents.Sum(d => d.TotalItems);
    int totalBehaviorItems = documents.Sum(d => d.BehaviorCount);
    int totalConditionItems = documents.Sum(d => d.ConditionCount);
}

<style>
    .master-tab-btn {
        padding: 9px 20px;
        font-weight: 700;
        font-size: 13px;
        border-radius: 12px;
        border: none;
        background: transparent;
        color: var(--text-muted);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .master-tab-btn:hover {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.05);
    }
    .master-tab-btn.active {
        background: var(--color-primary);
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
    }
    .master-table-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        overflow: hidden;
    }
    .btn-close-sap {
        filter: invert(1) brightness(200%);
        opacity: 0.8;
    }
    body.light-theme .btn-close-sap {
        filter: none;
        opacity: 0.6;
    }
    .master-table-card .table {
        --bs-table-bg: transparent;
        --bs-table-color: var(--text-main);
        --bs-table-hover-bg: rgba(255, 255, 255, 0.04);
        color: var(--text-main);
    }
    body.light-theme .master-table-card {
        background: #ffffff;
        box-shadow: 0 4px 16px rgba(149, 157, 165, 0.08);
    }
    body.light-theme .master-table-card .table {
        --bs-table-hover-bg: rgba(0, 0, 0, 0.03);
        --bs-table-color: var(--text-main);
    }
    body.light-theme .master-table-card thead th {
        color: var(--text-muted);
    }

    .doc-stat-chip {
        padding: 6px 12px;
        border-radius: 10px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border-color);
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 11.5px;
    }
    body.light-theme .doc-stat-chip {
        background: #f8fafc;
    }
</style>

<div class="animate-fade-in pb-5 mb-4">

    <!-- Screen Title -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); font-size: 10.5px; font-weight: 700;">
                    <i class="bi bi-shield-lock-fill me-1"></i>ADMINISTRATOR ONLY
                </span>
                <a asp-controller="Bbs" asp-action="Index" class="badge text-decoration-none" style="background: rgba(2, 132, 199, 0.12); color: var(--color-primary); font-size: 10.5px;">
                    &larr; Form &amp; Riwayat Observasi BBS
                </a>
            </div>
            <div class="screen-title">Master Data Konten BBS &amp; Formulir Acuan</div>
            <p class="screen-subtitle">Kelola dokumen standar checklist (FM-MOP), kategori observasi, topik special case, dan butir perilaku aktif.</p>
        </div>

        <div>
            @if (activeTab == "categories")
            {
                <button type="button" class="btn-sap-primary d-inline-flex align-items-center gap-2" style="padding: 10px 18px; font-size: 13px;" onclick="openCategoryModal()">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Tambah Kategori Baru</span>
                </button>
            }
            else if (activeTab == "topics")
            {
                <button type="button" class="btn btn-warning fw-bold d-inline-flex align-items-center gap-2 text-dark shadow-sm" style="border-radius: 14px; padding: 10px 18px; font-size: 13px;" onclick="openTopicModal()">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Tambah Topik Baru</span>
                </button>
            }
            else if (activeTab == "behaviors")
            {
                <button type="button" class="btn btn-success fw-bold d-inline-flex align-items-center gap-2 shadow-sm" style="border-radius: 14px; padding: 10px 18px; font-size: 13px;" onclick="openBehaviorModal()">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Tambah Butir Perilaku</span>
                </button>
            }
            else
            {
                <button type="button" class="btn btn-info fw-bold d-inline-flex align-items-center gap-2 text-dark shadow-sm" style="border-radius: 14px; padding: 10px 18px; font-size: 13px;" onclick="openDocumentModal()">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Tambah Dokumen Baru</span>
                </button>
            }
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-3" role="alert" style="background-color: rgba(244, 63, 94, 0.15); color: var(--color-red); border-radius: 14px;">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-sap" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-3" role="alert" style="background-color: rgba(34, 197, 94, 0.15); color: var(--color-green); border-radius: 14px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-sap" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Navigation Tabs -->
    <div class="d-flex align-items-center gap-1.5 p-1 rounded-4 mb-3 flex-wrap" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); width: fit-content;">
        <a href="/BbsMaster/Index?tab=documents" class="master-tab-btn @(activeTab == "documents" ? "active" : "")">
            <i class="bi bi-file-earmark-medical-fill"></i>
            <span>1. Master Dokumen Acuan (@documents.Count)</span>
        </a>
        <a href="/BbsMaster/Index?tab=categories" class="master-tab-btn @(activeTab == "categories" ? "active" : "")">
            <i class="bi bi-grid-fill"></i>
            <span>2. Master Kategori (@categories.Count)</span>
        </a>
        <a href="/BbsMaster/Index?tab=topics" class="master-tab-btn @(activeTab == "topics" ? "active" : "")">
            <i class="bi bi-tags-fill"></i>
            <span>3. Master Topik / Kasus (@topics.Count)</span>
        </a>
        <a href="/BbsMaster/Index?tab=behaviors" class="master-tab-btn @(activeTab == "behaviors" ? "active" : "")">
            <i class="bi bi-card-checklist"></i>
            <span>4. Master Butir Perilaku (@behaviors.Count)</span>
        </a>
    </div>

    <!-- ============================================================== -->
    <!-- TAB 1: MASTER DOKUMEN & FORMULIR ACUAN (FM-MOP)                -->
    <!-- ============================================================== -->
    @if (activeTab == "documents")
    {
        <!-- Summary Stats Banner -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 rounded-4 mb-3" style="background: rgba(2, 132, 199, 0.08); border: 1px solid rgba(2, 132, 199, 0.25);">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(2, 132, 199, 0.2); color: var(--color-primary); display: flex; align-items: center; justify-content: center; font-size: 18px;">
                        <i class="bi bi-journal-check"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-primary" style="font-size: 13.5px;">Dokumen Acuan Standar Operasional (MOP)</div>
                        <small class="text-muted">Diintegrasikan langsung dengan basis data butir observasi perilaku dan formulir lapangan.</small>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="doc-stat-chip">
                    <i class="bi bi-files text-primary"></i>
                    <span><strong>@totalDocsCount</strong> Dokumen SOP</span>
                </div>
                <div class="doc-stat-chip">
                    <i class="bi bi-list-check text-info"></i>
                    <span><strong>@totalChecklistItems</strong> Butir Checklist</span>
                </div>
                <div class="doc-stat-chip">
                    <i class="bi bi-shield-check text-success"></i>
                    <span><strong>@totalBehaviorItems</strong> Identifikasi Perilaku</span>
                </div>
                <div class="doc-stat-chip">
                    <i class="bi bi-clipboard-data text-warning"></i>
                    <span><strong>@totalConditionItems</strong> Identifikasi Kondisi</span>
                </div>
            </div>
        </div>

        <div class="master-table-card card-sap p-0 mb-0">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: var(--border-color) !important;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h6 class="fw-bold mb-0 text-info" style="font-size: 13.5px;">
                        <i class="bi bi-file-earmark-spreadsheet-fill me-1"></i>Daftar Master Dokumen &amp; Form Inspeksi
                    </h6>
                    <select class="form-select form-select-sm" style="width: auto; min-width: 190px; border-radius: 8px; font-size: 12px;" onchange="window.location.href='/BbsMaster/Index?tab=documents&categoryId=' + this.value">
                        <option value="">-- Semua Kategori --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(c.Id == selCategoryId)">@c.Name</option>
                        }
                    </select>

                    <form method="get" action="/BbsMaster/Index" class="d-inline-flex gap-1 m-0">
                        <input type="hidden" name="tab" value="documents" />
                        @if (selCategoryId.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@selCategoryId.Value" />
                        }
                        <input type="text" name="search" value="@searchQuery" class="form-control form-control-sm" placeholder="Cari kode/judul dokumen..." style="width: 220px; border-radius: 8px; font-size: 12px;" />
                        <button type="submit" class="btn btn-sm btn-outline-info" style="border-radius: 8px;"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <small class="text-muted">Klik "Lihat Butir Checklist" untuk menampilkan seluruh poin periksa form</small>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 12.5px; color: var(--text-main);">
                    <thead style="background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--border-color);">
                        <tr>
                            <th style="width: 45px;" class="text-center">#</th>
                            <th style="width: 140px;">No. Dokumen</th>
                            <th>Judul &amp; Ruang Lingkup Dokumen</th>
                            <th>Kategori &amp; Topik BBS</th>
                            <th>Departemen</th>
                            <th>Revisi / Tanggal</th>
                            <th>Checklist</th>
                            <th>Status</th>
                            <th class="text-end" style="width: 160px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in documents)
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@doc.SortOrder</td>
                                <td>
                                    <span class="badge" style="background: rgba(2, 132, 199, 0.15); color: #38bdf8; font-size: 11px; font-weight: 700; letter-spacing: 0.3px;">
                                        @doc.DocCode
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold" style="color: var(--text-main); font-size: 13px;">@doc.Title</div>
                                    @if (!string.IsNullOrEmpty(doc.Scope))
                                    {
                                        <small class="text-muted" style="font-size: 11px;"><i class="bi bi-compass me-1"></i>@doc.Scope</small>
                                    }
                                </td>
                                <td>
                                    <div style="font-size: 11.5px; font-weight: 600; color: var(--color-primary);">
                                        @(doc.Category?.Name ?? doc.CategoryName ?? "-")
                                    </div>
                                    @if (!string.IsNullOrEmpty(doc.TopicName))
                                    {
                                        <small class="text-muted" style="font-size: 10.5px;">&rsaquo; @doc.TopicName</small>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted" style="font-size: 11.5px;">@(doc.Department ?? "-")</span>
                                </td>
                                <td>
                                    <div style="font-size: 11px; font-weight: 600;">@(doc.Revision ?? "Rev.00")</div>
                                    <small class="text-muted" style="font-size: 10.5px;">@(doc.EffectiveDate ?? "2026")</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <button type="button" class="badge border-0" style="background: rgba(14, 165, 233, 0.18); color: #38bdf8; font-size: 10.5px; cursor: pointer;" onclick="viewDocumentDetails(@doc.Id)" title="Klik untuk lihat detail checklist">
                                            <strong>@doc.TotalItems</strong> Butir &rarr;
                                        </button>
                                        @if (doc.BehaviorCount > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 9.5px;" title="Butir Perilaku">
                                                @doc.BehaviorCount BBS
                                            </span>
                                        }
                                        @if (doc.ConditionCount > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size: 9.5px;" title="Butir Kondisi/Prasyarat">
                                                @doc.ConditionCount Kondisi
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (doc.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border border-secondary-subtle">Nonaktif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-info" title="Lihat Butir Checklist" onclick="viewDocumentDetails(@doc.Id)">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>

                                        @if (!string.IsNullOrEmpty(doc.FileName))
                                        {
                                            <a href="/BbsMaster/DownloadDocument/@doc.Id" class="btn btn-sm btn-outline-success" title="Download Excel Asli (@doc.FileName)">
                                                <i class="bi bi-file-earmark-excel-fill"></i>
                                            </a>
                                        }

                                        <button type="button" class="btn btn-sm btn-outline-warning" title="Edit Dokumen" onclick='editDocument(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { doc.Id, doc.DocCode, doc.Title, doc.CategoryId, doc.TopicName, doc.Revision, doc.EffectiveDate, doc.Department, doc.Scope, doc.Description, doc.Icon, doc.Color, doc.SortOrder, doc.IsActive })))'>
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>

                                        <form method="post" action="/BbsMaster/ToggleDocument/@doc.Id" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(doc.IsActive ? "btn-outline-secondary" : "btn-outline-success")" title="@(doc.IsActive ? "Nonaktifkan" : "Aktifkan")">
                                                <i class="bi @(doc.IsActive ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                            </button>
                                        </form>

                                        <form method="post" action="/BbsMaster/DeleteDocument/@doc.Id" onsubmit="return confirm('Hapus dokumen ini beserta seluruh butir checklistnya?');" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus Dokumen">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ============================================================== -->
    <!-- TAB 2: MASTER KATEGORI BBS                                     -->
    <!-- ============================================================== -->
    @if (activeTab == "categories")
    {
        <div class="master-table-card card-sap p-0 mb-0">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: var(--border-color) !important;">
                <h6 class="fw-bold mb-0 text-primary" style="font-size: 13.5px;">
                    <i class="bi bi-grid-3x3-gap-fill me-1"></i>Daftar Kategori Observasi BBS
                </h6>
                <small class="text-muted">Kategori memisahkan observasi Rutin, Kasus Khusus, atau Keduanya</small>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 12.5px; color: var(--text-main);">
                    <thead style="background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--border-color);">
                        <tr>
                            <th style="width: 45px;" class="text-center">#</th>
                            <th style="width: 55px;">Icon</th>
                            <th>Nama Kategori</th>
                            <th>Tipe Tampilan</th>
                            <th>Jumlah Topik</th>
                            <th>Jumlah Perilaku</th>
                            <th>Urutan</th>
                            <th>Status</th>
                            <th class="text-end" style="width: 120px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in categories)
                        {
                            var typeClass = cat.CategoryType == "Rutin" ? "bg-primary" : (cat.CategoryType == "SpecialCase" ? "bg-warning text-dark" : "bg-info text-dark");
                            <tr>
                                <td class="text-center text-muted fw-bold">@cat.Id</td>
                                <td>
                                    <div style="width: 34px; height: 34px; border-radius: 8px; background: rgba(2, 132, 199, 0.12); color: @cat.Color; display: flex; align-items: center; justify-content: center; font-size: 16px;">
                                        <i class="bi @cat.Icon"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold">@cat.Name</div>
                                    <small class="text-muted" style="font-size: 11px;">@cat.Description</small>
                                </td>
                                <td>
                                    <span class="badge @typeClass" style="font-size: 10px;">@cat.CategoryType</span>
                                </td>
                                <td>
                                    <a href="/BbsMaster/Index?tab=topics&categoryId=@cat.Id" class="badge text-decoration-none" style="background: rgba(255,255,255,0.06); color: var(--text-main); font-size: 10.5px;">
                                        @(cat.Topics?.Count ?? 0) Topik &rarr;
                                    </a>
                                </td>
                                <td>
                                    <a href="/BbsMaster/Index?tab=behaviors&categoryId=@cat.Id" class="badge text-decoration-none" style="background: rgba(255,255,255,0.06); color: var(--text-main); font-size: 10.5px;">
                                        @(cat.Behaviors?.Count ?? 0) Butir &rarr;
                                    </a>
                                </td>
                                <td class="text-muted">@cat.SortOrder</td>
                                <td>
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border border-secondary-subtle">Nonaktif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-info" title="Edit Kategori" onclick='editCategory(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { cat.Id, cat.Name, cat.CategoryType, cat.Icon, cat.Color, cat.Description, cat.SortOrder, cat.IsActive })))'>
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form method="post" action="/BbsMaster/ToggleCategory/@cat.Id" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(cat.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(cat.IsActive ? "Nonaktifkan" : "Aktifkan")">
                                                <i class="bi @(cat.IsActive ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ============================================================== -->
    <!-- TAB 3: MASTER TOPIK / KASUS BBS                                -->
    <!-- ============================================================== -->
    @if (activeTab == "topics")
    {
        <div class="master-table-card card-sap p-0 mb-0">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: var(--border-color) !important;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h6 class="fw-bold mb-0 text-warning" style="font-size: 13.5px;">
                        <i class="bi bi-tag-fill me-1"></i>Daftar Sub-Kategori / Topik Special Case
                    </h6>
                    <select class="form-select form-select-sm" style="width: auto; min-width: 190px; border-radius: 8px; font-size: 12px;" onchange="window.location.href='/BbsMaster/Index?tab=topics&categoryId=' + this.value">
                        <option value="">-- Semua Kategori --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(c.Id == selCategoryId)">@c.Name</option>
                        }
                    </select>

                    <form method="get" action="/BbsMaster/Index" class="d-inline-flex gap-1 m-0">
                        <input type="hidden" name="tab" value="topics" />
                        @if (selCategoryId.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@selCategoryId.Value" />
                        }
                        <input type="text" name="search" value="@searchQuery" class="form-control form-control-sm" placeholder="Cari topik..." style="width: 180px; border-radius: 8px; font-size: 12px;" />
                        <button type="submit" class="btn btn-sm btn-outline-warning" style="border-radius: 8px;"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <small class="text-muted">Topik mendetailkan fokus observasi (contoh: Operasional Front Loading Overburden)</small>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 12.5px; color: var(--text-main);">
                    <thead style="background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--border-color);">
                        <tr>
                            <th style="width: 45px;" class="text-center">#</th>
                            <th style="width: 55px;">Icon</th>
                            <th>Nama Topik / Kasus</th>
                            <th>Kategori Utama</th>
                            <th>Jumlah Butir Perilaku</th>
                            <th>Urutan</th>
                            <th>Status</th>
                            <th class="text-end" style="width: 120px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in topics)
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@t.Id</td>
                                <td>
                                    <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(245, 158, 11, 0.15); color: #fbbf24; display: flex; align-items: center; justify-content: center; font-size: 15px;">
                                        <i class="bi @t.Icon"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold">@t.Name</div>
                                    <small class="text-muted" style="font-size: 11px;">@t.Description</small>
                                </td>
                                <td>
                                    <span class="badge" style="background: rgba(2, 132, 199, 0.15); color: #38bdf8; font-size: 10.5px;">
                                        @(t.Category?.Name ?? "Umum")
                                    </span>
                                </td>
                                <td>
                                    <a href="/BbsMaster/Index?tab=behaviors&categoryId=@t.CategoryId&topicId=@t.Id" class="badge text-decoration-none" style="background: rgba(255,255,255,0.06); color: var(--text-main); font-size: 10.5px;">
                                        @(t.Behaviors?.Count ?? 0) Butir Perilaku &rarr;
                                    </a>
                                </td>
                                <td class="text-muted">@t.SortOrder</td>
                                <td>
                                    @if (t.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border border-secondary-subtle">Nonaktif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-info" title="Edit Topik" onclick='editTopic(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { t.Id, t.CategoryId, t.Name, t.Icon, t.Description, t.SortOrder, t.IsActive })))'>
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form method="post" action="/BbsMaster/ToggleTopic/@t.Id" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(t.IsActive ? "Nonaktifkan" : "Aktifkan")">
                                                <i class="bi @(t.IsActive ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ============================================================== -->
    <!-- TAB 4: MASTER BUTIR PERILAKU                                   -->
    <!-- ============================================================== -->
    @if (activeTab == "behaviors")
    {
        <div class="master-table-card card-sap p-0 mb-0">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: var(--border-color) !important;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h6 class="fw-bold mb-0 text-success" style="font-size: 13.5px;">
                        <i class="bi bi-card-checklist me-1"></i>Daftar Butir Perilaku yang Diamati
                    </h6>
                    <select class="form-select form-select-sm" style="width: auto; min-width: 180px; border-radius: 8px; font-size: 12px;" onchange="window.location.href='/BbsMaster/Index?tab=behaviors&categoryId=' + this.value">
                        <option value="">-- Filter Kategori --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(c.Id == selCategoryId)">@c.Name</option>
                        }
                    </select>

                    <form method="get" action="/BbsMaster/Index" class="d-inline-flex gap-1 m-0">
                        <input type="hidden" name="tab" value="behaviors" />
                        @if (selCategoryId.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@selCategoryId.Value" />
                        }
                        @if (selTopicId.HasValue)
                        {
                            <input type="hidden" name="topicId" value="@selTopicId.Value" />
                        }
                        <input type="text" name="search" value="@searchQuery" class="form-control form-control-sm" placeholder="Cari teks perilaku..." style="width: 180px; border-radius: 8px; font-size: 12px;" />
                        <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius: 8px;"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <small class="text-muted">Butir pilihan perilaku yang muncul pada formulir observasi BBS</small>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 12.5px; color: var(--text-main);">
                    <thead style="background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--border-color);">
                        <tr>
                            <th style="width: 45px;" class="text-center">#</th>
                            <th>Teks Perilaku</th>
                            <th>Kategori &amp; Topik</th>
                            <th>Klasifikasi</th>
                            <th>Risiko Bawaan</th>
                            <th>Status</th>
                            <th class="text-end" style="width: 120px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in behaviors)
                        {
                            var isSafe = b.DefaultClassification == "Safe";
                            var classBadge = isSafe ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle";

                            <tr>
                                <td class="text-center text-muted fw-bold">@b.Id</td>
                                <td>
                                    <div class="fw-bold">@b.BehaviorText</div>
                                    @if (!string.IsNullOrEmpty(b.GuidanceNote))
                                    {
                                        <small class="text-muted" style="font-size: 11px;"><i class="bi bi-info-circle me-1"></i>@b.GuidanceNote</small>
                                    }
                                </td>
                                <td>
                                    <div style="font-size: 12px; color: var(--color-primary);">@(b.Category?.Name ?? "-")</div>
                                    @if (b.Topic != null)
                                    {
                                        <small class="text-muted" style="font-size: 11px;">&rsaquo; @b.Topic.Name</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge @classBadge" style="font-size: 10px;">
                                        @(isSafe ? "Safe (Aman)" : "At-Risk (Berisiko)")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var rColor = b.DefaultRiskLevel switch
                                        {
                                            "Sangat Tinggi" => "#ef4444",
                                            "Tinggi" => "#f97316",
                                            "Sedang" => "#38bdf8",
                                            _ => "#10b981"
                                        };
                                    }
                                    <span class="badge" style="background: @(rColor)22; color: @rColor; border: 1px solid @(rColor)44; font-size: 10px;">
                                        @(b.DefaultRiskLevel ?? "Sedang")
                                    </span>
                                </td>
                                <td>
                                    @if (b.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border border-secondary-subtle">Nonaktif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-info" title="Edit Perilaku" onclick='editBehavior(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { b.Id, b.CategoryId, b.TopicId, b.BehaviorText, b.DefaultClassification, b.DefaultRiskLevel, b.GuidanceNote, b.SortOrder, b.IsActive })))'>
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form method="post" action="/BbsMaster/ToggleBehavior/@b.Id" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(b.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(b.IsActive ? "Nonaktifkan" : "Aktifkan")">
                                                <i class="bi @(b.IsActive ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="/BbsMaster/DeleteBehavior/@b.Id" onsubmit="return confirm('Hapus butir perilaku ini?');" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<!-- ============================================================== -->
