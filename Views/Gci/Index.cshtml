                                <tr class="border-bottom" style="color: var(--text-muted); border-color: var(--border-color) !important;">
                                    <th>Nama</th>
                                    <th>Role</th>
                                    <th>Deskripsi Tugas</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-color: var(--border-color);">
                                    <td class="fw-bold">@userNama</td>
                                    <td><span class="badge bg-primary" style="font-size: 8.5px;">Inspector</span></td>
                                    <td style="color: var(--text-muted);">Inspeksi lapangan &amp; penilaian GCI</td>
                                </tr>
                                <tr style="border-color: var(--border-color);">
                                    <td class="fw-bold" id="pjaTableDisplay">-</td>
                                    <td><span class="badge bg-warning text-dark" style="font-size: 8.5px;">PJA</span></td>
                                    <td style="color: var(--text-muted);">Review operasional &amp; validasi</td>
                                </tr>
                                <tr style="border-color: var(--border-color);">
                                    <td class="fw-bold" id="picTableDisplay">-</td>
                                    <td><span class="badge bg-info text-dark" style="font-size: 8.5px;">PIC Action</span></td>
                                    <td style="color: var(--text-muted);">Pelaksana tindakan perbaikan lereng</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="form-group-sap mb-0">
                        <label class="form-label-sap" style="font-size: 10px;">Deskripsi Temuan / Catatan Inspeksi:</label>
                        <textarea id="catatan" name="catatan" class="input-sap py-1 px-2" rows="2" style="font-size: 11px;" placeholder="Tuliskan catatan observasi lapangan, kondisi geologi, rembesan air, atau situasi khusus..."></textarea>
                    </div>
                </div>
            </div>

            <!-- PANEL 6: RENCANA TINDAKAN & SEARCH PIC KARYAWAN -->
            <div class="col-12 col-lg-4">
                <div class="card-sap p-3 h-100" style="border-top: 3px solid #ef4444;">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
                        <h6 class="mb-0 d-flex align-items-center gap-1.5 fw-bold" style="font-size: 13px; color: var(--text-main);">
                            <span class="badge bg-danger" style="font-size: 10px;">6</span>
                            <span>TINDAKAN, PIC (SEARCH) &amp; STATUS</span>
                        </h6>
                    </div>

                    <!-- Rekomendasi Tindakan Geoteknik -->
                    <div class="form-group-sap mb-2">
                        <label class="form-label-sap" style="font-size: 10.5px;">
                            <i class="bi bi-shield-check text-success me-1"></i> Rekomendasi Tindakan Geoteknik: <span class="text-danger">*</span>
                        </label>
                        <textarea id="tindakanPerbaikan" name="tindakanPerbaikan" class="input-sap py-1 px-2" rows="2" style="font-size: 11px;" placeholder="Contoh: Pembuatan saluran drainase keliling, perataan crest, atau penutupan retakan..." required></textarea>
                    </div>

                    <!-- PIC PELAKSANA (SEARCH DATA KARYAWAN + NOTIFIKASI) -->
                    <div class="form-group-sap mb-2 position-relative">
                        <label class="form-label-sap d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-fill-check text-info me-1"></i> PIC Pelaksana (Action By)</span>
                            <span class="badge bg-primary" style="font-size: 8.5px;"><i class="bi bi-bell-fill me-1"></i>Notifikasi SAP</span>
                        </label>

                        <!-- Input Pencarian Karyawan -->
                        <div id="picSearchWrapper" class="position-relative">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text" style="background: rgba(14, 165, 233, 0.08); border-color: var(--border-color); color: var(--text-muted);">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" id="picSearchInput" class="input-sap" placeholder="Ketik Nama / NIK karyawan PIC..." autocomplete="off" oninput="searchPicLive(this.value)" />
                            </div>
                            
                            <!-- Dropdown Hasil Pencarian Karyawan -->
                            <div id="picSearchResults" class="position-absolute shadow-lg rounded-3 mt-1 w-100 d-none" style="z-index: 1050; max-height: 210px; overflow-y: auto; background: var(--bg-card); border: 1px solid var(--border-color);">
                            </div>
                        </div>

                        <!-- Card PIC Terpilih -->
                        <div id="picSelectedCard" class="p-2 rounded-2 mt-1.5 d-flex align-items-center justify-content-between d-none" style="background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.3);">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #38bdf8); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 11px;" id="picAvatar">
                                    ?
                                </div>
                                <div>
                                    <div class="fw-bold" style="font-size: 11.5px; color: var(--text-main);" id="picNamaText">-</div>
                                    <div style="font-size: 9.5px; color: var(--text-muted);" id="picDetailText">Pilih PIC pelaksana perbaikan</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 10px; border-radius: 6px;" onclick="clearSelectedPic()">
                                <i class="bi bi-pencil-square"></i> Ganti
                            </button>
                        </div>

                        <input type="hidden" id="pic" name="pic" value="" />
                        <input type="hidden" id="picNik" name="picNik" value="" />
                        <div style="font-size: 9.5px; color: var(--text-muted);" class="mt-1">
                            <i class="bi bi-info-circle me-1"></i>PIC terpilih akan otomatis menerima notifikasi tugas perbaikan di dashboard &amp; lonceng SAP.
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-auto pt-2 border-top" style="border-color: var(--border-color) !important;">
                        <button type="button" class="btn btn-outline-secondary py-2.5 px-3 d-none" id="btnCancelEdit" style="border-radius: 10px; font-weight: 600; font-size: 13px;" onclick="resetGciForm()">
                            Batal Edit
                        </button>
                        <button type="submit" id="btnSubmitGci" class="btn btn-primary flex-grow-1 shadow-sm font-weight-bold py-2.5 d-flex align-items-center justify-content-center gap-1.5" style="background: linear-gradient(135deg, #0284c7, #38bdf8); border: none; font-size: 13.5px; border-radius: 10px;">
                            <i class="bi bi-save-fill"></i>
                            <span id="btnSubmitText">Submit Inspeksi &amp; Kirim Tugas</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- 3. TABEL RIWAYAT LAPORAN INSPEKSI GCI & FILTER SECTION -->
    <div class="mt-4" id="riwayatTableSection">
        <div class="card-sap p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
                <div>
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2" style="color: var(--text-main); font-size: 15px;">
                        <i class="bi bi-journal-text text-primary"></i>
                        <span>Riwayat Laporan Geotechnical Condition Index (GCI)</span>
                        <span class="badge bg-secondary" style="font-size: 11px;">@reportsList.Count Laporan</span>
                    </h5>
                    <p class="mb-0 text-muted" style="font-size: 11px;">Daftar lengkap hasil inspeksi lereng geoteknik, status TARP, dan tindak lanjut perbaikan.</p>
                </div>
            </div>

            <!-- Filter Bar Form (GET) -->
            <form method="get" asp-action="Index" class="mb-3 p-2.5 rounded-3" style="background: rgba(14, 165, 233, 0.04); border: 1px solid var(--border-color);">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text" style="background: var(--bg-card); border-color: var(--border-color); color: var(--text-muted);"><i class="bi bi-search"></i></span>
                            <input type="text" name="search" class="form-control input-sap" placeholder="Cari pelapor, lereng, pit..." value="@ViewBag.CurrentSearch" />
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <select name="pit" class="input-sap py-1">
                            <option value="">Semua Pit / Sektor</option>
                            @if (pitList != null)
                            {
                                @foreach (var p in pitList)
                                {
                                    if (p == (string)ViewBag.CurrentPit)
                                    {
                                        <option value="@p" selected>@p</option>
                                    }
                                    else
                                    {
                                        <option value="@p">@p</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <select name="tarpLevel" class="input-sap py-1">
                            <option value="">Semua Status TARP</option>
                            <option value="GREEN" selected="@(ViewBag.CurrentTarpLevel == "GREEN")">GREEN (TARP 0)</option>
                            <option value="YELLOW" selected="@(ViewBag.CurrentTarpLevel == "YELLOW")">YELLOW (TARP 1)</option>
                            <option value="ORANGE" selected="@(ViewBag.CurrentTarpLevel == "ORANGE")">ORANGE (TARP 2)</option>
                            <option value="RED" selected="@(ViewBag.CurrentTarpLevel == "RED")">RED (TARP 3)</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <input type="date" name="startDate" class="input-sap py-1" value="@ViewBag.StartDate" title="Tanggal Mulai" />
                    </div>
                    <div class="col-6 col-md-2">
                        <input type="date" name="endDate" class="input-sap py-1" value="@ViewBag.EndDate" title="Tanggal Selesai" />
                    </div>
                    <div class="col-12 col-md-1 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary flex-fill" style="background: #0284c7; border: none; border-radius: 8px;">
                            <i class="bi bi-filter"></i> Filter
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filter" style="border-radius: 8px;">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </div>
            </form>

            <!-- Table Riwayat Laporan -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 11.5px; color: var(--text-main);">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-size: 11px;">
                            <th style="width: 40px;">No</th>
                            <th>Tanggal &amp; Waktu</th>
                            <th>Judul / Temuan</th>
                            <th>Pit &amp; Sektor</th>
                            <th>Nama Lereng &amp; Tipe</th>
                            <th>Skor GCI</th>
                            <th>TARP Status</th>
                            <th>Inspector / PJA</th>
                            <th>PIC &amp; Target</th>
                            <th class="text-center" style="width: 100px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!reportsList.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                    Belum ada data laporan GCI untuk filter periode ini.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int no = 1;
                            foreach (var r in reportsList)
                            {
                                string tarpBadgeClass = r.TarpLevel switch
                                {
                                    "RED" => "bg-danger",
                                    "ORANGE" => "bg-warning text-dark",
                                    "YELLOW" => "bg-warning text-dark",
                                    _ => "bg-success"
                                };

                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td class="text-muted fw-bold">@no</td>
                                    <td>
                                        <div class="fw-bold">@r.Tanggal.ToString("dd MMM yyyy")</div>
                                        <div style="font-size: 10px; color: var(--text-muted);">@r.Waktu.ToString(@"hh\:mm") &bull; @(r.Shift ?? "Day Shift")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-truncate" style="max-width: 200px;" title="@r.JudulTemuan">
                                            @(string.IsNullOrEmpty(r.JudulTemuan) ? "Inspeksi Kestabilan Lereng" : r.JudulTemuan)
                                        </div>
                                        <div style="font-size: 10px; color: var(--text-muted);">
                                            @(r.JenisInspeksi ?? "Inspeksi Rutin")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; border: 1px solid rgba(14, 165, 233, 0.25); font-size: 10.5px;">
                                            @(string.IsNullOrEmpty(r.Pit) ? "-" : r.Pit)
                                        </span>
                                        @if (!string.IsNullOrEmpty(r.Area) && r.Area != r.Pit)
                                        {
                                            <div style="font-size: 9.5px; color: var(--text-muted);" class="mt-0.5">@r.Area</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(r.NamaLereng ?? r.Lokasi)</div>
                                        <div style="font-size: 10px; color: var(--text-muted);">
                                            Tipe: @(r.AreaType ?? "Highwall") &bull; RL: @(r.ElevasiRl.HasValue ? r.ElevasiRl.Value.ToString("0") + "m" : "-")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold" style="font-size: 12px;">@r.TotalScore%</span>
                                        <div style="font-size: 10px; color: var(--text-muted);">@r.KategoriIndex</div>
                                    </td>
                                    <td>
                                        <span class="badge @tarpBadgeClass px-2 py-1" style="font-size: 10.5px; font-weight: 700;">
                                            TARP @r.TarpLevel
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@r.Nama</div>
                                        <div style="font-size: 10px; color: var(--text-muted);">PJA: @(string.IsNullOrEmpty(r.PjaNama) ? "-" : r.PjaNama)</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 140px;">@(string.IsNullOrEmpty(r.Pic) ? "-" : r.Pic)</div>
                                        <div style="font-size: 10px; color: var(--text-muted);">
                                            Target: @(r.DueDate.HasValue ? r.DueDate.Value.ToString("dd/MM/yy") : "-")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-info py-0.5 px-1.5" title="Muat / Edit Form" onclick="loadReportToForm(@System.Text.Json.JsonSerializer.Serialize(r))">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary py-0.5 px-1.5" title="Lihat Detail" onclick="showDetailModal(@System.Text.Json.JsonSerializer.Serialize(r))">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus laporan GCI di @(r.NamaLereng ?? r.Lokasi)?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger py-0.5 px-1.5" title="Hapus">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                no++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DETAIL LAPORAN GCI -->
<div class="modal fade" id="modalGciDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header pb-2" style="border-bottom: 1px solid var(--border-color);">
                <div>
                    <h6 class="modal-title fw-bold d-flex align-items-center gap-2" style="color: var(--text-main);">
                        <i class="bi bi-triangle-half text-primary"></i>
                        <span id="modalDetailTitle">Detail Laporan Geoteknik (GCI)</span>
                    </h6>
                    <div style="font-size: 11px; color: var(--text-muted);" id="modalDetailSubtitle">-</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="font-size: 12px; color: var(--text-main);" id="modalDetailBody">
                <!-- Content will be rendered dynamically -->
            </div>
            <div class="modal-footer pt-2" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styling Elegan & Adaptif Mode Terang / Gelap */
    .form-group-sap {
        margin-bottom: 0.65rem;
    }
    .form-label-sap {
        color: var(--text-muted);
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 3px;
        display: block;
    }
    .input-sap {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-main);
        font-size: 12px;
        width: 100%;
        padding: 6px 10px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .input-sap:focus {
        border-color: #0284c7;
        outline: none;
        box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.2);
    }
    .emp-search-item {
        padding: 8px 12px;
        cursor: pointer;
        border-bottom: 1px solid var(--border-color);
        transition: background 0.15s ease;
    }
    .emp-search-item:hover {
        background: rgba(14, 165, 233, 0.1);
    }
    .emp-search-item:last-child {
        border-bottom: none;
    }

    /* Penyesuaian Responsif & Tampilan Mobile */
    @@media (max-width: 768px) {
        .gci-container {
            padding-bottom: 95px !important;
        }
        .card-sap {
            padding: 12px !important;
            margin-bottom: 12px !important;
            border-radius: 12px !important;
        }
        .screen-title {
            font-size: 14.5px !important;
        }
        .screen-subtitle {
            font-size: 10px !important;
        }
        .kpi-num {
            font-size: 1.25rem !important;
        }
        .btn {
            min-height: 36px;
        }
        .btn-group-sm > .btn {
            padding: 3px 6px;
            font-size: 9.5px;
        }
        .input-group > .input-sap {
            font-size: 11.5px;
        }
    }
</style>

@section Scripts {
<script>
    // Set Pit dari Dropdown atau Pilihan Cepat
    function setPitValue(val) {
        $('#pit').val(val);
        syncPitArea();
    }

    function syncPitArea() {
        updateLokasiFull();
    }

    function updateLokasiFull() {
        const pitVal = ($('#pit').val() || '').trim();
        const areaVal = ($('#area').val() || '').trim();
        const lerengVal = ($('#namaLereng').val() || '').trim();
        const elVal = $('#elevasiRl').val() ? ` EL ${$('#elevasiRl').val()}m` : '';

        let parts = [];
        if (pitVal) parts.push(pitVal);
        if (areaVal) parts.push(areaVal);
        if (lerengVal) parts.push(lerengVal);

        let loc = parts.join(' - ');
        if (elVal) loc += elVal;

        $('#lokasi').val(loc || 'Area Geoteknik');
    }

    // Live Search PIC (Action By)
    let picSearchTimeout = null;
    function searchPicLive(query) {
        clearTimeout(picSearchTimeout);
        if (!query || query.trim().length < 1) {
            $('#picSearchResults').addClass('d-none').empty();
            return;
        }

        picSearchTimeout = setTimeout(function() {
            $.getJSON('/Gci/SearchEmployees?q=' + encodeURIComponent(query), function(data) {
                const resultsContainer = $('#picSearchResults');
                resultsContainer.empty();

                if (!data || data.length === 0) {
                    resultsContainer.html('<div class="p-2 text-center text-muted" style="font-size: 11px;">Tidak ditemukan karyawan dengan kata kunci tersebut</div>').removeClass('d-none');
                    return;
                }

                data.forEach(function(emp) {
                    const initials = (emp.nama || 'XX').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
                    const itemHtml = `
                        <div class="emp-search-item d-flex align-items-center gap-2" onclick="selectPic('${emp.nik}', '${emp.nama.replace(/'/g, "\\'")}', '${(emp.jabatan || '').replace(/'/g, "\\'")}', '${(emp.perusahaan || '').replace(/'/g, "\\'")}')">
                            <div style="width: 28px; height: 28px; border-radius: 50%; background: #0284c7; color: white; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0;">
                                ${initials}
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="fw-bold text-truncate" style="font-size: 11.5px; color: var(--text-main);">${emp.nama}</div>
                                <div style="font-size: 9.5px; color: var(--text-muted);">NIK: ${emp.nik} &bull; ${emp.jabatan || 'Staff'} &bull; ${emp.perusahaan || ''}</div>
                            </div>
                        </div>
                    `;
                    resultsContainer.append(itemHtml);
                });
                resultsContainer.removeClass('d-none');
            }).fail(function() {
                $('#picSearchResults').html('<div class="p-2 text-center text-danger" style="font-size: 11px;">Gagal memuat data karyawan</div>').removeClass('d-none');
            });
        }, 250);
    }

    function selectPic(nik, nama, jabatan, perusahaan) {
        $('#pic').val(nama);
        $('#picNik').val(nik);
        $('#picNamaText').text(nama);
        $('#picDetailText').text(`NIK: ${nik} • ${jabatan || 'Pelaksana'} • ${perusahaan || ''}`);
        $('#picTableDisplay').text(nama);
        
        const initials = (nama || 'XX').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
        $('#picAvatar').text(initials);

        $('#picSearchInput').val('');
        $('#picSearchResults').addClass('d-none');
        $('#picSearchWrapper').addClass('d-none');
        $('#picSelectedCard').removeClass('d-none');
    }

    function clearSelectedPic() {
        $('#pic').val('');
        $('#picNik').val('');
        $('#picTableDisplay').text('-');
        $('#picSearchWrapper').removeClass('d-none');
        $('#picSelectedCard').addClass('d-none');
        $('#picSearchInput').focus();
    }

    // Live Search PJA (Supervisor)
    let pjaSearchTimeout = null;
    function searchPjaLive(query) {
        clearTimeout(pjaSearchTimeout);
        if (!query || query.trim().length < 1) {
            $('#pjaSearchResults').addClass('d-none').empty();
            return;
        }

        pjaSearchTimeout = setTimeout(function() {
            $.getJSON('/Gci/SearchEmployees?q=' + encodeURIComponent(query), function(data) {
                const resultsContainer = $('#pjaSearchResults');
                resultsContainer.empty();

                if (!data || data.length === 0) {
                    resultsContainer.html('<div class="p-2 text-center text-muted" style="font-size: 11px;">Tidak ditemukan data</div>').removeClass('d-none');
                    return;
                }

                data.forEach(function(emp) {
                    const itemHtml = `
                        <div class="emp-search-item" onclick="selectPja('${emp.nik}', '${emp.nama.replace(/'/g, "\\'")}')">
                            <div class="fw-bold text-truncate" style="font-size: 11.5px; color: var(--text-main);">${emp.nama}</div>
                            <div style="font-size: 9.5px; color: var(--text-muted);">NIK: ${emp.nik} &bull; ${emp.jabatan || 'Supervisor'} &bull; ${emp.perusahaan || ''}</div>
                        </div>
                    `;
                    resultsContainer.append(itemHtml);
                });
                resultsContainer.removeClass('d-none');
            });
        }, 250);
    }

    function selectPja(nik, nama) {
        $('#pjaNama').val(nama);
        $('#pjaNik').val(nik);
        $('#pjaSearchInput').val(nama);
        $('#pjaTableDisplay').text(nama);
        $('#pjaSearchResults').addClass('d-none');
    }

    // Tutup dropdown jika klik di luar
    $(document).on('click', function(e) {
        if (!$(e.target).closest('#picSearchWrapper').length) {
            $('#picSearchResults').addClass('d-none');
        }
        if (!$(e.target).closest('#pjaSearchInput, #pjaSearchResults').length) {
            $('#pjaSearchResults').addClass('d-none');
        }
    });

    function selectAreaType(type, btn) {
        $('#areaType').val(type);
        $('#areaTypeTabs button').removeClass('active btn-outline-info').addClass('btn-outline-secondary');
        $(btn).addClass('active btn-outline-info').removeClass('btn-outline-secondary');
    }

    function renderBenchSvg() {
        const h = $('#tinggiJenjang').val();
        const b = $('#lebarBerm').val();
        const f = $('#actualFaceAngle').val();

        $('#svgHeightText').text(h ? `H: ${h}m` : 'H: -');
        $('#svgBermText').text(b ? `Berm: ${b}m` : 'Berm: -');
        $('#svgFaceText').text(f ? `Face: ${f}°` : 'Face: -');
    }

    function previewUpload(input, targetLabel) {
        if (input.files && input.files[0]) {
            $(targetLabel).text(input.files[0].name);
        } else {
            $(targetLabel).text('Belum ada file dipilih');
        }
    }

    function updateMockupScores() {
        const crackVal = $('input[name="kondisiRetakan"]:checked').val() || "Tidak Ada";
        const seepVal = $('input[name="kondisiRembesan"]:checked').val() || "Tidak Ada";
        const bulgVal = $('input[name="kondisiBulging"]:checked').val() || "Tidak Ada";
        const rockVal = $('input[name="kondisiRockfall"]:checked').val() || "Tidak Ada";
        const crackMm = parseFloat($('#lebarRetakanMm').val()) || 0;

        let score = 100.0;
        let tarp = "TARP 0 - NORMAL";
        let tarpBadge = "bg-success";
        let tarpBorder = "#10b981";
        let tarpBg = "rgba(16, 185, 129, 0.12)";
        let hint = "Kondisi lereng stabil & aman untuk operasional.";

        if (crackVal === "Ada (Signifikan)" || bulgVal === "Ada" || crackMm >= 50) {
            score = 60.0;
            tarp = "TARP 2 - ACTION";
            tarpBadge = "bg-warning text-dark";
            tarpBorder = "#f97316";
            tarpBg = "rgba(249, 115, 22, 0.12)";
            hint = `Ketidaksesuaian kritis / retakan signifikan (${crackMm} mm)! Terapkan zona eksklusi & perbaikan dumping.`;
            $('#skorTensionCrack').val(40);
            $('#skorKestabilanBatuan').val(bulgVal === "Ada" ? 40 : 70);
        } else if (crackVal === "Ada (Minor)" || seepVal === "Ada" || rockVal === "Ada" || crackMm > 0) {
            score = 80.0;
            tarp = "TARP 1 - ALERT";
            tarpBadge = "bg-warning text-dark";
            tarpBorder = "#eab308";
            tarpBg = "rgba(234, 179, 8, 0.12)";
            hint = `Retakan minor (${crackMm} mm) / rembesan air / rockfall terdeteksi. Tingkatkan monitoring berkala.`;
            $('#skorTensionCrack').val(crackMm > 0 ? 70 : 100);
            $('#skorRembesanDrainase').val(seepVal === "Ada" ? 70 : 100);
            $('#skorKestabilanBatuan').val(rockVal === "Ada" ? 70 : 100);
        } else {
            $('#skorTensionCrack').val(100);
            $('#skorKestabilanBatuan').val(100);
            $('#skorRembesanDrainase').val(100);
        }

        $('#gciScoreDisplay').text(score.toFixed(1) + "%");
        $('#tarpBadgeDisplay').text(tarp).attr('class', `badge ${tarpBadge} fw-bold px-2 py-1`);
        $('#tarpSummaryCard').css({ 'border-color': tarpBorder, 'background': tarpBg });
        $('#tarpActionHint').text(hint);
    }

    function resetGciForm() {
        // Reset form inputs
        $('#formGci')[0].reset();
        $('#gciId').val('');
        $('#judulTemuan').val('');
        $('#dueDate').val('');
        $('#tanggal').val('@DateTime.Today.ToString("yyyy-MM-dd")');
        $('#waktuStr').val('@DateTime.Now.ToString("HH:mm")');
        $('#shift').val('Day Shift');
        $('#perusahaan').val('PT Indexim Coalindo');
        $('#pjaSearchInput').val('');
        $('#pjaNama').val('');
        $('#pjaNik').val('');
        $('#pjaTableDisplay').text('-');

        // Reset Pit, Sektor & Lokasi
        $('#pit').val('');
        $('#area').val('');
        $('#namaLereng').val('');
        $('#elevasiRl').val('');
        $('#detilLokasi').val('');
        $('#latitude').val('');
        $('#longitude').val('');
        $('#lokasi').val('');

        // Reset Geometri
        $('#tinggiJenjang').val('');
        $('#lebarBerm').val('');
        $('#actualFaceAngle').val('');
        $('#designFaceAngle').val('');
        $('#overallSlopeAngle').val('');
        $('#kondisiDesain').val('Sesuai');

        // Reset Radio Fisik
        $('#crackNo').prop('checked', true);
        $('#rockNo').prop('checked', true);
        $('#bulgNo').prop('checked', true);
        $('#seepNo').prop('checked', true);
        $('#debitRembesan').val('');

        // Reset Ukur Retakan
        $('#lebarRetakanMm').val('');
        $('#panjangRetakanM').val('');
        $('#kedalamanRetakanM').val('');
        $('#arahRetakan').val('');
        $('#pertumbuhanRetakan').val('Tidak');
        $('#kecepatanRetakan').val('');

        // Reset Foto Labels
        $('#fotoTemuanName').text('Belum ada file dipilih');
        $('#fotoRekomendasiName').text('Belum ada file dipilih');
        $('#petaDesainName').text('Belum ada file dipilih');

        // Reset Catatan & Tindakan
        $('#catatan').val('');
        $('#tindakanPerbaikan').val('');

        // Reset PIC
        clearSelectedPic();

        // Reset Edit Mode UI
        $('#editModeBadge').addClass('d-none');
        $('#btnCancelEdit').addClass('d-none');
        $('#btnSubmitText').text('Submit Inspeksi & Kirim Tugas');

        renderBenchSvg();
        updateMockupScores();
    }

    function loadReportToForm(report) {
        if (!report) return;

        // Set ID & Edit mode
        $('#gciId').val(report.Id);
        $('#editModeBadge').removeClass('d-none');
        $('#btnCancelEdit').removeClass('d-none');
        $('#btnSubmitText').text('Perbarui Laporan GCI #' + report.Id);

        // Header
        $('#judulTemuan').val(report.JudulTemuan || '');
        if (report.DueDate) {
            $('#dueDate').val(report.DueDate.substring(0, 10));
        } else {
            $('#dueDate').val('');
        }

        // Panel 1
        $('#jenisInspeksi').val(report.JenisInspeksi || 'Inspeksi Rutin');
        if (report.Tanggal) {
            $('#tanggal').val(report.Tanggal.substring(0, 10));
        }
        if (report.Waktu) {
            $('#waktuStr').val(typeof report.Waktu === 'string' ? report.Waktu.substring(0, 5) : '08:00');
        }
        $('#shift').val(report.Shift || 'Day Shift');
        $('#perusahaan').val(report.Perusahaan || 'PT Indexim Coalindo');

        if (report.PjaNama) {
            selectPja(report.PjaNik || '', report.PjaNama);
        } else {
            $('#pjaSearchInput').val('');
            $('#pjaNama').val('');
            $('#pjaNik').val('');
            $('#pjaTableDisplay').text('-');
        }

        // Pit, Sektor & Lokasi
        $('#pit').val(report.Pit || '');
        $('#area').val(report.Area || '');
        $('#namaLereng').val(report.NamaLereng || '');
        $('#elevasiRl').val(report.ElevasiRl || '');
        $('#detilLokasi').val(report.DetilLokasi || '');
        $('#latitude').val(report.Latitude || '');
        $('#longitude').val(report.Longitude || '');
        $('#lokasi').val(report.Lokasi || '');

        // Panel 2
        if (report.AreaType) {
            const btn = $(`#areaTypeTabs button:contains("${report.AreaType}")`);
            if (btn.length) {
                selectAreaType(report.AreaType, btn[0]);
            } else {
                $('#areaType').val(report.AreaType);
            }
        }
        $('#tinggiJenjang').val(report.TinggiJenjang || '');
        $('#lebarBerm').val(report.LebarBerm || '');
        $('#actualFaceAngle').val(report.ActualFaceAngle || '');
        $('#designFaceAngle').val(report.DesignFaceAngle || '');
        $('#overallSlopeAngle').val(report.OverallSlopeAngle || '');
        $('#kondisiDesain').val(report.KondisiDesain || 'Sesuai');

        // Radios Fisik
        if (report.KondisiRetakan === 'Ada (Signifikan)') $('#crackSig').prop('checked', true);
        else if (report.KondisiRetakan === 'Ada (Minor)') $('#crackMin').prop('checked', true);
        else $('#crackNo').prop('checked', true);

        if (report.KondisiRockfall === 'Ada') $('#rockAda').prop('checked', true);
        else $('#rockNo').prop('checked', true);

        if (report.KondisiBulging === 'Ada') $('#bulgAda').prop('checked', true);
        else $('#bulgNo').prop('checked', true);

        if (report.KondisiRembesan === 'Ada') $('#seepAda').prop('checked', true);
        else $('#seepNo').prop('checked', true);

        $('#debitRembesan').val(report.DebitRembesan || '');

        // Panel 3
        $('#lebarRetakanMm').val(report.LebarRetakanMm || '');
        $('#panjangRetakanM').val(report.PanjangRetakanM || '');
        $('#kedalamanRetakanM').val(report.KedalamanRetakanM || '');
        $('#arahRetakan').val(report.ArahRetakan || '');
        $('#pertumbuhanRetakan').val(report.PertumbuhanRetakan || 'Tidak');
        $('#kecepatanRetakan').val(report.KecepatanRetakan || '');

        // Panel 4 foto
        $('#fotoTemuanName').text(report.FotoTemuanUrl ? 'File tersimpan sebelumnya' : 'Belum ada file dipilih');
        $('#fotoRekomendasiName').text(report.FotoRekomendasiUrl ? 'File tersimpan sebelumnya' : 'Belum ada file dipilih');
        $('#petaDesainName').text(report.PetaDesainUrl ? 'File tersimpan sebelumnya' : 'Belum ada file dipilih');

        // Panel 5 & 6
        $('#catatan').val(report.Catatan || '');
        $('#tindakanPerbaikan').val(report.TindakanPerbaikan || '');

        if (report.Pic) {
            selectPic(report.PicNik || '', report.Pic, 'PIC', '');
        } else {
            clearSelectedPic();
        }

        renderBenchSvg();
        updateMockupScores();

        // Scroll to form smoothly
        $('html, body').animate({
            scrollTop: $('#formHeaderCard').offset().top - 80
        }, 300);
    }

