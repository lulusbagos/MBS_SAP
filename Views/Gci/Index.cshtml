@model IEnumerable<MBS_SAP.Models.GciReport>
@{
    ViewData["Title"] = "Geotechnical Inspection & Hazard Management - SAP";
    var userNik = ViewBag.UserNik as string ?? "00000";
    var userNama = ViewBag.UserNama as string ?? "Andi Pratama";
    var userDept = ViewBag.UserDept as string ?? "Geotechnical Engineering";
    var userCompany = ViewBag.UserCompany as string ?? "PT INDEXIM COALINDO";
    var pitList = ViewBag.PitList as List<string> ?? new List<string>();
    var totalReports = ViewBag.TotalReports as int? ?? (Model != null ? Model.Count() : 0);
    var avgScore = ViewBag.AvgScore as double? ?? 100.0;
    var goodCount = ViewBag.GoodCount as int? ?? 0;
    var fairCount = ViewBag.FairCount as int? ?? 0;
    var poorCount = ViewBag.PoorCount as int? ?? 0;
    var tarpGreenCount = ViewBag.TarpGreenCount as int? ?? 0;
    var tarpYellowCount = ViewBag.TarpYellowCount as int? ?? 0;
    var tarpOrangeCount = ViewBag.TarpOrangeCount as int? ?? 0;
    var tarpRedCount = ViewBag.TarpRedCount as int? ?? 0;
    var reportsList = Model != null ? Model.ToList() : new List<MBS_SAP.Models.GciReport>();
}

<div class="animate-fade-in gci-container pb-5">
    <!-- Top Header Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <div class="screen-title d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-triangle-half" style="color: #0284c7;"></i>
                <span style="font-weight: 800; letter-spacing: -0.3px; color: var(--text-main);">Geotechnical Inspection &amp; Hazard Management</span>
                <span class="badge" style="background: linear-gradient(135deg, #0284c7, #38bdf8); color: white; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 6px; letter-spacing: 0.5px;">
                    MBS GEOTEKNIK
                </span>
                <span class="badge" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; border: 1px solid rgba(14, 165, 233, 0.25); font-size: 11px; padding: 4px 10px; border-radius: 8px;">
                    PT Indexim Coalindo
                </span>
            </div>
            <p class="screen-subtitle mb-0 text-muted" style="font-size: 11.5px;">Sistem Inspeksi Kestabilan Lereng &amp; Penanganan Ketidaksesuaian Geoteknik Berdasarkan Kepmen ESDM 1827 K/30/MEM/2018.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap w-100 w-sm-auto justify-content-start justify-content-sm-end">
            <div class="d-flex align-items-center gap-2 px-3 py-1.5 rounded-3 d-none d-md-flex" style="background: var(--bg-card); border: 1px solid var(--border-color);">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #38bdf8); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 13px;">
                    @(userNama.Length >= 2 ? userNama.Substring(0, 2).ToUpper() : "AP")
                </div>
                <div>
                    <div style="font-size: 12px; font-weight: 700; color: var(--text-main);">@userNama</div>
                    <div style="font-size: 10px; color: var(--text-muted);">@userDept</div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1 shadow-sm flex-fill flex-sm-grow-0" style="border-radius: 10px; padding: 7px 12px; font-weight: 600; font-size: 11.5px;" onclick="resetGciForm()">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Reset Form</span>
            </button>
            <a href="#riwayatTableSection" class="btn btn-sm btn-outline-info d-flex align-items-center justify-content-center gap-1 shadow-sm flex-fill flex-sm-grow-0" style="border-radius: 10px; padding: 7px 12px; font-weight: 600; font-size: 11.5px;">
                <i class="bi bi-table"></i>
                <span>Riwayat (@reportsList.Count)</span>
            </a>
            <a asp-action="ExportExcel" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-sm btn-outline-success d-flex align-items-center justify-content-center gap-1 shadow-sm flex-fill flex-sm-grow-0" style="border-radius: 10px; padding: 7px 12px; font-weight: 600; font-size: 11.5px;">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Export Excel</span>
            </a>
        </div>
    </div>

    <!-- Status Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-3 shadow-sm" role="alert" style="background-color: rgba(34, 197, 94, 0.15); color: #15803d; border-radius: 12px; border: 1px solid rgba(34, 197, 94, 0.3);">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-3 shadow-sm" role="alert" style="background-color: rgba(239, 68, 68, 0.15); color: #b91c1c; border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.3);">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. Top Summary Metric Cards (Mobile: 2 per row, Desktop: 5 per row) -->
    <div class="row g-2 mb-3">
        <!-- Card 1: Total Hazard -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card-sap p-2 p-md-3 h-100" style="border-left: 4px solid #0284c7;">
                <div style="color: var(--text-muted); font-size: 10px; font-weight: 700; text-transform: uppercase;">Total MTD</div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold kpi-num" style="color: var(--text-main); font-size: 1.5rem;">@totalReports</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 9.5px;" class="mt-1">Rata-rata: <strong>@avgScore%</strong></div>
            </div>
        </div>

        <!-- Card 2: Critical TARP 3 -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card-sap p-2 p-md-3 h-100" style="border-left: 4px solid #ef4444; background: rgba(239, 68, 68, 0.04);">
                <div class="text-danger fw-bold" style="font-size: 10px; text-transform: uppercase;">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i> TARP 3 (Red)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold text-danger kpi-num" style="font-size: 1.5rem;">@tarpRedCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 9.5px;" class="mt-1">Kritis / Evakuasi</div>
            </div>
        </div>

        <!-- Card 3: Action TARP 2 -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card-sap p-2 p-md-3 h-100" style="border-left: 4px solid #f97316; background: rgba(249, 115, 22, 0.04);">
                <div style="color: #ea580c; font-size: 10px; font-weight: 700; text-transform: uppercase;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> TARP 2 (Orange)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold kpi-num" style="color: #ea580c; font-size: 1.5rem;">@tarpOrangeCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 9.5px;" class="mt-1">Mitigasi Diperlukan</div>
            </div>
        </div>

        <!-- Card 4: Alert TARP 1 -->
        <div class="col-6 col-md-4 col-xl">
            <div class="card-sap p-2 p-md-3 h-100" style="border-left: 4px solid #eab308; background: rgba(234, 179, 8, 0.04);">
                <div style="color: #ca8a04; font-size: 10px; font-weight: 700; text-transform: uppercase;">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> TARP 1 (Yellow)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold kpi-num" style="color: #ca8a04; font-size: 1.5rem;">@tarpYellowCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 9.5px;" class="mt-1">Tingkatkan Monitoring</div>
            </div>
        </div>

        <!-- Card 5: Normal TARP 0 -->
        <div class="col-12 col-md-4 col-xl">
            <div class="card-sap p-2 p-md-3 h-100" style="border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.04);">
                <div class="text-success fw-bold" style="font-size: 10px; text-transform: uppercase;">
                    <i class="bi bi-check-circle-fill me-1"></i> TARP 0 (Green)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold text-success kpi-num" style="font-size: 1.5rem;">@tarpGreenCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 9.5px;" class="mt-1">Lereng Stabil &amp; Aman</div>
            </div>
        </div>
    </div>

    <!-- 2. FORM INSPEKSI GEOTEKNIK UTAMA -->
    <form id="formGci" asp-action="Submit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" id="gciId" name="id" value="" />

        <!-- Header Memo Temuan / Ketidaksesuaian Geoteknik -->
        <div class="card-sap p-3 mb-3" style="border-left: 4px solid #0284c7;" id="formHeaderCard">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label-sap mb-0" style="font-size: 11px;">
                            <i class="bi bi-card-heading text-primary me-1"></i> Judul Temuan / Laporan Inspeksi Geoteknik <span class="text-danger">*</span>
                        </label>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-none" id="editModeBadge" style="font-size: 10px;">
                            <i class="bi bi-pencil-square me-1"></i> Mode Edit Laporan
                        </span>
                    </div>
                    <input type="text" id="judulTemuan" name="judulTemuan" class="input-sap fw-bold" value="" placeholder="Contoh: Inspeksi Kestabilan Lereng Highwall Pit A atau Ketidaksesuaian Material..." required style="font-size: 12.5px;" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label-sap mb-1" style="font-size: 11px;">
                        <i class="bi bi-calendar-check text-warning me-1"></i> Target Due Date (Penyelesaian)
                    </label>
                    <input type="date" id="dueDate" name="dueDate" class="input-sap" value="" />
                </div>
            </div>
        </div>

        <!-- ROW 1: Panel 1 (Umum & Lokasi) | Panel 2 (Kondisi Lereng) | Panel 3 (Pengukuran & Sensor) -->
        <div class="row g-3 mb-3">
            <!-- PANEL 1: IDENTITAS & LOKASI INSPEKSI -->
            <div class="col-12 col-lg-4">
                <div class="card-sap p-3 h-100" style="border-top: 3px solid #0284c7;">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
                        <h6 class="mb-0 d-flex align-items-center gap-1.5 fw-bold" style="font-size: 13px; color: var(--text-main);">
                            <span class="badge bg-primary" style="font-size: 10px;">1</span>
                            <span>INFORMASI &amp; LOKASI INSPEKSI</span>
                        </h6>
                    </div>

                    <!-- Stepper Bar Ringkas Berkontras Tinggi -->
                    <div class="d-flex justify-content-between align-items-center mb-3 px-2.5 py-1.5 rounded-2 overflow-auto text-nowrap" style="background: rgba(14, 165, 233, 0.08); border: 1px solid var(--border-color); font-size: 10px;">
                        <span class="fw-bold text-primary"><i class="bi bi-check2-circle me-1"></i>1. Lokasi</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">2. Geometri</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">3. Fisik</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">4. Foto</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">5. PIC</span>
                    </div>

                    <div class="form-group-sap mb-2">
                        <label class="form-label-sap">Jenis Inspeksi <span class="text-danger">*</span></label>
                        <select id="jenisInspeksi" name="jenisInspeksi" class="input-sap" required>
                            <option value="Inspeksi Rutin" selected>Inspeksi Rutin</option>
                            <option value="Inspeksi Pasca Hujan">Inspeksi Pasca Hujan</option>
                            <option value="Inspeksi Pasca Peledakan">Inspeksi Pasca Peledakan</option>
                            <option value="Inspeksi Perubahan Geometri">Inspeksi Perubahan Geometri</option>
                            <option value="Inspeksi Khusus">Inspeksi Khusus (Permintaan KTT / Geotek)</option>
                            <option value="Re-Inspection">Re-Inspection</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-7 form-group-sap mb-0">
                            <label class="form-label-sap">Tanggal <span class="text-danger">*</span></label>
                            <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-5 form-group-sap mb-0">
                            <label class="form-label-sap">Jam <span class="text-danger">*</span></label>
                            <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6 form-group-sap mb-0">
                            <label class="form-label-sap">Shift</label>
                            <select id="shift" name="shift" class="input-sap">
                                <option value="Day Shift" selected>Day Shift</option>
                                <option value="Night Shift">Night Shift</option>
                            </select>
                        </div>
                        <div class="col-6 form-group-sap mb-0">
                            <label class="form-label-sap">Perusahaan / Kontraktor</label>
                            <select id="perusahaan" name="perusahaan" class="input-sap">
                                <option value="PT Indexim Coalindo" selected>PT Indexim Coalindo</option>
                                <option value="KPP">KPP</option>
                                <option value="PAMA">PAMA</option>
                                <option value="UNGGUL">UNGGUL</option>
                                <option value="MGE">MGE</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-12 col-sm-6 form-group-sap mb-0">
                            <label class="form-label-sap">Inspector (Geotek IC)</label>
                            <input type="text" id="inspectorPic" name="nama" class="input-sap" value="@userNama" readonly />
                            <input type="hidden" name="nik" value="@userNik" />
                        </div>
                        <div class="col-12 col-sm-6 form-group-sap mb-0 position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label-sap mb-0">Supervisor (PJA)</label>
                                <span class="badge bg-secondary" style="font-size: 8px;">Cari</span>
                            </div>
                            <input type="text" id="pjaSearchInput" class="input-sap" value="" placeholder="Ketik nama / NIK PJA..." autocomplete="off" oninput="searchPjaLive(this.value)" />
                            <div id="pjaSearchResults" class="position-absolute shadow-lg rounded-3 mt-1 w-100 d-none" style="z-index: 1050; max-height: 200px; overflow-y: auto; background: var(--bg-card); border: 1px solid var(--border-color);"></div>
                            <input type="hidden" id="pjaNama" name="pjaNama" value="" />
                            <input type="hidden" id="pjaNik" name="pjaNik" value="" />
                        </div>
                    </div>

                    <!-- AREA & KOORDINAT LAPANGAN (PIT & SEKTOR BISA DIKETIK LANGSUNG) -->
                    <div class="p-2.5 rounded-3 mb-2" style="background: rgba(14, 165, 233, 0.04); border: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold" style="font-size: 11.5px; color: var(--text-main);">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i> Area &amp; Titik Lapangan
                            </span>
                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size: 10.5px; color: #0284c7; font-weight: 600;" onclick="getGciGpsLocation()">
                                <i class="bi bi-crosshair me-1"></i> GPS Otomatis
                            </button>
                        </div>

                        <!-- Baris 1: Pit & Sektor (BISA DIKETIK BEBAS OLEH USER) -->
                        <div class="row g-2 mb-2">
                            <div class="col-12 col-sm-6">
                                <label class="form-label-sap mb-1" style="font-size: 10.5px;">
                                    <i class="bi bi-gem text-primary me-1"></i>Pit <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="pit" name="pit" class="input-sap" value="" placeholder="Ketik Pit (contoh: PIT A, PIT B, ROM 33)..." autocomplete="off" oninput="syncPitArea()" required />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-sap mb-1" style="font-size: 10.5px;">
                                    <i class="bi bi-pin-map-fill text-warning me-1"></i>Sektor / Area <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="area" name="area" class="input-sap" value="" placeholder="Ketik Sektor (contoh: Sektor 1, Sektor Barat)..." autocomplete="off" oninput="syncPitArea()" required />
                            </div>
                        </div>

                        <!-- Baris 2: Sub Area / Nama Lereng & Detail Titik Benchmark -->
                        <div class="row g-2 mb-2">
                            <div class="col-12 col-sm-6">
                                <label class="form-label-sap mb-1" style="font-size: 10.5px;">
                                    <i class="bi bi-layers-half text-info me-1"></i>Sub Area / Nama Lereng <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="namaLereng" name="namaLereng" class="input-sap" value="" placeholder="Contoh: Highwall Ramp 2, Lowwall Seam A..." oninput="updateLokasiFull()" required />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-sap mb-1" style="font-size: 10.5px;">Detail Titik / Benchmark</label>
                                <input type="text" id="detilLokasi" name="detilLokasi" class="input-sap" value="" placeholder="Contoh: BM-04, Patok 12, DCP 1-1.5m..." />
                            </div>
                        </div>

                        <!-- Baris 3: Elevasi & Koordinat GPS -->
                        <div class="row g-2">
                            <div class="col-12 col-sm-4">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Elevasi (RL meter)</label>
                                <input type="number" step="1" id="elevasiRl" name="elevasiRl" class="input-sap" value="" placeholder="EL (m)..." oninput="updateLokasiFull()" />
                            </div>
                            <div class="col-6 col-sm-4">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Northing / Latitude</label>
                                <input type="text" id="latitude" name="latitude" class="input-sap" value="" placeholder="Lat / N..." style="font-size: 11px;" />
                            </div>
                            <div class="col-6 col-sm-4">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Easting / Longitude</label>
                                <input type="text" id="longitude" name="longitude" class="input-sap" value="" placeholder="Long / E..." style="font-size: 11px;" />
                            </div>
                        </div>

                        <input type="hidden" id="lokasi" name="lokasi" value="" />
                    </div>
                </div>
            </div>

            <!-- PANEL 2: DETAIL KONDISI LERENG (Geometri & Fisik) -->
            <div class="col-12 col-lg-4">
                <div class="card-sap p-3 h-100" style="border-top: 3px solid #0ea5e9;">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
                        <h6 class="mb-0 d-flex align-items-center gap-1.5 fw-bold" style="font-size: 13px; color: var(--text-main);">
                            <span class="badge bg-info text-dark" style="font-size: 10px;">2</span>
                            <span>DETAIL KONDISI LERENG</span>
                        </h6>
                    </div>

                    <!-- Tabs Area Type -->
                    <div class="d-flex gap-1 mb-2 overflow-auto pb-1" id="areaTypeTabs" style="font-size: 10.5px;">
                        <button type="button" class="btn btn-sm btn-outline-info active py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Highwall', this)">Highwall</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Lowwall', this)">Lowwall</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Stockpile', this)">Stockpile</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Disposal', this)">Disposal</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Infrastruktur', this)">Infrastruktur</button>
                    </div>
                    <input type="hidden" id="areaType" name="areaType" value="Highwall" />

                    <!-- Geometri Lereng -->
                    <div class="p-2.5 rounded-2 mb-2" style="background: rgba(14, 165, 233, 0.04); border: 1px solid var(--border-color);">
                        <div class="fw-bold mb-1.5 d-flex justify-content-between align-items-center" style="font-size: 11px; color: var(--text-main);">
                            <span><i class="bi bi-rulers text-info me-1"></i> Parameter Geometri Lereng</span>
                            <span class="badge bg-secondary" style="font-size: 8.5px;">Desain vs Aktual</span>
                        </div>
                        <div class="row g-1.5 mb-1.5">
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Tinggi (m)</label>
                                <input type="number" step="0.1" id="tinggiJenjang" name="tinggiJenjang" class="input-sap py-1 px-1 text-center" value="" placeholder="15.0" oninput="renderBenchSvg()" />
                            </div>
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Berm (m)</label>
                                <input type="number" step="0.1" id="lebarBerm" name="lebarBerm" class="input-sap py-1 px-1 text-center" value="" placeholder="8.0" oninput="renderBenchSvg()" />
