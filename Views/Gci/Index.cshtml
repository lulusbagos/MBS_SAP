@model IEnumerable<MBS_SAP.Models.GciReport>
@{
    ViewData["Title"] = "Geotechnical Inspection & Hazard Management - SAP";
    var userNik = ViewBag.UserNik as string ?? "00000";
    var userNama = ViewBag.UserNama as string ?? "Andi Pratama";
    var userDept = ViewBag.UserDept as string ?? "Geotechnical Engineering";
    var userCompany = ViewBag.UserCompany as string ?? "PT INDEXIM COALINDO";
    var pitList = ViewBag.PitList as List<string> ?? new List<string>();
    var totalReports = ViewBag.TotalReports as int? ?? 36;
    var avgScore = ViewBag.AvgScore as double? ?? 86.5;
    var goodCount = ViewBag.GoodCount as int? ?? 17;
    var fairCount = ViewBag.FairCount as int? ?? 16;
    var poorCount = ViewBag.PoorCount as int? ?? 3;
    var tarpGreenCount = ViewBag.TarpGreenCount as int? ?? 17;
    var tarpYellowCount = ViewBag.TarpYellowCount as int? ?? 11;
    var tarpOrangeCount = ViewBag.TarpOrangeCount as int? ?? 5;
    var tarpRedCount = ViewBag.TarpRedCount as int? ?? 3;
}

<div class="animate-fade-in pb-5">
    <!-- Top Header Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <div class="screen-title d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-triangle-half" style="color: #0284c7;"></i>
                <span style="font-weight: 800; letter-spacing: -0.3px; color: var(--text-main);">Geotechnical Inspection &amp; Hazard Management</span>
                <span class="badge" style="background: linear-gradient(135deg, #0284c7, #38bdf8); color: white; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 6px; letter-spacing: 0.5px;">
                    MBS GEOTEKNIK
                </span>
                <span class="badge" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; border: 1px solid rgba(14, 165, 233, 0.25); font-size: 11px; padding: 4px 10px; border-radius: 8px;">
                    PT Indexim Coalindo
                </span>
            </div>
            <p class="screen-subtitle mb-0" style="color: var(--text-muted);">Sistem Inspeksi Kestabilan Lereng &amp; Penanganan Ketidaksesuaian Geoteknik Berdasarkan Kepmen ESDM 1827 K/30/MEM/2018.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 px-3 py-1.5 rounded-3 d-none d-sm-flex" style="background: var(--bg-card); border: 1px solid var(--border-color);">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #38bdf8); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 13px;">
                    @(userNama.Length >= 2 ? userNama.Substring(0, 2).ToUpper() : "AP")
                </div>
                <div>
                    <div style="font-size: 12px; font-weight: 700; color: var(--text-main);">@userNama</div>
                    <div style="font-size: 10px; color: var(--text-muted);">Geoteknik Engineer</div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" style="border-radius: 10px; padding: 8px 14px; font-weight: 600;" onclick="resetGciForm()">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span class="d-none d-md-inline">Reset Form</span>
            </button>
            <a asp-action="ExportExcel" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 shadow-sm" style="border-radius: 10px; padding: 8px 14px; font-weight: 600;">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>Export Excel</span>
            </a>
        </div>
    </div>

    <!-- Status Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-3 shadow-sm" role="alert" style="background-color: rgba(34, 197, 94, 0.15); color: #15803d; border-radius: 12px; border: 1px solid rgba(34, 197, 94, 0.3);">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-3 shadow-sm" role="alert" style="background-color: rgba(239, 68, 68, 0.15); color: #b91c1c; border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.3);">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. Top Summary Metric Cards (5 KPI Cards Responsive) -->
    <div class="row g-2 mb-3">
        <!-- Card 1: Total Hazard -->
        <div class="col-6 col-md-4 col-xl-2" style="flex: 1 1 180px;">
            <div class="card-sap p-2.5 p-md-3 h-100" style="border-left: 4px solid #0284c7;">
                <div style="color: var(--text-muted); font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Total Hazard</div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold" style="color: var(--text-main); font-size: 1.6rem;">@totalReports</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 10px;" class="mt-1.5">12 Open &bull; 18 Monitor &bull; 6 Closed</div>
            </div>
        </div>

        <!-- Card 2: Critical TARP 3 -->
        <div class="col-6 col-md-4 col-xl-2" style="flex: 1 1 180px;">
            <div class="card-sap p-2.5 p-md-3 h-100" style="border-left: 4px solid #ef4444; background: rgba(239, 68, 68, 0.04);">
                <div class="text-danger fw-bold" style="font-size: 10.5px; text-transform: uppercase;">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i> Critical (TARP 3)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold text-danger" style="font-size: 1.6rem;">@tarpRedCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 10px;" class="mt-1.5">2 Pit &bull; 1 Disposal</div>
            </div>
        </div>

        <!-- Card 3: Action TARP 2 -->
        <div class="col-6 col-md-4 col-xl-2" style="flex: 1 1 180px;">
            <div class="card-sap p-2.5 p-md-3 h-100" style="border-left: 4px solid #f97316; background: rgba(249, 115, 22, 0.04);">
                <div style="color: #ea580c; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Action (TARP 2)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold" style="color: #ea580c; font-size: 1.6rem;">@tarpOrangeCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 10px;" class="mt-1.5">3 Pit &bull; 2 Disposal</div>
            </div>
        </div>

        <!-- Card 4: Alert TARP 1 -->
        <div class="col-6 col-md-4 col-xl-2" style="flex: 1 1 180px;">
            <div class="card-sap p-2.5 p-md-3 h-100" style="border-left: 4px solid #eab308; background: rgba(234, 179, 8, 0.04);">
                <div style="color: #ca8a04; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> Alert (TARP 1)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold" style="color: #ca8a04; font-size: 1.6rem;">@tarpYellowCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 10px;" class="mt-1.5">7 Pit &bull; 4 Disposal</div>
            </div>
        </div>

        <!-- Card 5: Normal TARP 0 -->
        <div class="col-12 col-md-4 col-xl-2" style="flex: 1 1 180px;">
            <div class="card-sap p-2.5 p-md-3 h-100" style="border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.04);">
                <div class="text-success fw-bold" style="font-size: 10.5px; text-transform: uppercase;">
                    <i class="bi bi-check-circle-fill me-1"></i> Normal (TARP 0)
                </div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h3 class="mb-0 font-weight-bold text-success" style="font-size: 1.6rem;">@tarpGreenCount</h3>
                </div>
                <div style="color: var(--text-muted); font-size: 10px;" class="mt-1.5">8 Pit &bull; 9 Disposal</div>
            </div>
        </div>
    </div>

    <!-- 2. FORM INSPEKSI GEOTEKNIK UTAMA (Sesuai Referensi Format Memo & Temuan Ketidaksesuaian) -->
    <form id="formGci" asp-action="Submit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" id="gciId" name="id" value="" />

        <!-- Header Memo Temuan / Ketidaksesuaian Geoteknik -->
        <div class="card-sap p-3 mb-3" style="border-left: 4px solid #0284c7;">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                    <label class="form-label-sap mb-1" style="font-size: 11px;">
                        <i class="bi bi-card-heading text-primary me-1"></i> Judul Temuan / Ketidaksesuaian Geoteknik <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="judulTemuan" name="judulTemuan" class="input-sap fw-bold" value="Ketidaksesuaian Material Pembentukan Pad Extend Stockpile ROM D" placeholder="Contoh: Ketidaksesuaian Material Pembentukan Pad Extend Stockpile ROM D..." required style="font-size: 13px;" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label-sap mb-1" style="font-size: 11px;">
                        <i class="bi bi-calendar-check text-warning me-1"></i> Target Due Date (Penyelesaian)
                    </label>
                    <input type="date" id="dueDate" name="dueDate" class="input-sap" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>

        <!-- ROW 1: Panel 1 (Umum & Lokasi) | Panel 2 (Kondisi Lereng) | Panel 3 (Pengukuran & Sensor) -->
        <div class="row g-3 mb-3">
            <!-- PANEL 1: IDENTITAS & LOKASI INSPEKSI -->
            <div class="col-12 col-lg-4">
                <div class="card-sap p-3 h-100" style="border-top: 3px solid #0284c7;">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
                        <h6 class="mb-0 d-flex align-items-center gap-1.5 fw-bold" style="font-size: 13px; color: var(--text-main);">
                            <span class="badge bg-primary" style="font-size: 10px;">1</span>
                            <span>INFORMASI &amp; LOKASI INSPEKSI</span>
                        </h6>
                    </div>

                    <!-- Stepper Bar Ringkas Berkontras Tinggi -->
                    <div class="d-flex justify-content-between align-items-center mb-3 px-2.5 py-1.5 rounded-2 overflow-auto text-nowrap" style="background: rgba(14, 165, 233, 0.08); border: 1px solid var(--border-color); font-size: 10.5px;">
                        <span class="fw-bold text-primary"><i class="bi bi-check2-circle me-1"></i>1. Lokasi</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">2. Geometri</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">3. Ukur</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">4. Sensor</span>
                        <span class="mx-1" style="color: var(--text-muted);">&bull;</span>
                        <span style="color: var(--text-main);">5. Dokumen</span>
                    </div>

                    <div class="form-group-sap mb-2">
                        <label class="form-label-sap">Jenis Inspeksi <span class="text-danger">*</span></label>
                        <select id="jenisInspeksi" name="jenisInspeksi" class="input-sap" required>
                            <option value="Inspeksi Rutin" selected>Inspeksi Rutin</option>
                            <option value="Inspeksi Pasca Hujan">Inspeksi Pasca Hujan</option>
                            <option value="Inspeksi Pasca Peledakan">Inspeksi Pasca Peledakan</option>
                            <option value="Inspeksi Perubahan Geometri">Inspeksi Perubahan Geometri</option>
                            <option value="Inspeksi Khusus">Inspeksi Khusus (Permintaan KTT / Geotek)</option>
                            <option value="Re-Inspection">Re-Inspection</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-7 form-group-sap mb-0">
                            <label class="form-label-sap">Tanggal <span class="text-danger">*</span></label>
                            <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-5 form-group-sap mb-0">
                            <label class="form-label-sap">Jam <span class="text-danger">*</span></label>
                            <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6 form-group-sap mb-0">
                            <label class="form-label-sap">Shift</label>
                            <select id="shift" name="shift" class="input-sap">
                                <option value="Day Shift" selected>Day Shift</option>
                                <option value="Night Shift">Night Shift</option>
                            </select>
                        </div>
                        <div class="col-6 form-group-sap mb-0">
                            <label class="form-label-sap">Perusahaan / Kontraktor</label>
                            <select id="perusahaan" name="perusahaan" class="input-sap">
                                <option value="KPP" selected>KPP</option>
                                <option value="PT Indexim Coalindo">Indexim</option>
                                <option value="PAMA">PAMA</option>
                                <option value="UNGGUL">UNGGUL</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6 form-group-sap mb-0">
                            <label class="form-label-sap">Inspector (Geotek IC)</label>
                            <input type="text" id="inspectorPic" name="nama" class="input-sap" value="@userNama" readonly />
                            <input type="hidden" name="nik" value="@userNik" />
                        </div>
                        <div class="col-6 form-group-sap mb-0 position-relative">
                            <label class="form-label-sap d-flex justify-content-between align-items-center">
                                <span>Supervisor (PJA)</span>
                                <span class="badge bg-secondary" style="font-size: 8px;">Search</span>
                            </label>
                            <input type="text" id="pjaSearchInput" class="input-sap" value="Rudi Saputra" placeholder="Ketik nama / NIK PJA..." autocomplete="off" oninput="searchPjaLive(this.value)" />
                            <div id="pjaSearchResults" class="position-absolute shadow-lg rounded-3 mt-1 w-100 d-none" style="z-index: 1050; max-height: 200px; overflow-y: auto; background: var(--bg-card); border: 1px solid var(--border-color);"></div>
                            <input type="hidden" id="pjaNama" name="pjaNama" value="Rudi Saputra" />
                            <input type="hidden" id="pjaNik" name="pjaNik" value="51022424" />
                        </div>
                    </div>

                    <!-- Lokasi Praktis & Koordinat Tanpa Peta Berat -->
                    <div class="p-2.5 rounded-3 mb-2" style="background: rgba(14, 165, 233, 0.04); border: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold" style="font-size: 11.5px; color: var(--text-main);">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i> Area &amp; Koordinat Lapangan
                            </span>
                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size: 10.5px; color: #0284c7; font-weight: 600;" onclick="getGciGpsLocation()">
                                <i class="bi bi-crosshair me-1"></i> GPS Otomatis
                            </button>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Pit / Sektor</label>
                                <select id="pitSelect" class="input-sap" onchange="updateAreaPit(this.value)">
                                    <option value="STOCKPILE ROM D" selected>STOCKPILE ROM D</option>
                                    <option value="PIT A">PIT A</option>
                                    <option value="PIT B">PIT B</option>
                                    <option value="PIT C">PIT C</option>
                                    <option value="DISPOSAL D01">DISPOSAL D01</option>
                                    <option value="DISPOSAL D02">DISPOSAL D02</option>
                                    <option value="ROM 33">ROM 33</option>
                                    <option value="SUMP CENTRAL">SUMP CENTRAL</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Sub Area / Nama Lereng</label>
                                <input type="text" id="namaLereng" name="namaLereng" class="input-sap" value="Pad Extend Stockpile ROM D Port" placeholder="Nama lereng..." required />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Elevasi (EL / RL dalam meter)</label>
                                <input type="number" step="1" id="elevasiRl" name="elevasiRl" class="input-sap" value="65" placeholder="EL (m)..." />
                            </div>
                            <div class="col-6">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Detail Titik / Benchmark</label>
                                <input type="text" id="detilLokasi" name="detilLokasi" class="input-sap" value="Port Stockpile D, Titik DCP 1-1.5m" placeholder="Benchmark/RL..." />
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Northing / Latitude</label>
                                <input type="text" id="latitude" name="latitude" class="input-sap" value="N 90246" style="font-size: 11px;" />
                            </div>
                            <div class="col-6">
                                <label class="form-label-sap mb-1" style="font-size: 10px;">Easting / Longitude</label>
                                <input type="text" id="longitude" name="longitude" class="input-sap" value="E 596604" style="font-size: 11px;" />
                            </div>
                        </div>

                        <input type="hidden" id="area" name="area" value="STOCKPILE ROM D" />
                        <input type="hidden" id="pit" name="pit" value="STOCKPILE ROM D" />
                        <input type="hidden" id="lokasi" name="lokasi" value="Stockpile ROM D Port EL 65" />
                    </div>
                </div>
            </div>

            <!-- PANEL 2: DETAIL KONDISI LERENG (Geometri & Fisik) -->
            <div class="col-12 col-lg-4">
                <div class="card-sap p-3 h-100" style="border-top: 3px solid #0284c7;">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
                        <h6 class="mb-0 d-flex align-items-center gap-1.5 fw-bold" style="font-size: 13px; color: var(--text-main);">
                            <span class="badge bg-info text-dark" style="font-size: 10px;">2</span>
                            <span>DETAIL KONDISI LERENG</span>
                        </h6>
                    </div>

                    <!-- Tabs Area Type -->
                    <div class="d-flex gap-1 mb-2 overflow-auto pb-1" id="areaTypeTabs" style="font-size: 10.5px;">
                        <button type="button" class="btn btn-sm btn-outline-info active py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Stockpile', this)">Stockpile</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Highwall', this)">Highwall</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Lowwall', this)">Lowwall</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Disposal', this)">Disposal</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5 text-nowrap" style="border-radius: 6px;" onclick="selectAreaType('Infrastruktur', this)">Infrastruktur</button>
                    </div>
                    <input type="hidden" id="areaType" name="areaType" value="Stockpile" />

                    <!-- Geometri Lereng -->
                    <div class="p-2.5 rounded-2 mb-2" style="background: rgba(14, 165, 233, 0.04); border: 1px solid var(--border-color);">
                        <div class="fw-bold mb-1.5 d-flex justify-content-between align-items-center" style="font-size: 11px; color: var(--text-main);">
                            <span><i class="bi bi-rulers text-info me-1"></i> Parameter Geometri Lereng</span>
                            <span class="badge bg-secondary" style="font-size: 8.5px;">Desain vs Aktual</span>
                        </div>
                        <div class="row g-1.5 mb-1.5">
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Tinggi Jenjang (m)</label>
                                <input type="number" step="0.1" id="tinggiJenjang" name="tinggiJenjang" class="input-sap py-1 px-2 text-center" value="15.5" onchange="renderBenchSvg()" />
                            </div>
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Lebar Berm (m)</label>
                                <input type="number" step="0.1" id="lebarBerm" name="lebarBerm" class="input-sap py-1 px-2 text-center" value="8.0" onchange="renderBenchSvg()" />
                            </div>
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Actual Face (&deg;)</label>
                                <input type="number" step="1" id="actualFaceAngle" name="actualFaceAngle" class="input-sap py-1 px-2 text-center" value="68" onchange="renderBenchSvg()" />
                            </div>
                        </div>
                        <div class="row g-1.5 mb-2">
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Design Face (&deg;)</label>
                                <input type="number" step="1" id="designFaceAngle" name="designFaceAngle" class="input-sap py-1 px-2 text-center" value="70" />
                            </div>
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Overall Slope (&deg;)</label>
                                <input type="number" step="1" id="overallSlopeAngle" name="overallSlopeAngle" class="input-sap py-1 px-2 text-center" value="42" />
                            </div>
                            <div class="col-4">
                                <label class="form-label-sap mb-0" style="font-size: 9.5px;">Status Desain</label>
