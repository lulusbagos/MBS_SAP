<!-- ========================================================================= -->
<!-- 7. JAVASCRIPT CONTROLLER & INTERACTION ENGINE                            -->
<!-- ========================================================================= -->
<script>
    let currentPage = 1;
    let pageSize = 15;
    let currentSearch = '';
    let currentFilterType = '';
    let searchDebounceTimer = null;
    let empDebounceTimer = null;
    let selectedPjas = [];
    let deleteTargetId = null;

    document.addEventListener('DOMContentLoaded', function () {
        loadAreasData();
        refreshStatsCounters();
    });

    // ── SEARCH HANDLERS ──
    function handleSearchInput() {
        const val = document.getElementById('searchInput').value;
        const clearBtn = document.getElementById('searchClearBtn');
        if (clearBtn) {
            clearBtn.style.display = val.length > 0 ? 'block' : 'none';
        }

        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
            currentSearch = val.trim();
            currentPage = 1;
            loadAreasData();
        }, 300);
    }

    function clearSearch() {
        const input = document.getElementById('searchInput');
        input.value = '';
        document.getElementById('searchClearBtn').style.display = 'none';
        currentSearch = '';
        currentPage = 1;
        loadAreasData();
        input.focus();
    }

    // ── FILTER HANDLERS ──
    function filterData(type) {
        currentFilterType = type;
        currentPage = 1;

        // Update button visual states
        document.querySelectorAll('.filter-segment-btn').forEach(b => b.classList.remove('active'));
        if (type === '') document.getElementById('fltAll')?.classList.add('active');
        else if (type === 'pja_khusus') document.getElementById('fltKhusus')?.classList.add('active');
        else if (type === 'all_karyawan') document.getElementById('fltAllKaryawan')?.classList.add('active');

        loadAreasData();
    }

    function changePageSize(size) {
        pageSize = parseInt(size, 10) || 15;
        currentPage = 1;
        loadAreasData();
    }

    // ── REFRESH ACTION ──
    async function handleRefreshClick() {
        const icon = document.getElementById('iconRefresh');
        if (icon) icon.classList.add('spin-icon');

        await Promise.all([loadAreasData(), refreshStatsCounters()]);

        setTimeout(() => {
            if (icon) icon.classList.remove('spin-icon');
            showToast('Data Area & PJA berhasil diperbarui', 'info');
        }, 400);
    }

    // ── LOAD TABLE DATA ──
    async function loadAreasData() {
        const tbody = document.getElementById('areasTableBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                    <div class="spinner-border text-info spinner-border-sm me-2" role="status"></div>
                    Memuat data Area Utama & PJA...
                </td>
            </tr>`;

        try {
            const url = `/AreaPja/GetAreasData?search=${encodeURIComponent(currentSearch)}&filterType=${encodeURIComponent(currentFilterType)}&page=${currentPage}&pageSize=${pageSize}`;
            const res = await fetch(url);
            const json = await res.json();

            if (!json.success) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger"><i class="bi bi-exclamation-octagon me-1"></i> Gagal memuat data: ${json.message || 'Akses ditolak'}</td></tr>`;
                return;
            }

            renderTable(json.data, json.totalItems, json.currentPage, json.totalPages);
        } catch (e) {
            tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger"><i class="bi bi-wifi-off me-1"></i> Terjadi kesalahan koneksi ke server.</td></tr>`;
        }
    }

    // ── RENDER TABLE ──
    function renderTable(data, totalItems, page, totalPages) {
        const tbody = document.getElementById('areasTableBody');
        if (!data || data.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2" style="background: rgba(255,255,255,0.03); width: 64px; height: 64px;">
                            <i class="bi bi-inbox fs-2 text-muted"></i>
                        </div>
                        <div class="fw-bold" style="color: var(--text-main);">Tidak ada area utama yang ditemukan</div>
                        <div class="small text-muted mt-1">Coba sesuaikan kata kunci pencarian atau ubah filter di atas.</div>
                    </td>
                </tr>`;
            document.getElementById('paginationInfo').innerText = `Menampilkan 0 dari 0 data`;
            document.getElementById('paginationNav').innerHTML = '';
            return;
        }

        let html = '';
        const startNo = (page - 1) * pageSize + 1;

        data.forEach((item, index) => {
            const no = startNo + index;
            const badgeType = item.isAllKaryawan 
                ? `<span class="badge-access-capsule all" title="Semua karyawan dapat dicari di aplikasi mobile">
                     <span class="pulse-dot"></span> All Karyawan
                   </span>`
                : `<span class="badge-access-capsule khusus" title="Hanya PJA khusus terdaftar yang muncul di mobile">
                     <span class="pulse-dot"></span> PJA Khusus
                   </span>`;

            // Render PJA Chips
            let pjaHtml = '';
            if (item.pjas && item.pjas.length > 0) {
                pjaHtml = '<div class="d-flex flex-wrap gap-1 align-items-center">';
                item.pjas.slice(0, 3).forEach(p => {
                    const initial = (p.nama || '?').charAt(0).toUpperCase();
                    pjaHtml += `
                        <div class="pja-person-chip" title="${escapeHtml(p.nama)} (${escapeHtml(p.nik)}) - ${escapeHtml(p.departemen || '')}">
                            <div class="pja-avatar-mini">${initial}</div>
                            <span class="fw-bold" style="color: var(--text-main); font-size: 11.5px;">${escapeHtml(p.nama)}</span>
                            <span class="text-muted" style="font-size: 10.5px;">${escapeHtml(p.nik)}</span>
                        </div>`;
                });
                if (item.pjas.length > 3) {
                    pjaHtml += `<button type="button" class="pja-more-btn" onclick="openEditModal(${item.id})" title="Lihat semua ${item.pjas.length} PJA">+${item.pjas.length - 3} Lainnya</button>`;
                }
                pjaHtml += '</div>';
            } else {
                pjaHtml = `<span class="text-muted small d-inline-flex align-items-center gap-1">
                    <i class="bi bi-dash-circle text-muted" style="font-size: 11px;"></i>
                    ${item.isAllKaryawan ? 'Terbuka bagi seluruh karyawan' : 'Belum ditentukan PJA khusus'}
                </span>`;
            }

            html += `
                <tr>
                    <td class="ps-4">
                        <span class="no-badge">${no}</span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="area-badge-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size: 14.5px; color: var(--text-main);">${escapeHtml(item.namaArea)}</div>
                                <div class="text-muted small" style="font-size: 11px;">
                                    <i class="bi bi-clock-history me-1"></i>${escapeHtml(item.createdAt || 'Aktif')}
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>${badgeType}</td>
                    <td>${pjaHtml}</td>
                    <td class="text-center">
                        <span class="badge rounded-pill px-3 py-1 fw-bold" style="font-size: 11px; background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                            ${item.pjaCount} PJA
                        </span>
                    </td>
                    <td class="text-end pe-4">
                        <div class="d-inline-flex gap-1">
                            <button type="button" class="btn-action-circle edit" onclick="openEditModal(${item.id})" title="Edit Area & Penugasan PJA">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button" class="btn-action-circle delete" onclick="openDeleteDialog(${item.id}, '${escapeHtml(item.namaArea)}')" title="Hapus Area">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;
        });

        tbody.innerHTML = html;

        // Render Pagination
        const endNo = Math.min(startNo + data.length - 1, totalItems);
        document.getElementById('paginationInfo').innerText = `Menampilkan ${startNo} - ${endNo} dari total ${totalItems} area (Halaman ${page} dari ${totalPages})`;

        let pagHtml = '';
        if (page > 1) {
            pagHtml += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(1); return false;" title="Halaman Pertama">&laquo;</a></li>`;
            pagHtml += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(${page - 1}); return false;" title="Sebelumnya">&lsaquo;</a></li>`;
        } else {
            pagHtml += `<li class="page-item disabled"><span class="page-link">&laquo;</span></li>`;
        }

        const maxButtons = 5;
        let startPage = Math.max(1, page - 2);
        let endPage = Math.min(totalPages, startPage + maxButtons - 1);
        if (endPage - startPage < maxButtons - 1) {
            startPage = Math.max(1, endPage - maxButtons + 1);
        }

        for (let p = startPage; p <= endPage; p++) {
            if (p === page) {
                pagHtml += `<li class="page-item active"><span class="page-link">${p}</span></li>`;
            } else {
                pagHtml += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(${p}); return false;">${p}</a></li>`;
            }
        }

        if (page < totalPages) {
            pagHtml += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(${page + 1}); return false;" title="Berikutnya">&rsaquo;</a></li>`;
            pagHtml += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(${totalPages}); return false;" title="Halaman Terakhir">&raquo;</a></li>`;
        } else {
            pagHtml += `<li class="page-item disabled"><span class="page-link">&raquo;</span></li>`;
        }

        document.getElementById('paginationNav').innerHTML = pagHtml;
    }

    function goToPage(page) {
        currentPage = page;
        loadAreasData();
    }

    // ── REFRESH METRIC HUD CARDS ──
    async function refreshStatsCounters() {
        try {
            const res = await fetch('/AreaPja/GetSummaryStats');
            const data = await res.json();
            if (data && data.success) {
                document.getElementById('statTotalArea').innerText = data.totalArea || 0;
                document.getElementById('statAreaKhusus').innerText = data.areaKhususCount || 0;
                document.getElementById('statAreaAll').innerText = data.areaAllCount || 0;
                document.getElementById('statTotalPja').innerText = data.totalPjaAssigned || 0;
            }
        } catch (_) {}
    }

    // ── MODAL CREATE / EDIT ──
    function openCreateModal() {
        document.getElementById('editAreaId').value = '';
        document.getElementById('modalAreaName').value = '';
        document.getElementById('modalAreaName').disabled = false;
        document.getElementById('switchAllKaryawan').checked = true;
        handleSwitchChange();
        document.getElementById('empSearchInput').value = '';
        document.getElementById('empSearchResults').classList.add('d-none');
        document.getElementById('areaModalLabel').innerText = 'Tambah Area Utama';
        document.getElementById('modalSubTitle').innerText = 'Daftarkan nama area kerja baru dan kelola personil PJA-nya.';
        selectedPjas = [];
        renderPjaChips();
        new bootstrap.Modal(document.getElementById('areaModal')).show();
        setTimeout(() => document.getElementById('modalAreaName').focus(), 300);
    }

    async function openEditModal(id) {
        try {
            const res = await fetch(`/AreaPja/GetAreaDetail/${id}`);
            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Gagal memuat detail area.', 'error');
                return;
            }

            const area = json.data;
            document.getElementById('editAreaId').value = area.id;
            document.getElementById('modalAreaName').value = area.namaArea;
            document.getElementById('modalAreaName').disabled = false;
            document.getElementById('switchAllKaryawan').checked = area.isAllKaryawan;
            handleSwitchChange();
            document.getElementById('empSearchInput').value = '';
            document.getElementById('empSearchResults').classList.add('d-none');
            document.getElementById('areaModalLabel').innerText = `Edit: ${area.namaArea}`;
            document.getElementById('modalSubTitle').innerText = 'Perbarui konfigurasi nama area dan penugasan PJA terpilih.';

            selectedPjas = area.pjas || [];
            renderPjaChips();
            new bootstrap.Modal(document.getElementById('areaModal')).show();
        } catch (e) {
            showToast('Terjadi kesalahan memuat data area.', 'error');
        }
    }

    function handleSwitchChange() {
        const isAll = document.getElementById('switchAllKaryawan').checked;
        const card = document.getElementById('switchOptionCard');
        const badge = document.getElementById('badgeSwitchStatus');

        if (card && badge) {
            if (isAll) {
                card.classList.add('active');
                badge.innerText = 'AKTIF (SEMUA KARYAWAN)';
                badge.style.background = 'rgba(245, 158, 11, 0.2)';
                badge.style.color = '#fbbf24';
                badge.style.borderColor = 'rgba(245, 158, 11, 0.4)';
            } else {
                card.classList.remove('active');
                badge.innerText = 'TERBATAS (PJA KHUSUS)';
                badge.style.background = 'rgba(16, 185, 129, 0.2)';
                badge.style.color = '#34d399';
                badge.style.borderColor = 'rgba(16, 185, 129, 0.4)';
            }
        }
    }

    // ── PJA CHIPS RENDERING ──
    function renderPjaChips() {
        const container = document.getElementById('pjaChipsContainer');
        const countBadge = document.getElementById('selectedPjaCount');
        countBadge.innerText = `${selectedPjas.length} PJA Dipilih`;

        if (selectedPjas.length === 0) {
            container.innerHTML = `
                <div class="text-muted small w-100 text-center py-4" id="emptyPjaNotice">
                    <i class="bi bi-person-x fs-3 d-block text-secondary mb-1"></i>
                    Belum ada PJA khusus yang ditambahkan.<br>
                    Gunakan kolom pencarian di atas untuk memilih karyawan sebagai PJA area ini.
                </div>`;
            return;
        }

        let html = '';
        selectedPjas.forEach((p, idx) => {
            const initial = (p.nama || '?').charAt(0).toUpperCase();
            html += `
                <div class="selected-pja-card">
                    <div class="pja-avatar-mini">${initial}</div>
                    <div>
                        <div class="fw-bold" style="font-size: 12px; color: #ffffff; line-height: 1.1;">${escapeHtml(p.nama)}</div>
                        <div class="text-muted" style="font-size: 10.5px;">${escapeHtml(p.nik)} &bull; ${escapeHtml(p.departemen || '-')}</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1" onclick="removePja(${idx})" title="Hapus personil">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </div>`;
        });

        container.innerHTML = html;
    }

    function removePja(idx) {
        selectedPjas.splice(idx, 1);
        renderPjaChips();
    }

    // ── EMPLOYEE AUTOCOMPLETE ──
    function debounceEmpSearch() {
        clearTimeout(empDebounceTimer);
        empDebounceTimer = setTimeout(performEmpSearch, 250);
    }

    async function performEmpSearch() {
        const input = document.getElementById('empSearchInput');
        const query = input.value.trim();
        const resultsBox = document.getElementById('empSearchResults');
        const searchIcon = document.getElementById('empSearchIcon');

        if (query.length < 2) {
            resultsBox.classList.add('d-none');
            resultsBox.innerHTML = '';
            return;
        }

        if (searchIcon) searchIcon.className = 'spinner-border spinner-border-sm text-info';

        try {
            const res = await fetch(`/AreaPja/SearchEmployees?term=${encodeURIComponent(query)}`);
            const data = await res.json();

            if (!data || data.length === 0) {
                resultsBox.innerHTML = `<div class="p-3 text-muted small text-center"><i class="bi bi-search me-1"></i> Tidak ditemukan karyawan dengan kata kunci "${escapeHtml(query)}"</div>`;
                resultsBox.classList.remove('d-none');
                return;
            }

            let html = '';
            data.forEach(item => {
                const isAlreadySelected = selectedPjas.some(p => p.nik === item.nik);
                const initial = (item.nama || '?').charAt(0).toUpperCase();

                html += `
                    <button type="button" class="emp-result-item" 
                            onclick="selectEmployee(${JSON.stringify(item).replace(/"/g, '&quot;')})" 
                            ${isAlreadySelected ? 'disabled' : ''}>
                        <div class="d-flex align-items-center gap-2 text-start">
                            <div class="pja-avatar-mini" style="width: 30px; height: 30px; font-size: 12px;">${initial}</div>
                            <div>
                                <div class="fw-bold ${isAlreadySelected ? 'text-muted' : 'text-white'}" style="font-size: 13px;">
                                    ${escapeHtml(item.nama)}
                                </div>
                                <div class="text-muted" style="font-size: 11px;">
                                    NIK: <span class="text-info">${escapeHtml(item.nik)}</span> &bull; ${escapeHtml(item.departemen || '-')} &bull; ${escapeHtml(item.perusahaan || '-')}
                                </div>
                            </div>
                        </div>
                        <div>
                            ${isAlreadySelected 
                                ? '<span class="badge rounded-pill bg-secondary" style="font-size: 10px;">Sudah Dipilih</span>' 
                                : '<span class="badge rounded-pill px-3 py-1" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); font-size: 11px;"><i class="bi bi-plus-lg"></i> Tambah</span>'}
                        </div>
                    </button>`;
            });

            resultsBox.innerHTML = html;
            resultsBox.classList.remove('d-none');
        } catch (e) {
            resultsBox.innerHTML = `<div class="p-3 text-danger small text-center">Gagal menghubungi server pencarian karyawan.</div>`;
            resultsBox.classList.remove('d-none');
        } finally {
            if (searchIcon) searchIcon.className = 'bi bi-search text-info';
        }
    }

    function selectEmployee(emp) {
        if (!selectedPjas.some(p => p.nik === emp.nik)) {
            selectedPjas.push({
                nik: emp.nik,
                nama: emp.nama,
                jabatan: emp.jabatan,
                departemen: emp.departemen,
                perusahaan: emp.perusahaan,
                isPicUtama: false
            });
            renderPjaChips();
        }
        document.getElementById('empSearchInput').value = '';
        document.getElementById('empSearchResults').classList.add('d-none');
    }

    document.addEventListener('click', function (e) {
        const resultsBox = document.getElementById('empSearchResults');
        const searchInput = document.getElementById('empSearchInput');
        if (resultsBox && !resultsBox.contains(e.target) && e.target !== searchInput) {
            resultsBox.classList.add('d-none');
        }
    });

    // ── SUBMIT SAVE AREA ──
    async function submitSaveArea() {
        const areaIdVal = document.getElementById('editAreaId').value;
        const areaName = document.getElementById('modalAreaName').value.trim();
        const isAllKaryawan = document.getElementById('switchAllKaryawan').checked;
        const saveBtn = document.getElementById('saveAreaBtn');

        if (!areaName) {
            showToast('Nama Area Utama wajib diisi!', 'warning');
            document.getElementById('modalAreaName').focus();
            return;
        }

        saveBtn.disabled = true;
        saveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan...`;

        const payload = {
            id: areaIdVal ? parseInt(areaIdVal, 10) : null,
            namaArea: areaName,
            isAllKaryawan: isAllKaryawan,
            pjas: selectedPjas
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch('/AreaPja/SaveArea', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Gagal menyimpan pengaturan area.', 'error');
                return;
            }

            // Close modal & reload data
            const modalEl = document.getElementById('areaModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            loadAreasData();
            refreshStatsCounters();
            showToast(`Area "${areaName}" berhasil disimpan`, 'success');
        } catch (e) {
            showToast('Terjadi kesalahan jaringan saat menyimpan.', 'error');
        } finally {
            saveBtn.disabled = false;
            saveBtn.innerHTML = `<i class="bi bi-check-circle-fill"></i> Simpan Pengaturan`;
        }
    }

    // ── DELETE AREA ACTION ──
    function openDeleteDialog(id, name) {
        deleteTargetId = id;
        document.getElementById('deleteAreaTargetName').innerText = name;
        const btn = document.getElementById('btnConfirmDeleteAction');
        btn.onclick = () => executeDeleteArea(id, name);
        new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
    }

    async function executeDeleteArea(id, name) {
        const btn = document.getElementById('btnConfirmDeleteAction');
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Menghapus...`;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch(`/AreaPja/DeleteArea/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            });
            const json = await res.json();

            // Close modal
            const modalEl = document.getElementById('deleteConfirmModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            if (json.success) {
                loadAreasData();
                refreshStatsCounters();
                showToast(`Area "${name}" berhasil dihapus`, 'success');
            } else {
                showToast(json.message || 'Gagal menghapus area.', 'error');
            }
        } catch (e) {
            showToast('Terjadi kesalahan saat menghapus area.', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-trash-fill"></i> Hapus`;
        }
    }

    // ── TOAST NOTIFICATIONS ──
    function showToast(message, type = 'info') {
        const container = document.getElementById('toastContainer');
        if (!container) return;

        const iconClass = type === 'success' ? 'bi-check-circle-fill text-success' : 
                         (type === 'error' ? 'bi-exclamation-octagon-fill text-danger' : 
                         (type === 'warning' ? 'bi-exclamation-triangle-fill text-warning' : 'bi-info-circle-fill text-info'));

        const toast = document.createElement('div');
        toast.className = 'toast-custom';
        toast.innerHTML = `
            <i class="bi ${iconClass} fs-5"></i>
            <span style="font-size: 13.5px; font-weight: 500;">${escapeHtml(message)}</span>
        `;

        container.appendChild(toast);
        setTimeout(() => {
            toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-10px)';
            setTimeout(() => toast.remove(), 400);
        }, 3200);
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
</script>
