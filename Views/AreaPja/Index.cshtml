@{
    ViewData["Title"] = "Master Area Utama & PJA";
    ViewData["ActiveTab"] = "AreaPjaAdmin";
}

@Html.AntiForgeryToken()

<style>
    /* ─── CUSTOM STYLING FOR PREMIUM AREA PJA DASHBOARD ─── */
    .area-pja-container {
        padding: 1.25rem 1.5rem;
    }

    /* Hero Banner */
    .hero-banner-card {
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.08) 0%, rgba(99, 102, 241, 0.08) 50%, rgba(16, 185, 129, 0.05) 100%);
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
        border-radius: 1.25rem;
        backdrop-filter: blur(16px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        position: relative;
        overflow: hidden;
    }
    .hero-banner-card::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, transparent 70%);
        pointer-events: none;
        border-radius: 50%;
    }

    .hero-icon-emblem {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        box-shadow: 0 8px 20px rgba(14, 165, 233, 0.35);
        flex-shrink: 0;
    }

    /* Metric HUD Cards */
    .metric-card {
        background: var(--bg-card, rgba(17, 24, 39, 0.7));
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.07));
        border-radius: 1.25rem;
        padding: 1.25rem 1.4rem;
        backdrop-filter: blur(14px);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s;
        position: relative;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
    }
    .metric-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
    }
    .metric-card.card-blue:hover { border-color: rgba(56, 189, 248, 0.4); }
    .metric-card.card-green:hover { border-color: rgba(16, 185, 129, 0.4); }
    .metric-card.card-amber:hover { border-color: rgba(245, 158, 11, 0.4); }
    .metric-card.card-purple:hover { border-color: rgba(168, 85, 247, 0.4); }

    .metric-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    .metric-icon-box.blue {
        background: rgba(14, 165, 233, 0.12);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.25);
    }
    .metric-icon-box.green {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }
    .metric-icon-box.amber {
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.25);
    }
    .metric-icon-box.purple {
        background: rgba(168, 85, 247, 0.12);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.25);
    }

    .metric-value {
        font-size: 2rem;
        font-weight: 800;
        font-family: var(--font-heading, 'Poppins'), sans-serif;
        line-height: 1.1;
        letter-spacing: -0.5px;
    }

    /* Main Table Container Card */
    .data-table-card {
        background: var(--bg-card, rgba(17, 24, 39, 0.7));
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
        border-radius: 1.25rem;
        backdrop-filter: blur(16px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
        overflow: hidden;
    }

    .data-table-toolbar {
        padding: 1.25rem 1.5rem;
        background: rgba(255, 255, 255, 0.015);
        border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.06));
    }

    .search-input-wrap {
        position: relative;
    }
    .search-input-wrap .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted, #94a3b8);
        font-size: 15px;
        pointer-events: none;
    }
    .search-input-wrap .search-clear-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: var(--text-muted, #94a3b8);
        cursor: pointer;
        font-size: 14px;
        padding: 0;
        display: none;
    }
    .search-input-wrap .search-clear-btn:hover {
        color: #ef4444;
    }
    .search-input-wrap input {
        padding-left: 40px;
        padding-right: 36px;
        height: 42px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
        color: var(--text-main, #f8fafc);
        font-size: 13.5px;
        transition: all 0.2s;
    }
    .search-input-wrap input:focus {
        background: rgba(255, 255, 255, 0.07);
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        color: var(--text-main, #f8fafc);
    }
    .search-input-wrap input::placeholder {
        color: rgba(148, 163, 184, 0.7);
    }

    /* Segmented Filter Buttons */
    .filter-segment-group {
        display: inline-flex;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
        padding: 3px;
        border-radius: 9999px;
    }
    .filter-segment-btn {
        border: none;
        background: transparent;
        color: var(--text-muted, #94a3b8);
        padding: 6px 14px;
        border-radius: 9999px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .filter-segment-btn:hover {
        color: var(--text-main, #ffffff);
    }
    .filter-segment-btn.active {
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
        color: #ffffff;
        box-shadow: 0 2px 10px rgba(14, 165, 233, 0.4);
    }

    /* Table Styles */
    .table-modern {
        width: 100%;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }
    .table-modern th {
        background: rgba(255, 255, 255, 0.02);
        color: var(--text-muted, #94a3b8);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.07));
        border-top: none;
    }
    .table-modern td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.05));
        color: var(--text-main, #f8fafc);
        vertical-align: middle;
        font-size: 13.5px;
        transition: background-color 0.15s;
    }
    .table-modern tbody tr:hover td {
        background-color: rgba(56, 189, 248, 0.035);
    }
    .table-modern tbody tr:last-child td {
        border-bottom: none;
    }

    /* Index Badge */
    .no-badge {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted, #94a3b8);
    }

    /* Area Title Box */
    .area-badge-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.15));
        border: 1px solid rgba(14, 165, 233, 0.3);
        color: #38bdf8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    /* Access Capsule Badges */
    .badge-access-capsule {
        padding: 6px 14px;
        border-radius: 9999px;
        font-size: 11.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        letter-spacing: 0.3px;
    }
    .badge-access-capsule.khusus {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .badge-access-capsule.all {
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
    }
    .badge-access-capsule.khusus .pulse-dot {
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
    }
    .badge-access-capsule.all .pulse-dot {
        background: #f59e0b;
        box-shadow: 0 0 8px #f59e0b;
    }

    /* PJA Person Pill Chips */
    .pja-person-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
        padding: 4px 10px 4px 5px;
        border-radius: 9999px;
        font-size: 11.5px;
        transition: all 0.2s;
    }
    .pja-person-chip:hover {
        background: rgba(56, 189, 248, 0.1);
        border-color: rgba(56, 189, 248, 0.3);
        transform: translateY(-1px);
    }
    .pja-avatar-mini {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        flex-shrink: 0;
    }
    .pja-more-btn {
        background: rgba(148, 163, 184, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.25);
        color: var(--text-muted, #94a3b8);
        padding: 3px 9px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }
    .pja-more-btn:hover {
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
        border-color: #38bdf8;
    }

    /* Action Buttons */
    .btn-action-circle {
        width: 34px;
        height: 34px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-muted, #94a3b8);
        transition: all 0.2s;
        font-size: 13.5px;
    }
    .btn-action-circle.edit:hover {
        background: rgba(14, 165, 233, 0.15);
        color: #38bdf8;
        border-color: rgba(14, 165, 233, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
    }
    .btn-action-circle.delete:hover {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    /* Modal Ultra-Premium Overrides */
    .modal-content.premium-modal {
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 1.5rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(56, 189, 248, 0.12);
        backdrop-filter: blur(24px);
    }
    .modal-header.premium-modal-hdr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        padding: 1.5rem 1.75rem 1.25rem 1.75rem;
    }
    .modal-body.premium-modal-body {
        padding: 1.5rem 1.75rem;
    }
    .modal-footer.premium-modal-ftr {
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        padding: 1.25rem 1.75rem 1.5rem 1.75rem;
    }

    .modal-field-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: #94a3b8;
        margin-bottom: 6px;
    }

    .premium-input {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #ffffff;
        border-radius: 12px;
        padding: 11px 16px;
        font-size: 14px;
        transition: all 0.2s;
    }
    .premium-input:focus {
        background: rgba(255, 255, 255, 0.08);
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
        color: #ffffff;
    }
    .premium-input::placeholder {
        color: rgba(148, 163, 184, 0.5);
    }

    /* Switch Card in Modal */
    .switch-option-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        padding: 1rem 1.25rem;
        transition: border-color 0.2s;
    }
    .switch-option-card.active {
        border-color: rgba(245, 158, 11, 0.4);
        background: rgba(245, 158, 11, 0.04);
    }

    /* Autocomplete Employee Results */
    .emp-results-dropdown {
        background: #1e293b;
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 14px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
        max-height: 250px;
        overflow-y: auto;
        z-index: 1065;
    }
    .emp-result-item {
        background: transparent;
        color: #f8fafc;
        border: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        transition: background-color 0.15s;
    }
    .emp-result-item:hover {
        background: rgba(56, 189, 248, 0.12);
        color: #ffffff;
    }
    .emp-result-item:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Selected PJA Chip Container in Modal */
    .selected-pjas-box {
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 14px;
        padding: 12px;
        min-height: 120px;
        max-height: 240px;
        overflow-y: auto;
    }

    .selected-pja-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 9999px;
        padding: 5px 12px 5px 6px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }
    .selected-pja-card:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(56, 189, 248, 0.4);
    }

    /* Floating Toast */
    .toast-container-custom {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 1090;
    }
    .toast-custom {
        background: #0f172a;
        color: #ffffff;
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 14px;
        padding: 12px 18px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 320px;
        animation: slideInToast 0.3s ease-out;
    }
    @@keyframes slideInToast {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>

<div class="area-pja-container">
    <!-- 1. HERO BANNER & PAGE HEADER -->
    <div class="hero-banner-card p-4 mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div class="d-flex align-items-start gap-3">
                <div class="hero-icon-emblem">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                        <span class="badge rounded-pill px-3 py-1 fw-bold" style="background: rgba(14, 165, 233, 0.15); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.3); font-size: 11px;">
                            <i class="bi bi-shield-lock-fill me-1"></i> MASTER DATA K3
                        </span>
                        <span class="badge rounded-pill px-3 py-1 fw-bold" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 11px;">
                            <i class="bi bi-phone-fill me-1"></i> SINKRONISASI MOBILE
                        </span>
                    </div>
                    <h2 class="fw-bold mb-1" style="font-size: 26px; color: var(--text-main, #ffffff); letter-spacing: -0.5px;">
                        Area Utama & Penanggung Jawab (PJA)
                    </h2>
                    <p class="text-muted mb-0" style="font-size: 13.5px; max-width: 780px;">
                        Pusat kendali pemetaan wilayah kerja tambang dan penugasan PJA resmi. Konfigurasi ini secara otomatis terintegrasi ke seluruh formulir aplikasi mobile (Hazard, Inspeksi, BBS, dan Coach).
                    </p>
                </div>
            </div>

            <!-- Header Action Buttons -->
            <div class="d-flex align-items-center gap-2 flex-wrap w-100 w-lg-auto">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 d-flex align-items-center gap-2" id="btnRefresh" onclick="handleRefreshClick()" title="Segarkan data area">
                    <i class="bi bi-arrow-clockwise" id="iconRefresh"></i>
                    <span>Refresh</span>
                </button>
                <button type="button" class="btn btn-primary rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); border: none; font-weight: 600;" onclick="openCreateModal()">
                    <i class="bi bi-plus-lg"></i>
                    <span>Tambah Area Utama</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 2. FOUR METRIC HUD CARDS -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Area -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card card-blue">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.6px;">Total Area Utama</span>
                    <div class="metric-icon-box blue">
                        <i class="bi bi-map-fill"></i>
                    </div>
                </div>
                <div class="metric-value text-info" id="statTotalArea">@ViewBag.TotalArea</div>
                <div class="small text-muted mt-1 d-flex align-items-center gap-1">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 11px;"></i> Seluruh sektor terdaftar
                </div>
            </div>
        </div>

        <!-- Card 2: PJA Khusus -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card card-green">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.6px;">PJA Khusus Ditetapkan</span>
                    <div class="metric-icon-box green">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
                <div class="metric-value text-success" id="statAreaKhusus">@ViewBag.AreaKhususCount</div>
                <div class="small text-muted mt-1 d-flex align-items-center gap-1">
                    <i class="bi bi-person-check-fill text-success" style="font-size: 11px;"></i> Terfilter ketat di mobile
                </div>
            </div>
        </div>

        <!-- Card 3: All Karyawan -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card card-amber">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.6px;">Akses Semua Karyawan</span>
                    <div class="metric-icon-box amber">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="metric-value text-warning" id="statAreaAll">@ViewBag.AreaAllCount</div>
                <div class="small text-muted mt-1 d-flex align-items-center gap-1">
                    <i class="bi bi-globe-americas text-warning" style="font-size: 11px;"></i> Pencarian terbuka publik
                </div>
            </div>
        </div>

        <!-- Card 4: Total Penugasan PJA -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card card-purple">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.6px;">Total Penugasan PJA</span>
                    <div class="metric-icon-box purple">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                </div>
                <div class="metric-value" style="color: #c084fc;" id="statTotalPja">@ViewBag.TotalPjaAssigned</div>
                <div class="small text-muted mt-1 d-flex align-items-center gap-1">
                    <i class="bi bi-award-fill" style="color: #c084fc; font-size: 11px;"></i> Personil penanggung jawab
                </div>
            </div>
        </div>
    </div>

    <!-- 3. DATA GRID TABLE CARD -->
    <div class="data-table-card">
        <!-- Toolbar: Search & Segmented Filters -->
        <div class="data-table-toolbar">
            <div class="row g-3 align-items-center justify-content-between">
                <!-- Search Input -->
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="search-input-wrap">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" id="searchInput" class="form-control" 
                               placeholder="Cari area utama, nama PJA, atau NIK..." 
                               oninput="handleSearchInput()" 
                               onkeydown="if(event.key === 'Escape'){ clearSearch(); }">
                        <button type="button" class="search-clear-btn" id="searchClearBtn" onclick="clearSearch()" title="Hapus pencarian">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                </div>

                <!-- Filters & Controls -->
                <div class="col-12 col-md-7 col-lg-8 d-flex flex-wrap align-items-center justify-content-md-end gap-3">
                    <!-- Segmented Filter Pills -->
                    <div class="filter-segment-group">
                        <button type="button" class="filter-segment-btn active" id="fltAll" onclick="filterData('')">
                            <i class="bi bi-grid-fill"></i> Semua Area
                        </button>
                        <button type="button" class="filter-segment-btn" id="fltKhusus" onclick="filterData('pja_khusus')">
                            <i class="bi bi-shield-check text-success"></i> PJA Khusus
                        </button>
                        <button type="button" class="filter-segment-btn" id="fltAllKaryawan" onclick="filterData('all_karyawan')">
                            <i class="bi bi-people-fill text-warning"></i> All Karyawan
                        </button>
                    </div>

                    <!-- Page Size Selector -->
                    <div class="d-flex align-items-center gap-1 text-muted small">
                        <span>Tampilkan:</span>
                        <select class="form-select form-select-sm rounded-pill" id="pageSizeSelect" style="width: 75px; background: rgba(255,255,255,0.04); border-color: var(--border-color); color: var(--text-main);" onchange="changePageSize(this.value)">
                            <option value="10">10</option>
                            <option value="15" selected>15</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Responsive -->
        <div class="table-responsive">
            <table class="table-modern" id="areasTable">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 60px;">#No</th>
                        <th style="min-width: 220px;">Area Utama</th>
                        <th style="width: 190px;">Tipe Akses Mobile</th>
                        <th style="min-width: 340px;">Daftar PJA Terdaftar</th>
                        <th class="text-center" style="width: 120px;">Kapasitas</th>
                        <th class="text-end pe-4" style="width: 130px;">Aksi</th>
                    </tr>
                </thead>
                <tbody id="areasTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <div class="spinner-border text-info spinner-border-sm me-2" role="status"></div>
                            Menghubungkan ke database & memuat data Area PJA...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer & Pagination -->
        <div class="p-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 border-top" style="border-color: var(--border-color, rgba(255,255,255,0.06)) !important;">
            <div class="small text-muted" id="paginationInfo">
                Menampilkan data...
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0 rounded-pill" id="paginationNav"></ul>
            </nav>
        </div>
    </div>
</div>

