        // Keyup handler with debounce
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('traineeSearchInput');
            const companyFilter = document.getElementById('traineeCompanyFilter');

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchDebounceTimer);
                    searchDebounceTimer = setTimeout(filterTraineeSuggestions, 300);
                });
                searchInput.addEventListener('focus', function() {
                    if (this.value.trim().length >= 2) filterTraineeSuggestions();
                });
                searchInput.addEventListener('keydown', function(e) {
