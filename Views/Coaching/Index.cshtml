@model IEnumerable<MBS_SAP.Models.Coaching>
@{
    ViewData["Title"] = "Coaching & Pembinaan - SAP";
    var userNik = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAdmin = User.IsInRole("Admin");
    var minDate = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
    var maxDate = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");

    string selectedCompanyIdVal = "";
    string selectedCompanyName = "";
    if (ViewBag.CompanyList != null && ViewBag.UserCompanyId != null)
    {
        foreach (var comp in ViewBag.CompanyList)
        {
            if (comp.PerusahaanId == (int)ViewBag.UserCompanyId)
            {
                selectedCompanyIdVal = comp.PerusahaanId.ToString();
                selectedCompanyName = comp.NamaPerusahaan;
                break;
            }
        }
    }
}

<style>
    @@keyframes sap-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    @@keyframes sap-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }
    .suggestion-item {
        transition: background 0.15s ease;
    }
    .suggestion-item:hover {
        background-color: rgba(124, 58, 237, 0.25) !important;
    }
    .company-option-btn:hover {
        background-color: rgba(124, 58, 237, 0.15) !important;
        color: #a855f7 !important;
    }
    .company-option-btn.active {
        background-color: rgba(124, 58, 237, 0.25) !important;
        color: #c084fc !important;
        font-weight: 700;
    }
    .trainee-chip {
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.4), rgba(168, 85, 247, 0.25)) !important;
        border: 1.5px solid #a855f7 !important;
        border-radius: 20px !important;
        padding: 6px 14px !important;
        color: #ffffff !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25) !important;
    }
    .trainee-badge-log {
        background-color: rgba(124, 58, 237, 0.18) !important;
        border: 1px solid rgba(168, 85, 247, 0.45) !important;
        color: #d8b4fe !important;
        font-size: 11px !important;
        font-weight: 600 !important;
        padding: 4px 10px !important;
        border-radius: 20px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
    }
    [data-bs-theme="light"] .trainee-badge-log,
    body.light-theme .trainee-badge-log {
        background-color: rgba(124, 58, 237, 0.12) !important;
        border-color: rgba(124, 58, 237, 0.35) !important;
        color: #6d28d9 !important;
    }
</style>

<div class="animate-fade-in pb-4">
    <!-- Header with Banner -->
    <div class="position-relative mb-4" style="margin: -20px -20px 20px -20px;">
        <div style="background: linear-gradient(135deg, #7c3aed, #a855f7); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; padding: 32px 20px 24px; text-align: center; position: relative; overflow: hidden;">
            <!-- Decorative circle -->
            <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: -30px; left: -10px; width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            
            <i class="bi bi-people-fill text-white mb-2 d-block" style="font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
            <h4 style="font-weight: 800; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.2); margin-bottom: 4px; letter-spacing: 0.5px;">COACHING & PEMBINAAN</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 12px; margin: 0; font-weight: 500;">Dokumentasikan sesi pembinaan dan sharing knowledge dengan tim.</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(244, 63, 94, 0.15); color: var(--color-red); border-radius: 12px;">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.15); color: #10b981; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hybrid Grid Layout: Form and List side-by-side on laptop, stacked on mobile -->
    <div class="form-responsive-row">
        
        <!-- Form Column -->
        <div class="card-sap border-purple-accent">
            <form asp-controller="Coaching" asp-action="Submit" method="post" enctype="multipart/form-data" id="coachingForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="coachingId" name="id" value="" />
                
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0" style="font-weight: 700; color: var(--text-main);" id="formTitle"><i class="bi bi-people-fill me-2" style="color: #a855f7;"></i>Catat Sesi Coaching Baru</h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelEdit" onclick="cancelEditCoaching()">
                        <i class="bi bi-x-circle me-1"></i> Batal Edit
                    </button>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="tanggal">Tanggal Kegiatan</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-calendar-event-fill input-sap-icon"></i>
                            <input type="date" id="tanggal" name="tanggal" class="input-sap" value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@minDate" max="@maxDate" required />
                        </div>
                    </div>
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="waktuStr">Waktu Mulai</label>
                        <div class="input-sap-wrapper">
                            <i class="bi bi-clock-fill input-sap-icon"></i>
                            <input type="time" id="waktuStr" name="waktuStr" class="input-sap" value="@DateTime.Now.ToString("HH:mm")" required />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="areaSearch">Area Utama</label>
                        <div class="position-relative mb-0">
                            <div class="input-sap-wrapper mb-0">
                                <i class="bi bi-geo-alt-fill input-sap-icon"></i>
                                <input type="text" id="areaSearch" class="input-sap text-uppercase" placeholder="Ketik untuk mencari area..." autocomplete="off" style="padding-right: 36px;" />
                                <i class="bi bi-chevron-down position-absolute" style="right: 12px; top: 14px; color: var(--text-muted); cursor: pointer;" id="toggleAreaDropdown"></i>
                            </div>
                            <!-- Hidden select for actual form submission -->
                            <select id="area" name="area" style="display:none;">
                                <option value="" disabled selected></option>
                            </select>
                            <!-- Dropdown list -->
                            <div id="areaDropdownMenu" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1050; background: var(--bg-card); border:1px solid var(--border-color); max-height:220px; overflow-y:auto; border-radius:8px; box-shadow: 0 8px 24px rgba(0,0,0,0.25);">
                                <!-- Populated by JS -->
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 form-group-sap">
                        <label class="form-label-sap" for="benchmarkSearch">Detail Lokasi / Benchmark</label>
                        <div class="d-flex align-items-center gap-2">
                            <div class="position-relative flex-grow-1 mb-0">
                                <div class="input-sap-wrapper mb-0">
                                    <i class="bi bi-compass-fill input-sap-icon"></i>
                                    <input type="text" id="benchmarkSearch" class="input-sap text-uppercase" placeholder="Pilih Area Utama dulu..." autocomplete="off" style="padding-right: 36px;" disabled />
                                    <i class="bi bi-chevron-down position-absolute" style="right: 12px; top: 14px; color: var(--text-muted); cursor: pointer;" id="toggleBenchmarkDropdown"></i>
                                </div>
                                <!-- Hidden input for actual form submission -->
                                <input type="hidden" id="detilLokasi" name="detilLokasi" value="" />
                                <!-- Dropdown list -->
                                <div id="benchmarkDropdownMenu" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1050; background: var(--bg-card); border:1px solid var(--border-color); max-height:220px; overflow-y:auto; border-radius:8px; box-shadow: 0 8px 24px rgba(0,0,0,0.25);">
                                    <!-- Populated by JS -->
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary shadow-sm" style="height: 46px; border-radius: 12px; padding: 0 16px; background-color: var(--color-primary); border: none;" onclick="$('#addBenchmarkModal').modal('show')" title="Tambah Benchmark Baru" id="btnAddBenchmark" disabled>
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-group-sap">
                    <label class="form-label-sap" for="lokasi">Lokasi Spesifik</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-geo-fill input-sap-icon"></i>
                        <input type="text" id="lokasi" name="lokasi" class="input-sap" placeholder="Masukkan lokasi spesifik / Klik ikon Lokasi Aktual GPS di kanan..." style="padding-right: 40px;" required />
                        <button type="button" class="btn btn-link p-0 position-absolute" id="btnGetLocation" style="right: 12px; top: 10px; color: var(--color-primary);" onclick="getLocation()" title="Ambil Lokasi Aktual GPS">
                            <i class="bi bi-crosshair"></i>
                        </button>
                    </div>
                    <small class="text-muted" style="font-size: 10px;">Lokasi Aktual GPS otomatis mengambil koordinat Anda atau Anda bisa mengetiknya secara manual.</small>
                </div>

                <div class="form-group-sap">
                    <label class="form-label-sap" for="tema">Tema Coaching</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-chat-quote-fill input-sap-icon"></i>
                        <select id="tema" name="tema" class="input-sap" required>
                            <option value="" disabled selected>Pilih Tema...</option>
                            <option value="Pembinaan">Pembinaan</option>
                            <option value="Sharing Knowledge">Sharing Knowledge</option>
                        </select>
                    </div>
                </div>

                <!-- Search and Add Trainee Selector -->
                <div class="form-group-sap position-relative">
                    <label class="form-label-sap">Pilih Peserta Coaching (Trainee)</label>

                    <!-- Company filter search dropdown -->
                    <div class="position-relative mb-2">
                        <div class="input-sap-wrapper mb-0">
                            <i class="bi bi-building input-sap-icon"></i>
                            <input type="text" id="traineeCompanySearch" class="input-sap" placeholder="Ketik untuk mencari / pilih perusahaan..." autocomplete="off" style="padding-right: 64px; font-size: 13px;" value="@selectedCompanyName" />
                            <div class="position-absolute d-flex align-items-center gap-1" style="right: 12px; top: 12px; z-index: 5;">
                                <i class="bi bi-x-circle-fill text-muted" id="clearTraineeCompany" style="cursor: pointer; font-size: 14px; display: @(!string.IsNullOrEmpty(selectedCompanyName) ? "inline-block" : "none");" title="Reset filter perusahaan"></i>
                                <i class="bi bi-chevron-down text-muted" id="toggleTraineeCompanyDropdown" style="cursor: pointer; font-size: 13px;"></i>
                            </div>
                        </div>
                        <input type="hidden" id="traineeCompanyFilter" value="@selectedCompanyIdVal" />
                        <div id="traineeCompanyDropdownMenu" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1050; background: var(--bg-card); border:1px solid var(--border-color); max-height:220px; overflow-y:auto; border-radius:8px; box-shadow: 0 8px 24px rgba(0,0,0,0.25); padding: 4px;">
                        </div>
                    </div>

                    <!-- Search input and button -->
                    <div class="d-flex gap-2 mb-2">
                        <div class="input-sap-wrapper flex-grow-1 mb-0" style="position: relative;">
                            <i class="bi bi-search input-sap-icon"></i>
                            <input type="text" id="traineeSearchInput" class="input-sap" placeholder="Ketik nama atau NIK peserta (min 2 karakter)..." autocomplete="off" />
                            <span id="traineeSearchSpinner" class="d-none" style="position: absolute; right: 12px; top: 10px;">
                                <span class="spinner-border spinner-border-sm text-purple" style="width:14px;height:14px;border-color:#a855f7;border-right-color:transparent;" role="status"></span>
                            </span>
                            <div id="traineeSuggestions" class="d-none" style="position: absolute; left: 0; right: 0; top: 100%; max-height: 220px; overflow-y: auto; background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.25); padding: 4px;">
                            </div>
                        </div>
                        <button type="button" id="btnSearchTrainee" class="btn btn-sap-primary px-3" style="background-color: #7c3aed; border-color: #6d28d9; border-radius: 12px;" onclick="filterTraineeSuggestions()">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <!-- Selected Trainees Container -->
                    <div id="selectedTraineesContainer" class="d-flex flex-wrap gap-2 p-3 mb-2" style="border: 1px solid var(--border-color); border-radius: 12px; min-height: 54px; background: rgba(0,0,0,0.25); align-items: center;">
                        <span class="text-muted" id="noTraineesLabel" style="font-size: 13px;">Belum ada peserta yang dipilih. Ketik & pilih dari hasil pencarian di atas.</span>
                    </div>
                    <small class="text-muted" style="font-size: 10px;">Gunakan pencarian perusahaan di atas untuk mempercepat mencari peserta per perusahaan</small>
                </div>

                <div class="form-group-sap">
                    <label class="form-label-sap" for="feedback">Umpan Balik (Feedback)</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-chat-left-text-fill input-sap-icon" style="top: 14px;"></i>
                        <textarea id="feedback" name="feedback" class="input-sap" rows="3" placeholder="Masukkan umpan balik atau respons peserta..." style="padding-left: 42px;"></textarea>
                    </div>
                </div>

                <div class="form-group-sap">
                    <label class="form-label-sap" for="komitmen">Komitmen Bersama</label>
                    <div class="input-sap-wrapper">
                        <i class="bi bi-shield-fill-check input-sap-icon" style="top: 14px;"></i>
                        <textarea id="komitmen" name="komitmen" class="input-sap" rows="3" placeholder="Masukkan rencana aksi atau komitmen pasca coaching..." style="padding-left: 42px;"></textarea>
                    </div>
                </div>

                <!-- Event Photo -->
                <div class="form-group-sap mb-4">
                    <label class="form-label-sap">Foto Kegiatan Coaching <span class="text-danger">*</span></label>
                    <input type="file" id="fotoInput" name="foto" accept="image/*" class="d-none" onchange="previewFoto(this)" />
                    <div class="upload-card" onclick="document.getElementById('fotoInput').click()" style="padding: 24px 12px; border-color: rgba(168, 85, 247, 0.4);">
                        <div id="fotoPlaceholder">
                            <i class="bi bi-camera-fill text-purple" style="font-size: 24px; color: #a855f7;"></i>
                            <span class="d-block" style="font-size: 12px; font-weight: 700; margin-top: 4px; color: var(--text-main);">Unggah Foto Coaching</span>
                        </div>
                        <div id="fotoPreviewContainer" class="d-none">
                            <img id="fotoPreview" src="" alt="Preview" style="max-width: 100%; max-height: 120px; border-radius: 6px;" />
                        </div>
                    </div>
                </div>

                <button type="submit" id="btnSubmitCoaching" class="btn btn-sap-primary w-100 py-3" style="background-color: #7c3aed; border-color: #6d28d9; font-weight: 700; border-radius: 12px; letter-spacing: 0.5px;">
                    <i class="bi bi-check-circle-fill me-2"></i> SIMPAN COACHING
                </button>
            </form>
        </div>

        <!-- History/List Column -->
        <div>
            <div class="history-header mb-3">
                <h6 style="font-weight: 700; color: var(--text-main);"><i class="bi bi-card-list me-2" style="color: #a855f7;"></i>Log Coaching & Pembinaan</h6>
            </div>
            
            @if (Model == null || !Model.Any())
            {
                <div class="card-sap text-center py-4 text-muted">
                    <i class="bi bi-inbox-fill d-block mb-2" style="font-size: 32px;"></i>
                    Belum ada sesi coaching tercatat.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var item in Model)
                    {
                        <div class="card-sap border-purple-accent mb-0">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge" style="background-color: rgba(124, 58, 237, 0.15); color: #c084fc; font-size: 10px; padding: 4px 8px; border-radius: 6px;">@item.Tema</span>
                                    <span class="d-block" style="font-weight: 700; font-size: 14px; margin-top: 4px; color: var(--text-main);"><i class="bi bi-geo-alt-fill me-1 text-muted"></i>@(item.Lokasi ?? item.Area ?? "General")</span>
                                </div>
                                <span class="status-badge approved" style="font-size: 9px; background-color: rgba(16, 185, 129, 0.15); color: #10b981;">
                                    Selesai
                                </span>
                            </div>

                            <div style="font-size: 12px; margin: 8px 0; color: var(--text-muted);">
                                <div><strong>Coach:</strong> @item.Nama (@item.Nik)</div>
                                <div class="mt-1">
                                    <strong style="color: var(--text-main); font-size: 11px;"><i class="bi bi-people-fill me-1" style="color: #a855f7;"></i>Peserta Coaching (@item.Participants.Count):</strong>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        @foreach (var p in item.Participants)
                                        {
                                            <span class="trainee-badge-log">
                                                <i class="bi bi-person-check-fill" style="color: #c084fc; font-size: 11px;"></i> @p.Nama
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Feedback))
                            {
                                <div style="font-size: 11px; color: var(--text-muted); background-color: var(--bg-layout); padding: 8px; border-radius: 6px; margin: 8px 0; border-left: 3px solid #7c3aed; white-space: pre-line;">
                                    <strong>Umpan Balik:</strong><br />@item.Feedback
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.Komitmen))
                            {
                                <div style="font-size: 11px; color: var(--text-muted); background-color: var(--bg-layout); padding: 8px; border-radius: 6px; margin: 8px 0; border-left: 3px solid #10b981; white-space: pre-line;">
                                    <strong>Komitmen:</strong><br />@item.Komitmen
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.Foto))
                            {
                                @if (item.Nik == userNik)
                                {
                                    var proxyFoto = item.Foto.StartsWith("http") ? "/ImageProxy/Get?url=" + Uri.EscapeDataString(item.Foto) : item.Foto;
                                    <div class="my-2">
                                        <a href="@proxyFoto" target="_blank">
                                            <img src="@proxyFoto" alt="Coaching Photo" style="max-height: 60px; border-radius: 4px; border: 1px solid var(--border-color);" />
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="px-2 py-1.5 d-flex align-items-center gap-1.5 mb-2" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; max-width: fit-content;">
                                        <i class="bi bi-shield-lock-fill text-warning" style="font-size: 13px;"></i>
                                        <span class="text-muted" style="font-size: 10px;">Foto dikunci</span>
                                    </div>
                                }
                            }

                            <div class="d-flex justify-content-between align-items-center pt-2 mt-2" style="border-top: 1px solid var(--border-color); font-size: 11px; color: var(--text-muted);">
                                <div class="d-flex align-items-center gap-2">
                                    <span><i class="bi bi-building me-1"></i>@item.Departemen</span>
                                    @if (item.Nik == userNik || isAdmin)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border: 1px solid var(--border-color); background: var(--bg-card); font-size: 13px;">
                                                <li><a class="dropdown-item" href="javascript:void(0)" style="color: var(--text-main);" onclick="editCoaching(@item.Id)"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Laporan</a></li>
                                                <li><hr class="dropdown-divider border-secondary"></li>
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteCoaching(@item.Id)"><i class="bi bi-trash-fill me-2"></i>Hapus Laporan</a></li>
                                            </ul>
                                        </div>
                                    }
                                </div>
                                <span><i class="bi bi-clock me-1"></i>@item.Tanggal.ToString("dd MMM yyyy") @item.Waktu.ToString(@"hh\:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 99999; justify-content: center; align-items: center; flex-direction: column; color: white; font-family: 'Poppins', sans-serif;">
    <div class="loader-spinner-container" style="position: relative; width: 100px; height: 100px; display: flex; justify-content: center; align-items: center; margin-bottom: 24px;">
        <div class="loader-circle" style="box-sizing: border-box; width: 80px; height: 80px; border: 4px solid rgba(255, 255, 255, 0.15); border-radius: 50%; border-top-color: #a855f7; border-bottom-color: #a855f7; animation: sap-spin 1.5s linear infinite;"></div>
        <i class="bi bi-people-fill" style="position: absolute; font-size: 32px; color: white; animation: sap-bounce 2s ease-in-out infinite;"></i>
    </div>
    <h5 id="loadingTitle" style="font-weight: 700; margin-bottom: 8px; letter-spacing: 0.5px; text-align: center; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Memproses Laporan Coaching</h5>
    <p id="loadingSubtitle" style="font-size: 13px; color: rgba(255,255,255,0.75); margin-bottom: 16px; text-align: center; max-width: 340px; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">Sedang menyimpan laporan coaching dan peserta. Mohon jangan menutup halaman ini...</p>

    <!-- Progress Bar Container -->
    <div style="width: 280px; background: rgba(255,255,255,0.1); height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.05);">
        <div id="loadingProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #7c3aed, #c084fc); transition: width 0.1s ease; border-radius: 4px;"></div>
    </div>
    <div id="loadingProgressPercent" style="font-size: 14px; font-weight: 700; color: #c084fc; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">0%</div>
</div>



@section Scripts {
    <script>
        function previewFoto(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('fotoPreview').src = e.target.result;
                    document.getElementById('fotoPlaceholder').classList.add('d-none');
                    document.getElementById('fotoPreviewContainer').classList.remove('d-none');
                    $(input).removeClass('is-invalid');
                    $(input).closest('.form-group-sap').find('.sap-err-msg').remove();
                }
                reader.readAsDataURL(file);
            }
        }

        const allEmployees = [];  // not used for search anymore (server-side)

        let selectedTrainees = [];
        let searchDebounceTimer = null;

        function escapeHtml(str) {
            return String(str ?? '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        let isCoachingSubmitting = false;

        function resetButtonState() {
            isCoachingSubmitting = false;
            $('#loadingOverlay').css('display', 'none');
            var coachingId = $('#coachingId').val();
            var btnText = '<i class="bi bi-check-circle-fill me-2"></i> ' + (coachingId ? 'PERBARUI COACHING' : 'SIMPAN COACHING');
            var $btn = $('#btnSubmitCoaching, #coachingForm button[type="submit"]');
            $btn.prop('disabled', false).css('pointer-events', 'auto').html(btnText);
        }

        function showSapErrorPopup(title, errors, fallbackMessage) {
            resetButtonState();
            const cleanErrors = Array.isArray(errors) && errors.length > 0 
                ? errors 
                : (typeof errors === 'string' && errors.trim().length > 0 ? [errors] : [fallbackMessage || 'Data belum lengkap.']);
            
            $('#sapErrorModal').remove();
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');

            const listHtml = cleanErrors.map(item => `<li style="margin-bottom: 8px;">${escapeHtml(item)}</li>`).join('');
            const modalHtml = `
                <div class="modal fade" id="sapErrorModal" tabindex="-1" aria-hidden="true" style="z-index: 10050;">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="background: var(--bg-card, #1e293b); color: var(--text-main, #f8fafc); border: 1px solid rgba(239,68,68,0.5); border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
                            <div class="modal-header" style="border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1)); padding: 16px 20px;">
                                <h5 class="modal-title d-flex align-items-center" style="font-size: 16px; font-weight: 800; color: #ef4444;">
                                    <i class="bi bi-exclamation-triangle-fill text-danger me-2" style="font-size: 20px;"></i>
                                    ${escapeHtml(title || 'Data Belum Lengkap')}
                                </h5>
                                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body" style="font-size: 13px; line-height: 1.6; padding: 20px;">
                                <div class="mb-2 fw-semibold text-danger">Periksa dan lengkapi bagian berikut:</div>
                                <ul class="mb-0 ps-3" style="color: var(--text-main, #f8fafc);">
                                    ${listHtml}
                                </ul>
                            </div>
                            <div class="modal-footer" style="border-top: 1px solid var(--border-color, rgba(255,255,255,0.1)); padding: 12px 20px;">
                                <button type="button" class="btn btn-danger px-4 py-2" data-bs-dismiss="modal" style="border-radius: 8px; font-weight: 600; font-size: 13px;">
                                    <i class="bi bi-check2 me-1"></i> Mengerti & Perbaiki
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
            $('body').append(modalHtml);

            try {
                const modalEl = document.getElementById('sapErrorModal');
                if (window.bootstrap && bootstrap.Modal) {
                    const myModal = bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: true, keyboard: true });
                    $(modalEl).on('hidden.bs.modal', function() {
                        resetButtonState();
                        $('#sapErrorModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    });
                    myModal.show();
                } else if ($.fn.modal) {
                    $(modalEl).on('hidden.bs.modal', function() {
                        resetButtonState();
                        $('#sapErrorModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    }).modal('show');
                } else {
                    alert((title || 'Data belum lengkap') + '\n\n- ' + cleanErrors.join('\n- '));
                }
            } catch(e) {
                alert((title || 'Data belum lengkap') + '\n\n- ' + cleanErrors.join('\n- '));
            }
        }
        function showSapSuccessPopup(title, message) {
            $('#sapSuccessModal').remove();
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');

            const safeTitle = escapeHtml(title || 'Berhasil Disimpan!');
            const safeMsg = escapeHtml(message || 'Data coaching berhasil disimpan ke sistem.');

            const modalHtml = `
                <div class="modal fade" id="sapSuccessModal" tabindex="-1" aria-hidden="true" style="z-index: 10050;">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="background: var(--bg-card, #1e293b); color: var(--text-main, #f8fafc); border: 1.5px solid rgba(16, 185, 129, 0.5); border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); overflow: hidden;">
                            <div class="modal-body text-center p-4">
                                <div style="width: 72px; height: 72px; background: rgba(16, 185, 129, 0.15); border: 2px solid #10b981; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                                    <i class="bi bi-check2-circle" style="font-size: 40px; color: #10b981;"></i>
                                </div>
                                <h4 style="font-weight: 800; color: #10b981; margin-bottom: 8px;">${safeTitle}</h4>
                                <p style="font-size: 14px; color: var(--text-muted, #94a3b8); margin-bottom: 24px; line-height: 1.5;">${safeMsg}</p>
                                <button type="button" class="btn btn-success px-5 py-2.5 w-100" data-bs-dismiss="modal" style="background-color: #10b981; border-color: #059669; border-radius: 12px; font-weight: 700; font-size: 14px; letter-spacing: 0.3px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
                                    <i class="bi bi-check-lg me-1"></i> OK, Mengerti
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
            $('body').append(modalHtml);

            try {
                const modalEl = document.getElementById('sapSuccessModal');
                if (window.bootstrap && bootstrap.Modal) {
                    const myModal = bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: true, keyboard: true });
                    $(modalEl).on('hidden.bs.modal', function() {
                        $('#sapSuccessModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    });
                    myModal.show();
                } else if ($.fn.modal) {
                    $(modalEl).on('hidden.bs.modal', function() {
                        $('#sapSuccessModal').remove();
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open').css('overflow', '').css('padding-right', '');
                    }).modal('show');
                } else {
                    alert(safeTitle + '\n\n' + safeMsg);
                }
            } catch(e) {
                alert(safeTitle + '\n\n' + safeMsg);
            }
        }

        const serverErrorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]));
        if (serverErrorMessage) {
            setTimeout(() => showSapErrorPopup("Terjadi kesalahan", [serverErrorMessage]), 250);
        }

        const serverSuccessMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]));
        if (serverSuccessMessage) {
            setTimeout(() => showSapSuccessPopup("Berhasil Disimpan!", serverSuccessMessage), 250);
        }

        let globalCompanyList = [
            { id: '', name: '— Semua Perusahaan —' },
            @if (ViewBag.CompanyList != null)
            {
                foreach (var comp in ViewBag.CompanyList)
                {
                    <text>{ id: '@comp.PerusahaanId', name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)comp.NamaPerusahaan)) },</text>
                }
            }
        ];

        function renderTraineeCompanyDropdown(filterText) {
            const menu = $('#traineeCompanyDropdownMenu');
            menu.empty();
            const clean = (filterText || '').trim().toLowerCase();
            const currentVal = $('#traineeCompanyFilter').val();

            const filtered = globalCompanyList.filter(c => {
                if (!c.id) return true;
                return !clean || c.name.toLowerCase().includes(clean);
            });

            if (filtered.length > 0) {
                filtered.forEach(comp => {
                    const isSelected = String(comp.id) === String(currentVal) || (!comp.id && !currentVal);
                    const icon = comp.id ? 'bi-building' : 'bi-globe2';
                    const btn = $('<button type="button"></button>')
                        .addClass('d-flex align-items-center justify-content-between w-100 text-start py-2 px-3 border-0 company-option-btn')
                        .toggleClass('active', isSelected)
                        .css({
                            background: isSelected ? 'rgba(124, 58, 237, 0.2)' : 'none',
                            color: isSelected ? '#a855f7' : 'var(--text-main)',
                            fontSize: '13px',
                            borderRadius: '6px',
                            cursor: 'pointer',
                            marginBottom: '2px',
                            borderBottom: '1px solid var(--border-color)'
                        })
                        .html(`<span><i class="bi ${icon} me-2 ${isSelected ? 'text-purple' : 'text-muted'}"></i>${escapeHtml(comp.name)}</span>` +
                              (isSelected ? '<i class="bi bi-check2 text-purple fw-bold"></i>' : ''))
                        .on('click', function(e) {
                            e.preventDefault();
                            selectTraineeCompany(comp.id, comp.id ? comp.name : '');
                        });
                    menu.append(btn);
                });
            } else {
                menu.append('<div class="p-3 text-center text-muted" style="font-size:12px;"><i class="bi bi-search me-1"></i>Perusahaan "' + escapeHtml(filterText) + '" tidak ditemukan</div>');
            }

            menu.show();
        }

        function selectTraineeCompany(id, name) {
            $('#traineeCompanyFilter').val(id);
            $('#traineeCompanySearch').val(name);
            $('#traineeCompanyDropdownMenu').hide();

            if (id) {
                $('#clearTraineeCompany').show();
            } else {
                $('#clearTraineeCompany').hide();
            }

            const input = document.getElementById('traineeSearchInput');
            if (input && input.value.trim().length >= 2) {
                filterTraineeSuggestions();
            }
        }

        function getSelectedCompanyId() {
            const el = document.getElementById('traineeCompanyFilter');
            return el ? el.value : '';
        }

        async function fetchTraineeSuggestions(term) {
            const companyId = getSelectedCompanyId();
            let url = '/Coaching/SearchEmployees?q=' + encodeURIComponent(term);
            if (companyId) url += '&companyId=' + encodeURIComponent(companyId);

            const spinner = document.getElementById('traineeSearchSpinner');
            if (spinner) spinner.classList.remove('d-none');

            try {
                const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) return [];
                return await resp.json();
            } catch {
                return [];
            } finally {
                if (spinner) spinner.classList.add('d-none');
            }
        }

        async function filterTraineeSuggestions() {
            const input = document.getElementById('traineeSearchInput');
            const suggestions = document.getElementById('traineeSuggestions');
            const term = (input ? input.value : '').trim();

            if (term.length < 2) {
                suggestions.classList.add('d-none');
                suggestions.innerHTML = '';
                return;
            }

            const matches = await fetchTraineeSuggestions(term);

            if (!matches || matches.length === 0) {
                suggestions.innerHTML = '<div class="text-muted p-2" style="font-size: 13px;">Karyawan tidak ditemukan</div>';
            } else {
                suggestions.innerHTML = matches.map(emp => `
                    <div class="suggestion-item p-2.5 d-flex justify-content-between align-items-center" style="cursor: pointer; border-radius: 8px; font-size: 13px; color: var(--text-main); margin-bottom: 2px; border-bottom: 1px solid var(--border-color);" 
                         data-nik="${escapeHtml(emp.nik)}" data-nama="${escapeHtml(emp.nama)}"
                         onclick="addTraineeFromElement(this)">
                        <div>
                            <i class="bi bi-person-circle me-1" style="color: #a855f7;"></i>
                            <strong style="color: var(--text-main); font-weight: 700;">${escapeHtml(emp.nama)}</strong>
                            <span style="color: var(--text-muted); font-size: 11px; margin-left: 4px;">(${escapeHtml(emp.nik)})</span>
                        </div>
                        <span class="badge" style="background: rgba(168, 85, 247, 0.2); color: #c084fc; font-size: 10px; font-weight: 600; border-radius: 6px; border: 1px solid rgba(168, 85, 247, 0.4); padding: 4px 8px;">${escapeHtml(emp.companyName)}</span>
                    </div>
                `).join('');
            }
            suggestions.classList.remove('d-none');
        }

        function addTraineeFromElement(el) {
            const nik = el.getAttribute('data-nik');
            const name = el.getAttribute('data-nama');
            addTrainee(nik, name);
        }

        function addTrainee(nik, name) {
            if (selectedTrainees.some(t => t.nik === nik)) {
                document.getElementById('traineeSearchInput').value = '';
                document.getElementById('traineeSuggestions').classList.add('d-none');
                return;
            }

            selectedTrainees.push({ nik: nik, name: name });
            renderTraineeChips();

            document.getElementById('traineeSearchInput').value = '';
            document.getElementById('traineeSuggestions').classList.add('d-none');
        }

        function removeTrainee(nik) {
            selectedTrainees = selectedTrainees.filter(t => t.nik !== nik);
            renderTraineeChips();
        }

        function renderTraineeChips() {
            const container = document.getElementById('selectedTraineesContainer');

            if (selectedTrainees.length === 0) {
                container.innerHTML = `<span class="text-muted" id="noTraineesLabel" style="font-size: 13px;">Belum ada peserta yang dipilih. Ketik &amp; pilih dari hasil pencarian di atas.</span>`;
            } else {
                container.innerHTML = selectedTrainees.map(t => `
                    <div class="trainee-chip m-1">
                        <span class="d-flex align-items-center gap-1.5">
                            <i class="bi bi-person-fill" style="color: #c084fc; font-size: 13px;"></i>
                            <strong style="color: #ffffff; font-weight: 700; font-size: 12px; letter-spacing: 0.2px;">${escapeHtml(t.name)}</strong>
                            <span style="color: #e9d5ff; font-weight: 500; font-size: 11px;">(${escapeHtml(t.nik)})</span>
                        </span>
                        <i class="bi bi-x-circle-fill text-danger" style="cursor: pointer; font-size: 15px; margin-left: 2px; transition: transform 0.15s;" onmouseenter="$(this).css('transform','scale(1.2)')" onmouseleave="$(this).css('transform','scale(1)')" data-nik="${escapeHtml(t.nik)}" onclick="removeTrainee(this.getAttribute('data-nik'))" title="Hapus peserta"></i>
                        <input type="hidden" name="selectedParticipants" value="${escapeHtml(t.nik)}" />
                    </div>
                `).join('');
            }
        }

        // Close suggestions dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const container = document.getElementById('traineeSuggestions');
            const input = document.getElementById('traineeSearchInput');
            if (container && input && e.target !== input && !container.contains(e.target)) {
                container.classList.add('d-none');
            }
        });

        // Keyup handler with debounce
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('traineeSearchInput');
            const companyFilter = document.getElementById('traineeCompanyFilter');

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchDebounceTimer);
                    searchDebounceTimer = setTimeout(filterTraineeSuggestions, 300);
                });
                searchInput.addEventListener('focus', function() {
                    if (this.value.trim().length >= 2) filterTraineeSuggestions();
                });
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        clearTimeout(searchDebounceTimer);
                        filterTraineeSuggestions();
                    }
                });
            }
            if (companyFilter) {
                companyFilter.addEventListener('change', function() {
                    const input = document.getElementById('traineeSearchInput');
                    if (input && input.value.trim().length >= 2) filterTraineeSuggestions();
                });
            }
        });

        // Geolocation Function
        function getLocation() {
            var btn = document.getElementById('btnGetLocation');
            var input = document.getElementById('lokasi');
            var detailInput = document.getElementById('detilLokasi');

            function buildSpecificLocationLabel(payload) {
                if (!payload) return '';
                const addr = payload.address || {};
                const candidates = [
                    addr.road,
                    addr.path,
                    addr.neighbourhood,
                    addr.suburb,
                    addr.village,
                    addr.hamlet,
                    addr.city_district,
                    addr.city,
                    addr.county,
                    addr.state
                ];
                const compact = candidates
                    .filter(function(x) { return typeof x === 'string' && x.trim().length > 0; })
                    .slice(0, 4)
                    .join(', ');

                return compact || (typeof payload.display_name === 'string' ? payload.display_name : '');
            }

            async function fillSpecificLocation(lat, lon) {
                if (!detailInput) return;
                try {
                    const endpoint = 'https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=' + encodeURIComponent(lat) + '&lon=' + encodeURIComponent(lon) + '&zoom=18&addressdetails=1';
                    const response = await fetch(endpoint, { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) return;
                    const json = await response.json();
                    const resolved = buildSpecificLocationLabel(json);
                    if (resolved) {
                        detailInput.value = resolved;
                    }
                } catch (e) {
                    // Fail silently
                }
            }
            
            if (navigator.geolocation) {
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 14px; height: 14px;"></span>';
                navigator.geolocation.getCurrentPosition(async function(position) {
                    var lat = position.coords.latitude.toFixed(6);
                    var lon = position.coords.longitude.toFixed(6);
                    input.value = lat + ", " + lon;
                    await fillSpecificLocation(lat, lon);
                    btn.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
                }, function(error) {
                    alert('Gagal mendapatkan lokasi GPS: ' + error.message);
                    btn.innerHTML = '<i class="bi bi-crosshair text-danger"></i>';
                }, {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                });
            } else {
                alert("Geolocation tidak didukung oleh browser ini.");
            }
        }

        function cancelEditCoaching() {
            $('#coachingForm')[0].reset();
            $('#coachingId').val('');
            $('#formTitle').html('<i class="bi bi-people-fill me-2" style="color: #a855f7;"></i>Catat Sesi Coaching Baru');
            $('#btnCancelEdit').addClass('d-none');
            $('#coachingForm').find('button[type="submit"]').prop('disabled', false).html('<i class="bi bi-check-circle-fill me-2"></i> SIMPAN COACHING');
            $('#coachingForm').find('.is-invalid').removeClass('is-invalid');
            $('#coachingForm').find('.sap-err-msg').remove();
            
            // Reset image preview
            $('#fotoPreview').attr('src', '');
            $('#fotoPreviewContainer').addClass('d-none');
            $('#fotoPlaceholder').removeClass('d-none');

            // Reset trainees
            selectedTrainees = [];
            renderTraineeChips();

            // Reset trainee company search to default
            const defaultCompanyId = '@selectedCompanyIdVal';
            const defaultCompanyName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedCompanyName));
            selectTraineeCompany(defaultCompanyId, defaultCompanyName);

            // Reset areas and benchmarks
            $('#areaSearch').val('');
            $('#benchmarkSearch').prop('disabled', true).val('Pilih Area Utama dulu...');
            $('#btnAddBenchmark').prop('disabled', true);
            $('#detilLokasi').val('');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function editCoaching(id) {
            $.get('/Coaching/GetData/' + id, function(data) {
                if (data) {
                    cancelEditCoaching(); // reset first
                    $('#coachingId').val(data.id);
                    
                    if (data.tanggal) $('#tanggal').val(data.tanggal.split('T')[0]);
                    if (data.waktu) $('#waktuStr').val(data.waktu.substring(0, 5));
                    
                    $('#area').val(data.area);
                    $('#areaSearch').val(data.area);
                    if (data.area) {
                        loadBenchmarks(data.area, data.detilLokasi);
                    } else {
                        $('#benchmarkSearch').prop('disabled', true).val('Pilih Area Utama dulu...');
                        $('#btnAddBenchmark').prop('disabled', true);
                    }
                    $('#lokasi').val(data.lokasi);
                    $('#detilLokasi').val(data.detilLokasi);
                    $('#tema').val(data.tema).change();
                    $('#feedback').val(data.feedback);
                    $('#komitmen').val(data.komitmen);

                    if (data.foto) {
                        var proxyFoto = data.foto.startsWith("http") ? "/ImageProxy/Get?url=" + encodeURIComponent(data.foto) : data.foto;
                        $('#fotoPreview').attr('src', proxyFoto);
                        $('#fotoPlaceholder').addClass('d-none');
                        $('#fotoPreviewContainer').removeClass('d-none');
                    }

                    // Check selected participants
                    selectedTrainees = [];
                    if (data.participants && data.participants.length > 0) {
                        // Fetch names for existing participants via server search
                        const nikList = data.participants;
                        const fetchPromises = nikList.map(nik =>
                            fetch('/Coaching/SearchEmployees?q=' + encodeURIComponent(nik), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                                .then(r => r.ok ? r.json() : [])
                                .then(results => {
                                    const found = Array.isArray(results) ? results.find(e => e.nik === nik) : null;
                                    return { nik: nik, name: found ? found.nama : nik };
                                })
                                .catch(() => ({ nik: nik, name: nik }))
                        );
                        Promise.all(fetchPromises).then(resolved => {
                            selectedTrainees = resolved;
                            renderTraineeChips();
                        });
                    }

                    $('#formTitle').html('<i class="bi bi-pencil-square me-2" style="color: #a855f7;"></i>Edit Laporan Coaching');
                    $('#btnCancelEdit').removeClass('d-none');
                    $('#coachingForm').find('button[type="submit"]').prop('disabled', false).html('<i class="bi bi-check-circle-fill me-2"></i> PERBARUI COACHING');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }).fail(function() {
                alert("Gagal mengambil data coaching. Laporan mungkin sudah dihapus.");
            });
        }

        function deleteCoaching(id) {
            if (confirm("Apakah Anda yakin ingin menghapus laporan coaching ini?")) {
                var form = $('<form action="/Coaching/Delete/' + id + '" method="post">' +
                             '<input type="hidden" name="__RequestVerificationToken" value="' + $('input[name="__RequestVerificationToken"]').val() + '" />' +
                             '</form>');
                $('body').append(form);
                form.submit();
            }
        }

        $(document).ready(function() {
            // Load areas list
            loadAreas();

            // Toggle area dropdown on chevron click
            $('#toggleAreaDropdown').on('click', function() {
                var menu = $('#areaDropdownMenu');
                if (menu.is(':visible')) {
                    menu.hide();
                } else {
                    renderAreaDropdown($('#areaSearch').val());
                    menu.show();
                }
            });

            // Filter dropdown on keyup
            $('#areaSearch').on('input keyup', function() {
                renderAreaDropdown($(this).val());
            });

            // Open dropdown on focus
            $('#areaSearch').on('focus', function() {
                renderAreaDropdown($(this).val());
            });

            // Toggle benchmark dropdown on chevron click
            $('#toggleBenchmarkDropdown').on('click', function() {
                if ($('#benchmarkSearch').prop('disabled')) return;
                var menu = $('#benchmarkDropdownMenu');
                if (menu.is(':visible')) {
                    menu.hide();
                } else {
                    renderBenchmarkDropdown($('#benchmarkSearch').val());
                    menu.show();
                }
            });

            // Filter dropdown on keyup
            $('#benchmarkSearch').on('input keyup', function() {
                renderBenchmarkDropdown($(this).val());
                if($(this).val() === '') $('#detilLokasi').val('');
            });

            // Open dropdown on focus
            $('#benchmarkSearch').on('focus', function() {
                if ($('#benchmarkSearch').prop('disabled')) return;
                renderBenchmarkDropdown($(this).val());
            });

            // Trainee Company search event listeners
            $('#traineeCompanySearch').on('focus input keyup', function() {
                renderTraineeCompanyDropdown($(this).val());
                if ($(this).val().trim() === '') {
                    $('#traineeCompanyFilter').val('');
                    $('#clearTraineeCompany').hide();
                    const input = document.getElementById('traineeSearchInput');
                    if (input && input.value.trim().length >= 2) {
                        filterTraineeSuggestions();
                    }
                }
            });

            $('#toggleTraineeCompanyDropdown').on('click', function(e) {
                e.stopPropagation();
                var menu = $('#traineeCompanyDropdownMenu');
                if (menu.is(':visible')) {
                    menu.hide();
                } else {
                    renderTraineeCompanyDropdown($('#traineeCompanySearch').val());
                }
            });

            $('#clearTraineeCompany').on('click', function(e) {
                e.stopPropagation();
                selectTraineeCompany('', '');
                $('#traineeCompanySearch').focus();
            });

            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#benchmarkSearch, #benchmarkDropdownMenu, #toggleBenchmarkDropdown').length) {
                    $('#benchmarkDropdownMenu').hide();
                }
                if (!$(e.target).closest('#areaSearch, #areaDropdownMenu, #toggleAreaDropdown').length) {
                    $('#areaDropdownMenu').hide();
                }
                if (!$(e.target).closest('#traineeCompanySearch, #traineeCompanyDropdownMenu, #toggleTraineeCompanyDropdown, #clearTraineeCompany').length) {
                    $('#traineeCompanyDropdownMenu').hide();
                }
            });

            $('#addBenchmarkModal').on('show.bs.modal', function () {
                var area = $('#area').val();
                if(!area) {
                    alert('Pilih Area Utama terlebih dahulu!');
                    return false; // Prevent modal from opening
                }
                $('#newBenchmarkArea').val(area);
                $('#newBenchmarkName').val('');
                $('#addBenchmarkError').hide();
                
                // Populate existing benchmarks in modal
                var list = $('#existingBenchmarksList');
                list.empty();
                if(globalBenchmarksList.length > 0) {
                    globalBenchmarksList.forEach(function(b) {
                        list.append('<div class="list-group-item" style="font-size: 13px; background: rgba(0,0,0,0.1); border-color: var(--border-color); color: var(--text-main);"><i class="bi bi-compass me-2 text-muted"></i>' + b.namaBenchmark + '</div>');
                    });
                } else {
                    list.append('<div class="p-3 text-center text-muted" style="font-size: 12px;">Belum ada benchmark di area ini</div>');
                }
            });

            // Auto fetch GPS location on page load
            getLocation();

            // Real-time error clearing on user input
            $('#coachingForm').on('input change', 'input, select, textarea', function() {
                $(this).removeClass('is-invalid');
                $(this).closest('.form-group-sap').find('.sap-err-msg').remove();
                $(this).closest('.input-sap-wrapper').next('.sap-err-msg').remove();
            });

            // Prevent double submission & enforce validations
            $('#coachingForm').on('submit', function(e) {
                e.preventDefault();
                if (isCoachingSubmitting) return false;

                var coachingId = $('#coachingId').val();
                var fotoInput = document.getElementById('fotoInput');
                var btn = $('#btnSubmitCoaching, #coachingForm button[type="submit"]');

                // Custom validation
                let isValid = true;
                let firstInvalid = null;
                let errorMessages = [];
                
                $('#coachingForm').find('.is-invalid').removeClass('is-invalid');
                $('#coachingForm').find('.sap-err-msg').remove();

                const fieldsToValidate = {
                    'tanggal': 'Tanggal Kegiatan',
                    'waktuStr': 'Waktu Mulai',
                    'lokasi': 'Lokasi Spesifik',
                    'tema': 'Tema Coaching'
                };

                // Validate visible input/select
                $('#coachingForm').find('input[required]:visible, select[required]:visible, textarea[required]:visible').each(function() {
                    const $el = $(this);
                    const id = $el.attr('id') || $el.attr('name');
                    const val = $el.val();
                    
                    if (!val || val.toString().trim() === '') {
                        isValid = false;
                        $el.addClass('is-invalid');
                        if (!firstInvalid) firstInvalid = $el;
                        
                        const labelName = fieldsToValidate[id] || $el.closest('.form-group-sap').find('label').text() || 'Field';
                        const cleanLabel = labelName.replace(':', '').replace('*', '').trim();
                        errorMessages.push(cleanLabel + " wajib diisi.");
                        const errHtml = `<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>${cleanLabel} wajib diisi.</span>`;
                        
                        const $wrapper = $el.closest('.input-sap-wrapper');
                        if ($wrapper.length) {
                            $wrapper.after(errHtml);
                        } else {
                            $el.after(errHtml);
                        }
                    }
                });

                // Validate date range (+/- 7 days)
                const tanggalVal = $('#tanggal').val();
                if (tanggalVal) {
                    const selectedDate = new Date(tanggalVal);
                    const today = new Date();
                    today.setHours(0,0,0,0);
                    selectedDate.setHours(0,0,0,0);
                    const diffDays = Math.round((selectedDate - today) / (1000 * 60 * 60 * 24));
                    if (diffDays < -7 || diffDays > 7) {
                        isValid = false;
                        $('#tanggal').addClass('is-invalid');
                        if (!firstInvalid) firstInvalid = $('#tanggal');
                        errorMessages.push("Tanggal kegiatan harus berada dalam rentang 7 hari sebelum dan sesudah hari ini.");
                        $('#tanggal').closest('.input-sap-wrapper').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Tanggal harus berada dalam rentang +/- 7 hari dari hari ini.</span>');
                    }
                }

                // Verify Area Utama
                const areaVal = $('#area').val();
                if (!areaVal || areaVal.trim() === '') {
                    isValid = false;
                    $('#areaSearch').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#areaSearch');
                    errorMessages.push("Area Utama wajib dipilih dari daftar.");
                    $('#areaSearch').closest('.input-sap-wrapper').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Area Utama wajib dipilih dari daftar.</span>');
                }

                // Verify at least one trainee selected
                if (selectedTrainees.length === 0) {
                    isValid = false;
                    $('#traineeSearchInput').addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('#traineeSearchInput');
                    errorMessages.push("Minimal satu peserta coaching (trainee) wajib dipilih.");
                    $('#traineeSearchInput').closest('.input-sap-wrapper').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Minimal satu peserta coaching wajib dipilih.</span>');
                }

                // If it is a new coaching session, photo is mandatory
                const hasExistingPhoto = !$('#fotoPreviewContainer').hasClass('d-none') && $('#fotoPreview').attr('src');
                if (!coachingId && (!fotoInput.files || fotoInput.files.length === 0)) {
                    isValid = false;
                    $(fotoInput).addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('.upload-card').last();
                    errorMessages.push("Foto bukti kegiatan coaching wajib diunggah.");
                    $(fotoInput).closest('.form-group-sap').find('.upload-card').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Foto bukti kegiatan coaching wajib diunggah.</span>');
                } else if (coachingId && (!fotoInput.files || fotoInput.files.length === 0) && !hasExistingPhoto) {
                    isValid = false;
                    $(fotoInput).addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = $('.upload-card').last();
                    errorMessages.push("Foto bukti kegiatan coaching wajib diunggah.");
                    $(fotoInput).closest('.form-group-sap').find('.upload-card').after('<span class="text-danger sap-err-msg d-block mt-1" style="font-size:11px;"><i class="bi bi-exclamation-circle-fill me-1"></i>Foto bukti kegiatan coaching wajib diunggah.</span>');
                }

                if (!isValid) {
                    resetButtonState();
                    showSapErrorPopup("Laporan coaching belum lengkap", errorMessages);
                    if (firstInvalid) {
                        $('html, body').animate({
                            scrollTop: firstInvalid.offset().top - 120
                        }, 300);
                    }
                    return false;
                }

                isCoachingSubmitting = true;
                btn.prop('disabled', true).css('pointer-events', 'none');
                btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>MENYIMPAN...');

                const $overlay = $('#loadingOverlay');
                const $progressBar = $('#loadingProgressBar');
                const $progressPercent = $('#loadingProgressPercent');
                const $title = $('#loadingTitle');
                const $subtitle = $('#loadingSubtitle');

                $overlay.css('display', 'flex');
                $title.text('Menyiapkan Data...');
                $subtitle.text('Sedang memproses laporan coaching dan peserta...');
                $progressBar.css('width', '15%');
                $progressPercent.text('15%');

                const formData = new FormData(this);

                $.ajax({
                    url: '/Coaching/Submit',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    xhr: function() {
                        const xhr = new window.XMLHttpRequest();
                        xhr.upload.addEventListener('progress', function(evt) {
                            if (evt.lengthComputable) {
                                const percent = Math.round((evt.loaded / evt.total) * 100);
                                const scaledPercent = Math.max(15, Math.min(95, percent));
                                $progressBar.css('width', scaledPercent + '%');
                                $progressPercent.text(scaledPercent + '%');
                                if (percent >= 100) {
                                    $title.text('Memproses di Server...');
                                    $subtitle.text('Mohon tunggu, server sedang menyimpan data...');
                                }
                            }
                        }, false);
                        return xhr;
                    },
                    success: function(response) {
                        $title.text('Selesai!');
                        $subtitle.text(response && response.message ? response.message : 'Laporan coaching berhasil disimpan.');
                        $progressBar.css('width', '100%');
                        $progressPercent.text('100%');
                        setTimeout(function() {
                            window.location.href = '/Coaching/Index';
                        }, 500);
                    },
                    error: function(xhr, status, error) {
                        resetButtonState();

                        let errMessage = "Terjadi kesalahan saat menyimpan data coaching.";
                        let errList = [];

                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.message) errMessage = xhr.responseJSON.message;
                            if (Array.isArray(xhr.responseJSON.errors)) errList = xhr.responseJSON.errors;
                        } else if (xhr.responseText) {
                            try {
                                const parsed = JSON.parse(xhr.responseText);
                                if (parsed.message) errMessage = parsed.message;
                                if (Array.isArray(parsed.errors)) errList = parsed.errors;
                            } catch(e) {}
                        }

                        if (errList.length === 0) {
                            errList = [errMessage];
                        }

                        showSapErrorPopup(errMessage, errList);
                    },
                    complete: function() {
                        setTimeout(function() {
                            if ($('#sapErrorModal').is(':visible') || !isCoachingSubmitting) {
                                resetButtonState();
                            }
                        }, 100);
                    }
                });

                return false;
            });

            // Ensure button state is clean on page load
            resetButtonState();
            window.addEventListener('pageshow', function() {
                resetButtonState();
            });
        });

        let globalAreasList = [
            { id: 1, namaArea: "Port/Jetty - Indexim" },
            { id: 2, namaArea: "CPP-33 & ROM - Indexim" },
            { id: 3, namaArea: "Kantor - Indexim" },
            { id: 4, namaArea: "Mess & Fasilitas - Indexim" },
            { id: 5, namaArea: "Nursery - Indexim" },
            { id: 6, namaArea: "Settling Pond - Indexim" },
            { id: 7, namaArea: "PIT - Unggul" },
            { id: 8, namaArea: "Road PIT Overburden - Unggul" },
            { id: 9, namaArea: "Kantor - Unggul" },
            { id: 10, namaArea: "Mess & Fasilitas - Unggul" },
            { id: 11, namaArea: "Settling Pond - Unggul" },
            { id: 12, namaArea: "PIT - KPP" },
            { id: 13, namaArea: "Road PIT Overburden - KPP" },
            { id: 14, namaArea: "Kantor - KPP" },
            { id: 15, namaArea: "Mess & Fasilitas - KPP" },
            { id: 16, namaArea: "Settling Pond - KPP" },
            { id: 17, namaArea: "PIT - MGE" },
            { id: 18, namaArea: "Road PIT Overburden - MGE" },
